/-- Every `a = 1 mod 4` with `5 ≤ a < 2^62` returns: kernel only, no `native_decide`. -/
theorem returns_2_62_kernel : ∀ a, a % 4 = 1 → 5 ≤ a → a < 2 ^ 62 → Returns a :=
  returns_of_cov R62.c

/-- **The first 3·2^60 + 1 ≈ 3.46·10¹⁸ passes** from blank tape never stop at a block of 1, and the machine
reaches each of their pass starts: kernel only. -/
theorem no_one_3e18_kernel (n : Nat) (hn : n ≤ 3 * 2 ^ 60 + 1) :
    ∃ zs t, orbit n = .ok zs ∧ zs.sum = 4 * n ∧ n ≤ t ∧ steps t init = some ⟨enc zs, blank, .A⟩ :=
  reach_upto _ returns_2_62_kernel n (by omega)

