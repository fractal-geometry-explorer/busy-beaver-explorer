    · simp only [flat, Sg.gs, nmis_append, nmis, nmis_rep, List.cons_append, List.nil_append, List.singleton_append, List.append_assoc, List.append_nil]
      repeat' split
      all_goals omega
  · cases h
    refine ⟨goodH_last2 _ _ (by omega) ?_, by (try dsimp only); omega, ?_⟩
    · intro b hb
      simp only [List.mem_cons, List.mem_append, List.mem_replicate, List.not_mem_nil, List.mem_singleton, or_false, false_or, ne_eq] at hb
      all_goals omega
    · simp only [flat, Sg.gs, nmis_append, nmis, nmis_rep, List.cons_append, List.nil_append, List.singleton_append, List.append_assoc, List.append_nil]
      repeat' split
      all_goals omega
  · cases h


/-! ## The invariant is kept -/

theorem nmis_le_of_cons {g : Nat} {G : List Nat} (h : nmis (g :: G) ≤ 1) (hg : g % 3 ≠ 2) : nmis G = 0 := by
  simp only [nmis, if_neg hg] at h; omega

theorem nmis_new {g : Nat} {G : List Nat} (h : nmis G = 0) : nmis (g :: G) ≤ 1 := by
  simp only [nmis, h]; split <;> omega

/-- The steps of `astep` keep the invariant (outside a lost race). -/
theorem astep_inv (c c' : AC) (hI : Inv c) (hl : ¬ lost c) (h : astep c = some c') : Inv c' := by
  obtain ⟨W, a, G⟩ := c
  obtain ⟨hW, ha, hG⟩ := hI
  simp only at hW ha hG
  simp only [lost, not_and, Nat.not_le] at hl
  unfold astep at h
  split at h
  · rename_i x hWx
    simp only at hWx; subst hWx
    have h0 : nmis G = 0 := by have := hl rfl; omega
    by_cases hc : x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ a
    · rw [ite_t hc] at h; cases h
      exact ⟨goodH_of_goodW (goodW_fresh ⟨hc.1, hc.2.1⟩), Nat.le_refl 1, nmis_new h0⟩
    · rw [ite_f hc] at h; cases h
  · rename_i x hWx
    simp only at hWx; subst hWx
    have h0 : nmis G = 0 := by have := hl (by simp [ended]); omega
    by_cases hx : x % 2 = 0 ∧ 2 ≤ x
    · rw [ite_t hx] at h
      by_cases h2 : 2 ≤ a
      · rw [ite_t h2] at h; cases h
        exact ⟨goodH_of_goodW (goodW_cons_odd (by decide) (goodW_fresh hx)), Nat.le_refl 1, nmis_new h0⟩
      · rw [ite_f h2] at h; cases h
    · rw [ite_f hx] at h; cases h
  · rename_i hne1 hne2
    by_cases hw : wshape W = true
    · rw [ite_t hw] at h
      have gp := goodW_phi (goodW_phi (goodW_of_wshape hW hw))
      by_cases h2 : 2 ≤ a
      · rw [ite_t h2] at h; cases h
        refine ⟨goodH_of_goodW gp, Nat.le_refl 1, ?_⟩
        show nmis ((3 * (a - 2) + 2) :: G) ≤ 1
        simp only [nmis, show (3 * (a - 2) + 2) % 3 = 2 by omega, if_true]; omega
      · rw [ite_f h2] at h
        by_cases h1 : a = 1
        · rw [ite_t h1] at h
          have hs := nmis_lead2 G
          split at h
          · cases h; exact ⟨goodH_of_goodW gp, by (try dsimp only); omega, Nat.zero_le 1⟩
          · rename_i t hh G0 e
            have e2 := congrArg Prod.snd e
            simp only at e2
            rw [e2] at hs
            have hne := lead2_head G hh G0 e2
            by_cases h3 : 3 ≤ hh
            · rw [ite_t h3] at h; cases h
              refine ⟨goodH_of_goodW gp, by (try dsimp only); omega, ?_⟩
              show nmis ((hh - 3) :: G0) ≤ 1
              rw [nmis_sub3 h3]; omega
            · rw [ite_f h3] at h
              by_cases hh1 : hh ≤ 1
              · rw [ite_t hh1] at h
                have h00 : nmis G0 = 0 := nmis_le_of_cons (g := hh) (by omega) (by omega)
                have hs0 := nmis_lead2 G0
                rw [h00] at hs0
                split at h
                · rename_i C a' d hc e3; cases h
                  obtain ⟨ha', hC⟩ := coll_spec hc
                  exact ⟨goodH_of_goodW (goodW_append hC (goodW_bump gp)), ha', Nat.zero_le 1⟩
                · rename_i C a' d h' G' hc e3
                  by_cases h5 : 5 ≤ h'
                  · rw [ite_t h5] at h; cases h
                    obtain ⟨ha', hC⟩ := coll_spec hc
                    rw [e3] at hs0
                    refine ⟨goodH_of_goodW (goodW_append hC (goodW_bump gp)), ha', ?_⟩
                    show nmis ((h' - 5 + d) :: G') ≤ 1
                    simp only [nmis] at hs0 ⊢
                    split at hs0 <;> split <;> omega
                  · rw [ite_f h5] at h; cases h
                · cases h
              · rw [ite_f hh1] at h; cases h
        · rw [ite_f h1] at h; cases h
    · rw [ite_f hw] at h; cases h

/-- Where `astep` has no rule, `xstep` has one and it keeps the invariant (outside a lost race). -/
theorem xstep_inv (c : AC) (hI : Inv c) (hl : ¬ lost c) (hn : astep c = none) :
    ∃ c', xstep c = some c' ∧ Inv c' := by
  obtain ⟨W, a, G⟩ := c
  obtain ⟨hW, ha, hG⟩ := hI
  simp only at hW ha hG
  simp only [lost, not_and, Nat.not_le] at hl
  unfold astep at hn
  split at hn
  · rename_i x hWx
    simp only at hWx; subst hWx
    have hx : x % 2 = 0 ∧ 2 ≤ x := hW
    rw [ite_t ⟨hx.1, hx.2, ha⟩] at hn; cases hn
  · rename_i y hWx
    simp only at hWx; subst hWx
    have hy : y % 2 = 0 ∧ 2 ≤ y := hW.2
    have h0 : nmis G = 0 := by have := hl (by simp [ended]); omega
    rw [ite_t hy] at hn
    have ha1 : a = 1 := by
      rcases Nat.lt_or_ge a 2 with h | h
      · omega
      · rw [ite_t h] at hn; cases hn
    subst ha1
    simp only [xstep]
    simp only [hy.1, hy.2, and_self, ite_true, if_true, true_and, and_true]
    have hok := okS_rl G h0
    obtain ⟨c', e⟩ := Option.isSome_iff_exists.mp (xanu_total ((y - 2) / 2) (rl G) hok)
    obtain ⟨g1, g2, g3⟩ := xanu_inv _ _ e
    rw [flat_rl, h0] at g3
    exact ⟨c', e, g1, g2, by omega⟩
  · rename_i hne1 hne2
    rcases W with _ | ⟨x, _ | ⟨y, V⟩⟩
    · exact absurd hW id
    · exact absurd rfl (hne1 x)
    have h1 : ¬ (x = 1 ∧ V = []) := by
      rintro ⟨rfl, rfl⟩; exact hne2 y rfl
    simp only [xstep]
    rw [ite_f h1]
    by_cases hx : x % 2 = 0
    · -- the anomaly inside the word
      have hy := goodW_pos hW.2
      have hx2 : 2 ≤ x := by have := hW.1; omega
      have h0 : nmis G = 0 := by
        have := hl (by simp [ended, hx]); omega
      rw [ite_t ⟨hx, hx2, hy, ha⟩]
      refine ⟨_, rfl, ?_, Nat.le_refl 1, nmis_new h0⟩
      exact goodH_of_goodW (goodW_append (ones_odd _) (goodW_add2 hW.2))
    · have hx2 : ¬ (x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ y ∧ 1 ≤ a) := fun h => hx h.1
      rw [ite_f hx2]
      have hWg : goodW (x :: y :: V) := goodW_of_goodH hW (by omega)
      have hw := wshape_of_goodW hWg (fun z e => by simp at e) (fun z e => by
        simp only [List.cons.injEq] at e; exact h1 ⟨e.1, e.2.2⟩)
      rw [ite_t hw] at hn
      have ha1 : a = 1 := by
        rcases Nat.lt_or_ge a 2 with h | h
        · omega
        · rw [ite_t h] at hn; cases hn
      subst ha1
      rw [ite_f (by omega : ¬ 2 ≤ 1), ite_t rfl] at hn
      rw [ite_t ⟨hw, rfl⟩]
      have hs := nmis_lead2 G
      cases e : lead2 G with
      | mk t R =>
        rw [e] at hn hs
        cases R with
        | nil => simp at hn
        | cons hh G0 =>
          simp only at hn hs ⊢
          have hne := lead2_head G hh G0 (by rw [e])
          have hh1 : hh ≤ 1 := by
            rcases Nat.lt_or_ge hh 3 with h3 | h3
            · omega
            · rw [ite_t h3] at hn; cases hn
          rw [ite_t hh1]
          have h00 : nmis G0 = 0 := nmis_le_of_cons (g := hh) (by omega) (by omega)
          have hok := okS_rl G0 h00
          have ht := xcoll_total (t / 2) (t % 2) hh (rl G0) (Nat.mod_lt _ (by decide)) hh1 hok
          obtain ⟨r, er⟩ := Option.isSome_iff_exists.mp ht
          obtain ⟨C, a', G', j⟩ := r
          rw [er]
          obtain ⟨ha', hC, hj, hn'⟩ := xcoll_inv _ _ _ _ er
          rw [flat_rl, h00] at hn'
          exact ⟨_, rfl, goodH_hd1 hC (goodW_addh (goodW_phi (goodW_phi hWg)) hj), ha', by omega⟩

/-- **The invariant is kept** wherever the race is not lost. -/
theorem inv_step (c : AC) (hI : Inv c) (hl : ¬ lost c) : ∃ c', bstep c = some c' ∧ Inv c' := by
  unfold bstep
  cases e : astep c with
  | some c' => exact ⟨c', rfl, astep_inv c c' hI hl e⟩
  | none => exact xstep_inv c hI hl e

/-! ## Non-halting reduced to the races -/

theorem inv_start : Inv start := ⟨⟨Nat.le_refl 1, rfl, Nat.le_refl 2⟩, Nat.le_refl 1, Nat.zero_le 1⟩

/-- Along an orbit with no lost race, `bstep` is defined at every step and the invariant holds. -/
theorem brun_of_races (c : AC) (hI : Inv c) :
    ∀ k, (∀ j c', j < k → brun j c = some c' → ¬ lost c') → ∃ c', brun k c = some c' ∧ Inv c' := by
  intro k
  induction k generalizing c with
  | zero => intro _; exact ⟨c, rfl, hI⟩
  | succ k ih =>
    intro hno
    obtain ⟨c1, e1, hI1⟩ := inv_step c hI (hno 0 c (by omega) rfl)
    have hno' : ∀ j c', j < k → brun j c1 = some c' → ¬ lost c' := by
      intro j c' hj hr
      exact hno (j + 1) c' (by omega) (by simp only [brun, e1, Option.bind_some]; exact hr)
    obtain ⟨c', e', hI'⟩ := ih c1 hI1 hno'
    exact ⟨c', by simp only [brun, e1, Option.bind_some]; exact e', hI'⟩

/-- **Halting needs a lost race**: if no configuration on the orbit of the closed-form map from the first Q
configuration (step 27) is a lost race, the machine never halts from blank tape. -/
theorem not_halts_of_races (h : ∀ k c, brun k start = some c → ¬ lost c) : ¬ HaltsFromBlank := by
  apply not_halts_of_brun
  intro k
  obtain ⟨c, e, _⟩ := brun_of_races start inv_start k (fun j c' _ hr => h j c' hr)
  rw [e]; rfl

end H70169
