/-! ## Words and gaps -/

/-- A valid word (last block first) with an odd last block, or a single even block: the first block (the last of
the list) even and at least 2, the others odd. -/
def goodW : List Nat → Prop
  | [] => False
  | [x] => x % 2 = 0 ∧ 2 ≤ x
  | b :: x :: W => b % 2 = 1 ∧ goodW (x :: W)

/-- A valid word whose last block may also be even. -/
def goodH : List Nat → Prop
  | [] => False
  | [x] => x % 2 = 0 ∧ 2 ≤ x
  | x :: y :: V => 1 ≤ x ∧ goodW (y :: V)

/-- The number of misaligned gaps. -/
def nmis : List Nat → Nat
  | [] => 0
  | g :: G => (if g % 3 = 2 then 0 else 1) + nmis G

/-- The invariant. -/
def Inv (c : AC) : Prop := goodH c.W ∧ 1 ≤ c.a ∧ nmis c.G ≤ 1

/-- An anomaly comes next: the word is one block, a block and a single 1, or its last block is even. -/
def ended : List Nat → Bool
  | [_] => true
  | x :: _ :: V => (x == 1 && V.isEmpty) || x % 2 == 0
  | [] => false

/-- A lost race: an anomaly comes next while a misaligned gap is pending. -/
def lost (c : AC) : Prop := ended c.W = true ∧ 1 ≤ nmis c.G

theorem nmis_append : ∀ A B : List Nat, nmis (A ++ B) = nmis A + nmis B
  | [], B => by simp [nmis]
  | g :: A, B => by simp only [List.cons_append, nmis, nmis_append A B]; omega

theorem nmis_rep (k g : Nat) : nmis (List.replicate k g) = if g % 3 = 2 then 0 else k := by
  induction k with
  | zero => simp [nmis]
  | succ k ih => simp only [List.replicate_succ, nmis, ih]; split <;> omega

theorem nmis_twos (t : Nat) (R : List Nat) : nmis (List.replicate t 2 ++ R) = nmis R := by
  rw [nmis_append, nmis_rep]; simp

theorem nmis_lead2 (G : List Nat) : nmis G = nmis (lead2 G).2 := by
  conv => lhs; rw [lead2_spec G]
  exact nmis_twos _ _

theorem goodW_cons_odd {b : Nat} {W : List Nat} (hb : b % 2 = 1) (hW : goodW W) : goodW (b :: W) := by
  match W, hW with
  | x :: W', hW => exact ⟨hb, hW⟩

theorem goodW_append {C W : List Nat} (hC : ∀ b ∈ C, b % 2 = 1) (hW : goodW W) : goodW (C ++ W) := by
  induction C with
  | nil => exact hW
  | cons b C ih =>
    exact goodW_cons_odd (hC b (List.mem_cons_self ..)) (ih fun x hx => hC x (List.mem_cons_of_mem _ hx))

theorem ones_odd (n : Nat) : ∀ b ∈ List.replicate n 1, b % 2 = 1 := by
  intro b hb; rw [List.eq_of_mem_replicate hb]

/-- The second block keeps its parity under `+ 2`. -/
theorem goodW_add2 {x : Nat} {W : List Nat} (h : goodW (x :: W)) : goodW ((x + 2) :: W) := by
  match W, h with
  | [], h => exact ⟨by have := h.1; omega, by omega⟩
  | y :: W', h => exact ⟨by have := h.1; omega, h.2⟩

theorem goodW_phi {W : List Nat} (h : goodW W) : goodW (phi W) := by
  match W, h with
  | [x], h => exact h
  | b :: x :: W', h =>
    simp only [phi]
    exact goodW_append (ones_odd _) (goodW_add2 h.2)

theorem goodW_bump {W : List Nat} (h : goodW W) : goodW (bump W) := by
  match W, h with
  | b :: W', h => exact goodW_add2 h

theorem goodW_addh {W : List Nat} {j : Nat} (h : goodW W) (hj : j % 2 = 0) : goodW (addh j W) := by
  match W, h with
  | [x], h => exact ⟨by have := h.1; omega, by have := h.2; omega⟩
  | b :: y :: W', h => exact ⟨by have := h.1; omega, h.2⟩

theorem goodW_fresh {x : Nat} (_hx : x % 2 = 0 ∧ 2 ≤ x) : goodW (fresh x) :=
  goodW_append (ones_odd _) ⟨by decide, Nat.le_refl 2⟩

theorem goodW_pos : ∀ {y : Nat} {V : List Nat}, goodW (y :: V) → 1 ≤ y
  | _, [], h => by have := h.2; omega
  | _, _ :: _, h => by have := h.1; omega

theorem goodH_of_goodW : ∀ {W : List Nat}, goodW W → goodH W
  | [_], h => h
  | _ :: _ :: _, h => ⟨by have := h.1; omega, h.2⟩

theorem goodW_of_goodH {x y : Nat} {V : List Nat} (h : goodH (x :: y :: V)) (hx : x % 2 = 1) :
    goodW (x :: y :: V) := ⟨hx, h.2⟩

/-- Blocks in front of a valid word: the last may be any positive block, the others odd. -/
def hd1 : List Nat → Prop
  | [] => True
  | c :: C => 1 ≤ c ∧ ∀ b ∈ C, b % 2 = 1

theorem goodH_hd1 {C W : List Nat} (hC : hd1 C) (hW : goodW W) : goodH (C ++ W) := by
  match C, hC with
  | [], _ => exact goodH_of_goodW hW
  | c :: C', hC =>
    have h2 : goodW (C' ++ W) := goodW_append hC.2 hW
    match e : C' ++ W, h2 with
    | y :: V, h2 => simp only [List.cons_append, e]; exact ⟨hC.1, h2⟩

theorem goodH_last2 (x : Nat) (C : List Nat) (hx : 1 ≤ x) (hC : ∀ b ∈ C, b % 2 = 1) : goodH (x :: (C ++ [2])) := by
  have h2 : goodW (C ++ [2]) := goodW_append hC ⟨rfl, Nat.le_refl 2⟩
  match e : C ++ [2], h2 with
  | y :: V, h2 => exact ⟨hx, h2⟩

/-- A word of at least two blocks with an odd last block, other than `[1, x]`, has one of the shapes of the regular
step. -/
theorem wshape_of_goodW {W : List Nat} (h : goodW W) (h1 : ∀ x, W ≠ [x]) (h2 : ∀ x, W ≠ [1, x]) :
    wshape W = true := by
  match W, h with
  | [x], _ => exact absurd rfl (h1 x)
  | b :: x :: V, h =>
    have hb := h.1
    simp only [wshape, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq]
    by_cases hb1 : b = 1
    · subst hb1
      cases V with
      | nil => exact absurd rfl (h2 x)
      | cons y V' =>
        right
        refine ⟨⟨rfl, ?_⟩, ?_⟩
        · exact h.2.1
        · simp
    · left; exact ⟨hb, by omega⟩

theorem goodW_of_wshape {W : List Nat} (h : goodH W) (hw : wshape W = true) : goodW W := by
  match W, h, hw with
  | b :: x :: V, h, hw =>
    simp only [wshape, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hw
    refine ⟨?_, h.2⟩
    rcases hw with ⟨hb, _⟩ | ⟨⟨rfl, _⟩, _⟩
    · exact hb
    · rfl

theorem coll_spec {s p g U : Nat} {C : List Nat} {a' d : Nat} (h : coll s p g U = some (C, a', d)) :
    1 ≤ a' ∧ ∀ b ∈ C, b % 2 = 1 := by
  unfold coll at h
  split at h <;> simp only [Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at h <;>
    obtain ⟨rfl, rfl, rfl⟩ := h <;>
    refine ⟨by omega, ?_⟩ <;> intro b hb <;>
    simp only [List.mem_cons, List.mem_replicate] at hb <;> omega

theorem nmis_sub3 {h : Nat} {G : List Nat} (h3 : 3 ≤ h) : nmis ((h - 3) :: G) = nmis (h :: G) := by
  simp only [nmis, show (h - 3) % 3 = h % 3 by omega]

/-! ## Run-length forms of aligned gap lists -/

def notTwo : List Sg → Bool
  | .two _ :: _ => false
  | _ => true

def notFive : List Sg → Bool
  | .five _ :: _ => false
  | _ => true

/-- A run-length form as `rl` makes it from an aligned gap list: maximal nonempty runs, no other gaps. -/
def okS : List Sg → Bool
  | [] => true
  | .two n :: S => 0 < n && notTwo S && okS S
  | .five n :: S => 0 < n && notFive S && okS S
  | .big _ :: S => okS S
  | .odd _ :: _ => false

theorem okS_one (g : Nat) (S : List Sg) (hS : okS S = true) (hg : g % 3 = 2) (h2 : g = 2 → notTwo S = true)
    (h5 : g = 5 → notFive S = true) : okS (one g S) = true := by
  unfold one
  by_cases e2 : g = 2
  · subst e2; simp [okS, h2 rfl, hS]
  · by_cases e5 : g = 5
    · subst e5; simp [okS, h5 rfl, hS]
    · have h8 : 8 ≤ g ∧ g % 3 = 2 := ⟨by omega, hg⟩
      simp [e2, e5, h8, okS, hS]

theorem okS_push (g : Nat) (hg : g % 3 = 2) : ∀ S : List Sg, okS S = true → okS (push g S) = true
  | .two n :: S, hS => by
    simp only [okS, Bool.and_eq_true, decide_eq_true_eq] at hS
    by_cases e : g = 2
    · subst e; simp [push, okS, hS.1.2, hS.2]
    · simp only [push, e, ite_false]
      exact okS_one g _ (by simp [okS, hS.1.1, hS.1.2, hS.2]) hg (fun h => absurd h e) (fun _ => rfl)
  | .five n :: S, hS => by
    simp only [okS, Bool.and_eq_true, decide_eq_true_eq] at hS
    by_cases e : g = 5
    · subst e; simp [push, okS, hS.1.2, hS.2]
    · simp only [push, e, ite_false]
      exact okS_one g _ (by simp [okS, hS.1.1, hS.1.2, hS.2]) hg (fun _ => rfl) (fun h => absurd h e)
  | .big q :: S, hS => by
    simp only [push]
    exact okS_one g _ hS hg (fun _ => rfl) (fun _ => rfl)
  | .odd x :: S, hS => by simp [okS] at hS
  | [], _ => by
    simp only [push]
    exact okS_one g _ rfl hg (fun _ => rfl) (fun _ => rfl)

theorem okS_rl : ∀ G : List Nat, nmis G = 0 → okS (rl G) = true
  | [], _ => rfl
  | g :: G, h => by
    simp only [nmis] at h
    have hg : g % 3 = 2 := by
      by_cases e : g % 3 = 2
      · exact e
      · rw [if_neg e] at h; omega
    rw [if_pos hg] at h
    exact okS_push g hg _ (okS_rl G (by omega))

