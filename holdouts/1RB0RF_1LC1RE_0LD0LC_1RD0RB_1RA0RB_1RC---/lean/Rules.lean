  have h6 : steps 13 ⟨cons true (cons true (cons false (L))), cons true (cons false (rep (i) [true, true] (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R)))))))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (L)))), cons true (rep (i) [true, true] (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R))))))), .E⟩ := rfl
  have h7 : steps 0 ⟨cons true (cons false (cons true (cons true (L)))), cons true (rep (i) [true, true] (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R))))))), .E⟩ = some ⟨cons true (cons false (cons true (cons true (L)))), rep (i) [true, true] (cons true (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R))))))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (i) [true, true] (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R))))))) = rep (i) [true, true] (cons true (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R))))))) from
      rep_rotate (i) [true] [true, true] [true, true] rfl (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R))))))]
  have c8 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h8 : steps ((i) * 2) ⟨cons true (cons false (cons true (cons true (L)))), rep (i) [true, true] (cons true (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R))))))), .E⟩ = some ⟨rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))), cons true (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R)))))), .E⟩ :=
    cross_r trans c8 (i) (cons true (cons false (cons true (cons true (L))))) (cons true (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R)))))))
  have h9 : steps 4 ⟨rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))), cons true (cons true (cons false (cons false (rep (a + 1) [false, false, false] (cons true (R)))))), .E⟩ = some ⟨cons true (cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))))))), rep (a + 1) [false, false, false] (cons true (R)), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

/-- Q-step: the last block of W is a single 1 after a block of 2i+1: the second phi splits that block; a run of 3 ones, then t gaps of length 2, then at least three 0s: the carry absorbs the t units. -/
theorem q_one_unit (i t : Nat) (L R : Tape) :
    steps (8 * i + 3 * t + 33) ⟨cons true (cons true (cons true (cons false (cons true (cons false (rep (i) [true, true] (cons true (cons false (L))))))))), cons false (rep (t) [false, false, true] (cons false (cons false (cons false (R))))), .B⟩ = some ⟨cons true (cons true (cons true (cons true (rep (t) [true, true, true] (cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))))))))))), cons false (R), .B⟩ := by
  have hn : 13 + (0 + ((i) * 6 + (13 + (0 + ((i) * 2 + (3 + (0 + ((t) * 3 + (4))))))))) = 8 * i + 3 * t + 33 := by omega
  have h0 : steps 13 ⟨cons true (cons true (cons true (cons false (cons true (cons false (rep (i) [true, true] (cons true (cons false (L))))))))), cons false (rep (t) [false, false, true] (cons false (cons false (cons false (R))))), .B⟩ = some ⟨cons true (rep (i) [true, true] (cons true (cons false (L)))), cons true (cons false (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .D⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (i) [true, true] (cons true (cons false (L)))), cons true (cons false (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .D⟩ = some ⟨rep (i) [true, true] (cons true (cons true (cons false (L)))), cons true (cons false (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .D⟩ := by
    simp only [steps_zero, show cons true (rep (i) [true, true] (cons true (cons false (L)))) = rep (i) [true, true] (cons true (cons true (cons false (L)))) from
      rep_rotate (i) [true] [true, true] [true, true] rfl (cons true (cons false (L)))]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [true, true] L, app [true, false] R, .D⟩ = some ⟨L, app [true, false] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h2 : steps ((i) * 6) ⟨rep (i) [true, true] (cons true (cons true (cons false (L)))), cons true (cons false (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .D⟩ = some ⟨cons true (cons true (cons false (L))), cons true (cons false (rep (i) [true, true] (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R))))))))))), .D⟩ :=
    cross_l trans c2 (i) (cons true (cons true (cons false (L)))) (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))
  have h3 : steps 13 ⟨cons true (cons true (cons false (L))), cons true (cons false (rep (i) [true, true] (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R))))))))))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (L)))), cons true (rep (i) [true, true] (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .E⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (cons true (L)))), cons true (rep (i) [true, true] (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .E⟩ = some ⟨cons true (cons false (cons true (cons true (L)))), rep (i) [true, true] (cons true (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (i) [true, true] (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))) = rep (i) [true, true] (cons true (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))) from
      rep_rotate (i) [true] [true, true] [true, true] rfl (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h5 : steps ((i) * 2) ⟨cons true (cons false (cons true (cons true (L)))), rep (i) [true, true] (cons true (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))))))), .E⟩ = some ⟨rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))), cons true (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R))))))))), .E⟩ :=
    cross_r trans c5 (i) (cons true (cons false (cons true (cons true (L))))) (cons true (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R))))))))))
  have h6 : steps 3 ⟨rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))), cons true (cons true (cons false (cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R))))))))), .E⟩ = some ⟨cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L)))))))), cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))), .A⟩ := rfl
  have h7 : steps 0 ⟨cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L)))))))), cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))), .A⟩ = some ⟨cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L)))))))), rep (t) [false, true, false] (cons false (cons true (cons false (cons false (cons false (R)))))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (t) [false, false, true] (cons false (cons false (cons false (R)))))) = rep (t) [false, true, false] (cons false (cons true (cons false (cons false (cons false (R)))))) from
      rep_rotate (t) [false, true] [false, false, true] [false, true, false] rfl (cons false (cons false (cons false (R))))]
  have c8 : ∀ L R : Tape, steps 3 ⟨app [] L, app [false, true, false] R, .A⟩ = some ⟨app [] (app [true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h8 : steps ((t) * 3) ⟨cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L)))))))), rep (t) [false, true, false] (cons false (cons true (cons false (cons false (cons false (R)))))), .A⟩ = some ⟨rep (t) [true, true, true] (cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))))))), cons false (cons true (cons false (cons false (cons false (R))))), .A⟩ :=
    cross_r trans c8 (t) (cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))))))) (cons false (cons true (cons false (cons false (cons false (R))))))
  have h9 : steps 4 ⟨rep (t) [true, true, true] (cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))))))), cons false (cons true (cons false (cons false (cons false (R))))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (rep (t) [true, true, true] (cons true (cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons true (L))))))))))))), cons false (R), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

