/-! ## The carry chain, for any number of digits

Digits are written nearest the head first (the head works at the left end of the tape, the digits run to the
right): a digit is its wall and then its run of `0001` blocks. -/

/-- A T digit (ternary 2) with a run of `r` blocks, in front of `t`. -/
def Tdig (r : Nat) (t : Tape) : Tape := app [false, false, false, true, true, true] (rep r [false, false, false, true] t)
/-- A Z digit (ternary 0). -/
def Zdig (r : Nat) (t : Tape) : Tape := app [false, false, false, false, false, true] (rep r [false, false, false, true] t)
/-- An O digit (ternary 1). -/
def Odig (r : Nat) (t : Tape) : Tape := app [false, true, false, true] (rep r [false, false, false, true] t)
/-- T digits, the one nearest the head first. -/
def Tc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Tdig r (Tc rs t)
/-- Z digits, the one nearest the head first. -/
def Zc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Zdig r (Zc rs t)
/-- What crossing one T digit leaves behind the head (on its left). -/
def Hd (r : Nat) (t : Tape) : Tape := rep r [false, true, true, true] (app [true, true, false, true, true, true] t)
/-- `Hd` for a list of digits, crossed in list order. -/
def Hacc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Hacc rs (Hd r t)
/-- `Hd` for a list, the last crossed first. -/
def Htop : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Hd r (Htop rs t)
/-- What the way back leaves in front of the head, digit by digit. -/
def Wacc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Wacc rs (rep r [false, false, false, true] (app [false, false, false, false, false, true] t))
/-- `Zc` built up the other way round. -/
def Zacc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Zacc rs (Zdig r t)
def fcost : List Nat → Nat
  | [] => 0
  | r :: rs => 4 * r + 6 + fcost rs
def bcost : List Nat → Nat
  | [] => 0
  | r :: rs => 8 * r + 10 + bcost rs
/-- The step count of a sweep over these chain digits: 12 per block and 16 per digit. -/
def cost : List Nat → Nat
  | [] => 0
  | r :: rs => 12 * r + 16 + cost rs

theorem fcost_append (a b : List Nat) : fcost (a ++ b) = fcost a + fcost b := by
  induction a with
  | nil => simp [fcost]
  | cons r a ih => simp [fcost, ih]; omega

theorem bcost_reverse (a : List Nat) : bcost a.reverse = bcost a := by
  have h : ∀ a b : List Nat, bcost (a ++ b) = bcost a + bcost b := by
    intro a b; induction a with
    | nil => simp [bcost]
    | cons r a ih => simp [bcost, ih]; omega
  induction a with
  | nil => rfl
  | cons r a ih => simp [List.reverse_cons, h, ih, bcost]; omega

theorem cost_split (a : List Nat) : fcost a + bcost a = cost a := by
  induction a with
  | nil => rfl
  | cons r a ih => simp [fcost, bcost, cost]; omega

theorem Hacc_append (a b : List Nat) (t : Tape) : Hacc (a ++ b) t = Hacc b (Hacc a t) := by
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => exact ih _

theorem Htop_append (a b : List Nat) (t : Tape) : Htop (a ++ b) t = Htop a (Htop b t) := by
  induction a with
  | nil => rfl
  | cons r a ih => simp [Htop, ih]

theorem Hacc_eq (a : List Nat) (t : Tape) : Hacc a t = Htop a.reverse t := by
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => simp [Hacc, ih, List.reverse_cons, Htop_append, Htop]

theorem Zacc_eq (a : List Nat) (t : Tape) : Zacc a t = Zc a.reverse t := by
  have h : ∀ a b : List Nat, ∀ t, Zc (a ++ b) t = Zc a (Zc b t) := by
    intro a b t; induction a with
    | nil => rfl
    | cons r a ih => simp [Zc, ih]
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => simp [Zacc, ih, List.reverse_cons, h, Zc]

theorem Wacc_eq (a : List Nat) (t : Tape) :
    app [false, false, false, false, false, true] (Wacc a t) = Zacc a (app [false, false, false, false, false, true] t) := by
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => exact ih _

/-- Crossing T digits forward, any number of them. -/
theorem fwdChain (rs : List Nat) (R L : Tape) :
    steps (fcost rs) ⟨R, Tc rs L, .D⟩ = some ⟨Hacc rs R, L, .D⟩ := by
  induction rs generalizing R with
  | nil => rfl
  | cons r rs ih => exact steps_seq trans (fwdT r R (Tc rs L)) (ih _)

/-- Crossing back, any number of digits: each T digit becomes a Z digit with the same run. -/
theorem retChain (ts : List Nat) (X M : Tape) :
    steps (bcost ts) ⟨app [true, true, true] (Htop ts X), app [false, false, false, false, false, false] (app [false, false, true] M), .C⟩
      = some ⟨app [true, true, true] X, app [false, false, false, false, false, false] (app [false, false, true] (Wacc ts M)), .C⟩ := by
  induction ts generalizing M with
  | nil => rfl
  | cons s ts ih => exact steps_seq trans (retT s (Htop ts X) (app [false, false, true] M)) (ih _)

theorem startC (z : Nat) (l : List Nat) (hl : l ≠ []) (Y : Tape) :
    steps (4 * z + 3) ⟨blank, app [false, false, true] (rep z [false, false, false, true] (Tc l Y)), .C⟩
      = some ⟨cons false (cons true (rep z [true, true, false, true] (cons true blank))), Tc l Y, .D⟩ := by
  cases l with
  | nil => exact absurd rfl hl
  | cons r l => exact startT z _

theorem endE (z : Nat) (M : Tape) :
    app [false, false, true] (app [false, false, false, true] (rep z [false, false, false, true] (app [false, false, false, true] M)))
      = app [false, false, true] (rep (z + 2) [false, false, false, true] M) := by
  rw [rep_app_comm]; rfl

/-- **The generic counter sweep with the carry stopping on a Z digit**, for every number of carry digits.
From the sample `[z]` E, then the T digits `rs` (nearest the head first), then the top T digit with `t + 1` blocks,
then a Z digit with `a` blocks: the T digits become Z digits with the same runs, the top one loses a block, the Z
digit becomes an O digit, and the end run gains 2 blocks, in `12 z + 12 (t + 1) + 36 + cost rs` steps. -/
theorem sweepZ (z a t : Nat) (rs : List Nat) (L : Tape) :
    steps (12 * z + cost rs + 12 * (t + 1) + 36)
      ⟨blank, app [false, false, true] (rep z [false, false, false, true] (Tc (rs ++ [t + 1]) (Zdig a L))), .C⟩
      = some ⟨blank, app [false, false, true] (rep (z + 2) [false, false, false, true] (Zc rs (Zdig t (Odig a L)))), .C⟩ := by
  have h1 := startC z (rs ++ [t + 1]) (by simp) (Zdig a L)
  have h2 := fwdChain (rs ++ [t + 1]) (cons false (cons true (rep z [true, true, false, true] (cons true blank)))) (Zdig a L)
  rw [Hacc_append] at h2
  have h3 := stopZ t (Hacc rs (cons false (cons true (rep z [true, true, false, true] (cons true blank))))) (rep a [false, false, false, true] L)
  have e3 : rep (t + 1) [false, false, true, false] (cons true (cons false (cons true (rep a [false, false, false, true] L))))
      = app [false, false, true] (rep t [false, false, false, true] (Odig a L)) := by
    rw [rep_rotate t [false, false, true] [false, false, false, true] [false, false, true, false] rfl, ← rep_app_comm]; rfl
  rw [e3] at h3
  have h4 := retChain rs.reverse (cons false (cons true (rep z [true, true, false, true] (cons true blank))))
    (rep t [false, false, false, true] (Odig a L))
  rw [← Hacc_eq] at h4
  have h5 := endT z (Wacc rs.reverse (rep t [false, false, false, true] (Odig a L)))
  have e5 : app [false, false, true] (app [false, false, false, true] (rep z [false, false, false, true]
      (app [false, false, false, true] (app [false, false, false, false, false, true] (Wacc rs.reverse (rep t [false, false, false, true] (Odig a L)))))))
      = app [false, false, true] (rep (z + 2) [false, false, false, true] (Zc rs (Zdig t (Odig a L)))) := by
    rw [endE, Wacc_eq, Zacc_eq, List.reverse_reverse]; rfl
  have hc : 4 * z + 3 + (fcost (rs ++ [t + 1]) + (8 * t + 17 + (bcost rs.reverse + (8 * z + 18))))
      = 12 * z + cost rs + 12 * (t + 1) + 36 := by
    rw [fcost_append, bcost_reverse, ← cost_split]; simp [fcost]; omega
  have := steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5)))
  rw [hc] at this
  exact this.trans (congrArg (fun r => some (⟨blank, r, .C⟩ : Config)) e5)

/-- **The generic counter sweep with the carry stopping on an O digit**: as `sweepZ`, but the top T digit has
`t + 2` blocks and loses two, and the O digit becomes a T digit. -/
theorem sweepO (z a t : Nat) (rs : List Nat) (L : Tape) :
    steps (12 * z + cost rs + 12 * (t + 2) + 34)
      ⟨blank, app [false, false, true] (rep z [false, false, false, true] (Tc (rs ++ [t + 2]) (Odig a L))), .C⟩
      = some ⟨blank, app [false, false, true] (rep (z + 2) [false, false, false, true] (Zc rs (Zdig t (Tdig a L)))), .C⟩ := by
  have h1 := startC z (rs ++ [t + 2]) (by simp) (Odig a L)
  have h2 := fwdChain (rs ++ [t + 2]) (cons false (cons true (rep z [true, true, false, true] (cons true blank)))) (Odig a L)
  rw [Hacc_append] at h2
  have h3 := stopO (t + 1) (Hacc rs (cons false (cons true (rep z [true, true, false, true] (cons true blank))))) (rep a [false, false, false, true] L)
  have e3 : rep (t + 1) [false, false, false, true] (cons true (cons true (rep a [false, false, false, true] L)))
      = rep t [false, false, false, true] (Tdig a L) := by
    rw [← rep_app_comm]; rfl
  have h4 := retChain rs.reverse (cons false (cons true (rep z [true, true, false, true] (cons true blank))))
    (rep t [false, false, false, true] (Tdig a L))
  rw [← e3, ← Hacc_eq] at h4
  have h5 := endT z (Wacc rs.reverse (rep (t + 1) [false, false, false, true] (cons true (cons true (rep a [false, false, false, true] L)))))
  have e5 : app [false, false, true] (app [false, false, false, true] (rep z [false, false, false, true]
      (app [false, false, false, true] (app [false, false, false, false, false, true]
        (Wacc rs.reverse (rep (t + 1) [false, false, false, true] (cons true (cons true (rep a [false, false, false, true] L)))))))))
      = app [false, false, true] (rep (z + 2) [false, false, false, true] (Zc rs (Zdig t (Tdig a L)))) := by
    rw [endE, Wacc_eq, Zacc_eq, List.reverse_reverse, e3]; rfl
  have hc : 4 * z + 3 + (fcost (rs ++ [t + 2]) + (8 * (t + 1) + 15 + (bcost rs.reverse + (8 * z + 18))))
      = 12 * z + cost rs + 12 * (t + 2) + 34 := by
    rw [fcost_append, bcost_reverse, ← cost_split]; simp [fcost]; omega
  have := steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5)))
  rw [hc] at this
  exact this.trans (congrArg (fun r => some (⟨blank, r, .C⟩ : Config)) e5)

end H44149
