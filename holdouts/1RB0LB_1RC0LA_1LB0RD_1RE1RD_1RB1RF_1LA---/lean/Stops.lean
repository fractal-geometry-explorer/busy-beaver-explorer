    steps (12 * z + 34) ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L))))))))))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))))))))), .A⟩ := by
  have hn : 1 + (0 + ((z) * 4 + (21 + (0 + ((z) * 8 + (12)))))) = 12 * z + 34 := by omega
  have h0 : steps 1 ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L))))))))))))), .A⟩ = some ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L)))))))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L)))))))))))), .B⟩ = some ⟨cons true (blank), rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L)))))))))))), .B⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L)))))))))))) = rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L)))))))))))) from
      rep_rotate (z) [false, true] [false, false, false, true] [false, true, false, false] rfl (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L))))))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, false] R, .B⟩ = some ⟨app [] (app [true, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((z) * 4) ⟨cons true (blank), rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L)))))))))))), .B⟩ = some ⟨rep (z) [true, true, false, true] (cons true (blank)), cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L))))))))))), .B⟩ :=
    cross_r trans c2 (z) (cons true (blank)) (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L))))))))))))
  have h3 : steps 21 ⟨rep (z) [true, true, false, true] (cons true (blank)), cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons true (rep (v + 1) [false, false, false, true] (L))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .A⟩ = some ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .A⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))) = rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))) from
      rep_rotate (z) [true, false, true] [true, true, false, true] [true, false, true, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 8 ⟨app [true, false, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, false, false, true] R), .A⟩ := fun _ _ => rfl
  have h5 : steps ((z) * 8) ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .A⟩ = some ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))), .A⟩ :=
    cross_l trans c5 (z) (cons true (cons false (cons true (cons true (blank))))) (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))
  have h6 : steps 12 ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- The carry stops on b1_1 (v+1 blocks) after a top T digit of `s + 1` blocks. -/
theorem stopW_b1_1 (s v : Nat) (X L : Tape) :
    steps (8 * s + 15) ⟨rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X))))))), cons false (cons true (rep (v + 1) [false, false, false, true] (L))), .D⟩ = some ⟨cons true (cons true (cons true (X))), cons false (cons false (cons false (cons false (cons false (rep (s + 1) [false, false, false, true] (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .A⟩ := by
  have hn : 3 + (0 + ((s + 1) * 8 + (4))) = 8 * s + 15 := by omega
  have h0 : steps 3 ⟨rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X))))))), cons false (cons true (rep (v + 1) [false, false, false, true] (L))), .D⟩ = some ⟨cons true (rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))), cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))), .A⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))), cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))), .A⟩ = some ⟨rep (s + 1) [true, false, true, true] (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))), cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))), .A⟩ := by
    simp only [steps_zero, show cons true (rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))) = rep (s + 1) [true, false, true, true] (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))) from
      rep_rotate (s + 1) [true] [false, true, true, true] [true, false, true, true] rfl (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))]
  have c2 : ∀ L R : Tape, steps 8 ⟨app [true, false, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, false, false, true] R), .A⟩ := fun _ _ => rfl
  have h2 : steps ((s + 1) * 8) ⟨rep (s + 1) [true, false, true, true] (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))), cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))), .A⟩ = some ⟨cons true (cons true (cons true (cons false (cons true (cons true (cons true (X))))))), cons true (rep (s + 1) [false, false, false, true] (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))), .A⟩ :=
    cross_l trans c2 (s + 1) (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))) (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))
  have h3 : steps 4 ⟨cons true (cons true (cons true (cons false (cons true (cons true (cons true (X))))))), cons true (rep (s + 1) [false, false, false, true] (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))), .A⟩ = some ⟨cons true (cons true (cons true (X))), cons false (cons false (cons false (cons false (cons false (rep (s + 1) [false, false, false, true] (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- A borrow: the carry stops on b1_1 (v+1 blocks) after a T digit of `r` blocks and one with no block. -/
theorem borrowW_b1_1 (r v : Nat) (X L : Tape) :
    steps (8 * r + 17) ⟨cons true (cons true (cons false (cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X))))))))))))), cons false (cons true (rep (v + 1) [false, false, false, true] (L))), .D⟩ = some ⟨cons true (cons true (cons true (X))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (rep (r) [false, false, false, true] (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))))))), .A⟩ := by
  have hn : 7 + (0 + ((r) * 8 + (10))) = 8 * r + 17 := by omega
  have h0 : steps 7 ⟨cons true (cons true (cons false (cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X))))))))))))), cons false (cons true (rep (v + 1) [false, false, false, true] (L))), .D⟩ = some ⟨cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))), .A⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))), .A⟩ = some ⟨rep (r) [true, true, true, false] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))), .A⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))) = rep (r) [true, true, true, false] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))) from
      rep_rotate (r) [true, true, true] [false, true, true, true] [true, true, true, false] rfl (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))]
  have c2 : ∀ L R : Tape, steps 8 ⟨app [true, true, true, false] L, app [false, false, false] R, .A⟩ = some ⟨L, app [false, false, false] (app [false, false, false, true] R), .A⟩ := fun _ _ => rfl
  have h2 : steps ((r) * 8) ⟨rep (r) [true, true, true, false] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X))))))))), cons false (cons false (cons false (rep (r) [false, false, false, true] (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .A⟩ :=
    cross_l trans c2 (r) (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))) (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))
  have h3 : steps 10 ⟨cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X))))))))), cons false (cons false (cons false (rep (r) [false, false, false, true] (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .A⟩ = some ⟨cons true (cons true (cons true (X))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (rep (r) [false, false, false, true] (cons false (cons false (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- No T digit: the carry stops on b2_2 (v blocks) at the bottom. -/
theorem bottom_b2_2 (v z : Nat) (L : Tape) :
    steps (12 * z + 18) ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .A⟩ := by
  have hn : 1 + (0 + ((z) * 4 + (5 + (0 + ((z) * 8 + (12)))))) = 12 * z + 18 := by omega
  have h0 : steps 1 ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))))), .A⟩ = some ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))), .B⟩ = some ⟨cons true (blank), rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))), .B⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))) = rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))) from
      rep_rotate (z) [false, true] [false, false, false, true] [false, true, false, false] rfl (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, false] R, .B⟩ = some ⟨app [] (app [true, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((z) * 4) ⟨cons true (blank), rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))), .B⟩ = some ⟨rep (z) [true, true, false, true] (cons true (blank)), cons false (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))), .B⟩ :=
    cross_r trans c2 (z) (cons true (blank)) (cons false (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))))
  have h3 : steps 5 ⟨rep (z) [true, true, false, true] (cons true (blank)), cons false (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))), .B⟩ = some ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons true (rep (v) [false, false, false, true] (L)))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons true (rep (v) [false, false, false, true] (L)))), .A⟩ = some ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons true (rep (v) [false, false, false, true] (L)))), .A⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))) = rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))) from
      rep_rotate (z) [true, false, true] [true, true, false, true] [true, false, true, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 8 ⟨app [true, false, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, false, false, true] R), .A⟩ := fun _ _ => rfl
  have h5 : steps ((z) * 8) ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons true (rep (v) [false, false, false, true] (L)))), .A⟩ = some ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, false, true] (cons false (cons true (rep (v) [false, false, false, true] (L))))), .A⟩ :=
    cross_l trans c5 (z) (cons true (cons false (cons true (cons true (blank))))) (cons false (cons true (rep (v) [false, false, false, true] (L))))
  have h6 : steps 12 ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, false, true] (cons false (cons true (rep (v) [false, false, false, true] (L))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- A borrow at the bottom: one T digit with no block, then b2_2 (v blocks). -/
