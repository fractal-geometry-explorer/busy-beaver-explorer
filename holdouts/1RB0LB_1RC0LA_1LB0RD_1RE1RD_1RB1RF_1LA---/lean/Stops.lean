    steps (12 * z + 34) ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))))))))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))))))), .A⟩ := by
