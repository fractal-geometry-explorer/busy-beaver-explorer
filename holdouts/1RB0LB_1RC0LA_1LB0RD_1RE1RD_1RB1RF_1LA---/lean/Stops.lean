theorem stopE_b2_3_b1_2 (s v : Nat) (X L : Tape) :
    steps (6 * s + 25) ⟨rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X))))))), cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))), .D⟩ = some ⟨cons true (cons true (cons true (X))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (rep (s + 1) [false, false, false, true] (cons false (cons false (cons false (rep (v) [false, false, false, true] (L))))))))))))), .B⟩ := by
  have hn : 11 + (0 + ((s + 1) * 6 + (8))) = 6 * s + 25 := by omega
  have h0 : steps 11 ⟨rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X))))))), cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))), .D⟩ = some ⟨cons true (cons true (cons true (rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (cons true (rep (s + 1) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))), .B⟩ = some ⟨rep (s + 1) [true, true, true, false] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))), .B⟩ := by
