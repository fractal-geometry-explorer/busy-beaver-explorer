  have h0 : steps 1 ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L))))))))))))))), .A⟩ = some ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))))))))), .B⟩ = some ⟨cons true (blank), rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))))))))), .B⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))))))))) = rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons true (cons true (rep (v) [false, false, false, true] (L)))))))))))))) from
