  have c4 : ∀ L R : Tape, steps 8 ⟨app [true, false, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, false, false, true] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((v) * 8) ⟨rep (v) [true, false, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X))))))))))))))))))))))), cons true (cons true (cons true (rep (u) [false, false, false, true] (L)))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))))))))))))))), cons true (rep (v) [false, false, false, true] (cons true (cons true (rep (u) [false, false, false, true] (L))))), .A⟩ :=
