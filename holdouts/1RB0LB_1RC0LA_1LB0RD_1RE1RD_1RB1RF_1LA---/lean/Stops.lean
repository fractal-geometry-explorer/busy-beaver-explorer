/-- On the way back towards E0, one more T digit becomes a Z digit with the same run. -/
theorem retE (r : Nat) (X M : Tape) :
    steps (6 * r + 8) ⟨cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))), .B⟩ = some ⟨cons true (cons true (cons true (X))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (rep (r) [false, false, false, true] (cons false (cons false (cons false (cons false (cons false (cons true (M))))))))))))))), .B⟩ := by
  have hn : 0 + ((r) * 6 + (8)) = 6 * r + 8 := by omega
  have h0 : steps 0 ⟨cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))), .B⟩ = some ⟨rep (r) [true, true, true, false] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (r) [false, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))) = rep (r) [true, true, true, false] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))) from
      rep_rotate (r) [true, true, true] [false, true, true, true] [true, true, true, false] rfl (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))]
  have c1 : ∀ L R : Tape, steps 6 ⟨app [true, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [false, false, false, true] R), .B⟩ := fun _ _ => rfl
  have h1 : steps ((r) * 6) ⟨rep (r) [true, true, true, false] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))), .B⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X))))))))), cons false (cons false (rep (r) [false, false, false, true] (cons false (cons false (cons false (cons false (cons false (cons true (M))))))))), .B⟩ :=
    cross_l trans c1 (r) (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X)))))))))) (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))
  have h2 : steps 8 ⟨cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (X))))))))), cons false (cons false (rep (r) [false, false, false, true] (cons false (cons false (cons false (cons false (cons false (cons true (M))))))))), .B⟩ = some ⟨cons true (cons true (cons true (X))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (rep (r) [false, false, false, true] (cons false (cons false (cons false (cons false (cons false (cons true (M))))))))))))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- Back to the sample: the end run gains a block and the end becomes E0. -/
theorem endE0 (z : Nat) (M : Tape) :
    steps (6 * z + 11) ⟨cons true (cons true (cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))), .B⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons true (cons false (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))))))))))), .A⟩ := by
  have hn : 4 + (0 + ((z) * 6 + (7))) = 6 * z + 11 := by omega
  have h0 : steps 4 ⟨cons true (cons true (cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))))), cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))), .B⟩ = some ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))))), .B⟩ = some ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))) = rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))) from
      rep_rotate (z) [true, false, true] [true, true, false, true] [true, false, true, true] rfl (cons true (blank))]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [true, false, true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, false, true, false] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((z) * 6) ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M))))))))))), .B⟩ :=
    cross_l trans c2 (z) (cons true (cons false (cons true (cons true (blank))))) (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M))))))))))
  have h3 : steps 7 ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M))))))))))), .B⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons true (cons false (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (M)))))))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- **From an E0 sample, whatever the rest of the tape:** 8 steps to the next sample, an E sample, the end run having become an O digit. -/
theorem e0toE (z : Nat) (L : Tape) :
    steps (8) ⟨blank, cons false (cons false (cons false (cons false (cons true (rep (z) [false, false, false, true] (L)))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (z) [false, false, false, true] (L)))))))), .A⟩ := by
  have hn : 8 = 8 := by omega
  have h0 : steps 8 ⟨blank, cons false (cons false (cons false (cons false (cons true (rep (z) [false, false, false, true] (L)))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (z) [false, false, false, true] (L)))))))), .A⟩ := rfl
  exact steps_congr trans hn (h0)

/-- No T digit: the carry stops on b2_3 (0 blocks), then b1_2 (v blocks) and the sweep ends at E0. -/
theorem bottomE_b2_3_b1_2 (v z : Nat) (L : Tape) :
    steps (10 * z + 25) ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))), .A⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons true (cons false (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))))))))))), .A⟩ := by
  have hn : 1 + (0 + ((z) * 4 + (17 + (0 + ((z) * 6 + (7)))))) = 10 * z + 25 := by omega
  have h0 : steps 1 ⟨blank, cons false (cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))), .A⟩ = some ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .B⟩ = some ⟨cons true (blank), rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .B⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (z) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))) = rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))) from
      rep_rotate (z) [false, true] [false, false, false, true] [false, true, false, false] rfl (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, false] R, .B⟩ = some ⟨app [] (app [true, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((z) * 4) ⟨cons true (blank), rep (z) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L)))))))))))), .B⟩ = some ⟨rep (z) [true, true, false, true] (cons true (blank)), cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .B⟩ :=
    cross_r trans c2 (z) (cons true (blank)) (cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))))
  have h3 : steps 17 ⟨rep (z) [true, true, false, true] (cons true (blank)), cons false (cons true (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (rep (v) [false, false, false, true] (L))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))))), .B⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))))), .B⟩ = some ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (z) [true, true, false, true] (cons true (blank))))) = rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))) from
      rep_rotate (z) [true, false, true] [true, true, false, true] [true, false, true, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 6 ⟨app [true, false, true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, false, true, false] R), .B⟩ := fun _ _ => rfl
  have h5 : steps ((z) * 6) ⟨rep (z) [true, false, true, true] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L))))))))), .B⟩ :=
    cross_l trans c5 (z) (cons true (cons false (cons true (cons true (blank))))) (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L))))))))
  have h6 : steps 7 ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L))))))))), .B⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons true (cons false (rep (z) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (rep (v) [false, false, false, true] (L)))))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

