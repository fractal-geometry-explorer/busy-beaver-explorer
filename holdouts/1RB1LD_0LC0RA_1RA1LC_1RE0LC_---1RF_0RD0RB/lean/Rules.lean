/-- Going left, the head zigzags across the block of 10s in states C and A, two cells every four steps. -/
theorem zig (n : Nat) (L R : Tape) :
    steps (4 * n + 4) ⟨cons false (cons true (rep (n) [false, true] (L))), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (cons false (cons true (R)))), .C⟩ := by
  have h0 : steps 4 ⟨cons false (cons true (rep (n) [false, true] (L))), cons true (R), .C⟩ = some ⟨rep (n) [false, true] (L), cons true (cons false (cons true (R))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨rep (n) [false, true] (L), cons true (cons false (cons true (R))), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (cons false (cons true (R)))), .C⟩ :=
    cross_l trans c1 (n) (L) (cons false (cons true (R)))
  exact steps_congr trans (a := 4 + ((n) * 4)) (by omega) (steps_seq trans h0 (h1))

/-- Going right, the head runs across the block in states B and A, one cell a step, rewriting each 10 as 01. -/
theorem run_right (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, false] (R), .B⟩ = some ⟨rep (n) [true, false] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, false] (R), .B⟩ = some ⟨rep (n) [true, false] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

