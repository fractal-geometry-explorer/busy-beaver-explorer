/-- Both directions: a configuration halts after exactly 3 more steps if and only if it matches one of the windows of `halt_pred_3`. -/
theorem halt_iff_3 (c : Config) : (∃ c', steps 3 c = some c' ∧ step c' = none) ↔
    ((c.st = .B ∧ c.l 0 = true ∧ c.r 0 = false ∧ c.r 1 = true) ∨ (c.st = .D ∧ c.l 2 = true ∧ c.l 1 = true ∧ c.l 0 = true ∧ c.r 0 = true) ∨ (c.st = .E ∧ c.l 2 = true ∧ c.l 1 = true ∧ c.l 0 = true ∧ c.r 0 = false) ∨ (c.st = .F ∧ c.l 2 = true ∧ c.l 1 = true ∧ c.l 0 = true ∧ c.r 0 = false)) := by
  constructor
  · rintro ⟨c', h, hn⟩; exact halt_pred_3 c c' h hn
  · obtain ⟨l, r, s⟩ := c
    intro hw
    rcases hw with ⟨hs, w0, w1, w2⟩ | ⟨hs, w0, w1, w2, w3⟩ | ⟨hs, w0, w1, w2, w3⟩ | ⟨hs, w0, w1, w2, w3⟩
    · simp only at hs w0 w1 w2; subst hs
      simp [steps, step, TM.steps, TM.step, trans, TM.tail, w0, w1, w2]
    · simp only at hs w0 w1 w2 w3; subst hs
      simp [steps, step, TM.steps, TM.step, trans, TM.tail, w0, w1, w2, w3]
    · simp only at hs w0 w1 w2 w3; subst hs
      simp [steps, step, TM.steps, TM.step, trans, TM.tail, w0, w1, w2, w3]
    · simp only at hs w0 w1 w2 w3; subst hs
      simp [steps, step, TM.steps, TM.step, trans, TM.tail, w0, w1, w2, w3]

/-- If the machine halts from blank tape, the run passes through one of the windows of `halt_pred_3`. -/
theorem halts_blank_pred_3 (hh : HaltsFromBlank) :
    ∃ n c, steps n init = some c ∧ ((c.st = .B ∧ c.l 0 = true ∧ c.r 0 = false ∧ c.r 1 = true) ∨ (c.st = .D ∧ c.l 2 = true ∧ c.l 1 = true ∧ c.l 0 = true ∧ c.r 0 = true) ∨ (c.st = .E ∧ c.l 2 = true ∧ c.l 1 = true ∧ c.l 0 = true ∧ c.r 0 = false) ∨ (c.st = .F ∧ c.l 2 = true ∧ c.l 1 = true ∧ c.l 0 = true ∧ c.r 0 = false)) := by
  obtain ⟨n, c', h1, h2⟩ := hh
  obtain ⟨c0, h0⟩ := blank_runs_kernel
  have hn : 3 ≤ n := by
    refine Nat.le_of_not_lt (fun hlt => ?_)
    have := TM.steps_halt trans h1 h2 (10000 - n - 1)
    rw [show n + (10000 - n - 1 + 1) = 10000 by omega] at this
    simp_all
  obtain ⟨c, hc, hc'⟩ := steps_split (n - 3) 3 init c' (by rw [show n - 3 + 3 = n by omega]; exact h1)
  exact ⟨n - 3, c, hc, halt_pred_3 c c' hc' h2⟩

