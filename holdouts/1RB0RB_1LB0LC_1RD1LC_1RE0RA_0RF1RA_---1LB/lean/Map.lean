import Steps
import Rules

/-!
# 1RB0RB_1LB0LC_1RD1LC_1RE0RA_0RF1RA_---1LB: the hole map, proved

Hand-written; the rules it chains are proved in `Steps.lean` (generated by `py/steps.py` with `bbtools.symtm`) and
the halting family in `Rules.lean`.

`S p r` is the sample: the head in state C on the leftmost cell of `1^p 0 1^r` (blank tape on both sides): a run of
ones with one hole, `p` ones before it and `r` after it. For `p, r ≥ 1` the machine goes from `S p r` to the next
sample `S p' r'` given by `f p r`, in `cost p r` steps, or halts (`f p r = none`, which is `p = 2` and `3 ∣ r`):

* `p = 1`:          `S 1 r      → S (r + 4) 1`
* `p = 2`:          `S 2 (3m+1) → S (3m + 6) 1`,  `S 2 (3m+2) → S (3m + 5) 2`,  `S 2 (3m+3)` halts
* `p = 3k + 3`:     `S p r → S (4k + r + 6) 1`
* `p = 3k + 4`:     `S p r → S (4k + r + 8) 1`
* `p = 3k + 5`:     `S p r → S (k + 1) (2k + r + 5)`   (the division by 3)

From blank tape the machine reaches `S 3 1` in 11 steps. `halts_iff`: the machine halts from blank tape iff the
orbit of `(3, 1)` under `f` reaches the halting case.
-/

namespace H86694

open TM

/-! ## Iterating a rule -/

/-- `g` applied `n` times. -/
def it {α : Type} (g : α → α) : Nat → α → α
  | 0, a => a
  | n + 1, a => it g n (g a)

/-- The steps of `n` uses of a rule whose `n`-th use costs `s n a`. -/
def iterSteps {α : Type} (s : Nat → α → Nat) (g : α → α) : Nat → α → Nat
  | 0, _ => 0
  | n + 1, a => s n a + iterSteps s g n (g a)

/-- A rule `F (n+1) a → F n (g a)` used `n` times. -/
theorem iterate {α : Type} (F : Nat → α → Config) (g : α → α) (s : Nat → α → Nat)
    (h : ∀ n a, steps (s n a) (F (n + 1) a) = some (F n (g a))) :
    ∀ n a, steps (iterSteps s g n a) (F n a) = some (F 0 (it g n a)) := by
  intro n
  induction n with
  | zero => intro a; rfl
  | succ n ih => intro a; exact steps_seq trans (h n a) (ih (g a))

theorem it_app (w : List Bool) (n : Nat) : ∀ L, it (app w) n L = rep n w L := by
  induction n with
  | zero => intro L; rfl
  | succ n ih => intro L; show it (app w) n (app w L) = _; rw [ih, rep_app_comm]

theorem it_pair (u v : List Bool) (n : Nat) : ∀ L R,
    it (fun x : Tape × Tape => (app u x.1, app v x.2)) n (L, R) = (rep n u L, rep n v R) := by
  induction n with
  | zero => intro L R; rfl
  | succ n ih =>
    intro L R
    show it (fun x : Tape × Tape => (app u x.1, app v x.2)) n (app u L, app v R) = _
    rw [ih, rep_app_comm, rep_app_comm]

/-- `n (n - 1) / 2`. -/
def tri (n : Nat) : Nat := n * (n - 1) / 2

theorem tri_succ (n : Nat) : tri (n + 1) = tri n + n := by
  unfold tri
  cases n with
  | zero => rfl
  | succ n =>
    rw [show n + 1 + 1 - 1 = n + 1 by omega, show n + 1 - 1 = n by omega, Nat.succ_mul, Nat.mul_succ]
    omega

theorem iter_const {α : Type} (c : Nat) (g : α → α) (n : Nat) : ∀ a, iterSteps (fun _ _ => c) g n a = c * n := by
  induction n with
  | zero => intro a; rfl
  | succ n ih => intro a; simp only [iterSteps, ih, Nat.mul_succ]; omega

theorem iter_lin {α : Type} (x y : Nat) (g : α → α) (n : Nat) :
    ∀ a, iterSteps (fun n _ => x * n + y) g n a = x * tri n + y * n := by
  induction n with
  | zero => intro a; rfl
  | succ n ih => intro a; simp only [iterSteps, ih, tri_succ, Nat.mul_succ, Nat.mul_add]; omega

/-! ## Runs of ones -/

theorem ones_cons (n : Nat) (s : Tape) : rep n [true] (cons true s) = rep (n + 1) [true] s :=
  rep_app_comm n [true] s

theorem ones_add (a b : Nat) (s : Tape) : rep a [true] (rep b [true] s) = rep (a + b) [true] s :=
  (rep_add a b [true] s).symm

theorem ones3 (k : Nat) (s : Tape) : rep k [true, true, true] s = rep (3 * k) [true] s := by
  induction k with
  | zero => rfl
  | succ k ih => rw [show 3 * (k + 1) = 3 * k + 1 + 1 + 1 by omega, rep_succ, ih]; rfl

theorem ones4 (k : Nat) (s : Tape) : rep k [true, true, true, true] s = rep (4 * k) [true] s := by
  induction k with
  | zero => rfl
  | succ k ih => rw [show 4 * (k + 1) = 4 * k + 1 + 1 + 1 + 1 by omega, rep_succ, ih]; rfl

theorem ones2 (k : Nat) (s : Tape) : rep k [true, true] s = rep (2 * k) [true] s := by
  induction k with
  | zero => rfl
  | succ k ih => rw [show 2 * (k + 1) = 2 * k + 1 + 1 by omega, rep_succ, ih]; rfl

theorem rep3_comm (k : Nat) (s : Tape) :
    rep k [true, true, true] (cons true (cons true (cons true s))) = rep (k + 1) [true, true, true] s :=
  rep_app_comm k [true, true, true] s

/-! ## The sample and the map -/

/-- The sample `C> 1^p 0 1^r` on blank tape. -/
def S (p r : Nat) : Config := ⟨blank, rep p [true] (cons false (rep r [true] blank)), .C⟩

/-- The hole map (`none`: the machine halts). Meant for `p, r ≥ 1`. -/
def f (p r : Nat) : Option (Nat × Nat) :=
  if p = 1 then some (r + 4, 1)
  else if p = 2 then (if r % 3 = 1 then some (r + 5, 1) else if r % 3 = 2 then some (r + 3, 2) else none)
  else if p % 3 = 0 then some (4 * (p / 3 - 1) + r + 6, 1)
  else if p % 3 = 1 then some (4 * ((p - 4) / 3) + r + 8, 1)
  else some ((p - 5) / 3 + 1, 2 * ((p - 5) / 3) + r + 5)

/-- Steps from `S p r` to the next sample. -/
def cost (p r : Nat) : Nat :=
  if p = 1 then 6 * (r - 1) + 21
  else if p = 2 then 8 * ((r - 1) / 3) + 24
  else if p % 3 = 0 then
    (8 * (p / 3 - 1) + 11) + (8 * (p / 3 - 1) + 5) * (r + 1) + (32 * tri (p / 3 - 1) + 34 * (p / 3 - 1))
      + (4 * (p / 3 - 1) + r + 2 + 15)
  else if p = 4 then 11 + 13 * (r - 1) + (r + 55)
  else if p % 3 = 1 then
    (8 * ((p - 4) / 3) + 11) + (8 * ((p - 4) / 3) + 13) * (r - 1) + (64 * ((p - 7) / 3) + 102)
      + (32 * tri ((p - 7) / 3) + 34 * ((p - 7) / 3)) + (4 * ((p - 7) / 3) + r + 8 + 15)
  else (8 * ((p - 5) / 3) + 14) + (8 * tri ((p - 5) / 3) + 13 * ((p - 5) / 3)) + ((p - 5) / 3 + 7)

/-! ## The cases -/

/-- `0 C> 1 (111)^k 0` drifting right over `n` ones. -/
theorem drift0_n (k n : Nat) (L : Tape) :
    steps ((8 * k + 5) * n) ⟨cons false L, cons true (rep k [true, true, true] (cons false (rep n [true] blank))), .C⟩
      = some ⟨cons false (rep n [true] L), cons true (rep k [true, true, true] (cons false blank)), .C⟩ := by
  have h := iterate (fun n L => ⟨cons false L, cons true (rep k [true, true, true] (cons false (rep n [true] blank))), .C⟩)
    (app [true]) (fun _ _ => 8 * k + 5) (fun n L => drift0 k L (rep n [true] blank)) n L
  rw [iter_const, it_app] at h
  exact h

/-- The block at the right end, used up `k` times. -/
theorem loop0_n (k : Nat) (L : Tape) :
    steps (32 * tri k + 34 * k) ⟨cons false L, cons true (rep k [true, true, true] (cons false blank)), .C⟩
      = some ⟨cons false (rep (4 * k) [true] L), cons true (cons false blank), .C⟩ := by
  have h := iterate (fun n L => ⟨cons false L, cons true (rep n [true, true, true] (cons false blank)), .C⟩)
    (app [true, true, true, true]) (fun n _ => 32 * n + 34)
    (fun n L => by have := loop0 n L; rw [rep3_comm] at this; exact this) k L
  rw [iter_lin, it_app, ones4] at h
  exact h

/-- `0 1 1 C> 1 (111)^k 1 0` drifting right over `n` ones. -/
theorem drift1_n (k n : Nat) (L : Tape) :
    steps ((8 * k + 13) * n)
      ⟨cons true (cons true (cons false L)), cons true (rep k [true, true, true] (cons true (cons false (rep n [true] blank)))), .C⟩
      = some ⟨cons true (cons true (cons false (rep n [true] L))),
          cons true (rep k [true, true, true] (cons true (cons false blank))), .C⟩ := by
  have h := iterate (fun n L => ⟨cons true (cons true (cons false L)),
      cons true (rep k [true, true, true] (cons true (cons false (rep n [true] blank)))), .C⟩)
    (app [true]) (fun _ _ => 8 * k + 13) (fun n L => drift1 k L (rep n [true] blank)) n L
  rw [iter_const, it_app] at h
  exact h

/-- `k` division rounds. -/
theorem roundD_n (k : Nat) (L R : Tape) :
    steps (8 * tri k + 13 * k) ⟨L, cons false (cons true (cons true (rep k [true, true, true] (cons false R)))), .C⟩
      = some ⟨rep k [true] L, cons false (cons true (cons true (cons false (rep k [true, true] R)))), .C⟩ := by
  have h := iterate (fun n (x : Tape × Tape) =>
      (⟨x.1, cons false (cons true (cons true (rep n [true, true, true] (cons false x.2)))), .C⟩ : Config))
    (fun x : Tape × Tape => (app [true] x.1, app [true, true] x.2)) (fun n _ => 8 * n + 13)
    (fun n x => by have := roundD n x.1 x.2; rw [rep3_comm] at this; exact this) k (L, R)
  rw [iter_lin, it_pair] at h
  exact h

theorem steps_conv {n : Nat} {a a' b b' : Config} (h : steps n a = some b) (ha : a' = a) (hb : b = b') :
    steps n a' = some b' := by
  subst ha; subst hb; exact h

theorem cons_ones (n : Nat) (s : Tape) : cons true (rep n [true] s) = rep (n + 1) [true] s := rfl

theorem ones_eq {a b : Nat} (s : Tape) (h : a = b) : rep a [true] s = rep b [true] s := by rw [h]

theorem one_rep (s : Tape) : cons true s = rep 1 [true] s := rfl

/-- Two configurations that differ only in how their runs of ones are written. -/
macro "tape_eq" : tactic =>
  `(tactic| (simp only [S, one_rep, ones_add, ones2, ones3, ones4]; repeat (first | omega | rfl | congr 1)))

theorem final0' (j : Nat) :
    steps (j + 15) ⟨cons false (rep j [true] blank), cons true (cons false blank), .C⟩ = some (S (j + 4) 1) :=
  steps_conv (final0 j) rfl (by tape_eq)

theorem case0 (k R : Nat) :
    steps ((8 * k + 11) + ((8 * k + 5) * (R + 2) + ((32 * tri k + 34 * k) + (4 * k + (R + 3) + 15))))
      (S (3 * k + 3) (R + 1)) = some (S (4 * k + R + 7) 1) := by
  have h1 := steps_conv (init0 k (rep R [true] blank)) (a' := S (3 * k + 3) (R + 1)) (b' := ⟨cons false (cons true blank),
    cons true (rep k [true, true, true] (cons false (rep (R + 2) [true] blank))), .C⟩) (by tape_eq) (by tape_eq)
  have h2 := steps_conv (drift0_n k (R + 2) (cons true blank)) rfl
    (b' := ⟨cons false (rep (R + 3) [true] blank), cons true (rep k [true, true, true] (cons false blank)), .C⟩)
    (by tape_eq)
  have h3 := steps_conv (loop0_n k (rep (R + 3) [true] blank)) rfl
    (b' := ⟨cons false (rep (4 * k + (R + 3)) [true] blank), cons true (cons false blank), .C⟩) (by tape_eq)
  have h4 := steps_conv (final0' (4 * k + (R + 3))) rfl (b' := S (4 * k + R + 7) 1) (by tape_eq)
  exact steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 h4))

theorem case1z (R : Nat) :
    steps ((8 * 0 + 11) + ((8 * 0 + 13) * R + (R + 1 + 55))) (S 4 (R + 1)) = some (S (R + 9) 1) := by
  have h1 := steps_conv (init1 0 (rep R [true] blank)) (a' := S 4 (R + 1))
    (b' := ⟨cons true (cons true (cons false (cons true blank))),
      cons true (rep 0 [true, true, true] (cons true (cons false (rep R [true] blank)))), .C⟩) (by tape_eq) rfl
  have h2 := steps_conv (drift1_n 0 R (cons true blank)) rfl
    (b' := ⟨cons true (cons true (cons false (rep (R + 1) [true] blank))), cons true (cons true (cons false blank)), .C⟩)
    (by tape_eq)
  have h3 := steps_conv (end1z (R + 1)) rfl (b' := S (R + 9) 1) (by tape_eq)
  exact steps_seq trans h1 (steps_seq trans h2 h3)

theorem case1s (K R : Nat) :
    steps ((8 * (K + 1) + 11) + ((8 * (K + 1) + 13) * R + ((64 * K + 102) + ((32 * tri K + 34 * K)
        + (4 * K + (R + 9) + 15)))))
      (S (3 * K + 7) (R + 1)) = some (S (4 * K + R + 13) 1) := by
  have h1 := steps_conv (init1 (K + 1) (rep R [true] blank)) (a' := S (3 * K + 7) (R + 1))
    (b' := ⟨cons true (cons true (cons false (cons true blank))),
      cons true (rep (K + 1) [true, true, true] (cons true (cons false (rep R [true] blank)))), .C⟩) (by tape_eq) rfl
  have h2 := steps_conv (drift1_n (K + 1) R (cons true blank)) rfl
    (b' := ⟨cons true (cons true (cons false (rep (R + 1) [true] blank))),
      cons true (rep K [true, true, true] (cons true (cons true (cons true (cons true (cons false blank)))))), .C⟩)
    (by rw [ones_cons, rep3_comm])
  have h3 := end1s K (rep (R + 1) [true] blank)
  have h4 := steps_conv (loop0_n K (rep (R + 9) [true] blank))
    (a' := ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true
      (rep (R + 1) [true] blank))))))))), cons true (rep K [true, true, true] (cons false blank)), .C⟩) (by tape_eq)
    (b' := ⟨cons false (rep (4 * K + (R + 9)) [true] blank), cons true (cons false blank), .C⟩) (by tape_eq)
  have h5 := steps_conv (final0' (4 * K + (R + 9))) rfl (b' := S (4 * K + R + 13) 1) (by tape_eq)
  exact steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5)))

theorem caseD (k r : Nat) :
    steps ((8 * k + 14) + ((8 * tri k + 13 * k) + (k + 7))) (S (3 * k + 5) r) = some (S (k + 1) (2 * k + r + 5)) := by
  have h1 := steps_conv (initD k (rep r [true] blank)) (a' := S (3 * k + 5) r) (by tape_eq) rfl
  have h2 := roundD_n k (cons true blank) (cons true (cons true (rep r [true] blank)))
  have h3 := steps_conv (endD k (rep k [true, true] (cons true (cons true (rep r [true] blank)))))
    (a' := ⟨rep k [true] (cons true blank), cons false (cons true (cons true (cons false
      (rep k [true, true] (cons true (cons true (rep r [true] blank))))))), .C⟩) (by tape_eq)
    (b' := S (k + 1) (2 * k + r + 5)) (by tape_eq)
  exact steps_seq trans h1 (steps_seq trans h2 h3)

theorem caseP1 (R : Nat) : steps (6 * R + 21) (S 1 (R + 1)) = some (S (R + 5) 1) :=
  steps_conv (p1 R) (by tape_eq) (by tape_eq)

theorem caseP2a (m : Nat) : steps (8 * m + 24) (S 2 (3 * m + 1)) = some (S (3 * m + 6) 1) :=
  steps_conv (p2a m) (by tape_eq) (by tape_eq)

theorem caseP2b (m : Nat) : steps (8 * m + 24) (S 2 (3 * m + 2)) = some (S (3 * m + 5) 2) :=
  steps_conv (p2b m) (by tape_eq) (by tape_eq)

theorem caseP2h (m : Nat) : Halts trans (S 2 (3 * m + 3)) := by
  have h := halts_family m
  rw [show S 2 (3 * m + 3) = ⟨blank, cons true (cons true (cons false (rep (m + 1) [true, true, true] blank))), .C⟩ by
    tape_eq]
  exact h

theorem f_c1 (R : Nat) : f 1 (R + 1) = some (R + 5, 1) := by simp [f]
theorem cost_c1 (R : Nat) : cost 1 (R + 1) = 6 * R + 21 := by simp [cost]

theorem f_c2a (m : Nat) : f 2 (3 * m + 1) = some (3 * m + 6, 1) := by
  unfold f; rw [if_neg (by omega), if_pos rfl, if_pos (by omega)]
theorem f_c2b (m : Nat) : f 2 (3 * m + 2) = some (3 * m + 5, 2) := by
  unfold f; rw [if_neg (by omega), if_pos rfl, if_neg (by omega), if_pos (by omega)]
theorem f_c2h (m : Nat) : f 2 (3 * m + 3) = none := by
  unfold f; rw [if_neg (by omega), if_pos rfl, if_neg (by omega), if_neg (by omega)]
theorem cost_c2 (r : Nat) : cost 2 r = 8 * ((r - 1) / 3) + 24 := by
  unfold cost; rw [if_neg (by omega), if_pos rfl]

theorem f_c0 (k R : Nat) : f (3 * k + 3) (R + 1) = some (4 * k + R + 7, 1) := by
  unfold f; rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  rw [show (3 * k + 3) / 3 - 1 = k by omega, show 4 * k + (R + 1) + 6 = 4 * k + R + 7 by omega]
theorem cost_c0 (k R : Nat) : cost (3 * k + 3) (R + 1) =
    (8 * k + 11) + ((8 * k + 5) * (R + 2) + ((32 * tri k + 34 * k) + (4 * k + (R + 3) + 15))) := by
  unfold cost; rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  rw [show (3 * k + 3) / 3 - 1 = k by omega, show R + 1 + 1 = R + 2 by omega]; omega

theorem f_c4 (R : Nat) : f 4 (R + 1) = some (R + 9, 1) := by
  unfold f; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  simp only [Option.some.injEq, Prod.mk.injEq]; exact ⟨by omega, trivial⟩
theorem cost_c4 (R : Nat) : cost 4 (R + 1) = (8 * 0 + 11) + ((8 * 0 + 13) * R + (R + 1 + 55)) := by
  unfold cost; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos rfl]; omega

theorem f_c1s (K R : Nat) : f (3 * K + 7) (R + 1) = some (4 * K + R + 13, 1) := by
  unfold f; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  rw [show (3 * K + 7 - 4) / 3 = K + 1 by omega, show 4 * (K + 1) + (R + 1) + 8 = 4 * K + R + 13 by omega]
theorem cost_c1s (K R : Nat) : cost (3 * K + 7) (R + 1) =
    (8 * (K + 1) + 11) + ((8 * (K + 1) + 13) * R + ((64 * K + 102) + ((32 * tri K + 34 * K)
        + (4 * K + (R + 9) + 15)))) := by
  unfold cost; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  rw [show (3 * K + 7 - 4) / 3 = K + 1 by omega, show (3 * K + 7 - 7) / 3 = K by omega, show R + 1 - 1 = R by omega]
  omega

theorem f_cD (k r : Nat) : f (3 * k + 5) r = some (k + 1, 2 * k + r + 5) := by
  unfold f; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]
  rw [show (3 * k + 5 - 5) / 3 = k by omega]
theorem cost_cD (k r : Nat) : cost (3 * k + 5) r = (8 * k + 14) + ((8 * tri k + 13 * k) + (k + 7)) := by
  unfold cost; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]
  rw [show (3 * k + 5 - 5) / 3 = k by omega]; omega

/-- One sample to the next: for `p, r ≥ 1`, `S p r` reaches `S p' r'` in `cost p r` steps when `f p r = some (p', r')`,
and halts when `f p r = none`. -/
theorem sample_step (p r : Nat) (hp : 1 ≤ p) (hr : 1 ≤ r) :
    match f p r with
    | some (p', r') => steps (cost p r) (S p r) = some (S p' r')
    | none => Halts trans (S p r) := by
  by_cases h1 : p = 1
  · subst h1
    obtain ⟨R, rfl⟩ : ∃ R, r = R + 1 := ⟨r - 1, by omega⟩
    rw [f_c1, cost_c1]; exact caseP1 R
  by_cases h2 : p = 2
  · subst h2
    obtain ⟨m, hm⟩ : ∃ m, r = 3 * m + 1 ∨ r = 3 * m + 2 ∨ r = 3 * m + 3 := ⟨(r - 1) / 3, by omega⟩
    rcases hm with rfl | rfl | rfl
    · rw [f_c2a, cost_c2, show (3 * m + 1 - 1) / 3 = m by omega]; exact caseP2a m
    · rw [f_c2b, cost_c2, show (3 * m + 2 - 1) / 3 = m by omega]; exact caseP2b m
    · rw [f_c2h]; exact caseP2h m
  obtain ⟨R, rfl⟩ : ∃ R, r = R + 1 := ⟨r - 1, by omega⟩
  by_cases h0 : p % 3 = 0
  · obtain ⟨k, rfl⟩ : ∃ k, p = 3 * k + 3 := ⟨p / 3 - 1, by omega⟩
    rw [f_c0, cost_c0]; exact case0 k R
  by_cases h4 : p = 4
  · subst h4
    rw [f_c4, cost_c4]; exact case1z R
  by_cases h1' : p % 3 = 1
  · obtain ⟨K, rfl⟩ : ∃ K, p = 3 * K + 7 := ⟨(p - 7) / 3, by omega⟩
    rw [f_c1s, cost_c1s]; exact case1s K R
  · obtain ⟨k, rfl⟩ : ∃ k, p = 3 * k + 5 := ⟨(p - 5) / 3, by omega⟩
    rw [f_cD, cost_cD]; exact caseD k (R + 1)

theorem f_dom (p r p' r' : Nat) (hr : 1 ≤ r) (h : f p r = some (p', r')) : 1 ≤ p' ∧ 1 ≤ r' := by
  unfold f at h
  split at h
  · cases h; omega
  split at h
  · split at h
    · cases h; omega
    split at h
    · cases h; omega
    · cases h
  split at h
  · cases h; omega
  split at h
  · cases h; omega
  · cases h; omega

theorem cost_pos (p r : Nat) : 1 ≤ cost p r := by
  unfold cost
  repeat (first | (split; omega) | split)
  all_goals omega

/-! ## The reduction -/

/-- The orbit of the first sample `(3, 1)`; `none` once the map has halted. -/
def orb : Nat → Option (Nat × Nat)
  | 0 => some (3, 1)
  | n + 1 => match orb n with
    | some (p, r) => f p r
    | none => none

theorem start_S : steps 11 init = some (S 3 1) := start

theorem halts_of_steps {a : Nat} {c c' : Config} (h : steps a c = some c') (h' : Halts trans c') : Halts trans c := by
  obtain ⟨n, c'', h1, h2⟩ := h'
  exact ⟨a + n, c'', steps_seq trans h h1, h2⟩

theorem reach (n : Nat) : ∀ p r, orb n = some (p, r) → 1 ≤ p ∧ 1 ≤ r ∧ ∃ t, n ≤ t ∧ steps t init = some (S p r) := by
  induction n with
  | zero =>
    intro p r h
    simp only [orb, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨by omega, by omega, 11, by omega, start_S⟩
  | succ n ih =>
    intro p' r' h
    simp only [orb] at h
    split at h
    · rename_i p r hpr
      obtain ⟨hp, hr, t, hn, ht⟩ := ih p r hpr
      have hs := sample_step p r hp hr
      rw [h] at hs
      obtain ⟨hp', hr'⟩ := f_dom p r p' r' hr h
      exact ⟨hp', hr', t + cost p r, by have := cost_pos p r; omega, steps_seq trans ht hs⟩
    · cases h

/-- **The reduction.** The machine halts from blank tape iff the orbit of `(3, 1)` under the hole map `f` reaches
the halting case (`p = 2` with `3 ∣ r`). -/
theorem halts_iff : HaltsFromBlank ↔ ∃ n, orb n = none := by
  constructor
  · intro hh
    apply Classical.byContradiction
    intro hne
    have hall : ∀ n, ∃ p r, orb n = some (p, r) := by
      intro n
      cases h : orb n with
      | none => exact absurd ⟨n, h⟩ hne
      | some x => exact ⟨x.1, x.2, rfl⟩
    apply not_halts_of_forall trans _ hh
    apply forall_of_unbounded trans (fun m => ∃ n p r, orb n = some (p, r) ∧ steps m init = some (S p r))
    · intro n
      obtain ⟨p, r, h⟩ := hall n
      obtain ⟨_, _, t, hn, ht⟩ := reach n p r h
      exact ⟨t, hn, n, p, r, h, ht⟩
    · rintro m ⟨n, p, r, _, hm⟩
      exact ⟨_, hm⟩
  · rintro ⟨n, hn⟩
    induction n with
    | zero => simp [orb] at hn
    | succ n ih =>
      cases h : orb n with
      | none => exact ih h
      | some x =>
        obtain ⟨p, r⟩ := x
        obtain ⟨hp, hr, t, _, ht⟩ := reach n p r h
        simp only [orb, h] at hn
        have hs := sample_step p r hp hr
        rw [hn] at hs
        exact halts_of_steps ht hs

end H86694
