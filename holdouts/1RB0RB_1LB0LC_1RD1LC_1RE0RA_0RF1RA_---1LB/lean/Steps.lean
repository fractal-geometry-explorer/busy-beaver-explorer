  have h3 : steps 9 ⟨rep (k) [true, true, true] (cons false (cons true (blank))), cons true (cons true (cons true (cons true (cons false (R))))), .A⟩ = some ⟨cons true (rep (k) [true, true, true] (cons false (cons true (blank)))), cons true (cons false (cons true (cons true (R)))), .C⟩ := rfl
