  have h0 : steps 3 ⟨blank, cons true (cons true (rep (k) [true, true, true] (cons true (cons true (cons true (cons false (R))))))), .C⟩ = some ⟨cons false (cons true (blank)), cons true (rep (k) [true, true, true] (cons true (cons true (cons true (cons false (R)))))), .A⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (blank)), cons true (rep (k) [true, true, true] (cons true (cons true (cons true (cons false (R)))))), .A⟩ = some ⟨cons false (cons true (blank)), rep (k) [true, true, true] (cons true (cons true (cons true (cons true (cons false (R)))))), .A⟩ := by
    simp only [steps_zero, show cons true (rep (k) [true, true, true] (cons true (cons true (cons true (cons false (R)))))) = rep (k) [true, true, true] (cons true (cons true (cons true (cons true (cons false (R)))))) from
      rep_rotate (k) [true] [true, true, true] [true, true, true] rfl (cons true (cons true (cons true (cons false (R)))))]
