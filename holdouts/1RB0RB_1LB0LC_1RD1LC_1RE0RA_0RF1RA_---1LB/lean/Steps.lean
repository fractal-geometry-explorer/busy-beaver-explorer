  have h0 : steps 2 ⟨L, cons false (cons true (cons true (rep (m) [true, true, true] (cons true (cons true (cons true (cons false (R)))))))), .C⟩ = some ⟨cons false (cons true (L)), cons true (rep (m) [true, true, true] (cons true (cons true (cons true (cons false (R)))))), .A⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (L)), cons true (rep (m) [true, true, true] (cons true (cons true (cons true (cons false (R)))))), .A⟩ = some ⟨cons false (cons true (L)), rep (m) [true, true, true] (cons true (cons true (cons true (cons true (cons false (R)))))), .A⟩ := by
