/-- The division ends in a sample with the hole at k+1. -/
theorem endD (a : Nat) (R : Tape) :
    steps (a + 7) ⟨cons true (rep (a) [true] (blank)), cons false (cons true (cons true (cons false (R)))), .C⟩ = some ⟨blank, cons true (rep (a) [true] (cons false (cons true (cons true (cons true (R)))))), .C⟩ := by
  have hn : 7 + ((a) * 1) = a + 7 := by omega
  have h0 : steps 7 ⟨cons true (rep (a) [true] (blank)), cons false (cons true (cons true (cons false (R)))), .C⟩ = some ⟨rep (a) [true] (blank), cons true (cons false (cons true (cons true (cons true (R))))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((a) * 1) ⟨rep (a) [true] (blank), cons true (cons false (cons true (cons true (cons true (R))))), .C⟩ = some ⟨blank, cons true (rep (a) [true] (cons false (cons true (cons true (cons true (R)))))), .C⟩ :=
    cross_l trans c1 (a) (blank) (cons false (cons true (cons true (cons true (R)))))
  exact steps_congr trans hn (steps_seq trans h0 (h1))

