/-- p = 2, N = 3m+5. -/
theorem p2b (m : Nat) :
    steps (8 * m + 24) ⟨blank, cons true (cons true (cons false (cons true (rep (m) [true, true, true] (cons true (blank)))))), .C⟩ = some ⟨blank, cons true (cons true (cons true (cons true (cons true (rep (m) [true, true, true] (cons false (cons true (cons true (blank))))))))), .C⟩ := by
  have hn : 12 + (0 + ((m) * 5 + (8 + (0 + ((m) * 3 + (4)))))) = 8 * m + 24 := by omega
  have h0 : steps 12 ⟨blank, cons true (cons true (cons false (cons true (rep (m) [true, true, true] (cons true (blank)))))), .C⟩ = some ⟨cons false (cons true (cons true (cons true (blank)))), cons true (cons true (rep (m) [true, true, true] (cons true (blank)))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (cons true (cons true (blank)))), cons true (cons true (rep (m) [true, true, true] (cons true (blank)))), .B⟩ = some ⟨cons false (cons true (cons true (cons true (blank)))), rep (m) [true, true, true] (cons true (cons true (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (m) [true, true, true] (cons true (blank)))) = rep (m) [true, true, true] (cons true (cons true (cons true (blank)))) from
      rep_rotate (m) [true, true] [true, true, true] [true, true, true] rfl (cons true (blank))]
  have c2 : ∀ L R : Tape, steps 5 ⟨app [false] L, app [true, true, true] R, .B⟩ = some ⟨app [false] (app [true, true, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((m) * 5) ⟨cons false (cons true (cons true (cons true (blank)))), rep (m) [true, true, true] (cons true (cons true (cons true (blank)))), .B⟩ = some ⟨cons false (rep (m) [true, true, true] (cons true (cons true (cons true (blank))))), cons true (cons true (cons true (blank))), .B⟩ :=
    cross_r trans c2 (m) (cons true (cons true (cons true (blank)))) (cons true (cons true (cons true (blank))))
  have h3 : steps 8 ⟨cons false (rep (m) [true, true, true] (cons true (cons true (cons true (blank))))), cons true (cons true (cons true (blank))), .B⟩ = some ⟨cons true (rep (m) [true, true, true] (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons true (blank)))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (m) [true, true, true] (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons true (blank)))), .C⟩ = some ⟨rep (m) [true, true, true] (cons true (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons true (blank)))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (m) [true, true, true] (cons true (cons true (cons true (blank))))) = rep (m) [true, true, true] (cons true (cons true (cons true (cons true (blank))))) from
      rep_rotate (m) [true] [true, true, true] [true, true, true] rfl (cons true (cons true (cons true (blank))))]
  have c5 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true, true] R), .C⟩ := fun _ _ => rfl
  have h5 : steps ((m) * 3) ⟨rep (m) [true, true, true] (cons true (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons true (blank)))), .C⟩ = some ⟨cons true (cons true (cons true (cons true (blank)))), cons true (rep (m) [true, true, true] (cons false (cons true (cons true (blank))))), .C⟩ :=
    cross_l trans c5 (m) (cons true (cons true (cons true (cons true (blank))))) (cons false (cons true (cons true (blank))))
  have h6 : steps 4 ⟨cons true (cons true (cons true (cons true (blank)))), cons true (rep (m) [true, true, true] (cons false (cons true (cons true (blank))))), .C⟩ = some ⟨blank, cons true (cons true (cons true (cons true (cons true (rep (m) [true, true, true] (cons false (cons true (cons true (blank))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

