      rep_rotate (m) [true] [true, true, true] [true, true, true] rfl (cons true (cons true (cons true (cons false (R)))))]
  have c2 : ∀ L R : Tape, steps 5 ⟨app [] L, app [true, true, true] R, .A⟩ = some ⟨app [] (app [true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h2 : steps ((m) * 5) ⟨cons false (cons true (L)), rep (m) [true, true, true] (cons true (cons true (cons true (cons true (cons false (R)))))), .A⟩ = some ⟨rep (m) [true, true, true] (cons false (cons true (L))), cons true (cons true (cons true (cons true (cons false (R))))), .A⟩ :=
    cross_r trans c2 (m) (cons false (cons true (L))) (cons true (cons true (cons true (cons true (cons false (R))))))
  have h3 : steps 9 ⟨rep (m) [true, true, true] (cons false (cons true (L))), cons true (cons true (cons true (cons true (cons false (R))))), .A⟩ = some ⟨cons true (rep (m) [true, true, true] (cons false (cons true (L)))), cons true (cons false (cons true (cons true (R)))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (m) [true, true, true] (cons false (cons true (L)))), cons true (cons false (cons true (cons true (R)))), .C⟩ = some ⟨rep (m) [true, true, true] (cons true (cons false (cons true (L)))), cons true (cons false (cons true (cons true (R)))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (m) [true, true, true] (cons false (cons true (L)))) = rep (m) [true, true, true] (cons true (cons false (cons true (L)))) from
      rep_rotate (m) [true] [true, true, true] [true, true, true] rfl (cons false (cons true (L)))]
  have c5 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true, true] R), .C⟩ := fun _ _ => rfl
  have h5 : steps ((m) * 3) ⟨rep (m) [true, true, true] (cons true (cons false (cons true (L)))), cons true (cons false (cons true (cons true (R)))), .C⟩ = some ⟨cons true (cons false (cons true (L))), cons true (rep (m) [true, true, true] (cons false (cons true (cons true (R))))), .C⟩ :=
    cross_l trans c5 (m) (cons true (cons false (cons true (L)))) (cons false (cons true (cons true (R))))
