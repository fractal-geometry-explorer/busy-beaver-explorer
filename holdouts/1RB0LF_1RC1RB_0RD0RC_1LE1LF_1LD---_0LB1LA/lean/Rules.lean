namespace H116372

open TM

/-- Leftward, D and E fill the zeros at the right with ones, 2 steps a pair. -/
theorem d_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [false, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [true, true] (R)), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [false, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [true, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Leftward, A and F turn the block of ones into (10)^n, 2 steps a pair. -/
theorem a_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [true, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, false] (R)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [true, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, false] (R)), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Rightward, a short zigzag turns each 10 back into 11, 10 steps a pair. -/
theorem d_zigzag (n : Nat) (L R : Tape) :
    steps (10 * n) ⟨cons false (cons false (L)), rep (n) [true, false] (R), .D⟩ = some ⟨cons false (cons false (rep (n) [true, true] (L))), R, .D⟩ := by
  have c0 : ∀ L R : Tape, steps 10 ⟨app [false, false] L, app [true, false] R, .D⟩ = some ⟨app [false, false] (app [true, true] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 10) ⟨cons false (cons false (L)), rep (n) [true, false] (R), .D⟩ = some ⟨cons false (cons false (rep (n) [true, true] (L))), R, .D⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 10) (by omega) (h0)

/-- Rightward, B crosses ones unchanged. -/
theorem b_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, true] (R), .B⟩ = some ⟨rep (n) [true, true] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (R), .B⟩ = some ⟨rep (n) [true, true] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Rightward, C turns ones into zeros (the ones written by D and E become zeros again). -/
theorem c_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, true] (R), .C⟩ = some ⟨rep (n) [false, false] (L), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .C⟩ = some ⟨app [] (app [false, false] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (R), .C⟩ = some ⟨rep (n) [false, false] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- The only way to a halt: D on a 0 with a 1 to its left puts E on that 1, which halts. -/
theorem halt_shape (L R : Tape) :
    steps (1) ⟨cons true (L), cons false (R), .D⟩ = some ⟨L, cons true (cons true (R)), .E⟩ := by
  have h0 : steps 1 ⟨cons true (L), cons false (R), .D⟩ = some ⟨L, cons true (cons true (R)), .E⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

/-- E reading a 1 halts (the end of `halt_shape`). -/
theorem halt_after_shape (L R : Tape) : step ⟨L, cons true R, .E⟩ = none := rfl

