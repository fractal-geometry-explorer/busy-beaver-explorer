  obtain ⟨m, c, e, hc⟩ := h1 (true) (cons true (cons false (cons x (L))))
  have a0 : steps 3 ⟨cons false (cons x (L)), cons false (cons true (cons false (cons false (s)))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons x (L))))), cons false (s), .C⟩ := rfl
  exact ⟨3 + m, c, steps_seq trans (a0) e, hc⟩

