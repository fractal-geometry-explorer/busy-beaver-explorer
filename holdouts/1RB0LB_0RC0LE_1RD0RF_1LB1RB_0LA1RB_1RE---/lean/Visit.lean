import Machine

/-! The two-form visit law of 1RB0LB_0RC0LE_1RD0RF_1LB1RB_0LA1RB_1RE---, generated by `py/visit2.py`; do not edit by hand.

A visit: the head stands on a 0 (the lead cell) with a 0 on its left and a stream `s` on its right, in state C
(`V s s'`) or in state F (`W s s'`); it comes back in state A two cells further left, both 0s restored and `s`
rewritten to `s'`.  `VH s`, `WH s`: the visit halts instead.  The rules below are for every stream, every cell `x`
and every left tape `L`. -/

namespace H60498

open TM

/-- One visit entered in state C rewrites the stream `s` to `s'`. -/
def V (s s' : Tape) : Prop :=
  ∀ (x : Bool) (L : Tape), ∃ n, steps n ⟨cons false (cons x L), cons false s, .C⟩ = some ⟨L, cons x (cons false (cons false s')), .A⟩

/-- A visit entered in state C to the stream `s` halts the machine. -/
def VH (s : Tape) : Prop :=
  ∀ (x : Bool) (L : Tape), ∃ n c, steps n ⟨cons false (cons x L), cons false s, .C⟩ = some c ∧ step c = none

/-- One visit entered in state F rewrites the stream `s` to `s'`. -/
def W (s s' : Tape) : Prop :=
  ∀ (x : Bool) (L : Tape), ∃ n, steps n ⟨cons false (cons x L), cons false s, .F⟩ = some ⟨L, cons x (cons false (cons false s')), .A⟩

/-- A visit entered in state F to the stream `s` halts the machine. -/
def WH (s : Tape) : Prop :=
  ∀ (x : Bool) (L : Tape), ∃ n c, steps n ⟨cons false (cons x L), cons false s, .F⟩ = some c ∧ step c = none

/-- V: `0 s` becomes `1 s'`; no nested visit. -/
theorem V_0 {s : Tape}  :
    V (cons false (s)) (cons true (s)) := by
  intro x L
  have a0 : steps 4 ⟨cons false (cons x (L)), cons false (cons false (s)), .C⟩ = some ⟨L, cons x (cons false (cons false (cons true (s)))), .A⟩ := rfl
  exact ⟨4, a0⟩

/-- V: `100 s` becomes `000 s'`; nested: V. -/
theorem V_100 {s s' : Tape} (h1 : V s s') :
    V (cons true (cons false (cons false (s)))) (cons false (cons false (cons false (s')))) := by
  intro x L
  obtain ⟨n1, e1⟩ := h1 (true) (cons true (cons false (cons x (L))))
  have a0 : steps 3 ⟨cons false (cons x (L)), cons false (cons true (cons false (cons false (s)))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons x (L))))), cons false (s), .C⟩ := rfl
  have a1 : steps 3 ⟨cons true (cons false (cons x (L))), cons true (cons false (cons false (s'))), .A⟩ = some ⟨L, cons x (cons false (cons false (cons false (cons false (cons false (s')))))), .A⟩ := rfl
  exact ⟨3 + n1 + 3, steps_seq trans (steps_seq trans (a0) e1) a1⟩

/-- V: a visit to `100 s` halts when its first nested visit halts. -/
theorem V_100_halts_1 {s : Tape} (h1 : VH s) :
    VH (cons true (cons false (cons false (s)))) := by
