/-- The configuration `0^∞ A> 1 0 0 s`. -/
def LE (s : Tape) : Config := ⟨blank, cons true (cons false (cons false s)), .A⟩

/-- A round, with any left tape that starts with 2 blank cells. -/
theorem round_gen {s s' : Tape} (h : V (cons true (cons false s)) s') (L : Tape) :
    ∃ n, steps n ⟨cons false (cons false (L)), cons true (cons false (cons false s)), .A⟩ = some ⟨L, cons true (cons false (cons false s')), .A⟩ := by
  obtain ⟨n1, e1⟩ := h (true) (L)
  have a0 : steps 8 ⟨cons false (cons false (L)), cons true (cons false (cons false s)), .A⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons false s)), .C⟩ := rfl
  have a1 : steps 0 ⟨L, cons true (cons false (cons false (s'))), .A⟩ = some ⟨L, cons true (cons false (cons false s')), .A⟩ := rfl
  exact ⟨8 + n1 + 0, steps_seq trans (steps_seq trans a0 e1) a1⟩

theorem blank_eq : cons false (cons false (blank)) = blank := by
  simp [cons_false_blank]

/-- A round: `0^∞ A> 1 0 0 s` becomes `0^∞ A> 1 0 0 s'` when a visit (form V) turns `1 0 s` into `s'`. -/
theorem round {s s' : Tape} (h : V (cons true (cons false s)) s') : ∃ n, steps n (LE s) = some (LE s') := by
  obtain ⟨n, e⟩ := round_gen h blank
  rw [blank_eq] at e
  exact ⟨n, e⟩

/-- A round whose visit halts: the machine halts. -/
theorem round_halts {s : Tape} (h : VH (cons true (cons false s))) : TM.Halts trans (LE s) := by
  obtain ⟨m, c, e, hc⟩ := h (true) (blank)
  have a0 : steps 8 ⟨cons false (cons false (blank)), cons true (cons false (cons false s)), .A⟩ = some ⟨cons false (cons true (blank)), cons false (cons true (cons false s)), .C⟩ := rfl
  rw [blank_eq] at a0
  exact ⟨8 + m, c, steps_seq trans a0 e, hc⟩

/-- From blank tape the machine reaches `0^∞ A> 1 0 0 1 0^∞` after 6 steps. -/
theorem start : steps 6 init = some (LE (app [true] blank)) := by
  have h := blank_reaches trans (q := St.A) (n := 6) (c := ⟨[], [true, false, false, true], .A⟩) (by decide)
  simpa [LE, FCfg.toCfg, cons_false_blank] using h

end H60498
