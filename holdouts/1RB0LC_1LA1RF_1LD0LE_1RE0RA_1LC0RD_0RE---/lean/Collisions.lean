/-- At the right end the left part's sweep turns a swept mover `1 (10)^(n+2)` into a mover at rest with gap n. -/
theorem zb_cells (n : Nat) (L R : Tape) :
    steps (2 * n + 5) ⟨L, cons true (rep (n + 2) [true, false] (R)), .E⟩ = some ⟨rep (n) [true, false] (cons false (cons true (cons true (cons false (cons false (L)))))), R, .E⟩ := by
  have h0 : steps 5 ⟨L, cons true (rep (n + 2) [true, false] (R)), .E⟩ = some ⟨cons false (cons true (cons true (cons false (cons false (L))))), rep (n) [true, false] (R), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨cons false (cons true (cons true (cons false (cons false (L))))), rep (n) [true, false] (R), .E⟩ = some ⟨rep (n) [true, false] (cons false (cons true (cons true (cons false (cons false (L)))))), R, .E⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons true (cons false (cons false (L)))))) (R)
  exact steps_congr trans (a := 5 + ((n) * 2)) (by omega) (steps_seq trans h0 (h1))

/-- The last swept mover, with a one-pair gap, becomes a mover at rest with no gap, and the head is at the right end. -/
theorem ze_cells (L : Tape) :
    steps (5) ⟨L, cons true (cons true (cons false (cons true (blank)))), .E⟩ = some ⟨cons false (cons true (cons true (cons false (cons false (L))))), blank, .E⟩ := by
  have h0 : steps 5 ⟨L, cons true (cons true (cons false (cons true (blank)))), .E⟩ = some ⟨cons false (cons true (cons true (cons false (cons false (L))))), blank, .E⟩ := rfl
  exact steps_congr trans (a := 5) (by omega) (h0)

