     "<div style=\"display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;margin:10px 0\"><label style=\"display:flex;gap:6px;align-items:center;max-width:100%;min-width:0\">rule <select id=\"qs-rule\" style=\"font:inherit;padding:4px 6px;min-width:0;flex:1 1 auto\"></select></label><label id=\"qs-prow\"><span id=\"qs-plab\">m</span> = <b id=\"qs-pval\"></b> <input id=\"qs-p\" type=\"range\" style=\"vertical-align:middle\"></label><label>right block c = <b id=\"qs-cval\"></b> <input id=\"qs-c\" type=\"range\" style=\"vertical-align:middle\"></label></div>",
