   {
    "id": "events-run",
    "eyebrow": "The run",
    "heading": "Follow the run from blank tape, one event at a time",
    "html": [
     "<div class=\"col\"><p>This is the whole run of the machine, replayed with the rules. The strip shows the tape to scale: each bar is a block of 1s, the blue one is m, the green one is c, and the orange line is the head. Below it the same tape is written out with exact lengths, and the text says which rule fired and what it did.</p></div>",
     "<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin:10px 0\"><button type=\"button\" id=\"qs-next\" style=\"font:inherit;padding:4px 12px\"><b>Next event</b></button><button type=\"button\" id=\"qs-play\" style=\"font:inherit;padding:4px 12px\">Play</button><button type=\"button\" id=\"qs-n10\" style=\"font:inherit;padding:4px 12px\">+10</button><button type=\"button\" id=\"qs-fold\" style=\"font:inherit;padding:4px 12px\">To the next fold</button><button type=\"button\" id=\"qs-n1000\" style=\"font:inherit;padding:4px 12px\">+1,000</button><button type=\"button\" id=\"qs-n30000\" style=\"font:inherit;padding:4px 12px\">+30,000</button><button type=\"button\" id=\"qs-reset\" style=\"font:inherit;padding:4px 12px\">Start over</button></div>",
     "<p id=\"qs-count\" style=\"margin:6px 0\"></p>",
     "<div id=\"qs-strip\" style=\"display:flex;align-items:stretch;height:30px;margin:24px 0 8px\"></div>",
     "<p id=\"qs-tape\" style=\"font-family:var(--mono);font-size:.92em;overflow-wrap:anywhere;margin:6px 0\"></p>",
     "<p id=\"qs-what\" style=\"margin:10px 0;padding:10px 12px;border-left:3px solid var(--accent);background:var(--accent-soft);min-height:3.2em\"></p>",
     "<div class=\"col\"><p style=\"margin-bottom:4px\"><b>How big the tape is.</b> The number of 1s on the tape (logarithmic scale) against the number of events so far. A straight line here means exponential growth: the tape gains a fixed number of digits per thousand events.</p></div>",
     "<canvas id=\"qs-chart\" role=\"img\" aria-label=\"number of ones on the tape against events, logarithmic scale\"></canvas>",
     "<p style=\"margin:8px 0 2px\"><b>Rules used so far</b></p><div id=\"qs-tally\" style=\"font-family:var(--mono);font-size:.9em\"></div>",
     "<div class=\"col\"><p>Things to notice. Splits and the small cases only move 1s around; an odd round adds 2 and a fold adds half of a block. After <b>+30,000</b> the tape holds more than 10<sup>137</sup> ones. Reaching that tape takes the real machine more steps than that, which is how Lean proves that the machine does not halt in its first 10<sup>137</sup> steps.</p></div>",
     "<script>\n// Event maps of the quarter-split pair, transcribed from lean/Events.lean (evT, arr, event, rstep).\n// A side is an array of [zeros, ones] pairs (BigInt), nearest the head first.\nfunction QS(spec){\n  var G=spec.gap, AN=spec.anchor, T=spec.table;\n  function hd(s){for(var i=0;i<s.length;i++){if(s[i][0]>0n)return 0;if(s[i][1]>0n)return 1;}return 0;}\n  function pop(s){for(var i=0;i<s.length;i++){var g=s[i][0],b=s[i][1];\n      if(g>0n)return [[g-1n,b]].concat(s.slice(i+1));\n      if(b>1n)return [[0n,b-1n]].concat(s.slice(i+1));\n      if(b===1n)return s.slice(i+1);}\n    return [];}\n  function push1s(n,s){if(s.length&&s[0][0]===0n)return [[0n,s[0][1]+n]].concat(s.slice(1));\n    return n===0n?s:[[0n,n]].concat(s);}\n  function push0s(n,s){if(!s.length)return [];return [[s[0][0]+n,s[0][1]]].concat(s.slice(1));}\n  function push(x,s){return x?push1s(1n,s):push0s(1n,s);}\n  function popn(k,s){for(var i=0;i<k;i++)s=pop(s);return s;}\n  function arr(l,Z,info){\n    for(;;){\n      if(!Z.length)return {l:l,q:AN,r:[[1n,3n]]};\n      var g=Z[0][0],b=Z[0][1],rest=Z.slice(1);\n      if(g===1n&&b>=2n){l=push1s(b,push0s(1n,l));Z=rest;if(info)info.passed=(info.passed||0)+1;continue;}\n      if(g===2n)return {l:l,q:AN,r:[[1n,b+3n]].concat(rest)};\n      if(g>=3n)return {l:l,q:AN,r:[[1n,3n],[g-2n,b]].concat(rest)};\n      return null;}}\n  // the event at the anchor  Y 1^m AN> 0 1^c Z\n  function evT(Y,m,c,Z,info){\n    function car(l){info.carrier=true;return arr(l,Z,info);}\n    if(hd(Y))return null;\n    var P=pop(Y);\n    function single(name,add){ // a lone 0 (variant B, m=0) or lone 1 with a block behind one 0\n      if(P.length&&P[0][0]===0n){var a=P[0][1],Y1=P.slice(1);\n        if(hd(Y1))return null;\n        if(a%2n===0n){info.name=name+'E';if(a>=2n&&c>=2n)return car(push1s(c,push0s(1n,push1s(a+add,pop(Y1)))));return null;}\n        info.name=name+'O';return {l:pop(Y1),q:AN,r:[[1n,a+add+1n],[1n,c]].concat(Z)};}\n      return null;}\n    if(m===0n){\n      if(G===3){\n        if(hd(P))return single('zero',0n);\n        info.name='zero';if(c>=3n)return car(push1s(c-3n,push0s(3n,push1s(1n,pop(P)))));return null;}\n      info.name='zero';if(c>=3n)return car(push1s(c-3n,push0s(2n,push1s(1n,P))));return null;}\n    if(m===1n){\n      if(hd(P))return single('one',1n);\n      info.name='one';if(c>=2n)return car(push1s(c,push0s(1n,push1s(1n,pop(P)))));return null;}\n    if(m%2n===1n){\n      if(!Y.length){info.name='fold';return {l:[[0n,1n]],q:AN,r:[[1n,c+3n*(m/2n)]].concat(Z)};}\n      info.name='odd';return {l:push1s(m-2n,P),q:AN,r:[[1n,c+3n]].concat(Z)};}\n    if(G===2?hd(P):(hd(P)||hd(pop(P)))){info.name='shift';return {l:P,q:AN,r:[[1n,m-1n],[2n,c]].concat(Z)};}\n    if(m===2n){info.name='two';\n      if(G===2){if(c>=2n)return car(push1s(c-2n,push0s(4n,push1s(1n,pop(P)))));return null;}\n      return {l:push0s(2n,push1s(2n,popn(3,Y))),q:AN,r:[[1n,c+1n]].concat(Z)};}\n    info.name='split';\n    return {l:push1s(m%4n,push0s(BigInt(G),push1s(m/4n,popn(G,Y)))),q:AN,r:[[1n,c+3n*(m/4n)]].concat(Z)};}\n  function anchor(s){ // {Y,m,c,Z} if s is an anchor\n    if(s.q!==AN||!s.r.length||s.r[0][0]!==1n)return null;\n    if(s.l.length&&s.l[0][0]===0n)return {Y:s.l.slice(1),m:s.l[0][1],c:s.r[0][1],Z:s.r.slice(1)};\n    return {Y:s.l,m:0n,c:s.r[0][1],Z:s.r.slice(1)};}\n  function event(s,info){info=info||{};var a=anchor(s);if(!a)return null;return evT(a.Y,a.m,a.c,a.Z,info);}\n  function rstep(s){var t=T[s.q][hd(s.r)];if(!t)return null;\n    if(t[1]==='R')return {l:push(t[0],s.l),q:t[2],r:pop(s.r)};\n    return {l:pop(s.l),q:t[2],r:push(hd(s.l),push(t[0],pop(s.r)))};}\n  function cells(side){var o=[];for(var i=0;i<side.length;i++){for(var k=0n;k<side[i][0];k++)o.push(0);for(k=0n;k<side[i][1];k++)o.push(1);}return o;}\n  // raw machine on cells: left array (nearest last), right array reversed (head cell last)\n  function raw(s){return {L:cells(s.l).reverse(),R:cells(s.r).reverse(),q:s.q,n:0};}\n  function rawstep(c){var x=c.R.length?c.R.pop():0,t=T[c.q][x];if(!t){c.R.push(x);return false;}\n    if(t[1]==='R'){c.L.push(t[0]);}else{c.R.push(t[0]);c.R.push(c.L.length?c.L.pop():0);}\n    c.q=t[2];c.n++;return true;}\n  function strip(a){var i=0;while(i<a.length&&a[i]===0)i++;return a.slice(i);}\n  function rawkey(c){return strip(c.L).join('')+c.q+strip(c.R).slice().reverse().join('');}\n  function key(s){return rawkey(raw(s));}\n  return {hd:hd,pop:pop,push1s:push1s,push0s:push0s,arr:arr,evT:evT,anchor:anchor,event:event,rstep:rstep,raw:raw,rawstep:rawstep,rawkey:rawkey,key:key,cells:cells,first:{l:[[0n,1n]],q:AN,r:[[1n,3n]]},spec:spec};\n}\nfunction parseTM(s){var o={};s.split('_').forEach(function(row,i){var q='ABCDEF'[i];o[q]=[0,1].map(function(b){var t=row.substr(3*b,3);return t[0]==='-'?null:[+t[0],t[1],t[2]];});});return o;}\nvar QS_D=QS({gap:2,anchor:'D',table:parseTM('1RB1LD_1LC0RC_0RF1RA_0LE1LA_1RC0LA_---0RB')});\nvar QS_C=QS({gap:3,anchor:'C',table:parseTM('1RB1LC_1LC0RD_0LE1LA_0RF1RA_1LA0LA_---0RB')});\n\nQS_D.spec.firstSteps=14;\nQS_D.spec.presets=[{label:'split: an even block is cut into quarters',make:function(p,c){return {l:[[0n,p],[2n,3n]],q:'D',r:[[1n,c]]};},p:[4,28,2,12],plab:'left block m',c:[0,10,3],words:'The head bounces inside the left block. Every bounce takes four 1s from it, drops one on the far side of the gap of two 0s and adds three to the right block. It stops when fewer than four are left.',lean:'c_split'},\n{label:'odd: an odd block loses 2, the right gains 3',make:function(p,c){return {l:[[0n,p],[1n,3n]],q:'D',r:[[1n,c]]};},p:[3,15,2,7],plab:'left block m',c:[0,10,3],words:'One sweep through the odd block and back. The 0 on its left is filled in, so here the block joins its neighbour.',lean:'c_odd'},\n{label:'fold: an odd block at the left end becomes 3 for every 2',make:function(p,c){return {l:[[0n,p]],q:'D',r:[[1n,c]]};},p:[3,25,2,9],plab:'left block m',c:[0,10,3],words:'With nothing further left, the odd round repeats by itself until a single 1 is left: every two 1s of the block become three on the right.',lean:'c_fold'},\n{label:'shift: the head steps over an even block',make:function(p,c){return {l:[[0n,p],[1n,3n]],q:'D',r:[[1n,c]]};},p:[2,16,2,6],plab:'left block m',c:[0,10,3],words:'The block is even and has a single 0 on its left, so it cannot be split. The head crosses it, erasing one 1, and stops at its left edge.',lean:'c_shift'},\n{label:'zero: nothing left of the head; the carrier runs to the end',make:function(p,c){return {l:[[2n,3n]],q:'D',r:[[1n,c]]};},p:null,plab:'',c:[3,14,6],words:'The right block hands one 1 to the left and moves over. The head runs right behind a small marker, the carrier <code>0 1</code>, and at the end of the tape the carrier becomes three 1s.',lean:'c_zero, a_end'},\n{label:'zero, then the carrier passes a block',make:function(p,c){return {l:[[2n,3n]],q:'D',r:[[1n,c],[1n,p]]};},p:[2,8,1,4],plab:'block further right',c:[3,10,5],words:'As before, but there is another block on the right behind a single 0. The carrier passes it, shifting it one cell left, and only stops at two 0s or the end of the tape.',lean:'c_zero, c_pass, a_end'},\n{label:'one: a single 1 left of the head',make:function(p,c){return {l:[[0n,1n],[2n,3n]],q:'D',r:[[1n,c]]};},p:null,plab:'',c:[2,12,4],words:'The single 1 hops across its gap and the carrier runs right.',lean:'c_one'},\n{label:'two: two 1s left of the head',make:function(p,c){return {l:[[0n,2n],[2n,3n]],q:'D',r:[[1n,c]]};},p:null,plab:'',c:[2,12,4],words:'The two 1s are erased, one 1 crosses the gap, and the carrier runs right.',lean:'c_two'},\n{label:'oneE: a single 1 with an even block behind it',make:function(p,c){return {l:[[0n,1n],[1n,p],[1n,2n]],q:'D',r:[[1n,c]]};},p:[2,10,2,4],plab:'block behind the 1',c:[2,10,3],words:'The single 1 is absorbed into the even block behind it, and the carrier runs right.',lean:'c_oneE'},\n{label:'oneO: a single 1 with an odd block behind it',make:function(p,c){return {l:[[0n,1n],[1n,p],[1n,2n]],q:'D',r:[[1n,c]]};},p:[1,9,2,3],plab:'block behind the 1',c:[0,10,3],words:'The head steps back over the odd block (which takes the single 1 and one more), and it ends up on the right of the head.',lean:'c_oneO'}];\nQS_C.spec.firstSteps=10;\nQS_C.spec.presets=[{label:'split: an even block is cut into quarters',make:function(p,c){return {l:[[0n,p],[3n,3n]],q:'C',r:[[1n,c]]};},p:[4,28,2,12],plab:'left block m',c:[0,10,3],words:'The head bounces inside the left block. Every bounce takes four 1s from it, drops one on the far side of the gap of three 0s and adds three to the right block. It stops when fewer than four are left.',lean:'c_split'},\n{label:'odd: an odd block loses 2, the right gains 3',make:function(p,c){return {l:[[0n,p],[1n,3n]],q:'C',r:[[1n,c]]};},p:[3,15,2,7],plab:'left block m',c:[0,10,3],words:'One sweep through the odd block and back. The 0 on its left is filled in, so here the block joins its neighbour.',lean:'c_odd'},\n{label:'fold: an odd block at the left end becomes 3 for every 2',make:function(p,c){return {l:[[0n,p]],q:'C',r:[[1n,c]]};},p:[3,25,2,9],plab:'left block m',c:[0,10,3],words:'With nothing further left, the odd round repeats by itself until a single 1 is left: every two 1s of the block become three on the right.',lean:'c_fold'},\n{label:'shift: the head steps over an even block',make:function(p,c){return {l:[[0n,p],[1n,3n]],q:'C',r:[[1n,c]]};},p:[2,16,2,6],plab:'left block m',c:[0,10,3],words:'The block is even and has a single 0 on its left, so it cannot be split. The head crosses it, erasing one 1, and stops at its left edge.',lean:'c_shift'},\n{label:'zero: nothing left of the head; the carrier runs to the end',make:function(p,c){return {l:[[2n,3n]],q:'C',r:[[1n,c]]};},p:null,plab:'',c:[3,14,6],words:'The right block hands one 1 to the left and moves over. The head runs right behind a small marker, the carrier <code>0 1</code>, and at the end of the tape the carrier becomes three 1s.',lean:'c_zero, a_end'},\n{label:'zero, then the carrier passes a block',make:function(p,c){return {l:[[2n,3n]],q:'C',r:[[1n,c],[1n,p]]};},p:[2,8,1,4],plab:'block further right',c:[3,10,5],words:'As before, but there is another block on the right behind a single 0. The carrier passes it, shifting it one cell left, and only stops at two 0s or the end of the tape.',lean:'c_zero, c_pass, a_end'},\n{label:'one: a single 1 left of the head',make:function(p,c){return {l:[[0n,1n],[2n,3n]],q:'C',r:[[1n,c]]};},p:null,plab:'',c:[2,12,4],words:'The single 1 hops across its gap and the carrier runs right.',lean:'c_one'},\n{label:'two: two 1s left of the head',make:function(p,c){return {l:[[0n,2n],[3n,3n]],q:'C',r:[[1n,c]]};},p:null,plab:'',c:[2,12,4],words:'The two 1s cross the gap and join the block behind it; the right block gains one.',lean:'c_two'},\n{label:'zeroE: an even block behind a single 0',make:function(p,c){return {l:[[1n,p],[1n,2n]],q:'C',r:[[1n,c]]};},p:[2,10,2,4],plab:'block behind the 0',c:[2,10,3],words:'The head is at a single 0 with an even block behind it. The carrier runs right.',lean:'c_zeroE'},\n{label:'zeroO: an odd block behind a single 0',make:function(p,c){return {l:[[1n,p],[1n,2n]],q:'C',r:[[1n,c]]};},p:[1,9,2,3],plab:'block behind the 0',c:[0,10,3],words:'The head steps back over the odd block, which ends up on its right.',lean:'c_zeroO'},\n{label:'oneE: a single 1 with an even block behind it',make:function(p,c){return {l:[[0n,1n],[1n,p],[1n,2n]],q:'C',r:[[1n,c]]};},p:[2,10,2,4],plab:'block behind the 1',c:[2,10,3],words:'The single 1 is absorbed into the even block behind it, and the carrier runs right.',lean:'c_oneE'},\n{label:'oneO: a single 1 with an odd block behind it',make:function(p,c){return {l:[[0n,1n],[1n,p],[1n,2n]],q:'C',r:[[1n,c]]};},p:[1,9,2,3],plab:'block behind the 1',c:[0,10,3],words:'The head steps back over the odd block (which takes the single 1 and one more), and it ends up on the right of the head.',lean:'c_oneO'}];\n\n// Interactive parts of the explainer: a rule viewer (the real machine, cell by cell) and an event-by-event stepper.\nfunction QSW(M,P){\n  var AN=M.spec.anchor,G=M.spec.gap,B=BigInt,$=function(id){return document.getElementById(P+id);};\n  function css(v){return getComputedStyle(document.documentElement).getPropertyValue(v).trim()||'#888';}\n  function num(x){var s=String(x);if(s.length<=12)return s.replace(/\\B(?=(\\d{3})+$)/g,',');\n    return s[0]+'.'+s.slice(1,4)+'×10<sup>'+(s.length-1)+'</sup>';}\n  function lg(x){var s=String(x);if(s==='0')return 0;return s.length-1+Math.log10(Number(s.slice(0,15))/Math.pow(10,Math.min(s.length,15)-1));}\n  function runs(s){ // tape as a list of items, left to right\n    var o=[],i;for(i=s.l.length-1;i>=0;i--){if(s.l[i][1]>0n)o.push({k:1,n:s.l[i][1],side:'l',near:i===0&&s.l[i][0]===0n});if(s.l[i][0]>0n)o.push({k:0,n:s.l[i][0]});}\n    o.push({k:'h'});\n    for(i=0;i<s.r.length;i++){if(s.r[i][0]>0n)o.push({k:0,n:s.r[i][0]});if(s.r[i][1]>0n)o.push({k:1,n:s.r[i][1],side:'r',near:i===0});}\n    return o;}\n  function text(s,q){return runs(s).map(function(r){\n      if(r.k==='h')return '<b style=\"color:var(--head)\">'+(q||s.q)+'&gt;</b>';\n      if(r.k===0)return r.n>4n?'0<sup>'+r.n+'</sup>':Array(Number(r.n)+1).join('0 ').trim();\n      return '1<sup>'+num(r.n)+'</sup>';}).join(' ');}\n  function total(s){var t=0n;s.l.concat(s.r).forEach(function(p){t+=p[1];});return t;}\n  function strip(el,s){\n    var rs=runs(s),tot=total(s),h='';if(tot===0n)tot=1n;\n    rs.forEach(function(r){\n      if(r.k==='h'){h+='<div style=\"flex:0 0 3px;background:var(--head);align-self:stretch;position:relative\"><span style=\"position:absolute;top:-18px;left:-4px;color:var(--head);font:600 12px var(--mono)\">'+s.q+'</span></div>';return;}\n      if(r.k===0){h+='<div style=\"flex:0 0 '+(3*Math.min(Number(r.n),5))+'px\"></div>';return;}\n      var col=r.near?(r.side==='l'?'var(--accent)':'var(--kernel)'):'var(--muted)';\n      h+='<div title=\"'+String(r.n)+' ones\" style=\"flex:'+(Number(r.n*100000n/tot)+1)+' 1 0;min-width:7px;background:'+col+';border-radius:3px\"></div>';});\n    el.innerHTML=h;}\n\n  /* ---------- rule viewer ---------- */\n  var presets=M.spec.presets,sel=$('rule'),pin=$('p'),cin=$('c');\n  presets.forEach(function(p,i){var o=document.createElement('option');o.value=i;o.textContent=p.label;sel.appendChild(o);});\n  function setRanges(){var p=presets[+sel.value];\n    $('prow').style.display=p.p?'':'none';\n    if(p.p){pin.min=p.p[0];pin.max=p.p[1];pin.step=p.p[2];pin.value=p.p[3];$('plab').textContent=p.plab;}\n    cin.min=p.c[0];cin.max=p.c[1];cin.value=p.c[2];}\n  function drawRule(){\n    var p=presets[+sel.value],pv=B(pin.value||0),cv=B(cin.value);\n    $('pval').textContent=pv;$('cval').textContent=cv;\n    var s=p.make(pv,cv),info={},t=M.event(s,info),msg=$('rmsg'),cv2=$('canvas');\n    $('before').innerHTML=text(s);\n    if(!t){$('after').innerHTML='(no rule for these numbers)';msg.textContent='';return;}\n    $('after').innerHTML=text(t);\n    var c=M.raw(s),pos=0,rows=[],want=M.key(t),ok=false,lo=-c.L.length,hi=c.R.length;\n    function snap(){rows.push({pos:pos,L:c.L.slice(),R:c.R.slice()});lo=Math.min(lo,pos-c.L.length,pos);hi=Math.max(hi,pos+c.R.length,pos+1);}\n    snap();\n    while(c.n<30000){var x=c.R.length?c.R[c.R.length-1]:0,d=M.spec.table[c.q][x];if(!d)break;M.rawstep(c);pos+=d[1]==='R'?1:-1;snap();\n      if(c.q===t.q&&M.rawkey(c)===want){ok=true;break;}}\n    lo-=1;hi+=1;\n    var cols=hi-lo,W=Math.min(cv2.parentNode.clientWidth||640,720),cw=Math.max(2,Math.min(12,Math.floor(W/cols))),rh=Math.max(1,Math.min(cw,Math.floor(1500/rows.length)));\n    var dpr=window.devicePixelRatio||1;cv2.width=cols*cw*dpr;cv2.height=rows.length*rh*dpr;cv2.style.width=cols*cw+'px';cv2.style.height=rows.length*rh+'px';\n    var g=cv2.getContext('2d');g.scale(dpr,dpr);g.fillStyle=css('--cell0');g.fillRect(0,0,cols*cw,rows.length*rh);\n    var one=css('--ink'),head=css('--head');\n    rows.forEach(function(r,y){g.fillStyle=one;var i,xx;\n      for(i=0;i<r.L.length;i++)if(r.L[r.L.length-1-i]){xx=r.pos-1-i-lo;g.fillRect(xx*cw,y*rh,cw,rh);}\n      for(i=0;i<r.R.length;i++)if(r.R[r.R.length-1-i]){xx=r.pos+i-lo;g.fillRect(xx*cw,y*rh,cw,rh);}\n      g.fillStyle=head;g.fillRect((r.pos-lo)*cw,y*rh,cw,Math.max(rh,2));});\n    msg.innerHTML=ok?'The real machine goes from the first line to the second in <b>'+c.n.toLocaleString('en')+' steps</b>. Each row of the picture is one step (time runs down); dark cells are 1s, the coloured cell is the head. Lean: <code>'+p.lean+'</code>.':'The run did not reach the predicted tape within 30,000 steps.';\n    $('rwords').innerHTML=p.words;}\n  sel.addEventListener('change',function(){setRanges();drawRule();});\n  pin.addEventListener('input',drawRule);cin.addEventListener('input',drawRule);\n  setRanges();drawRule();\n\n  /* ---------- the run, event by event ---------- */\n  var st,k,hist,tally,folds,timer=null,last;\n  function reset(){st=M.first;k=0;hist=[[0,lg(total(st))]];tally={};folds=0;last=null;show();}\n  function one(){var info={},b=M.anchor(st),t=M.event(st,info);if(!t)return false;\n    last={name:info.name,passed:info.passed||0,carrier:info.carrier,b:b,before:st,after:t};\n    st=t;k++;tally[info.name]=(tally[info.name]||0)+1;if(info.name==='fold')folds++;\n    if(hist.length<400000)hist.push([k,lg(total(st))]);return true;}\n  function words(e){var m=e.b.m,c=e.b.c,q=m/4n,n=e.name,z=G===2?'two 0s':'three 0s',car=e.carrier?' The head then runs right as the carrier <code>0 1</code>'+(e.passed?', passes '+e.passed+' block'+(e.passed>1?'s':''):'')+' and turns into three 1s at the first pair of 0s (or the end of the tape).':'';\n    if(n==='split')return '<b>Split.</b> The left block, '+num(m)+' ones, is even and has '+z+' on its left. A quarter of it, '+num(q)+', goes to the far side of the gap; three quarters, '+num(3n*q)+', go to the right block; '+(m%4n)+' stay.';\n    if(n==='odd')return '<b>Odd round.</b> The left block, '+num(m)+' ones, is odd. It loses 2, the 0 on its left becomes a 1, and the right block gains 3'+(e.b.Y.length&&e.b.Y[0][0]===1n?'. That closed the gap, so two blocks merged.':'.');\n    if(n==='fold')return '<b>Fold.</b> The odd block of '+num(m)+' ones is the whole left part of the tape. It is used up two at a time, and every two become three on the right: the right block grows by '+num(3n*(m/2n))+'. This is where the tape grows by half.';\n    if(n==='shift')return '<b>Shift.</b> The left block, '+num(m)+' ones, is even and too close to its neighbour to be split. The head steps over it: the block (minus one) is now on the right of the head, and the head faces the next block to the left.';\n    if(n==='zero')return '<b>Empty left.</b> There is no block next to the head on the left. The right block passes one 1 across the gap and moves over.'+car;\n    if(n==='two')return G===2?'<b>Two left.</b> Only two 1s remain of a split block. They are erased, one 1 crosses the gap, and the right block moves over.'+car:'<b>Two left.</b> Only two 1s remain of a split block. They cross the gap and join the block on the far side; the right block gains 1.';\n    if(n==='one')return '<b>One left.</b> A single 1 is next to the head. It hops across the gap.'+car;\n    if(n==='oneE'||n==='zeroE')return '<b>Remainder next to an even block.</b> The small remainder is absorbed into the even block behind it.'+car;\n    if(n==='oneO'||n==='zeroO')return '<b>Remainder next to an odd block.</b> The head steps back over the odd block behind it, which is now on the right of the head.';\n    return n;}\n  function chart(){var cv=$('chart'),W=Math.min(cv.parentNode.clientWidth||640,720),H=150,dpr=window.devicePixelRatio||1;\n    cv.width=W*dpr;cv.height=H*dpr;cv.style.width=W+'px';cv.style.height=H+'px';var g=cv.getContext('2d');g.scale(dpr,dpr);g.clearRect(0,0,W,H);\n    var n=hist.length,ymax=Math.max(1,hist[n-1][1]),xmax=Math.max(1,hist[n-1][0]),stepi=Math.max(1,Math.floor(n/1500));\n    g.strokeStyle=css('--line');g.beginPath();g.moveTo(34,6);g.lineTo(34,H-18);g.lineTo(W-4,H-18);g.stroke();\n    g.fillStyle=css('--muted');g.font='11px sans-serif';g.fillText('10^'+ymax.toFixed(ymax<10?1:0),0,12);g.fillText('1',22,H-18);g.fillText('event '+xmax.toLocaleString('en'),W-90,H-4);g.fillText('0',34,H-4);\n    g.strokeStyle=css('--accent');g.lineWidth=1.5;g.beginPath();\n    for(var i=0;i<n;i+=stepi){var x=34+(W-40)*hist[i][0]/xmax,y=H-18-(H-26)*hist[i][1]/ymax;if(i)g.lineTo(x,y);else g.moveTo(x,y);}\n    g.lineTo(34+(W-40),H-18-(H-26)*hist[n-1][1]/ymax);g.stroke();}\n  function show(){strip($('strip'),st);$('tape').innerHTML=text(st);\n    $('count').innerHTML='Event <b>'+k.toLocaleString('en')+'</b> &middot; '+num(total(st))+' ones on the tape &middot; '+folds.toLocaleString('en')+(folds===1?' fold':' folds')+' so far';\n    $('what').innerHTML=last?words(last):'This is the first anchor, reached '+M.spec.firstSteps+' steps after the start on a blank tape. Press <b>Next event</b>.';\n    var names=Object.keys(tally).sort(function(a,b){return tally[b]-tally[a];});\n    $('tally').innerHTML=names.map(function(n){return '<span style=\"display:inline-block;margin:2px 6px 2px 0;padding:1px 8px;border:1px solid var(--line);border-radius:10px\">'+n+' <b>'+tally[n].toLocaleString('en')+'</b></span>';}).join('');\n    chart();}\n  function go(n){for(var i=0;i<n;i++)if(!one()){$('what').innerHTML='No event rule applies here.';break;}show();}\n  function stop(){if(timer){clearInterval(timer);timer=null;$('play').textContent='Play';}}\n  $('next').addEventListener('click',function(){stop();go(1);});\n  $('n10').addEventListener('click',function(){stop();go(10);});\n  $('n1000').addEventListener('click',function(){stop();go(1000);});\n  $('n30000').addEventListener('click',function(){stop();go(30000);});\n  $('fold').addEventListener('click',function(){stop();for(var i=0;i<100000;i++){if(!one())break;if(last.name==='fold')break;}show();});\n  $('reset').addEventListener('click',function(){stop();reset();});\n  $('play').addEventListener('