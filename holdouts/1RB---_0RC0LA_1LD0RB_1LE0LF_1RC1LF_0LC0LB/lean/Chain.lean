/-! ## The carry chain, for any number of digits

The head works at the right end of the tape; a tape left of the head is listed nearest cell first.  A digit
`(1000)^r W` read from the head is its wall `W` (reversed) and then its run of `0001` blocks. -/

/-- The run block `1000`, read from the head. -/
abbrev blk : List Bool := [false, false, false, true]
/-- A T digit (ternary 2, wall `100000`) with a run of `r` blocks, in front of `t`. -/
def Tdig (r : Nat) (t : Tape) : Tape := app [false, false, false, false, false, true] (rep r blk t)
/-- A Z digit (ternary 0, wall `101010`). -/
def Zdig (r : Nat) (t : Tape) : Tape := app [false, true, false, true, false, true] (rep r blk t)
/-- An O digit (ternary 1, wall `10`). -/
def Odig (r : Nat) (t : Tape) : Tape := app [false, true] (rep r blk t)
/-- T digits, the one nearest the head first. -/
def Tc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Tdig r (Tc rs t)
/-- Z digits, the one nearest the head first. -/
def Zc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Zdig r (Zc rs t)
/-- What crossing one T digit leaves on the head's right. -/
def Hd (r : Nat) (t : Tape) : Tape :=
  rep r [false, true, true, true] (app [true, true, true, true, true, true] t)
/-- `Hd` for a list of digits, crossed in list order. -/
def Hacc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Hacc rs (Hd r t)
/-- `Hd` for a list, the last crossed first. -/
def Htop : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Hd r (Htop rs t)
/-- What the way back leaves on the head's left, digit by digit. -/
def Wacc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Wacc rs (rep r blk (app [false, true, false, true, false, true] t))
/-- `Zc` built up the other way round. -/
def Zacc : List Nat → Tape → Tape
  | [], t => t
  | r :: rs, t => Zacc rs (Zdig r t)
def fcost : List Nat → Nat
  | [] => 0
  | r :: rs => 4 * r + 16 + fcost rs
def bcost : List Nat → Nat
  | [] => 0
  | r :: rs => 6 * r + 12 + bcost rs
/-- The step count of a sweep over these chain digits: 10 per block and 28 per digit. -/
def cost : List Nat → Nat
  | [] => 0
  | r :: rs => 10 * r + 28 + cost rs

theorem fcost_append (a b : List Nat) : fcost (a ++ b) = fcost a + fcost b := by
  induction a with
  | nil => simp [fcost]
  | cons r a ih => simp [fcost, ih]; omega

theorem bcost_reverse (a : List Nat) : bcost a.reverse = bcost a := by
  have h : ∀ a b : List Nat, bcost (a ++ b) = bcost a + bcost b := by
    intro a b; induction a with
    | nil => simp [bcost]
    | cons r a ih => simp [bcost, ih]; omega
  induction a with
  | nil => rfl
  | cons r a ih => simp [List.reverse_cons, h, ih, bcost]; omega

theorem cost_split (a : List Nat) : fcost a + bcost a = cost a := by
  induction a with
  | nil => rfl
  | cons r a ih => simp [fcost, bcost, cost]; omega

theorem Hacc_append (a b : List Nat) (t : Tape) : Hacc (a ++ b) t = Hacc b (Hacc a t) := by
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => exact ih _

theorem Htop_append (a b : List Nat) (t : Tape) : Htop (a ++ b) t = Htop a (Htop b t) := by
  induction a with
  | nil => rfl
  | cons r a ih => simp [Htop, ih]

theorem Hacc_eq (a : List Nat) (t : Tape) : Hacc a t = Htop a.reverse t := by
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => simp [Hacc, ih, List.reverse_cons, Htop_append, Htop]

theorem Zacc_eq (a : List Nat) (t : Tape) : Zacc a t = Zc a.reverse t := by
  have h : ∀ a b : List Nat, ∀ t, Zc (a ++ b) t = Zc a (Zc b t) := by
    intro a b t; induction a with
    | nil => rfl
    | cons r a ih => simp [Zc, ih]
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => simp [Zacc, ih, List.reverse_cons, h, Zc]

theorem Wacc_eq (a : List Nat) (t : Tape) :
    app [false, true, false, true, false, true] (Wacc a t) = Zacc a (app [false, true, false, true, false, true] t) := by
  induction a generalizing t with
  | nil => rfl
  | cons r a ih => exact ih _

/-- Crossing T digits leftwards, any number of them. -/
theorem fwdChain (rs : List Nat) (X R : Tape) :
    steps (fcost rs) ⟨cons false (cons true (Tc rs X)), cons false R, .C⟩
      = some ⟨cons false (cons true X), cons false (Hacc rs R), .C⟩ := by
  induction rs generalizing R with
  | nil => rfl
  | cons r rs ih => exact steps_seq trans (fwdT r (Tc rs X) R) (ih _)

/-- Crossing back, any number of digits: each T digit becomes a Z digit with the same run. -/
theorem retChain (ts : List Nat) (M R : Tape) :
    steps (bcost ts) ⟨M, app [true, true, true, true, true, true, true, true, true] (Htop ts R), .C⟩
      = some ⟨Wacc ts M, app [true, true, true, true, true, true, true, true, true] R, .C⟩ := by
  induction ts generalizing M with
  | nil => rfl
  | cons b ts ih => exact steps_seq trans (retT b M (Htop ts R)) (ih _)

theorem startC (z : Nat) (l : List Nat) (hl : l ≠ []) (Y : Tape) :
    steps (4 * z + 13) ⟨app [false, false, true] (rep z blk (Tc l Y)), blank, .B⟩
      = some ⟨cons false (cons true (Tc l Y)), cons false (rep z [false, true, true, true] (app [true, true, true] blank)), .C⟩ := by
  cases l with
  | nil => exact absurd rfl hl
  | cons r l => exact startT z _

/-- **The generic counter sweep with the carry stopping on a Z digit**, for every number of carry digits.
From the sample (`100` and the last run `z` next to the head), the T digits `rs` (nearest the head first), the top
T digit with `a` blocks, then a Z digit with `s` blocks: the T digits become Z digits with the same runs, the top
one gains a block, the Z digit becomes an O digit, and the last run gains one, in `10 z + 10 a + 70 + cost rs`
steps (10 per block of the chain and of the last run, 28 per chain digit, plus 42). -/
theorem sweepZ (z a s : Nat) (rs : List Nat) (L : Tape) :
    steps (10 * z + cost rs + 10 * a + 70)
      ⟨app [false, false, true] (rep z blk (Tc (rs ++ [a]) (Zdig s L))), blank, .B⟩
      = some ⟨app [false, false, true] (rep (z + 1) blk (Zc rs (Zdig (a + 1) (Odig s L)))), blank, .B⟩ := by
  have h1 := startC z (rs ++ [a]) (by simp) (Zdig s L)
  have h2 := fwdChain (rs ++ [a]) (Zdig s L) (rep z [false, true, true, true] (app [true, true, true] blank))
  rw [Hacc_append] at h2
  have h3 : steps (6 * a + 6) ⟨cons false (cons true (Zdig s L)),
      cons false (Hacc [a] (Hacc rs (rep z [false, true, true, true] (app [true, true, true] blank)))), .C⟩
      = some ⟨rep (a + 1) blk (Odig s L), app [true, true, true, true, true, true, true, true, true]
          (Hacc rs (rep z [false, true, true, true] (app [true, true, true] blank))), .C⟩ := by
    rw [← rep_app_comm]
    exact stopZ a (rep s blk L) _
  have h4 := retChain rs.reverse (rep (a + 1) blk (Odig s L))
    (rep z [false, true, true, true] (app [true, true, true] blank))
  rw [← Hacc_eq] at h4
  have h5 := endT z (Wacc rs.reverse (rep (a + 1) blk (Odig s L)))
  have e5 : cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep z blk
      (cons false (cons true (cons false (cons true (cons false (cons true
        (Wacc rs.reverse (rep (a + 1) blk (Odig s L))))))))))))))))
      = app [false, false, true] (rep (z + 1) blk (Zc rs (Zdig (a + 1) (Odig s L)))) := by
    have := Wacc_eq rs.reverse (rep (a + 1) blk (Odig s L))
    rw [Zacc_eq, List.reverse_reverse] at this
    show app [false, false, true] (app blk (rep z blk (app [false, true, false, true, false, true] _))) = _
    rw [this]; rfl
  have hc : 4 * z + 13 + (fcost (rs ++ [a]) + (6 * a + 6 + (bcost rs.reverse + (6 * z + 35))))
      = 10 * z + cost rs + 10 * a + 70 := by
    rw [fcost_append, bcost_reverse, ← cost_split]; simp [fcost]; omega
  have := steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5)))
  rw [hc] at this
  exact this.trans (congrArg (fun l => some (⟨l, blank, .B⟩ : Cfg St)) e5)

/-- **The generic counter sweep with the carry stopping on an O digit**: as `sweepZ`, but the stop digit is an O
digit with `s + 1` blocks; it becomes a T digit and loses a block, and the top T digit keeps its run. -/
theorem sweepO (z a s : Nat) (rs : List Nat) (L : Tape) :
    steps (10 * z + cost rs + 10 * a + 70)
      ⟨app [false, false, true] (rep z blk (Tc (rs ++ [a]) (Odig (s + 1) L))), blank, .B⟩
      = some ⟨app [false, false, true] (rep (z + 1) blk (Zc rs (Zdig a (Tdig s L)))), blank, .B⟩ := by
  have h1 := startC z (rs ++ [a]) (by simp) (Odig (s + 1) L)
  have h2 := fwdChain (rs ++ [a]) (Odig (s + 1) L) (rep z [false, true, true, true] (app [true, true, true] blank))
  rw [Hacc_append] at h2
  have h3 : steps (6 * a + 6) ⟨cons false (cons true (Odig (s + 1) L)),
      cons false (Hacc [a] (Hacc rs (rep z [false, true, true, true] (app [true, true, true] blank)))), .C⟩
      = some ⟨rep a blk (Tdig s L), app [true, true, true, true, true, true, true, true, true]
          (Hacc rs (rep z [false, true, true, true] (app [true, true, true] blank))), .C⟩ :=
    stopO a s L _
  have h4 := retChain rs.reverse (rep a blk (Tdig s L))
    (rep z [false, true, true, true] (app [true, true, true] blank))
  rw [← Hacc_eq] at h4
  have h5 := endT z (Wacc rs.reverse (rep a blk (Tdig s L)))
  have e5 : cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep z blk
      (cons false (cons true (cons false (cons true (cons false (cons true
        (Wacc rs.reverse (rep a blk (Tdig s L))))))))))))))))
      = app [false, false, true] (rep (z + 1) blk (Zc rs (Zdig a (Tdig s L)))) := by
    have := Wacc_eq rs.reverse (rep a blk (Tdig s L))
    rw [Zacc_eq, List.reverse_reverse] at this
    show app [false, false, true] (app blk (rep z blk (app [false, true, false, true, false, true] _))) = _
    rw [this]; rfl
  have hc : 4 * z + 13 + (fcost (rs ++ [a]) + (6 * a + 6 + (bcost rs.reverse + (6 * z + 35))))
      = 10 * z + cost rs + 10 * a + 70 := by
    rw [fcost_append, bcost_reverse, ← cost_split]; simp [fcost]; omega
  have := steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5)))
  rw [hc] at this
  exact this.trans (congrArg (fun l => some (⟨l, blank, .B⟩ : Cfg St)) e5)

end H49413
