/-- The only way to a halt: E on a 0 with 1 1 to its left reaches F on a 1 (which halts) in 2 steps. -/
theorem halt_shape (L R : Tape) :
    steps (2) ⟨cons true (cons true (L)), cons false (R), .E⟩ = some ⟨L, cons true (cons false (cons false (R))), .F⟩ := by
  have h0 : steps 2 ⟨cons true (cons true (L)), cons false (R), .E⟩ = some ⟨L, cons true (cons false (cons false (R))), .F⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- F reading a 1 halts (the end of `halt_shape`). -/
theorem halt_after_shape (L R : Tape) : step ⟨L, cons true R, .F⟩ = none := rfl

