      rep_rotate (b) [false] [true, false] [false, true] rfl (cons true (cons true (blank)))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .B⟩ = some ⟨app [] (app [false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((b) * 2) ⟨cons true (cons true (blank)), rep (b) [false, true] (cons false (cons true (cons true (blank)))), .B⟩ = some ⟨rep (b) [false, true] (cons true (cons true (blank))), cons false (cons true (cons true (blank))), .B⟩ :=
    cross_r trans c2 (b) (cons true (cons true (blank))) (cons false (cons true (cons true (blank))))
  have h3 : steps 3 ⟨rep (b) [false, true] (cons true (cons true (blank))), cons false (cons true (cons true (blank))), .B⟩ = some ⟨cons true (rep (b) [false, true] (cons true (cons true (blank)))), cons false (cons false (blank)), .D⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (b) [false, true] (cons true (cons true (blank)))), cons false (cons false (blank)), .D⟩ = some ⟨rep (b) [true, false] (cons true (cons true (cons true (blank)))), cons false (cons false (blank)), .D⟩ := by
    simp only [steps_zero, show cons true (rep (b) [false, true] (cons true (cons true (blank)))) = rep (b) [true, false] (cons true (cons true (cons true (blank)))) from
      rep_rotate (b) [true] [false, true] [true, false] rfl (cons true (cons true (blank)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((b) * 2) ⟨rep (b) [true, false] (cons true (cons true (cons true (blank)))), cons false (cons false (blank)), .D⟩ = some ⟨cons true (cons true (cons true (blank))), cons false (rep (b) [false, true] (cons false (blank))), .D⟩ :=
    cross_l trans c5 (b) (cons true (cons true (cons true (blank)))) (cons false (blank))
  have h6 : steps 8 ⟨cons true (cons true (cons true (blank))), cons false (rep (b) [false, true] (cons false (blank))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (b) [false, true] (cons false (blank))), .C⟩ := rfl
  have h7 : steps 0 ⟨cons true (cons false (cons true (cons true (blank)))), cons true (rep (b) [false, true] (cons false (blank))), .C⟩ = some ⟨cons true (cons false (cons true (cons true (blank)))), rep (b) [true, false] (cons true (cons false (blank))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (b) [false, true] (cons false (blank))) = rep (b) [true, false] (cons true (cons false (blank))) from
      rep_rotate (b) [true] [false, true] [true, false] rfl (cons false (blank))]
  have c8 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .C⟩ = some ⟨app [] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h8 : steps ((b) * 2) ⟨cons true (cons false (cons true (cons true (blank)))), rep (b) [true, false] (cons true (cons false (blank))), .C⟩ = some ⟨rep (b) [true, false] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (blank)), .C⟩ :=
    cross_r trans c8 (b) (cons true (cons false (cons true (cons true (blank))))) (cons true (cons false (blank)))
  have h9 : steps 3 ⟨rep (b) [true, false] (cons true (cons false (cons true (cons true (blank))))), cons true (cons false (blank)), .C⟩ = some ⟨cons false (rep (b) [true, false] (cons true (cons false (cons true (cons true (blank)))))), cons true (cons true (blank)), .A⟩ := rfl
  have h10 : steps 0 ⟨cons false (rep (b) [true, false] (cons true (cons false (cons true (cons true (blank)))))), cons true (cons true (blank)), .A⟩ = some ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))), cons true (cons true (blank)), .A⟩ := by
    simp only [steps_zero, show cons false (rep (b) [true, false] (cons true (cons false (cons true (cons true (blank)))))) = rep (b) [false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))) from
      rep_rotate (b) [false] [true, false] [false, true] rfl (cons true (cons false (cons true (cons true (blank)))))]
  have c11 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h11 : steps ((b) * 2) ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))), cons true (cons true (blank)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (blank))))), cons true (rep (b) [true, true] (cons true (blank))), .A⟩ :=
    cross_l trans c11 (b) (cons false (cons true (cons false (cons true (cons true (blank)))))) (cons true (blank))
  have h12 : steps 7 ⟨cons false (cons true (cons false (cons true (cons true (blank))))), cons true (rep (b) [true, true] (cons true (blank))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (b) [true, true] (cons true (blank)))))))), .D⟩ := rfl
  exact steps_congr trans (a := 1 + (0 + ((b) * 2 + (3 + (0 + ((b) * 2 + (8 + (0 + ((b) * 2 + (3 + (0 + ((b) * 2 + (7))))))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (h12)))))))))))))

/-- transfer: two 1s become a pair 10, the tape grows by two cells on the left -/
theorem transfer (x y : Nat) (R : Tape) :
    steps (4 * x + 10) ⟨blank, cons false (cons false (rep (x) [true, false] (rep (y + 2) [true] (R)))), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (rep (x) [false, true] (cons false (rep (y) [true] (R)))))))), .D⟩ := by
  have h0 : steps 3 ⟨blank, cons false (cons false (rep (x) [true, false] (rep (y + 2) [true] (R)))), .D⟩ = some ⟨cons false (cons true (blank)), cons false (rep (x) [true, false] (rep (y + 2) [true] (R))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (blank)), cons false (rep (x) [true, false] (rep (y + 2) [true] (R))), .B⟩ = some ⟨cons false (cons true (blank)), rep (x) [false, true] (cons false (rep (y + 2) [true] (R))), .B⟩ := by
    simp only [steps_zero, show cons false (rep (x) [true, false] (rep (y + 2) [true] (R))) = rep (x) [false, true] (cons false (rep (y + 2) [true] (R))) from
      rep_rotate (x) [false] [true, false] [false, true] rfl (rep (y + 2) [true] (R))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .B⟩ = some ⟨app [] (app [false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((x) * 2) ⟨cons false (cons true (blank)), rep (x) [false, true] (cons false (rep (y + 2) [true] (R))), .B⟩ = some ⟨rep (x) [false, true] (cons false (cons true (blank))), cons false (rep (y + 2) [true] (R)), .B⟩ :=
    cross_r trans c2 (x) (cons false (cons true (blank))) (cons false (rep (y + 2) [true] (R)))
  have h3 : steps 3 ⟨rep (x) [false, true] (cons false (cons true (blank))), cons false (rep (y + 2) [true] (R)), .B⟩ = some ⟨cons true (rep (x) [false, true] (cons false (cons true (blank)))), cons false (cons false (rep (y) [true] (R))), .D⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (x) [false, true] (cons false (cons true (blank)))), cons false (cons false (rep (y) [true] (R))), .D⟩ = some ⟨rep (x) [true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (rep (y) [true] (R))), .D⟩ := by
    simp only [steps_zero, show cons true (rep (x) [false, true] (cons false (cons true (blank)))) = rep (x) [true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (x) [true] [false, true] [true, false] rfl (cons false (cons true (blank)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((x) * 2) ⟨rep (x) [true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (rep (y) [true] (R))), .D⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (rep (x) [false, true] (cons false (rep (y) [true] (R)))), .D⟩ :=
    cross_l trans c5 (x) (cons true (cons false (cons true (blank)))) (cons false (rep (y) [true] (R)))
  have h6 : steps 4 ⟨cons true (cons false (cons true (blank))), cons false (rep (x) [false, true] (cons false (rep (y) [true] (R)))), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (rep (x) [false, true] (cons false (rep (y) [true] (R)))))))), .D⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((x) * 2 + (3 + (0 + ((x) * 2 + (4))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- end of a round: one 1 left, the pairs are unfolded into 1s -/
theorem final (x : Nat) :
    steps (4 * x + 15) ⟨blank, cons false (cons false (rep (x) [true, false] (cons true (blank)))), .D⟩ = some ⟨blank, cons true (cons false (cons true (cons true (cons true (cons true (rep (x) [true, true] (cons true (cons true (blank))))))))), .D⟩ := by
  have h0 : steps 3 ⟨blank, cons false (cons false (rep (x) [true, false] (cons true (blank)))), .D⟩ = some ⟨cons false (cons true (blank)), cons false (rep (x) [true, false] (cons true (blank))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (blank)), cons false (rep (x) [true, false] (cons true (blank))), .B⟩ = some ⟨cons false (cons true (blank)), rep (x) [false, true] (cons false (cons true (blank))), .B⟩ := by
    simp only [steps_zero, show cons false (rep (x) [true, false] (cons true (blank))) = rep (x) [false, true] (cons false (cons true (blank))) from
      rep_rotate (x) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .B⟩ = some ⟨app [] (app [false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((x) * 2) ⟨cons false (cons true (blank)), rep (x) [false, true] (cons false (cons true (blank))), .B⟩ = some ⟨rep (x) [false, true] (cons false (cons true (blank))), cons false (cons true (blank)), .B⟩ :=
    cross_r trans c2 (x) (cons false (cons true (blank))) (cons false (cons true (blank)))
  have h3 : steps 5 ⟨rep (x) [false, true] (cons false (cons true (blank))), cons false (cons true (blank)), .B⟩ = some ⟨cons true (rep (x) [false, true] (cons false (cons true (blank)))), cons false (cons true (cons true (blank))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (x) [false, true] (cons false (cons true (blank)))), cons false (cons true (cons true (blank))), .C⟩ = some ⟨rep (x) [true, false] (cons true (cons false (cons true (blank)))), cons false (cons true (cons true (blank))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (x) [false, true] (cons false (cons true (blank)))) = rep (x) [true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (x) [true] [false, true] [true, false] rfl (cons false (cons true (blank)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h5 : steps ((x) * 2) ⟨rep (x) [true, false] (cons true (cons false (cons true (blank)))), cons false (cons true (cons true (blank))), .C⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (rep (x) [true, true] (cons true (cons true (blank)))), .C⟩ :=
    cross_l trans c5 (x) (cons true (cons false (cons true (blank)))) (cons true (cons true (blank)))
  have h6 : steps 7 ⟨cons true (cons false (cons true (blank))), cons false (rep (x) [true, true] (cons true (cons true (blank)))), .C⟩ = some ⟨blank, cons true (cons false (cons true (cons true (cons true (cons true (rep (x) [true, true] (cons true (cons true (blank))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((x) * 2 + (5 + (0 + ((x) * 2 + (7))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- the halting case: no 1s at the start of a doubling -/
theorem tohalt (k : Nat) :
    steps (2 * k + 4) ⟨blank, rep (k + 1) [true, false] (blank), .D⟩ = some ⟨cons true (rep (k) [false, true] (cons false (cons true (blank)))), blank, .F⟩ := by
  have h0 : steps 3 ⟨blank, rep (k + 1) [true, false] (blank), .D⟩ = some ⟨cons false (cons true (blank)), cons false (rep (k) [true, false] (blank)), .E⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (blank)), cons false (rep (k) [true, false] (blank)), .E⟩ = some ⟨cons false (cons true (blank)), rep (k) [false, true] (cons false (blank)), .E⟩ := by
    simp only [steps_zero, show cons false (rep (k) [true, false] (blank)) = rep (k) [false, true] (cons false (blank)) from
      rep_rotate (k) [false] [true, false] [false, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .E⟩ = some ⟨app [] (app [false, true] L), R, .E⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 2) ⟨cons false (cons true (blank)), rep (k) [false, true] (cons false (blank)), .E⟩ = some ⟨rep (k) [false, true] (cons false (cons true (blank))), cons false (blank), .E⟩ :=
    cross_r trans c2 (k) (cons false (cons true (blank))) (cons false (blank))
  have h3 : steps 1 ⟨rep (k) [false, true] (cons false (cons true (blank))), cons false (blank), .E⟩ = some ⟨cons true (rep (k) [false, true] (cons false (cons true (blank)))), blank, .F⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((k) * 2 + (1)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

