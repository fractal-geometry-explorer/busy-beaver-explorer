theorem r_start (L : Tape) :
    steps (9) ⟨cons false (cons false (cons false (L))), blank, .E⟩ = some ⟨L, cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), .D⟩ := by
  have h0 : steps 9 ⟨cons false (cons false (cons false (L))), blank, .E⟩ = some ⟨L, cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), .D⟩ := rfl
  exact steps_congr trans (a := 9) (by omega) (h0)

