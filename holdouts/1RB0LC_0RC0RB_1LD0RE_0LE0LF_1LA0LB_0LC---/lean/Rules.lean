    cross_l trans c1 (n + 1) (cons true (cons true (cons false (L)))) (cons true (cons false (cons true (cons false (cons true (blank))))))
  have h2 : steps 25 ⟨cons true (cons true (cons false (L))), cons false (rep (n + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank))))))), .D⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (L)))))))), rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank)))))), .C⟩ := rfl
  have c3 : ∀ L R : Tape, steps 6 ⟨app [] L, app [true, false, true, false] R, .C⟩ = some ⟨app [] (app [false, false, false, true] L), R, .C⟩ := fun _ _ => rfl
  have h3 : steps ((n) * 6) ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (L)))))))), rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank)))))), .C⟩ = some ⟨rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (L))))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .C⟩ :=
    cross_r trans c3 (n) (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (L))))))))) (cons true (cons false (cons true (cons false (cons true (blank))))))
  have h4 : steps 7 ⟨rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (L))))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .C⟩ = some ⟨cons false (cons false (cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (L)))))))))))))), blank, .E⟩ := rfl
  exact steps_congr trans (a := 9 + ((n + 1) * 4 + (25 + ((n) * 6 + (7))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

