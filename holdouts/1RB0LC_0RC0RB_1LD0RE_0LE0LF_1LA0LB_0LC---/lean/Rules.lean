    steps (10 * n + 45) ⟨cons false (cons false (cons false (rep (n + 1) [false, true, false, false] (cons true (cons true (cons false (L))))))), blank, .E⟩ = some ⟨cons false (cons false (cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (L)))))))))))))), blank, .E⟩ := by
  have h0 : steps 9 ⟨cons false (cons false (cons false (rep (n + 1) [false, true, false, false] (cons true (cons true (cons false (L))))))), blank, .E⟩ = some ⟨rep (n + 1) [false, true, false, false] (cons true (cons true (cons false (L)))), cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
