  have hn : 1 + (0 + ((q) * 3 + (13 + (0 + ((q) * 7 + (9)))))) = 10 * q + 23 := by omega
  have h0 : steps 1 ⟨cons true (cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L)))))))))), blank, .C⟩ = some ⟨cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))), cons true (cons true (blank)), .A⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))), cons true (cons true (blank)), .A⟩ = some ⟨rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))), cons true (cons true (blank)), .A⟩ := by
    simp only [steps_zero, show cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))) = rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))) from
      rep_rotate (q) [true] [false, true, true] [true, false, true] rfl (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))]
  have c2 : ∀ L R : Tape, steps 3 ⟨app [true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true, false] R), .A⟩ := fun _ _ => rfl
  have h2 : steps ((q) * 3) ⟨rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L)))))))), cons true (rep (q) [true, true, false] (cons true (blank))), .A⟩ :=
    cross_l trans c2 (q) (cons true (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L))))))))) (cons true (blank))
  have h3 : steps 13 ⟨cons true (cons false (cons true (cons true (cons true (cons false (cons true (cons true (L)))))))), cons true (rep (q) [true, true, false] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (L))))))), cons true (cons false (rep (q) [true, true, false] (cons true (blank)))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (L))))))), cons true (cons false (rep (q) [true, true, false] (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (L))))))), rep (q) [true, false, true] (cons true (cons false (cons true (blank)))), .A⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (q) [true, true, false] (cons true (blank)))) = rep (q) [true, false, true] (cons true (cons false (cons true (blank)))) from
      rep_rotate (q) [true, false] [true, true, false] [true, false, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 7 ⟨app [false, true] L, app [true, false, true] R, .A⟩ = some ⟨app [false, true] (app [true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((q) * 7) ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (L))))))), rep (q) [true, false, true] (cons true (cons false (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (rep (q) [true, false, true] (cons true (cons true (cons true (cons true (cons true (L)))))))), cons true (cons false (cons true (blank))), .A⟩ :=
    cross_r trans c5 (q) (cons true (cons true (cons true (cons true (cons true (L)))))) (cons true (cons false (cons true (blank))))
  have h6 : steps 9 ⟨cons false (cons true (rep (q) [true, false, true] (cons true (cons true (cons true (cons true (cons true (L)))))))), cons true (cons false (cons true (blank))), .A⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (q) [true, false, true] (cons true (cons true (cons true (cons true (cons true (L))))))))))))), blank, .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- The walker reaches the marked group before it: `1^m 0 1110 (110)^q 1 1 C>` becomes `1^(m+4) 0 (110)^(q+1) 1 1 C>`. -/
theorem walk_merge (q : Nat) (L : Tape) :
    steps (10 * q + 23) ⟨cons true (cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (L))))))))), blank, .C⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (q) [true, false, true] (cons true (cons true (cons true (cons true (L)))))))))))), blank, .C⟩ := by
  have hn : 1 + (0 + ((q) * 3 + (13 + (0 + ((q) * 7 + (9)))))) = 10 * q + 23 := by omega
  have h0 : steps 1 ⟨cons true (cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (L))))))))), blank, .C⟩ = some ⟨cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))), cons true (cons true (blank)), .A⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))), cons true (cons true (blank)), .A⟩ = some ⟨rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))), cons true (cons true (blank)), .A⟩ := by
    simp only [steps_zero, show cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))) = rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))) from
      rep_rotate (q) [true] [false, true, true] [true, false, true] rfl (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))]
  have c2 : ∀ L R : Tape, steps 3 ⟨app [true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true, false] R), .A⟩ := fun _ _ => rfl
  have h2 : steps ((q) * 3) ⟨rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons false (cons true (cons true (cons true (cons false (cons true (L))))))), cons true (rep (q) [true, true, false] (cons true (blank))), .A⟩ :=
    cross_l trans c2 (q) (cons true (cons false (cons true (cons true (cons true (cons false (cons true (L)))))))) (cons true (blank))
  have h3 : steps 13 ⟨cons true (cons false (cons true (cons true (cons true (cons false (cons true (L))))))), cons true (rep (q) [true, true, false] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (L)))))), cons true (cons false (rep (q) [true, true, false] (cons true (blank)))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons true (cons true (cons true (cons true (L)))))), cons true (cons false (rep (q) [true, true, false] (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (L)))))), rep (q) [true, false, true] (cons true (cons false (cons true (blank)))), .A⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (q) [true, true, false] (cons true (blank)))) = rep (q) [true, false, true] (cons true (cons false (cons true (blank)))) from
      rep_rotate (q) [true, false] [true, true, false] [true, false, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 7 ⟨app [false, true] L, app [true, false, true] R, .A⟩ = some ⟨app [false, true] (app [true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((q) * 7) ⟨cons false (cons true (cons true (cons true (cons true (cons true (L)))))), rep (q) [true, false, true] (cons true (cons false (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (rep (q) [true, false, true] (cons true (cons true (cons true (cons true (L))))))), cons true (cons false (cons true (blank))), .A⟩ :=
    cross_r trans c5 (q) (cons true (cons true (cons true (cons true (L))))) (cons true (cons false (cons true (blank))))
  have h6 : steps 9 ⟨cons false (cons true (rep (q) [true, false, true] (cons true (cons true (cons true (cons true (L))))))), cons true (cons false (cons true (blank))), .A⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (q) [true, false, true] (cons true (cons true (cons true (cons true (L)))))))))))), blank, .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- After a carry that leaves `1^6` at the end: the tail becomes a marked item, `1^6 C>` becomes `1110 110 11 C>`, in 13 steps. -/
theorem push (L : Tape) :
    steps (13) ⟨cons true (cons true (cons true (cons true (cons true (cons true (L)))))), blank, .C⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (L))))))))), blank, .C⟩ := by
  have hn : 13 = 13 := by omega
  have h0 : steps 13 ⟨cons true (cons true (cons true (cons true (cons true (cons true (L)))))), blank, .C⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (L))))))))), blank, .C⟩ := rfl
  exact steps_congr trans hn (h0)

