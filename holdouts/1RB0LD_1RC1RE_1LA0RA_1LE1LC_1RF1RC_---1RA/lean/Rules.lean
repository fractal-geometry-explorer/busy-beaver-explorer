import Machine

/-! # The walker

Generated by `py/gen_rules.py` with `bbtools.symtm.prove`: every theorem is a run of the machine for every tail length
`q` and every tape `L` further left (left tapes are written nearest the head first).  At a sweep start the head is in
state C on the blank cell right of the tape; the tape is groups `1^m 0` and ends with `1 1`.  The end configurations
are written the way the run brackets them (the repeated word `110` re-bracketed as `101` or `011`: the same cells). -/

namespace H41716

open TM

/-- The last marked group loses three 1s and the tail gains two groups: `1^m 0 (110)^q 1 1 C>` (m ≥ 4) becomes `1^(m-3) 0 (110)^(q+2) 1 1 C>`, in 10q + 23 steps. -/
theorem walk_down (q : Nat) (L : Tape) :
    steps (10 * q + 23) ⟨cons true (cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons true (L)))))))), blank, .C⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (q) [true, false, true] (cons true (cons false (cons true (L))))))))))), blank, .C⟩ := by
  have hn : 1 + (0 + ((q) * 3 + (13 + (0 + ((q) * 7 + (9)))))) = 10 * q + 23 := by omega
  have h0 : steps 1 ⟨cons true (cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons true (L)))))))), blank, .C⟩ = some ⟨cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (blank)), .A⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (blank)), .A⟩ = some ⟨rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (blank)), .A⟩ := by
    simp only [steps_zero, show cons true (rep (q) [false, true, true] (cons false (cons true (cons true (cons true (cons true (L))))))) = rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (L))))))) from
      rep_rotate (q) [true] [false, true, true] [true, false, true] rfl (cons false (cons true (cons true (cons true (cons true (L))))))]
  have c2 : ∀ L R : Tape, steps 3 ⟨app [true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true, false] R), .A⟩ := fun _ _ => rfl
  have h2 : steps ((q) * 3) ⟨rep (q) [true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons false (cons true (cons true (cons true (cons true (L)))))), cons true (rep (q) [true, true, false] (cons true (blank))), .A⟩ :=
    cross_l trans c2 (q) (cons true (cons false (cons true (cons true (cons true (cons true (L))))))) (cons true (blank))
  have h3 : steps 13 ⟨cons true (cons false (cons true (cons true (cons true (cons true (L)))))), cons true (rep (q) [true, true, false] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (L))))), cons true (cons false (rep (q) [true, true, false] (cons true (blank)))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons true (cons false (cons true (L))))), cons true (cons false (rep (q) [true, true, false] (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (L))))), rep (q) [true, false, true] (cons true (cons false (cons true (blank)))), .A⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (q) [true, true, false] (cons true (blank)))) = rep (q) [true, false, true] (cons true (cons false (cons true (blank)))) from
      rep_rotate (q) [true, false] [true, true, false] [true, false, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 7 ⟨app [false, true] L, app [true, false, true] R, .A⟩ = some ⟨app [false, true] (app [true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((q) * 7) ⟨cons false (cons true (cons true (cons false (cons true (L))))), rep (q) [true, false, true] (cons true (cons false (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (rep (q) [true, false, true] (cons true (cons false (cons true (L)))))), cons true (cons false (cons true (blank))), .A⟩ :=
    cross_r trans c5 (q) (cons true (cons false (cons true (L)))) (cons true (cons false (cons true (blank))))
  have h6 : steps 9 ⟨cons false (cons true (rep (q) [true, false, true] (cons true (cons false (cons true (L)))))), cons true (cons false (cons true (blank))), .A⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (q) [true, false, true] (cons true (cons false (cons true (L))))))))))), blank, .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- The walker steps one group left: `110 1110 (110)^q 1 1 C>` becomes `1^6 0 (110)^(q+1) 1 1 C>`, in 10q + 23 steps. -/
theorem walk_left (q : Nat) (L : Tape) :
