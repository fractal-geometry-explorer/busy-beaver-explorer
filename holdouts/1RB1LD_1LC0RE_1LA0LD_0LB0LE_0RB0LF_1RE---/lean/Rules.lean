    steps (10 * x + 49) ⟨cons true (cons false (cons true (rep (x + 1) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (L))))))))), cons true (cons true (cons false (R))), .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (x + 1) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (L)))))))))))), R, .B⟩ := by
  have hn : 11 + ((x + 1) * 4 + (17 + ((x + 1) * 6 + (11)))) = 10 * x + 49 := by omega
  have h0 : steps 11 ⟨cons true (cons false (cons true (rep (x + 1) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (L))))))))), cons true (cons true (cons false (R))), .B⟩ = some ⟨rep (x + 1) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))), cons true (cons true (cons true (cons true (cons true (cons true (R)))))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [false, false, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true, false, true] R), .A⟩ := fun _ _ => rfl
  have h1 : steps ((x + 1) * 4) ⟨rep (x + 1) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))), cons true (cons true (cons true (cons true (cons true (cons true (R)))))), .A⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (L))))), cons true (rep (x + 1) [true, true, false, true] (cons true (cons true (cons true (cons true (cons true (R))))))), .A⟩ :=
    cross_l trans c1 (x + 1) (cons false (cons false (cons true (cons false (cons true (L)))))) (cons true (cons true (cons true (cons true (cons true (R))))))
  have h2 : steps 17 ⟨cons false (cons false (cons true (cons false (cons true (L))))), cons true (rep (x + 1) [true, true, false, true] (cons true (cons true (cons true (cons true (cons true (R))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons false (cons true (cons true (L)))))), rep (x + 1) [true, true, false, true] (cons true (cons true (cons true (cons true (cons true (R)))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 6 ⟨app [false] L, app [true, true, false, true] R, .E⟩ = some ⟨app [false] (app [false, false, false, true] L), R, .E⟩ := fun _ _ => rfl
  have h3 : steps ((x + 1) * 6) ⟨cons false (cons false (cons false (cons false (cons true (cons true (L)))))), rep (x + 1) [true, true, false, true] (cons true (cons true (cons true (cons true (cons true (R)))))), .E⟩ = some ⟨cons false (rep (x + 1) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (L))))))), cons true (cons true (cons true (cons true (cons true (R))))), .E⟩ :=
    cross_r trans c3 (x + 1) (cons false (cons false (cons false (cons true (cons true (L)))))) (cons true (cons true (cons true (cons true (cons true (R))))))
  have h4 : steps 11 ⟨cons false (rep (x + 1) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (L))))))), cons true (cons true (cons true (cons true (cons true (R))))), .E⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (x + 1) [false, false, false, true] (cons false (cons false (cons false (cons true (cons true (L)))))))))))), R, .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

