    steps (4 * y + 16) ⟨cons true (cons false (cons true (rep (y) [false, false, false, true] (cons false (cons false (rep (x + 1) [false, false, false, true] (L))))))), cons true (cons true (cons false (R))), .B⟩ = some ⟨cons true (cons false (cons true (rep (x) [false, false, false, true] (L)))), cons true (cons true (cons false (cons true (rep (y) [true, true, false, true] (cons true (cons true (cons true (cons true (cons true (R)))))))))), .B⟩ := by
  have hn : 11 + ((y) * 4 + (5)) = 4 * y + 16 := by omega
