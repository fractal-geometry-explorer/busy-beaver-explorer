  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((b) * 4) ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ :=
