import Machine

/-! # Ticks over chains of even blocks, of any length

In block notation (README), the tick of `x | a . b1 . c1 . … . bk . ck . d . e` with all blocks even, for any number
k of pairs.  The pieces `enter`, `lu`, `turn`, `ru`, `leave` are symbolic runs (`py/chain.py` with
`tools/py/bbtools/symtm.py`; re-bracketings by `py/tapeeq.py`); `left_pass` and `right_pass` are inductions on the
list of pairs, and `tick_chain` is the whole tick: from `⟨Q d e (P ps (T a L)), 1 1 0^inf, A⟩` the machine
reaches `⟨Fin d e (W ps d (T' a L)), 1 1 0^inf, A⟩`, the next right-end turn, for every list `ps`, all a, d, e and
every tape L.  `tick_chain_oo` is the same for `x | p | a . b1 . c1 . … . d . e` with p and a odd (the turn
`turn_oo`).  Block lengths: `(1010)^(n+1)` is an even block of length 2n+2, `10 (1010)^v 1010` an odd one of 2v+3. -/

namespace H103746

open TM

set_option maxRecDepth 100000

/-- `L 0 (10)^(2d+2) 0 (10)^(2e+2)`: the last two blocks, before a tick. -/
def Q (d e : Nat) (L : Tape) : Tape := rep (e + 1) [false, true, false, true] (cons false (rep (d + 1) [false, true, false, true] (cons false (L))))
/-- `L 0 1 0 1 (0101)^d`: a block during the left pass. -/
def Rot (d : Nat) (L : Tape) : Tape := rep (d) [true, false, true, false] (cons true (cons false (cons true (cons false (L)))))
/-- `L 0 (10)^(2b+2) 0 (10)^(2c+2)`: a pair of blocks with their separators 0. -/
def Pc (c b : Nat) (L : Tape) : Tape := rep (c + 1) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))
/-- A list of pairs of blocks, the head of the list nearest to the head of the machine. -/
def P : List (Nat × Nat) → Tape → Tape
  | [], L => L
  | (c, b) :: ps, L => Pc c b (P ps L)
/-- What the left pass leaves on the right for a pair. -/
def U (c d : Nat) (R : Tape) : Tape := cons true (cons false (rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))))
/-- `L 1 (10)^(2a+2)`: the block after the separator 1 where the tick turns. -/
def T (a : Nat) (L : Tape) : Tape := rep (a + 1) [false, true, false, true] (cons true (L))
/-- The same after the turn. -/
def T' (a : Nat) (L : Tape) : Tape := cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (L)))))))))
/-- `(0101)^b 0 1 0 0 R`, right of the head during the right pass. -/
def A0100 (b : Nat) (R : Tape) : Tape := rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R)))))
/-- What the right pass leaves on the left for a pair. -/
def V (b c : Nat) (L : Tape) : Tape := cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L))))))))))))
/-- `(10)^(2e+2) 1 0^inf`: the last block and the end of the tape. -/
def R0 (e : Nat) : Tape := rep (e + 1) [true, false, true, false] (cons true (blank))
/-- The last two blocks after a tick. -/
def Fin (d e : Nat) (L : Tape) : Tape := cons false (cons true (cons false (cons true (cons false (rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L)))))))))))))
/-- `L 1 (10)^(2p+3) 1 (10)^(2a+3)`: two odd blocks after separators 1, where the tick turns. -/
def To (p a : Nat) (L : Tape) : Tape := cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))))
/-- The same after the turn. -/
def To' (p a : Nat) (L : Tape) : Tape := cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (p) [true, false, true, false] (cons true (cons false (cons true (cons false (L)))))))))))))))))))
/-- `0 1 0 R`. -/
def D010 (R : Tape) : Tape := cons false (cons true (cons false R))

/-- The symbolic run of `enter`, ending as the run writes it. -/
theorem enter_raw (d e : Nat) (L : Tape) :
    steps (4 * e + 6) ⟨rep (e + 1) [false, true, false, true] (cons false (rep (d + 1) [false, true, false, true] (cons false (L)))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons false (cons true (rep (d) [false, true, false, true] (cons false (L))))), cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (cons true (blank))))), .D⟩ := by
  have hn : (e + 1) * 4 + (2) = 4 * e + 6 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((e + 1) * 4) ⟨rep (e + 1) [false, true, false, true] (cons false (rep (d + 1) [false, true, false, true] (cons false (L)))), cons true (cons true (blank)), .A⟩ = some ⟨cons false (rep (d + 1) [false, true, false, true] (cons false (L))), cons true (rep (e + 1) [true, false, true, false] (cons true (blank))), .A⟩ :=
    cross_l trans c0 (e + 1) (cons false (rep (d + 1) [false, true, false, true] (cons false (L)))) (cons true (blank))
  have h1 : steps 2 ⟨cons false (rep (d + 1) [false, true, false, true] (cons false (L))), cons true (rep (e + 1) [true, false, true, false] (cons true (blank))), .A⟩ = some ⟨cons true (cons false (cons true (rep (d) [false, true, false, true] (cons false (L))))), cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (cons true (blank))))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

/-- The left tape at the end of `enter_raw`, rebracketed. -/
theorem enter_l (d : Nat) (L : Tape) :
    cons true (cons false (cons true (rep (d) [false, true, false, true] (cons false (L))))) = rep (d) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))) := by
  have e0 : cons true (cons false (cons true (rep (d) [false, true, false, true] (cons false (L))))) = cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (L))))) := by
    rw [show cons true (rep (d) [false, true, false, true] (cons false (L))) = rep (d) [true, false, true, false] (cons true (cons false (L))) from rep_rotate (d) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (L))]
  have e1 : cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (L))))) = cons true (rep (d) [false, true, false, true] (cons false (cons true (cons false (L))))) := by
    rw [show cons false (rep (d) [true, false, true, false] (cons true (cons false (L)))) = rep (d) [false, true, false, true] (cons false (cons true (cons false (L)))) from rep_rotate (d) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (L)))]
  have e2 : cons true (rep (d) [false, true, false, true] (cons false (cons true (cons false (L))))) = rep (d) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))) := by
    rw [show cons true (rep (d) [false, true, false, true] (cons false (cons true (cons false (L))))) = rep (d) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))) from rep_rotate (d) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (L))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- A crosses the last block leftwards. -/
theorem enter (d e : Nat) (L : Tape) :
    steps (4 * e + 6) (⟨Q d e L, cons true (cons true blank), .A⟩) = some (⟨Rot d L, D010 (R0 e), .D⟩) := by
  have h := enter_raw d e L
  have e : (some ⟨cons true (cons false (cons true (rep (d) [false, true, false, true] (cons false (L))))), cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (cons true (blank))))), .D⟩ : Option Config) = some ⟨rep (d) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))), cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (cons true (blank))))), .D⟩ := by
    rw [enter_l d L]
  rw [e] at h
  exact h

/-- The symbolic run of `lu`, ending as the run writes it. -/
theorem lu_raw (b c d : Nat) (L R : Tape) :
    steps (4 * c + 12 * d + 22) ⟨rep (d) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c + 1) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (L))))), cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))))))), .D⟩ := by
  have hn : (d) * 4 + (8 + (0 + ((d) * 4 + (3 + (0 + ((d) * 4 + (7 + (0 + ((c) * 4 + (4)))))))))) = 4 * c + 12 * d + 22 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((d) * 4) ⟨rep (d) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c + 1) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons true (cons false (cons true (cons false (rep (c + 1) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))), cons false (rep (d) [false, true, false, true] (cons true (cons false (R)))), .D⟩ :=
    cross_l trans c0 (d) (cons true (cons false (cons true (cons false (rep (c + 1) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))) (cons true (cons false (R)))
  have h1 : steps 8 ⟨cons true (cons false (cons true (cons false (rep (c + 1) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))), cons false (rep (d) [false, true, false, true] (cons true (cons false (R)))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))), cons true (cons false (cons true (rep (d) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))), cons true (cons false (cons true (rep (d) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))), rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (d) [false, true, false, true] (cons true (cons false (R)))))) = rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))) from
      rep_rotate (d) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (cons false (R)))]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((d) * 4) ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))), rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ :=
    cross_r trans c3 (d) (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))))) (cons true (cons false (cons true (cons true (cons false (R))))))
  have h4 : steps 3 ⟨rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ = some ⟨cons false (cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))))), cons true (cons false (R)), .A⟩ := rfl
  have h5 : steps 0 ⟨cons false (cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))))), cons true (cons false (R)), .A⟩ = some ⟨rep (d) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))))), cons true (cons false (R)), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))))) = rep (d) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))))) from
      rep_rotate (d) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))]
  have c6 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h6 : steps ((d) * 4) ⟨rep (d) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))))), cons true (cons false (R)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))))))), cons true (rep (d) [true, false, true, false] (cons false (R))), .A⟩ :=
    cross_l trans c6 (d) (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))))))))))) (cons false (R))
  have h7 : steps 7 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))))))))))), cons true (rep (d) [true, false, true, false] (cons false (R))), .A⟩ = some ⟨cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R)))))))))), .D⟩ := rfl
  have h8 : steps 0 ⟨cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R)))))))))), .D⟩ = some ⟨rep (c) [false, true, false, true] (cons false (cons true (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R)))))))))), .D⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (c) [false, true, false, true] (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))) = rep (c) [false, true, false, true] (cons false (cons true (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))) from
      rep_rotate (c) [false, true] [false, true, false, true] [false, true, false, true] rfl (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))]
  have c9 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
  have h9 : steps ((c) * 4) ⟨rep (c) [false, true, false, true] (cons false (cons true (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R)))))))))), .D⟩ = some ⟨cons false (cons true (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))), cons true (rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))), .D⟩ :=
    cross_l trans c9 (c) (cons false (cons true (cons false (rep (b + 1) [false, true, false, true] (cons false (L)))))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))
  have h10 : steps 4 ⟨cons false (cons true (cons false (rep (b + 1) [false, true, false, true] (cons false (L))))), cons true (rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))), .D⟩ = some ⟨cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (L))))), cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))))))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (h10)))))))))))

/-- The left tape at the end of `lu_raw`, rebracketed. -/
theorem lu_l (b : Nat) (L : Tape) :
    cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (L))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))) := by
  have e0 : cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (L))))) = cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (L))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (L))) = rep (b) [true, false, true, false] (cons true (cons false (L))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (L))]
  have e1 : cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (L))))) = cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (L))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (L)))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (L)))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (L)))]
  have e2 : cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (L))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (L))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (L))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- The left pass over one pair of blocks. -/
theorem lu (b c d : Nat) (L R : Tape) :
    steps (4 * c + 12 * d + 22) (⟨Rot d (Pc c b L), D010 R, .D⟩) = some (⟨Rot b L, D010 (U c d R), .D⟩) := by
  have h := lu_raw b c d L R
  have e : (some ⟨cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (L))))), cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))))))), .D⟩ : Option Config) = some ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))), cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))))))), .D⟩ := by
    rw [lu_l b L]
  rw [e] at h
  exact h

/-- The symbolic run of `turn`, ending as the run writes it. -/
theorem turn_raw (a b : Nat) (L R : Tape) :
    steps (8 * a + 12 * b + 29) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons true (L))))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (L))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ := by
  have hn : (b) * 4 + (8 + (0 + ((b) * 4 + (3 + (0 + ((b) * 4 + (7 + (0 + ((a) * 4 + (5 + (0 + ((a) * 4 + (6))))))))))))) = 8 * a + 12 * b + 29 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((b) * 4) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons true (L))))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons true (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons true (L)))))), cons false (rep (b) [false, true, false, true] (cons true (cons false (R)))), .D⟩ :=
    cross_l trans c0 (b) (cons true (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons true (L))))))) (cons true (cons false (R)))
  have h1 : steps 8 ⟨cons true (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons true (L)))))), cons false (rep (b) [false, true, false, true] (cons true (cons false (R)))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))) from
      rep_rotate (b) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (cons false (R)))]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((b) * 4) ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ :=
    cross_r trans c3 (b) (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L))))))))) (cons true (cons false (cons true (cons true (cons false (R))))))
  have h4 : steps 3 ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ = some ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))))), cons true (cons false (R)), .A⟩ := rfl
  have h5 : steps 0 ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))))), cons true (cons false (R)), .A⟩ = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))))), cons true (cons false (R)), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))))) from
      rep_rotate (b) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))]
  have c6 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h6 : steps ((b) * 4) ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))))), cons true (cons false (R)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L))))))))))), cons true (rep (b) [true, false, true, false] (cons false (R))), .A⟩ :=
    cross_l trans c6 (b) (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))))))))))) (cons false (R))
  have h7 : steps 7 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons true (L))))))))))), cons true (rep (b) [true, false, true, false] (cons false (R))), .A⟩ = some ⟨cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ := rfl
  have h8 : steps 0 ⟨cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ = some ⟨rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (a) [false, true, false, true] (cons true (L)))) = rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))) from
      rep_rotate (a) [false, true] [false, true, false, true] [false, true, false, true] rfl (cons true (L))]
  have c9 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
  have h9 : steps ((a) * 4) ⟨rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ = some ⟨cons false (cons true (cons true (L))), cons true (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .D⟩ :=
    cross_l trans c9 (a) (cons false (cons true (cons true (L)))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))
  have h10 : steps 5 ⟨cons false (cons true (cons true (L))), cons true (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .D⟩ = some ⟨cons true (cons false (L)), cons true (cons false (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ := rfl
  have h11 : steps 0 ⟨cons true (cons false (L)), cons true (cons false (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ = some ⟨cons true (cons false (L)), rep (a) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))) = rep (a) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))) from
      rep_rotate (a) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))]
  have c12 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h12 : steps ((a) * 4) ⟨cons true (cons false (L)), rep (a) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ = some ⟨rep (a) [true, false, true, false] (cons true (cons false (L))), cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .B⟩ :=
    cross_r trans c12 (a) (cons true (cons false (L))) (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))))
  have h13 : steps 6 ⟨rep (a) [true, false, true, false] (cons true (cons false (L))), cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .B⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (L))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (steps_seq trans h12 (h13))))))))))))))

/-- The right tape at the end of `turn_raw`, rebracketed. -/
theorem turn_r (b : Nat) (R : Tape) :
    cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
  have e0 : cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons false (R))) = rep (b) [false, true, false, true] (cons false (cons false (R))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons false (R))]
  have e1 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons false (R)))) = rep (b) [true, false, true, false] (cons true (cons false (cons false (R)))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons false (R)))]
  have e2 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (R))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- The turn at the separator 1. -/
theorem turn (a b : Nat) (L R : Tape) :
    steps (8 * a + 12 * b + 29) (⟨Rot b (T a L), D010 R, .D⟩) = some (⟨T' a L, A0100 b R, .A⟩) := by
  have h := turn_raw a b L R
  have e : (some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (L))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ : Option Config) = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (L))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ := by
    rw [turn_r b R]
  rw [e] at h
  exact h

