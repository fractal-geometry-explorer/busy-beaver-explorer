  have h2 : steps 0 ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ := by
