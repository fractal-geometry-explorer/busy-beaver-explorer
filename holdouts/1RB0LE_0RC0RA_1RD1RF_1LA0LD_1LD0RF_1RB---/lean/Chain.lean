  have h4 : steps 3 ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ = some ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))))))))))), cons true (cons false (R)), .A⟩ := rfl
