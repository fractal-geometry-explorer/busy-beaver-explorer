  have h2 : steps ((c) * 4) ⟨cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L))))))), rep (c) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R)))))))))), .B⟩ = some ⟨rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L)))))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))), .B⟩ :=
    cross_r trans c2 (c) (cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L)))))))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))))
  have h3 : steps 4 ⟨rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L)))))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))))))), .B⟩ = some ⟨cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L)))))))))))), cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The right tape at the end of `ru_raw`, rebracketed. -/
theorem ru_r (d : Nat) (R : Tape) :
    cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))) = rep (d) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
  have e0 : cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))) = cons false (cons true (rep (d) [false, true, false, true] (cons false (cons false (R))))) := by
    rw [show cons false (rep (d) [true, false, true, false] (cons false (R))) = rep (d) [false, true, false, true] (cons false (cons false (R))) from rep_rotate (d) [false] [true, false, true, false] [false, true, false, true] rfl (cons false (R))]
  have e1 : cons false (cons true (rep (d) [false, true, false, true] (cons false (cons false (R))))) = cons false (rep (d) [true, false, true, false] (cons true (cons false (cons false (R))))) := by
    rw [show cons true (rep (d) [false, true, false, true] (cons false (cons false (R)))) = rep (d) [true, false, true, false] (cons true (cons false (cons false (R)))) from rep_rotate (d) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons false (R)))]
  have e2 : cons false (rep (d) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (d) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
    rw [show cons false (rep (d) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (d) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) from rep_rotate (d) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (R))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- The right pass over one pair of blocks. -/
theorem ru (b c d : Nat) (L R : Tape) :
    steps (4 * b + 4 * c + 10) (⟨L, A0100 b (U c d R), .A⟩) = some (⟨V b c L, A0100 d R, .A⟩) := by
  have h := ru_raw b c d L R
  have e : (some ⟨cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L)))))))))))), cons false (cons true (cons false (rep (d) [true, false, true, false] (cons false (R))))), .A⟩ : Option Config) = some ⟨cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (L)))))))))))), rep (d) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ := by
    rw [ru_r d R]
  rw [e] at h
  exact h

/-- The symbolic run of `leave`, ending as the run writes it. -/
theorem leave_raw (d e : Nat) (L : Tape) :
    steps (4 * d + 4 * e + 13) ⟨L, rep (d) [false, true, false, true] (cons false (cons true (cons false (cons false (rep (e + 1) [true, false, true, false] (cons true (blank))))))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L))))))))))))), cons true (cons true (blank)), .A⟩ := by
  have hn : (d) * 4 + (6 + (0 + ((e) * 4 + (7)))) = 4 * d + 4 * e + 13 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((d) * 4) ⟨L, rep (d) [false, true, false, true] (cons false (cons true (cons false (cons false (rep (e + 1) [true, false, true, false] (cons true (blank))))))), .A⟩ = some ⟨rep (d) [false, true, false, true] (L), cons false (cons true (cons false (cons false (rep (e + 1) [true, false, true, false] (cons true (blank)))))), .A⟩ :=
    cross_r trans c0 (d) (L) (cons false (cons true (cons false (cons false (rep (e + 1) [true, false, true, false] (cons true (blank)))))))
  have h1 : steps 6 ⟨rep (d) [false, true, false, true] (L), cons false (cons true (cons false (cons false (rep (e + 1) [true, false, true, false] (cons true (blank)))))), .A⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L))))))), cons true (cons false (rep (e) [true, false, true, false] (cons true (blank)))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L))))))), cons true (cons false (rep (e) [true, false, true, false] (cons true (blank)))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L))))))), rep (e) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (e) [true, false, true, false] (cons true (blank)))) = rep (e) [true, false, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (e) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons true (blank))]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((e) * 4) ⟨cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L))))))), rep (e) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ = some ⟨rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L)))))))), cons true (cons false (cons true (blank))), .B⟩ :=
    cross_r trans c3 (e) (cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L)))))))) (cons true (cons false (cons true (blank))))
  have h4 : steps 7 ⟨rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L)))))))), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (d) [false, true, false, true] (L))))))))))))), cons true (cons true (blank)), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The last block, back at the right end. -/
theorem leave (d e : Nat) (L : Tape) :
    steps (4 * d + 4 * e + 13) (⟨L, A0100 d (R0 e), .A⟩) = some (⟨Fin d e L, cons true (cons true blank), .A⟩) := by
  have h := leave_raw d e L
  exact h

/-- The left pass over a list of pairs: the block it ends on and what it leaves on the right. -/
def LP : List (Nat × Nat) → Nat → Tape → Nat × Tape
  | [], d, R => (d, R)
  | (c, b) :: ps, d, R => LP ps b (U c d R)

/-- What the right pass leaves on the left. -/
def W : List (Nat × Nat) → Nat → Tape → Tape
  | [], _, L => L
  | (c, b) :: ps, _, L => V b c (W ps b L)

theorem left_pass (L : Tape) : ∀ (ps : List (Nat × Nat)) (d : Nat) (R : Tape), ∃ n,
    steps n ⟨Rot d (P ps L), D010 R, .D⟩ = some ⟨Rot (LP ps d R).1 L, D010 (LP ps d R).2, .D⟩ := by
  intro ps
  induction ps with
  | nil => intro d R; exact ⟨0, rfl⟩
  | cons p ps ih =>
    obtain ⟨c, b⟩ := p
    intro d R
    obtain ⟨n, hn⟩ := ih b (U c d R)
    exact ⟨_, steps_seq trans (lu b c d (P ps L) R) hn⟩

theorem right_pass (L : Tape) : ∀ (ps : List (Nat × Nat)) (d : Nat) (R : Tape), ∃ n,
    steps n ⟨L, A0100 (LP ps d R).1 (LP ps d R).2, .A⟩ = some ⟨W ps d L, A0100 d R, .A⟩ := by
  intro ps
  induction ps with
  | nil => intro d R; exact ⟨0, rfl⟩
  | cons p ps ih =>
    obtain ⟨c, b⟩ := p
    intro d R
    obtain ⟨n, hn⟩ := ih b (U c d R)
    exact ⟨_, steps_seq trans hn (ru b c d (W ps b L) R)⟩

/-- A whole tick of `x | a . b1 . c1 . … . bk . ck . d . e` (all blocks even, any k), from one right-end turn to the
next. -/
theorem tick_chain (L : Tape) (a d e : Nat) (ps : List (Nat × Nat)) : ∃ n,
    steps n ⟨Q d e (P ps (T a L)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (T' a L)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (T a L) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (T' a L) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (T a L)))
    (steps_seq trans h1 (steps_seq trans (turn a _ L _) (steps_seq trans h2 (leave d e (W ps d (T' a L))))))⟩

/-- A whole tick of `x | p | a . b1 . c1 . … . bk . ck . d . e` with p, a odd and the rest even (any k). -/
theorem tick_chain_oo (L : Tape) (p a d e : Nat) (ps : List (Nat × Nat)) : ∃ n,
    steps n ⟨Q d e (P ps (To p a L)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (To' p a L)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (To p a L) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (To' p a L) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (To p a L)))
    (steps_seq trans h1 (steps_seq trans (turn_oo p a _ L _) (steps_seq trans h2 (leave d e (W ps d (To' p a L))))))⟩

end H103746
