/-- The right tape at the end of `turn_oo_raw`, rebracketed. -/
theorem turn_oo_r (b : Nat) (R : Tape) :
    cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
  have e0 : cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons false (R))) = rep (b) [false, true, false, true] (cons false (cons false (R))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons false (R))]
  have e1 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons false (R)))) = rep (b) [true, false, true, false] (cons true (cons false (cons false (R)))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons false (R)))]
  have e2 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (R))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- The turn at two odd blocks after separators 1. -/
theorem turn_oo (p a b : Nat) (L R : Tape) :
    steps (8 * a + 12 * b + 8 * p + 47) (⟨Rot b (To p a L), D010 R, .D⟩) = some (⟨To' p a L, A0100 b R, .A⟩) := by
  have h := turn_oo_raw a b p L R
  have e : (some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (p) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))))))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ : Option Config) = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (p) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))))))))))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ := by
    rw [turn_oo_r b R]
  rw [e] at h
  exact h

