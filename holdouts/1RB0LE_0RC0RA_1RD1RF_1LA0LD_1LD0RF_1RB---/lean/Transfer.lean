  have e1 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))]
  exact (e0.trans (e1)).trans (rfl).symm

/-- The middle turns at the left end, after an odd first block. -/
theorem mid_o0 (b : Nat) (R : Tape) :
    steps (8 * b + 26) (⟨O0 b, cons true R, .D⟩) = some (⟨O0' b, cons false R, .A⟩) := by
  have h := mid_o0_raw b R
  have e : (some ⟨cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), cons false (R), .A⟩ : Option Config) = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), cons false (R), .A⟩ := by
    rw [mid_o0_l b]
  rw [e] at h
