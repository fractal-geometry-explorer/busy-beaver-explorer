/-- The middle of a tick at the left end: from the last separator of the front in state D back to it in state A,
never reading the cells right of it. -/
def Mid (L L' : Tape) : Prop := ∀ R : Tape, ∃ n, steps n ⟨L, cons true R, .D⟩ = some ⟨L', cons false R, .A⟩

/-- The left-end tick of `F | 3`, from one right-end turn to the next, for any front with a middle. -/
theorem main_of_mid {L L' : Tape} (h : Mid L L') : ∃ n,
    steps n ⟨Three L, cons true (cons true blank), .A⟩ = some ⟨Four L', cons true (cons true blank), .A⟩ := by
  obtain ⟨n, hn⟩ := h M1
  exact ⟨_, steps_seq trans (main_in L) (steps_seq trans hn (main_out L'))⟩

/-- A copy round over the front `F |`, from one turn at the edge of X to the next, for any front with a middle:
the same middle as the tick of `F | 3`, so the same new front, and one pair `10` of X moved. -/
theorem round_of_mid {L L' : Tape} (h : Mid L L') (b : Nat) (R : Tape) : ∃ n,
    steps n ⟨XT b L, cons true (cons false (cons false (cons true (cons false R)))), .D⟩ =
      some ⟨XT b (G L'), cons true (cons false (cons false R)), .D⟩ := by
  obtain ⟨n, hn⟩ := h (Y b (cons true (cons false R)))
  exact ⟨_, steps_seq trans (copy_in b L _) (steps_seq trans hn (copy_out b L' R))⟩

/-- The transfer: a middle proved for one front gives both its left-end tick and its copy round. -/
theorem transfer {L L' : Tape} (h : Mid L L') :
    (∃ n, steps n ⟨Three L, cons true (cons true blank), .A⟩ = some ⟨Four L', cons true (cons true blank), .A⟩) ∧
    ∀ (b : Nat) (R : Tape), ∃ n, steps n ⟨XT b L, cons true (cons false (cons false (cons true (cons false R)))), .D⟩ =
      some ⟨XT b (G L'), cons true (cons false (cons false R)), .D⟩ :=
  ⟨main_of_mid h, round_of_mid h⟩

/-- Rounds in a row: a list of fronts, each the middle's result of the one before, grown by a pair. -/
def Mids : Tape → List Tape → Prop
  | _, [] => True
  | L, L' :: Ls => Mid L L' ∧ Mids (G L') Ls

/-- The last front of such a list. -/
def lastF : Tape → List Tape → Tape
  | L, [] => L
  | _, L' :: Ls => lastF (G L') Ls

/-- k = |Ls| copy rounds in a row move k pairs of X. -/
theorem rounds_of_mids : ∀ (Ls : List Tape) (L : Tape), Mids L Ls → ∀ (b : Nat) (R : Tape), ∃ n,
    steps n ⟨XT b L, cons true (cons false (cons false (rep Ls.length [true, false] R))), .D⟩ =
      some ⟨XT b (lastF L Ls), cons true (cons false (cons false R)), .D⟩ := by
  intro Ls
  induction Ls with
  | nil => intro L _ b R; exact ⟨0, rfl⟩
  | cons L' Ls ih =>
    intro L h b R
    obtain ⟨n1, h1⟩ := round_of_mid h.1 b (rep Ls.length [true, false] R)
    obtain ⟨n2, h2⟩ := ih (G L') h.2 b R
    exact ⟨_, steps_seq trans h1 h2⟩

/-- `L . (10)^(2b+4)`. -/
def Ev (b : Nat) (L : Tape) : Tape := rep (b + 2) [false, true, false, true] (cons false (L))
/-- `3 | (10)^(2b+3)`. -/
def O1 (b : Nat) : Tape := rep (b + 1) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))

/-- A block that gave a pair to the block before it gets one back from the block after it. -/
theorem G_H_raw (b : Nat) (L : Tape) :
    cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (L)))))))) = rep (b + 1) [false, true, false, true] (cons true (cons false (cons true (L)))) := by
  have e0 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (L)))))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (L))))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (L))))))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons true (cons false (cons true (L))))))]
  have e1 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))]
  have f0 : rep (b + 1) [false, true, false, true] (cons true (cons false (cons true (L)))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))) := by
    rw [show rep (b + 1) [false, true, false, true] (cons true (cons false (cons true (L)))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (L)))))))) from rep_add (b) 1 [false, true, false, true] (cons true (cons false (cons true (L))))]
  exact (e0.trans (e1)).trans (f0).symm

/-- A block that gave a pair to the block before it gets one back from the block after it. -/
theorem G_H (b : Nat) (L : Tape) : G (H b L) = XT b (G L) := G_H_raw b L

/-- `L | o` becomes `L . o+1`. -/
theorem G_Od'_raw (b : Nat) (L : Tape) :
    cons false (cons true (rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (L)))))) = rep (b + 2) [false, true, false, true] (cons false (L)) := by
  have e0 : cons false (cons true (rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (L)))))) = cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) := by
    rw [show rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (L)))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) from rep_add (b) 1 [false, true, false, true] (cons false (cons true (cons false (L))))]
  have e1 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L))))))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L))))))))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L))))))))]
  have e2 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))]
  have f0 : rep (b + 2) [false, true, false, true] (cons false (L)) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) := by
    rw [show rep (b + 2) [false, true, false, true] (cons false (L)) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))) from rep_add (b) 2 [false, true, false, true] (cons false (L))]
  exact (e0.trans (e1.trans (e2))).trans (f0).symm

/-- `L | o` becomes `L . o+1`. -/
theorem G_Od' (b : Nat) (L : Tape) : G (Od' b L) = Ev b L := G_Od'_raw b L

/-- An even first block grows by 2. -/
theorem G_E0'_raw (b : Nat) :
    cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) = rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))) := by
  have e0 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))]
  have e1 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))]
  have f0 : rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) := by
    rw [show rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) from rep_add (b) 1 [false, true, false, true] (cons false (cons true (cons false (cons true (blank)))))]
  exact (e0.trans (e1)).trans (f0).symm

/-- An even first block grows by 2. -/
theorem G_E0' (b : Nat) : G (E0' b) = E0 (b + 1) := G_E0'_raw b

/-- An odd first block o becomes `3 | o`. -/
theorem G_O0'_raw (b : Nat) :
    cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) = rep (b + 1) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))) := by
  have e0 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))]
  have e1 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))]
  have f0 : rep (b + 1) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) := by
    rw [show rep (b + 1) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))) from rep_add (b) 1 [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))]
  exact (e0.trans (e1)).trans (f0).symm

/-- An odd first block o becomes `3 | o`. -/
theorem G_O0' (b : Nat) : G (O0' b) = O1 b := G_O0'_raw b

theorem four_eq (L : Tape) : Four L = Four4 (G L) := rfl

/-- An even block after a separator 1 is passive: the middle crosses it, runs on what is left of it, and comes back. -/
theorem mid_even {L L' : Tape} (h : Mid L L') (b : Nat) : Mid (XT b L) (H b L') := by
  intro R
  obtain ⟨n, hn⟩ := h (Yp b R)
  exact ⟨_, steps_seq trans (le b L R) (steps_seq trans hn (re b L' R))⟩

/-- Even blocks after separators 1, the first one of the list nearest the left end. -/
def XTs : List Nat → Tape → Tape
  | [], L => L
  | b :: bs, L => XTs bs (XT b L)
/-- The same blocks after the middle. -/
def Hs : List Nat → Tape → Tape
  | [], L => L
  | b :: bs, L => Hs bs (H b L)

/-- Any number of even blocks after separators 1 at the end of the front are passive. -/
theorem mid_evens : ∀ (bs : List Nat) {L L' : Tape}, Mid L L' → Mid (XTs bs L) (Hs bs L') := by
  intro bs
  induction bs with
  | nil => intro L L' h; exact h
  | cons b bs ih => intro L L' h; exact ih (mid_even h b)

/-- After the round (or the tick) the passive blocks are what they were. -/
theorem G_Hs : ∀ (bs : List Nat) (L : Tape), G (Hs bs L) = XTs bs (G L) := by
  intro bs
  induction bs with
  | nil => intro L; rfl
  | cons b bs ih => intro L; simp only [Hs, XTs]; rw [ih, G_H]

/-- The middle for the fronts `L | o | e1 | … | ek |` (e1 … ek even, any k). -/
theorem midF_od (b : Nat) (L : Tape) (bs : List Nat) : Mid (XTs bs (Od b L)) (Hs bs (Od' b L)) :=
  mid_evens bs (fun R => ⟨_, mid_od b L R⟩)

/-- The copy round over the front `L | o | e1 | … | ek |`  ->  `L . o+1 | e1 | … | ek |`, whatever L is: from one turn at X to the next. -/
theorem round_od (b : Nat) (L : Tape) (bs : List Nat) (c : Nat) (R : Tape) : ∃ n,
    steps n ⟨XT c (XTs bs (Od b L)), cons true (cons false (cons false (cons true (cons false R)))), .D⟩ =
      some ⟨XT c (XTs bs (Ev b L)), cons true (cons false (cons false R)), .D⟩ := by
  have h := round_of_mid (midF_od b L bs) c R
  rwa [G_Hs, G_Od' b L] at h

/-- The left-end tick of the same front followed by the last block 3: `L | o | e1 | … | ek | 3`  ->  `L . o+1 | e1 | … | ek | 4`, whatever L is. -/
theorem tick3_od (b : Nat) (L : Tape) (bs : List Nat) : ∃ n,
    steps n ⟨Three (XTs bs (Od b L)), cons true (cons true blank), .A⟩ =
      some ⟨Four4 (XTs bs (Ev b L)), cons true (cons true blank), .A⟩ := by
  have h := main_of_mid (midF_od b L bs)
  rwa [four_eq, G_Hs, G_Od' b L] at h

/-- The middle for the fronts `e | e1 | … | ek |` (e1 … ek even, any k). -/
theorem midF_e0 (b : Nat) (bs : List Nat) : Mid (XTs bs (E0 b)) (Hs bs (E0' b)) :=
  mid_evens bs (fun R => ⟨_, mid_e0 b R⟩)

/-- The copy round over the front `e | e1 | … | ek |`  ->  `e+2 | e1 | … | ek |`, e the first block: from one turn at X to the next. -/
theorem round_e0 (b : Nat) (bs : List Nat) (c : Nat) (R : Tape) : ∃ n,
    steps n ⟨XT c (XTs bs (E0 b)), cons true (cons false (cons false (cons true (cons false R)))), .D⟩ =
      some ⟨XT c (XTs bs (E0 (b + 1))), cons true (cons false (cons false R)), .D⟩ := by
  have h := round_of_mid (midF_e0 b bs) c R
  rwa [G_Hs, G_E0' b] at h

/-- The left-end tick of the same front followed by the last block 3: `e | e1 | … | ek | 3`  ->  `e+2 | e1 | … | ek | 4`, e the first block. -/
theorem tick3_e0 (b : Nat) (bs : List Nat) : ∃ n,
    steps n ⟨Three (XTs bs (E0 b)), cons true (cons true blank), .A⟩ =
      some ⟨Four4 (XTs bs (E0 (b + 1))), cons true (cons true blank), .A⟩ := by
  have h := main_of_mid (midF_e0 b bs)
  rwa [four_eq, G_Hs, G_E0' b] at h

/-- The middle for the fronts `o | e1 | … | ek |` (e1 … ek even, any k). -/
theorem midF_o0 (b : Nat) (bs : List Nat) : Mid (XTs bs (O0 b)) (Hs bs (O0' b)) :=
  mid_evens bs (fun R => ⟨_, mid_o0 b R⟩)

/-- The copy round over the front `o | e1 | … | ek |`  ->  `3 | o | e1 | … | ek |`, o the first block: from one turn at X to the next. -/
theorem round_o0 (b : Nat) (bs : List Nat) (c : Nat) (R : Tape) : ∃ n,
    steps n ⟨XT c (XTs bs (O0 b)), cons true (cons false (cons false (cons true (cons false R)))), .D⟩ =
      some ⟨XT c (XTs bs (O1 b)), cons true (cons false (cons false R)), .D⟩ := by
  have h := round_of_mid (midF_o0 b bs) c R
  rwa [G_Hs, G_O0' b] at h

/-- The left-end tick of the same front followed by the last block 3: `o | e1 | … | ek | 3`  ->  `3 | o | e1 | … | ek | 4`, o the first block. -/
theorem tick3_o0 (b : Nat) (bs : List Nat) : ∃ n,
    steps n ⟨Three (XTs bs (O0 b)), cons true (cons true blank), .A⟩ =
      some ⟨Four4 (XTs bs (O1 b)), cons true (cons true blank), .A⟩ := by
  have h := main_of_mid (midF_o0 b bs)
  rwa [four_eq, G_Hs, G_O0' b] at h

/-- The front `L  | o . e` (v0 = 0). -/
def S_b_LIo_e_v0eq0 (v1 : Nat) (L : Tape) : Tape := rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))))))
/-- The same after the middle. -/
def S'_b_LIo_e_v0eq0 (v1 : Nat) (L : Tape) : Tape := cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))))))

/-- The symbolic run of `mid_b_LIo_e_v0eq0`, ending as the run writes it. -/
theorem mid_b_LIo_e_v0eq0_raw (v1 : Nat) (L R : Tape) :
    steps (8 * v1 + 12) ⟨rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))))), cons true (R), .D⟩ = some ⟨cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))))), cons false (R), .A⟩ := by
  have hn : (v1) * 4 + (10 + (0 + ((v1) * 4 + (2)))) = 8 * v1 + 12 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((v1) * 4) ⟨rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))))), cons true (R), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))))), cons true (rep (v1) [true, false, true, false] (R)), .D⟩ :=
    cross_l trans c0 (v1) (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))))) (R)
  have h1 : steps 10 ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))))), cons true (rep (v1) [true, false, true, false] (R)), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))), cons false (cons true (cons false (rep (v1) [true, false, true, false] (R)))), .A⟩ := rfl
  have h2 : steps 0 ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))), cons false (cons true (cons false (rep (v1) [true, false, true, false] (R)))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))), rep (v1) [false, true, false, true] (cons false (cons true (cons false (R)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (v1) [true, false, true, false] (R)))) = rep (v1) [false, true, false, true] (cons false (cons true (cons false (R)))) from
      rep_rotate (v1) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (R)]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((v1) * 4) ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))))), rep (v1) [false, true, false, true] (cons false (cons true (cons false (R)))), .A⟩ = some ⟨rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))), cons false (cons true (cons false (R))), .A⟩ :=
    cross_r trans c3 (v1) (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))) (cons false (cons true (cons false (R))))
  have h4 : steps 2 ⟨rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))), cons false (cons true (cons false (R))), .A⟩ = some ⟨cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (L))))))))))))), cons false (R), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The middle for the front `L  | o . e`. -/
theorem mid_b_LIo_e_v0eq0 (v1 : Nat) (L R : Tape) :
    steps (8 * v1 + 12) (⟨S_b_LIo_e_v0eq0 v1 L, cons true R, .D⟩) = some (⟨S'_b_LIo_e_v0eq0 v1 L, cons false R, .A⟩) := by
  have h := mid_b_LIo_e_v0eq0_raw v1 L R
