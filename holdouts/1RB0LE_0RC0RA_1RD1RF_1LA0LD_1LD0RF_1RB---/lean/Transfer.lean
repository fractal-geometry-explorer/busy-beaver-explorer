    steps (8 * b + 26) ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), cons true (R), .D⟩ = some ⟨cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), cons false (R), .A⟩ := by
  have hn : (b) * 4 + (24 + (0 + ((b) * 4 + (2)))) = 8 * b + 26 := by omega
