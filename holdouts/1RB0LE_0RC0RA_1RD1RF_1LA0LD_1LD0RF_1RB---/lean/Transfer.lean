  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((b) * 4) ⟨cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (R)))), .A⟩ = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))), cons false (cons true (cons false (R))), .A⟩ :=
    cross_r trans c3 (b) (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))) (cons false (cons true (cons false (R))))
  have h4 : steps 2 ⟨rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))), cons false (cons true (cons false (R))), .A⟩ = some ⟨cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), cons false (R), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The left tape at the end of `mid_o0_raw`, rebracketed. -/
theorem mid_o0_l (b : Nat) :
