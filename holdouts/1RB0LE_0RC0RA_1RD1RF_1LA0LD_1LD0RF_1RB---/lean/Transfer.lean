  have h1 : steps 0 ⟨cons true (cons true (cons false (cons true (L)))), cons true (rep (b) [false, true, false, true] (cons false (R))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (L)))), rep (b) [true, false, true, false] (cons true (cons false (R))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (b) [false, true, false, true] (cons false (R))) = rep (b) [true, false, true, false] (cons true (cons false (R))) from
      rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (R))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((b) * 4) ⟨cons true (cons true (cons false (cons true (L)))), rep (b) [true, false, true, false] (cons true (cons false (R))), .B⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (L))))), cons true (cons false (R)), .B⟩ :=
    cross_r trans c2 (b) (cons true (cons true (cons false (cons true (L))))) (cons true (cons false (R)))
  have h3 : steps 1 ⟨rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (L))))), cons true (cons false (R)), .B⟩ = some ⟨cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (L)))))), cons false (R), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The left tape at the end of `re_raw`, rebracketed. -/
theorem re_l (b : Nat) (L : Tape) :
    cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (L)))))) = rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (L)))))) := by
  have e0 : cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (L)))))) = rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (L)))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (L)))))) = rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (L)))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons true (cons false (cons true (L)))))]
  exact (e0).trans (rfl).symm

/-- And back to the right, passing one pair to the block before it. -/
theorem re (b : Nat) (L R : Tape) :
    steps (4 * b + 5) (⟨L, cons false (Yp b R), .A⟩) = some (⟨H b L, cons false R, .A⟩) := by
  have h := re_raw b L R
  have e : (some ⟨cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (L)))))), cons false (R), .A⟩ : Option Config) = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (L)))))), cons false (R), .A⟩ := by
    rw [re_l b L]
  rw [e] at h
  exact h

/-- The symbolic run of `mid_od`, ending as the run writes it. -/
theorem mid_od_raw (b : Nat) (L R : Tape) :
    steps (8 * b + 14) ⟨rep (b + 1) [false, true, false, true] (cons false (cons true (cons true (L)))), cons true (R), .D⟩ = some ⟨cons false (rep (b + 1) [true, false, true, false] (cons true (cons false (L)))), cons false (R), .A⟩ := by
  have hn : (b + 1) * 4 + (5 + (0 + ((b + 1) * 4 + (1)))) = 8 * b + 14 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((b + 1) * 4) ⟨rep (b + 1) [false, true, false, true] (cons false (cons true (cons true (L)))), cons true (R), .D⟩ = some ⟨cons false (cons true (cons true (L))), cons true (rep (b + 1) [true, false, true, false] (R)), .D⟩ :=
    cross_l trans c0 (b + 1) (cons false (cons true (cons true (L)))) (R)
  have h1 : steps 5 ⟨cons false (cons true (cons true (L))), cons true (rep (b + 1) [true, false, true, false] (R)), .D⟩ = some ⟨cons true (cons false (L)), cons true (cons false (rep (b + 1) [true, false, true, false] (R))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (L)), cons true (cons false (rep (b + 1) [true, false, true, false] (R))), .B⟩ = some ⟨cons true (cons false (L)), rep (b + 1) [true, false, true, false] (cons true (cons false (R))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (b + 1) [true, false, true, false] (R))) = rep (b + 1) [true, false, true, false] (cons true (cons false (R))) from
      rep_rotate (b + 1) [true, false] [true, false, true, false] [true, false, true, false] rfl (R)]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((b + 1) * 4) ⟨cons true (cons false (L)), rep (b + 1) [true, false, true, false] (cons true (cons false (R))), .B⟩ = some ⟨rep (b + 1) [true, false, true, false] (cons true (cons false (L))), cons true (cons false (R)), .B⟩ :=
    cross_r trans c3 (b + 1) (cons true (cons false (L))) (cons true (cons false (R)))
  have h4 : steps 1 ⟨rep (b + 1) [true, false, true, false] (cons true (cons false (L))), cons true (cons false (R)), .B⟩ = some ⟨cons false (rep (b + 1) [true, false, true, false] (cons true (cons false (L)))), cons false (R), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The left tape at the end of `mid_od_raw`, rebracketed. -/
theorem mid_od_l (b : Nat) (L : Tape) :
    cons false (rep (b + 1) [true, false, true, false] (cons true (cons false (L)))) = rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (L)))) := by
  have e0 : cons false (rep (b + 1) [true, false, true, false] (cons true (cons false (L)))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) := by
    rw [show rep (b + 1) [true, false, true, false] (cons true (cons false (L))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (L))))))) from rep_add (b) 1 [true, false, true, false] (cons true (cons false (L)))]
  have e1 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))]
  have f0 : rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (L)))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) := by
    rw [show rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (L)))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) from rep_add (b) 1 [false, true, false, true] (cons false (cons true (cons false (L))))]
  exact (e0.trans (e1)).trans (f0).symm

/-- The middle turns in an odd block after a separator 1, whatever is left of it. -/
theorem mid_od (b : Nat) (L R : Tape) :
    steps (8 * b + 14) (⟨Od b L, cons true R, .D⟩) = some (⟨Od' b L, cons false R, .A⟩) := by
  have h := mid_od_raw b L R
  have e : (some ⟨cons false (rep (b + 1) [true, false, true, false] (cons true (cons false (L)))), cons false (R), .A⟩ : Option Config) = some ⟨rep (b + 1) [false, true, false, true] (cons false (cons true (cons false (L)))), cons false (R), .A⟩ := by
    rw [mid_od_l b L]
  rw [e] at h
  exact h

