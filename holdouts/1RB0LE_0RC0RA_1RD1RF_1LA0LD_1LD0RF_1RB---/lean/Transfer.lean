  have h2 : steps 0 ⟨cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (R)))), .A⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (R)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (b) [true, false, true, false] (R)))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (R)))) from
