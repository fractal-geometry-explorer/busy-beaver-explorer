  have e : (some ⟨cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))))), cons false (R), .A⟩ : Option Config) = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), cons false (R), .A⟩ := by
