  exact steps_congr trans (a := 1 + (0 + ((b) * 4 + (7 + (0 + ((a) * 4 + (10 + (0 + ((a) * 4 + (7 + (0 + ((b) * 4 + (9))))))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (h12)))))))))))))

/-- `C> 1 1` halts: C keeps the 1 and moves right in state F, which reads a 1. -/
theorem halt_C (L R : Tape) : ∃ c, steps 1 ⟨L, cons true (cons true R), .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `E> 1 1` halts: E erases its 1 and moves right in state F, which reads a 1. -/
theorem halt_E (L R : Tape) : ∃ c, steps 1 ⟨L, cons true (cons true R), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

