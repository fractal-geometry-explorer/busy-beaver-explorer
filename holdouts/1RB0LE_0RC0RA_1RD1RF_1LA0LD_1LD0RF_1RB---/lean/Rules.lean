import Machine

/-! # Shift rules of 1RB0LE_0RC0RA_1RD1RF_1LA0LD_1LD0RF_1RB---

The sweeps of the machine: moving left, A, E and D rewrite an alternating stretch `1010...` four cells at a time,
complementing it (`sweep_left`); moving right, B and A complement it two cells at a time (`sweep_right`).  A
defect (two equal cells side by side) is where the sweeps turn or change phase.  One tick of the counter is proved
whole: when the last separator is a 1 and the last block has even length, the round trip turns that separator into
a 0 and lengthens the last block by two (`tick_last`); a second tick pattern is proved the same way (`tick_oo`, in
the block notation of `c/blocks.c`).  Longer patterns (`py/ticks.py`) give proofs too long for the kernel's default
limits and are left to the symbolic simulator.  The only halt is F reading a 1, reached from `C> 1 1` or
`E> 1 1` (`halt_C`, `halt_E`); `lean/Route.lean` shows that only the first can occur, as `B> 0 1 1`.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H103746

open TM

/-- A crosses `1010` leftwards in four steps (A, E, D, D) and complements it: `1010...10 1` becomes `1 1010...10`. -/
theorem sweep_left (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨rep (n) [false, true, false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, false, true, false] (R)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨rep (n) [false, true, false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, false, true, false] (R)), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 4) (by omega) (h0)

/-- B crosses `10` rightwards in two steps (B, A) and complements it. -/
theorem sweep_right (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, false] (R), .B⟩ = some ⟨rep (n) [true, false] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, false] (R), .B⟩ = some ⟨rep (n) [true, false] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- One tick at the right end: `x 1 (10)^(2k) A> 1 1` becomes `x 0 (10)^(2k+2) A> 1 1` (the last separator 1 becomes a 0, the last block grows by two), back at the next right-end turn. -/
theorem tick_last (k : Nat) (L : Tape) :
    steps (8 * k + 8) ⟨rep (k) [false, true, false, true] (cons true (L)), cons true (cons true (blank)), .A⟩ = some ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (L)))))), cons true (cons true (blank)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((k) * 4) ⟨rep (k) [false, true, false, true] (cons true (L)), cons true (cons true (blank)), .A⟩ = some ⟨cons true (L), cons true (rep (k) [true, false, true, false] (cons true (blank))), .A⟩ :=
    cross_l trans c0 (k) (cons true (L)) (cons true (blank))
  have h1 : steps 3 ⟨cons true (L), cons true (rep (k) [true, false, true, false] (cons true (blank))), .A⟩ = some ⟨cons true (cons false (L)), rep (k) [true, false, true, false] (cons true (blank)), .B⟩ := rfl
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 4) ⟨cons true (cons false (L)), rep (k) [true, false, true, false] (cons true (blank)), .B⟩ = some ⟨rep (k) [true, false, true, false] (cons true (cons false (L))), cons true (blank), .B⟩ :=
    cross_r trans c2 (k) (cons true (cons false (L))) (cons true (blank))
  have h3 : steps 5 ⟨rep (k) [true, false, true, false] (cons true (cons false (L))), cons true (blank), .B⟩ = some ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (L)))))), cons true (cons true (blank)), .A⟩ := rfl
  exact steps_congr trans (a := (k) * 4 + (3 + ((k) * 4 + (5)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- One tick, in blocks: `| 2a+3 | 2b+3` becomes `. 2a+4 | 2b+4` (two odd blocks after separators 1). -/
theorem tick_oo (a b : Nat) (L : Tape) :
    steps (8 * a + 8 * b + 34) ⟨cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (L)))))))))))))))))))), cons true (cons true (blank)), .A⟩ := by
  have h0 : steps 1 ⟨cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))), cons false (cons false (cons true (blank))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))), cons false (cons false (cons true (blank))), .E⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))), cons false (cons false (cons true (blank))), .E⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))) from
      rep_rotate (b) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((b) * 4) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))), cons false (cons false (cons true (blank))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))), cons false (rep (b) [false, true, false, true] (cons false (cons true (blank)))), .E⟩ :=
    cross_l trans c2 (b) (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))) (cons false (cons true (blank)))
  have h3 : steps 7 ⟨cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))))))))))))), cons false (rep (b) [false, true, false, true] (cons false (cons true (blank)))), .E⟩ = some ⟨cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank))))))))))), .D⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank))))))))))), .D⟩ = some ⟨rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (L))))))), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank))))))))))), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))) = rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (L))))))) from
      rep_rotate (a) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons true (L))))]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((a) * 4) ⟨rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (L))))))), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank))))))))))), .D⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons true (L)))))), cons false (rep (a) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))), .D⟩ :=
    cross_l trans c5 (a) (cons true (cons false (cons true (cons false (cons true (cons true (L))))))) (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))
  have h6 : steps 10 ⟨cons true (cons false (cons true (cons false (cons true (cons true (L)))))), cons false (rep (a) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))), .D⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))))), .B⟩ := rfl
  have h7 : steps 0 ⟨cons true (cons false (cons true (cons false (L)))), cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))))) = rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))))) from
      rep_rotate (a) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))]
  have c8 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h8 : steps ((a) * 4) ⟨cons true (cons false (cons true (cons false (L)))), rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))))))))))), .B⟩ = some ⟨rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank))))))))))))), .B⟩ :=
    cross_r trans c8 (a) (cons true (cons false (cons true (cons false (L))))) (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank))))))))))))))
  have h9 : steps 7 ⟨rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank))))))))))))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (L)))))))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))), .B⟩ := rfl
  have h10 : steps 0 ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (L)))))))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons true (blank)))))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (L)))))))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank)))))), .B⟩ := by
