/-- The right tape at the end of `front_e_e_raw`, rebracketed. -/
theorem front_e_e_r (b : Nat) (R : Tape) :
    cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
  have e0 : cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons false (R))) = rep (b) [false, true, false, true] (cons false (cons false (R))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons false (R))]
  have e1 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons false (R)))) = rep (b) [true, false, true, false] (cons true (cons false (cons false (R)))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons false (R)))]
  have e2 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (R))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- The front piece of `e.e`. -/
theorem front_e_e (v0 v1 b : Nat) (R : Tape) :
    steps (12 * b + 16 * v0 + 8 * v1 + 57) (⟨Rot b (F_e_e v0 v1), D010 R, .D⟩) = some (⟨F'_e_e v0 v1, A0100 b R, .A⟩) := by
  have h := front_e_e_raw b v0 v1 R
  have e : (some ⟨cons false (cons true (cons true (cons false (rep (v1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (v0) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ : Option Config) = some ⟨cons false (cons true (cons true (cons false (rep (v1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (v0) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ := by
    rw [front_e_e_r b R]
  rw [e] at h
  exact h

/-- The left-end tick of `e.e . m1 . … . mk` (k even, any k), in block notation
`n0.n1.m1.m2.m3.m4  ->  n0+3|n1-1|m1+1|m2-1|m3+1|m4+1` (shown for k = 4), from one right-end turn to the next. -/
theorem tick_e_e (v0 v1 : Nat) (d e : Nat) (ps : List (Nat × Nat)) : ∃ n,
    steps n ⟨Q d e (P ps (F_e_e v0 v1)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (F'_e_e v0 v1)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (F_e_e v0 v1) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (F'_e_e v0 v1) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (F_e_e v0 v1)))
    (steps_seq trans h1 (steps_seq trans (front_e_e v0 v1 _ _) (steps_seq trans h2 (leave d e (W ps d (F'_e_e v0 v1))))))⟩

/-- The front `e|o` (`n0|n1.m1.m2.m3.m4 -> n0+2|n1-1|m1+1|m2-1|m3+1|m4+1`), before the front piece. -/
def F_eIo (v0 v1 : Nat) : Tape := rep (v1 + 1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (blank)))))
/-- The front `e|o` after the front piece. -/
def F'_eIo (v0 v1 : Nat) : Tape := cons false (cons true (cons true (cons false (cons true (cons false (rep (v1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (v0 + 1) [false, true, false, true] (blank))))))))))))))

