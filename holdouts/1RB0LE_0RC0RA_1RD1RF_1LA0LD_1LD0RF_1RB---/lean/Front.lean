    steps n ⟨Q d e (P ps (F_eIo v0 v1)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (F'_eIo v0 v1)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (F_eIo v0 v1) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (F'_eIo v0 v1) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (F_eIo v0 v1)))
    (steps_seq trans h1 (steps_seq trans (front_eIo v0 v1 _ _) (steps_seq trans h2 (leave d e (W ps d (F'_eIo v0 v1))))))⟩

