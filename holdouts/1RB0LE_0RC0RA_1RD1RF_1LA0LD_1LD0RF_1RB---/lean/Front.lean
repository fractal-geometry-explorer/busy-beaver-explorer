import Chain

/-! # The left-end ticks: a front piece and the ordinary passes

A left-end tick of the list `F . m1 . … . mk` (k even, the m's even) is the ordinary left pass over the m's
(`left_pass` of `Chain.lean`), one *front piece* at the left end of the tape, and the ordinary right pass back.
Each front piece below is a symbolic run (`py/front.py` with `tools/py/bbtools/symtm.py`) from the configuration
the left pass leaves, `⟨Rot b (F …), D010 R, .D⟩`, to `⟨F' …, A0100 b R, .A⟩`, for every value of its variables
(each block of the front has a variable, with its parity fixed: `(1010)^(v+1)` is an even block of 2v+2 pairs,
`10 (1010)^(v+1)` an odd one of 2v+3) and every tape R.  `tick_<shape>` is the whole tick, from one right-end turn
to the next, for every list of pairs `ps` and all `d`, `e`, as `tick_chain` is for the ticks that turn at a
separator.  The shapes are those of the left-end ticks of the first 10^10 steps (`lean/front_shapes.txt`); the
README gives each rule in block notation. -/

namespace H103746

open TM

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-- The front `e` (`n0.m1.m2.m3.m4 -> 3|n0-1|m1+1|m2-1|m3+1|m4+1`), before the front piece. -/
def F_e (v0 : Nat) : Tape := rep (v0 + 1) [false, true, false, true] (blank)
/-- The front `e` after the front piece. -/
def F'_e (v0 : Nat) : Tape := cons false (cons true (cons true (cons false (rep (v0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))

/-- The symbolic run of `front_e`, ending as the run writes it. -/
theorem front_e_raw (b v0 : Nat) (R : Tape) :
    steps (12 * b + 8 * v0 + 41) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (v0 + 1) [false, true, false, true] (blank)))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons false (cons true (cons true (cons false (rep (v0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ := by
  have hn : (b) * 4 + (8 + (0 + ((b) * 4 + (3 + (0 + ((b) * 4 + (7 + (0 + ((v0) * 4 + (19 + ((v0) * 4 + (4)))))))))))) = 12 * b + 8 * v0 + 41 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((b) * 4) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (v0 + 1) [false, true, false, true] (blank)))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons true (cons false (cons true (cons false (rep (v0 + 1) [false, true, false, true] (blank))))), cons false (rep (b) [false, true, false, true] (cons true (cons false (R)))), .D⟩ :=
    cross_l trans c0 (b) (cons true (cons false (cons true (cons false (rep (v0 + 1) [false, true, false, true] (blank)))))) (cons true (cons false (R)))
  have h1 : steps 8 ⟨cons true (cons false (cons true (cons false (rep (v0 + 1) [false, true, false, true] (blank))))), cons false (rep (b) [false, true, false, true] (cons true (cons false (R)))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))) from
      rep_rotate (b) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (cons false (R)))]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((b) * 4) ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank)))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ :=
    cross_r trans c3 (b) (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank)))))))) (cons true (cons false (cons true (cons true (cons false (R))))))
  have h4 : steps 3 ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank)))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ = some ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))))), cons true (cons false (R)), .A⟩ := rfl
  have h5 : steps 0 ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))))), cons true (cons false (R)), .A⟩ = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))))), cons true (cons false (R)), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))))) from
      rep_rotate (b) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))]
  have c6 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h6 : steps ((b) * 4) ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))))), cons true (cons false (R)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank)))))))))), cons true (rep (b) [true, false, true, false] (cons false (R))), .A⟩ :=
    cross_l trans c6 (b) (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank))))))))))) (cons false (R))
  have h7 : steps 7 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (v0) [false, true, false, true] (blank)))))))))), cons true (rep (b) [true, false, true, false] (cons false (R))), .A⟩ = some ⟨cons false (cons true (rep (v0) [false, true, false, true] (blank))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ := rfl
  have h8 : steps 0 ⟨cons false (cons true (rep (v0) [false, true, false, true] (blank))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ = some ⟨rep (v0) [false, true, false, true] (cons false (cons true (blank))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (v0) [false, true, false, true] (blank))) = rep (v0) [false, true, false, true] (cons false (cons true (blank))) from
      rep_rotate (v0) [false, true] [false, true, false, true] [false, true, false, true] rfl (blank)]
  have c9 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
  have h9 : steps ((v0) * 4) ⟨rep (v0) [false, true, false, true] (cons false (cons true (blank))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ = some ⟨cons false (cons true (blank)), cons true (rep (v0) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .D⟩ :=
    cross_l trans c9 (v0) (cons false (cons true (blank))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))
  have h10 : steps 19 ⟨cons false (cons true (blank)), cons true (rep (v0) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .D⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), rep (v0) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .B⟩ := rfl
  have c11 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h11 : steps ((v0) * 4) ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), rep (v0) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .B⟩ = some ⟨rep (v0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))), .B⟩ :=
    cross_r trans c11 (v0) (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))
  have h12 : steps 4 ⟨rep (v0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))), .B⟩ = some ⟨cons false (cons true (cons true (cons false (rep (v0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (h12)))))))))))))

/-- The right tape at the end of `front_e_raw`, rebracketed. -/
theorem front_e_r (b : Nat) (R : Tape) :
    cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
  have e0 : cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons false (R))) = rep (b) [false, true, false, true] (cons false (cons false (R))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons false (R))]
  have e1 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons false (R)))) = rep (b) [true, false, true, false] (cons true (cons false (cons false (R)))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons false (R)))]
  have e2 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (R))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- The front piece of `e`. -/
theorem front_e (v0 b : Nat) (R : Tape) :
    steps (12 * b + 8 * v0 + 41) (⟨Rot b (F_e v0), D010 R, .D⟩) = some (⟨F'_e v0, A0100 b R, .A⟩) := by
  have h := front_e_raw b v0 R
  have e : (some ⟨cons false (cons true (cons true (cons false (rep (v0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ : Option Config) = some ⟨cons false (cons true (cons true (cons false (rep (v0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ := by
    rw [front_e_r b R]
  rw [e] at h
  exact h

/-- The left-end tick of `e . m1 . … . mk` (k even, any k), in block notation
`n0.m1.m2.m3.m4  ->  3|n0-1|m1+1|m2-1|m3+1|m4+1` (shown for k = 4), from one right-end turn to the next. -/
theorem tick_e (v0 : Nat) (d e : Nat) (ps : List (Nat × Nat)) : ∃ n,
    steps n ⟨Q d e (P ps (F_e v0)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (F'_e v0)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (F_e v0) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (F'_e v0) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (F_e v0)))
    (steps_seq trans h1 (steps_seq trans (front_e v0 _ _) (steps_seq trans h2 (leave d e (W ps d (F'_e v0))))))⟩

/-- The front `o|o` (`n0|n1.m1.m2.m3.m4 -> 3|n0|n1-1|m1+1|m2-1|m3+1|m4+1`), before the front piece. -/
def F_oIo (v0 v1 : Nat) : Tape := rep (v1 + 1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank)))))))
/-- The front `o|o` after the front piece. -/
def F'_oIo (v0 v1 : Nat) : Tape := cons false (cons true (cons true (cons false (cons true (cons false (rep (v1) [true, false, true, false] (cons true (cons true (cons false (rep (v0 + 1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))))))))

/-- The symbolic run of `front_oIo`, ending as the run writes it. -/
theorem front_oIo_raw (b v0 v1 : Nat) (R : Tape) :
    steps (12 * b + 8 * v0 + 8 * v1 + 59) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (v1 + 1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank)))))))))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (v1) [true, false, true, false] (cons true (cons true (cons false (rep (v0 + 1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ := by
  have hn : (b) * 4 + (8 + (0 + ((b) * 4 + (3 + (0 + ((b) * 4 + (7 + (0 + ((v1) * 4 + (5 + ((v0 + 1) * 4 + (19 + ((v0 + 1) * 4 + (3 + (0 + ((v1) * 4 + (6))))))))))))))))) = 12 * b + 8 * v0 + 8 * v1 + 59 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((b) * 4) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (v1 + 1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank)))))))))))), cons false (cons true (cons false (R))), .D⟩ = some ⟨cons true (cons false (cons true (cons false (rep (v1 + 1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank))))))))))), cons false (rep (b) [false, true, false, true] (cons true (cons false (R)))), .D⟩ :=
    cross_l trans c0 (b) (cons true (cons false (cons true (cons false (rep (v1 + 1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank)))))))))))) (cons true (cons false (R)))
  have h1 : steps 8 ⟨cons true (cons false (cons true (cons false (rep (v1 + 1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank))))))))))), cons false (rep (b) [false, true, false, true] (cons true (cons false (R)))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank))))))))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank))))))))))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank))))))))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons false (R)))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))) from
      rep_rotate (b) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (cons false (R)))]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((b) * 4) ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank))))))))))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (v1) [false, true, false, true] (cons false (cons true (cons true (rep (v0 + 1) [false, true, false, true] (cons false (cons true (blank)))))))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ :=
