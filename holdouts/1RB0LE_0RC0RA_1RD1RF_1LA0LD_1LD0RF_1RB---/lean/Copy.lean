    simp only [steps_zero, show cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (L))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (L))))))) from
