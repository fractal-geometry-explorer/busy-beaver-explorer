  have e1 : cons true (cons true (cons false (cons true (cons false (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))))) = cons true (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))))) := by
    rw [show cons true (cons false (cons true (cons false (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))))))) = rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))))))) from rep_rotate (j) [true, false, true, false] [true, false, true, false] [true, false, true, false] rfl (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))]
  have f0 : cons true (cons true (cons false (rep (j + 2) [true, false, true, false] (cons true (cons false (R)))))) = cons true (cons true (cons false (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))))) := by
    rw [show rep (j + 2) [true, false, true, false] (cons true (cons false (R))) = rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))))) from rep_add (j) 2 [true, false, true, false] (cons true (cons false (R)))]
  have f1 : cons true (cons true (cons false (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))))) = cons true (cons true (rep (j) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))))) := by
    rw [show cons false (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))) = rep (j) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))) from rep_rotate (j) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))]
  have f2 : cons true (cons true (rep (j) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))))) = cons true (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))))))))) := by
    rw [show cons true (rep (j) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))))))) = rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))))))) from rep_rotate (j) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))))))]
  exact (e0.trans (e1)).trans (f0.trans (f1.trans (f2))).symm

/-- At the left end, at the end of a round. -/
theorem el3 (j : Nat) (R : Tape) :
    steps (4 * j + 12) (⟨cons false (J2 j), cons true R, .D⟩) = some (⟨blank, Kj (j + 2) R, .D⟩) := by
  have h := el3_raw j R
  have e : (some ⟨blank, cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (R)))))))))))))), .D⟩ : Option Config) = some ⟨blank, cons true (cons true (cons false (rep (j + 2) [true, false, true, false] (cons true (cons false (R)))))), .D⟩ := by
    rw [el3_r j R]
  rw [e] at h
  exact h

theorem passB : ∀ (bs : List Nat) (L R : Tape), ∃ n,
    steps n ⟨L, CS bs R, .B⟩ = some ⟨BS bs L, R, .B⟩ := by
  intro bs
  induction bs with
  | nil => intro L R; exact ⟨0, rfl⟩
  | cons b bs ih =>
    intro L R
    obtain ⟨n, hn⟩ := ih (Bk b L) R
    exact ⟨_, steps_seq trans (crossB b L (CS bs R)) hn⟩

theorem passD : ∀ (bs : List Nat) (L R : Tape), ∃ n,
    steps n ⟨cons false (BS bs L), cons true R, .D⟩ = some ⟨cons false L, cons true (CS bs R), .D⟩ := by
  intro bs
  induction bs with
  | nil => intro L R; exact ⟨0, rfl⟩
  | cons b bs ih =>
    intro L R
    obtain ⟨n, hn⟩ := ih (Bk b L) R
    exact ⟨_, steps_seq trans hn (crossD b L (CS bs R))⟩

/-- One round of the copy loop, for any reworked front `bs`: two pairs of X move into the new first block. -/
theorem round (bs : List Nat) (j r : Nat) (Z : Tape) : ∃ n,
    steps n ⟨blank, Kj j (CS bs (X0 (r + 1) Z)), .D⟩ = some ⟨blank, Kj (j + 2) (CS bs (X0 r Z)), .D⟩ := by
  obtain ⟨n1, h1⟩ := passB bs (J1 j) (X0 (r + 1) Z)
  obtain ⟨n2, h2⟩ := passD bs (J1 j) (X1 r Z)
  obtain ⟨n3, h3⟩ := passB bs (J2 j) (X1 r Z)
  obtain ⟨n4, h4⟩ := passD bs (J2 j) (X0 r Z)
  exact ⟨_, steps_seq trans (el1 j _) (steps_seq trans h1 (steps_seq trans (xa r _ Z) (steps_seq trans h2
    (steps_seq trans (el2 j _) (steps_seq trans h3 (steps_seq trans (xb r _ Z) (steps_seq trans h4
      (el3 j _))))))))⟩

/-- The copy loop: all r remaining pairs of X move into the new first block. -/
theorem loop (bs : List Nat) : ∀ (r j : Nat) (Z : Tape), ∃ n,
    steps n ⟨blank, Kj j (CS bs (X0 r Z)), .D⟩ = some ⟨blank, Kj (j + 2 * r) (CS bs (X0 0 Z)), .D⟩ := by
  intro r
  induction r with
  | zero => intro j Z; exact ⟨0, rfl⟩
  | succ r ih =>
    intro j Z
    obtain ⟨n1, h1⟩ := round bs j r Z
    obtain ⟨n2, h2⟩ := ih (j + 2) Z
    rw [show j + 2 + 2 * r = j + 2 * (r + 1) by omega] at h2
    exact ⟨_, steps_seq trans h1 h2⟩

