import Chain

/-! # The copy ticks

Generated by `py/copyloop.py` (see its docstring).  A copy tick reads `P | 1 . X . m1 . … . mk` (k odd, X and the
m's even).  The left pass ends on X; then the head goes back and forth between the left end and X.  After the
entry, which reworks P into a list `bs` of even blocks, the tape right of the head at the left end is
`Kj j (CS bs (X0 r Z))` = `1 (10)^(2j+2) 0 (10)^(2b1+2) … 0 (10)^(2bm+2) 0 0 (10)^(2r) Z`; `round` (seven local
pieces and two inductions on `bs`) moves two pairs of X into the first block, for every list `bs`, and `loop` is the
induction on r.  For each front shape of the run, `entry_*`, `exit3_*`, `exit1_*` are symbolic runs (a variable for
each block of P), and `copy_*_long` (k ≥ 3, any list of pairs) and `copy_*_one` (k = 1) are the whole tick, for
every X and every chain. -/

namespace H103746

open TM

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-- `1 (10)^(2j+2) R`: the new first block, right of the head at the left end. -/
def Kj (j : Nat) (R : Tape) : Tape := cons true (cons true (cons false (rep (j) [true, false, true, false] (cons true (cons false (R))))))
/-- `0 (10)^(2b+2) R`: a block of the reworked front. -/
def Ck (b : Nat) (R : Tape) : Tape := cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (R))))))
/-- The same block after the head crossed it to the right. -/
def Bk (b : Nat) (L : Tape) : Tape := cons true (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (L))))))
/-- The blocks of the reworked front, the first one nearest the left end. -/
def CS : List Nat → Tape → Tape
  | [], R => R
  | b :: bs, R => Ck b (CS bs R)
/-- The same blocks, crossed to the right. -/
def BS : List Nat → Tape → Tape
  | [], L => L
  | b :: bs, L => BS bs (Bk b L)
/-- `0 0 (10)^(2r) Z`: what is left of X. -/
def X0 (r : Nat) (Z : Tape) : Tape := cons false (cons false (rep (r) [true, false, true, false] (Z)))
/-- The same in the middle of a round. -/
def X1 (r : Nat) (Z : Tape) : Tape := cons false (cons false (cons true (cons false (rep (r) [true, false, true, false] (Z)))))
/-- The left end in the first half round. -/
def J1 (j : Nat) : Tape := cons true (cons false (cons true (cons false (cons true (rep (j) [false, true, false, true] (cons false (cons true (blank))))))))
/-- The left end in the second half round. -/
def J2 (j : Nat) : Tape := cons true (cons false (cons true (cons false (cons true (cons false (rep (j) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank))))))))))))

/-- The symbolic run of `crossB`, ending as the run writes it. -/
theorem crossB_raw (b : Nat) (L R : Tape) :
    steps (4 * b + 5) ⟨L, cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (R)))))), .B⟩ = some ⟨cons true (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (L)))))), R, .B⟩ := by
  have hn : 3 + (0 + ((b) * 4 + (2))) = 4 * b + 5 := by omega
  have h0 : steps 3 ⟨L, cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (R)))))), .B⟩ = some ⟨cons true (cons true (cons false (L))), cons true (cons false (rep (b) [true, false, true, false] (R))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (cons false (L))), cons true (cons false (rep (b) [true, false, true, false] (R))), .B⟩ = some ⟨cons true (cons true (cons false (L))), rep (b) [true, false, true, false] (cons true (cons false (R))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (b) [true, false, true, false] (R))) = rep (b) [true, false, true, false] (cons true (cons false (R))) from
      rep_rotate (b) [true, false] [true, false, true, false] [true, false, true, false] rfl (R)]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((b) * 4) ⟨cons true (cons true (cons false (L))), rep (b) [true, false, true, false] (cons true (cons false (R))), .B⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons true (cons false (L)))), cons true (cons false (R)), .B⟩ :=
    cross_r trans c2 (b) (cons true (cons true (cons false (L)))) (cons true (cons false (R)))
  have h3 : steps 2 ⟨rep (b) [true, false, true, false] (cons true (cons true (cons false (L)))), cons true (cons false (R)), .B⟩ = some ⟨cons true (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons false (L)))))), R, .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The head crosses a block of the loop to the right. -/
theorem crossB (b : Nat) (L R : Tape) :
    steps (4 * b + 5) (⟨L, Ck b R, .B⟩) = some (⟨Bk b L, R, .B⟩) := by
  have h := crossB_raw b L R
  exact h

