  have h1 : steps ((b) * 4) ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (L))))))), cons true (R), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (cons false (L)))))), cons true (rep (b) [true, false, true, false] (R)), .D⟩ :=
