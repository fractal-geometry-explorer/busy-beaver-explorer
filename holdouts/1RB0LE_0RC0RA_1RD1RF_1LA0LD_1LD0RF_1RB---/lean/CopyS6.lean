/-- Front `e|o`: the end of the loop when the chain has one block, the next right-end turn. -/
theorem exit1_eIo (v0 v1 j e : Nat) :
    steps (4 * e + 4 * j + 4 * v0 + 20 * v1 + 103) (⟨blank, Kj j (CS [v0 + 1, v1 + 2] (X0 0 (cons false (R0 e)))), .D⟩) = some (⟨G1_eIo v0 v1 j e, cons true (cons true blank), .A⟩) := by
  have h := exit1_eIo_raw e j v0 v1
  exact h

/-- A whole copy tick of `e|o | 1 . X . m1 . … . mk`, k ≥ 3 (X = 2(x + 1)+2, m1 = 2c+4, then the pairs `ps`,
then the last two blocks d, e), from one right-end turn to the next. -/
theorem copy_eIo_long (v0 v1 : Nat) (x c d e : Nat) (ps : List (Nat × Nat)) : ∃ n,
    steps n ⟨Q d e (P ps (Pc (c + 1) (x + 1) (FC_eIo v0 v1))), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (G3_eIo v0 v1 (0 + 2 * (x)) c)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (Pc (c + 1) (x + 1) (FC_eIo v0 v1)) ps d (R0 e)
  obtain ⟨n2, h2⟩ := loop [v0 + 1, v1 + 2] (x) (0) (cons false (U (c + 1) (LP ps d (R0 e)).1 (LP ps d (R0 e)).2))
  obtain ⟨n3, h3⟩ := right_pass (G3_eIo v0 v1 (0 + 2 * (x)) c) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e _) (steps_seq trans h1 (steps_seq trans (lu (x + 1) (c + 1) _ _ _)
    (steps_seq trans (entry_eIo v0 v1 x _) (steps_seq trans h2 (steps_seq trans (exit3_eIo v0 v1 _ c _ _)
      (steps_seq trans h3 (leave d e _)))))))⟩

/-- A whole copy tick of `e|o | 1 . X . m1` (k = 1; X = 2(x + 1)+2, m1 = 2e+2), from one right-end turn to the
next. -/
theorem copy_eIo_one (v0 v1 : Nat) (x e : Nat) : ∃ n,
    steps n ⟨Q (x + 1) e (FC_eIo v0 v1), cons true (cons true blank), .A⟩ =
      some ⟨G1_eIo v0 v1 (0 + 2 * (x)) e, cons true (cons true blank), .A⟩ := by
  obtain ⟨n2, h2⟩ := loop [v0 + 1, v1 + 2] (x) (0) (cons false (R0 e))
  exact ⟨_, steps_seq trans (enter (x + 1) e _) (steps_seq trans (entry_eIo v0 v1 x _)
    (steps_seq trans h2 (exit1_eIo v0 v1 _ e)))⟩

