theorem copy_oI1Io_long (v0 v2 : Nat) (x c d e : Nat) (ps : List (Nat × Nat)) : ∃ n,
    steps n ⟨Q d e (P ps (Pc (c + 1) x (FC_oI1Io v0 v2))), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (G3_oI1Io v0 v2 x (2 * (v2 + 1)) c)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (Pc (c + 1) x (FC_oI1Io v0 v2)) ps d (R0 e)
  obtain ⟨n2, h2⟩ := loop [v0 + 2] (v2 + 1) 0 (WY x (U (c + 1) (LP ps d (R0 e)).1 (LP ps d (R0 e)).2))
  obtain ⟨n3, h3⟩ := right_pass (G3_oI1Io v0 v2 x (2 * (v2 + 1)) c) ps d (R0 e)
  rw [show 0 + 2 * (v2 + 1) = 2 * (v2 + 1) by omega] at h2
