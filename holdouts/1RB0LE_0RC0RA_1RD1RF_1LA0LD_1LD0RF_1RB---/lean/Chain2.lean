/-- A whole tick of `x | p | a . c` (p = 1, a odd, c even), from one right-end turn to the next. -/
theorem tick_p1_last (a c : Nat) (L : Tape) :
    steps (16 * a + 8 * c + 46) (⟨rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons true (L))))))))))))), cons true (cons true blank), .A⟩) = some (⟨cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (L))))))))))))))))))))), cons true (cons true blank), .A⟩) := by
  have h := tick_p1_last_raw a c L
  exact h


/-- A whole tick of `x | p | a . a2 . b1 . c1 . … . bk . ck . d . e` (p = 1; a odd, the rest even, any k). -/
theorem tick_chain_p1 (a a2 d e : Nat) (ps : List (Nat × Nat)) (L : Tape) : ∃ n,
    steps n ⟨Q d e (P ps (Tp1 a a2 L)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (Tp1' a a2 L)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (Tp1 a a2 L) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (Tp1' a a2 L) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (Tp1 a a2 L)))
    (steps_seq trans h1 (steps_seq trans (turn_p1 a a2 _ L _)
      (steps_seq trans h2 (leave d e (W ps d (Tp1' a a2 L))))))⟩

/-- `L | 1 | a` (a odd), where the tick turns. -/
def T1o (a : Nat) (L : Tape) : Tape := cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons true (L)))))))))))
