  have e : (some ⟨cons false (cons true (cons true (cons false (rep (a2) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons true (L))))))))))))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ : Option Config) = some ⟨cons false (cons true (cons true (cons false (rep (a2) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons true (L))))))))))))))))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ := by
