/-- A whole tick of `x | p | a . c` (p even, a odd, c even), from one right-end turn to the next. -/
theorem tick_pe_last (p a c : Nat) (L : Tape) :
    steps (16 * a + 8 * c + 46) (⟨rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (rep (p + 1) [false, true, false, true] (cons true (L)))))))))))), cons true (cons true blank), .A⟩) = some (⟨cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons true (L)))))))))))))))))))))))), cons true (cons true blank), .A⟩) := by
  have h := tick_pe_last_raw a c p L
  exact h


/-- A whole tick of `x | p | a . a2 . b1 . c1 . … . bk . ck . d . e` (p even; a odd, the rest even, any k). -/
theorem tick_chain_pe (p : Nat) (a a2 d e : Nat) (ps : List (Nat × Nat)) (L : Tape) : ∃ n,
    steps n ⟨Q d e (P ps (Tpe p a a2 L)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (Tpe' p a a2 L)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (Tpe p a a2 L) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (Tpe' p a a2 L) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (Tpe p a a2 L)))
    (steps_seq trans h1 (steps_seq trans (turn_pe p a a2 _ L _)
      (steps_seq trans h2 (leave d e (W ps d (Tpe' p a a2 L))))))⟩

/-- `L | p | a . a2` (p odd, at least 3, a odd, a2 even), where the tick turns. -/
def Tpo (p : Nat) (a a2 : Nat) (L : Tape) : Tape := rep (a2 + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (cons true (L))))))))))))))))))
/-- The same after the turn. -/
