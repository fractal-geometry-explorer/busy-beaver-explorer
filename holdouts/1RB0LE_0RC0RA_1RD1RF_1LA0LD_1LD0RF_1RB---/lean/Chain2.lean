      rep_rotate (a) [false, true] [false, true, false, true] [false, true, false, true] rfl (cons false (cons true (cons true (cons false (cons true (cons true (L)))))))]
  have c9 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
  have h9 : steps ((a) * 4) ⟨rep (a) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (L))))))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (L)))))))), cons true (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .D⟩ :=
    cross_l trans c9 (a) (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (L))))))))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))
  have h10 : steps 15 ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (L)))))))), cons true (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .D⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), cons true (cons false (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ := rfl
  have h11 : steps 0 ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), cons true (cons false (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), rep (a) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (a) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))) = rep (a) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))) from
      rep_rotate (a) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))]
  have c12 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h12 : steps ((a) * 4) ⟨cons true (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), rep (a) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R)))))))))))), .B⟩ = some ⟨rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))), cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .B⟩ :=
    cross_r trans c12 (a) (cons true (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))))
  have h13 : steps 6 ⟨rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))), cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))))))))), .B⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (steps_seq trans h12 (h13))))))))))))))

/-- The right tape at the end of `turn_1o_raw`, rebracketed. -/
theorem turn_1o_r (b : Nat) (R : Tape) :
    cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
  have e0 : cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))) = cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons false (R))) = rep (b) [false, true, false, true] (cons false (cons false (R))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons false (R))]
  have e1 : cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (R))))) = cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) := by
    rw [show cons true (rep (b) [false, true, false, true] (cons false (cons false (R)))) = rep (b) [true, false, true, false] (cons true (cons false (cons false (R)))) from rep_rotate (b) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons false (R)))]
  have e2 : cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) := by
    rw [show cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))) from rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (R))))]
  exact (e0.trans (e1.trans (e2))).trans (rfl).symm

/-- The turn at `| 1 | a`, a odd. -/
theorem turn_1o (a b : Nat) (L R : Tape) :
    steps (8 * a + 12 * b + 39) (⟨Rot b (T1o a L), D010 R, .D⟩) = some (⟨T1o' a L, A0100 b R, .A⟩) := by
  have h := turn_1o_raw a b L R
  have e : (some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (R))))), .A⟩ : Option Config) = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))))))))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ := by
    rw [turn_1o_r b R]
  rw [e] at h
  exact h


/-- A whole tick of `x | 1 | a . b1 . c1 . … . bk . ck . d . e` (a odd, the rest even, any k). -/
theorem tick_chain_1o (a d e : Nat) (ps : List (Nat × Nat)) (L : Tape) : ∃ n,
    steps n ⟨Q d e (P ps (T1o a L)), cons true (cons true blank), .A⟩ =
      some ⟨Fin d e (W ps d (T1o' a L)), cons true (cons true blank), .A⟩ := by
  obtain ⟨n1, h1⟩ := left_pass (T1o a L) ps d (R0 e)
  obtain ⟨n2, h2⟩ := right_pass (T1o' a L) ps d (R0 e)
  exact ⟨_, steps_seq trans (enter d e (P ps (T1o a L)))
    (steps_seq trans h1 (steps_seq trans (turn_1o a _ L _) (steps_seq trans h2 (leave d e (W ps d (T1o' a L))))))⟩

