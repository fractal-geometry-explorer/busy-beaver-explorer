/-- The return: `(10)^(x+1) 11 000` becomes the unit x = 1, y = x, w = 2. `L 0 0 0 0 A> 0 (10)^x+1 1 1 0 0 0 R` reaches `L A> 0 1 0 0 0 1 (01)^x 1 0 0 1 1 0 R`. -/
theorem g_ret (x : Nat) (L R : Tape) :
    steps (4 * x + 16) ⟨cons false (cons false (cons false (cons false (L)))), cons false (rep (x + 1) [true, false] (cons true (cons true (cons false (cons false (cons false (R))))))), .A⟩ = some ⟨L, cons false (cons true (cons false (cons false (cons false (cons true (rep (x) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (R))))))))))))), .A⟩ := by
  have hn : 0 + ((x + 1) * 2 + (9 + (0 + ((x) * 2 + (5))))) = 4 * x + 16 := by omega
  have h0 : steps 0 ⟨cons false (cons false (cons false (cons false (L)))), cons false (rep (x + 1) [true, false] (cons true (cons true (cons false (cons false (cons false (R))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons false (L)))), rep (x + 1) [false, true] (cons false (cons true (cons true (cons false (cons false (cons false (R))))))), .A⟩ := by
    simp only [steps_zero, show cons false (rep (x + 1) [true, false] (cons true (cons true (cons false (cons false (cons false (R))))))) = rep (x + 1) [false, true] (cons false (cons true (cons true (cons false (cons false (cons false (R))))))) from
      rep_rotate (x + 1) [false] [true, false] [false, true] rfl (cons true (cons true (cons false (cons false (cons false (R))))))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((x + 1) * 2) ⟨cons false (cons false (cons false (cons false (L)))), rep (x + 1) [false, true] (cons false (cons true (cons true (cons false (cons false (cons false (R))))))), .A⟩ = some ⟨rep (x + 1) [true, true] (cons false (cons false (cons false (cons false (L))))), cons false (cons true (cons true (cons false (cons false (cons false (R)))))), .A⟩ :=
    cross_r trans c1 (x + 1) (cons false (cons false (cons false (cons false (L))))) (cons false (cons true (cons true (cons false (cons false (cons false (R)))))))
  have h2 : steps 9 ⟨rep (x + 1) [true, true] (cons false (cons false (cons false (cons false (L))))), cons false (cons true (cons true (cons false (cons false (cons false (R)))))), .A⟩ = some ⟨cons true (rep (x) [true, true] (cons false (cons false (cons false (cons false (L)))))), cons true (cons true (cons false (cons false (cons true (cons true (cons false (R))))))), .C⟩ := rfl
  have h3 : steps 0 ⟨cons true (rep (x) [true, true] (cons false (cons false (cons false (cons false (L)))))), cons true (cons true (cons false (cons false (cons true (cons true (cons false (R))))))), .C⟩ = some ⟨rep (x) [true, true] (cons true (cons false (cons false (cons false (cons false (L)))))), cons true (cons true (cons false (cons false (cons true (cons true (cons false (R))))))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (x) [true, true] (cons false (cons false (cons false (cons false (L)))))) = rep (x) [true, true] (cons true (cons false (cons false (cons false (cons false (L)))))) from
      rep_rotate (x) [true] [true, true] [true, true] rfl (cons false (cons false (cons false (cons false (L)))))]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((x) * 2) ⟨rep (x) [true, true] (cons true (cons false (cons false (cons false (cons false (L)))))), cons true (cons true (cons false (cons false (cons true (cons true (cons false (R))))))), .C⟩ = some ⟨cons true (cons false (cons false (cons false (cons false (L))))), cons true (rep (x) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (R)))))))), .C⟩ :=
    cross_l trans c4 (x) (cons true (cons false (cons false (cons false (cons false (L)))))) (cons true (cons false (cons false (cons true (cons true (cons false (R)))))))
  have h5 : steps 5 ⟨cons true (cons false (cons false (cons false (cons false (L))))), cons true (rep (x) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (R)))))))), .C⟩ = some ⟨L, cons false (cons true (cons false (cons false (cons false (cons true (rep (x) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (R))))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

end H154944
