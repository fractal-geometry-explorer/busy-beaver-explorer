/-- Where a halt comes from: item 0 odd, item 1 even with separator 1, item 2 = `(0, 1)`, followed by a 1: F reads that 1 (the halting transition). -/
theorem to_halt (a b : Nat) (R : Tape) :
    steps (8 * a + 8 * b + 15) ⟨blank, cons false (cons false (rep (a) [true, false, true, false] (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R)))))))))), .D⟩ = some ⟨cons true (cons true (cons true (rep (b) [true, true, true, true] (cons false (cons true (cons true (rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank)))))))))))), cons true (R), .F⟩ := by
  have hn : 9 + (0 + ((a) * 8 + (3 + (0 + ((b) * 8 + (3)))))) = 8 * a + 8 * b + 15 := by omega
  have h0 : steps 9 ⟨blank, cons false (cons false (rep (a) [true, false, true, false] (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R)))))))))), .D⟩ = some ⟨cons true (cons true (cons true (cons true (blank)))), cons false (rep (a) [true, false, true, false] (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))))))), .A⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (cons true (cons true (blank)))), cons false (rep (a) [true, false, true, false] (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))))))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (blank)))), rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))))))), .A⟩ := by
    simp only [steps_zero, show cons false (rep (a) [true, false, true, false] (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))))))) = rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))))))) from
      rep_rotate (a) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))))))]
  have c2 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h2 : steps ((a) * 8) ⟨cons true (cons true (cons true (cons true (blank)))), rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))))))), .A⟩ = some ⟨rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank))))), cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R)))))))), .A⟩ :=
    cross_r trans c2 (a) (cons true (cons true (cons true (cons true (blank))))) (cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R)))))))))
  have h3 : steps 3 ⟨rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank))))), cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R)))))))), .A⟩ = some ⟨cons false (cons true (cons true (rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank)))))))), cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons true (rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank)))))))), cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))), .A⟩ = some ⟨cons false (cons true (cons true (rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank)))))))), rep (b) [false, true, false, true] (cons false (cons true (cons true (cons true (R))))), .A⟩ := by
    simp only [steps_zero, show cons false (rep (b) [true, false, true, false] (cons true (cons true (cons true (R))))) = rep (b) [false, true, false, true] (cons false (cons true (cons true (cons true (R))))) from
      rep_rotate (b) [false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons true (cons true (R))))]
  have c5 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((b) * 8) ⟨cons false (cons true (cons true (rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank)))))))), rep (b) [false, true, false, true] (cons false (cons true (cons true (cons true (R))))), .A⟩ = some ⟨rep (b) [true, true, true, true] (cons false (cons true (cons true (rep (a) [true, true, true, true] (cons true (cons true (cons true (cons true (blank))))))))), cons false (cons true (cons true (cons true (R)))), .A⟩ :=
