import Rules

/-!
# The main regime as a theorem for all sizes

`P a b` is the tape at the left end in state F during the main regime:
`F>0^6 (1000)^a 1 0 1 1 1 (0001)^b 0 1 0 0 0 1 0 1 0 0 0 0 1`, blank tape on both sides.
`phase3` (in `Rules.lean`, generated by `tools/py/bbtools/symtm.py`) is three round trips of the head; here it is
re-bracketed into `P a (b + 3) → P (a + 6) (b + 1)` and iterated: `P a (b + 2k + 1)` reaches `P (a + 6k) (b + 1)`.
-/

namespace H100726

open TM

def w1 : List Bool := [true, false, false, false]
def w2 : List Bool := [false, false, false, true]
/-- The right end of the tape in the main regime (one of the three shapes it cycles through). -/
def tail1 : List Bool := [false, true, false, false, false, true, false, true, false, false, false, false, true]

/-- The main-regime configuration with `a` blocks `1000` and `b` blocks `0001`. -/
def P (a b : Nat) : Config :=
  ⟨blank, app [false, false, false, false, false, false]
    (rep a w1 (app [true, false, true, true, true] (rep b w2 (app tail1 blank)))), .F⟩

theorem rot1 (n : Nat) (s : Tape) :
    cons true (rep n [false, false, false, true] s) = rep n [true, false, false, false] (cons true s) :=
  rep_rotate n [true] w2 w1 rfl s

theorem absorb1 (n : Nat) (s : Tape) :
    rep n [true, false, false, false] (cons true (cons false (cons false (cons false s)))) =
      rep (n + 1) [true, false, false, false] s :=
  rep_app_comm n w1 s

theorem absorb2 (n : Nat) (s : Tape) :
    rep n [false, false, false, true] (cons false (cons false (cons false (cons true s)))) =
      rep (n + 1) [false, false, false, true] s :=
  rep_app_comm n w2 s

/-- Three round trips: two blocks `0001` fewer, six blocks `1000` more (kernel). -/
theorem P_step (a b : Nat) : steps (114 * a + 114 * b + 1115) (P a (b + 3)) = some (P (a + 6) (b + 1)) := by
  have h := phase3 a b
  rw [rot1 a, absorb1 a, absorb1 (a + 1), absorb1 (a + 2), absorb2 b] at h
  exact h

/-- The main regime run `k` times: `P a (b + 2k + 1)` reaches `P (a + 6k) (b + 1)` (kernel). -/
theorem P_iter (k : Nat) : ∀ a b : Nat, ∃ t, steps t (P a (b + 2 * k + 1)) = some (P (a + 6 * k) (b + 1)) := by
  induction k with
  | zero => intro a b; exact ⟨0, by simp⟩
  | succ k ih =>
    intro a b
    have e1 : b + 2 * (k + 1) + 1 = (b + 2 * k) + 3 := by omega
    obtain ⟨t, ht⟩ := ih (a + 6) b
    refine ⟨114 * a + 114 * (b + 2 * k) + 1115 + t, ?_⟩
    rw [e1]
    have e2 : a + 6 * (k + 1) = a + 6 + 6 * k := by omega
    rw [e2]
    exact steps_seq trans (P_step a (b + 2 * k)) ht

end H100726
