namespace H100726

open TM

/-- The halting configurations: the machine stops exactly when it reads the symbol of a halting transition (B1).
-/
theorem step_none_iff (c : Config) : step c = none ↔ (c.st = .B ∧ c.r 0 = true) := by
  obtain ⟨l, r, s⟩ := c
  cases s <;> cases h : r 0 <;> simp [step, TM.step, trans, h]

/-- 10,000 steps from blank tape without a halt, checked by Lean's kernel alone. -/
theorem blank_runs_kernel : ∃ c, steps 10000 init = some c :=
  blank_runs trans (by decide +kernel)

/-- 10,000,000 steps from blank tape without a halt, by compiled evaluation (`native_decide`). -/
theorem blank_runs_native : ∃ c, steps 10000000 init = some c :=
  blank_runs trans (by native_decide)

end H100726
