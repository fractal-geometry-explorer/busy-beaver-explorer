/-- An odd-type round trip with no `10`: it turns into the 5-visit cycle form with no runs, which is `S1`. -/
theorem ozero (a c : Nat) :
    steps (60 * a + 672) (O a 0 (c + 3)) = some (T3 (a + 2) 0 0 0 7 c) := by
  have h := ozero_raw a c
  have e : (some ⟨blank, cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (cons false (rep (a) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (rep (c) [false, false, false, false, true, false, false, false, false, false, true, false, false, false] (cons true (cons false (cons true (blank)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))), .A⟩ : Option Config) = some ⟨blank, cons false (cons false (cons false (cons false (cons false (cons false (cons false (rep (a + 2) [true, false, false, false] (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (rep (7) [true, false] (rep (c) [false, false, true, false, false, false, false, false, true, false, false, false, false, false] (cons false (cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank))))))))))))))))))))))))))))))))))))))), .A⟩ := by
    rw [ozero_r a c]
  rw [e] at h
