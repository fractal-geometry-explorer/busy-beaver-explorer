/-- A configuration at a phase form whose counts satisfy the invariant. -/
def Good (t : Config) : Prop :=
  (∃ a b c, t = O a b c ∧ gOp a b c) ∨
  (∃ a c, t = O a 0 c ∧ gO0 a c) ∨
  (∃ a b c, t = S1 a b c ∧ gS1 a b c) ∨
  (∃ a k m, t = RF a k m ∧ gRF a k m) ∨
  (∃ a q, t = EF a q ∧ gEF a q) ∨
  (∃ a x d y z c, t = T3 a x d y z c ∧ gT3 a x d y z c) ∨
  (∃ a x y c, t = T2 a x y c ∧ gT2 a x y c) ∨
  (∃ a x y z c, t = U3 a x y z c ∧ gU3 a x y z c) ∨
  (∃ a x n m, t = RG a x n m ∧ gRG a x n m) ∨
  (∃ a x y n m, t = RG3 a x y n m ∧ gRG3 a x y n m)

theorem good_Op {a b c : Nat} (h : gOp a b c) : Good (O a b c) :=
  Or.inl ⟨a, b, c, rfl, h⟩

theorem good_O0 {a c : Nat} (h : gO0 a c) : Good (O a 0 c) :=
  Or.inr (Or.inl ⟨a, c, rfl, h⟩)

theorem good_S1 {a b c : Nat} (h : gS1 a b c) : Good (S1 a b c) :=
  Or.inr (Or.inr (Or.inl ⟨a, b, c, rfl, h⟩))

theorem good_RF {a k m : Nat} (h : gRF a k m) : Good (RF a k m) :=
  Or.inr (Or.inr (Or.inr (Or.inl ⟨a, k, m, rfl, h⟩)))

theorem good_EF {a q : Nat} (h : gEF a q) : Good (EF a q) :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨a, q, rfl, h⟩))))

theorem good_T3 {a x d y z c : Nat} (h : gT3 a x d y z c) : Good (T3 a x d y z c) :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨a, x, d, y, z, c, rfl, h⟩)))))

theorem good_T2 {a x y c : Nat} (h : gT2 a x y c) : Good (T2 a x y c) :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨a, x, y, c, rfl, h⟩))))))

theorem good_U3 {a x y z c : Nat} (h : gU3 a x y z c) : Good (U3 a x y z c) :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨a, x, y, z, c, rfl, h⟩)))))))

theorem good_RG {a x n m : Nat} (h : gRG a x n m) : Good (RG a x n m) :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨a, x, n, m, rfl, h⟩))))))))

theorem good_RG3 {a x y n m : Nat} (h : gRG3 a x y n m) : Good (RG3 a x y n m) :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨a, x, y, n, m, rfl, h⟩))))))))

/-- From the form `O a b c` with the invariant, the next form with the invariant. -/
theorem step_Op (a b c : Nat) (h : gOp a b c) :
    ∃ i t', steps (i + 1) (O a b c) = some t' ∧ Good t' := by
  unfold gOp at h
  obtain ⟨b', rfl⟩ : ∃ b', b = b' + 6 := ⟨b - 6, by omega⟩
  obtain ⟨c', rfl⟩ : ∃ c', c = c' + 2 := ⟨c - 2, by omega⟩
  obtain ⟨n, hn⟩ := mv_oentry a b' c'
  exact ⟨n, _, hn, good_S1 (by unfold gS1; omega)⟩

/-- From the form `O a 0 c` with the invariant, the next form with the invariant. -/
theorem step_O0 (a c : Nat) (h : gO0 a c) :
