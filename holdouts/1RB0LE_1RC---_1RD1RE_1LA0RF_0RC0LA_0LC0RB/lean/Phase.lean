/-- The end of a right phase with a run of 2q+1 copies of `1111110`: the start of an even round-trip phase. -/
theorem rend (a q : Nat) :
    steps (26 * a + 42 * q + 225) (RF2 a q 1) = some (EF a q) := by
  have h := rend_raw a q
  exact h

/-- A run of a word repeated 2q times is the doubled word repeated q times. -/
theorem rep_double (q : Nat) (w : List Bool) (s : Tape) : rep (2 * q) w s = rep q (w ++ w) s := by
  induction q with
  | zero => rfl
  | succ q ih =>
    have e : 2 * (q + 1) = 2 * q + 1 + 1 := by omega
    rw [e, rep_succ, rep_succ, ih, rep_succ, app_app]

/-- `rcyc` t times. -/
theorem rcyc_iter (t : Nat) : ∀ a k m : Nat, ∃ n,
    steps n (RF a k (m + 1 + t)) = some (RF a (k + t) (m + 1)) := by
  induction t with
  | zero => intro a k m; exact ⟨0, by simp⟩
  | succ t ih =>
    intro a k m
    obtain ⟨n, hn⟩ := ih a (k + 1) m
    have h := rcyc a k (m + t)
    have e1 : m + 1 + (t + 1) = m + t + 2 := by omega
    have e2 : m + t + 1 = m + 1 + t := by omega
    have e3 : k + (t + 1) = k + 1 + t := by omega
    rw [e2] at h
    rw [e1, e3]
    exact ⟨_, steps_seq trans h hn⟩

/-- The end of a right phase whose run of `1111110` has odd length 2q+1. -/
theorem rend' (a q : Nat) : ∃ n, steps n (RF a (2 * q + 1) 1) = some (EF a q) := by
  have e : RF a (2 * q + 1) 1 = RF2 a q 1 := by
    simp only [RF, RF2, rep_succ, rep_double]
    rfl
  rw [e]
  exact ⟨_, rend a q⟩

/-- An odd round-trip phase and the right phase after it, from start to the start of the next round-trip phase. -/
theorem odd_phase (a p j : Nat) :
    ∃ n, steps n (O a (2 * p + 7) (2 * j + 3)) = some (EF (a + 4 + 3 * j) (p + 6 * j + 8)) := by
  have h1 := oentry a (2 * p + 1) (2 * j + 1)
  have e1 : 2 * p + 1 + 6 = 2 * p + 7 := by omega
  have e2 : 2 * j + 1 + 2 = 2 * j + 3 := by omega
  rw [e1, e2] at h1
  obtain ⟨n2, h2⟩ := cycle_iter j (a + 1) (2 * p + 5) 1
  have e3 : 2 * p + 5 + 2 = 2 * p + 7 := by omega
  have e4 : 1 + 2 * j = 2 * j + 1 := by omega
  rw [e3, e4] at h2
  have h3 := oexit (a + 1 + 3 * j) (2 * p + 1 + 12 * j)
  have e5 : 2 * p + 1 + 12 * j + 6 = 2 * p + 5 + 2 + 12 * j := by omega
  rw [e5] at h3
  obtain ⟨n4, h4⟩ := rcyc_iter (2 * p + 1 + 12 * j + 11) (a + 1 + 3 * j + 3) 5 0
  have e6 : 0 + 1 + (2 * p + 1 + 12 * j + 11) = 2 * p + 1 + 12 * j + 12 := by omega
  have e7 : 5 + (2 * p + 1 + 12 * j + 11) = 2 * (p + 6 * j + 8) + 1 := by omega
  rw [e6, e7] at h4
  obtain ⟨n5, h5⟩ := rend' (a + 1 + 3 * j + 3) (p + 6 * j + 8)
  have e8 : a + 1 + 3 * j + 3 = a + 4 + 3 * j := by omega
  rw [e8] at h4 h5
  rw [e8] at h3
  exact ⟨_, steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5)))⟩

