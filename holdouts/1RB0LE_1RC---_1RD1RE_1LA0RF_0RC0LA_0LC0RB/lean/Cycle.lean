theorem cycle_iter (k : Nat) : ∀ a b c : Nat, ∃ n,
    steps n (S1 a (b + 2) (c + 2 * k)) = some (S1 (a + 3 * k) (b + 2 + 12 * k) c) := by
  induction k with
  | zero => intro a b c; exact ⟨0, by simp⟩
  | succ k ih =>
    intro a b c
    obtain ⟨n, hn⟩ := ih (a + 3) (b + 12) c
    have h := cycle a b (c + 2 * k)
    rw [show b + 14 = b + 12 + 2 by omega] at h
    rw [show c + 2 * (k + 1) = c + 2 * k + 2 by omega, show a + 3 * (k + 1) = a + 3 + 3 * k by omega,
      show b + 2 + 12 * (k + 1) = b + 12 + 2 + 12 * k by omega]
    exact ⟨_, steps_seq trans h hn⟩

/-- `cycle2` k times. -/
theorem cycle2_iter (k : Nat) : ∀ a x y c : Nat, ∃ n,
    steps n (T2 a (x + 6) (y + 6) (c + 2 * k)) = some (T2 (a + 3 * k) (x + 6 + 7 * k) (y + 6 + 5 * k) c) := by
  induction k with
  | zero => intro a x y c; exact ⟨0, by simp⟩
  | succ k ih =>
    intro a x y c
    obtain ⟨n, hn⟩ := ih (a + 3) (x + 7) (y + 5) c
    have h := cycle2 a x y (c + 2 * k)
    rw [show x + 13 = x + 7 + 6 by omega, show y + 11 = y + 5 + 6 by omega] at h
    rw [show c + 2 * (k + 1) = c + 2 * k + 2 by omega, show a + 3 * (k + 1) = a + 3 + 3 * k by omega,
      show x + 6 + 7 * (k + 1) = x + 7 + 6 + 7 * k by omega, show y + 6 + 5 * (k + 1) = y + 5 + 6 + 5 * k by omega]
    exact ⟨_, steps_seq trans h hn⟩

/-- `cycle3` k times. -/
theorem cycle3_iter (k : Nat) : ∀ a x d y z c : Nat, ∃ n,
    steps n (T3 a (x + 6) (d + 5 * k) (y + 6) (z + 6) (c + 2 * k)) =
      some (T3 (a + 4 * k) (x + 6 + 8 * k) d (y + 6 + 7 * k) (z + 6 + 5 * k) c) := by
  induction k with
  | zero => intro a x d y z c; exact ⟨0, by simp⟩
  | succ k ih =>
    intro a x d y z c
    obtain ⟨n, hn⟩ := ih (a + 4) (x + 8) d (y + 7) (z + 5) c
    have h := cycle3 a x (d + 5 * k) y z (c + 2 * k)
    rw [show x + 14 = x + 8 + 6 by omega, show y + 13 = y + 7 + 6 by omega, show z + 11 = z + 5 + 6 by omega] at h
    rw [show c + 2 * (k + 1) = c + 2 * k + 2 by omega, show d + 5 * (k + 1) = d + 5 * k + 5 by omega,
      show a + 4 * (k + 1) = a + 4 + 4 * k by omega, show x + 6 + 8 * (k + 1) = x + 8 + 6 + 8 * k by omega,
      show y + 6 + 7 * (k + 1) = y + 7 + 6 + 7 * k by omega, show z + 6 + 5 * (k + 1) = z + 5 + 6 + 5 * k by omega]
    exact ⟨_, steps_seq trans h hn⟩

end H113677
