import Machine

/-! # Shift rules of 1RB0LE_1RC---_1RD1RE_1LA0RF_0RC0LA_0LC0RB

The passes of the machine over the regular parts of its tape: C moving right over `10` (`pass_10_right`), A moving
left over `01` (`pass_10_left`), F and B moving right turn `1000`/`0001` into `1110` (`fill_F`, `fill_B`), A moving
left turns `0111` into `0010` (`clear_A`).  The only halt is B reading a 1; B is entered from A reading a 0 and
from F reading a 1, both stepping right, so `A> 0 1` and `F> 1 1` halt after two steps (`halt_A`, `halt_F`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H113677

open TM

/-- C moving right over the alternating part, one step a cell. -/
theorem pass_10_right (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, false] (R), .C⟩ = some ⟨rep (n) [false, true] (L), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .C⟩ = some ⟨app [] (app [false, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, false] (R), .C⟩ = some ⟨rep (n) [false, true] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- A moving left over the alternating part, eight steps a copy of `01`. -/
theorem pass_10_left (n : Nat) (L R : Tape) :
    steps (8 * n) ⟨rep (n) [true, false] (L), cons true (cons false (R)), .A⟩ = some ⟨L, cons true (cons false (rep (n) [false, true] (R))), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [true, false] L, app [true, false] R, .A⟩ = some ⟨L, app [true, false] (app [false, true] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 8) ⟨rep (n) [true, false] (L), cons true (cons false (R)), .A⟩ = some ⟨L, cons true (cons false (rep (n) [false, true] (R))), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 8) (by omega) (h0)

/-- F moving right turns each `1000` into `1110`, ten steps a copy. -/
theorem fill_F (n : Nat) (L R : Tape) :
    steps (10 * n) ⟨L, rep (n) [true, false, false, false] (R), .F⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 10 ⟨app [] L, app [true, false, false, false] R, .F⟩ = some ⟨app [] (app [false, true, true, true] L), R, .F⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 10) ⟨L, rep (n) [true, false, false, false] (R), .F⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .F⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 10) (by omega) (h0)

/-- B moving right turns each `0001` into `1110`, ten steps a copy. -/
theorem fill_B (n : Nat) (L R : Tape) :
    steps (10 * n) ⟨cons false (L), rep (n) [false, false, false, true] (R), .B⟩ = some ⟨cons false (rep (n) [false, true, true, true] (L)), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 10 ⟨app [false] L, app [false, false, false, true] R, .B⟩ = some ⟨app [false] (app [false, true, true, true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 10) ⟨cons false (L), rep (n) [false, false, false, true] (R), .B⟩ = some ⟨cons false (rep (n) [false, true, true, true] (L)), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 10) (by omega) (h0)

/-- A moving left turns each `0111` into `0010`, ten steps a copy. -/
theorem clear_A (n : Nat) (L R : Tape) :
    steps (10 * n) ⟨rep (n) [true, true, true, false] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [false, false, true, false] (R)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 10 ⟨app [true, true, true, false] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 10) ⟨rep (n) [true, true, true, false] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [false, false, true, false] (R)), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 10) (by omega) (h0)

/-- `A> 0 1` halts: A writes a 1 and steps right in state B onto a 1, which has no transition. -/
theorem halt_A (L R : Tape) :
    ∃ c, steps 1 ⟨L, cons false (cons true R), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `F> 1 1` halts: F writes a 0 and steps right in state B onto a 1. -/
theorem halt_F (L R : Tape) :
    ∃ c, steps 1 ⟨L, cons true (cons true R), .F⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H113677
