  have h4 : ∃ n, steps n ⟨rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), cons true (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (rep (q) [false, false, true] (R)))))), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (p) [false, false, true] (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (rep (q) [false, false, true] (R))))))))))))))), .C⟩ :=
    ⟨_, sweep0_s4 p (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (rep (q) [false, false, true] (R))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

