    steps (5 * p + 10) ⟨rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), cons true (K1), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (p) [false, false, true] (K1)))))))))), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 5 ⟨app [false, true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((p) * 5) ⟨rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), cons true (K1), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))), cons true (rep (p) [false, false, true] (K1)), .D⟩ :=
    cross_l trans c0 (p) (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))) (K1)
  have h1 : steps 10 ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))), cons true (rep (p) [false, false, true] (K1)), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (p) [false, false, true] (K1)))))))))), .C⟩ := rfl
  exact steps_congr trans (a := (p) * 5 + (10)) (by omega) (steps_seq trans h0 (h1))

/-- A sweep with any number of carries (the list ts of digits 3, each followed by its block `a^(x+1)`), the first digit below 3 being 2: every digit 3 becomes 0 and its block gains one `a`, the digit 2 becomes 3. -/
theorem sweep2 (p q : Nat) (ts : List (Nat)) (R : Tape) :
    ∃ n, steps n ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (rep (p) [false, false, true] (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons false (rep (q + 1) [false, false, true] (R))))))))))), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (p) [false, false, true] (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R)))))))))))))))), .C⟩ := by
  have h0 : ∃ n, steps n ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (rep (p) [false, false, true] (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons false (rep (q + 1) [false, false, true] (R))))))))))), .C⟩ = some ⟨rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons false (rep (q + 1) [false, false, true] (R)))), .F⟩ :=
    ⟨_, sweep2_s0 p (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons false (rep (q + 1) [false, false, true] (R)))))⟩
  have h1 : ∃ n, steps n ⟨rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons false (rep (q + 1) [false, false, true] (R)))), .F⟩ = some ⟨sqr (fun (x : Nat) (X : Tape) => rep (x) [false, true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (X))))))))) ts (rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))), cons false (cons false (rep (q + 1) [false, false, true] (R))), .F⟩ :=
    seqR (fun (x : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) (fun (x : Nat) (X : Tape) => rep (x) [false, true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (X))))))))) (fun Y => Y) .F (fun x L R => ⟨_, sweep2_b1 x L R⟩) ts (rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))) (cons false (cons false (rep (q + 1) [false, false, true] (R))))
  have h2 : ∃ n, steps n ⟨sqr (fun (x : Nat) (X : Tape) => rep (x) [false, true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (X))))))))) ts (rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))), cons false (cons false (rep (q + 1) [false, false, true] (R))), .F⟩ = some ⟨sqr (fun (x : Nat) (X : Tape) => rep (x) [false, true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (X))))))))) ts (rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))), cons true (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R)))))), .D⟩ :=
    ⟨_, sweep2_s2 q (sqr (fun (x : Nat) (X : Tape) => rep (x) [false, true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (X))))))))) ts (rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))))) R⟩
  have h3 : ∃ n, steps n ⟨sqr (fun (x : Nat) (X : Tape) => rep (x) [false, true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (X))))))))) ts (rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))), cons true (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R)))))), .D⟩ = some ⟨rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), cons true (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R))))))), .D⟩ :=
    seqL' (fun (x : Nat) (X : Tape) => rep (x) [false, true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (X))))))))) (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) (fun Y => cons true (Y)) .D (fun x L R => ⟨_, sweep2_b3 x L R⟩) ts (rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))) (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R))))))
  have h4 : ∃ n, steps n ⟨rep (p) [false, true, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), cons true (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R))))))), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (p) [false, false, true] (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R)))))))))))))))), .C⟩ :=
    ⟨_, sweep2_s4 p (sq (fun (x : Nat) (X : Tape) => cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (x) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (rep (q) [false, false, true] (R)))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

end H175626
