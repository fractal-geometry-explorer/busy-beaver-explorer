import Machine

/-! Shift rules, proved for every n and every surrounding tape (`bbtools.symtm`). Generated by `py/gen_rules.py`. -/

namespace H64598

open TM

/-- The rightward sweep: C zigzags across `1 0 1` words, 7 steps each, rewriting each into `1 1 0`. -/
theorem sweep_right (n : Nat) (L R : Tape) :
    steps (7 * n) ⟨L, rep (n) [true, false, true] (R), .C⟩ = some ⟨rep (n) [false, true, true] (L), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 7 ⟨app [] L, app [true, false, true] R, .C⟩ = some ⟨app [] (app [false, true, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 7) ⟨L, rep (n) [true, false, true] (R), .C⟩ = some ⟨rep (n) [false, true, true] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 7) (by omega) (h0)

/-- Leftward, A crosses `1 1 0` words, rewriting each into `1 0 0` (read left to right). -/
theorem sweep_left_A (n : Nat) (L R : Tape) :
    steps (5 * n) ⟨rep (n) [false, true, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [false, false, true] (R)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 5 ⟨app [false, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, false, true] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 5) ⟨rep (n) [false, true, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [false, false, true] (R)), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 5) (by omega) (h0)

end H64598
