import Machine

/-! # The left sweep over the blocks `1^(2k) 0`

Going right, the head leaves behind blocks `1^(2k) 0` (`RightPass.lean`); going left it reads them back, one block
at a time, and writes tokens again.  Between blocks it stands on the `0` that ends a block, in one of three states,
each a machine state with a fixed word right of the head: `L0` (D, `0 0 0 1`), `L1` (A, `0 0 1 0`), `L2` (B,
`1 0 0 0`).  From `L0` and `L2` the next state depends only on k mod 3: one more `1^6` adds 30 steps and writes one
more period (`TM.cross_l`).  From `L0`, k = 1, 2, 3 (mod 3) give `L0`, `L1`, `L2`; from `L2` they give `L2`, `L0`,
`L1`.  `L1` first makes a short trip right over the tokens it has just written (11 cells), so its crossing depends on
them and is not stated here.  Generated by `py/gen_sweeps.py` with `bbtools.symtm`; every theorem is for every n and every
tape on both sides. -/

namespace H64598

open TM

/-- `L0` crosses a block `1^(6n+2) 0` and stays `L0`. -/
theorem left_L0_1 (n : Nat) (L R : Tape) :
    steps (30 * n + 5) ⟨cons true (cons true (rep (n) [true, true, true, true, true, true] (cons false (L)))), cons false (cons false (cons false (cons false (cons true (R))))), .D⟩ = some ⟨L, cons false (cons false (cons false (cons false (rep (n) [true, false, true, true, false, true] (cons true (cons false (cons false (cons true (R))))))))), .D⟩ := by
  have h0 : steps 4 ⟨cons true (cons true (rep (n) [true, true, true, true, true, true] (cons false (L)))), cons false (cons false (cons false (cons false (cons true (R))))), .D⟩ = some ⟨rep (n) [true, true, true, true, true, true] (cons false (L)), cons true (cons false (cons false (cons true (cons false (cons false (cons true (R))))))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 30 ⟨app [true, true, true, true, true, true] L, app [true, false, false] R, .A⟩ = some ⟨L, app [true, false, false] (app [true, false, true, true, false, true] R), .A⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 30) ⟨rep (n) [true, true, true, true, true, true] (cons false (L)), cons true (cons false (cons false (cons true (cons false (cons false (cons true (R))))))), .A⟩ = some ⟨cons false (L), cons true (cons false (cons false (rep (n) [true, false, true, true, false, true] (cons true (cons false (cons false (cons true (R)))))))), .A⟩ :=
    cross_l trans c1 (n) (cons false (L)) (cons true (cons false (cons false (cons true (R)))))
  have h2 : steps 1 ⟨cons false (L), cons true (cons false (cons false (rep (n) [true, false, true, true, false, true] (cons true (cons false (cons false (cons true (R)))))))), .A⟩ = some ⟨L, cons false (cons false (cons false (cons false (rep (n) [true, false, true, true, false, true] (cons true (cons false (cons false (cons true (R))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 4 + ((n) * 30 + (1))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

