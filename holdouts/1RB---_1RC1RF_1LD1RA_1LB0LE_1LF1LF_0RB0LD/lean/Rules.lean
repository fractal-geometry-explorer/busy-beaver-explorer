    steps (6 * a + 6 * b + 51) ⟨blank, cons false (rep (a + 1) [false, true, false] (cons true (cons false (cons true (rep (b + 1) [false, false, true] (cons false (cons true (blank)))))))), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (a) [true, false, false] (cons true (cons false (cons false (cons false (cons true (cons false (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank)))))))))))))))))))), .D⟩ := by
  have h0 : steps 6 ⟨blank, cons false (rep (a + 1) [false, true, false] (cons true (cons false (cons true (rep (b + 1) [false, false, true] (cons false (cons true (blank)))))))), .D⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (blank))))), rep (a) [false, true, false] (cons true (cons false (cons true (rep (b + 1) [false, false, true] (cons false (cons true (blank))))))), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 3 ⟨app [] L, app [false, true, false] R, .B⟩ = some ⟨app [] (app [true, true, true] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((a) * 3) ⟨cons false (cons true (cons true (cons true (cons true (blank))))), rep (a) [false, true, false] (cons true (cons false (cons true (rep (b + 1) [false, false, true] (cons false (cons true (blank))))))), .B⟩ = some ⟨rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))), cons true (cons false (cons true (rep (b + 1) [false, false, true] (cons false (cons true (blank)))))), .B⟩ :=
    cross_r trans c1 (a) (cons false (cons true (cons true (cons true (cons true (blank)))))) (cons true (cons false (cons true (rep (b + 1) [false, false, true] (cons false (cons true (blank)))))))
  have h2 : steps 4 ⟨rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))), cons true (cons false (cons true (rep (b + 1) [false, false, true] (cons false (cons true (blank)))))), .B⟩ = some ⟨cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))))))), cons false (cons true (rep (b) [false, false, true] (cons false (cons true (blank))))), .B⟩ := rfl
  have h3 : steps 0 ⟨cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))))))), cons false (cons true (rep (b) [false, false, true] (cons false (cons true (blank))))), .B⟩ = some ⟨cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))))))), rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank))))), .B⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (b) [false, false, true] (cons false (cons true (blank))))) = rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank))))) from
      rep_rotate (b) [false, true] [false, false, true] [false, true, false] rfl (cons false (cons true (blank)))]
  have c4 : ∀ L R : Tape, steps 3 ⟨app [] L, app [false, true, false] R, .B⟩ = some ⟨app [] (app [true, true, true] L), R, .B⟩ := fun _ _ => rfl
  have h4 : steps ((b) * 3) ⟨cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))))))), rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank))))), .B⟩ = some ⟨rep (b) [true, true, true] (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))), cons false (cons true (cons false (cons true (blank)))), .B⟩ :=
    cross_r trans c4 (b) (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))) (cons false (cons true (cons false (cons true (blank)))))
  have h5 : steps 10 ⟨rep (b) [true, true, true] (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))), cons false (cons true (cons false (cons true (blank)))), .B⟩ = some ⟨cons true (cons true (rep (b) [true, true, true] (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .D⟩ := rfl
  have h6 : steps 0 ⟨cons true (cons true (rep (b) [true, true, true] (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .D⟩ = some ⟨rep (b) [true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .D⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (b) [true, true, true] (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))))) = rep (b) [true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))))) from
      rep_rotate (b) [true, true] [true, true, true] [true, true, true] rfl (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))))))))]
  have c7 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true, false] R), .D⟩ := fun _ _ => rfl
  have h7 : steps ((b) * 3) ⟨rep (b) [true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .D⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))))))))), cons true (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank)))))), .D⟩ :=
    cross_l trans c7 (b) (cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank))))))))))))) (cons false (cons true (cons false (cons true (blank)))))
  have h8 : steps 8 ⟨cons true (cons true (cons false (cons true (cons false (cons true (rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))))))))), cons true (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank)))))), .D⟩ = some ⟨rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))), cons true (cons true (cons false (cons false (cons false (cons true (cons false (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank)))))))))))), .F⟩ := rfl
  have c9 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false, false] R), .F⟩ := fun _ _ => rfl
  have h9 : steps ((a) * 3) ⟨rep (a) [true, true, true] (cons false (cons true (cons true (cons true (cons true (blank)))))), cons true (cons true (cons false (cons false (cons false (cons true (cons false (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank)))))))))))), .F⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (blank))))), cons true (rep (a) [true, false, false] (cons true (cons false (cons false (cons false (cons true (cons false (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank))))))))))))), .F⟩ :=
    cross_l trans c9 (a) (cons false (cons true (cons true (cons true (cons true (blank)))))) (cons true (cons false (cons false (cons false (cons true (cons false (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank))))))))))))
  have h10 : steps 23 ⟨cons false (cons true (cons true (cons true (cons true (blank))))), cons true (rep (a) [true, false, false] (cons true (cons false (cons false (cons false (cons true (cons false (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank))))))))))))), .F⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (a) [true, false, false] (cons true (cons false (cons false (cons false (cons true (cons false (rep (b) [false, true, false] (cons false (cons true (cons false (cons true (blank)))))))))))))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 6 + ((a) * 3 + (4 + (0 + ((b) * 3 + (10 + (0 + ((b) * 3 + (8 + ((a) * 3 + (23))))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (h10)))))))))))

end H83770
