  have c1 : ∀ L R : Tape, steps 6 ⟨app [false, true, true, false, true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, true, false, true, true, false] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((z) * 6) ⟨rep (z) [false, true, true, false, true, true] (K0), cons true (cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ = some ⟨K0, cons true (rep (z) [true, true, false, true, true, false] (cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (blank)))))))))), .D⟩ :=
