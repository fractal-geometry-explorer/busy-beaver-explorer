theorem a_right (n : Nat) (L R : Tape) :
    steps (16 * n) ⟨cons true (cons false (L)), rep (n) [true, true, false, true, true, false] (R), .A⟩ = some ⟨cons true (cons false (rep (n) [false, true, true, false, true, true] (L))), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 16 ⟨app [true, false] L, app [true, true, false, true, true, false] R, .A⟩ = some ⟨app [true, false] (app [false, true, true, false, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 16) ⟨cons true (cons false (L)), rep (n) [true, true, false, true, true, false] (R), .A⟩ = some ⟨cons true (cons false (rep (n) [false, true, true, false, true, true] (L))), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 16) (by omega) (h0)

