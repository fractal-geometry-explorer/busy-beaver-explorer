import Rules

/-!
# The right-end map of 1RB1LF_1RC1RF_0LD1RE_---1LC_0RB1RE_1LA0LE, proved

Configurations (tapes left to right, the head reads the cell after `S>`; `[br]` is the bracket `1^2 0 (10)^c`, or
nothing for `c = none`):

* `Tv c a b`   = `0^inf [br] 1^a 0 (10)^b B> 0^inf`                         (a visit of the right end)
* `Cs c x n w` = `0^inf [br] 1^x 0 A> 1 (11)^n tail_w`                      (inside a sweep: pool `1^x`, middle
  block `(11)^n`, a tail worth `w` rounds: `0 (10)^(w-2) 1 0^inf` for `w ≥ 2`, `0^inf` for `w = 1`, and for `w = 0`
  one more 1 of the middle block, `1 0^inf`)

The rules of `Rules.lean` (generated by `py/rules.py`) restated on these configurations are the moves of
`py/model.py`'s `step`: rounds, the end of a sweep, the carry at a pool of two, the odd and even events, the bracket
that an odd pool leaves behind, the merge of an odd pool into the bracket, and the fresh sweep of a pool of one at
`w = 1` (a node of its own, `rs`).  They are assembled into a map `F` on nodes.

Main results:
* `F_sem`: on a good node, `F n = some n'` → the machine goes from `n` to `n'` (at least one step) and `n'` is
  good; `F n = none` → it halts from `n`;
* `halts_iff`: **the machine halts from blank tape iff the orbit of the visit `Tv none 2 0` (step 7) under `F`
  reaches `none`**; the only halting nodes are the visits `Tv none 1 b` (`F_none_iff`).
-/

namespace H21883

open TM

/-! ## Tape identities -/

theorem tt_rot (n : Nat) (X : Tape) :
    rep n [true, true] (cons true (cons true X)) = cons true (cons true (rep n [true, true] X)) :=
  (rep_rotate n [true, true] [true, true] [true, true] rfl X).symm

theorem tt_one (n : Nat) (X : Tape) : rep n [true, true] X = rep (2 * n) [true] X := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, ih, rep_succ, rep_succ]; rfl

theorem pool4 (n : Nat) (Y : Tape) :
    rep n [true, true] (cons true (cons true (cons true (cons true Y)))) = rep (2 * n + 4) [true] Y := by
  rw [tt_one, show (cons true (cons true (cons true (cons true Y)))) = rep 4 [true] Y from rfl, ← rep_add]

theorem pool6 (n : Nat) (Y : Tape) :
    rep n [true, true] (cons true (cons true (cons true (cons true (cons true (cons true Y)))))) =
      rep (2 * n + 6) [true] Y := by
  rw [tt_one, show (cons true (cons true (cons true (cons true (cons true (cons true Y)))))) = rep 6 [true] Y
    from rfl, ← rep_add]

theorem ft_succ (n : Nat) (Z : Tape) : rep (n + 1) [false, true] Z = rep n [false, true] (cons false (cons true Z)) :=
  (rep_app_comm n [false, true] Z).symm

theorem tail_rot (n : Nat) :
    cons true (rep n [false, true] (cons false blank)) = rep n [true, false] (cons true blank) := by
  have h := rep_rotate n [true] [false, true] [true, false] rfl (cons false blank)
  simp only [app_cons, app_nil] at h
  rw [h, cons_false_blank]

theorem merge_tt (c n : Nat) (Y : Tape) :
    rep c [true, true] (cons true (cons true (cons true (cons true (rep n [true, true] Y))))) =
      rep (c + n + 2) [true, true] Y := by
  rw [show (cons true (cons true (cons true (cons true (rep n [true, true] Y))))) = rep 2 [true, true]
    (rep n [true, true] Y) from rfl, ← rep_add, ← rep_add, show c + 2 + n = c + n + 2 by omega]

theorem merge6 (c n : Nat) (Y : Tape) :
    rep c [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (rep n [true, true] Y)))))))
      = rep (c + n + 3) [true, true] Y := by
  rw [show (cons true (cons true (cons true (cons true (cons true (cons true (rep n [true, true] Y))))))) =
    rep 3 [true, true] (rep n [true, true] Y) from rfl, ← rep_add, ← rep_add, show c + 3 + n = c + n + 3 by omega]

/-! ## The configurations -/

/-- The bracket `1^2 0 (10)^c`, nearest cell first (`none`: blank tape). -/
def Br : Option Nat → Tape
  | none => blank
  | some c => rep c [false, true] (cons false (cons true (cons true blank)))

/-- Left of the head inside a sweep: `0`, the pool `1^x`, the bracket. -/
def Lf (c : Option Nat) (x : Nat) : Tape := cons false (rep x [true] (Br c))

/-- Right of the head inside a sweep: `1 (11)^n` and the tail worth `w` rounds. -/
def Rgt (n : Nat) : Nat → Tape
  | 0 => cons true (rep n [true, true] (cons true blank))
  | 1 => cons true (rep n [true, true] blank)
  | z + 2 => cons true (rep n [true, true] (cons false (rep z [true, false] (cons true blank))))

def Cs (c : Option Nat) (x n w : Nat) : Config := ⟨Lf c x, Rgt n w, .A⟩

/-- The visit `T(c, a, b) = 0^inf [br] 1^a 0 (10)^b B> 0^inf`. -/
def Tv (c : Option Nat) (a b : Nat) : Config := ⟨rep b [false, true] (cons false (rep a [true] (Br c))), blank, .B⟩

theorem br_f (c : Option Nat) : ∃ L, Br c = cons false L := by
  cases c with
  | none => exact ⟨blank, cons_false_blank.symm⟩
  | some c =>
    cases c with
    | zero => exact ⟨_, rfl⟩
    | succ c => exact ⟨_, rfl⟩

/-! ## Reaching -/

def Reach (c c' : Config) : Prop := ∃ n, steps (n + 1) c = some c'
def Reaches (c c' : Config) : Prop := ∃ n, steps n c = some c'

theorem reach_trans {a b c : Config} : Reach a b → Reach b c → Reach a c
  | ⟨n, h1⟩, ⟨m, h2⟩ => ⟨n + m + 1, steps_congr trans (by omega) (steps_seq trans h1 h2)⟩
theorem Reach.reaches {a b : Config} : Reach a b → Reaches a b
  | ⟨n, h⟩ => ⟨n + 1, h⟩
theorem halts_pre {a b : Config} : Reaches a b → Halts trans b → Halts trans a
  | ⟨n, h1⟩, ⟨m, c, h2, h3⟩ => ⟨n + m, c, steps_seq trans h1 h2, h3⟩
theorem reach_of {n : Nat} {c c' d d' : Config} (h : steps n d = some d') (e1 : c = d) (e2 : c' = d')
    (hn : 0 < n) : Reach c c' := by
  subst e1; subst e2; exact ⟨n - 1, by rw [show n - 1 + 1 = n by omega]; exact h⟩

/-! ## The moves -/

theorem m_start (c : Option Nat) (a z : Nat) : Reach (Tv c (a + 2) (z + 2)) (Cs c (a + 2) 1 (z + 2)) := by
  refine reach_of (start z (rep a [true] (Br c))) ?_ ?_ (by omega)
  · simp only [Tv]; rw [rep_add]; rfl
  · simp only [Cs, Rgt]; rw [tail_rot]; rfl

theorem m_start1 (c : Option Nat) (a : Nat) : Reach (Tv c (a + 2) 1) (Cs c (a + 2) 1 1) := by
  refine reach_of (c_start1 (rep a [true] (Br c))) rfl ?_ (by omega)
  simp only [Cs, Rgt]; rw [cons_false_blank]; rfl

theorem m_start0 (c : Option Nat) (a : Nat) : Reach (Tv c (a + 2) 0) (Cs c (a + 2) 0 0) :=
  reach_of (c_start0 (rep a [true] (Br c))) rfl rfl (by omega)

theorem m_round (c : Option Nat) (x n z : Nat) : Reach (Cs c (x + 3) n (z + 3)) (Cs c (x + 1) (n + 2) (z + 2)) := by
  refine reach_of (round n (rep x [true] (Br c)) (rep z [true, false] (cons true blank))) rfl ?_ (by omega)
  simp only [Cs, Rgt]; rw [tt_rot]; rfl

theorem m_round_last (c : Option Nat) (x n : Nat) : Reach (Cs c (x + 3) n 2) (Cs c (x + 1) (n + 2) 1) := by
  refine reach_of (c_round_last n (rep x [true] (Br c))) rfl ?_ (by omega)
  simp only [Cs, Rgt]; rw [tt_rot]; rfl

theorem m_round_w1 (c : Option Nat) (x n : Nat) : Reach (Cs c (x + 3) n 1) (Cs c (x + 1) (n + 1) 0) :=
  reach_of (c_round_w1 n (rep x [true] (Br c))) rfl rfl (by omega)

theorem m_final (c : Option Nat) (x n : Nat) : Reach (Cs c (x + 3) n 0) (Tv c (x + 1) (n + 2)) := by
  refine reach_of (final n (rep x [true] (Br c))) rfl ?_ (by omega)
  simp only [Tv]; rw [show n + 2 = n + 1 + 1 from rfl, ft_succ (n + 1)]; rfl

theorem m_final_br (c n : Nat) : Reach (Cs (some c) 3 n 0) (Tv none 2 (c + n + 3)) := by
  refine reach_of (final n (rep 0 [true] (Br (some c)))) rfl ?_ (by omega)
  simp only [Tv, Br]
  rw [show c + n + 3 = (n + 2) + 1 + c by omega, rep_add (n + 2 + 1) c, rep_succ, rep_add n 2]; rfl

theorem m_carry (c : Option Nat) (n z : Nat) : Reach (Cs c 2 n (z + 4)) (Cs c (2 * n + 4) 1 (z + 2)) := by
  obtain ⟨L, hL⟩ := br_f c
  refine reach_of (carry n L (rep z [true, false] (cons true blank))) ?_ ?_ (by omega)
  · simp only [Cs, Lf, hL]; rfl
  · simp only [Cs, Lf, Rgt, hL]; rw [pool4]; rfl

theorem m_carry_w3 (c : Option Nat) (n : Nat) : Reach (Cs c 2 n 3) (Cs c (2 * n + 4) 1 1) := by
  obtain ⟨L, hL⟩ := br_f c
  refine reach_of (c_carry_w3 n L) ?_ ?_ (by omega)
  · simp only [Cs, Lf, hL]; rfl
  · simp only [Cs, Lf, Rgt, hL]; rw [pool4]; rfl

theorem m_carry_w2 (c : Option Nat) (n : Nat) : Reach (Cs c 2 n 2) (Cs c (2 * n + 4) 0 0) := by
  obtain ⟨L, hL⟩ := br_f c
  refine reach_of (c_carry_w2 n L) ?_ ?_ (by omega)
  · simp only [Cs, Lf, hL]; rfl
  · simp only [Cs, Lf, Rgt, hL]; rw [pool4]; rfl

theorem m_even (c : Option Nat) (n : Nat) : Reach (Cs c 2 n 1) (Tv c (2 * n + 4) 0) := by
  obtain ⟨L, hL⟩ := br_f c
  refine reach_of (event_even n L) ?_ ?_ (by omega)
  · simp only [Cs, Lf, hL]; rfl
  · simp only [Tv, hL]; rw [pool4]; rfl

theorem m_odd (c : Option Nat) (n : Nat) : Reach (Cs c 2 n 0) (Tv c (2 * n + 5) 0) := by
  obtain ⟨L, hL⟩ := br_f c
  refine reach_of (event_odd n L) ?_ ?_ (by omega)
  · simp only [Cs, Lf, hL]; rfl
  · simp only [Tv, hL]; rw [show 2 * n + 5 = 2 * n + 4 + 1 from rfl, rep_succ, pool4]; rfl

theorem m_bracket (n z : Nat) : Reach (Cs none 1 n (z + 5)) (Cs (some (n + 1)) 2 1 (z + 2)) := by
  refine reach_of (c_bracket n z) rfl ?_ (by omega)
  simp only [Cs, Lf, Br]; rw [ft_succ]; rfl

theorem m_bracket_w4 (n : Nat) : Reach (Cs none 1 n 4) (Cs (some (n + 1)) 2 1 1) := by
  refine reach_of (c_bracket_w4 n) rfl ?_ (by omega)
  simp only [Cs, Lf, Br]; rw [ft_succ]; rfl

theorem m_bracket_w3 (n : Nat) : Reach (Cs none 1 n 3) (Cs (some (n + 1)) 2 0 0) := by
  refine reach_of (c_bracket_w3 n) rfl ?_ (by omega)
  simp only [Cs, Lf, Br]; rw [ft_succ]; rfl

theorem m_bracket_w2 (n : Nat) : Reach (Cs none 1 n 2) (Tv (some (n + 1)) 2 0) := by
  refine reach_of (c_bracket_w2 n) rfl ?_ (by omega)
  simp only [Tv, Br]; rw [ft_succ]; rfl

theorem m_restart (n : Nat) : Reach (Cs none 1 (n + 1) 1) (Cs none 2 1 (n + 2)) := by
  refine reach_of (c_restart n) rfl ?_ (by omega)
  simp only [Cs, Rgt]; rw [tail_rot]; rfl

theorem m_odd_w0 (n : Nat) : Reach (Cs none 1 n 0) (Tv none (2 * n + 7) 0) := by
  refine reach_of (c_odd_w0 n) rfl ?_ (by omega)
  simp only [Tv, Br]; rw [cons_false_blank, show 2 * n + 7 = 2 * n + 6 + 1 from rfl, rep_succ, pool6]; rfl

theorem m_merge (c n z : Nat) : Reach (Cs (some c) 3 n (z + 3)) (Cs none 2 (c + n + 3) (z + 2)) := by
  refine reach_of (c_merge c n z) rfl ?_ (by omega)
  simp only [Cs, Rgt]; rw [tt_rot n, merge6]; rfl

theorem m_merge_w2 (c n : Nat) : Reach (Cs (some c) 3 n 2) (Cs none 2 (c + n + 3) 1) := by
  refine reach_of (c_merge_w2 c n) rfl ?_ (by omega)
  simp only [Cs, Rgt]; rw [tt_rot n, merge6]; rfl

theorem m_merge_w1 (c n : Nat) : Reach (Cs (some c) 3 n 1) (Cs none 2 (c + n + 2) 0) := by
  refine reach_of (c_merge_w1 c n) rfl ?_ (by omega)
  simp only [Cs, Rgt]; rw [merge_tt]; rfl

theorem m_halt (b : Nat) : Halts trans (Tv none 1 b) := halt_T1 b

/-! ## The map -/

/-- The nodes: visits `Tv c a b`, and the fresh sweep `rs n` = `Cs none 2 1 (n + 2)` that a pool of one starts at
`w = 1` (no visit of the right end comes in between). -/
inductive Node where
  | vis (c : Option Nat) (a b : Nat)
  | rs (n : Nat)
  deriving DecidableEq, Repr

def Node.cfg : Node → Config
  | .vis c a b => Tv c a b
  | .rs n => Cs none 2 1 (n + 2)

/-- One sweep from inside, `Cs c x n w`, to the next node, or `none` for the halt (and for states no run
reaches: `Good`). -/
def inner : Option Nat → Nat → Nat → Nat → Option Node
  | some c, 3, n, z + 3 => inner none 2 (c + n + 3) (z + 2)
  | some c, 3, n, 2 => inner none 2 (c + n + 3) 1
  | some c, 3, n, 1 => inner none 2 (c + n + 2) 0
  | some c, 3, n, 0 => some (.vis none 2 (c + n + 3))
  | none, x + 3, n, z + 3 => inner none (x + 1) (n + 2) (z + 2)
  | none, x + 3, n, 2 => inner none (x + 1) (n + 2) 1
  | none, x + 3, n, 1 => inner none (x + 1) (n + 1) 0
  | none, x + 3, n, 0 => some (.vis none (x + 1) (n + 2))
  | some c, x + 4, n, z + 3 => inner (some c) (x + 2) (n + 2) (z + 2)
  | some c, x + 4, n, 2 => inner (some c) (x + 2) (n + 2) 1
  | some c, x + 4, n, 1 => inner (some c) (x + 2) (n + 1) 0
  | some c, x + 4, n, 0 => some (.vis (some c) (x + 2) (n + 2))
  | c, 2, n, z + 4 => inner c (2 * n + 4) 1 (z + 2)
  | c, 2, n, 3 => inner c (2 * n + 4) 1 1
  | c, 2, n, 2 => inner c (2 * n + 4) 0 0
  | c, 2, n, 1 => some (.vis c (2 * n + 4) 0)
  | c, 2, n, 0 => some (.vis c (2 * n + 5) 0)
  | none, 1, n, z + 5 => inner (some (n + 1)) 2 1 (z + 2)
  | none, 1, n, 4 => inner (some (n + 1)) 2 1 1
  | none, 1, n, 3 => inner (some (n + 1)) 2 0 0
  | none, 1, n, 2 => some (.vis (some (n + 1)) 2 0)
  | none, 1, n + 1, 1 => some (.rs n)
  | none, 1, 0, 1 => none
  | none, 1, n, 0 => some (.vis none (2 * n + 7) 0)
  | some _, 1, _, _ => none
  | _, 0, _, _ => none
  termination_by _ _ _ w => w

/-- The map on nodes; `none` is the halt (`Tv none 1 b`). -/
def F : Node → Option Node
  | .vis c (a + 2) (z + 2) => inner c (a + 2) 1 (z + 2)
  | .vis c (a + 2) 1 => inner c (a + 2) 1 1
  | .vis c (a + 2) 0 => inner c (a + 2) 0 0
  | .vis _ _ _ => none
  | .rs n => inner none 2 1 (n + 2)

/-- The states and nodes a run meets. -/
def GoodI (c : Option Nat) (x n w : Nat) : Prop := 2 ≤ x ∨ (x = 1 ∧ c = none ∧ (w = 1 → 1 ≤ n))
def Good : Node → Prop
  | .vis c a _ => 2 ≤ a ∨ (a = 1 ∧ c = none)
  | .rs _ => True

/-- What `F` claims about a configuration. -/
def Sem (x : Config) : Option Node → Prop
  | some n => Reach x n.cfg ∧ Good n
  | none => Halts trans x

theorem sem_pre {x y : Config} {o : Option Node} (h : Reach x y) (hy : Sem y o) : Sem x o := by
  cases o with
  | none => exact halts_pre h.reaches hy
  | some v => exact ⟨reach_trans h hy.1, hy.2⟩

theorem sem_vis {x : Config} {c : Option Nat} {a b : Nat} (h : Reach x (Tv c a b)) (hg : 2 ≤ a ∨ (a = 1 ∧ c = none)) :
    Sem x (some (.vis c a b)) := ⟨h, hg⟩

theorem inner_sem (w : Nat) : ∀ c x n, GoodI c x n w → Sem (Cs c x n w) (inner c x n w) := by
  induction w using Nat.strongRecOn with
  | ind w ih =>
    intro c x n hg
    match c, x, n, w with
    | some c, 3, n, z + 3 =>
      simp only [inner]; exact sem_pre (m_merge c n z) (by simpa only [inner] using ih (z + 2) (by omega) none 2 (c + n + 3) (by simp [GoodI]))
    | some c, 3, n, 2 =>
      simp only [inner]; exact sem_pre (m_merge_w2 c n) (by simpa only [inner] using ih 1 (by omega) none 2 (c + n + 3) (by simp [GoodI]))
    | some c, 3, n, 1 =>
      simp only [inner]; exact sem_pre (m_merge_w1 c n) (by simpa only [inner] using ih 0 (by omega) none 2 (c + n + 2) (by simp [GoodI]))
    | some c, 3, n, 0 => simp only [inner]; exact sem_vis (m_final_br c n) (by simp <;> omega)
    | none, x + 3, n, z + 3 =>
      simp only [inner]
      exact sem_pre (m_round none x n z) (by simpa only [inner] using ih (z + 2) (by omega) none (x + 1) (n + 2) (by simp [GoodI] <;> omega))
    | none, x + 3, n, 2 =>
      simp only [inner]
      exact sem_pre (m_round_last none x n) (by simpa only [inner] using ih 1 (by omega) none (x + 1) (n + 2) (by simp [GoodI] <;> omega))
    | none, x + 3, n, 1 =>
      simp only [inner]
      exact sem_pre (m_round_w1 none x n) (by simpa only [inner] using ih 0 (by omega) none (x + 1) (n + 1) (by simp [GoodI] <;> omega))
    | none, x + 3, n, 0 => simp only [inner]; exact sem_vis (m_final none x n) (by simp <;> omega)
    | some c, x + 4, n, z + 3 =>
      simp only [inner]
      exact sem_pre (m_round (some c) (x + 1) n z) (by simpa only [inner] using ih (z + 2) (by omega) (some c) (x + 2) (n + 2) (by simp [GoodI] <;> omega))
    | some c, x + 4, n, 2 =>
      simp only [inner]
      exact sem_pre (m_round_last (some c) (x + 1) n) (by simpa only [inner] using ih 1 (by omega) (some c) (x + 2) (n + 2) (by simp [GoodI] <;> omega))
    | some c, x + 4, n, 1 =>
      simp only [inner]
      exact sem_pre (m_round_w1 (some c) (x + 1) n) (by simpa only [inner] using ih 0 (by omega) (some c) (x + 2) (n + 1) (by simp [GoodI] <;> omega))
    | some c, x + 4, n, 0 => simp only [inner]; exact sem_vis (m_final (some c) (x + 1) n) (by simp <;> omega)
    | c, 2, n, z + 4 =>
      simp only [inner]; exact sem_pre (m_carry c n z) (by simpa only [inner] using ih (z + 2) (by omega) c (2 * n + 4) 1 (by simp [GoodI]))
    | c, 2, n, 3 =>
      simp only [inner]; exact sem_pre (m_carry_w3 c n) (by simpa only [inner] using ih 1 (by omega) c (2 * n + 4) 1 (by simp [GoodI]))
    | c, 2, n, 2 =>
      simp only [inner]; exact sem_pre (m_carry_w2 c n) (by simpa only [inner] using ih 0 (by omega) c (2 * n + 4) 0 (by simp [GoodI]))
    | c, 2, n, 1 => simp only [inner]; exact sem_vis (m_even c n) (by simp <;> omega)
    | c, 2, n, 0 => simp only [inner]; exact sem_vis (m_odd c n) (by simp <;> omega)
    | none, 1, n, z + 5 =>
      simp only [inner]; exact sem_pre (m_bracket n z) (by simpa only [inner] using ih (z + 2) (by omega) (some (n + 1)) 2 1 (by simp [GoodI]))
    | none, 1, n, 4 =>
      simp only [inner]; exact sem_pre (m_bracket_w4 n) (by simpa only [inner] using ih 1 (by omega) (some (n + 1)) 2 1 (by simp [GoodI]))
    | none, 1, n, 3 =>
      simp only [inner]; exact sem_pre (m_bracket_w3 n) (by simpa only [inner] using ih 0 (by omega) (some (n + 1)) 2 0 (by simp [GoodI]))
    | none, 1, n, 2 => simp only [inner]; exact sem_vis (m_bracket_w2 n) (by simp <;> omega)
    | none, 1, n + 1, 1 => simp only [inner]; exact ⟨m_restart n, trivial⟩
    | none, 1, 0, 1 => simp [GoodI] at hg
    | none, 1, n, 0 => simp only [inner]; exact sem_vis (m_odd_w0 n) (by simp <;> omega)
    | some _, 1, _, _ => simp [GoodI] at hg
    | _, 0, _, _ => simp [GoodI] at hg

theorem inner_ne_none (w : Nat) : ∀ c x n, GoodI c x n w → inner c x n w ≠ none := by
  induction w using Nat.strongRecOn with
  | ind w ih =>
    intro c x n hg
    match c, x, n, w with
    | some c, 3, n, z + 3 =>
      simp only [inner]; simpa only [inner] using ih (z + 2) (by omega) none 2 (c + n + 3) (by simp [GoodI])
    | some c, 3, n, 2 =>
      simp only [inner]; simpa only [inner] using ih 1 (by omega) none 2 (c + n + 3) (by simp [GoodI])
    | some c, 3, n, 1 =>
      simp only [inner]; simpa only [inner] using ih 0 (by omega) none 2 (c + n + 2) (by simp [GoodI])
    | some c, 3, n, 0 => simp only [inner]; simp
    | none, x + 3, n, z + 3 =>
      simp only [inner]
      simpa only [inner] using ih (z + 2) (by omega) none (x + 1) (n + 2) (by simp [GoodI] <;> omega)
    | none, x + 3, n, 2 =>
      simp only [inner]
      simpa only [inner] using ih 1 (by omega) none (x + 1) (n + 2) (by simp [GoodI] <;> omega)
    | none, x + 3, n, 1 =>
      simp only [inner]
      simpa only [inner] using ih 0 (by omega) none (x + 1) (n + 1) (by simp [GoodI] <;> omega)
    | none, x + 3, n, 0 => simp only [inner]; simp
    | some c, x + 4, n, z + 3 =>
      simp only [inner]
      simpa only [inner] using ih (z + 2) (by omega) (some c) (x + 2) (n + 2) (by simp [GoodI] <;> omega)
    | some c, x + 4, n, 2 =>
      simp only [inner]
      simpa only [inner] using ih 1 (by omega) (some c) (x + 2) (n + 2) (by simp [GoodI] <;> omega)
    | some c, x + 4, n, 1 =>
      simp only [inner]
      simpa only [inner] using ih 0 (by omega) (some c) (x + 2) (n + 1) (by simp [GoodI] <;> omega)
    | some c, x + 4, n, 0 => simp only [inner]; simp
    | c, 2, n, z + 4 =>
      simp only [inner]; simpa only [inner] using ih (z + 2) (by omega) c (2 * n + 4) 1 (by simp [GoodI])
    | c, 2, n, 3 =>
      simp only [inner]; simpa only [inner] using ih 1 (by omega) c (2 * n + 4) 1 (by simp [GoodI])
    | c, 2, n, 2 =>
      simp only [inner]; simpa only [inner] using ih 0 (by omega) c (2 * n + 4) 0 (by simp [GoodI])
    | c, 2, n, 1 => simp only [inner]; simp
    | c, 2, n, 0 => simp only [inner]; simp
    | none, 1, n, z + 5 =>
      simp only [inner]; simpa only [inner] using ih (z + 2) (by omega) (some (n + 1)) 2 1 (by simp [GoodI])
    | none, 1, n, 4 =>
      simp only [inner]; simpa only [inner] using ih 1 (by omega) (some (n + 1)) 2 1 (by simp [GoodI])
    | none, 1, n, 3 =>
      simp only [inner]; simpa only [inner] using ih 0 (by omega) (some (n + 1)) 2 0 (by simp [GoodI])
    | none, 1, n, 2 => simp only [inner]; simp
    | none, 1, n + 1, 1 => simp only [inner]; simp
    | none, 1, 0, 1 => simp [GoodI] at hg
    | none, 1, n, 0 => simp only [inner]; simp
    | some _, 1, _, _ => simp [GoodI] at hg
    | _, 0, _, _ => simp [GoodI] at hg

/-- **`F` is the machine on nodes.** -/
theorem F_sem (v : Node) (hg : Good v) : Sem v.cfg (F v) := by
  match v with
  | .vis c (a + 2) (z + 2) =>
    exact sem_pre (m_start c a z) (inner_sem _ c (a + 2) 1 (by simp [GoodI]))
  | .vis c (a + 2) 1 => exact sem_pre (m_start1 c a) (inner_sem _ c (a + 2) 1 (by simp [GoodI]))
  | .vis c (a + 2) 0 => exact sem_pre (m_start0 c a) (inner_sem _ c (a + 2) 0 (by simp [GoodI]))
  | .vis none 1 b => exact m_halt b
  | .vis (some _) 1 _ => simp [Good] at hg
  | .vis _ 0 _ => simp [Good] at hg
  | .rs n => exact inner_sem (n + 2) none 2 1 (by simp [GoodI])

/-! ## Halting is the orbit question -/

def orbit (v : Node) : Nat → Option Node
  | 0 => some v
  | k + 1 => (F v).bind (fun v' => orbit v' k)

/-- The run from blank tape is at the visit `T(none, 2, 0)` after 7 steps. -/
theorem blank_to_T : steps 7 init = some (Tv none 2 0) :=
  blank_reaches trans (q := .A) (n := 7) (c := ⟨[false, true, true], [], .B⟩) (by decide)

theorem runs_long (N : Nat) : ∀ v, Good v → (∀ k, orbit v k ≠ none) →
    ∃ m, N ≤ m ∧ ∃ c, steps m v.cfg = some c := by
  induction N with
  | zero => intro v _ _; exact ⟨0, Nat.le_refl 0, _, rfl⟩
  | succ N ih =>
    intro v hg hs
    have hr := F_sem v hg
    cases hF : F v with
    | none => exact absurd (by simp [orbit, hF]) (hs 1)
    | some v' =>
      have hs' : ∀ k, orbit v' k ≠ none := fun k h => hs (k + 1) (by simp [orbit, hF, h])
      rw [hF] at hr
      obtain ⟨⟨k, hk⟩, hg'⟩ := hr
      obtain ⟨m, hm, c, hc⟩ := ih v' hg' hs'
      exact ⟨k + 1 + m, by omega, c, steps_seq trans hk hc⟩

theorem halts_from (v : Node) (hg : Good v) : Halts trans v.cfg ↔ ∃ k, orbit v k = none := by
  constructor
  · intro hh
    refine Classical.byContradiction fun hne => ?_
    have hs : ∀ k, orbit v k ≠ none := fun k h => hne ⟨k, h⟩
    refine not_halts_of_forall trans ?_ hh
    exact forall_of_unbounded trans (fun m => ∃ c, steps m v.cfg = some c) (runs_long · v hg hs) (fun _ h => h)
  · rintro ⟨k, hk⟩
    induction k generalizing v with
    | zero => simp [orbit] at hk
    | succ k ih =>
      have hr := F_sem v hg
      cases hF : F v with
      | none => rw [hF] at hr; exact hr
      | some v' =>
        rw [hF] at hr
        have hk' : orbit v' k = none := by simpa [orbit, hF] using hk
        exact halts_pre hr.1.reaches (ih v' hr.2 hk')

/-- **Main theorem.** The machine halts from blank tape iff the orbit of the visit `T(none, 2, 0)` (step 7) under
`F` reaches `none`. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ k, orbit (.vis none 2 0) k = none := by
  have hg : Good (.vis none 2 0) := by simp [Good]
  rw [← halts_from _ hg]
  constructor
  · intro hh
    refine Classical.byContradiction fun hne => ?_
    have hs : ∀ k, orbit (.vis none 2 0) k ≠ none := fun k h => hne ((halts_from _ hg).2 ⟨k, h⟩)
    refine not_halts_of_forall trans ?_ hh
    refine forall_of_unbounded trans (fun m => ∃ c, steps m init = some c) (fun N => ?_) (fun _ h => h)
    obtain ⟨m, hm, c, hc⟩ := runs_long N _ hg hs
    exact ⟨7 + m, by omega, c, steps_seq trans blank_to_T hc⟩
  · exact halts_pre ⟨7, blank_to_T⟩

/-- On the nodes a run meets, `F` stops exactly at the visits `T(none, 1, b)`. -/
theorem F_none_iff (v : Node) (hg : Good v) : F v = none ↔ ∃ b, v = .vis none 1 b := by
  constructor
  · intro h
    match v, hg, h with
    | .vis c (a + 2) (z + 2), _, h => exact absurd h (inner_ne_none _ c (a + 2) 1 (by simp [GoodI]))
    | .vis c (a + 2) 1, _, h => exact absurd h (inner_ne_none _ c (a + 2) 1 (by simp [GoodI]))
    | .vis c (a + 2) 0, _, h => exact absurd h (inner_ne_none _ c (a + 2) 0 (by simp [GoodI]))
    | .vis none 1 b, _, _ => exact ⟨b, rfl⟩
    | .vis (some _) 1 _, hg, _ => simp [Good] at hg
    | .vis _ 0 _, hg, _ => simp [Good] at hg
    | .rs n, _, h => exact absurd h (inner_ne_none (n + 2) none 2 1 (by simp [GoodI]))
  · rintro ⟨b, rfl⟩; rfl

theorem orbit_succ (k : Nat) : ∀ v : Node, orbit v (k + 1) = (orbit v k).bind F := by
  induction k with
  | zero => intro v; simp [orbit]
  | succ k ih =>
    intro v
    show (F v).bind (fun v' => orbit v' (k + 1)) = ((F v).bind (fun v' => orbit v' k)).bind F
    cases F v with
    | none => rfl
    | some v' => exact ih v'

theorem orbit_good (k : Nat) : ∀ v v', Good v → orbit v k = some v' → Good v' := by
  induction k with
  | zero => intro v v' hg h; simp [orbit] at h; subst h; exact hg
  | succ k ih =>
    intro v v' hg h
    have hr := F_sem v hg
    cases hF : F v with
    | none => simp [orbit, hF] at h
    | some w =>
      rw [hF] at hr
      exact ih w v' hr.2 (by simpa [orbit, hF] using h)

/-- **The machine halts from blank tape iff the orbit of `T(none, 2, 0)` reaches a visit `T(none, 1, b)`**:
a pool of a single 1 with no bracket. -/
theorem halts_iff_T1 : HaltsFromBlank ↔ ∃ k b, orbit (.vis none 2 0) k = some (.vis none 1 b) := by
  have hg0 : Good (.vis none 2 0) := by simp [Good]
  rw [halts_iff]
  constructor
  · rintro ⟨k, hk⟩
    induction k with
    | zero => simp [orbit] at hk
    | succ k ih =>
      rw [orbit_succ] at hk
      cases ho : orbit (.vis none 2 0) k with
      | none => exact ih ho
      | some v =>
        rw [ho] at hk
        obtain ⟨b, rfl⟩ := (F_none_iff v (orbit_good k _ v hg0 ho)).1 hk
        exact ⟨k, b, ho⟩
  · rintro ⟨k, b, hk⟩
    exact ⟨k + 1, by rw [orbit_succ, hk]; rfl⟩

/-! ## The orbit, evaluated -/

theorem orbit_ne_of_le {v : Node} {k N : Nat} (hk : k ≤ N) (h : orbit v N ≠ none) : orbit v k ≠ none := by
  intro h0; apply h
  obtain ⟨d, rfl⟩ : ∃ d, N = k + d := ⟨N - k, by omega⟩
  clear hk h
  induction d with
  | zero => exact h0
  | succ d ih => rw [← Nat.add_assoc, orbit_succ, ih]; rfl

set_option maxRecDepth 100000 in
/-- The first 100 nodes of the orbit do not halt (Lean's kernel). -/
theorem orbit_kernel : ∀ k ≤ 100, orbit (.vis none 2 0) k ≠ none :=
  fun _ hk => orbit_ne_of_le hk (by decide +kernel)

/-- The first 10^4 nodes of the orbit do not halt (compiled evaluation). -/
theorem orbit_native : ∀ k ≤ 10000, orbit (.vis none 2 0) k ≠ none :=
  fun _ hk => orbit_ne_of_le hk (by native_decide)

end H21883
