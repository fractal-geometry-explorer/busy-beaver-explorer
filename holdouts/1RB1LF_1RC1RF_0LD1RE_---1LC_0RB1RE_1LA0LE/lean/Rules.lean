/-- `T(none, 1, n) = 0^inf 1 0 (10)^n B> 0^inf` halts, for every n: the only halting visits of the right end. -/
theorem halt_T1 (n : Nat) :
    TM.Halts trans ⟨rep (n) [false, true] (cons false (cons true (blank))), blank, .B⟩ :=
  ⟨_, _, halt_run n, rfl⟩

