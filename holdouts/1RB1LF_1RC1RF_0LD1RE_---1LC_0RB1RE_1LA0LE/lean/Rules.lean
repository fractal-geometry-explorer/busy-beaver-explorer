import Machine

/-! # The building blocks of the right-end map of 1RB1LF_1RC1RF_0LD1RE_---1LC_0RB1RE_1LA0LE

Between two visits `T(a, b) = [1^2 0 (10)^c] 1^a 0 (10)^b B> 0^inf` of the right end the machine works through the
inner configurations `C(x, p, tail) = ... 1^x 0 [A> 1] 1^p tail`.  Each theorem is one move of `py/model.py`'s
`step`, for every value of its parameters and every tape in the contexts `L`, `R`:

* `start`, `start0`, `start1`: from `T(a, b)` to the first `C(a, 2, ·)` (b ≥ 2), or straight to `T(a-2, 2)`, `T(a-4, 4)`;
* `round`, `round_last`, `round_w1`: a round takes two 1s from the pool, one `10` from the tail and adds four 1s
  (three in the last round) to the middle block: `(x, p, w) → (x-2, p+4, w-1)`;
* `final`: with the tail used up, the middle block becomes the new `(10)` block: `T(x-2, (p+3)/2)`;
* `carry`: the pool is down to two 1s: the middle block becomes the new pool, `(2, p, w) → (p+4, 2, w-2)`;
* `event_odd`, `event_even`: the pool and the tail run out together: `T(p+4, 0)` with p odd (an odd pool appears),
  or p even;
* `bracket`: an odd pool runs out: the middle block is left behind as the bracket `1^2 0 (10)^c`;
* `merge`: an odd pool runs out next to a bracket: the bracket is unwound into the middle block (`unwind`);
* `halt_run`: `0^inf 1 0 (10)^n B> 0^inf` reaches `D> 0` (the undefined transition) after 2n + 6 steps; `halt_T1`: so it halts.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H21883

open TM

/-- `T(a, n+2)` to `C(a, 2, 0 (10)^n 1)`. -/
theorem start (n : Nat) (L : Tape) :
    steps (2 * n + 14) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))), blank, .B⟩ = some ⟨cons false (cons true (cons true (L))), cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (cons false (blank))))))), .A⟩ := by
  have h0 : steps 2 ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))), blank, .B⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))), cons true (cons false (blank)), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))), cons true (cons false (blank)), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (L))))))), cons true (rep (n) [false, true] (cons false (blank))), .D⟩ :=
    cross_l trans c1 (n) (cons false (cons true (cons false (cons true (cons false (cons true (cons true (L)))))))) (cons false (blank))
  have h2 : steps 12 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (L))))))), cons true (rep (n) [false, true] (cons false (blank))), .D⟩ = some ⟨cons false (cons true (cons true (L))), cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (cons false (blank))))))), .A⟩ := rfl
  exact steps_congr trans (a := 2 + ((n) * 2 + (12))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- `T(a, 0)` to `T(a-2, 2)`. -/
theorem start0 (L : Tape) :
    steps (24) ⟨cons false (cons true (cons true (cons true (L)))), blank, .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), blank, .B⟩ := by
  have h0 : steps 24 ⟨cons false (cons true (cons true (cons true (L)))), blank, .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), blank, .B⟩ := rfl
  exact steps_congr trans (a := 24) (by omega) (h0)

/-- `T(a, 1)` to `T(a-4, 4)`. -/
theorem start1 (L : Tape) :
    steps (54) ⟨cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (L)))))))), blank, .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))))), blank, .B⟩ := by
  have h0 : steps 54 ⟨cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (L)))))))), blank, .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))))), blank, .B⟩ := rfl
  exact steps_congr trans (a := 54) (by omega) (h0)

/-- A walks left through `(10)^n`, turning it into 1s. -/
theorem unwind (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, true] (R)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, true] (R)), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- A round with tail left: `(x, 2n, w) -> (x-2, 2n+4, w-1)`. -/
theorem round (n : Nat) (L R : Tape) :
    steps (6 * n + 14) ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons false (cons true (cons false (R))))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))))), .A⟩ := by
  have h0 : steps 11 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons false (cons true (cons false (R))))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons false (cons true (cons false (R)))), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true] L, app [true, true] R, .F⟩ = some ⟨app [true] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons false (cons true (cons false (R)))), .F⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons false (cons true (cons false (R))), .F⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (L))))) (cons false (cons true (cons false (R))))
  have h2 : steps 1 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons false (cons true (cons false (R))), .F⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (cons true (cons false (R)))), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h3 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (cons true (cons false (R)))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))), .A⟩ :=
    cross_l trans c3 (n) (cons false (cons true (cons false (cons true (L))))) (cons true (cons true (cons false (R))))
  have h4 : steps 2 ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))))), .A⟩ := rfl
  exact steps_congr trans (a := 11 + ((n) * 4 + (1 + ((n) * 2 + (2))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The round that uses the last 1 of the tail (w = 2 to 1). -/
theorem round_last (n : Nat) (L : Tape) :
    steps (6 * n + 14) ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons false (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (blank)))))), .A⟩ := by
  have h0 : steps 11 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons false (cons true (blank)))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons false (cons true (blank))), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true] L, app [true, true] R, .F⟩ = some ⟨app [true] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons false (cons true (blank))), .F⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons false (cons true (blank)), .F⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (L))))) (cons false (cons true (blank)))
  have h2 : steps 1 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons false (cons true (blank)), .F⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (cons true (blank))), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h3 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (cons true (blank))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (cons true (blank)))), .A⟩ :=
    cross_l trans c3 (n) (cons false (cons true (cons false (cons true (L))))) (cons true (cons true (blank)))
  have h4 : steps 2 ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (blank)))))), .A⟩ := rfl
  exact steps_congr trans (a := 11 + ((n) * 4 + (1 + ((n) * 2 + (2))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The round at w = 1: three 1s, the middle block becomes odd. -/
theorem round_w1 (n : Nat) (L : Tape) :
    steps (6 * n + 14) ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (blank)), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (blank))))), .A⟩ := by
  have h0 : steps 11 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (blank)), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (blank), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true] L, app [true, true] R, .F⟩ = some ⟨app [true] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (blank), .F⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), blank, .F⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (L))))) (blank)
  have h2 : steps 1 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), blank, .F⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (blank)), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h3 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (blank)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ :=
    cross_l trans c3 (n) (cons false (cons true (cons false (cons true (L))))) (cons true (blank))
  have h4 : steps 2 ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (blank))))), .A⟩ := rfl
  exact steps_congr trans (a := 11 + ((n) * 4 + (1 + ((n) * 2 + (2))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- w = 0: `C(x, 2n+1, 0^inf)` to `T(x-2, n+2)`. -/
theorem final (n : Nat) (L : Tape) :
    steps (4 * n + 14) ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))))), blank, .B⟩ := by
  have h0 : steps 11 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons true (blank)), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true] L, app [true, true] R, .F⟩ = some ⟨app [true] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons true (blank)), .F⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons true (blank), .F⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (L))))) (cons true (blank))
  have h2 : steps 3 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons true (blank), .F⟩ = some ⟨cons false (cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))))), blank, .B⟩ := rfl
  exact steps_congr trans (a := 11 + ((n) * 4 + (3))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- The pool is `1^2` (after blank tape or a bracket, which both end in 0): `(2, 2n, w) -> (2n+4, 2, w-2)`. -/
theorem carry (n : Nat) (L R : Tape) :
    steps (2 * n + 12) ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (R))))))), .A⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L))))))), cons true (cons true (cons true (cons false (R)))), .A⟩ := by
  have h0 : steps 9 ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (R))))))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (R)))))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, true] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (R)))))), .E⟩ = some ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (cons false (R))))), .E⟩ :=
    cross_r trans c1 (n) (cons true (cons true (cons true (cons true (cons false (L)))))) (cons false (cons true (cons false (cons true (cons false (R))))))
  have h2 : steps 3 ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (cons false (R))))), .E⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L))))))), cons true (cons true (cons true (cons false (R)))), .A⟩ := rfl
  exact steps_congr trans (a := 9 + ((n) * 2 + (3))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- Pool `1^2` and w = 0: `T(2n+5, 0)`, an odd pool. -/
theorem event_odd (n : Nat) (L : Tape) :
    steps (2 * n + 11) ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))))), blank, .B⟩ := by
  have h0 : steps 9 ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (cons true (blank)), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, true] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (cons true (blank)), .E⟩ = some ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), cons true (blank), .E⟩ :=
    cross_r trans c1 (n) (cons true (cons true (cons true (cons true (cons false (L)))))) (cons true (blank))
  have h2 : steps 2 ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), cons true (blank), .E⟩ = some ⟨cons false (cons true (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))))), blank, .B⟩ := rfl
  exact steps_congr trans (a := 9 + ((n) * 2 + (2))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- Pool `1^2` and w = 1: `T(2n+4, 0)`. -/
theorem event_even (n : Nat) (L : Tape) :
    steps (2 * n + 10) ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (blank)), .A⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L))))))), blank, .B⟩ := by
  have h0 : steps 9 ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (blank)), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (blank), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, true] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (blank), .E⟩ = some ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), blank, .E⟩ :=
    cross_r trans c1 (n) (cons true (cons true (cons true (cons true (cons false (L)))))) (blank)
  have h2 : steps 1 ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), blank, .E⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L))))))), blank, .B⟩ := rfl
  exact steps_congr trans (a := 9 + ((n) * 2 + (1))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- An odd pool down to `1` with no bracket: the middle block becomes the bracket `1^2 0 (10)^(n+1)`. -/
theorem bracket (n : Nat) (R : Tape) :
    steps (4 * n + 18) ⟨cons false (cons true (blank)), cons true (rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))), .A⟩ = some ⟨cons false (cons true (cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (cons true (blank))))))))), cons true (cons true (cons true (cons false (R)))), .A⟩ := by
  have h0 : steps 13 ⟨cons false (cons true (blank)), cons true (rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (blank))))), rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [false, true] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons false (cons true (cons false (cons true (cons true (blank))))), rep (n) [true, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R)))))))), .B⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))), .B⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (cons true (blank)))))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))))
  have h2 : steps 5 ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (R))))))), .B⟩ = some ⟨cons false (cons true (cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (cons true (blank))))))))), cons true (cons true (cons true (cons false (R)))), .A⟩ := rfl
  exact steps_congr trans (a := 13 + ((n) * 4 + (5))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- An odd pool `1^3` next to the bracket `1^2 0 (10)^c`: the bracket joins the middle block. -/
theorem merge (c n : Nat) (L R : Tape) :
    steps (2 * c + 6 * n + 16) ⟨cons false (cons true (cons true (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))))))), cons true (rep (n) [true, true] (cons false (cons true (cons false (R))))), .A⟩ = some ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (c) [true, true] (cons true (cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (cons false (R)))))))))), .A⟩ := by
  have h0 : steps 11 ⟨cons false (cons true (cons true (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))))))), cons true (rep (n) [true, true] (cons false (cons true (cons false (R))))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L)))))))))), rep (n) [true, true] (cons false (cons true (cons false (R)))), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true] L, app [true, true] R, .F⟩ = some ⟨app [true] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons true (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L)))))))))), rep (n) [true, true] (cons false (cons true (cons false (R)))), .F⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))))))))), cons false (cons true (cons false (R))), .F⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L)))))))))) (cons false (cons true (cons false (R))))
  have h2 : steps 1 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))))))))), cons false (cons true (cons false (R))), .F⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L)))))))))), cons true (cons true (cons true (cons false (R)))), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h3 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L)))))))))), cons true (cons true (cons true (cons false (R)))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))))))), cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))), .A⟩ :=
    cross_l trans c3 (n) (cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L)))))))))) (cons true (cons true (cons false (R))))
  have h4 : steps 4 ⟨cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))))))), cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))), .A⟩ = some ⟨rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))), cons true (cons true (cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))))))), .A⟩ := rfl
  have c5 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h5 : steps ((c) * 2) ⟨rep (c) [false, true] (cons false (cons true (cons true (cons false (L))))), cons true (cons true (cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (cons false (R))))))))), .A⟩ = some ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (c) [true, true] (cons true (cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (cons false (R)))))))))), .A⟩ :=
    cross_l trans c5 (c) (cons false (cons true (cons true (cons false (L))))) (cons true (cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (cons false (R)))))))))
  exact steps_congr trans (a := 11 + ((n) * 4 + (1 + ((n) * 2 + (4 + ((c) * 2)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- `T(none, 1, n)` runs into the undefined transition (D reading 0). -/
theorem halt_run (n : Nat) :
    steps (2 * n + 6) ⟨rep (n) [false, true] (cons false (cons true (blank))), blank, .B⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (rep (n) [false, true] (cons false (blank))))))), .D⟩ := by
  have h0 : steps 2 ⟨rep (n) [false, true] (cons false (cons true (blank))), blank, .B⟩ = some ⟨rep (n) [false, true] (cons false (cons true (blank))), cons true (cons false (blank)), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (blank))), cons true (cons false (blank)), .D⟩ = some ⟨cons false (cons true (blank)), cons true (rep (n) [false, true] (cons false (blank))), .D⟩ :=
    cross_l trans c1 (n) (cons false (cons true (blank))) (cons false (blank))
  have h2 : steps 4 ⟨cons false (cons true (blank)), cons true (rep (n) [false, true] (cons false (blank))), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (rep (n) [false, true] (cons false (blank))))))), .D⟩ := rfl
  exact steps_congr trans (a := 2 + ((n) * 2 + (4))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- `T(a, 1)` to the round state with w = 1. -/
theorem c_start1 (L : Tape) :
    steps (12) ⟨cons false (cons true (cons false (cons true (cons true (L))))), blank, .B⟩ = some ⟨cons false (cons true (cons true (L))), cons true (cons true (cons true (cons false (blank)))), .A⟩ := by
  have h0 : steps 12 ⟨cons false (cons true (cons false (cons true (cons true (L))))), blank, .B⟩ = some ⟨cons false (cons true (cons true (L))), cons true (cons true (cons true (cons false (blank)))), .A⟩ := rfl
  exact steps_congr trans (a := 12) (by omega) (h0)

/-- `T(a, 0)` to the round state with w = 0. -/
theorem c_start0 (L : Tape) :
    steps (10) ⟨cons false (cons true (cons true (L))), blank, .B⟩ = some ⟨cons false (cons true (cons true (L))), cons true (cons true (blank)), .A⟩ := by
  have h0 : steps 10 ⟨cons false (cons true (cons true (L))), blank, .B⟩ = some ⟨cons false (cons true (cons true (L))), cons true (cons true (blank)), .A⟩ := rfl
  exact steps_congr trans (a := 10) (by omega) (h0)

/-- The round from w = 2 to w = 1. -/
theorem c_round_last (n : Nat) (L : Tape) :
    steps (6 * n + 14) ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons false (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (blank)))))), .A⟩ := by
  have h0 : steps 11 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (cons false (cons true (blank)))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons false (cons true (blank))), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true] L, app [true, true] R, .F⟩ = some ⟨app [true] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (cons false (cons true (blank))), .F⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons false (cons true (blank)), .F⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (L))))) (cons false (cons true (blank)))
  have h2 : steps 1 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons false (cons true (blank)), .F⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (cons true (blank))), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h3 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (cons true (blank))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (cons true (blank)))), .A⟩ :=
    cross_l trans c3 (n) (cons false (cons true (cons false (cons true (L))))) (cons true (cons true (blank)))
  have h4 : steps 2 ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (cons true (blank)))))), .A⟩ := rfl
  exact steps_congr trans (a := 11 + ((n) * 4 + (1 + ((n) * 2 + (2))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The round from w = 1 to w = 0. -/
theorem c_round_w1 (n : Nat) (L : Tape) :
    steps (6 * n + 14) ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (blank)), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (blank))))), .A⟩ := by
  have h0 : steps 11 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (n) [true, true] (blank)), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (blank), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true] L, app [true, true] R, .F⟩ = some ⟨app [true] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (n) [true, true] (blank), .F⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), blank, .F⟩ :=
    cross_r trans c1 (n) (cons false (cons true (cons false (cons true (L))))) (blank)
  have h2 : steps 1 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (L)))))), blank, .F⟩ = some ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (blank)), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h3 : steps ((n) * 2) ⟨rep (n) [false, true] (cons false (cons true (cons false (cons true (L))))), cons true (cons true (blank)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ :=
    cross_l trans c3 (n) (cons false (cons true (cons false (cons true (L))))) (cons true (blank))
  have h4 : steps 2 ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true, true] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (rep (n) [true, true] (cons true (blank))))), .A⟩ := rfl
  exact steps_congr trans (a := 11 + ((n) * 4 + (1 + ((n) * 2 + (2))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- A carry at w = 3. -/
theorem c_carry_w3 (n : Nat) (L : Tape) :
    steps (2 * n + 12) ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (cons false (cons true (cons false (cons true (blank)))))), .A⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L))))))), cons true (cons true (cons true (blank))), .A⟩ := by
  have h0 : steps 9 ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (cons false (cons true (cons false (cons true (blank)))))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (cons false (cons true (cons false (cons true (blank))))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, true] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨cons true (cons true (cons true (cons true (cons false (L))))), rep (n) [true, true] (cons false (cons true (cons false (cons true (blank))))), .E⟩ = some ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (blank)))), .E⟩ :=
    cross_r trans c1 (n) (cons true (cons true (cons true (cons true (cons false (L)))))) (cons false (cons true (cons false (cons true (blank)))))
  have h2 : steps 3 ⟨rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (blank)))), .E⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L))))))), cons true (cons true (cons true (blank))), .A⟩ := rfl
  exact steps_congr trans (a := 9 + ((n) * 2 + (3))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A carry at w = 2. -/
theorem c_carry_w2 (n : Nat) (L : Tape) :
    steps (2 * n + 12) ⟨cons false (cons true (cons true (cons false (L)))), cons true (rep (n) [true, true] (cons false (cons true (blank)))), .A⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons true (cons true (cons true (cons false (L))))))), cons true (cons true (blank)), .A⟩ := by
