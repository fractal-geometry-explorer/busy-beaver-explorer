import Machine

/-! The block rules: how the two sweeps rewrite a row of blocks of 1s split by single 0s, for all block sizes and every tape around them. Generated by `py/blocks.py`. -/

namespace H7085

open TM

/-- C, sweeping left, passes a single 1: the block it leaves and the block it enters both grow by one cell. -/
theorem pass (c : Nat) (L R : Tape) :
    steps (c + 4) ⟨rep (c) [true] (cons false (cons true (cons false (cons true (L))))), cons true (R), .C⟩ = some ⟨L, cons true (cons true (cons false (cons true (cons true (rep (c) [true] (R)))))), .C⟩ := by
  have hn : (c) * 1 + (4) = c + 4 := by omega
  have c0 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((c) * 1) ⟨rep (c) [true] (cons false (cons true (cons false (cons true (L))))), cons true (R), .C⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (c) [true] (R)), .C⟩ :=
    cross_l trans c0 (c) (cons false (cons true (cons false (cons true (L))))) (R)
  have h1 : steps 4 ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (c) [true] (R)), .C⟩ = some ⟨L, cons true (cons true (cons false (cons true (cons true (rep (c) [true] (R)))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

/-- C meets a block of at least two 1s: the block loses two cells, the 0 moves two cells left, and the head turns round in A. -/
theorem bounce (c : Nat) (L R : Tape) :
    steps (c + 6) ⟨rep (c) [true] (cons false (cons true (cons true (L)))), cons true (R), .C⟩ = some ⟨cons true (cons true (cons false (L))), cons true (rep (c) [true] (R)), .A⟩ := by
  have hn : (c) * 1 + (6) = c + 6 := by omega
  have c0 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((c) * 1) ⟨rep (c) [true] (cons false (cons true (cons true (L)))), cons true (R), .C⟩ = some ⟨cons false (cons true (cons true (L))), cons true (rep (c) [true] (R)), .C⟩ :=
    cross_l trans c0 (c) (cons false (cons true (cons true (L)))) (R)
  have h1 : steps 6 ⟨cons false (cons true (cons true (L))), cons true (rep (c) [true] (R)), .C⟩ = some ⟨cons true (cons true (cons false (L))), cons true (rep (c) [true] (R)), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

/-- A, sweeping right, turns the next block, of odd length 2k+1, into k single 1s and goes on in A. -/
theorem shred (a k : Nat) (L R : Tape) :
    steps (a + 2 * k + 3) ⟨L, rep (a) [true] (cons false (cons true (rep (k) [true, true] (cons false (R))))), .A⟩ = some ⟨cons true (cons false (rep (k) [true, false] (cons true (rep (a) [true] (L))))), R, .A⟩ := by
  have hn : (a) * 1 + (1 + (0 + ((k) * 2 + (2)))) = a + 2 * k + 3 := by omega
  have c0 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((a) * 1) ⟨L, rep (a) [true] (cons false (cons true (rep (k) [true, true] (cons false (R))))), .A⟩ = some ⟨rep (a) [true] (L), cons false (cons true (rep (k) [true, true] (cons false (R)))), .A⟩ :=
    cross_r trans c0 (a) (L) (cons false (cons true (rep (k) [true, true] (cons false (R)))))
  have h1 : steps 1 ⟨rep (a) [true] (L), cons false (cons true (rep (k) [true, true] (cons false (R)))), .A⟩ = some ⟨cons true (rep (a) [true] (L)), cons true (rep (k) [true, true] (cons false (R))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (rep (a) [true] (L)), cons true (rep (k) [true, true] (cons false (R))), .B⟩ = some ⟨cons true (rep (a) [true] (L)), rep (k) [true, true] (cons true (cons false (R))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (k) [true, true] (cons false (R))) = rep (k) [true, true] (cons true (cons false (R))) from
      rep_rotate (k) [true] [true, true] [true, true] rfl (cons false (R))]
  have c3 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((k) * 2) ⟨cons true (rep (a) [true] (L)), rep (k) [true, true] (cons true (cons false (R))), .B⟩ = some ⟨rep (k) [true, false] (cons true (rep (a) [true] (L))), cons true (cons false (R)), .B⟩ :=
    cross_r trans c3 (k) (cons true (rep (a) [true] (L))) (cons true (cons false (R)))
  have h4 : steps 2 ⟨rep (k) [true, false] (cons true (rep (a) [true] (L))), cons true (cons false (R)), .B⟩ = some ⟨cons true (cons false (rep (k) [true, false] (cons true (rep (a) [true] (L))))), R, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The next block has even length 2k+2: k single 1s, and the head turns round in C. -/
theorem turn (a k : Nat) (L R : Tape) :
    steps (a + 2 * k + 4) ⟨L, rep (a) [true] (cons false (rep (k + 1) [true, true] (cons false (R)))), .A⟩ = some ⟨cons false (rep (k) [true, false] (cons true (rep (a) [true] (L)))), cons true (cons true (R)), .C⟩ := by
  have hn : (a) * 1 + (1 + ((k + 1) * 2 + (1))) = a + 2 * k + 4 := by omega
  have c0 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((a) * 1) ⟨L, rep (a) [true] (cons false (rep (k + 1) [true, true] (cons false (R)))), .A⟩ = some ⟨rep (a) [true] (L), cons false (rep (k + 1) [true, true] (cons false (R))), .A⟩ :=
    cross_r trans c0 (a) (L) (cons false (rep (k + 1) [true, true] (cons false (R))))
  have h1 : steps 1 ⟨rep (a) [true] (L), cons false (rep (k + 1) [true, true] (cons false (R))), .A⟩ = some ⟨cons true (rep (a) [true] (L)), rep (k + 1) [true, true] (cons false (R)), .B⟩ := rfl
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((k + 1) * 2) ⟨cons true (rep (a) [true] (L)), rep (k + 1) [true, true] (cons false (R)), .B⟩ = some ⟨rep (k + 1) [true, false] (cons true (rep (a) [true] (L))), cons false (R), .B⟩ :=
    cross_r trans c2 (k + 1) (cons true (rep (a) [true] (L))) (cons false (R))
  have h3 : steps 1 ⟨rep (k + 1) [true, false] (cons true (rep (a) [true] (L))), cons false (R), .B⟩ = some ⟨cons false (rep (k) [true, false] (cons true (rep (a) [true] (L)))), cons true (cons true (R)), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- A double 0 with a 1 on its left, met by C from the right: E reads the 1, the halting transition. -/
theorem halt_pattern (c : Nat) (L R : Tape) :
    steps (c + 3) ⟨rep (c) [true] (cons false (cons false (cons true (L)))), cons true (R), .C⟩ = some ⟨L, cons true (cons true (cons true (cons true (rep (c) [true] (R))))), .E⟩ := by
  have hn : (c) * 1 + (3) = c + 3 := by omega
  have c0 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((c) * 1) ⟨rep (c) [true] (cons false (cons false (cons true (L)))), cons true (R), .C⟩ = some ⟨cons false (cons false (cons true (L))), cons true (rep (c) [true] (R)), .C⟩ :=
    cross_l trans c0 (c) (cons false (cons false (cons true (L)))) (R)
  have h1 : steps 3 ⟨cons false (cons false (cons true (L))), cons true (rep (c) [true] (R)), .C⟩ = some ⟨L, cons true (cons true (cons true (cons true (rep (c) [true] (R))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

end H7085
