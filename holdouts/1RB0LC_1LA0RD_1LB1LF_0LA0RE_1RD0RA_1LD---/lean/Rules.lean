/-! Shift rules of the leftward sweep. Generated by py/rules.py (tools/py/bbtools/symtm.py); do not edit by hand. The background of the tape is the period-3 word 100 (as the head leaves it after a sweep to the right) or 110 (after a sweep to the left); these rules cross a whole run of copies at once. -/

namespace H105641

open TM

/-- A runs left over triples 100, turning each into 110 (A1 → 0LC, C0 → 1LB, B0 → 1LA): the leftward sweep that turns the right-sweep form 100 of the background into its left-sweep form 110. -/
theorem a_left (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [false, false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, true, false] (R)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [false, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [false, false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [true, true, false] (R)), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 3) (by omega) (h0)

/-- The same sweep entered in phase B: each 001 becomes 101. -/
theorem b_left (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [true, false, false] (L), cons false (R), .B⟩ = some ⟨L, cons false (rep (n) [true, false, true] (R)), .B⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true, false, false] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [true, false, true] R), .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true, false, false] (L), cons false (R), .B⟩ = some ⟨L, cons false (rep (n) [true, false, true] (R)), .B⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 3) (by omega) (h0)

/-- The same sweep entered in phase C: each 010 becomes 011. -/
theorem c_left (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [false, true, false] (L), cons false (R), .C⟩ = some ⟨L, cons false (rep (n) [false, true, true] (R)), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [false, true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [false, true, false] (L), cons false (R), .C⟩ = some ⟨L, cons false (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 3) (by omega) (h0)

