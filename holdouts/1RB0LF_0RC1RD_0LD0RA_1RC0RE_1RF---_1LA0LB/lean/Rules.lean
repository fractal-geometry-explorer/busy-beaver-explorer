  have h0 : steps 5 ⟨cons true (cons true (rep (a + 1) [false, true] (cons false (cons true (cons true (cons false (cons true (cons true (rep (b + 1) [false, true] (cons false (cons true (cons true (cons true (L)))))))))))))), blank, .C⟩ = some ⟨cons true (rep (a + 1) [false, true] (cons false (cons true (cons true (cons false (cons true (cons true (rep (b + 1) [false, true] (cons false (cons true (cons true (cons true (L))))))))))))), cons false (cons false (cons true (blank))), .F⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (a + 1) [false, true] (cons false (cons true (cons true (cons false (cons true (cons true (rep (b + 1) [false, true] (cons false (cons true (cons true (cons true (L))))))))))))), cons false (cons false (cons true (blank))), .F⟩ = some ⟨rep (a + 1) [true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (b + 1) [false, true] (cons false (cons true (cons true (cons true (L))))))))))))), cons false (cons false (cons true (blank))), .F⟩ := by
