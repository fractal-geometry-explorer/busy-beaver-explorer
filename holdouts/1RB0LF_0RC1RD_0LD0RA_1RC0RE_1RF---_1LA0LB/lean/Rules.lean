      rep_rotate (a + 1) [true] [false, true] [true, false] rfl (cons false (cons true (cons true (cons false (cons true (cons true (rep (b + 1) [false, true] (cons false (cons true (cons true (cons true (L))))))))))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .F⟩ = some ⟨L, app [false] (app [false, true] R), .F⟩ := fun _ _ => rfl
  have h2 : steps ((a + 1) * 2) ⟨rep (a + 1) [true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (b + 1) [false, true] (cons false (cons true (cons true (cons true (L))))))))))))), cons false (cons false (cons true (blank))), .F⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (b + 1) [false, true] (cons false (cons true (cons true (cons true (L)))))))))))), cons false (rep (a + 1) [false, true] (cons false (cons true (blank)))), .F⟩ :=
