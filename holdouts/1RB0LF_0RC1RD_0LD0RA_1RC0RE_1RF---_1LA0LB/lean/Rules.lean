  have h8 : steps ((b) * 6) ⟨cons true (cons false (cons true (cons false (cons true (L))))), rep (b) [true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (a + 1) [false, true] (cons false (cons true (blank))))))))))))), .F⟩ = some ⟨cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))), cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (a + 1) [false, true] (cons false (cons true (blank)))))))))))), .F⟩ :=
