import Machine

/-! The cascade: what a pass of the head does when it turns on a pair 01, by the number of blank cells to its left. Generated by `py/cascade_lean.py`. -/

namespace H34090

open TM

/-- Cascade with m = 0 blank cells: the pair to the left is a Y (here the 1 and the turning cell): the cascade is the hit L 1 1 B> 1 0 R, D erasing into R (7 steps), for every L and R. -/
theorem cascade0 (L R : Tape) :
    steps (7) ⟨cons false (cons true (L)), cons true (R), .F⟩ = some ⟨cons false (cons false (cons false (L))), R, .D⟩ := by
  have hn : 7 = 7 := by omega
  have h0 : steps 7 ⟨cons false (cons true (L)), cons true (R), .F⟩ = some ⟨cons false (cons false (cons false (L))), R, .D⟩ := rfl
  exact steps_congr trans hn (h0)

/-- Cascade with m = 1 blank cells: the head turns right as at a wall visit, B running into R (9 steps), for every L and R. -/
theorem cascade1 (L R : Tape) :
    steps (9) ⟨cons false (cons false (cons true (L))), cons true (R), .F⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), R, .B⟩ := by
  have hn : 9 = 9 := by omega
  have h0 : steps 9 ⟨cons false (cons false (cons true (L))), cons true (R), .F⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), R, .B⟩ := rfl
  exact steps_congr trans hn (h0)

/-- Cascade with m = 2 blank cells: C on the 1, D next steps into L (6 steps), for every L and R. -/
theorem cascade2 (L R : Tape) :
    steps (6) ⟨cons false (cons false (cons false (cons true (L)))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (R))))), .C⟩ := by
  have hn : 6 = 6 := by omega
  have h0 : steps 6 ⟨cons false (cons false (cons false (cons true (L)))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (R))))), .C⟩ := rfl
  exact steps_congr trans hn (h0)

/-- Cascade with m = 4 blank cells: F on the 1, the pass goes on into L (8 steps), for every L and R. -/
theorem cascade4 (L R : Tape) :
    steps (8) ⟨cons false (cons false (cons false (cons false (cons false (cons true (L)))))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (cons true (cons true (R))))))), .F⟩ := by
  have hn : 8 = 8 := by omega
  have h0 : steps 8 ⟨cons false (cons false (cons false (cons false (cons false (cons true (L)))))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (cons true (cons true (R))))))), .F⟩ := rfl
  exact steps_congr trans hn (h0)

/-- Cascade with m = 5 blank cells: A on the 1, the pass goes on into L (9 steps), for every L and R. -/
theorem cascade5 (L R : Tape) :
    steps (9) ⟨cons false (cons false (cons false (cons false (cons false (cons false (cons true (L))))))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (R)))))))), .A⟩ := by
  have hn : 9 = 9 := by omega
  have h0 : steps 9 ⟨cons false (cons false (cons false (cons false (cons false (cons false (cons true (L))))))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (R)))))))), .A⟩ := rfl
  exact steps_congr trans hn (h0)

/-- Cascade with m = 6 blank cells: a wall visit 7 cells to the left with the word Y Y Y R, whatever L is (m >= 6) (7 steps), for every L and R. -/
theorem cascade6 (L R : Tape) :
    steps (8) ⟨cons false (cons false (cons false (cons false (cons false (cons false (cons false (L))))))), cons true (R), .F⟩ = some ⟨cons false (L), cons false (cons true (cons true (cons true (cons true (cons true (cons true (R))))))), .F⟩ := by
  have hn : 8 = 8 := by omega
  have h0 : steps 8 ⟨cons false (cons false (cons false (cons false (cons false (cons false (cons false (L))))))), cons true (R), .F⟩ = some ⟨cons false (L), cons false (cons true (cons true (cons true (cons true (cons true (cons true (R))))))), .F⟩ := rfl
  exact steps_congr trans hn (h0)

/-- Cascade with m = 3 blank cells: 7 steps to E on a 1, for every L and R. -/
theorem cascade3_run (L R : Tape) :
    steps (7) ⟨cons false (cons false (cons false (cons false (cons true (L))))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (cons true (R)))))), .E⟩ := by
  have hn : 7 = 7 := by omega
  have h0 : steps 7 ⟨cons false (cons false (cons false (cons false (cons true (L))))), cons true (R), .F⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons true (cons true (R)))))), .E⟩ := rfl
  exact steps_congr trans hn (h0)

/-- The cascade with m = 3 blank cells halts the machine, for every tape L and R: a pass of the head that reads `1 0 0 0 0 F> 1` stops it. -/
theorem cascade3_halts (L R : Tape) : ∃ c, steps (7) ⟨cons false (cons false (cons false (cons false (cons true (L))))), cons true (R), .F⟩ = some c ∧ step c = none :=
  ⟨_, cascade3_run L R, rfl⟩
end H34090
