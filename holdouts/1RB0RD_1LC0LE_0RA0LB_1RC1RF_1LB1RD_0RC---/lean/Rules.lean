  have c3 : ∀ L R : Tape, steps 9 ⟨app [true, false, false] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [true, false, false] R), .B⟩ := fun _ _ => rfl
  have h3 : steps ((j + 3) * 9) ⟨rep (j + 3) [true, false, false] (cons false (rep (m) [true, false, false] (cons true (cons true (L))))), cons false (cons true (cons false (cons true (cons false (cons false (rep (k + 1) [true, false, true] (cons true (cons false (cons true (blank)))))))))), .B⟩ = some ⟨cons false (rep (m) [true, false, false] (cons true (cons true (L)))), cons false (rep (j + 3) [true, false, false] (cons true (cons false (cons true (cons false (cons false (rep (k + 1) [true, false, true] (cons true (cons false (cons true (blank))))))))))), .B⟩ :=
