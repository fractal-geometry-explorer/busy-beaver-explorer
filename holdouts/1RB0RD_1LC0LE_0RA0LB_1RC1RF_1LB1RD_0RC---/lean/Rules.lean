import Machine

/-! # 1RB0RD_1LC0LE_0RA0LB_1RC1RF_1LB1RD_0RC---: proved rules

Shift rules (the head crossing a run of copies of a word in one go) found in the run and proved for every count and every tape around them by `tools/py/bbtools/symtm.py` (the folder's `py/rules.py` rewrites this file). -/

namespace H21160

open TM

/-- Shift rule: in state C the head crosses n copies of 001 leftward, 9 steps per copy, leaving 100 behind (the word 0101 next to the head travels along). -/
theorem shift_l_C_001 (n : Nat) (L R : Tape) :
    steps (9 * n) ⟨rep (n) [true, false, false] (L), cons false (cons true (cons false (cons true (R)))), .C⟩ = some ⟨L, cons false (cons true (cons false (cons true (rep (n) [true, false, false] (R))))), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 9 ⟨app [true, false, false] L, app [false, true, false, true] R, .C⟩ = some ⟨L, app [false, true, false, true] (app [true, false, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 9) ⟨rep (n) [true, false, false] (L), cons false (cons true (cons false (cons true (R)))), .C⟩ = some ⟨L, cons false (cons true (cons false (cons true (rep (n) [true, false, false] (R))))), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 9) (by omega) (h0)

/-- One bounce of the growing tail (phase P1): from the right end in A, the head runs left to the wall 1 1 and back; three copies of 001 move from the right part to the left part, and the right part gains one 110. The end configuration is the start with m+3, j-3, k+1 (re-bracketed). -/
theorem bounce_tail (j k m : Nat) (L : Tape) :
    steps (36 * j + 24 * k + 151) ⟨cons false (cons true (cons true (rep (k + 1) [false, true, true] (cons false (rep (j + 4) [true, false, false] (cons false (rep (m) [true, false, false] (cons true (cons true (L)))))))))), blank, .A⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, true, true] (cons false (rep (j + 1) [true, false, false] (cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons false (rep (m) [true, false, false] (cons true (cons true (L)))))))))))))))))))))), blank, .A⟩ := by
  have hn : 5 + ((k + 1) * 15 + (4 + ((j + 3) * 9 + (5 + (0 + ((j + 2) * 3 + ((j + 2) * 9 + (11 + (0 + ((j + 2) * 3 + (4 + ((j + 2) * 9 + (5 + (0 + ((j + 1) * 3 + (2 + (0 + ((k + 1) * 9 + (13))))))))))))))))))) = 36 * j + 24 * k + 151 := by omega
  have h0 : steps 5 ⟨cons false (cons true (cons true (rep (k + 1) [false, true, true] (cons false (rep (j + 4) [true, false, false] (cons false (rep (m) [true, false, false] (cons true (cons true (L)))))))))), blank, .A⟩ = some ⟨rep (k + 1) [false, true, true] (cons false (rep (j + 4) [true, false, false] (cons false (rep (m) [true, false, false] (cons true (cons true (L))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 15 ⟨app [false, true, true] L, app [true, false] R, .B⟩ = some ⟨L, app [true, false] (app [true, false, true] R), .B⟩ := fun _ _ => rfl
  have h1 : steps ((k + 1) * 15) ⟨rep (k + 1) [false, true, true] (cons false (rep (j + 4) [true, false, false] (cons false (rep (m) [true, false, false] (cons true (cons true (L))))))), cons true (cons false (cons true (cons false (cons true (blank))))), .B⟩ = some ⟨cons false (rep (j + 4) [true, false, false] (cons false (rep (m) [true, false, false] (cons true (cons true (L)))))), cons true (cons false (rep (k + 1) [true, false, true] (cons true (cons false (cons true (blank)))))), .B⟩ :=
    cross_l trans c1 (k + 1) (cons false (rep (j + 4) [true, false, false] (cons false (rep (m) [true, false, false] (cons true (cons true (L))))))) (cons true (cons false (cons true (blank))))
