/-- The first bounce of phase P1, when the right part has no 011 yet: one 001 moves left and the first 011 appears. -/
theorem bounce_z0 (x y : Nat) (L : Tape) :
    steps (12 * y + 35) ⟨cons false (rep (y + 2) [true, false, false] (cons false (rep (x) [true, false, false] (cons true (cons true (L)))))), blank, .A⟩ = some ⟨cons false (cons true (cons true (cons false (rep (y + 1) [true, false, false] (cons false (cons true (cons false (cons false (rep (x) [true, false, false] (cons true (cons true (L)))))))))))), blank, .A⟩ := by
  have hn : 3 + ((y + 2) * 9 + (5 + (0 + ((y + 1) * 3 + (6))))) = 12 * y + 35 := by omega
  have h0 : steps 3 ⟨cons false (rep (y + 2) [true, false, false] (cons false (rep (x) [true, false, false] (cons true (cons true (L)))))), blank, .A⟩ = some ⟨rep (y + 2) [true, false, false] (cons false (rep (x) [true, false, false] (cons true (cons true (L))))), cons false (cons false (cons true (blank))), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 9 ⟨app [true, false, false] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [true, false, false] R), .B⟩ := fun _ _ => rfl
  have h1 : steps ((y + 2) * 9) ⟨rep (y + 2) [true, false, false] (cons false (rep (x) [true, false, false] (cons true (cons true (L))))), cons false (cons false (cons true (blank))), .B⟩ = some ⟨cons false (rep (x) [true, false, false] (cons true (cons true (L)))), cons false (rep (y + 2) [true, false, false] (cons false (cons true (blank)))), .B⟩ :=
    cross_l trans c1 (y + 2) (cons false (rep (x) [true, false, false] (cons true (cons true (L))))) (cons false (cons true (blank)))
  have h2 : steps 5 ⟨cons false (rep (x) [true, false, false] (cons true (cons true (L)))), cons false (rep (y + 2) [true, false, false] (cons false (cons true (blank)))), .B⟩ = some ⟨cons false (cons true (cons false (cons false (rep (x) [true, false, false] (cons true (cons true (L))))))), cons false (rep (y + 1) [true, false, false] (cons false (cons true (blank)))), .C⟩ := rfl
