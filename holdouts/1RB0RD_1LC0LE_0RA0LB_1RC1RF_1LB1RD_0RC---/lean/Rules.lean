  have h5 : steps 0 ⟨cons false (cons true (cons false (cons false (rep (m) [true, false, false] (cons true (cons true (L))))))), cons false (rep (j + 2) [true, false, false] (cons true (cons false (cons true (cons false (cons false (rep (k + 1) [true, false, true] (cons true (cons false (cons true (blank))))))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons false (rep (m) [true, false, false] (cons true (cons true (L))))))), rep (j + 2) [false, true, false] (cons false (cons true (cons false (cons true (cons false (cons false (rep (k + 1) [true, false, true] (cons true (cons false (cons true (blank))))))))))), .C⟩ := by
