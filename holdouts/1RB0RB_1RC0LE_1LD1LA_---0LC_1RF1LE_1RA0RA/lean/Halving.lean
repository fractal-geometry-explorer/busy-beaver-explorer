import HalvingRules
import Rules
import TM.Fin

/-! # The halving at the left wall of 1RB0RB_1RC0LE_1LD1LA_---0LC_1RF1LE_1RA0RA

The wall configuration `W x R` is `0^inf E> 0 1^x 0 0 1 0 R`: the head in E on the blank cell left of the leftmost
block of x ones. The run from blank tape reaches `W 1 blank` after 8 steps (`blank_to_W1`) and keeps coming back to
wall configurations.

* `halve_W`: for k ≥ 2, `W (2k) R` reaches `W k (1^k 0 R)`: the block is cut into two halves.
* `W_two_halts`: `W 2 R` halts (D reads 0 eight steps later, bbchallenge count).
* `W_pow_halts`: so `W (2^j) R` halts for every j ≥ 1 and every tape R.
* `W_chain`: `W (2^j q) R` reaches `W q R'` for every q ≥ 2, so a chain of halvings from 2^j·q with q odd and
  q ≥ 3 ends at q without halting.

What the machine does from `W q R` with q odd (a long sweep to the right that redistributes the blocks and comes
back to a new wall configuration) is not proved here; see the README.

The pieces `half_round` and `half_four` are generated by `py/rules.py` (`HalvingRules.lean`); the induction over the
rounds and the corollaries are by hand. -/

namespace H25221

open TM

/-- The wall configuration `0^inf E> 0 1^x 0 0 1 0 R`. -/
def W (x : Nat) (R : Tape) : Config :=
  ⟨blank, cons false (rep x [true] (cons false (cons false (cons true (cons false R))))), .E⟩

theorem ones_cons (n : Nat) (s : Tape) : rep n [true] (cons true s) = rep (n + 1) [true] s :=
  rep_app_comm n [true] s

theorem pairs_ones (m : Nat) (s : Tape) : rep m [true, true] s = rep (2 * m) [true] s := by
  induction m with
  | zero => rfl
  | succ m ih =>
    have e : 2 * (m + 1) = 2 * m + 1 + 1 := by omega
    rw [e, rep_succ, ih]; rfl

/-- `half_round` with the blocks written as runs of ones: `L 1^j E> 0 1^(2m+6) 0 0 R` reaches
`L 1^(j+1) E> 0 1^(2m+4) 0 0 1 R`. -/
theorem round_ones (j m : Nat) (L R : Tape) :
    steps (6 * m + 27) ⟨rep j [true] L, cons false (rep (2 * m + 6) [true] (cons false (cons false R))), .E⟩ =
      some ⟨rep (j + 1) [true] L, cons false (rep (2 * m + 4) [true] (cons false (cons false (cons true R)))), .E⟩ := by
  have h := half_round j m L R
  have e1 : rep (m + 3) [true, true] (cons false (cons false R)) = rep (2 * m + 6) [true] (cons false (cons false R)) := by
    rw [pairs_ones]; congr 1
  have e2 : cons true (rep m [true, true] (cons true (cons true (cons true (cons false (cons false (cons true R)))))))
      = rep (2 * m + 4) [true] (cons false (cons false (cons true R))) := by
    rw [pairs_ones, ones_cons, ones_cons, ones_cons]; rfl
  rw [e1, e2] at h
  exact h

/-- r rounds: `L 1^j E> 0 1^(2(m+r)+4) 0 0 1^p R` reaches `L 1^(j+r) E> 0 1^(2m+4) 0 0 1^(p+r) R`. -/
theorem rounds (r : Nat) : ∀ (j m p : Nat) (L R : Tape),
    ∃ t, steps t ⟨rep j [true] L, cons false (rep (2 * (m + r) + 4) [true] (cons false (cons false (rep p [true] R)))), .E⟩ =
      some ⟨rep (j + r) [true] L, cons false (rep (2 * m + 4) [true] (cons false (cons false (rep (p + r) [true] R)))), .E⟩ := by
  induction r with
  | zero => intro j m p L R; exact ⟨0, rfl⟩
  | succ r ih =>
    intro j m p L R
    have h1 := round_ones j (m + r) L (rep p [true] R)
    have e1 : 2 * (m + (r + 1)) + 4 = 2 * (m + r) + 6 := by omega
    have e2 : 2 * (m + r) + 4 = 2 * (m + r) + 4 := rfl
    obtain ⟨t, h2⟩ := ih (j + 1) m (p + 1) L R
    have e3 : j + 1 + r = j + (r + 1) := by omega
    have e4 : p + 1 + r = p + (r + 1) := by omega
    rw [e3, e4] at h2
    rw [e1]
    exact ⟨_, steps_seq trans h1 h2⟩

/-- E moves off the left end of the ones onto blank tape. -/
theorem e_off (X : Tape) : steps 1 ⟨blank, cons true X, .E⟩ = some ⟨blank, cons false (cons true X), .E⟩ := rfl

/-- **The halving.** `0^inf E> 0 1^(2k+4) 0 0 1^p R` reaches `0^inf E> 0 1^(k+2) 0 0 1 0 1^(p+k+1) R`. -/
theorem halve (k p : Nat) (R : Tape) :
    ∃ t, steps t ⟨blank, cons false (rep (2 * k + 4) [true] (cons false (cons false (rep p [true] R)))), .E⟩ =
      some ⟨blank, cons false (rep (k + 2) [true] (cons false (cons false (cons true (cons false
        (rep (p + k + 1) [true] R)))))), .E⟩ := by
  obtain ⟨t1, h1⟩ := rounds k 0 0 p blank R
  have e0 : 2 * (0 + k) + 4 = 2 * k + 4 := by omega
  rw [e0] at h1
  have h2 := half_four (0 + k) blank (rep (p + k) [true] R)
  have h3 := e_off (rep (0 + k) [true] (cons true (cons false (cons false (cons true (cons false (cons true
    (rep (p + k) [true] R))))))))
  have h := steps_seq trans h1 (steps_seq trans h2 h3)
  have e1 : rep (0 + k) [true] (cons true (cons false (cons false (cons true (cons false (cons true
      (rep (p + k) [true] R)))))))
      = rep (k + 1) [true] (cons false (cons false (cons true (cons false (rep (p + k + 1) [true] R))))) := by
    rw [ones_cons, Nat.zero_add]; rfl
  rw [e1] at h
  exact ⟨_, h⟩

/-- **The halving at the wall.** For k ≥ 2, `W (2k) R` reaches `W k (1^k 0 R)`. -/
theorem halve_W (k : Nat) (hk : 2 ≤ k) (R : Tape) :
    ∃ t, steps t (W (2 * k) R) = some (W k (rep k [true] (cons false R))) := by
  obtain ⟨k, rfl⟩ : ∃ k', k = k' + 2 := ⟨k - 2, by omega⟩
  obtain ⟨t, h⟩ := halve k 1 (cons false R)
  have e : 2 * (k + 2) = 2 * k + 4 := by omega
  unfold W
  rw [e]
  have e2 : 1 + k + 1 = k + 2 := by omega
  rw [e2] at h
  exact ⟨t, h⟩

theorem halts_of_steps {t : Nat} {c c' : Config} (h : steps t c = some c') (h' : Halts trans c') : Halts trans c := by
  obtain ⟨n, d, h1, h2⟩ := h'
  exact ⟨t + n, d, steps_seq trans h h1, h2⟩

/-- A block of two at the wall halts (`two_to_halt`, `two_stuck`). -/
theorem W_two_halts (R : Tape) : Halts trans (W 2 R) :=
  ⟨7, _, two_to_halt blank R, two_stuck blank R⟩

/-- **A halving chain from a power of two halts**: `W (2^j) R` halts for every j ≥ 1 and every tape R. -/
theorem W_pow_halts (j : Nat) (hj : 1 ≤ j) : ∀ R : Tape, Halts trans (W (2 ^ j) R) := by
  induction j with
  | zero => omega
  | succ j ih =>
    intro R
    rcases Nat.eq_zero_or_pos j with h0 | hpos
    · subst h0; exact W_two_halts R
    · have hk : 2 ≤ 2 ^ j := by
        have := Nat.pow_le_pow_right (show 0 < 2 by omega) hpos
        simpa using this
      obtain ⟨t, h⟩ := halve_W (2 ^ j) hk R
      have e : 2 ^ (j + 1) = 2 * 2 ^ j := by rw [Nat.pow_succ, Nat.mul_comm]
      rw [e]
      exact halts_of_steps h (ih hpos _)

/-- **A halving chain from 2^j·q, q ≥ 2, reaches q**: `W (2^j q) R` reaches some `W q R'`. -/
theorem W_chain (q : Nat) (hq : 2 ≤ q) (j : Nat) :
    ∀ R : Tape, ∃ t R', steps t (W (2 ^ j * q) R) = some (W q R') := by
  induction j with
  | zero => intro R; exact ⟨0, R, by simp⟩
  | succ j ih =>
    intro R
    have hk : 2 ≤ 2 ^ j * q := by
      have : 1 ≤ 2 ^ j := Nat.one_le_two_pow
      calc 2 ≤ 1 * q := by omega
        _ ≤ 2 ^ j * q := Nat.mul_le_mul_right q this
    obtain ⟨t1, h1⟩ := halve_W (2 ^ j * q) hk R
    obtain ⟨t2, R', h2⟩ := ih (rep (2 ^ j * q) [true] (cons false R))
    have e : 2 ^ (j + 1) * q = 2 * (2 ^ j * q) := by rw [Nat.pow_succ]; ac_rfl
    rw [e]
    exact ⟨_, R', steps_seq trans h1 h2⟩

/-- The run from blank tape reaches the first wall configuration, `W 1 blank`, after 8 steps. -/
theorem blank_to_W1 : steps 8 init = some (W 1 blank) := by
  have h := blank_reaches trans (q := .A) (n := 8) (c := ⟨[], [false, true, false, false, true], .E⟩) (by decide)
  show TM.steps trans 8 (blankCfg St.A) = _
  rw [h]
  unfold W
  rw [cons_false_blank]
  rfl

end H25221
