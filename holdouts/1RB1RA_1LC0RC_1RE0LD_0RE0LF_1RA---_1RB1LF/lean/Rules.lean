/-- W 1 at the left end of the tape: E reads a 1 next (a halt). -/
theorem halt1 (g : Nat) (R : Tape) :
    steps (11) ⟨cons true (blank), cons true (cons true (cons false (rep (g + 2) [true] (cons false (R))))), .C⟩ = some ⟨cons true (cons false (cons true (cons true (cons true (cons false (blank)))))), rep (g + 2) [true] (cons false (R)), .E⟩ := by
  have hn : 11 = 11 := by omega
  have h0 : steps 11 ⟨cons true (blank), cons true (cons true (cons false (rep (g + 2) [true] (cons false (R))))), .C⟩ = some ⟨cons true (cons false (cons true (cons true (cons true (cons false (blank)))))), rep (g + 2) [true] (cons false (R)), .E⟩ := rfl
  exact steps_congr trans hn (h0)


