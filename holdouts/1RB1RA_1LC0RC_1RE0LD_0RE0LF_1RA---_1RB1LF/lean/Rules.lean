  have h0 : steps 9 ⟨cons false (rep (i) [true] (cons false (L))), cons true (cons false (cons false (rep (j) [true] (cons false (R))))), .C⟩ = some ⟨rep (i) [true] (cons false (L)), cons true (cons true (cons false (cons true (rep (j) [true] (cons false (R)))))), .C⟩ := rfl
  exact steps_congr trans hn (h0)


/-- End of the zigzag on an even digit: the wave stops and the head sweeps right in state D. -/
theorem zend0 (g i j : Nat) (L R : Tape) :
    steps (j + 5) ⟨cons false (rep (i) [true] (cons false (L))), cons false (cons false (rep (j) [true] (cons false (rep (g + 2) [true] (cons false (R)))))), .C⟩ = some ⟨cons true (rep (j) [true] (cons true (cons true (cons false (rep (i) [true] (cons false (L))))))), cons false (cons false (rep (g) [true] (cons false (R)))), .D⟩ := by
  have hn : 2 + ((j) * 1 + (3)) = j + 5 := by omega
  have h0 : steps 2 ⟨cons false (rep (i) [true] (cons false (L))), cons false (cons false (rep (j) [true] (cons false (rep (g + 2) [true] (cons false (R)))))), .C⟩ = some ⟨cons true (cons true (cons false (rep (i) [true] (cons false (L))))), rep (j) [true] (cons false (rep (g + 2) [true] (cons false (R)))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 1) ⟨cons true (cons true (cons false (rep (i) [true] (cons false (L))))), rep (j) [true] (cons false (rep (g + 2) [true] (cons false (R)))), .A⟩ = some ⟨rep (j) [true] (cons true (cons true (cons false (rep (i) [true] (cons false (L)))))), cons false (rep (g + 2) [true] (cons false (R))), .A⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 1) ⟨L, rep k [true] (R), .A⟩ = some ⟨rep k [true] (L), R, .A⟩ from cross_r trans c1) (j) (cons true (cons true (cons false (rep (i) [true] (cons false (L)))))) (cons false (rep (g + 2) [true] (cons false (R))))
  have h2 : steps 3 ⟨rep (j) [true] (cons true (cons true (cons false (rep (i) [true] (cons false (L)))))), cons false (rep (g + 2) [true] (cons false (R))), .A⟩ = some ⟨cons true (rep (j) [true] (cons true (cons true (cons false (rep (i) [true] (cons false (L))))))), cons false (cons false (rep (g) [true] (cons false (R)))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- The sweep to the right crosses one digit. -/
theorem dsw (d g : Nat) (L R : Tape) :
    steps (d + 5) ⟨L, cons false (cons false (rep (d) [true] (cons false (rep (g + 2) [true] (cons false (R)))))), .D⟩ = some ⟨cons true (rep (d) [true] (cons true (cons false (L)))), cons false (cons false (rep (g) [true] (cons false (R)))), .D⟩ := by
  have hn : 2 + ((d) * 1 + (3)) = d + 5 := by omega
  have h0 : steps 2 ⟨L, cons false (cons false (rep (d) [true] (cons false (rep (g + 2) [true] (cons false (R)))))), .D⟩ = some ⟨cons true (cons false (L)), rep (d) [true] (cons false (rep (g + 2) [true] (cons false (R)))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((d) * 1) ⟨cons true (cons false (L)), rep (d) [true] (cons false (rep (g + 2) [true] (cons false (R)))), .A⟩ = some ⟨rep (d) [true] (cons true (cons false (L))), cons false (rep (g + 2) [true] (cons false (R))), .A⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 1) ⟨L, rep k [true] (R), .A⟩ = some ⟨rep k [true] (L), R, .A⟩ from cross_r trans c1) (d) (cons true (cons false (L))) (cons false (rep (g + 2) [true] (cons false (R))))
  have h2 : steps 3 ⟨rep (d) [true] (cons true (cons false (L))), cons false (rep (g + 2) [true] (cons false (R))), .A⟩ = some ⟨cons true (rep (d) [true] (cons true (cons false (L)))), cons false (cons false (rep (g) [true] (cons false (R)))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- The sweep reaches the fixed tail: back to S0. -/
theorem dfin (L : Tape) :
    steps (42) ⟨L, cons false (cons false (rep (12) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))))))), .D⟩ = some ⟨cons false (cons true (rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))))))))), rep (1) [true] (blank), .C⟩ := by
  have hn : 2 + ((12) * 1 + (5 + ((5) * 1 + (5 + ((4) * 1 + (5 + ((2) * 1 + (2)))))))) = 42 := by omega
  have h0 : steps 2 ⟨L, cons false (cons false (rep (12) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))))))), .D⟩ = some ⟨cons true (cons false (L)), rep (12) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((12) * 1) ⟨cons true (cons false (L)), rep (12) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))))), .A⟩ = some ⟨rep (12) [true] (cons true (cons false (L))), cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))), .A⟩ :=
    cross_r trans c1 (12) (cons true (cons false (L))) (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))))
  have h2 : steps 5 ⟨rep (12) [true] (cons true (cons false (L))), cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))), .A⟩ = some ⟨cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L)))))), rep (5) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((5) * 1) ⟨cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L)))))), rep (5) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))), .A⟩ = some ⟨rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))), cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))), .A⟩ :=
    cross_r trans c3 (5) (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))) (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))
  have h4 : steps 5 ⟨rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))), cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))), .A⟩ = some ⟨cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L)))))))))), rep (4) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))), .A⟩ := rfl
  have c5 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((4) * 1) ⟨cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L)))))))))), rep (4) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))), .A⟩ = some ⟨rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))), cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))), .A⟩ :=
    cross_r trans c5 (4) (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))) (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))
  have h6 : steps 5 ⟨rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))), cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))), .A⟩ = some ⟨cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L)))))))))))))), rep (2) [true] (cons false (rep (2) [true] (blank))), .A⟩ := rfl
  have c7 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h7 : steps ((2) * 1) ⟨cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L)))))))))))))), rep (2) [true] (cons false (rep (2) [true] (blank))), .A⟩ = some ⟨rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))))))), cons false (rep (2) [true] (blank)), .A⟩ :=
    cross_r trans c7 (2) (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))))))) (cons false (rep (2) [true] (blank)))
  have h8 : steps 2 ⟨rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))))))), cons false (rep (2) [true] (blank)), .A⟩ = some ⟨cons false (cons true (rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (L))))))))))))))))), rep (1) [true] (blank), .C⟩ := rfl
