import Cases

/-! The run-length frame map from blank tape, generated by `bbtools.listframe`; do not edit.

`init_f0`: the run from blank tape reaches the frame `f0` (its first head turn) after 3 steps.  `frames_1000000`:
the frame map is defined for the first 1000000 frames (`native_decide`), so by `rl_reach` the machine runs on through
them.  `no_halt_of_total`: if the frame map is defined forever along this orbit, the machine never halts; that is
the open part. -/

namespace H65208

open TM

def f0 : RLFrame St := (⟨.D, [(true, 1), (false, 1), (true, 1)], []⟩ : RLFrame St)

theorem init_f0 : steps 3 init = some f0.cfg := blank_frame trans (by decide)

theorem frames_1000000 : ∀ j, j ≤ 1000000 → ∃ f, iterF next j f0 = some f :=
  checkF_sound next 1000000 f0 (by native_decide)

theorem no_halt_of_total (h : ∀ k, ∃ f, iterF next k f0 = some f) : ¬ HaltsFromBlank :=
  rl_no_halt trans cases init_f0 h

end H65208
