  have h0 : steps 2 ⟨cons true (cons false (cons false (blank))), cons true (cons false (rep (c + 1) [true, true, true, false] (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R))))))), .A⟩ = some ⟨cons true (cons true (cons true (cons false (cons false (blank))))), rep (c + 1) [true, true, true, false] (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R))))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 6 ⟨app [] L, app [true, true, true, false] R, .A⟩ = some ⟨app [] (app [true, true, true, false] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((c + 1) * 6) ⟨cons true (cons true (cons true (cons false (cons false (blank))))), rep (c + 1) [true, true, true, false] (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R))))), .A⟩ = some ⟨rep (c + 1) [true, true, true, false] (cons true (cons true (cons true (cons false (cons false (blank)))))), cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R)))), .A⟩ :=
    cross_r trans c1 (c + 1) (cons true (cons true (cons true (cons false (cons false (blank)))))) (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R)))))
  have h2 : steps 8 ⟨rep (c + 1) [true, true, true, false] (cons true (cons true (cons true (cons false (cons false (blank)))))), cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R)))), .A⟩ = some ⟨rep (c + 1) [true, true, true, false] (cons true (cons true (cons true (cons false (cons false (blank)))))), cons false (cons true (cons true (cons false (cons true (cons true (cons false (rep (b) [true, true, true, false] (R)))))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, false] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [true, true, false, true] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((c + 1) * 4) ⟨rep (c + 1) [true, true, true, false] (cons true (cons true (cons true (cons false (cons false (blank)))))), cons false (cons true (cons true (cons false (cons true (cons true (cons false (rep (b) [true, true, true, false] (R)))))))), .E⟩ = some ⟨cons true (cons true (cons true (cons false (cons false (blank))))), cons false (rep (c + 1) [true, true, false, true] (cons true (cons true (cons false (cons true (cons true (cons false (rep (b) [true, true, true, false] (R))))))))), .E⟩ :=
    cross_l trans c3 (c + 1) (cons true (cons true (cons true (cons false (cons false (blank)))))) (cons true (cons true (cons false (cons true (cons true (cons false (rep (b) [true, true, true, false] (R))))))))
  have h4 : steps 15 ⟨cons true (cons true (cons true (cons false (cons false (blank))))), cons false (rep (c + 1) [true, true, false, true] (cons true (cons true (cons false (cons true (cons true (cons false (rep (b) [true, true, true, false] (R))))))))), .E⟩ = some ⟨cons true (cons false (cons false (blank))), cons true (cons true (cons false (cons true (rep (c + 1) [true, true, false, true] (cons true (cons true (cons false (cons true (cons true (cons false (rep (b) [true, true, true, false] (R)))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The left end emits a new runner (the old one rests from now on). Blocks: `3 D^(c+1) 2 D^(b+1)` ⟶ `4 2 D^c 2 D^(b+1)`. `0^inf 0 0 1 A> 110 (1110)^c+1 110 (1110)^b+1 R` ⟶ `0^inf 0 0 1 A> 1 1 1 0 1 1 0 (1110)^c 1 1 0 (1110)^b+1 R`. -/
theorem gadget_emit (b c : Nat) (R : Tape) :
    steps (14) ⟨cons true (cons false (cons false (blank))), cons true (cons true (cons false (rep (c + 1) [true, true, true, false] (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R)))))))), .A⟩ = some ⟨cons true (cons false (cons false (blank))), cons true (cons true (cons true (cons false (cons true (cons true (cons false (rep (c) [true, true, true, false] (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R)))))))))))), .A⟩ := by
  have hn : 14 = 14 := by omega
  have h0 : steps 14 ⟨cons true (cons false (cons false (blank))), cons true (cons true (cons false (rep (c + 1) [true, true, true, false] (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R)))))))), .A⟩ = some ⟨cons true (cons false (cons false (blank))), cons true (cons true (cons true (cons false (cons true (cons true (cons false (rep (c) [true, true, true, false] (cons true (cons true (cons false (rep (b + 1) [true, true, true, false] (R)))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (h0)

