import StackRules

/-!
# The step of the machine on a stack of counters

`StackRules.lean` (generated by `py/stack.py`) has the rules for one item, each for any tape below the item and
any context above it; here they are put together by induction on the stack.

`res ws s n` is the answer of the wall `ws` (top item first) to a signal: `s = false` (N even) arriving as
`QQ (wtl ws) n c`, `s = true` (N odd) arriving as `CALL (wt ws) 0 n c`.  It returns the new wall, the new block
count `M` and the number `u` of copies used up from the block of the context; the machine then reaches
`START (wt ws') M c'` with `c' = c.sub u` (`res_ok`), in every context `c`: the top of the stack, or under an item
whose block has at least `u` copies left.  The cases (`b = 110`):

* bottom `1`: even: nothing changes (`close0`); odd: a new open counter `K(0)` (`b0`);
* open `K(k)`: even: closed (`close`); odd: its block becomes the left block of the transfer loop one level down
  (`o0`, `k0`), the parity of `k` goes down, and the answer of the level below becomes the new count (`reb`);
* closed `K'(j)`, `j ≥ 1`: its block becomes the left block of a junction on the wall below (`cq`, `c1T`/`c1D`, `k1T`/`k1D`),
  so the parity of `j` (plus the signal) goes down and the counter is dissolved into the block;
* closed `K'(0)`: even: two copies more and the signal goes on down (`q0c`); odd: only when everything below is
  `1 K'(0)^a` (`p0`: a new `K(0)` on top).  In the other odd case the run of 1s merges with the item below
  and `res` answers `none`.

`res` also answers `none` when a count would go below zero.

`stepRes` is the whole step (`part1`, the transfer loop `sweeps_cx`, then the wall): `S W N` reaches `S W' N'`
(`step_stack`).  `mstep`/`mstepN` are `step`/`stepN` of `py/stackmodel.py` written in Lean, and `step_model`
proves that `stepRes` agrees with them whenever it answers: the fitted model is a theorem on those steps
(`stack_step` has both).
-/

namespace H3292

open TM

/-! ## Sweeps, in any context -/

theorem sweep_cx (W : Tape) (x y : Nat) (c c' : Cx) (h : c.sub 1 = some c') :
    Reach (CALL W (x + 2) y c) (CALL W x (y + 3) c') := by
  cases c with
  | top => cases h; exact Reach.of (sweepT W x y)
  | deep m c =>
    simp only [Cx.sub] at h
    split at h
    · next hm =>
      cases h
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
      rw [show m' + 1 - 1 = m' by omega]
      exact Reach.of (sweepD W x y m' c)
    · cases h

theorem sweeps_cx (W : Tape) (x : Nat) : ∀ (t y : Nat) (c c' : Cx), c.sub t = some c' →
    Reach (CALL W (x + 2 * t) y c) (CALL W x (y + 3 * t) c')
  | 0, y, c, c', h => by rw [Cx.sub_zero] at h; cases h; exact Reach.refl _
  | t + 1, y, c, c', h => by
    obtain ⟨c1, h1, h2⟩ := Cx.sub_add c 1 t (by rw [Nat.add_comm]; exact h)
    have a := sweep_cx W (x + 2 * t) y c c1 h1
    rw [show x + 2 * t + 2 = x + 2 * (t + 1) by omega] at a
    have b := sweeps_cx W x t (y + 3) c1 c' h2
    rw [show y + 3 + 3 * t = y + 3 * (t + 1) by omega] at b
    exact a.trans b

theorem q1_cx (L : Tape) (y : Nat) (c c' : Cx) (h : c.sub 1 = some c') :
    Reach (CALL (cons true L) 1 (y + 1) c) (QQ L (y + 5) c') := by
  cases c with
  | top => cases h; exact Reach.of (q1T L y)
  | deep m c =>
    simp only [Cx.sub] at h
    split at h
    · next hm =>
      cases h
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
      rw [show m' + 1 - 1 = m' by omega]
      exact Reach.of (q1D L y m' c)
    · cases h

theorem c1_cx (W : Tape) (j n : Nat) (c c' : Cx) (h : c.sub 2 = some c') :
    Reach (CALL (itT (.c (j + 2)) W) 0 n c) (CALL W j (n + 6) c') := by
  cases c with
  | top => cases h; exact Reach.of (c1T W j n)
  | deep m c =>
    simp only [Cx.sub] at h
    split at h
    · next hm =>
      cases h
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 2 := ⟨m - 2, by omega⟩
      rw [show m' + 2 - 2 = m' by omega]
      exact Reach.of (c1D W j n m' c)
    · cases h

theorem k1_cx (L : Tape) (y : Nat) (c c' : Cx) (h : c.sub 2 = some c') :
    Reach (CALL (itT (.c 1) (cons true L)) 0 y c) (QQ L (y + 7) c') := by
  cases c with
  | top => cases h; exact Reach.of (k1T L y)
  | deep m c =>
    simp only [Cx.sub] at h
    split at h
    · next hm =>
      cases h
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 2 := ⟨m - 2, by omega⟩
      rw [show m' + 2 - 2 = m' by omega]
      exact Reach.of (k1D L y m' c)
    · cases h

/-! ## The answer of a wall -/

/-- Where a signal arrives: even (`false`) as `QQ`, odd (`true`) as `CALL _ 0`. -/
def IN (ws : List It) : Bool → Nat → Cx → Config
  | false, n, c => QQ (wtl ws) n c
  | true, n, c => CALL (wt ws) 0 n c

abbrev Res := List It × Nat × Nat

/-- After the junction `CALL (wt ws) x y c`: the transfer loop leaves `x mod 2` copies, and the signal goes to
`ws` (`f` is the answer of `ws`). -/
def goX (f : Bool → Nat → Option Res) (x y : Nat) : Option Res :=
  if x % 2 = 0 then
    (f true (y + 3 * (x / 2))).map fun r => (r.1, r.2.1, x / 2 + r.2.2)
  else if 1 ≤ y + 3 * (x / 2) then
    (f false (y + 3 * (x / 2) + 4)).map fun r => (r.1, r.2.1, x / 2 + (1 + r.2.2))
  else none

/-- The answer from below comes back under an open counter: its block becomes the new count. -/
def rebR (y : Nat) : Option Res → Option Res
  | some (ws', M, u) => if 1 ≤ M ∧ u + 1 ≤ y then some (.o (M - 1) :: ws', y - u, 0) else none
  | none => none

/-- All items are closed empty counters `K'(0)`. -/
def allC0 : List It → Bool
  | [] => true
  | .c 0 :: ws => allC0 ws
  | _ :: _ => false

theorem wt_allC0 : ∀ ws : List It, allC0 ws = true → wt ws = rep ws.length [true, true, true, true, true, true] (cons true blank)
  | [], _ => rfl
  | .c 0 :: ws, h => by
    have ih := wt_allC0 ws h
    show app _ (wt ws) = _
    rw [ih]; rfl
  | .c (_ + 1) :: _, h => by simp [allC0] at h
  | .o _ :: _, h => by simp [allC0] at h

/-- The answer of the wall `ws` to a signal `s` (`false` even, `true` odd) with `n` copies in the block. -/
def res : List It → Bool → Nat → Option Res
  | [], false, n => some ([], n, 0)
  | [], true, n => if 1 ≤ n then some ([.o 0], n, 0) else none
  | .o k :: ws, false, n => some (.c k :: ws, n, 0)
  | .o 0 :: ws, true, y => rebR y (res ws false 3)
  | .o (k + 1) :: ws, true, y => rebR y (goX (res ws) k 2)
  | .c 0 :: ws, false, n => res ws false (n + 2)
  | .c 0 :: ws, true, n => if allC0 ws = true ∧ 1 ≤ n then some (.o 0 :: .c 0 :: ws, n, 0) else none
  | .c (j + 1) :: ws, false, n => goX (res ws) j (n + 1)
  | .c 1 :: ws, true, n => (res ws false (n + 7)).map fun r => (r.1, r.2.1, 2 + r.2.2)
  | .c (j + 2) :: ws, true, n => (goX (res ws) j (n + 6)).map fun r => (r.1, r.2.1, 2 + r.2.2)

/-- What `res` claims, for one wall. -/
def ResOK (ws : List It) (f : Bool → Nat → Option Res) : Prop :=
  ∀ s n r, f s n = some r → ∀ c c', c.sub r.2.2 = some c' → Reach (IN ws s n c) (START (wt r.1) r.2.1 c')

theorem goX_ok (ws : List It) (f : Bool → Nat → Option Res) (hf : ResOK ws f) (x y : Nat) (r : Res)
    (h : goX f x y = some r) (c c' : Cx) (hc : c.sub r.2.2 = some c') :
    Reach (CALL (wt ws) x y c) (START (wt r.1) r.2.1 c') := by
  unfold goX at h
  split at h
  · next hx =>
    cases e : f true (y + 3 * (x / 2)) with
    | none => rw [e] at h; cases h
    | some r0 =>
      rw [e] at h; cases h
      obtain ⟨c1, h1, h2⟩ := Cx.sub_add c (x / 2) r0.2.2 hc
      have a := sweeps_cx (wt ws) 0 (x / 2) y c c1 h1
      rw [show 0 + 2 * (x / 2) = x by omega] at a
      exact a.trans (hf true _ r0 e c1 c' h2)
  · split at h
    · next hx hy =>
      cases e : f false (y + 3 * (x / 2) + 4) with
      | none => rw [e] at h; cases h
      | some r0 =>
        rw [e] at h; cases h
        obtain ⟨c1, h1, h2⟩ := Cx.sub_add c (x / 2) (1 + r0.2.2) hc
        obtain ⟨c2, h3, h4⟩ := Cx.sub_add c1 1 r0.2.2 h2
        have a := sweeps_cx (wt ws) 1 (x / 2) y c c1 h1
        rw [show 1 + 2 * (x / 2) = x by omega] at a
        obtain ⟨y', hy'⟩ : ∃ y', y + 3 * (x / 2) = y' + 1 := ⟨y + 3 * (x / 2) - 1, by omega⟩
        rw [hy'] at a
        have b := q1_cx (wtl ws) y' c1 c2 h3
        rw [← wt_eq] at b
        rw [show y' + 5 = y + 3 * (x / 2) + 4 by omega] at b
        exact a.trans (b.trans (hf false _ r0 e c2 c' h4))
    · cases h

theorem rebR_ok (E : Cx → Config) (o : Option Res)
    (ho : ∀ r0, o = some r0 → ∀ c1 c1', c1.sub r0.2.2 = some c1' → Reach (E c1) (START (wt r0.1) r0.2.1 c1'))
    (y : Nat) (r : Res) (h : rebR y o = some r) (c c' : Cx) (hc : c.sub r.2.2 = some c') :
    Reach (E (.deep y c)) (START (wt r.1) r.2.1 c') := by
  cases o with
  | none => cases h
  | some r0 =>
    obtain ⟨ws', M, u⟩ := r0
    simp only [rebR] at h
    split at h
    · next hM =>
      simp only [Option.some.injEq] at h; subst h
      rw [Cx.sub_zero] at hc; cases hc
      have hs : (Cx.deep y c).sub u = some (.deep (y - u) c) := by
        simp [Cx.sub, show u ≤ y by omega]
      have b := ho _ rfl _ _ hs
      obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
      obtain ⟨m', hm'⟩ : ∃ m', y - u = m' + 1 := ⟨y - u - 1, by omega⟩
      rw [hm'] at b
      have d := Reach.of (reb (wt ws') M' m' c)
      simp only [Nat.add_sub_cancel]
      rw [hm']
      exact b.trans d
    · cases h

theorem res_ok (ws : List It) : ResOK ws (res ws) := by
  induction ws with
  | nil =>
    intro s n r h c c' hc
    cases s with
    | false =>
      simp only [res, Option.some.injEq] at h; subst h
      rw [Cx.sub_zero] at hc; cases hc
      exact Reach.of (close0 n c)
    | true =>
      simp only [res] at h
      split at h
      · next hn =>
        simp only [Option.some.injEq] at h; subst h
        rw [Cx.sub_zero] at hc; cases hc
        obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
        exact Reach.of (b0 n' c)
      · cases h
  | cons x ws ih =>
    intro s n r h c c' hc
    cases x with
    | o k =>
      cases s with
      | false =>
        simp only [res, Option.some.injEq] at h; subst h
        rw [Cx.sub_zero] at hc; cases hc
        exact Reach.of (close _ n c)
      | true =>
        cases k with
        | zero =>
          have a := Reach.of (k0 (wtl ws) n c)
          rw [← wt_eq] at a
          exact a.trans (rebR_ok (fun c1 => QQ (wtl ws) 3 c1) _ (fun r0 e c1 c1' h1 => ih false 3 r0 e c1 c1' h1)
            n r h c c' hc)
        | succ k =>
          exact (Reach.of (o0 (wt ws) k n c)).trans
            (rebR_ok (fun c1 => CALL (wt ws) k 2 c1) _ (fun r0 e c1 c1' h1 => goX_ok ws _ ih k 2 r0 e c1 c1' h1)
              n r h c c' hc)
    | c j =>
      cases j with
      | zero =>
        cases s with
        | false =>
          have a := Reach.of (q0c (wtl ws) n c)
          rw [← wt_eq] at a
          exact a.trans (ih false (n + 2) r h c c' hc)
        | true =>
          simp only [res] at h
          split at h
          · next hw =>
            simp only [Option.some.injEq] at h; subst h
            rw [Cx.sub_zero] at hc; cases hc
            obtain ⟨y, rfl⟩ : ∃ y, n = y + 1 := ⟨n - 1, by omega⟩
            have e : wt (.c 0 :: ws) = rep (ws.length + 1) [true, true, true, true, true, true] (cons true blank) :=
              wt_allC0 (.c 0 :: ws) hw.1
            have a := Reach.of (p0 ws.length y c)
            rw [← e] at a
            exact a
          · cases h
      | succ j =>
        cases s with
        | false =>
          exact (Reach.of (cq (wt ws) j n c)).trans (goX_ok ws _ ih j (n + 1) r h c c' hc)
        | true =>
          cases j with
          | zero =>
            simp only [res] at h
            cases e : res ws false (n + 7) with
            | none => rw [e] at h; cases h
            | some r0 =>
              rw [e] at h; simp only [Option.map_some, Option.some.injEq] at h; subst h
              obtain ⟨c1, h1, h2⟩ := Cx.sub_add c 2 r0.2.2 hc
              have a := k1_cx (wtl ws) n c c1 h1
              rw [← wt_eq] at a
              exact a.trans (ih false (n + 7) r0 e c1 c' h2)
          | succ j =>
            simp only [res] at h
            cases e : goX (res ws) j (n + 6) with
            | none => rw [e] at h; cases h
            | some r0 =>
              rw [e] at h; simp only [Option.map_some, Option.some.injEq] at h; subst h
              obtain ⟨c1, h1, h2⟩ := Cx.sub_add c 2 r0.2.2 hc
              exact (c1_cx (wt ws) j n c c1 h1).trans (goX_ok ws _ ih j (n + 6) r0 e c1 c' h2)

/-! ## The whole step -/

/-- The step from `S W N`: the junction `CALL W (N - 5) 12` is built, and the transfer loop sends the parity of
`N` into the wall. -/
def stepRes (ws : List It) (N : Nat) : Option (List It × Nat) :=
  if 5 ≤ N then (goX (res ws) (N - 5) 12).map fun r => (r.1, r.2.1) else none

theorem step_ok (ws ws' : List It) (N M : Nat) (h : stepRes ws N = some (ws', M)) :
    Reach (START (wt ws) N .top) (START (wt ws') M .top) := by
  unfold stepRes at h
  split at h
  · next hN =>
    cases e : goX (res ws) (N - 5) 12 with
    | none => rw [e] at h; cases h
    | some r =>
      rw [e] at h; simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      obtain ⟨n, rfl⟩ : ∃ n, N = n + 5 := ⟨N - 5, by omega⟩
      have a := Reach.of (part1 (wtl ws) n)
      rw [← wt_eq] at a
      rw [Nat.add_sub_cancel] at e
      exact a.trans (goX_ok ws _ (res_ok ws) n 12 r e .top .top rfl)
  · cases h

/-- The wall as a list of cells, from the head leftwards (the form `S` of `Reduction.lean` takes). -/
def itL : It → List Bool
  | .o k => [true, false, true, true, true, true, true] ++ repl false true true k
  | .c k => [true, true, true, true, true, true] ++ repl false true true k

def wl : List It → List Bool
  | [] => [true]
  | x :: ws => itL x ++ wl ws

theorem wl_spec : ∀ ws, app (wl ws) blank = wt ws
  | [] => rfl
  | .o k :: ws => by
    simp only [wl, itL, wt, itT, List.cons_append, app_cons, List.nil_append]
    rw [repl_spec, wl_spec ws]; rfl
  | .c k :: ws => by
    simp only [wl, itL, wt, itT, List.cons_append, app_cons, List.nil_append]
    rw [repl_spec, wl_spec ws]; rfl

/-- **The step on the stack**: whenever `stepRes` answers, the machine goes from the step start `S W N` to the
step start `S W' N'` (`S` of `Reduction.lean`), for the walls `W = wl ws`, `W' = wl ws'`. -/
theorem step_stack (ws ws' : List It) (N M : Nat) (h : stepRes ws N = some (ws', M)) :
    Reach (S (wl ws) N) (S (wl ws') M) := by
  have a := step_ok ws ws' N M h
  rw [← wl_spec, ← wl_spec] at a
  exact a

theorem ite_f {α : Type} {p : Prop} [Decidable p] (h : ¬p) (a b : α) : (if p then a else b) = b := by simp [h]
theorem ite_t {α : Type} {p : Prop} [Decidable p] (h : p) (a b : α) : (if p then a else b) = a := by simp [h]

/-! ## The fitted model of `py/stackmodel.py`

`mstep` is `step` of `py/stackmodel.py` (lists top first, signal `true` = odd): the new wall, `om` (what the item
below adds to its count) and `orr`.  `res_model`: whenever `res` answers, `mstep` gives the same wall, and the
amounts agree (`M = n + om`, minus 2 for the even signal; the copies used up from the block above are
`om - orr`).  `step_model`: `stepRes` is `stepN`, so `stackmodel.py` is proved for every step where `res`
answers. -/

def mstep : List It → Bool → Option (List It × Int × Int)
  | [], false => some ([], 2, 2)
  | [], true => some ([.o 0], 0, 0)
  | .o k :: V, false => some (.c k :: V, 2, 2)
  | .o k :: V, true =>
    match mstep V (k % 2 == 1) with
    | none => none
    | some (V', om, orr) =>
      if ((3 * k / 2 : Nat) : Int) + om < 0 then none
      else some (.o (((3 * k / 2 : Nat) : Int) + om).toNat :: V',
        (k : Int) - (((3 * k / 2 : Nat) : Int) + om) + orr, (k : Int) - (((3 * k / 2 : Nat) : Int) + om) + orr)
  | .c 0 :: V, true => some (.o 0 :: .c 0 :: V, 0, 0)
  | .c k :: V, s =>
    match mstep V ((k + (if s then 1 else 0)) % 2 == 1) with
    | none => none
    | some (V', om, orr) =>
      some (V', om + ((3 * k / 2 : Nat) : Int) + (2 + (if s then 1 + ((k % 2 : Nat) : Int) else 0)), orr + k + 2)

/-- `stepN` of `py/stackmodel.py`. -/
def mstepN (ws : List It) (N : Nat) : Option (List It × Nat) :=
  match mstep ws (N % 2 == 1) with
  | none => none
  | some (ws', om, _) =>
    if ((if N % 2 = 0 then 3 * N / 2 + 5 else (3 * N + 9) / 2 : Nat) : Int) + om < 0 then none
    else some (ws', (((if N % 2 = 0 then 3 * N / 2 + 5 else (3 * N + 9) / 2 : Nat) : Int) + om).toNat)

def ModelOK (ws : List It) (f : Bool → Nat → Option Res) : Prop :=
  ∀ s n r, f s n = some r → ∃ om orr : Int, mstep ws s = some (r.1, om, orr) ∧
    (r.2.1 : Int) + (if s then 0 else 2) = n + om ∧ (r.2.2 : Int) = om - orr

theorem goX_model (ws : List It) (f : Bool → Nat → Option Res) (hf : ModelOK ws f) (x y : Nat) (r : Res)
    (h : goX f x y = some r) : ∃ om orr : Int, mstep ws (x % 2 == 0) = some (r.1, om, orr) ∧
      (r.2.1 : Int) + (if x % 2 = 0 then 0 else 2) = y + 3 * (x / 2) + (if x % 2 = 0 then 0 else 4) + om ∧
      (r.2.2 : Int) = x / 2 + (if x % 2 = 0 then 0 else 1) + om - orr := by
  unfold goX at h
  split at h
  · next hx =>
    cases e : f true (y + 3 * (x / 2)) with
    | none => rw [e] at h; cases h
    | some r0 =>
      rw [e] at h; cases h
      obtain ⟨om, orr, h1, h2, h3⟩ := hf true _ r0 e
      refine ⟨om, orr, ?_, ?_, ?_⟩
      · simp only [hx]; exact h1
      · simp only [hx, ite_true] at h2 ⊢; push_cast at h2 ⊢; omega
      · simp only [hx, ite_true]; push_cast; omega
  · split at h
    · next hx hy =>
      cases e : f false (y + 3 * (x / 2) + 4) with
      | none => rw [e] at h; cases h
      | some r0 =>
        rw [e] at h; cases h
        obtain ⟨om, orr, h1, h2, h3⟩ := hf false _ r0 e
        refine ⟨om, orr, ?_, ?_, ?_⟩
        · simp only [show (x % 2 == 0) = false by simp [hx]]; exact h1
        · simp only [hx, ite_false] at h2 ⊢; push_cast at h2 ⊢; omega
        · simp only [hx, ite_false]; push_cast; omega
    · cases h

theorem rebR_model (o : Option Res) (y : Nat) (r : Res) (h : rebR y o = some r) :
    ∃ r0 : Res, o = some r0 ∧ 1 ≤ r0.2.1 ∧ r0.2.2 + 1 ≤ y ∧ r = (.o (r0.2.1 - 1) :: r0.1, y - r0.2.2, 0) := by
  cases o with
  | none => cases h
  | some r0 =>
    obtain ⟨ws', M, u⟩ := r0
    simp only [rebR] at h
    split at h
    · next hM => simp only [Option.some.injEq] at h; exact ⟨_, rfl, hM.1, hM.2, h.symm⟩
    · cases h

theorem mstep_o (k : Nat) (V : List It) : mstep (.o k :: V) true =
    (mstep V (k % 2 == 1)).bind fun r =>
      if ((3 * k / 2 : Nat) : Int) + r.2.1 < 0 then none
      else some (.o (((3 * k / 2 : Nat) : Int) + r.2.1).toNat :: r.1,
        (k : Int) - (((3 * k / 2 : Nat) : Int) + r.2.1) + r.2.2, (k : Int) - (((3 * k / 2 : Nat) : Int) + r.2.1) + r.2.2) := by
  simp only [mstep]; cases mstep V (k % 2 == 1) <;> rfl

theorem mstep_c0 (k : Nat) (V : List It) : mstep (.c k :: V) false =
    (mstep V (k % 2 == 1)).map fun r => (r.1, r.2.1 + ((3 * k / 2 : Nat) : Int) + 2, r.2.2 + (k : Int) + 2) := by
  cases k <;> simp only [mstep, Bool.false_eq_true, ite_false, Nat.add_zero, Int.add_zero] <;>
    cases mstep V _ <;> rfl

theorem mstep_c1 (k : Nat) (V : List It) : mstep (.c (k + 1) :: V) true =
    (mstep V ((k + 1 + 1) % 2 == 1)).map fun r =>
      (r.1, r.2.1 + ((3 * (k + 1) / 2 : Nat) : Int) + (2 + (1 + (((k + 1) % 2 : Nat) : Int))), r.2.2 + ((k + 1 : Nat) : Int) + 2) := by
  simp only [mstep, ite_true]; cases mstep V _ <;> rfl

theorem res_model (ws : List It) : ModelOK ws (res ws) := by
  induction ws with
  | nil =>
    intro s n r h
    cases s with
    | false =>
      simp only [res, Option.some.injEq] at h; subst h
      exact ⟨2, 2, rfl, by simp, by simp⟩
    | true =>
      simp only [res] at h
      split at h
      · simp only [Option.some.injEq] at h; subst h
        exact ⟨0, 0, rfl, by simp, by simp⟩
      · cases h
  | cons x ws ih =>
    intro s n r h
    cases x with
    | o k =>
      cases s with
      | false =>
        simp only [res, Option.some.injEq] at h; subst h
        exact ⟨2, 2, rfl, by simp, by simp⟩
      | true =>
        rw [mstep_o]
        cases k with
        | zero =>
          obtain ⟨r0, e, h1, h2, rfl⟩ := rebR_model _ n r h
          obtain ⟨om, orr, m1, m2, m3⟩ := ih false 3 r0 e
          rw [ite_f Bool.false_ne_true] at m2
          rw [show ((0 : Nat) % 2 == 1) = false from rfl, m1]
          refine ⟨-(om) + orr, -(om) + orr, ?_, ?_, ?_⟩
          · simp only [Option.bind_some]
            rw [ite_f (by push_cast; omega)]
            simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, It.o.injEq, and_true]
            refine ⟨by omega, by push_cast; omega⟩
          · rw [ite_t rfl]; simp only; omega
          · simp only; omega
        | succ k =>
          obtain ⟨r0, e, h1, h2, rfl⟩ := rebR_model _ n r h
          obtain ⟨om, orr, m1, m2, m3⟩ := goX_model ws _ ih k 2 r0 e
          have hb : (k % 2 == 0) = ((k + 1) % 2 == 1) := by
            rcases Nat.mod_two_eq_zero_or_one k with hk | hk <;> simp [hk, Nat.add_mod]
          rw [hb] at m1
          rw [m1]
          refine ⟨(k + 1 : Nat) - (((3 * (k + 1) / 2 : Nat) : Int) + om) + orr,
            (k + 1 : Nat) - (((3 * (k + 1) / 2 : Nat) : Int) + om) + orr, ?_, ?_, ?_⟩
          · simp only [Option.bind_some]
            rw [ite_f (by split at m2 <;> push_cast at m2 ⊢ <;> omega)]
            simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, It.o.injEq, and_true]
            split at m2 <;> omega
          · rw [ite_t rfl]; split at m2 <;> split at m3 <;> push_cast at m2 m3 ⊢ <;> omega
          · simp only; omega
    | c j =>
      cases j with
      | zero =>
        cases s with
        | false =>
          obtain ⟨om, orr, m1, m2, m3⟩ := ih false (n + 2) r h
          rw [ite_f Bool.false_ne_true] at m2
          refine ⟨om + 2, orr + 2, ?_, ?_, ?_⟩
          · rw [mstep_c0, show ((0 : Nat) % 2 == 1) = false from rfl, m1]; simp
          · rw [ite_f Bool.false_ne_true]; push_cast at m2; omega
          · omega
        | true =>
          simp only [res] at h
          split at h
          · simp only [Option.some.injEq] at h; subst h
            exact ⟨0, 0, rfl, by simp, by simp⟩
          · cases h
      | succ j =>
        cases s with
        | false =>
          obtain ⟨om, orr, m1, m2, m3⟩ := goX_model ws _ ih j (n + 1) r h
          have hb : (j % 2 == 0) = ((j + 1) % 2 == 1) := by
            rcases Nat.mod_two_eq_zero_or_one j with hk | hk <;> simp [hk, Nat.add_mod]
          rw [hb] at m1
          refine ⟨om + ((3 * (j + 1) / 2 : Nat) : Int) + 2, orr + (j + 1 : Nat) + 2, ?_, ?_, ?_⟩
          · rw [mstep_c0, m1]; simp
          · rw [ite_f Bool.false_ne_true]; split at m2 <;> push_cast at m2 ⊢ <;> omega
          · split at m3 <;> push_cast at m3 ⊢ <;> omega
        | true =>
          rw [mstep_c1]
          cases j with
          | zero =>
            simp only [res] at h
            cases e : res ws false (n + 7) with
            | none => rw [e] at h; cases h
            | some r0 =>
              rw [e] at h; simp only [Option.map_some, Option.some.injEq] at h; subst h
              obtain ⟨om, orr, m1, m2, m3⟩ := ih false (n + 7) r0 e
              rw [ite_f Bool.false_ne_true] at m2
              rw [show ((0 + 1 + 1) % 2 == 1) = false from rfl, m1]
              refine ⟨om + 1 + (2 + (1 + 1)), orr + 1 + 2, ?_, ?_, ?_⟩
              · simp
              · rw [ite_t rfl]; push_cast at m2 ⊢; omega
              · simp only; push_cast; omega
          | succ j =>
            simp only [res] at h
            cases e : goX (res ws) j (n + 6) with
            | none => rw [e] at h; cases h
            | some r0 =>
              rw [e] at h; simp only [Option.map_some, Option.some.injEq] at h; subst h
              obtain ⟨om, orr, m1, m2, m3⟩ := goX_model ws _ ih j (n + 6) r0 e
              have hb : (j % 2 == 0) = ((j + 1 + 1 + 1) % 2 == 1) := by
                rcases Nat.mod_two_eq_zero_or_one j with hk | hk <;> simp [hk, Nat.add_mod]
              rw [hb] at m1
              rw [m1]
              refine ⟨om + ((3 * (j + 1 + 1) / 2 : Nat) : Int) + (2 + (1 + (((j + 1 + 1) % 2 : Nat) : Int))),
                orr + (j + 1 + 1 : Nat) + 2, ?_, ?_, ?_⟩
              · simp
              · rw [ite_t rfl]; split at m2 <;> push_cast at m2 ⊢ <;> omega
              · simp only; split at m3 <;> push_cast at m3 ⊢ <;> omega

/-- **`stepRes` is `stepN` of `py/stackmodel.py`** whenever it answers: so the fitted model is proved for every
such step (with `step_stack`: the machine does it). -/
theorem step_model (ws ws' : List It) (N M : Nat) (h : stepRes ws N = some (ws', M)) :
    mstepN ws N = some (ws', M) := by
  unfold stepRes at h
  split at h
  · next hN =>
    cases e : goX (res ws) (N - 5) 12 with
    | none => rw [e] at h; cases h
    | some r =>
      rw [e] at h; simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      obtain ⟨om, orr, m1, m2, m3⟩ := goX_model ws _ (res_model ws) (N - 5) 12 r e
      have hb : ((N - 5) % 2 == 0) = (N % 2 == 1) := by
        rcases Nat.mod_two_eq_zero_or_one N with hk | hk <;> simp [hk] <;> omega
      rw [hb] at m1
      unfold mstepN
      rw [m1]
      simp only
      rw [ite_f (by split <;> split at m2 <;> push_cast at m2 ⊢ <;> omega)]
      congr 2
      split <;> split at m2 <;> push_cast at m2 ⊢ <;> omega
  · cases h

/-- **The counter-stack step.**  Whenever `stepRes` answers, the machine goes from the step start `S W N` to the
step start `S W' N'`, and `(W', N')` is what `stepN` of `py/stackmodel.py` gives. -/
theorem stack_step (ws ws' : List It) (N M : Nat) (h : stepRes ws N = some (ws', M)) :
    mstepN ws N = some (ws', M) ∧ Reach (S (wl ws) N) (S (wl ws') M) :=
  ⟨step_model ws ws' N M h, step_stack ws ws' N M h⟩

end H3292
