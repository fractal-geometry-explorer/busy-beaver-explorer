import Machine

/-! # The moves of an excursion

Generated by `py/gen_rules.py` with `bbtools.symtm.prove`: every theorem is a run of the machine for all values of
the variables and every tape `L`, `R`, proved by `rfl` steps and the shift rules `cross_l`, `cross_r`.
Left tapes are written nearest the head first, so `(10)^k` on the page is `rep k [false, true]` here. -/

namespace H77294

open TM

/-- The only way to halt: D on a 1 with `0 0` to its left; two steps later F reads 0 (`step_none_iff`). -/
theorem halt_00 (L R : Tape) :
    steps (2) ⟨cons false (cons false (L)), cons true (R), .D⟩ = some ⟨L, cons false (cons true (cons true (R))), .F⟩ := by
  have h0 : steps 2 ⟨cons false (cons false (L)), cons true (R), .D⟩ = some ⟨L, cons false (cons true (cons true (R))), .F⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- The right sweep: A crosses `11` pairs, turning each into `01`. -/
theorem sweep_d (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, true] (R), .A⟩ = some ⟨rep (n) [true, false] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, false] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (R), .A⟩ = some ⟨rep (n) [true, false] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- ...and `01` pairs into `11`. -/
theorem sweep_b (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [false, true] (R), .A⟩ = some ⟨rep (n) [true, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [false, true] (R), .A⟩ = some ⟨rep (n) [true, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- At the right end, an odd last block `1^(2a+1)` is crossed by the D/E pass, which ends in F on the 1 to its left. -/
theorem tail_odd (a : Nat) (L : Tape) :
    steps (2 * a + 8) ⟨cons true (cons true (cons false (cons true (rep (a) [true, true] (cons false (cons true (L))))))), blank, .B⟩ = some ⟨L, cons true (cons true (cons true (rep (a) [false, true] (cons false (cons true (cons true (cons false (blank)))))))), .F⟩ := by
  have h0 : steps 6 ⟨cons true (cons true (cons false (cons true (rep (a) [true, true] (cons false (cons true (L))))))), blank, .B⟩ = some ⟨rep (a) [true, true] (cons false (cons true (L))), cons true (cons false (cons true (cons true (cons false (blank))))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((a) * 2) ⟨rep (a) [true, true] (cons false (cons true (L))), cons true (cons false (cons true (cons true (cons false (blank))))), .D⟩ = some ⟨cons false (cons true (L)), cons true (rep (a) [false, true] (cons false (cons true (cons true (cons false (blank)))))), .D⟩ :=
    cross_l trans c1 (a) (cons false (cons true (L))) (cons false (cons true (cons true (cons false (blank)))))
  have h2 : steps 2 ⟨cons false (cons true (L)), cons true (rep (a) [false, true] (cons false (cons true (cons true (cons false (blank)))))), .D⟩ = some ⟨L, cons true (cons true (cons true (rep (a) [false, true] (cons false (cons true (cons true (cons false (blank)))))))), .F⟩ := rfl
  exact steps_congr trans (a := 6 + ((a) * 2 + (2))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- An even last block `1^(2a+2)` ends the pass in D on the 0 to its left. -/
theorem tail_even (a : Nat) (L : Tape) :
    steps (2 * a + 8) ⟨cons true (cons true (cons false (cons true (cons true (rep (a) [true, true] (cons false (L))))))), blank, .B⟩ = some ⟨L, cons false (cons false (rep (a) [true, false] (cons true (cons false (cons true (cons true (cons false (blank)))))))), .D⟩ := by
  have h0 : steps 7 ⟨cons true (cons true (cons false (cons true (cons true (rep (a) [true, true] (cons false (L))))))), blank, .B⟩ = some ⟨rep (a) [true, true] (cons false (L)), cons true (cons true (cons false (cons true (cons true (cons false (blank)))))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h1 : steps ((a) * 2) ⟨rep (a) [true, true] (cons false (L)), cons true (cons true (cons false (cons true (cons true (cons false (blank)))))), .E⟩ = some ⟨cons false (L), cons true (rep (a) [true, false] (cons true (cons false (cons true (cons true (cons false (blank))))))), .E⟩ :=
    cross_l trans c1 (a) (cons false (L)) (cons true (cons false (cons true (cons true (cons false (blank))))))
  have h2 : steps 1 ⟨cons false (L), cons true (rep (a) [true, false] (cons true (cons false (cons true (cons true (cons false (blank))))))), .E⟩ = some ⟨L, cons false (cons false (rep (a) [true, false] (cons true (cons false (cons true (cons true (cons false (blank)))))))), .D⟩ := rfl
  exact steps_congr trans (a := 7 + ((a) * 2 + (1))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- The D/E pass inside the tape: `0 1^(2n+2)` with D on its right end becomes `0 0 1 (01)^n`, D on the 0. -/
theorem de_pass (n : Nat) (L R : Tape) :
    steps (2 * n + 2) ⟨rep (n) [true, true] (cons true (cons false (L))), cons true (R), .D⟩ = some ⟨L, cons false (cons false (cons true (rep (n) [false, true] (R)))), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [true, true] (cons true (cons false (L))), cons true (R), .D⟩ = some ⟨cons true (cons false (L)), cons true (rep (n) [false, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (cons true (cons false (L))) (R)
  have h1 : steps 2 ⟨cons true (cons false (L)), cons true (rep (n) [false, true] (R)), .D⟩ = some ⟨L, cons false (cons false (cons true (rep (n) [false, true] (R)))), .D⟩ := rfl
  exact steps_congr trans (a := (n) * 2 + (2)) (by omega) (steps_seq trans h0 (h1))

/-- A pass that reaches the leftmost block when it is odd (`1^(2a+1)` next to blank tape) halts: F reads 0. -/
theorem lead_odd (a : Nat) (R : Tape) :
    steps (2 * a + 2) ⟨rep (a) [true, true] (blank), cons true (R), .D⟩ = some ⟨blank, cons false (cons true (cons true (rep (a) [false, true] (R)))), .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((a) * 2) ⟨rep (a) [true, true] (blank), cons true (R), .D⟩ = some ⟨blank, cons true (rep (a) [false, true] (R)), .D⟩ :=
    cross_l trans c0 (a) (blank) (R)
  have h1 : steps 2 ⟨blank, cons true (rep (a) [false, true] (R)), .D⟩ = some ⟨blank, cons false (cons true (cons true (rep (a) [false, true] (R)))), .F⟩ := rfl
  exact steps_congr trans (a := (a) * 2 + (2)) (by omega) (steps_seq trans h0 (h1))

/-- When the block next to `0 0` is even the pass turns into a right sweep instead, and the tape grows by two 1s. -/
theorem lead_even (a : Nat) (L R : Tape) :
    steps (4 * a + 7) ⟨rep (a) [true, true] (cons true (cons false (cons false (L)))), cons true (R), .D⟩ = some ⟨rep (a) [true, true] (cons true (cons true (cons true (cons true (L))))), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((a) * 2) ⟨rep (a) [true, true] (cons true (cons false (cons false (L)))), cons true (R), .D⟩ = some ⟨cons true (cons false (cons false (L))), cons true (rep (a) [false, true] (R)), .D⟩ :=
    cross_l trans c0 (a) (cons true (cons false (cons false (L)))) (R)
  have h1 : steps 7 ⟨cons true (cons false (cons false (L))), cons true (rep (a) [false, true] (R)), .D⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), rep (a) [false, true] (R), .A⟩ := rfl
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h2 : steps ((a) * 2) ⟨cons true (cons true (cons true (cons true (L)))), rep (a) [false, true] (R), .A⟩ = some ⟨rep (a) [true, true] (cons true (cons true (cons true (cons true (L))))), R, .A⟩ :=
    cross_r trans c2 (a) (cons true (cons true (cons true (cons true (L))))) (R)
  exact steps_congr trans (a := (a) * 2 + (7 + ((a) * 2))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A left-going round: `0101 01 1^(2j)` with A on `00` becomes `00 1101 1^(2j) 10`; the head moves 2j+6 cells left. -/
theorem zig_1 (j : Nat) (L R : Tape) :
    steps (2 * j + 10) ⟨rep (j) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (R)), .A⟩ = some ⟨L, cons false (cons false (cons true (cons true (cons false (cons true (cons true (rep (j) [true, true] (cons false (R))))))))), .A⟩ := by
  have h0 : steps 2 ⟨rep (j) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (R)), .A⟩ = some ⟨rep (j) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), cons true (cons false (R)), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 2) ⟨rep (j) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (L))))))), cons true (cons false (R)), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons false (L)))))), cons true (rep (j) [true, true] (cons false (R))), .C⟩ :=
    cross_l trans c1 (j) (cons true (cons false (cons true (cons false (cons true (cons false (L))))))) (cons false (R))
  have h2 : steps 8 ⟨cons true (cons false (cons true (cons false (cons true (cons false (L)))))), cons true (rep (j) [true, true] (cons false (R))), .C⟩ = some ⟨L, cons false (cons false (cons true (cons true (cons false (cons true (cons true (rep (j) [true, true] (cons false (R))))))))), .A⟩ := rfl
  exact steps_congr trans (a := 2 + ((j) * 2 + (8))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- The other left-going round: `0101 1^(2j) 01` with A on `00` becomes `00 1101 (01)^j 10`. -/
theorem zig_2 (j : Nat) (L R : Tape) :
    steps (2 * j + 10) ⟨cons true (cons false (rep (j) [true, true] (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (R)), .A⟩ = some ⟨L, cons false (cons false (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))))), .A⟩ := by
  have h0 : steps 6 ⟨cons true (cons false (rep (j) [true, true] (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (R)), .A⟩ = some ⟨rep (j) [true, true] (cons true (cons false (cons true (cons false (L))))), cons true (cons true (cons true (cons false (R)))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 2) ⟨rep (j) [true, true] (cons true (cons false (cons true (cons false (L))))), cons true (cons true (cons true (cons false (R)))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), cons true (rep (j) [true, false] (cons true (cons true (cons false (R))))), .E⟩ :=
    cross_l trans c1 (j) (cons true (cons false (cons true (cons false (L))))) (cons true (cons true (cons false (R))))
  have h2 : steps 4 ⟨cons true (cons false (cons true (cons false (L)))), cons true (rep (j) [true, false] (cons true (cons true (cons false (R))))), .E⟩ = some ⟨L, cons false (cons false (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))))), .A⟩ := rfl
  exact steps_congr trans (a := 6 + ((j) * 2 + (4))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A right-going round: `1111 (11)^i 10` becomes `0101 (01)^i 01` (the A/B sweep with a carry). -/
theorem ret_d (i : Nat) (L R : Tape) :
    steps (2 * i + 10) ⟨L, cons true (cons true (cons true (cons true (rep (i) [true, true] (cons true (cons false (R))))))), .A⟩ = some ⟨cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons false (L))))))), R, .A⟩ := by
  have h0 : steps 4 ⟨L, cons true (cons true (cons true (cons true (rep (i) [true, true] (cons true (cons false (R))))))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), rep (i) [true, true] (cons true (cons false (R))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, false] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((i) * 2) ⟨cons true (cons false (cons true (cons false (L)))), rep (i) [true, true] (cons true (cons false (R))), .A⟩ = some ⟨rep (i) [true, false] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (R)), .A⟩ :=
    cross_r trans c1 (i) (cons true (cons false (cons true (cons false (L))))) (cons true (cons false (R)))
  have h2 : steps 6 ⟨rep (i) [true, false] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (R)), .A⟩ = some ⟨cons true (cons false (rep (i) [true, false] (cons true (cons false (cons true (cons false (L))))))), R, .A⟩ := rfl
  exact steps_congr trans (a := 4 + ((i) * 2 + (6))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- ...and `1111 (01)^i 10` becomes `0101 (11)^i 01`. -/
theorem ret_b (i : Nat) (L R : Tape) :
    steps (2 * i + 10) ⟨L, cons true (cons true (cons true (cons true (rep (i) [false, true] (cons true (cons false (R))))))), .A⟩ = some ⟨cons true (cons false (rep (i) [true, true] (cons true (cons false (cons true (cons false (L))))))), R, .A⟩ := by
  have h0 : steps 4 ⟨L, cons true (cons true (cons true (cons true (rep (i) [false, true] (cons true (cons false (R))))))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), rep (i) [false, true] (cons true (cons false (R))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((i) * 2) ⟨cons true (cons false (cons true (cons false (L)))), rep (i) [false, true] (cons true (cons false (R))), .A⟩ = some ⟨rep (i) [true, true] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (R)), .A⟩ :=
    cross_r trans c1 (i) (cons true (cons false (cons true (cons false (L))))) (cons true (cons false (R)))
  have h2 : steps 6 ⟨rep (i) [true, true] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (R)), .A⟩ = some ⟨cons true (cons false (rep (i) [true, true] (cons true (cons false (cons true (cons false (L))))))), R, .A⟩ := rfl
  exact steps_congr trans (a := 4 + ((i) * 2 + (6))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

end H77294
