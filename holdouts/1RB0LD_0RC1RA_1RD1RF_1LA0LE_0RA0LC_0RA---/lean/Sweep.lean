import Machine

/-!
# The sweeps of 1RB0LD_0RC1RA_1RD1RF_1LA0LE_0RA0LC_0RA---

Generated by `py/gen_sweep.py`; do not edit by hand.

Between the left part of the tape (where the counter's digits are) and the right end, the tape is a run of
`P = 11111010` (after a rightward sweep) or `Q = 01010010` (after a leftward one).  Going right, state A turns `Q^n` into
`P^n` (8 steps a word).  At the right end the head turns (`turn_a`, `turn_b`, which include the rightward sweep).
Going left, state C turns `P^n` back into `Q^n`, 30 steps a word, carrying `1010` on its left and `101` on its
right, so it needs `cross_l2`, the two-sided form of `TM.cross_l`; in the left-sweep form the run of `P` reads
`1 W^n` with `W = 11110101`.  Tapes left of the head are written nearest cell first.
-/

namespace H149064

open TM

/-- Crossing to the left with a word carried on each side: `w^k u₁ q> u₂ R` becomes `u₁ q> u₂ v^k R`. -/
theorem cross_l2 {s : Nat} {q : St} {u₁ u₂ w v : List Bool}
    (h : ∀ L R : Tape, steps s ⟨app u₁ (app w L), app u₂ R, q⟩ = some ⟨app u₁ L, app u₂ (app v R), q⟩) (k : Nat) :
    ∀ L R : Tape, steps (k * s) ⟨app u₁ (rep k w L), app u₂ R, q⟩ = some ⟨app u₁ L, app u₂ (rep k v R), q⟩ := by
  induction k with
  | zero => intro L R; simp
  | succ k ih =>
    intro L R
    have e : (k + 1) * s = s + k * s := by rw [Nat.succ_mul, Nat.add_comm]
    rw [e]
    have h₂ := ih L (app v R)
    rw [rep_app_comm] at h₂
    exact steps_seq trans (h (rep k w L) R) h₂

/-- The rightward sweep: `A> Q^n` becomes `P^n A>` in 8n steps. -/
theorem sweep_right (n : Nat) (L R : Tape) :
    steps (8 * n) ⟨L, rep (n) [false, true, false, true, false, false, true, false] (R), .A⟩ = some ⟨rep (n) [false, true, false, true, true, true, true, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, true, false, true, false, false, true, false] R, .A⟩ = some ⟨app [] (app [false, true, false, true, true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 8) ⟨L, rep (n) [false, true, false, true, false, false, true, false] (R), .A⟩ = some ⟨rep (n) [false, true, false, true, true, true, true, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 8) (by omega) (h0)


/-- One copy of the leftward sweep: `W 1010 C> 101` becomes `1010 C> 101 Q` in 30 steps. -/
theorem sweep_left_one : ∀ L R : Tape,
    steps 30 ⟨app [false, true, false, true] (app [true, false, true, false, true, true, true, true] L), app [true, false, true] R, .C⟩ = some ⟨app [false, true, false, true] L, app [true, false, true] (app [false, true, false, true, false, false, true, false] R), .C⟩ :=
  fun _ _ => rfl

/-- The leftward sweep: `W^n 1010 C> 101` becomes `1010 C> 101 Q^n` in 30n steps. -/
theorem sweep_left (n : Nat) (L R : Tape) :
    steps (n * 30) ⟨app [false, true, false, true] (rep n [true, false, true, false, true, true, true, true] L), app [true, false, true] R, .C⟩ =
      some ⟨app [false, true, false, true] L, app [true, false, true] (rep n [false, true, false, true, false, false, true, false] R), .C⟩ :=
  cross_l2 sweep_left_one n L R

/-- `P^n 1` is `1 W^n`. -/
theorem p_rotate (n : Nat) (L : Tape) : cons true (rep n [false, true, false, true, true, true, true, true] L) = rep n [true, false, true, false, true, true, true, true] (cons true L) :=
  rep_rotate n [true] [false, true, false, true, true, true, true, true] [true, false, true, false, true, true, true, true] rfl L

/-- Sweep right and turn, case a: `A> Q^(n+4) 0101` at the right end becomes `P^(n+4) 1 1010 C> 101` in 8n + 49 steps. -/
theorem turn_a (n : Nat) (L : Tape) :
    steps (8 * n + 49) ⟨L, rep (n + 4) [false, true, false, true, false, false, true, false] (cons false (cons true (cons false (cons true (blank))))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (rep (n + 4) [false, true, false, true, true, true, true, true] (L)))))), cons true (cons false (cons true (blank))), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, true, false, true, false, false, true, false] R, .A⟩ = some ⟨app [] (app [false, true, false, true, true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n + 4) * 8) ⟨L, rep (n + 4) [false, true, false, true, false, false, true, false] (cons false (cons true (cons false (cons true (blank))))), .A⟩ = some ⟨rep (n + 4) [false, true, false, true, true, true, true, true] (L), cons false (cons true (cons false (cons true (blank)))), .A⟩ :=
    cross_r trans c0 (n + 4) (L) (cons false (cons true (cons false (cons true (blank)))))
  have h1 : steps 17 ⟨rep (n + 4) [false, true, false, true, true, true, true, true] (L), cons false (cons true (cons false (cons true (blank)))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (rep (n + 4) [false, true, false, true, true, true, true, true] (L)))))), cons true (cons false (cons true (blank))), .C⟩ := rfl
  exact steps_congr trans (a := (n + 4) * 8 + (17)) (by omega) (steps_seq trans h0 (h1))


/-- Sweep right and turn, case b: `A> Q^(n+4)` at the right end becomes `P^(n+3) 1 1010 C> 101 0101` in 8n + 49 steps. -/
theorem turn_b (n : Nat) (L : Tape) :
    steps (8 * n + 49) ⟨L, rep (n + 4) [false, true, false, true, false, false, true, false] (blank), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (rep (n + 3) [false, true, false, true, true, true, true, true] (L)))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, true, false, true, false, false, true, false] R, .A⟩ = some ⟨app [] (app [false, true, false, true, true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n + 4) * 8) ⟨L, rep (n + 4) [false, true, false, true, false, false, true, false] (blank), .A⟩ = some ⟨rep (n + 4) [false, true, false, true, true, true, true, true] (L), blank, .A⟩ :=
    cross_r trans c0 (n + 4) (L) (blank)
  have h1 : steps 17 ⟨rep (n + 4) [false, true, false, true, true, true, true, true] (L), blank, .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (rep (n + 3) [false, true, false, true, true, true, true, true] (L)))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), .C⟩ := rfl
  exact steps_congr trans (a := (n + 4) * 8 + (17)) (by omega) (steps_seq trans h0 (h1))


/-- The right half of a round trip, case a: from `A> Q^(n+4) 0101` the head sweeps right, turns, and sweeps back
over the whole run, leaving `1 1010 C> 101 Q^(n+4)` (four cells wider), in 38n + 169 steps. -/
theorem round_a (n : Nat) (L : Tape) :
    steps (38 * n + 169) ⟨L, rep (n + 4) [false, true, false, true, false, false, true, false] (cons false (cons true (cons false (cons true blank)))), .A⟩ =
      some ⟨app [false, true, false, true] (cons true L), app [true, false, true] (rep (n + 4) [false, true, false, true, false, false, true, false] blank), .C⟩ := by
  have h1 := turn_a n L
  have h2 := sweep_left (n + 4) (cons true L) blank
  rw [← p_rotate] at h2
  have h := steps_seq trans h1 h2
  exact steps_congr trans (by omega) h

/-- The right half of a round trip, case b: from `A> Q^(n+4)` at the right end the head comes back as
`1 1010 C> 101 Q^(n+3) 0101`, in 38n + 139 steps. -/
theorem round_b (n : Nat) (L : Tape) :
    steps (38 * n + 139) ⟨L, rep (n + 4) [false, true, false, true, false, false, true, false] blank, .A⟩ =
      some ⟨app [false, true, false, true] (cons true L), app [true, false, true] (rep (n + 3) [false, true, false, true, false, false, true, false] (cons false (cons true (cons false (cons true blank))))), .C⟩ := by
  have h1 := turn_b n L
  have h2 := sweep_left (n + 3) (cons true L) (cons false (cons true (cons false (cons true blank))))
  rw [← p_rotate] at h2
  have h := steps_seq trans h1 h2
  exact steps_congr trans (by omega) h

end H149064
