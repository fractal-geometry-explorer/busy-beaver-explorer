import Machine

/-! The visit law of 1RB0LB_0RC0LF_1LD1RE_0LA0RB_0RD0RF_0LA---, generated by `py/visit.py`; do not edit by hand.

A visit: the head enters a stream `s` in state C with a 0 on its left and comes back in state A two cells further
left, the 0 restored and `s` rewritten to `s'` (`Vis s s'`).  The rules below are for every stream, every cell `x`
and every left tape `L`. -/

namespace H112145

open TM

/-- One visit rewrites the stream `s` to `s'`. -/
def Vis (s s' : Tape) : Prop :=
  ∀ (x : Bool) (L : Tape), ∃ n, steps n ⟨cons false (cons x L), s, .C⟩ = some ⟨L, cons x (cons false s'), .A⟩

/-- A visit to the stream `s` halts the machine. -/
def VisHalts (s : Tape) : Prop :=
  ∀ (x : Bool) (L : Tape), ∃ n c, steps n ⟨cons false (cons x L), s, .C⟩ = some c ∧ step c = none

/-- `0 s` becomes `1 s'`, no nested visit. -/
theorem vis_0 {s : Tape}  :
    Vis (cons false (s)) (cons true (s)) := by
  intro x L
  have a0 : steps 2 ⟨cons false (cons x (L)), cons false (s), .C⟩ = some ⟨L, cons x (cons false (cons true (s))), .A⟩ := rfl
  exact ⟨2, a0⟩

/-- `100 s` becomes `000 s'`, one nested visit. -/
theorem vis_100 {s s' : Tape} (h1 : Vis s s') :
    Vis (cons true (cons false (cons false (s)))) (cons false (cons false (cons false (s')))) := by
  intro x L
  obtain ⟨n1, e1⟩ := h1 (true) (cons true (cons false (cons x (L))))
  have a0 : steps 5 ⟨cons false (cons x (L)), cons true (cons false (cons false (s))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons x (L))))), s, .C⟩ := rfl
  have a1 : steps 3 ⟨cons true (cons false (cons x (L))), cons true (cons false (s')), .A⟩ = some ⟨L, cons x (cons false (cons false (cons false (cons false (s'))))), .A⟩ := rfl
  exact ⟨5 + n1 + 3, steps_seq trans (steps_seq trans (a0) e1) a1⟩

/-- A visit to `100 s` halts when its first nested visit halts. -/
theorem vis_100_halts_1 {s : Tape} (h1 : VisHalts s) :
    VisHalts (cons true (cons false (cons false (s)))) := by
  intro x L
  obtain ⟨m, c, e, hc⟩ := h1 (true) (cons true (cons false (cons x (L))))
  have a0 : steps 5 ⟨cons false (cons x (L)), cons true (cons false (cons false (s))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons x (L))))), s, .C⟩ := rfl
  exact ⟨5 + m, c, steps_seq trans (a0) e, hc⟩

/-- `110 s` becomes `000 s'`, one nested visit. -/
theorem vis_110 {s s' : Tape} (h1 : Vis s s') :
    Vis (cons true (cons true (cons false (s)))) (cons false (cons false (cons false (s')))) := by
  intro x L
  obtain ⟨n1, e1⟩ := h1 (true) (cons true (cons false (cons x (L))))
  have a0 : steps 5 ⟨cons false (cons x (L)), cons true (cons true (cons false (s))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons x (L))))), s, .C⟩ := rfl
  have a1 : steps 3 ⟨cons true (cons false (cons x (L))), cons true (cons false (s')), .A⟩ = some ⟨L, cons x (cons false (cons false (cons false (cons false (s'))))), .A⟩ := rfl
  exact ⟨5 + n1 + 3, steps_seq trans (steps_seq trans (a0) e1) a1⟩

/-- A visit to `110 s` halts when its first nested visit halts. -/
theorem vis_110_halts_1 {s : Tape} (h1 : VisHalts s) :
    VisHalts (cons true (cons true (cons false (s)))) := by
  intro x L
  obtain ⟨m, c, e, hc⟩ := h1 (true) (cons true (cons false (cons x (L))))
  have a0 : steps 5 ⟨cons false (cons x (L)), cons true (cons true (cons false (s))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons x (L))))), s, .C⟩ := rfl
  exact ⟨5 + m, c, steps_seq trans (a0) e, hc⟩

/-- A visit to `111 s` halts. -/
theorem vis_111_halts {s : Tape} : VisHalts (cons true (cons true (cons true (s)))) := by
  intro x L
  exact ⟨2, ⟨cons false (cons true (cons false (cons x (L)))), cons true (s), .F⟩, rfl, rfl⟩

/-- `1010 s` becomes `1010 s'`, two nested visits. -/
theorem vis_1010 {s s1 s' : Tape} (h1 : Vis s s1) (h2 : Vis s1 s') :
    Vis (cons true (cons false (cons true (cons false (s))))) (cons true (cons false (cons true (cons false (s'))))) := by
  intro x L
  obtain ⟨n1, e1⟩ := h1 (false) (cons false (cons true (cons false (cons x (L)))))
  obtain ⟨n2, e2⟩ := h2 (true) (cons false (cons true (cons false (cons x (L)))))
  have a0 : steps 4 ⟨cons false (cons x (L)), cons true (cons false (cons true (cons false (s)))), .C⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons x (L)))))), s, .C⟩ := rfl
  have a1 : steps 2 ⟨cons false (cons true (cons false (cons x (L)))), cons false (cons false (s1)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons x (L)))))), s1, .C⟩ := rfl
  have a2 : steps 8 ⟨cons false (cons true (cons false (cons x (L)))), cons true (cons false (s')), .A⟩ = some ⟨L, cons x (cons false (cons true (cons false (cons true (cons false (s')))))), .A⟩ := rfl
  exact ⟨4 + n1 + 2 + n2 + 8, steps_seq trans (steps_seq trans (steps_seq trans (steps_seq trans (a0) e1) a1) e2) a2⟩

/-- A visit to `1010 s` halts when its first nested visit halts. -/
theorem vis_1010_halts_1 {s : Tape} (h1 : VisHalts s) :
    VisHalts (cons true (cons false (cons true (cons false (s))))) := by
  intro x L
  obtain ⟨m, c, e, hc⟩ := h1 (false) (cons false (cons true (cons false (cons x (L)))))
  have a0 : steps 4 ⟨cons false (cons x (L)), cons true (cons false (cons true (cons false (s)))), .C⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons x (L)))))), s, .C⟩ := rfl
  exact ⟨4 + m, c, steps_seq trans (a0) e, hc⟩

/-- A visit to `1010 s` halts when its second nested visit halts. -/
theorem vis_1010_halts_2 {s s1 : Tape} (h1 : Vis s s1) (h2 : VisHalts s1) :
    VisHalts (cons true (cons false (cons true (cons false (s))))) := by
  intro x L
  obtain ⟨n1, e1⟩ := h1 (false) (cons false (cons true (cons false (cons x (L)))))
  obtain ⟨m, c, e, hc⟩ := h2 (true) (cons false (cons true (cons false (cons x (L)))))
  have a0 : steps 4 ⟨cons false (cons x (L)), cons true (cons false (cons true (cons false (s)))), .C⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons x (L)))))), s, .C⟩ := rfl
  have a1 : steps 2 ⟨cons false (cons true (cons false (cons x (L)))), cons false (cons false (s1)), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons x (L)))))), s1, .C⟩ := rfl
  exact ⟨4 + n1 + 2 + m, c, steps_seq trans (steps_seq trans (steps_seq trans (a0) e1) a1) e, hc⟩

/-- `1011 s` becomes `0001 s'`, no nested visit. -/
theorem vis_1011 {s : Tape}  :
    Vis (cons true (cons false (cons true (cons true (s))))) (cons false (cons false (cons false (cons true (s))))) := by
  intro x L
  have a0 : steps 12 ⟨cons false (cons x (L)), cons true (cons false (cons true (cons true (s)))), .C⟩ = some ⟨L, cons x (cons false (cons false (cons false (cons false (cons true (s)))))), .A⟩ := rfl
  exact ⟨12, a0⟩

/-- The configuration `0^∞ A> 1 0 s`. -/
def LE (s : Tape) : Config := ⟨blank, cons true (cons false s), .A⟩

/-- A round, with any left tape that starts with 2 blank cells. -/
theorem round_gen {s s' : Tape} (h : Vis (cons true (cons false s)) s') (L : Tape) :
    ∃ n, steps n ⟨cons false (cons false (L)), cons true (cons false s), .A⟩ = some ⟨L, cons true (cons false s'), .A⟩ := by
  obtain ⟨n1, e1⟩ := h (true) (L)
  have a0 : steps 6 ⟨cons false (cons false (L)), cons true (cons false s), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons false s), .C⟩ := rfl
  have a1 : steps 0 ⟨L, cons true (cons false (s')), .A⟩ = some ⟨L, cons true (cons false s'), .A⟩ := rfl
  exact ⟨6 + n1 + 0, steps_seq trans (steps_seq trans a0 e1) a1⟩

theorem blank_eq : cons false (cons false (blank)) = blank := by
  simp [cons_false_blank]

/-- A round: `0^∞ A> 1 0 s` becomes `0^∞ A> 1 0 s'` when a visit turns `1 0 s` into `s'`. -/
theorem round {s s' : Tape} (h : Vis (cons true (cons false s)) s') : ∃ n, steps n (LE s) = some (LE s') := by
  obtain ⟨n, e⟩ := round_gen h blank
  rw [blank_eq] at e
  exact ⟨n, e⟩

/-- A round whose visit halts: the machine halts. -/
theorem round_halts {s : Tape} (h : VisHalts (cons true (cons false s))) : TM.Halts trans (LE s) := by
  obtain ⟨m, c, e, hc⟩ := h (true) (blank)
  have a0 : steps 6 ⟨cons false (cons false (blank)), cons true (cons false s), .A⟩ = some ⟨cons false (cons true (blank)), cons true (cons false s), .C⟩ := rfl
  rw [blank_eq] at a0
  exact ⟨6 + m, c, steps_seq trans a0 e, hc⟩

/-- From blank tape the machine reaches `0^∞ A> 1 0 1 0^∞` after 4 steps. -/
theorem start : steps 4 init = some (LE (app [true] blank)) := by
  have h := blank_reaches trans (q := St.A) (n := 4) (c := ⟨[], [true, false, true], .A⟩) (by decide)
  simpa [LE, FCfg.toCfg, cons_false_blank] using h

end H112145
