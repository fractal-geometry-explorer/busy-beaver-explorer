    simp only [steps_zero, show cons true (cons true (cons true (rep (t) [true, true, true, true, true] (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (R))))))))) = rep (t) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (R))))))))) from
      rep_rotate (t) [true, true, true] [true, true, true, true, true] [true, true, true, true, true] rfl (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (R))))))]
  have c11 : ∀ L R : Tape, steps 5 ⟨app [] L, app [true, true, true, true, true] R, .F⟩ = some ⟨app [] (app [false, false, false, false, false] L), R, .F⟩ := fun _ _ => rfl
  have h11 : steps ((t) * 5) ⟨cons false (cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L))))))))), rep (t) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (R))))))))), .F⟩ = some ⟨rep (t) [false, false, false, false, false] (cons false (cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L)))))))))), cons true (cons true (cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (R)))))))), .F⟩ :=
    cross_r trans c11 (t) (cons false (cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L)))))))))) (cons true (cons true (cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (R)))))))))
  have h12 : steps 4 ⟨rep (t) [false, false, false, false, false] (cons false (cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L)))))))))), cons true (cons true (cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (R)))))))), .F⟩ = some ⟨cons false (cons false (cons false (cons false (rep (t) [false, false, false, false, false] (cons false (cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L)))))))))))))), cons false (cons true (rep (c + 1) [false, true] (cons true (R)))), .F⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (h12)))))))))))))

/-- The counter at (1, ..., 1): W + 1 and the configuration X(k+1, W + 1). -/
theorem round_end (k : Nat) (R : Tape) :
    steps (13 * k + 29) ⟨rep (k + 2) [false, false, false, true, true] (blank), cons false (cons true (cons false (cons true (R)))), .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (cons true (cons true (R))))))))))), .C⟩ := by
  have hn : 10 + (0 + ((k + 1) * 13 + (6))) = 13 * k + 29 := by omega
  have h0 : steps 10 ⟨rep (k + 2) [false, false, false, true, true] (blank), cons false (cons true (cons false (cons true (R)))), .F⟩ = some ⟨cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))), cons true (cons true (cons false (cons true (cons true (cons true (R)))))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))), cons true (cons true (cons false (cons true (cons true (cons true (R)))))), .C⟩ = some ⟨rep (k + 1) [false, true, true, false, false] (cons false (cons true (cons true (blank)))), cons true (cons true (cons false (cons true (cons true (cons true (R)))))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))) = rep (k + 1) [false, true, true, false, false] (cons false (cons true (cons true (blank)))) from
      rep_rotate (k + 1) [false, true, true] [false, false, false, true, true] [false, true, true, false, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 13 ⟨app [false, true, true, false, false] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true, true, true, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((k + 1) * 13) ⟨rep (k + 1) [false, true, true, false, false] (cons false (cons true (cons true (blank)))), cons true (cons true (cons false (cons true (cons true (cons true (R)))))), .C⟩ = some ⟨cons false (cons true (cons true (blank))), cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (cons true (cons true (R))))))), .C⟩ :=
    cross_l trans c2 (k + 1) (cons false (cons true (cons true (blank)))) (cons true (cons false (cons true (cons true (cons true (R))))))
  have h3 : steps 6 ⟨cons false (cons true (cons true (blank))), cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (cons true (cons true (R))))))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (cons true (cons true (R))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The same with a carry of length c+1. -/
theorem round_end_carry (c k : Nat) (R : Tape) :
    steps (4 * c + 13 * k + 33) ⟨rep (k + 2) [false, false, false, true, true] (blank), cons false (rep (c + 1) [true, true] (cons true (cons false (cons true (R))))), .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R)))))))))))), .C⟩ := by
  have hn : 4 + (0 + ((c + 1) * 2 + (3 + (0 + ((c + 1) * 2 + (3 + (0 + ((k + 1) * 13 + (6))))))))) = 4 * c + 13 * k + 33 := by omega
  have h0 : steps 4 ⟨rep (k + 2) [false, false, false, true, true] (blank), cons false (rep (c + 1) [true, true] (cons true (cons false (cons true (R))))), .F⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))), cons true (rep (c + 1) [true, true] (cons true (cons false (cons true (R))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))), cons true (rep (c + 1) [true, true] (cons true (cons false (cons true (R))))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))), rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (R))))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (c + 1) [true, true] (cons true (cons false (cons true (R))))) = rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (R))))) from
      rep_rotate (c + 1) [true] [true, true] [true, true] rfl (cons true (cons false (cons true (R))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((c + 1) * 2) ⟨cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))), rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (R))))), .B⟩ = some ⟨rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank))))))), cons true (cons true (cons false (cons true (R)))), .B⟩ :=
    cross_r trans c2 (c + 1) (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank))))))) (cons true (cons true (cons false (cons true (R)))))
  have h3 : steps 3 ⟨rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank))))))), cons true (cons true (cons false (cons true (R)))), .B⟩ = some ⟨cons true (rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))), cons true (cons true (cons true (R))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))), cons true (cons true (cons true (R))), .A⟩ = some ⟨rep (c + 1) [true, true] (cons true (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))), cons true (cons true (cons true (R))), .A⟩ := by
    simp only [steps_zero, show cons true (rep (c + 1) [true, true] (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))) = rep (c + 1) [true, true] (cons true (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))) from
      rep_rotate (c + 1) [true] [true, true] [true, true] rfl (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, true] R), .A⟩ := fun _ _ => rfl
  have h5 : steps ((c + 1) * 2) ⟨rep (c + 1) [true, true] (cons true (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))), cons true (cons true (cons true (R))), .A⟩ = some ⟨cons true (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank))))))), cons true (rep (c + 1) [false, true] (cons true (cons true (R)))), .A⟩ :=
    cross_l trans c5 (c + 1) (cons true (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))))))) (cons true (cons true (R)))
  have h6 : steps 3 ⟨cons true (cons true (cons true (cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank))))))), cons true (rep (c + 1) [false, true] (cons true (cons true (R)))), .A⟩ = some ⟨cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))), cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R))))))), .C⟩ := rfl
  have h7 : steps 0 ⟨cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))), cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R))))))), .C⟩ = some ⟨rep (k + 1) [false, true, true, false, false] (cons false (cons true (cons true (blank)))), cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R))))))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (cons true (rep (k + 1) [false, false, false, true, true] (blank)))) = rep (k + 1) [false, true, true, false, false] (cons false (cons true (cons true (blank)))) from
      rep_rotate (k + 1) [false, true, true] [false, false, false, true, true] [false, true, true, false, false] rfl (blank)]
  have c8 : ∀ L R : Tape, steps 13 ⟨app [false, true, true, false, false] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true, true, true, true] R), .C⟩ := fun _ _ => rfl
  have h8 : steps ((k + 1) * 13) ⟨rep (k + 1) [false, true, true, false, false] (cons false (cons true (cons true (blank)))), cons true (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (blank))), cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R)))))))), .C⟩ :=
    cross_l trans c8 (k + 1) (cons false (cons true (cons true (blank)))) (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R)))))))
  have h9 : steps 6 ⟨cons false (cons true (cons true (blank))), cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R)))))))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (k + 1) [true, true, true, true, true] (cons true (cons false (cons true (rep (c + 1) [false, true] (cons true (cons true (R)))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

/-- Overflow of W = 2^(c+3)-1 on an even tick with last part a+3: (.., a+3) -> (.., a+1, 1) and W = 2^(c+5) + 24 (c+6 bits): the small restructure. -/
theorem small_end (a c : Nat) (L : Tape) :
    steps (4 * c + 115) ⟨rep (5 * a + 13) [false] (cons true (cons true (L))), cons false (rep (c + 3) [true, true] (blank)), .F⟩ = some ⟨cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L)))))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (c) [false, true] (cons true (blank)))))))))))))), .F⟩ := by
  have hn : 4 + (0 + ((c + 3) * 2 + (2 + ((c + 3) * 2 + (30 + (30 + (30 + (7)))))))) = 4 * c + 115 := by omega
  have h0 : steps 4 ⟨rep (5 * a + 13) [false] (cons true (cons true (L))), cons false (rep (c + 3) [true, true] (blank)), .F⟩ = some ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), cons true (rep (c + 3) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), cons true (rep (c + 3) [true, true] (blank)), .B⟩ = some ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), rep (c + 3) [true, true] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (c + 3) [true, true] (blank)) = rep (c + 3) [true, true] (cons true (blank)) from
      rep_rotate (c + 3) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((c + 3) * 2) ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), rep (c + 3) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (c + 3) [true, true] (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))), cons true (blank), .B⟩ :=
    cross_r trans c2 (c + 3) (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))) (cons true (blank))
  have h3 : steps 2 ⟨rep (c + 3) [true, true] (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))), cons true (blank), .B⟩ = some ⟨rep (c + 3) [true, true] (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))), cons true (cons true (blank)), .A⟩ := rfl
  have c4 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, true] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((c + 3) * 2) ⟨rep (c + 3) [true, true] (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), cons true (rep (c + 3) [false, true] (cons true (blank))), .A⟩ :=
    cross_l trans c4 (c + 3) (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))) (cons true (blank))
  have h5 : steps 30 ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), cons true (rep (c + 3) [false, true] (cons true (blank))), .A⟩ = some ⟨cons true (cons true (cons true (cons false (cons false (cons false (cons false (cons true (cons true (rep (5 * a + 6) [false] (cons true (cons true (L)))))))))))), cons true (cons true (cons true (rep (c + 1) [false, true] (cons true (blank))))), .A⟩ := rfl
  have h6 : steps 30 ⟨cons true (cons true (cons true (cons false (cons false (cons false (cons false (cons true (cons true (rep (5 * a + 6) [false] (cons true (cons true (L)))))))))))), cons true (cons true (cons true (rep (c + 1) [false, true] (cons true (blank))))), .A⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (rep (5 * a + 6) [false] (cons true (cons true (L)))))))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons true (rep (c) [false, true] (cons true (blank))))))))))), .A⟩ := rfl
  have h7 : steps 30 ⟨cons true (cons true (cons false (cons true (cons true (rep (5 * a + 6) [false] (cons true (cons true (L)))))))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons true (rep (c) [false, true] (cons true (blank))))))))))), .A⟩ = some ⟨rep (5 * a + 5) [false] (cons true (cons true (L))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (c) [false, true] (cons true (blank))))))))))))))))), .A⟩ := rfl
  have h8 : steps 7 ⟨rep (5 * a + 5) [false] (cons true (cons true (L))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (c) [false, true] (cons true (blank))))))))))))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L)))))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (c) [false, true] (cons true (blank)))))))))))))), .F⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- The same when a single 0 and another word follow W: the two words are joined. -/
theorem small_join (a c : Nat) (L R : Tape) :
    steps (4 * c + 115) ⟨rep (5 * a + 13) [false] (cons true (cons true (L))), cons false (rep (c + 3) [true, true] (cons false (cons true (R)))), .F⟩ = some ⟨cons false (cons false (cons false (cons true (cons true (rep (5 * a + 3) [false] (cons true (cons true (L)))))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (c) [false, true] (cons true (cons true (R))))))))))))))), .F⟩ := by
  have hn : 4 + (0 + ((c + 3) * 2 + (2 + ((c + 3) * 2 + (30 + (30 + (30 + (7)))))))) = 4 * c + 115 := by omega
  have h0 : steps 4 ⟨rep (5 * a + 13) [false] (cons true (cons true (L))), cons false (rep (c + 3) [true, true] (cons false (cons true (R)))), .F⟩ = some ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), cons true (rep (c + 3) [true, true] (cons false (cons true (R)))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), cons true (rep (c + 3) [true, true] (cons false (cons true (R)))), .B⟩ = some ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), rep (c + 3) [true, true] (cons true (cons false (cons true (R)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (c + 3) [true, true] (cons false (cons true (R)))) = rep (c + 3) [true, true] (cons true (cons false (cons true (R)))) from
      rep_rotate (c + 3) [true] [true, true] [true, true] rfl (cons false (cons true (R)))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((c + 3) * 2) ⟨cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L))))), rep (c + 3) [true, true] (cons true (cons false (cons true (R)))), .B⟩ = some ⟨rep (c + 3) [true, true] (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))), cons true (cons false (cons true (R))), .B⟩ :=
    cross_r trans c2 (c + 3) (cons true (cons true (rep (5 * a + 11) [false] (cons true (cons true (L)))))) (cons true (cons false (cons true (R))))
