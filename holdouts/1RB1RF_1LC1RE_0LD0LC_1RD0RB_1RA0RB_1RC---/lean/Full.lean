import CollideQ

/-!
# A partial macro map for 1RB1RF_1LC1RE_0LD0LC_1RD0RB_1RA0RB_1RC---

Generated by `py/gen_full.py` in the folder of 1RB0RF_1LC1RE_0LD0LC_1RD0RB_1RA0RB_0LC--- from that machine's Full.lean; do not edit by hand.

`astep` maps a Q configuration `qr W a G` (Abstract.lean: word `W` last block first, counter low part `a`, raw
gaps `G`) to the next one, where a rule proved for this machine applies, and returns `none` elsewhere.  It covers:

* the regular Q-steps (the word goes to `phi (phi W)`, the counter adds one), wide and one-unit;
* the anomaly when the counter's low part is wide enough (word one block with `a >= 1`, or a block and a single 1
  with `a >= 2`);
* the collisions in the rows of `coll` (the rows of `TABLES` in gen_collide.py for this machine).

It does NOT cover the anomaly with a one-unit counter (its rules for this machine are in Collide.lean as
`anomx_*`, on tapes, but they are not part of `astep`), nor the other collisions.  The first Q configuration of the
run from blank tape (`start`, step 27) is already such an anomaly, so `astep start = none`: the statements about
`arun ... start` below are true but say nothing yet.  `astep_sound` (each step the map returns is taken by the
machine, in at least 17 machine steps) is the useful theorem of this file.
-/

namespace H152797

open TM

theorem ite_t {α : Type} {p : Prop} [Decidable p] (h : p) (a b : α) : (if p then a else b) = a := by simp [h]
theorem ite_f {α : Type} {p : Prop} [Decidable p] (h : ¬ p) (a b : α) : (if p then a else b) = b := by simp [h]

/-- Count the leading gaps of length 2. -/
def lead2 : List Nat → Nat × List Nat
  | [] => (0, [])
  | g :: G => if g = 2 then ((lead2 G).1 + 1, (lead2 G).2) else (0, g :: G)

theorem lead2_spec : ∀ G : List Nat, G = List.replicate (lead2 G).1 2 ++ (lead2 G).2
  | [] => rfl
  | g :: G => by
    by_cases h : g = 2
    · subst h
      have e : lead2 (2 :: G) = ((lead2 G).1 + 1, (lead2 G).2) := by simp [lead2]
      rw [e, List.replicate_succ, List.cons_append, ← lead2_spec G]
    · have e : lead2 (g :: G) = (0, g :: G) := by simp [lead2, h]
      rw [e]; rfl

theorem lead2_head : ∀ (G : List Nat) (g : Nat) (G' : List Nat), (lead2 G).2 = g :: G' → g ≠ 2
  | [], _, _, h => by simp [lead2] at h
  | x :: G, g, G', h => by
    by_cases hx : x = 2
    · subst hx
      have e : lead2 (2 :: G) = ((lead2 G).1 + 1, (lead2 G).2) := by simp [lead2]
      rw [e] at h; exact lead2_head G g G' h
    · have e : lead2 (x :: G) = (0, x :: G) := by simp [lead2, hx]
      rw [e] at h; simp only [List.cons.injEq] at h; omega

/-- The blocks `3s` ones (last first). -/
abbrev ones (s : Nat) : List Nat := List.replicate (3 * s) 1

/-- The collision table: `t = 2s + p` gaps of 2 before the misaligned gap `g`, then `U` gaps of 2.  It gives the
blocks appended to the word (last first), the new low part, and how much longer the next gap is than `h` when the
old one was `h + 5`. -/
def coll : Nat → Nat → Nat → Nat → Option (List Nat × Nat × Nat)
  | s, 0, 0, 0 => some (3 :: ones s, 1, 0)
  | s, 0, 0, 1 => some (5 :: ones s, 1, 1)
  | s, 0, 0, 2 => some (1 :: 7 :: ones s, 1, 0)
  | s, 0, 0, 3 => some (3 :: 7 :: ones s, 1, 1)
  | s, 0, 1, u + 1 => some (1 :: 1 :: 1 :: ones s, u + 1, 2)
  | s, 1, 0, 0 => some (1 :: 1 :: 1 :: ones s, 1, 1)
  | s, 1, 0, 1 => some (1 :: 3 :: 1 :: 1 :: ones s, 1, 0)
  | s, 1, 0, 2 => some (3 :: 3 :: 1 :: 1 :: ones s, 1, 1)
  | s, 1, 1, 0 => some (1 :: 1 :: 1 :: 1 :: ones s, 1, 0)
  | s, 1, 1, 1 => some (3 :: 1 :: 1 :: 1 :: ones s, 1, 1)
  | _, _, _, _ => none

/-- The end of a collision, as the A phase leaves it. -/
def collEnd (L : Tape) (C : List Nat) (a' : Nat) (G' : List Nat) : Config :=
  ⟨rep a' [true, true, true] (cons false (wlx C (cons true (cons true L)))), cons false (gl G'), .B⟩

/-- Every row of the table is a theorem of `CollideQ.lean`: the gap version and the blank-tape version. -/
theorem coll_sound {s p g U : Nat} {C : List Nat} {a' d : Nat} (hc : coll s p g U = some (C, a', d)) (L : Tape) :
    (∃ n, 17 ≤ n ∧ steps n (zc L (List.replicate (2 * s + p) 2 ++ g :: (List.replicate U 2 ++ [])))
        = some (collEnd L C a' [])) ∧
    (∀ h G, ∃ n, 17 ≤ n ∧ steps n (zc L (List.replicate (2 * s + p) 2 ++ g :: (List.replicate U 2 ++ (h + 5) :: G)))
        = some (collEnd L C a' ((h + d) :: G))) := by
  unfold coll at hc
  split at hc <;> simp only [Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at hc <;> obtain ⟨rfl, rfl, rfl⟩ := hc <;>
    simp only [Nat.add_zero, collEnd]
  · exact ⟨⟨_, by omega, zcoll_e0_0_blank s L⟩, fun h G => ⟨_, by omega, zcoll_e0_0_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_e0_1_blank s L⟩, fun h G => ⟨_, by omega, zcoll_e0_1_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_e0_2_blank s L⟩, fun h G => ⟨_, by omega, zcoll_e0_2_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_e0_3_blank s L⟩, fun h G => ⟨_, by omega, zcoll_e0_3_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_e1_u1_blank s _ L⟩, fun h G => ⟨_, by omega, zcoll_e1_u1_gap h s _ G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_o0_0_blank s L⟩, fun h G => ⟨_, by omega, zcoll_o0_0_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_o0_1_blank s L⟩, fun h G => ⟨_, by omega, zcoll_o0_1_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_o0_2_blank s L⟩, fun h G => ⟨_, by omega, zcoll_o0_2_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_o1_0_blank s L⟩, fun h G => ⟨_, by omega, zcoll_o1_0_gap h s G L⟩⟩
  · exact ⟨⟨_, by omega, zcoll_o1_1_blank s L⟩, fun h G => ⟨_, by omega, zcoll_o1_1_gap h s G L⟩⟩

/-- Add 2 to the last block. -/
def bump : List Nat → List Nat
  | b :: V => (b + 2) :: V
  | [] => []

/-- The word shapes for which `phi` can be applied twice: last block odd and at least 3, or a last 1 after an odd
block that is not the first. -/
def wshape : List Nat → Bool
  | b :: x :: V => (b % 2 == 1 && 3 ≤ b) || (b == 1 && x % 2 == 1 && !V.isEmpty)
  | _ => false

/-- An abstract Q configuration. -/
structure AC where
  W : List Nat
  a : Nat
  G : List Nat

/-- Its tape. -/
def AC.enc (c : AC) : Config := qr c.W c.a c.G

/-- The new word of an anomaly: `[2, 1, …, 1]` with `c` ones (last block first). -/
abbrev fresh (x : Nat) : List Nat := List.replicate ((x - 2) / 2) 1 ++ [2]

/-- The macro map: the next Q configuration, or `none` where no proved rule applies. -/
def astep (c : AC) : Option AC :=
  match c.W with
  | [x] => if x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ c.a then some ⟨fresh x, 1, (3 * (c.a - 1)) :: c.G⟩ else none
  | [1, x] =>
    if x % 2 = 0 ∧ 2 ≤ x then
      if 2 ≤ c.a then some ⟨3 :: fresh x, 1, (3 * (c.a - 2) + 1) :: c.G⟩
      else none
    else none
  | W =>
    if wshape W then
      if 2 ≤ c.a then some ⟨phi (phi W), 1, (3 * (c.a - 2) + 2) :: c.G⟩
      else if c.a = 1 then
        match lead2 c.G with
        | (t, []) => some ⟨phi (phi W), t + 2, []⟩
        | (t, h :: G) =>
          if 3 ≤ h then some ⟨phi (phi W), t + 2, (h - 3) :: G⟩
          else if h ≤ 1 then
            match coll (t / 2) (t % 2) h (lead2 G).1, (lead2 G).2 with
            | some (C, a', _), [] => some ⟨C ++ bump (phi (phi W)), a', []⟩
            | some (C, a', d), h' :: G' => if 5 ≤ h' then some ⟨C ++ bump (phi (phi W)), a', (h' - 5 + d) :: G'⟩
                else none
            | none, _ => none
          else none
      else none
    else none

/-- `steps n c = some c'` for some `n ≥ 17` (17 is the length of the shortest macro step, an anomaly). -/
def Adv (c c' : Config) : Prop := ∃ n, 17 ≤ n ∧ steps n c = some c'

theorem adv_trans {c c' c'' : Config} (h₁ : Adv c c') (h₂ : ∃ m, steps m c' = some c'') : Adv c c'' := by
  obtain ⟨n, hn, h⟩ := h₁
  obtain ⟨m, h'⟩ := h₂
  exact ⟨n + m, by omega, steps_seq trans h h'⟩

theorem wl_bump (W : List Nat) (hW : W ≠ []) : wl (bump W) = cons true (cons true (wl W)) := by
  cases W with
  | nil => exact absurd rfl hW
  | cons b V => exact wl_two b V

theorem phi_ne_nil : ∀ W : List Nat, W ≠ [] → phi W ≠ []
  | [], h => h
  | [_], _ => by simp [phi]
  | _ :: _ :: _, _ => by simp [phi]

/-- The word phase: for a word of one of the three shapes, from `W 0 1 1 1 B>0 R` to `phi(phi W) 0 1 1 A>0 1 R`. -/
theorem wphase (W : List Nat) (hW : wshape W = true) (R : Tape) :
    Adv ⟨rep 1 [true, true, true] (cons false (wl W)), cons false R, .B⟩
      ⟨cons true (cons true (cons false (wl (phi (phi W))))), cons false (cons true R), .A⟩ := by
  match W, hW with
  | b :: x :: V, hW =>
    simp only [wshape, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq, Bool.not_eq_true',
      List.isEmpty_eq_false_iff] at hW
    rcases hW with ⟨hb, hb3⟩ | ⟨⟨rfl, hx⟩, hV⟩
    · by_cases h3 : b = 3
      · subst h3; exact ⟨_, by omega, wq_three x V R⟩
      · obtain ⟨j, rfl⟩ : ∃ j, b = 2 * j + 5 := ⟨(b - 5) / 2, by omega⟩
        exact ⟨_, by omega, wq_big j x V R⟩
    · obtain ⟨i, rfl⟩ : ∃ i, x = 2 * i + 1 := ⟨x / 2, by omega⟩
      match V, hV with
      | y :: V', _ => exact ⟨_, by omega, wq_one i y V' R⟩

/-- The wide step. -/
theorem wide (W : List Nat) (hW : wshape W = true) (a : Nat) (G : List Nat) :
    Adv (qr W (a + 2) G) (qr (phi (phi W)) 1 ((3 * a + 2) :: G)) := by
  match W, hW with
  | b :: x :: V, hW =>
    simp only [wshape, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq, Bool.not_eq_true',
      List.isEmpty_eq_false_iff] at hW
    rcases hW with ⟨hb, hb3⟩ | ⟨⟨rfl, hx⟩, hV⟩
    · by_cases h3 : b = 3
      · subst h3; exact ⟨_, by omega, qw_three a x V G⟩
      · obtain ⟨j, rfl⟩ : ∃ j, b = 2 * j + 5 := ⟨(b - 5) / 2, by omega⟩
        exact ⟨_, by omega, qw_big a j x V G⟩
    · obtain ⟨i, rfl⟩ : ∃ i, x = 2 * i + 1 := ⟨x / 2, by omega⟩
      match V, hV with
      | y :: V', _ => exact ⟨_, by omega, qw_one a i y V' G⟩

theorem wshape_ne_nil {W : List Nat} (h : wshape W = true) : W ≠ [] := by
  intro e; subst e; simp [wshape] at h

theorem fresh_eq (c : Nat) : fresh (2 * c + 2) = List.replicate c 1 ++ [2] := by
  simp only [fresh, show (2 * c + 2 - 2) / 2 = c by omega]

/-- Every step of `astep` is taken by the machine, in at least 17 machine steps. -/
theorem astep_sound (c c' : AC) (h : astep c = some c') : Adv c.enc c'.enc := by
  obtain ⟨W, a, G⟩ := c
  simp only [AC.enc]
  unfold astep at h
  split at h
  · -- one block
    rename_i x hWx
    simp only at hWx; subst hWx
    by_cases hc : x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ a
    · rw [ite_t hc] at h; cases h
      obtain ⟨c0, rfl⟩ : ∃ c0, x = 2 * c0 + 2 := ⟨(x - 2) / 2, by omega⟩
      obtain ⟨a0, rfl⟩ : ∃ a0, a = a0 + 1 := ⟨a - 1, by omega⟩
      simp only [fresh_eq, show a0 + 1 - 1 = a0 by omega]
      exact ⟨_, by omega, qa_one a0 c0 G⟩
    · rw [ite_f hc] at h; cases h
  · -- a block and a single 1
    rename_i x hWx
    simp only at hWx; subst hWx
    by_cases hx : x % 2 = 0 ∧ 2 ≤ x
    · rw [ite_t hx] at h
      obtain ⟨c0, rfl⟩ : ∃ c0, x = 2 * c0 + 2 := ⟨(x - 2) / 2, by omega⟩
      simp only [fresh_eq] at h
      by_cases ha : 2 ≤ a
      · rw [ite_t ha] at h; cases h
        obtain ⟨a0, rfl⟩ : ∃ a0, a = a0 + 2 := ⟨a - 2, by omega⟩
        simp only [show a0 + 2 - 2 = a0 by omega]
        exact ⟨_, by omega, qa_two a0 c0 G⟩
      · rw [ite_f ha] at h; cases h
    · rw [ite_f hx] at h; cases h
  · -- the regular shapes
    rename_i hne1 hne2
    by_cases hw : wshape W = true
    · rw [ite_t hw] at h
      by_cases ha : 2 ≤ a
      · rw [ite_t ha] at h; cases h
        obtain ⟨a0, rfl⟩ : ∃ a0, a = a0 + 2 := ⟨a - 2, by omega⟩
        simp only [show a0 + 2 - 2 = a0 by omega]
        exact wide W hw a0 G
      · rw [ite_f ha] at h
        by_cases h1 : a = 1
        · rw [ite_t h1] at h; subst h1
          have hs := lead2_spec G
          have wp := wphase W hw (gl G)
          split at h
          · rename_i t e; cases h; rw [e] at hs
            refine adv_trans wp ?_
            rw [hs, List.append_nil]
            exact ⟨_, zq_unit_blank t _⟩
          · rename_i t hh G0 e
            rw [e] at hs
            by_cases h3 : 3 ≤ hh
            · rw [ite_t h3] at h; cases h
              refine adv_trans wp ?_
              obtain ⟨h0, rfl⟩ : ∃ h0, hh = h0 + 3 := ⟨hh - 3, by omega⟩
              rw [hs]; simp only [show h0 + 3 - 3 = h0 by omega]
              exact ⟨_, zq_unit t h0 G0 _⟩
            · rw [ite_f h3] at h
              by_cases h1 : hh ≤ 1
              · rw [ite_t h1] at h
                have hs0 := lead2_spec G0
                have ht : t = 2 * (t / 2) + t % 2 := (Nat.div_add_mod t 2).symm
                have hne : phi (phi W) ≠ [] := phi_ne_nil _ (phi_ne_nil _ (wshape_ne_nil hw))
                refine adv_trans wp ?_
                split at h
                · rename_i C a' d hc e2; cases h
                  have hz := (coll_sound hc (wl (phi (phi W)))).1
                  rw [hs, hs0, e2, ht]
                  simp only [qr, wl_append, wl_bump _ hne]
                  obtain ⟨n, _, hz⟩ := hz
                  exact ⟨n, hz⟩
                · rename_i C a' d h' G' hc e2
                  by_cases h5 : 5 ≤ h'
                  · rw [ite_t h5] at h; cases h
                    obtain ⟨h0, rfl⟩ : ∃ h0, h' = h0 + 5 := ⟨h' - 5, by omega⟩
                    have hz := (coll_sound hc (wl (phi (phi W)))).2 h0 G'
                    rw [hs, hs0, e2, ht]
                    simp only [qr, wl_append, wl_bump _ hne, show h0 + 5 - 5 + d = h0 + d by omega]
                    obtain ⟨n, _, hz⟩ := hz
                    exact ⟨n, hz⟩
                  · rw [ite_f h5] at h; cases h
                · cases h
              · rw [ite_f h1] at h; cases h
        · rw [ite_f h1] at h; cases h
    · rw [ite_f hw] at h; cases h

/-- The abstract run: `k` steps of `astep`. -/
def arun : Nat → AC → Option AC
  | 0, c => some c
  | k + 1, c => (astep c).bind (arun k)

theorem arun_adv : ∀ (k : Nat) (c c' : AC), arun k c = some c' → ∃ n, 17 * k ≤ n ∧ steps n c.enc = some c'.enc
  | 0, c, c', h => by cases h; exact ⟨0, Nat.le_refl _, rfl⟩
  | k + 1, c, c', h => by
    simp only [arun] at h
    cases h1 : astep c with
    | none => rw [h1] at h; cases h
    | some c1 =>
      rw [h1] at h
      obtain ⟨n, hn, hs⟩ := astep_sound c c1 h1
      obtain ⟨m, hm, hs'⟩ := arun_adv k c1 c' h
      exact ⟨n + m, by omega, steps_seq trans hs hs'⟩

/-- The first Q configuration of the run from blank tape: `1^2 0 1 0 1^3 B>0`, at step 27. -/
def start : AC := ⟨[1, 2], 1, []⟩

theorem start_reached : steps 27 init = some start.enc := by
  have h : TM.fsteps trans 27 (FCfg.blank St.A) = some ⟨[true, true, true, false, true, false, true, true], [],
      St.B⟩ := by decide
  have h2 := blank_reaches trans h
  rw [show steps 27 init = TM.steps trans 27 (blankCfg St.A) from rfl, h2]
  simp only [AC.enc, start, qr, wl, gl, rep_succ, rep_zero, app_cons, app_nil, cons_false_blank, FCfg.toCfg]

/-- If the abstract run from the first Q configuration never fails, the machine does not halt from blank tape. -/
theorem not_halts_of_arun (h : ∀ k, (arun k start).isSome) : ¬ HaltsFromBlank := by
  apply not_halts_of_forall
  intro n
  have hk := h n
  cases e : arun n start with
  | none => rw [e] at hk; cases hk
  | some c =>
    obtain ⟨m, hm, hs⟩ := arun_adv n start c e
    have h3 := steps_seq trans start_reached hs
    have e2 : 27 + m = n + (27 + m - n) := by omega
    rw [e2] at h3
    exact steps_le trans h3

/-- A bounded version: if `k` steps of the abstract run succeed, the machine does not halt in its first
`27 + 17 k` steps. -/
theorem runs_of_arun (k : Nat) (h : (arun k start).isSome) : ∃ c, steps (27 + 17 * k) init = some c := by
  cases e : arun k start with
  | none => rw [e] at h; cases h
  | some c =>
    obtain ⟨m, hm, hs⟩ := arun_adv k start c e
    have h3 := steps_seq trans start_reached hs
    have e2 : 27 + m = (27 + 17 * k) + (m - 17 * k) := by omega
    rw [e2] at h3
    exact steps_le trans h3

/-- The abstract run as a loop (for compiled evaluation). -/
def arunB : Nat → AC → Bool
  | 0, _ => true
  | k + 1, c => match astep c with
    | some c' => arunB k c'
    | none => false

theorem arunB_sound : ∀ (k : Nat) (c : AC), arunB k c = true → (arun k c).isSome
  | 0, _, _ => rfl
  | k + 1, c, h => by
    simp only [arunB] at h
    simp only [arun]
    cases e : astep c with
    | none => rw [e] at h; cases h
    | some c' => rw [e] at h; exact arunB_sound k c' h

end H152797
