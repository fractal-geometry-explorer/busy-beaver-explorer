      rep_rotate (s) [false, true] [false, false, true, false, false, true] [false, true, false, false, true, false] rfl (cons true (rep (h + 5) [false] (cons true (R))))]
  have c1 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, false, false, true, false] R, .A⟩ = some ⟨app [] (app [true, true, true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
