  have h3 : steps ((b + 1) * 2) ⟨cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank))))), rep (b + 1) [true, false] (rep (c + 2) [true] (blank)), .B⟩ = some ⟨rep (b + 1) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank)))))), rep (c + 2) [true] (blank), .B⟩ :=
    cross_r trans c3 (b + 1) (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank)))))) (rep (c + 2) [true] (blank))
  have h4 : steps 2 ⟨rep (b + 1) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank)))))), rep (c + 2) [true] (blank), .B⟩ = some ⟨rep (b + 1) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank)))))), cons false (cons true (rep (c) [true] (blank))), .D⟩ := rfl
