  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, false] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((b) * 2) ⟨rep (b) [true, false] (cons true (cons false (cons false (rep (a + 3) [true] (blank))))), cons false (rep (1) [true] (blank)), .D⟩ = some ⟨cons true (cons false (cons false (rep (a + 3) [true] (blank)))), cons false (rep (b) [true, false] (rep (1) [true] (blank))), .D⟩ :=
