  have h5 : steps 7 ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (1) [true] (blank))))))), cons false (rep (1) [true] (blank)), .A⟩ = some ⟨cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (1) [true] (blank)))))))), cons false (cons false (cons true (cons true (blank)))), .B⟩ := rfl
