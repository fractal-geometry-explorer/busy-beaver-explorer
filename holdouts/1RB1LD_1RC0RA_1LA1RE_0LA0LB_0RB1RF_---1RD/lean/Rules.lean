    simp only [steps_zero, show cons true (rep (b + 1) [false, true] (cons false (cons false (rep (a + 3) [true] (blank))))) = rep (b + 1) [true, false] (cons true (cons false (cons false (rep (a + 3) [true] (blank))))) from
      rep_rotate (b + 1) [true] [false, true] [true, false] rfl (cons false (cons false (rep (a + 3) [true] (blank))))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, false] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((b + 1) * 2) ⟨rep (b + 1) [true, false] (cons true (cons false (cons false (rep (a + 3) [true] (blank))))), cons false (rep (c + 2) [true] (blank)), .D⟩ = some ⟨cons true (cons false (cons false (rep (a + 3) [true] (blank)))), cons false (rep (b + 1) [true, false] (rep (c + 2) [true] (blank))), .D⟩ :=
    cross_l trans c1 (b + 1) (cons true (cons false (cons false (rep (a + 3) [true] (blank))))) (rep (c + 2) [true] (blank))
  have h2 : steps 7 ⟨cons true (cons false (cons false (rep (a + 3) [true] (blank)))), cons false (rep (b + 1) [true, false] (rep (c + 2) [true] (blank))), .D⟩ = some ⟨cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank))))), rep (b + 1) [true, false] (rep (c + 2) [true] (blank)), .B⟩ := rfl
