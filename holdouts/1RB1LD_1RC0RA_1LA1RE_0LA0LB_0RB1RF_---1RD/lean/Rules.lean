/-- Y(a+3,b+1,c+2) -> Y(a+6,b,c+1) -/
theorem y_bulk (a b c : Nat) :
    steps (4 * b + 13) ⟨cons true (rep (b + 1) [false, true] (cons false (cons false (rep (a + 3) [true] (blank))))), cons false (rep (c + 2) [true] (blank)), .D⟩ = some ⟨rep (b + 1) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank)))))), cons false (cons true (rep (c) [true] (blank))), .D⟩ := by
