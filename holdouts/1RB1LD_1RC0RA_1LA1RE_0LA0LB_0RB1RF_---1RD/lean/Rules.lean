  have h4 : steps 5 ⟨rep (b) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank)))))), rep (1) [true] (blank), .B⟩ = some ⟨cons false (rep (b) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank))))))), cons true (cons true (cons true (blank))), .D⟩ := rfl
  have h5 : steps 0 ⟨cons false (rep (b) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank))))))), cons true (cons true (cons true (blank))), .D⟩ = some ⟨rep (b) [false, true] (cons false (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank))))))), cons true (cons true (cons true (blank))), .D⟩ := by
