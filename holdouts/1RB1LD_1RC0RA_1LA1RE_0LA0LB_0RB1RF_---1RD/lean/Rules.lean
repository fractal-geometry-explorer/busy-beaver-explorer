      rep_rotate (b) [false] [true, false] [false, true] rfl (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank))))))]
  have c6 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, true] R), .D⟩ := fun _ _ => rfl
