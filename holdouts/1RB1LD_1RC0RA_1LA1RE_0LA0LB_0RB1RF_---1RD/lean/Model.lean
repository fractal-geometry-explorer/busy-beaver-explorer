import Rules

/-!
# 1RB1LD_1RC0RA_1LA1RE_0LA0LB_0RB1RF_---1RD as a machine with three counters

Every time the head turns left into state D, the tape is one of

* `X(a,b,c) = 0^inf 1^a 0  (10)^b 1 D> 0 1^c 0^inf`
* `Y(a,b,c) = 0^inf 1^a 00 (10)^b 1 D> 0 1^c 0^inf`
* `Z(a,c)   = 0^inf 1^a 0 D> 0 1^c 0^inf`

`Rules.lean` (generated by `py/gen_rules.py`) proves, for all values, how each of these goes to the next one; here
they are collected into the map `nxt` on the states `St3` and chained.  In `St3` the counts are shifted so that every
state is one the rules cover: `X a b c` is `X(a,b,c+1)`, `Y a b c` is `Y(a+3,b,c+1)`, `Z a c` is `Z(a+3,c+1)`.
`nxt` is `none` exactly at `Z(a,2)`, where the machine halts five steps later.

From blank tape the machine is at `X(2,0,3)` after 29 steps (`blank_to_X`).  The result is `halts_iff`: the machine
halts from blank tape if and only if the orbit of `X 2 0 2` under `nxt` reaches a halting state.
-/

namespace H28830

open TM

/-- `0^inf 1^a 0 (10)^b 1 D> 0 1^c 0^inf`. -/
def Xc (a b c : Nat) : Config := ⟨cons true (rep b [false, true] (cons false (rep a [true] blank))), cons false (rep c [true] blank), .D⟩
/-- `0^inf 1^a 00 (10)^b 1 D> 0 1^c 0^inf`. -/
def Yc (a b c : Nat) : Config :=
  ⟨cons true (rep b [false, true] (cons false (cons false (rep a [true] blank)))), cons false (rep c [true] blank), .D⟩
/-- `0^inf 1^a 0 D> 0 1^c 0^inf`. -/
def Zc (a c : Nat) : Config := ⟨cons false (rep a [true] blank), cons false (rep c [true] blank), .D⟩

/-- The register states, with shifted counts (see the header). -/
inductive St3 where
  | X (a b c : Nat)
  | Y (a b c : Nat)
  | Z (a c : Nat)
  deriving DecidableEq, Repr

def cfg : St3 → Config
  | .X a b c => Xc a b (c + 1)
  | .Y a b c => Yc (a + 3) b (c + 1)
  | .Z a c => Zc (a + 3) (c + 1)

/-- The next state; `none` where the machine halts.  In real counts:
X(a+4,b,c+2)→X(a+1,b+2,c+1), X(3,b,c+2)→X(1,b+1,c+1), X(2,b,c+2)→X(2,b+2,c+1), X(1,b,c+2)→Y(3,b,c+1),
X(0,0,c+2)→Z(3,c+1); X(a+5,b,1)→X(a,0,2b+9), X(4,b,1)→X(4,0,2b+7), X(3,b,1)→X(4,0,2b+5), X(2,b,1)→X(0,0,2b+9),
X(1,b,1)→X(1,0,2b+5); Y(a,b+1,c+2)→Y(a+3,b,c+1), Y(a,0,c+2)→Z(a+3,c+1), Y(a,b,1)→X(a,1,2b+3);
Z(a,c+6)→X(a+4,0,c+1), Z(a,1)→X(a,1,1), Z(a,2) halts, Z(a,3)→X(a,0,5), Z(a,4)→X(a+2,0,3), Z(a,5)→X(a+2,0,5).
`X(0,b+1,c)` is the same tape as `X(1,b,c)`. -/
def nxt : St3 → Option St3
  | .X (a + 4) b (c + 1) => some (.X (a + 1) (b + 2) c)
  | .X 3 b (c + 1) => some (.X 1 (b + 1) c)
  | .X 2 b (c + 1) => some (.X 2 (b + 2) c)
  | .X 1 b (c + 1) => some (.Y 0 b c)
  | .X 0 0 (c + 1) => some (.Z 0 c)
  | .X 0 (b + 1) (c + 1) => some (.Y 0 b c)
  | .X (a + 5) b 0 => some (.X a 0 (2 * b + 8))
  | .X 4 b 0 => some (.X 4 0 (2 * b + 6))
  | .X 3 b 0 => some (.X 4 0 (2 * b + 4))
  | .X 2 b 0 => some (.X 0 0 (2 * b + 8))
  | .X 1 b 0 => some (.X 1 0 (2 * b + 4))
  | .X 0 0 0 => some (.X 1 0 2)
  | .X 0 (b + 1) 0 => some (.X 1 0 (2 * b + 4))
  | .Y a (b + 1) (c + 1) => some (.Y (a + 3) b c)
  | .Y a 0 (c + 1) => some (.Z (a + 3) c)
  | .Y a b 0 => some (.X (a + 3) 1 (2 * b + 2))
  | .Z a (c + 5) => some (.X (a + 7) 0 c)
  | .Z a 0 => some (.X (a + 3) 1 0)
  | .Z _ 1 => none
  | .Z a 2 => some (.X (a + 3) 0 4)
  | .Z a 3 => some (.X (a + 5) 0 2)
  | .Z a 4 => some (.X (a + 5) 0 4)

theorem rot_ft (b : Nat) (s : Tape) : cons true (rep b [false, true] s) = rep b [true, false] (cons true s) :=
  rep_rotate b [true] [false, true] [true, false] rfl s

theorem ones_end (b : Nat) : rep b [true, true] (cons true (cons true blank)) = rep (2 * b + 2) [true] blank := by
  induction b with
  | zero => rfl
  | succ b ih =>
    rw [rep_succ, ih, show 2 * (b + 1) + 2 = (2 * b + 2) + 2 by omega]; rfl

theorem x0_eq (b c : Nat) : cfg (.X 0 (b + 1) c) = cfg (.X 1 b c) := by
  simp only [cfg, Xc]
  rw [← rep_app_comm b [false, true]]
  show (⟨cons true (rep b [false, true] (cons false (cons true (cons false blank)))), _, _⟩ : Config) = _
  rw [cons_false_blank]; rfl

/-! ## Each rule in the shape of `cfg` -/

theorem r_x_bulk (a b c : Nat) : steps (4 * b + 13) (cfg (.X (a + 4) b (c + 1))) = some (cfg (.X (a + 1) (b + 2) c)) := by
  have h := x_bulk a b c
  have e : cfg (.X (a + 1) (b + 2) c) = ⟨cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (a + 1) [true] (blank)))))))), cons false (cons true (rep (c) [true] (blank))), .D⟩ := by
    simp only [cfg, Xc]; rw [rep_add b 2]; rfl
  rw [e]; exact h

theorem r_x_three (b c : Nat) : steps (4 * b + 13) (cfg (.X 3 b (c + 1))) = some (cfg (.X 1 (b + 1) c)) := by
  have h := x_three b c
  rw [cons_false_blank] at h
  have e : cfg (.X 1 (b + 1) c) = ⟨cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (blank)))))), cons false (cons true (rep (c) [true] (blank))), .D⟩ := by
    simp only [cfg, Xc]; rw [rep_add b 1]; rfl
  rw [e]; exact h

theorem r_x_two (b c : Nat) : steps (4 * b + 25) (cfg (.X 2 b (c + 1))) = some (cfg (.X 2 (b + 2) c)) := by
  have h := x_two b c
  have e : cfg (.X 2 (b + 2) c) = ⟨cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), cons false (cons true (rep (c) [true] (blank))), .D⟩ := by
    simp only [cfg, Xc]; rw [rep_add b 2]; rfl
  rw [e]; exact h

theorem r_x_one (b c : Nat) : steps (4 * b + 13) (cfg (.X 1 b (c + 1))) = some (cfg (.Y 0 b c)) := x_one b c

theorem r_x_zero0 (c : Nat) : steps 9 (cfg (.X 0 0 (c + 1))) = some (cfg (.Z 0 c)) := x_zero0 c

theorem r_xe_big (a b : Nat) : steps (8 * b + 37) (cfg (.X (a + 5) b 0)) = some (cfg (.X a 0 (2 * b + 8))) := by
  have h := xe_big a b
  rw [ones_end] at h
  exact h

theorem r_xe_4 (b : Nat) : steps (8 * b + 47) (cfg (.X 4 b 0)) = some (cfg (.X 4 0 (2 * b + 6))) := by
  have h := xe_4 b
  rw [ones_end] at h
  exact h

theorem r_xe_3 (b : Nat) : steps (8 * b + 43) (cfg (.X 3 b 0)) = some (cfg (.X 4 0 (2 * b + 4))) := by
  have h := xe_3 b
  rw [ones_end] at h
  exact h

theorem r_xe_2 (b : Nat) : steps (8 * b + 49) (cfg (.X 2 b 0)) = some (cfg (.X 0 0 (2 * b + 8))) := by
  have h := xe_2 b
  rw [ones_end] at h
  exact h

theorem r_xe_1 (b : Nat) : steps (8 * b + 33) (cfg (.X 1 b 0)) = some (cfg (.X 1 0 (2 * b + 4))) := by
  have h := xe_1 b
  rw [ones_end, cons_false_blank] at h
  exact h

theorem r_xe_00 : steps 25 (cfg (.X 0 0 0)) = some (cfg (.X 1 0 2)) := by
  have h := xe_00
  rw [cons_false_blank] at h
  exact h

theorem r_y_bulk (a b c : Nat) : steps (4 * b + 13) (cfg (.Y a (b + 1) (c + 1))) = some (cfg (.Y (a + 3) b c)) := by
  have h := y_bulk a b c
  have e : cfg (.Y (a + 3) b c) = ⟨rep (b + 1) [true, false] (cons false (cons true (cons true (cons true (rep (a + 3) [true] (blank)))))), cons false (cons true (rep (c) [true] (blank))), .D⟩ := by
    simp only [cfg, Yc]; rw [rot_ft, ← rep_app_comm b [true, false]]; rfl
  rw [e]; exact h

theorem r_y_zero (a c : Nat) : steps 9 (cfg (.Y a 0 (c + 1))) = some (cfg (.Z (a + 3) c)) := y_zero a c

theorem r_ye (a b : Nat) : steps (8 * b + 25) (cfg (.Y a b 0)) = some (cfg (.X (a + 3) 1 (2 * b + 2))) := by
  have h := ye a b
  rw [ones_end] at h
  exact h

theorem r_z_big (a c : Nat) : steps 11 (cfg (.Z a (c + 5))) = some (cfg (.X (a + 7) 0 c)) := z_big a c
theorem r_z_1 (a : Nat) : steps 17 (cfg (.Z a 0)) = some (cfg (.X (a + 3) 1 0)) := z_1 a
theorem r_z_3 (a : Nat) : steps 29 (cfg (.Z a 2)) = some (cfg (.X (a + 3) 0 4)) := z_3 a
theorem r_z_4 (a : Nat) : steps 21 (cfg (.Z a 3)) = some (cfg (.X (a + 5) 0 2)) := z_4 a
theorem r_z_5 (a : Nat) : steps 27 (cfg (.Z a 4)) = some (cfg (.X (a + 5) 0 4)) := z_5 a

/-! ## The map is the machine -/

theorem rule_some : ∀ (s s' : St3), nxt s = some s' → ∃ n, 0 < n ∧ steps n (cfg s) = some (cfg s')
  | .X (a + 4) b (c + 1), _, h => by cases h; exact ⟨_, by omega, r_x_bulk a b c⟩
  | .X 3 b (c + 1), _, h => by cases h; exact ⟨_, by omega, r_x_three b c⟩
  | .X 2 b (c + 1), _, h => by cases h; exact ⟨_, by omega, r_x_two b c⟩
  | .X 1 b (c + 1), _, h => by cases h; exact ⟨_, by omega, r_x_one b c⟩
  | .X 0 0 (c + 1), _, h => by cases h; exact ⟨_, by omega, r_x_zero0 c⟩
  | .X 0 (b + 1) (c + 1), _, h => by cases h; rw [x0_eq]; exact ⟨_, by omega, r_x_one b c⟩
  | .X (a + 5) b 0, _, h => by cases h; exact ⟨_, by omega, r_xe_big a b⟩
  | .X 4 b 0, _, h => by cases h; exact ⟨_, by omega, r_xe_4 b⟩
  | .X 3 b 0, _, h => by cases h; exact ⟨_, by omega, r_xe_3 b⟩
  | .X 2 b 0, _, h => by cases h; exact ⟨_, by omega, r_xe_2 b⟩
  | .X 1 b 0, _, h => by cases h; exact ⟨_, by omega, r_xe_1 b⟩
  | .X 0 0 0, _, h => by cases h; exact ⟨_, by omega, r_xe_00⟩
  | .X 0 (b + 1) 0, _, h => by cases h; rw [x0_eq]; exact ⟨_, by omega, r_xe_1 b⟩
  | .Y a (b + 1) (c + 1), _, h => by cases h; exact ⟨_, by omega, r_y_bulk a b c⟩
  | .Y a 0 (c + 1), _, h => by cases h; exact ⟨_, by omega, r_y_zero a c⟩
  | .Y a 0 0, _, h => by cases h; exact ⟨_, by omega, r_ye a 0⟩
  | .Y a (b + 1) 0, _, h => by cases h; exact ⟨_, by omega, r_ye a (b + 1)⟩
  | .Z a (c + 5), _, h => by cases h; exact ⟨_, by omega, r_z_big a c⟩
  | .Z a 0, _, h => by cases h; exact ⟨_, by omega, r_z_1 a⟩
  | .Z _ 1, _, h => by cases h
  | .Z a 2, _, h => by cases h; exact ⟨_, by omega, r_z_3 a⟩
  | .Z a 3, _, h => by cases h; exact ⟨_, by omega, r_z_4 a⟩
  | .Z a 4, _, h => by cases h; exact ⟨_, by omega, r_z_5 a⟩

theorem rule_none : ∀ (s : St3), nxt s = none → ∃ n c, steps n (cfg s) = some c ∧ step c = none
  | .Z a 1, _ => ⟨5, _, z_halt a, rfl⟩
  | .X (_ + 4) _ (_ + 1), h | .X 3 _ (_ + 1), h | .X 2 _ (_ + 1), h | .X 1 _ (_ + 1), h | .X 0 0 (_ + 1), h
  | .X 0 (_ + 1) (_ + 1), h | .X (_ + 5) _ 0, h | .X 4 _ 0, h | .X 3 _ 0, h | .X 2 _ 0, h | .X 1 _ 0, h
  | .X 0 0 0, h | .X 0 (_ + 1) 0, h | .Y _ (_ + 1) (_ + 1), h | .Y _ 0 (_ + 1), h | .Y _ 0 0, h | .Y _ (_ + 1) 0, h
  | .Z _ (_ + 5), h | .Z _ 0, h | .Z _ 2, h | .Z _ 3, h | .Z _ 4, h => by cases h

/-- From blank tape: `X(2,0,3)` after 29 steps. -/
theorem blank_to_X : steps 29 init = some (cfg (.X 2 0 2)) :=
  blank_reaches trans (n := 29) (q := .A) (c := ⟨[true, false, true, true], [false, true, true, true], .D⟩) (by decide +kernel)

/-- The orbit of the first state under `nxt` (`none` once it has halted). -/
def orbit : Nat → Option St3
  | 0 => some (.X 2 0 2)
  | n + 1 => match orbit n with
    | none => none
    | some s => nxt s

theorem reach (n : Nat) : ∀ s, orbit n = some s → ∃ T, n ≤ T ∧ steps T init = some (cfg s) := by
  induction n with
  | zero =>
    intro s h
    simp only [orbit, Option.some.injEq] at h
    subst h
    exact ⟨29, by omega, blank_to_X⟩
  | succ n ih =>
    intro s' h
    simp only [orbit] at h
    split at h
    · cases h
    · rename_i s hs
      obtain ⟨T, hT, hT'⟩ := ih s hs
      obtain ⟨r, hr, hr'⟩ := rule_some s s' h
      exact ⟨T + r, by omega, steps_seq trans hT' hr'⟩

theorem not_halts_of_orbit (h : ∀ n, orbit n ≠ none) : ¬ HaltsFromBlank := by
  apply not_halts_of_forall
  apply forall_of_unbounded trans (fun T => ∃ c, steps T init = some c)
  · intro n
    cases e : orbit n with
    | none => exact absurd e (h n)
    | some s =>
      obtain ⟨T, hT, hs⟩ := reach n s e
      exact ⟨T, hT, _, hs⟩
  · intro m hm; exact hm

theorem halts_of_orbit (n : Nat) (h : orbit n = none) : HaltsFromBlank := by
  induction n with
  | zero => simp [orbit] at h
  | succ n ih =>
    simp only [orbit] at h
    split at h
    · exact ih (by assumption)
    · rename_i s hs
      obtain ⟨T, -, hT⟩ := reach n s hs
      obtain ⟨r, c, hr, hc⟩ := rule_none s h
      exact ⟨T + r, c, steps_seq trans hT hr, hc⟩

/-- The reduction: the machine halts from blank tape if and only if the orbit of `X 2 0 2` (the tape `X(2,0,3)`)
under `nxt` reaches a state where `nxt` is `none`, i.e. the tape `Z(a,2) = 0^inf 1^a 0 D> 0 1 1 0^inf`. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ n, orbit n = none := by
  constructor
  · intro hh
    exact Classical.byContradiction fun hne => not_halts_of_orbit (fun n hn => hne ⟨n, hn⟩) hh
  · rintro ⟨n, hn⟩
    exact halts_of_orbit n hn

end H28830
