/-- A round that starts with exactly two 1s on blank tape reaches D on blank tape, which halts. -/
theorem l_dhalt (m : Nat) :
    steps (2 * m + 3) ⟨blank, cons false (rep (m) [true, false] (cons true (cons true (blank)))), .C⟩ = some ⟨cons false (cons true (cons true (rep (m) [true, true] (blank)))), blank, .D⟩ := by
  have hn : 0 + ((m) * 2 + (3)) = 2 * m + 3 := by omega
  have h0 : steps 0 ⟨blank, cons false (rep (m) [true, false] (cons true (cons true (blank)))), .C⟩ = some ⟨blank, rep (m) [false, true] (cons false (cons true (cons true (blank)))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (m) [true, false] (cons true (cons true (blank)))) = rep (m) [false, true] (cons false (cons true (cons true (blank)))) from
      rep_rotate (m) [false] [true, false] [false, true] rfl (cons true (cons true (blank)))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, true] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((m) * 2) ⟨blank, rep (m) [false, true] (cons false (cons true (cons true (blank)))), .C⟩ = some ⟨rep (m) [true, true] (blank), cons false (cons true (cons true (blank))), .C⟩ :=
    cross_r trans c1 (m) (blank) (cons false (cons true (cons true (blank))))
  have h2 : steps 3 ⟨rep (m) [true, true] (blank), cons false (cons true (cons true (blank))), .C⟩ = some ⟨cons false (cons true (cons true (rep (m) [true, true] (blank)))), blank, .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

