import Machine

/-! The bouncer cycle of 1RB0RA_0RC0LB_1LD1RF_1LE1RA_1RD1RB_1LA---, proved by `bbtools.symtm` for every value of the counts (words a = 11010, b = 10000, c = 10 read left to right; in Lean the left tape is listed from the head outward). -/

namespace H97509

open TM

/-- One block cycle: with the head in C at the right end after `b^(n+1) 1 a^(m+1) 1 c 1 a^(k+1) 0^4 c`, two sweeps turn the last b of the block into an a and lengthen the last a-run by one, in 50k + 50m + 287 steps; the rest of the tape (L) is never read. -/
theorem sweep (k m n : Nat) (L : Tape) :
    steps (50 * k + 50 * m + 287) ⟨cons false (cons true (cons false (cons false (cons false (cons false (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))))))))))), blank, .C⟩ = some ⟨cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons true (cons true (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))))))))))))))))), blank, .C⟩ := by
  have hn : 40 + (19 + (0 + ((k + 1) * 13 + (10 + (0 + ((m + 1) * 13 + (40 + (2 + (0 + ((m + 1) * 37 + (36 + (0 + ((k + 1) * 37 + (40)))))))))))))) = 50 * k + 50 * m + 287 := by omega
  have h0 : steps 40 ⟨cons false (cons true (cons false (cons false (cons false (cons false (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))))))))))), blank, .C⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons true (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))))))))))), cons false (cons false (cons false (cons true (blank)))), .B⟩ := rfl
  have h1 : steps 19 ⟨cons false (cons false (cons true (cons false (cons true (cons true (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))))))))))), cons false (cons false (cons false (cons true (blank)))), .B⟩ = some ⟨cons false (cons true (cons true (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))))), cons true (cons true (cons true (cons false (cons false (cons true (cons false (blank))))))), .E⟩ := rfl
  have h2 : steps 0 ⟨cons false (cons true (cons true (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))))), cons true (cons true (cons true (cons false (cons false (cons true (cons false (blank))))))), .E⟩ = some ⟨rep (k + 1) [false, true, true, false, true] (cons false (cons true (cons true (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))))), cons true (cons true (cons true (cons false (cons false (cons true (cons false (blank))))))), .E⟩ := by
    simp only [steps_zero, show cons false (cons true (cons true (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))))) = rep (k + 1) [false, true, true, false, true] (cons false (cons true (cons true (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))))) from
      rep_rotate (k + 1) [false, true, true] [false, true, false, true, true] [false, true, true, false, true] rfl (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))]
  have c3 : ∀ L R : Tape, steps 13 ⟨app [false, true, true, false, true] L, app [true, true] R, .E⟩ = some ⟨L, app [true, true] (app [true, false, false, true, false] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((k + 1) * 13) ⟨rep (k + 1) [false, true, true, false, true] (cons false (cons true (cons true (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))))), cons true (cons true (cons true (cons false (cons false (cons true (cons false (blank))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))))))), cons true (cons true (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))), .E⟩ :=
    cross_l trans c3 (k + 1) (cons false (cons true (cons true (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L))))))))))) (cons true (cons false (cons false (cons true (cons false (blank))))))
  have h4 : steps 10 ⟨cons false (cons true (cons true (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))))))), cons true (cons true (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))), .E⟩ = some ⟨cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))), cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))))))), .B⟩ := rfl
  have h5 : steps 0 ⟨cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))), cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))))))), .B⟩ = some ⟨rep (m + 1) [false, true, true, false, true] (cons false (cons true (cons true (cons true (rep (n + 1) [false, false, false, false, true] (L)))))), cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))))))), .B⟩ := by
    simp only [steps_zero, show cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons true (rep (n + 1) [false, false, false, false, true] (L)))))) = rep (m + 1) [false, true, true, false, true] (cons false (cons true (cons true (cons true (rep (n + 1) [false, false, false, false, true] (L)))))) from
      rep_rotate (m + 1) [false, true, true] [false, true, false, true, true] [false, true, true, false, true] rfl (cons true (rep (n + 1) [false, false, false, false, true] (L)))]
  have c6 : ∀ L R : Tape, steps 13 ⟨app [false, true, true, false, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, true, false, false, true] R), .B⟩ := fun _ _ => rfl
  have h6 : steps ((m + 1) * 13) ⟨rep (m + 1) [false, true, true, false, true] (cons false (cons true (cons true (cons true (rep (n + 1) [false, false, false, false, true] (L)))))), cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))))))), .B⟩ = some ⟨cons false (cons true (cons true (cons true (rep (n + 1) [false, false, false, false, true] (L))))), cons true (rep (m + 1) [false, true, false, false, true] (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))), .B⟩ :=
    cross_l trans c6 (m + 1) (cons false (cons true (cons true (cons true (rep (n + 1) [false, false, false, false, true] (L)))))) (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))
  have h7 : steps 40 ⟨cons false (cons true (cons true (cons true (rep (n + 1) [false, false, false, false, true] (L))))), cons true (rep (m + 1) [false, true, false, false, true] (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))), cons true (cons true (cons true (rep (m + 1) [false, true, false, false, true] (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))))), .A⟩ := rfl
  have h8 : steps 2 ⟨cons false (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))), cons true (cons true (cons true (rep (m + 1) [false, true, false, false, true] (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))), cons true (rep (m + 1) [false, true, false, false, true] (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))), .A⟩ := rfl
  have h9 : steps 0 ⟨cons false (cons false (cons false (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))), cons true (rep (m + 1) [false, true, false, false, true] (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))), rep (m + 1) [true, false, true, false, false] (cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))), .A⟩ := by
    simp only [steps_zero, show cons true (rep (m + 1) [false, true, false, false, true] (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))) = rep (m + 1) [true, false, true, false, false] (cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))) from
      rep_rotate (m + 1) [true] [false, true, false, false, true] [true, false, true, false, false] rfl (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))]
  have c10 : ∀ L R : Tape, steps 37 ⟨app [false, false, false] L, app [true, false, true, false, false] R, .A⟩ = some ⟨app [false, false, false] (app [false, true, false, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h10 : steps ((m + 1) * 37) ⟨cons false (cons false (cons false (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))), rep (m + 1) [true, false, true, false, false] (cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank))))))))))))), .A⟩ = some ⟨cons false (cons false (cons false (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L))))))))))), cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))))))), .A⟩ :=
    cross_r trans c10 (m + 1) (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))) (cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))))))))
  have h11 : steps 36 ⟨cons false (cons false (cons false (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L))))))))))), cons true (cons false (cons false (cons false (cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L))))))))))))))), cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))), .A⟩ := rfl
  have h12 : steps 0 ⟨cons false (cons false (cons false (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L))))))))))))))), cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L))))))))))))))), rep (k + 1) [true, false, true, false, false] (cons true (cons false (cons true (cons false (cons false (cons true (cons false (blank)))))))), .A⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (k + 1) [true, false, false, true, false] (cons true (cons false (cons false (cons true (cons false (blank)))))))) = rep (k + 1) [true, false, true, false, false] (cons true (cons false (cons true (cons false (cons false (cons true (cons false (blank)))))))) from
      rep_rotate (k + 1) [true, false] [true, false, false, true, false] [true, false, true, false, false] rfl (cons true (cons false (cons false (cons true (cons false (blank))))))]
  have c13 : ∀ L R : Tape, steps 37 ⟨app [false, false, false] L, app [true, false, true, false, false] R, .A⟩ = some ⟨app [false, false, false] (app [false, true, false, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h13 : steps ((k + 1) * 37) ⟨cons false (cons false (cons false (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L))))))))))))))), rep (k + 1) [true, false, true, false, false] (cons true (cons false (cons true (cons false (cons false (cons true (cons false (blank)))))))), .A⟩ = some ⟨cons false (cons false (cons false (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))))))))), cons true (cons false (cons true (cons false (cons false (cons true (cons false (blank))))))), .A⟩ :=
    cross_r trans c13 (k + 1) (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L))))))))))))) (cons true (cons false (cons true (cons false (cons false (cons true (cons false (blank))))))))
  have h14 : steps 40 ⟨cons false (cons false (cons false (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))))))))), cons true (cons false (cons true (cons false (cons false (cons true (cons false (blank))))))), .A⟩ = some ⟨cons false (cons true (cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons true (cons true (rep (k + 1) [false, true, false, true, true] (cons true (cons false (cons true (cons true (rep (m + 1) [false, true, false, true, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (n) [false, false, false, false, true] (L)))))))))))))))))))))))), blank, .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (steps_seq trans h12 (steps_seq trans h13 (h14)))))))))))))))

end H97509
