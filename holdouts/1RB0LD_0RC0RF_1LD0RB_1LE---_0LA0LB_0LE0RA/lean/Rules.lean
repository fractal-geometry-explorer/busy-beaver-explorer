import Machine

/-! # Shift rules of 1RB0LD_0RC0RF_1LD0RB_1LE---_0LA0LB_0LE0RA

The two conversions of the bouncer: going right, C turns every `1111` into `1000` (`pack`, 10 steps a copy);
going left, E turns every `0001` back into `1111` (`unpack`, 28 steps a copy).  The halting situations: only D
reading a 1 halts, and `1 A> 1`, `1 C> 0` and `1 1 E> 0` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H163738

open TM

/-- Going right, C turns each `1111` into `1000`, ten steps a copy. -/
theorem pack (n : Nat) (L R : Tape) :
    steps (10 * n) ⟨L, rep (n) [true, true, true, true] (R), .C⟩ = some ⟨rep (n) [false, false, false, true] (L), R, .C⟩ := by
  have hn : (n) * 10 = 10 * n := by omega
  have c0 : ∀ L R : Tape, steps 10 ⟨app [] L, app [true, true, true, true] R, .C⟩ = some ⟨app [] (app [false, false, false, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 10) ⟨L, rep (n) [true, true, true, true] (R), .C⟩ = some ⟨rep (n) [false, false, false, true] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- Going left, E (with `00` ahead) turns each `0001` back into `1111`, 28 steps a copy. -/
theorem unpack (n : Nat) (L R : Tape) :
    steps (28 * n) ⟨rep (n) [true, false, false, false] (L), cons false (cons false (R)), .E⟩ = some ⟨L, cons false (cons false (rep (n) [true, true, true, true] (R))), .E⟩ := by
  have hn : (n) * 28 = 28 * n := by omega
  have c0 : ∀ L R : Tape, steps 28 ⟨app [true, false, false, false] L, app [false, false] R, .E⟩ = some ⟨L, app [false, false] (app [true, true, true, true] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 28) ⟨rep (n) [true, false, false, false] (L), cons false (cons false (R)), .E⟩ = some ⟨L, cons false (cons false (rep (n) [true, true, true, true] (R))), .E⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `1 A> 1` halts: A erases the 1 and steps left onto a 1 in state D. -/
theorem halt_A (L R : Tape) : ∃ c, steps 1 ⟨cons true (L), cons true (R), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `1 C> 0` halts: C writes 1 and steps left onto a 1 in state D. -/
theorem halt_C (L R : Tape) : ∃ c, steps 1 ⟨cons true (L), cons false (R), .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `1 1 E> 0` halts after two steps. -/
theorem halt_E (L R : Tape) : ∃ c, steps 2 ⟨cons true (cons true (L)), cons false (R), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H163738
