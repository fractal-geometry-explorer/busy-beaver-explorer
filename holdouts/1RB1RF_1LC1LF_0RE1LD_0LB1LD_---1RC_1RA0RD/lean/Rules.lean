/-- One round of a pass: A eats the last `10` on its left, two 1s on its right, and the block of 1s grows by 4. -/
theorem cycle (k p s : Nat) (L R : Tape) :
    steps (12 * k + 20) ⟨rep (2 * k + 2) [true, true] (rep (p + 1) [false, true] (L)), rep (s + 3) [true] (R), .A⟩ = some ⟨cons true (rep (2 * k + 2) [true, true] (cons true (cons true (cons true (rep (p) [false, true] (L)))))), cons true (rep (s) [true] (R)), .A⟩ := by
  have h0 : steps 3 ⟨rep (2 * k + 2) [true, true] (rep (p + 1) [false, true] (L)), rep (s + 3) [true] (R), .A⟩ = some ⟨cons true (rep (2 * k + 2) [true, true] (rep (p + 1) [false, true] (L))), cons false (cons true (rep (s) [true] (R))), .D⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (2 * k + 2) [true, true] (rep (p + 1) [false, true] (L))), cons false (cons true (rep (s) [true] (R))), .D⟩ = some ⟨rep (2 * k + 2) [true, true] (cons true (rep (p + 1) [false, true] (L))), cons false (cons true (rep (s) [true] (R))), .D⟩ := by
    simp only [steps_zero, show cons true (rep (2 * k + 2) [true, true] (rep (p + 1) [false, true] (L))) = rep (2 * k + 2) [true, true] (cons true (rep (p + 1) [false, true] (L))) from
      rep_rotate (2 * k + 2) [true] [true, true] [true, true] rfl (rep (p + 1) [false, true] (L))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, false] R), .D⟩ := fun _ _ => rfl
  have h2 : steps ((2 * k + 2) * 4) ⟨rep (2 * k + 2) [true, true] (cons true (rep (p + 1) [false, true] (L))), cons false (cons true (rep (s) [true] (R))), .D⟩ = some ⟨cons true (rep (p + 1) [false, true] (L)), cons false (rep (2 * k + 2) [true, false] (cons true (rep (s) [true] (R)))), .D⟩ :=
    cross_l trans c2 (2 * k + 2) (cons true (rep (p + 1) [false, true] (L))) (cons true (rep (s) [true] (R)))
  have h3 : steps 4 ⟨cons true (rep (p + 1) [false, true] (L)), cons false (rep (2 * k + 2) [true, false] (cons true (rep (s) [true] (R)))), .D⟩ = some ⟨cons true (cons true (cons true (rep (p) [false, true] (L)))), cons false (rep (2 * k + 2) [true, false] (cons true (rep (s) [true] (R)))), .F⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons true (cons true (rep (p) [false, true] (L)))), cons false (rep (2 * k + 2) [true, false] (cons true (rep (s) [true] (R)))), .F⟩ = some ⟨cons true (cons true (cons true (rep (p) [false, true] (L)))), rep (2 * k + 2) [false, true] (cons false (cons true (rep (s) [true] (R)))), .F⟩ := by
    simp only [steps_zero, show cons false (rep (2 * k + 2) [true, false] (cons true (rep (s) [true] (R)))) = rep (2 * k + 2) [false, true] (cons false (cons true (rep (s) [true] (R)))) from
      rep_rotate (2 * k + 2) [false] [true, false] [false, true] rfl (cons true (rep (s) [true] (R)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [true, true] L), R, .F⟩ := fun _ _ => rfl
  have h5 : steps ((2 * k + 2) * 2) ⟨cons true (cons true (cons true (rep (p) [false, true] (L)))), rep (2 * k + 2) [false, true] (cons false (cons true (rep (s) [true] (R)))), .F⟩ = some ⟨rep (2 * k + 2) [true, true] (cons true (cons true (cons true (rep (p) [false, true] (L))))), cons false (cons true (rep (s) [true] (R))), .F⟩ :=
    cross_r trans c5 (2 * k + 2) (cons true (cons true (cons true (rep (p) [false, true] (L))))) (cons false (cons true (rep (s) [true] (R))))
  have h6 : steps 1 ⟨rep (2 * k + 2) [true, true] (cons true (cons true (cons true (rep (p) [false, true] (L))))), cons false (cons true (rep (s) [true] (R))), .F⟩ = some ⟨cons true (rep (2 * k + 2) [true, true] (cons true (cons true (cons true (rep (p) [false, true] (L)))))), cons true (rep (s) [true] (R)), .A⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((2 * k + 2) * 4 + (4 + (0 + ((2 * k + 2) * 2 + (1))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- The start of a pass: C and E zip over the `10`s, D and B turn the last one into the block `1111`. -/
theorem pass_start (a s : Nat) (R : Tape) :
    steps (2 * a + 16) ⟨blank, cons false (cons false (rep (a + 2) [true, false] (rep (s + 3) [true] (R)))), .B⟩ = some ⟨cons true (cons true (cons true (rep (a + 1) [true, false] (cons true (cons false (blank)))))), cons true (cons true (rep (s + 1) [true] (R))), .A⟩ := by
  have h0 : steps 3 ⟨blank, cons false (cons false (rep (a + 2) [true, false] (rep (s + 3) [true] (R)))), .B⟩ = some ⟨cons true (cons false (blank)), cons false (rep (a + 2) [true, false] (rep (s + 3) [true] (R))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (blank)), cons false (rep (a + 2) [true, false] (rep (s + 3) [true] (R))), .C⟩ = some ⟨cons true (cons false (blank)), rep (a + 2) [false, true] (cons false (rep (s + 3) [true] (R))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (a + 2) [true, false] (rep (s + 3) [true] (R))) = rep (a + 2) [false, true] (cons false (rep (s + 3) [true] (R))) from
      rep_rotate (a + 2) [false] [true, false] [false, true] rfl (rep (s + 3) [true] (R))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h2 : steps ((a + 2) * 2) ⟨cons true (cons false (blank)), rep (a + 2) [false, true] (cons false (rep (s + 3) [true] (R))), .C⟩ = some ⟨rep (a + 2) [true, false] (cons true (cons false (blank))), cons false (rep (s + 3) [true] (R)), .C⟩ :=
    cross_r trans c2 (a + 2) (cons true (cons false (blank))) (cons false (rep (s + 3) [true] (R)))
  have h3 : steps 9 ⟨rep (a + 2) [true, false] (cons true (cons false (blank))), cons false (rep (s + 3) [true] (R)), .C⟩ = some ⟨cons true (cons true (cons true (rep (a + 1) [true, false] (cons true (cons false (blank)))))), cons true (cons true (rep (s + 1) [true] (R))), .A⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((a + 2) * 2 + (9)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The end of a pass, when no `10` is left: the block of 1s becomes the new run of `10`s. -/
theorem pass_end (m s : Nat) (R : Tape) :
    steps (10 * m + 30) ⟨rep (m + 1) [true, true] (blank), rep (s + 5) [true] (R), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, true] (cons false (cons true (rep (s) [true] (R))))))))), .B⟩ := by
  have h0 : steps 3 ⟨rep (m + 1) [true, true] (blank), rep (s + 5) [true] (R), .A⟩ = some ⟨cons true (rep (m + 1) [true, true] (blank)), cons false (cons true (rep (s + 2) [true] (R))), .D⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (m + 1) [true, true] (blank)), cons false (cons true (rep (s + 2) [true] (R))), .D⟩ = some ⟨rep (m + 1) [true, true] (cons true (blank)), cons false (cons true (rep (s + 2) [true] (R))), .D⟩ := by
    simp only [steps_zero, show cons true (rep (m + 1) [true, true] (blank)) = rep (m + 1) [true, true] (cons true (blank)) from
      rep_rotate (m + 1) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, false] R), .D⟩ := fun _ _ => rfl
  have h2 : steps ((m + 1) * 4) ⟨rep (m + 1) [true, true] (cons true (blank)), cons false (cons true (rep (s + 2) [true] (R))), .D⟩ = some ⟨cons true (blank), cons false (rep (m + 1) [true, false] (cons true (rep (s + 2) [true] (R)))), .D⟩ :=
    cross_l trans c2 (m + 1) (cons true (blank)) (cons true (rep (s + 2) [true] (R)))
  have h3 : steps 4 ⟨cons true (blank), cons false (rep (m + 1) [true, false] (cons true (rep (s + 2) [true] (R)))), .D⟩ = some ⟨cons true (cons true (blank)), cons false (rep (m + 1) [true, false] (cons true (rep (s + 2) [true] (R)))), .F⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons true (blank)), cons false (rep (m + 1) [true, false] (cons true (rep (s + 2) [true] (R)))), .F⟩ = some ⟨cons true (cons true (blank)), rep (m + 1) [false, true] (cons false (cons true (rep (s + 2) [true] (R)))), .F⟩ := by
    simp only [steps_zero, show cons false (rep (m + 1) [true, false] (cons true (rep (s + 2) [true] (R)))) = rep (m + 1) [false, true] (cons false (cons true (rep (s + 2) [true] (R)))) from
      rep_rotate (m + 1) [false] [true, false] [false, true] rfl (cons true (rep (s + 2) [true] (R)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [true, true] L), R, .F⟩ := fun _ _ => rfl
  have h5 : steps ((m + 1) * 2) ⟨cons true (cons true (blank)), rep (m + 1) [false, true] (cons false (cons true (rep (s + 2) [true] (R)))), .F⟩ = some ⟨rep (m + 1) [true, true] (cons true (cons true (blank))), cons false (cons true (rep (s + 2) [true] (R))), .F⟩ :=
    cross_r trans c5 (m + 1) (cons true (cons true (blank))) (cons false (cons true (rep (s + 2) [true] (R))))
  have h6 : steps 5 ⟨rep (m + 1) [true, true] (cons true (cons true (blank))), cons false (cons true (rep (s + 2) [true] (R))), .F⟩ = some ⟨cons true (rep (m + 1) [true, true] (cons true (cons true (blank)))), cons true (cons false (cons true (rep (s) [true] (R)))), .B⟩ := rfl
  have h7 : steps 0 ⟨cons true (rep (m + 1) [true, true] (cons true (cons true (blank)))), cons true (cons false (cons true (rep (s) [true] (R)))), .B⟩ = some ⟨rep (m + 1) [true, true] (cons true (cons true (cons true (blank)))), cons true (cons false (cons true (rep (s) [true] (R)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (m + 1) [true, true] (cons true (cons true (blank)))) = rep (m + 1) [true, true] (cons true (cons true (cons true (blank)))) from
      rep_rotate (m + 1) [true] [true, true] [true, true] rfl (cons true (cons true (blank)))]
  have c8 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, true] R), .B⟩ := fun _ _ => rfl
  have h8 : steps ((m + 1) * 4) ⟨rep (m + 1) [true, true] (cons true (cons true (cons true (blank)))), cons true (cons false (cons true (rep (s) [true] (R)))), .B⟩ = some ⟨cons true (cons true (cons true (blank))), cons true (rep (m + 1) [false, true] (cons false (cons true (rep (s) [true] (R))))), .B⟩ :=
    cross_l trans c8 (m + 1) (cons true (cons true (cons true (blank)))) (cons false (cons true (rep (s) [true] (R))))
  have h9 : steps 8 ⟨cons true (cons true (cons true (blank))), cons true (rep (m + 1) [false, true] (cons false (cons true (rep (s) [true] (R))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, true] (cons false (cons true (rep (s) [true] (R))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((m + 1) * 4 + (4 + (0 + ((m + 1) * 2 + (5 + (0 + ((m + 1) * 4 + (8)))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

/-- From `B>0 0 (10)^n` and blank tape, C and E zip right and E reaches a blank. -/
theorem zip_halt (n : Nat) :
    steps (2 * n + 4) ⟨blank, cons false (cons false (rep (n) [true, false] (blank))), .B⟩ = some ⟨cons false (rep (n) [true, false] (cons true (cons false (blank)))), blank, .E⟩ := by
  have h0 : steps 3 ⟨blank, cons false (cons false (rep (n) [true, false] (blank))), .B⟩ = some ⟨cons true (cons false (blank)), cons false (rep (n) [true, false] (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (blank)), cons false (rep (n) [true, false] (blank)), .C⟩ = some ⟨cons true (cons false (blank)), rep (n) [false, true] (cons false (blank)), .C⟩ := by
    simp only [steps_zero, show cons false (rep (n) [true, false] (blank)) = rep (n) [false, true] (cons false (blank)) from
      rep_rotate (n) [false] [true, false] [false, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 2) ⟨cons true (cons false (blank)), rep (n) [false, true] (cons false (blank)), .C⟩ = some ⟨rep (n) [true, false] (cons true (cons false (blank))), cons false (blank), .C⟩ :=
    cross_r trans c2 (n) (cons true (cons false (blank))) (cons false (blank))
  have h3 : steps 1 ⟨rep (n) [true, false] (cons true (cons false (blank))), cons false (blank), .C⟩ = some ⟨cons false (rep (n) [true, false] (cons true (cons false (blank)))), blank, .E⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((n) * 2 + (1)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

