theorem deep_case_0_0 (m : Nat) (pre : Tape) (hi : List Bool) (hp : pre = blank ∨ pre = preB)
    (hl : 2 ≤ hi.length) (hm : hi.length + 5 ≤ m)
    (hb : ¬ BStart (vis m (Xv pre false (false :: false :: false :: false :: hi) false true true true))) :
    ∃ n c', steps (n + 1) (vis m (Xv pre false (false :: false :: false :: false :: hi) false true true true)) = some c' ∧ Steady c' := by
  rcases split_ones hi with ⟨j, rest, rfl⟩ | hall
  · simp only [List.length_append, List.length_replicate, List.length_cons] at hl hm
    cases j with
    | zero => exact ⟨_, _, vd_0_0_z m rest pre, steady_mk hp (by simp only [List.length_append, List.length_replicate, List.length_cons]; omega) (by simp only [List.length_append, List.length_replicate, List.length_cons]; omega)⟩
    | succ k => exact ⟨_, _, vd_0_0_s k m rest pre, steady_mk hp (by simp only [List.length_append, List.length_replicate, List.length_cons]; omega) (by simp only [List.length_append, List.length_replicate, List.length_cons]; omega)⟩
  · rcases hp with rfl | rfl
    · obtain ⟨k, hk⟩ : ∃ k, hi.length = k + 1 := ⟨hi.length - 1, by omega⟩
      rw [hall, hk]
      exact ⟨_, _, va_0_0 k m, steady_mk (Or.inr rfl) (by simp only [List.length_append, List.length_replicate, List.length_cons]; omega) (by simp only [List.length_append, List.length_replicate, List.length_cons]; omega)⟩
    · exact absurd ⟨false, false, false, false, false, hi, false, m, rfl, hall⟩ hb

