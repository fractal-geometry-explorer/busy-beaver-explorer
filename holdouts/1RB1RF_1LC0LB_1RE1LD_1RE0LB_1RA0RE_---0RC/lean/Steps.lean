theorem vd_0_0_z (m : Nat) (rest : List Bool) (pre : Tape) :
    steps (8 * m + 12 + (1431) + 1) (vis m (Xv pre false (false :: false :: false :: false :: (List.replicate 0 true ++ false :: rest)) false true true true))
      = some (vis (m + 1) (Xv pre true (true :: true :: false :: false :: (List.replicate 0 false ++ true :: rest)) true false false false)) := by
  refine visit m (1431) _ _ (fun R => ?_)
  have h := deep_0_0_z (digs rest pre) R
  try rw [rot0] at h
  simp only [Xv, digs_cons, digs_rep, digs_rep_nil, app_cons, app_nil]
  exact h

