  have h5 : steps ((j) * 4) ⟨rep (j) [true, true, true, true] (cons true (cons true (cons true (cons true (cons false (cons true (L))))))), cons true (cons true (rep (r) [true] (blank))), .E⟩ = some ⟨cons true (cons true (cons true (cons true (cons false (cons true (L)))))), cons true (rep (j) [true, false, true, false] (cons true (rep (r) [true] (blank)))), .E⟩ :=
