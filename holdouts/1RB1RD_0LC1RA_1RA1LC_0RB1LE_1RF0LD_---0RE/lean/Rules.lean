/-- E phase, start: E(x+1, s+5) reaches Q(x, 1, s+1). -/
theorem startE (s x : Nat) :
    steps (2 * x + 17) ⟨blank, cons false (rep (x + 1) [true, false] (rep (s + 5) [true] (blank))), .E⟩ = some ⟨cons true (rep (x) [false, true] (blank)), cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (s) [true] (blank)))))))), .D⟩ := by
  have h0 : steps 0 ⟨blank, cons false (rep (x + 1) [true, false] (rep (s + 5) [true] (blank))), .E⟩ = some ⟨blank, rep (x + 1) [false, true] (cons false (rep (s + 5) [true] (blank))), .E⟩ := by
    simp only [steps_zero, show cons false (rep (x + 1) [true, false] (rep (s + 5) [true] (blank))) = rep (x + 1) [false, true] (cons false (rep (s + 5) [true] (blank))) from
      rep_rotate (x + 1) [false] [true, false] [false, true] rfl (rep (s + 5) [true] (blank))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .E⟩ = some ⟨app [] (app [false, true] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((x + 1) * 2) ⟨blank, rep (x + 1) [false, true] (cons false (rep (s + 5) [true] (blank))), .E⟩ = some ⟨rep (x + 1) [false, true] (blank), cons false (rep (s + 5) [true] (blank)), .E⟩ :=
    cross_r trans c1 (x + 1) (blank) (cons false (rep (s + 5) [true] (blank)))
  have h2 : steps 15 ⟨rep (x + 1) [false, true] (blank), cons false (rep (s + 5) [true] (blank)), .E⟩ = some ⟨cons true (rep (x) [false, true] (blank)), cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (s) [true] (blank)))))))), .D⟩ := rfl
  exact steps_congr trans (a := 0 + ((x + 1) * 2 + (15))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

