/-! ## The doubling loop -/

/-- `c` reaches `c'` in a positive number of steps. -/
def Reach (c c' : Config) : Prop := ∃ n, 0 < n ∧ steps n c = some c'

/-- `c` reaches `c'` in some number of steps, maybe none. -/
def Runs (c c' : Config) : Prop := ∃ n, steps n c = some c'

theorem reach_of {n : Nat} {c c' : Config} (h : steps n c = some c') (hn : 0 < n) : Reach c c' := ⟨n, hn, h⟩

theorem reach_trans {a b c : Config} (h₁ : Reach a b) (h₂ : Reach b c) : Reach a c := by
  obtain ⟨n, hn, h⟩ := h₁
  obtain ⟨m, _, h'⟩ := h₂
  exact ⟨n + m, by omega, steps_seq trans h h'⟩

theorem runs_trans {a b c : Config} (h₁ : Runs a b) (h₂ : Runs b c) : Runs a c := by
  obtain ⟨n, h⟩ := h₁
  obtain ⟨m, h'⟩ := h₂
  exact ⟨n + m, steps_seq trans h h'⟩

theorem reach_runs {a b c : Config} (h₁ : Reach a b) (h₂ : Runs b c) : Reach a c := by
  obtain ⟨n, hn, h⟩ := h₁
  obtain ⟨m, h'⟩ := h₂
  exact ⟨n + m, by omega, steps_seq trans h h'⟩

/-- One turn of the loop, with `Qc`. -/
theorem qturn (L : Tape) (a m k : Nat) : steps (6 * m + 10) (Qc L (a + 1) m (k + 1)) = some (Qc L a (m + 2) k) := by
  have h := qstep a k m L
  simp only [rep_tt_cons] at h
  exact h

/-- `i` turns of the loop: each pays one pair `01` on the right and one `10` on the left, and adds `11`. -/
theorem qloop (L : Tape) (i : Nat) : ∀ a m k, Runs (Qc L (a + i) m (k + i)) (Qc L a (m + 2 * i) k) := by
  induction i with
  | zero => intro a m k; exact ⟨0, rfl⟩
  | succ i ih =>
    intro a m k
    have h1 : Runs (Qc L (a + (i + 1)) m (k + (i + 1))) (Qc L (a + i) (m + 2) (k + i)) :=
      ⟨_, qturn L (a + i) m (k + i)⟩
    have h2 := ih a (m + 2) k
    rw [show m + 2 + 2 * i = m + 2 * (i + 1) by omega] at h2
    exact runs_trans h1 h2

/-! ## The map -/

/-- The constant of the doubling row: `2n + 6` from A, `2n + 7` from D. -/
def dc : Sd → Nat
  | .A => 6
  | .D => 7

/-- The first count after a conversion: `D(1, _)` from A, `D(3, _)` from D. -/
def cc : Sd → Nat
  | .A => 1
  | .D => 3

/-- The left-end map (`py/emap.py`); `none` is the halting row, n odd and k = 1. -/
def emap : Sd × Nat × Nat → Option (Sd × Nat × Nat)
  | (s, n, k) =>
    if k = 0 then
      (if n % 2 = 0 then some (oth s, n + 3, 0) else some (.D, cc s, (n + 1) / 2))
    else if n % 2 = 0 then
      (if k = 1 then some (oth s, n + 7, 0) else some (oth s, n + 4, k - 1))
    else if k = 1 then none
    else if 2 * k > n + 5 then some (s, 2 * n + dc s, k - (n + 5) / 2)
    else if 2 * k = n + 5 then some (s, 2 * n + dc s + 3, 0)
    else some (oth s, n + 6 - 2 * k, 2 * k)

/-- The halting row of the map. -/
theorem emap_none (x : Sd × Nat × Nat) : emap x = none ↔ x.2.1 % 2 = 1 ∧ x.2.2 = 1 := by
  obtain ⟨s, n, k⟩ := x
  simp only [emap]
  constructor
  · intro h
    by_cases h0 : k = 0
    · simp only [h0, ite_true] at h; split at h <;> cases h
    · by_cases h1 : n % 2 = 0
      · simp only [h0, h1, ite_true, ite_false] at h; split at h <;> cases h
      · by_cases h2 : k = 1
        · exact ⟨by omega, h2⟩
        · simp only [h0, h1, h2, ite_false] at h; split at h <;> (try split at h) <;> cases h
  · rintro ⟨h1, h2⟩
    subst h2
    simp only [show ¬ (1 = 0) by omega, show ¬ (n % 2 = 0) by omega, ite_true, ite_false]

theorem ite_t {α : Type} {c : Prop} [Decidable c] (h : c) (a b : α) : (if c then a else b) = a := by
  simp [h]

theorem ite_f {α : Type} {c : Prop} [Decidable c] (h : ¬ c) (a b : α) : (if c then a else b) = b := by
  simp [h]

macro "emap_tac" : tactic =>
  `(tactic| (simp (disch := omega) only [emap, ite_true, ite_false, ite_t, ite_f, oth, dc, cc] <;>
      (try simp only [Option.some.injEq, Prod.mk.injEq, true_and, and_true]) <;> omega))

/-- The map from A. -/
theorem stepA (n k : Nat) :
    (∀ y, emap (.A, n, k) = some y → Reach (LA n k) (enc y)) ∧ (emap (.A, n, k) = none → Halts trans (LA n k)) := by
  obtain ⟨j, rfl | rfl⟩ : ∃ j, n = 2 * j ∨ n = 2 * j + 1 := ⟨n / 2, by omega⟩
  · rcases k with _ | _ | k
    · have hf : emap (.A, 2 * j, 0) = some (.D, 2 * j + 3, 0) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rA0 j) (by omega)
    · have hf : emap (.A, 2 * j, 0 + 1) = some (.D, 2 * j + 7, 0) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rA1 j) (by omega)
    · have hf : emap (.A, 2 * j, k + 1 + 1) = some (.D, 2 * j + 4, k + 1) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rA2 j k) (by omega)
  · rcases k with _ | _ | k
    · have hf : emap (.A, 2 * j + 1, 0) = some (.D, 1, j + 1) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rcA j) (by omega)
    · exact ⟨fun y hy => by simp [emap] at hy, fun _ => haltA j⟩
    · obtain ⟨e, he, hen⟩ := enA j k
      have hE : Reach (LA (2 * j + 1) (k + 1 + 1)) (Qc blank j 2 k) := ⟨e, he, hen⟩
      by_cases hjk : j ≤ k
      · obtain ⟨r, rfl⟩ : ∃ r, k = r + j := ⟨k - j, by omega⟩
        have hL : Runs (Qc blank j 2 (r + j)) (Qc blank 0 (2 + 2 * j) r) := by
          have := qloop blank j 0 2 r
          rw [Nat.zero_add] at this
          exact this
        have hQ := reach_runs hE hL
        rcases r with _ | _ | r
        · have hf : emap (.A, 2 * j + 1, 0 + j + 1 + 1) = some (.D, 2 * 0 + 3, 2 + 2 * j + 2) := by emap_tac
          refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
          rw [hf] at hy; cases hy
          exact reach_trans hQ (reach_of (fA 0 (2 + 2 * j)) (by omega))
        · have hf : emap (.A, 2 * j + 1, 0 + 1 + j + 1 + 1) = some (.A, 2 * (2 + 2 * j) + 7, 0) := by emap_tac
          refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
          rw [hf] at hy; cases hy
          exact reach_trans hQ (reach_of (oA1 (2 + 2 * j)) (by omega))
        · have hf : emap (.A, 2 * j + 1, r + 1 + 1 + j + 1 + 1) = some (.A, 2 * (2 + 2 * j) + 4, r + 1) := by
            emap_tac
          refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
          rw [hf] at hy; cases hy
          exact reach_trans hQ (reach_of (oA2 r (2 + 2 * j)) (by omega))
      · obtain ⟨d, rfl⟩ : ∃ d, j = d + 1 + k := ⟨j - k - 1, by omega⟩
        have hL : Runs (Qc blank (d + 1 + k) 2 k) (Qc blank (d + 1) (2 + 2 * k) 0) := by
          have := qloop blank k (d + 1) 2 0
          rw [Nat.zero_add] at this
          exact this
        have hQ := reach_runs hE hL
        have hf : emap (.A, 2 * (d + 1 + k) + 1, k + 1 + 1) = some (.D, 2 * (d + 1) + 3, 2 + 2 * k + 2) := by
          emap_tac
        refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
        rw [hf] at hy; cases hy
        exact reach_trans hQ (reach_of (fA (d + 1) (2 + 2 * k)) (by omega))

/-- The map from D. -/
theorem stepD (n k : Nat) :
    (∀ y, emap (.D, n, k) = some y → Reach (LD n k) (enc y)) ∧ (emap (.D, n, k) = none → Halts trans (LD n k)) := by
  obtain ⟨j, rfl | rfl⟩ : ∃ j, n = 2 * j ∨ n = 2 * j + 1 := ⟨n / 2, by omega⟩
  · rcases k with _ | _ | k
    · have hf : emap (.D, 2 * j, 0) = some (.A, 2 * j + 3, 0) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rD0 j) (by omega)
    · have hf : emap (.D, 2 * j, 0 + 1) = some (.A, 2 * j + 7, 0) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rD1 j) (by omega)
    · have hf : emap (.D, 2 * j, k + 1 + 1) = some (.A, 2 * j + 4, k + 1) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rD2 j k) (by omega)
  · rcases k with _ | _ | k
    · have hf : emap (.D, 2 * j + 1, 0) = some (.D, 3, j + 1) := by emap_tac
      refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
      rw [hf] at hy; cases hy; exact reach_of (rcD j) (by omega)
    · exact ⟨fun y hy => by simp [emap] at hy, fun _ => haltD j⟩
    · obtain ⟨e, he, hen⟩ := enD j k
      have hE : Reach (LD (2 * j + 1) (k + 1 + 1)) (Qc (cons true blank) j 2 k) := ⟨e, he, hen⟩
      by_cases hjk : j ≤ k
      · obtain ⟨r, rfl⟩ : ∃ r, k = r + j := ⟨k - j, by omega⟩
        have hL : Runs (Qc (cons true blank) j 2 (r + j)) (Qc (cons true blank) 0 (2 + 2 * j) r) := by
          have := qloop (cons true blank) j 0 2 r
          rw [Nat.zero_add] at this
          exact this
        have hQ := reach_runs hE hL
        rcases r with _ | _ | r
        · have hf : emap (.D, 2 * j + 1, 0 + j + 1 + 1) = some (.A, 2 * 0 + 3, 2 + 2 * j + 2) := by emap_tac
          refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
          rw [hf] at hy; cases hy
          exact reach_trans hQ (reach_of (fD 0 (2 + 2 * j)) (by omega))
        · have hf : emap (.D, 2 * j + 1, 0 + 1 + j + 1 + 1) = some (.D, 2 * (2 + 2 * j) + 8, 0) := by emap_tac
          refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
          rw [hf] at hy; cases hy
          exact reach_trans hQ (reach_of (oD1 (2 + 2 * j)) (by omega))
        · have hf : emap (.D, 2 * j + 1, r + 1 + 1 + j + 1 + 1) = some (.D, 2 * (2 + 2 * j) + 5, r + 1) := by
            emap_tac
          refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
          rw [hf] at hy; cases hy
          exact reach_trans hQ (reach_of (oD2 r (2 + 2 * j)) (by omega))
      · obtain ⟨d, rfl⟩ : ∃ d, j = d + 1 + k := ⟨j - k - 1, by omega⟩
        have hL : Runs (Qc (cons true blank) (d + 1 + k) 2 k) (Qc (cons true blank) (d + 1) (2 + 2 * k) 0) := by
          have := qloop (cons true blank) k (d + 1) 2 0
          rw [Nat.zero_add] at this
          exact this
        have hQ := reach_runs hE hL
        have hf : emap (.D, 2 * (d + 1 + k) + 1, k + 1 + 1) = some (.A, 2 * (d + 1) + 3, 2 + 2 * k + 2) := by
          emap_tac
        refine ⟨fun y hy => ?_, fun h => by rw [hf] at h; cases h⟩
        rw [hf] at hy; cases hy
        exact reach_trans hQ (reach_of (fD (d + 1) (2 + 2 * k)) (by omega))

/-- **The map is what the machine does**: a step of `emap` is a positive run between left-end states, and a `none`
is a halt. -/
theorem map_step (x : Sd × Nat × Nat) :
    (∀ y, emap x = some y → Reach (enc x) (enc y)) ∧ (emap x = none → Halts trans (enc x)) := by
  obtain ⟨s, n, k⟩ := x
  cases s
  · exact stepA n k
  · exact stepD n k

/-! ## From blank tape -/

/-- 11 steps from blank tape reach `D(3, 0)` = `0^inf D> 0 0 0 1 1 1 0^inf`. -/
theorem blank_11 : steps 11 init = some (LD 3 0) := by
  have h := blank_reaches trans (n := 11) (q := St.A)
    (c := ⟨[], [false, false, false, true, true, true], .D⟩) (by decide)
  exact h

/-- The orbit of `D(3, 0)`; `none` once it has halted. -/
def orbit : Nat → Option (Sd × Nat × Nat)
  | 0 => some (.D, 3, 0)
  | i + 1 => (orbit i).bind emap

theorem orbit_reach (i : Nat) :
    ∀ x, orbit i = some x → ∃ n, i ≤ n ∧ steps n init = some (enc x) := by
  induction i with
  | zero =>
    intro x hx; cases hx
    exact ⟨11, by omega, blank_11⟩
  | succ i ih =>
    intro y hy
    simp only [orbit] at hy
    cases hk : orbit i with
    | none => rw [hk] at hy; cases hy
    | some x =>
      rw [hk] at hy
      obtain ⟨n, hn, h⟩ := ih x hk
      obtain ⟨m, hm, h'⟩ := (map_step x).1 y hy
      exact ⟨n + m, by omega, steps_seq trans h h'⟩

/-- **The machine halts from blank tape if and only if the orbit of `D(3, 0)` under the left-end map reaches the
halting row** (where `emap` gives `none`). -/
theorem halts_iff : HaltsFromBlank ↔ ∃ i, orbit i = none := by
  constructor
  · intro hH
    apply Classical.byContradiction
    intro hno
    have hall : ∀ i, ∃ x, orbit i = some x := by
      intro i
      cases e : orbit i with
      | none => exact absurd ⟨i, e⟩ hno
      | some x => exact ⟨x, rfl⟩
    apply not_halts_of_forall trans _ hH
    apply forall_of_unbounded trans (fun n => ∃ x, steps n init = some (enc x))
    · intro n
      obtain ⟨x, hx⟩ := hall n
      obtain ⟨m, hm, h⟩ := orbit_reach n x hx
      exact ⟨m, hm, x, h⟩
    · rintro m ⟨x, h⟩; exact ⟨_, h⟩
  · rintro ⟨i, hi⟩
    induction i with
    | zero => cases hi
    | succ i ih =>
      simp only [orbit] at hi
      cases e : orbit i with
      | none => exact ih e
      | some x =>
        rw [e] at hi
        obtain ⟨n, _, h⟩ := orbit_reach i x e
        obtain ⟨m, c, hc, hs⟩ := (map_step x).2 hi
        exact ⟨n + m, c, steps_seq trans h hc, hs⟩

/-- The same with the halting row written out: **the machine halts from blank tape iff the orbit of `D(3, 0)` reaches
a left-end state `A(n, 1)` or `D(n, 1)` with `n` odd.** -/
theorem halts_iff_state : HaltsFromBlank ↔ ∃ i s n, orbit i = some (s, n, 1) ∧ n % 2 = 1 := by
  rw [halts_iff]
  constructor
  · rintro ⟨i, hi⟩
    induction i with
    | zero => cases hi
    | succ i ih =>
      simp only [orbit] at hi
      cases e : orbit i with
      | none => exact ih e
      | some x =>
        rw [e] at hi
        obtain ⟨h1, h2⟩ := (emap_none x).1 (by simpa using hi)
        obtain ⟨s, n, k⟩ := x
        simp only at h1 h2
        subst h2
        exact ⟨i, s, n, e, h1⟩
  · rintro ⟨i, s, n, hi, hn⟩
    refine ⟨i + 1, ?_⟩
    simp only [orbit, hi, Option.bind_some]
    exact (emap_none (s, n, 1)).2 ⟨hn, rfl⟩

end H132148
