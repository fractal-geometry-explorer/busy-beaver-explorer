/-!
# 1RB1RF_1LC---_1LE1RD_1RA0RC_0LF0LA_0LD0RB: the machine is a map on left-end states

Left-end states (`py/emap.py`): `A(n, k)` is `0^inf A> 0 0 T` and `D(n, k)` is `0^inf D> 0 0 0 T`, with
`T = 1^n (01)^k 111 0^inf` (`T = 1^n 0^inf` when `k = 0`).  `MapRules.lean` (generated by `py/maprules.py`) proves
every row of the map, and one turn `qstep` of the doubling loop, for all values of the counts.  This file

* restates those rows with the left-end states `LA n k`, `LD n k` and the loop configurations `Qc L a m k`,
* chains the whole doubling loop by induction over `qstep` (`qloop`),
* glues the rows into the map `emap` on `(side, n, k)`, whose `none` is the halting row (n odd, k = 1),
  and proves that the map is what the machine does (`map_step`),
* runs the 11 steps from blank tape to `D(3, 0)` (`blank_11`),

and concludes: **the machine halts from blank tape iff the orbit of `D(3, 0)` under `emap` reaches `none`**
(`halts_iff`), i.e. reaches a state with n odd and k = 1 (`halts_iff_state`).  Checked by Lean's kernel; the proof
of `halts_iff` uses `Classical.byContradiction`.
-/

set_option linter.unusedSimpArgs false

namespace H132148

open TM

/-! ## Left-end states and the loop configurations -/

/-- The two states in which the head turns at the left end. -/
inductive Sd where
  | A | D
  deriving DecidableEq, Repr

/-- The other side. -/
def oth : Sd → Sd
  | .A => .D
  | .D => .A

/-- The part `(01)^k 111 0^inf` of the tape (`0^inf` when `k = 0`). -/
def tl : Nat → Tape
  | 0 => blank
  | k + 1 => rep (k + 1) [false, true] (cons true (cons true (cons true blank)))

/-- `A(n, k)`: `0^inf A> 0 0 1^n (01)^k 111 0^inf`. -/
def LA (n k : Nat) : Config := ⟨blank, cons false (cons false (rep n [true] (tl k))), .A⟩

/-- `D(n, k)`: `0^inf D> 0 0 0 1^n (01)^k 111 0^inf`. -/
def LD (n k : Nat) : Config := ⟨blank, cons false (cons false (cons false (rep n [true] (tl k)))), .D⟩

/-- The configuration of a left-end state. -/
def enc : Sd × Nat × Nat → Config
  | (.A, n, k) => LA n k
  | (.D, n, k) => LD n k

/-- `Q(L; a, m, k)` = `L (10)^a 1 1 D> 1 (11)^m (01)^k 111 0^inf`, the doubling loop. -/
def Qc (L : Tape) (a m k : Nat) : Config :=
  ⟨cons true (cons true (rep a [false, true] L)),
    cons true (rep m [true, true] (rep k [false, true] (cons true (cons true (cons true blank))))), .D⟩

/-! ## Rewriting the tapes of the generated rules -/

theorem rep_tt (n : Nat) (s : Tape) : rep n [true, true] s = rep (2 * n) [true] s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega]
    show cons true (cons true (rep n [true, true] s)) = cons true (cons true (rep (2 * n) [true] s))
    rw [ih]

theorem rep1_cons (n : Nat) (s : Tape) : rep n [true] (cons true s) = rep (n + 1) [true] s :=
  rep_app_comm n [true] s

theorem cons_rep1 (n : Nat) (s : Tape) : cons true (rep n [true] s) = rep (n + 1) [true] s := rfl

theorem rep1_rep1 (a b : Nat) (s : Tape) : rep a [true] (rep b [true] s) = rep (a + b) [true] s :=
  (rep_add a b [true] s).symm

theorem rep_ft_cons (n : Nat) (s : Tape) :
    rep n [false, true] (cons false (cons true s)) = rep (n + 1) [false, true] s :=
  rep_app_comm n [false, true] s

theorem rep_tt_cons (n : Nat) (s : Tape) :
    rep n [true, true] (cons true (cons true s)) = rep (n + 1) [true, true] s :=
  rep_app_comm n [true, true] s

