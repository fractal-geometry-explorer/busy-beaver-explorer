  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .D⟩ = some ⟨app [] (app [true, false] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨cons true (cons true (blank)), rep (n) [true, true] (cons false (cons true (cons true (cons true (R))))), .D⟩ = some ⟨rep (n) [true, false] (cons true (cons true (blank))), cons false (cons true (cons true (cons true (R)))), .D⟩ :=
    cross_r trans c0 (n) (cons true (cons true (blank))) (cons false (cons true (cons true (cons true (R)))))
  have h1 : steps 3 ⟨rep (n) [true, false] (cons true (cons true (blank))), cons false (cons true (cons true (cons true (R)))), .D⟩ = some ⟨cons false (cons true (cons true (rep (n) [true, false] (cons true (cons true (blank)))))), cons true (R), .B⟩ := rfl
