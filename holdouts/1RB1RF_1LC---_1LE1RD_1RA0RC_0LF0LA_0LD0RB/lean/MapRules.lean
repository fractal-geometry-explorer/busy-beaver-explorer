    steps (6 * m + 7) ⟨cons true (cons true (blank)), cons true (rep (m) [true, true] (rep (k + 2) [false, true] (cons true (cons true (cons true (blank)))))), .D⟩ = some ⟨blank, cons false (cons false (cons true (cons true (rep (m) [true, true] (cons true (cons true (rep (k + 1) [false, true] (cons true (cons true (cons true (blank))))))))))), .A⟩ := by
  have hn : 0 + ((m) * 2 + (2 + ((m) * 4 + (5)))) = 6 * m + 7 := by omega
  have h0 : steps 0 ⟨cons true (cons true (blank)), cons true (rep (m) [true, true] (rep (k + 2) [false, true] (cons true (cons true (cons true (blank)))))), .D⟩ = some ⟨cons true (cons true (blank)), rep (m) [true, true] (cons true (rep (k + 2) [false, true] (cons true (cons true (cons true (blank)))))), .D⟩ := by
    simp only [steps_zero, show cons true (rep (m) [true, true] (rep (k + 2) [false, true] (cons true (cons true (cons true (blank)))))) = rep (m) [true, true] (cons true (rep (k + 2) [false, true] (cons true (cons true (cons true (blank)))))) from
      rep_rotate (m) [true] [true, true] [true, true] rfl (rep (k + 2) [false, true] (cons true (cons true (cons true (blank)))))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .D⟩ = some ⟨app [] (app [true, false] L), R, .D⟩ := fun _ _ => rfl
  have h1 : steps ((m) * 2) ⟨cons true (cons true (blank)), rep (m) [true, true] (cons true (rep (k + 2) [false, true] (cons true (cons true (cons true (blank)))))), .D⟩ = some ⟨rep (m) [true, false] (cons true (cons true (blank))), cons true (rep (k + 2) [false, true] (cons true (cons true (cons true (blank))))), .D⟩ :=
    cross_r trans c1 (m) (cons true (cons true (blank))) (cons true (rep (k + 2) [false, true] (cons true (cons true (cons true (blank))))))
  have h2 : steps 2 ⟨rep (m) [true, false] (cons true (cons true (blank))), cons true (rep (k + 2) [false, true] (cons true (cons true (cons true (blank))))), .D⟩ = some ⟨rep (m) [true, false] (cons true (cons true (blank))), cons false (cons true (cons true (rep (k + 1) [false, true] (cons true (cons true (cons true (blank))))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 4 ⟨app [true, false] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [true, true] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((m) * 4) ⟨rep (m) [true, false] (cons true (cons true (blank))), cons false (cons true (cons true (rep (k + 1) [false, true] (cons true (cons true (cons true (blank))))))), .E⟩ = some ⟨cons true (cons true (blank)), cons false (rep (m) [true, true] (cons true (cons true (rep (k + 1) [false, true] (cons true (cons true (cons true (blank)))))))), .E⟩ :=
    cross_l trans c3 (m) (cons true (cons true (blank))) (cons true (cons true (rep (k + 1) [false, true] (cons true (cons true (cons true (blank)))))))
  have h4 : steps 5 ⟨cons true (cons true (blank)), cons false (rep (m) [true, true] (cons true (cons true (rep (k + 1) [false, true] (cons true (cons true (cons true (blank)))))))), .E⟩ = some ⟨blank, cons false (cons false (cons true (cons true (rep (m) [true, true] (cons true (cons true (rep (k + 1) [false, true] (cons true (cons true (cons true (blank))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

