import Pieces
import Norm

/-!
# 1RB1RF_0LC0RF_1RD1LC_---0LE_0RC1LF_1RA0LE: the frame map

Configurations (blank tape around, `S>` the head in state S on the next cell):
* `e`: `11^L E 00 10^j 1^R`
* `E`: `1 11^L E 00 10^j 1^R`
* `f`: `11^L F 1^R`
* `F`: `1 11^L F 1^R`
* `g`: `F 0 10^j 1^R`
* `h`: `11^L 0 11^M F 1^R`
* `H`: `11^L 0 1 11^M F 1^R`
* `i`: `1 11^L 0 11^M F 1^R`
* `I`: `1 11^L 0 1 11^M F 1^R`
* `k`: `11^L 0 1^M B`
* `K`: `1 11^L 0 1^M B`

`next` sends each one to the next frame the machine reaches; `next_sound` proves every case for all parameters
(one symbolic run of `Pieces.lean` each, generated by `py/pieces.py`, glued by `tape_eq`).  Where `next` is `none`
the machine halts (`none_halts`).  The run from blank tape reaches `Ph.g 0 1` after 6 steps (`init_start`).
So the machine halts from blank tape iff the orbit of `Ph.g 0 1` under `next` reaches a phase where `next` is
`none` (`halts_iff`); `no_halt_phases` checks the first 100000000 phases by `native_decide`.
-/

namespace H151878

open TM

/-- `11^L E 00 10^j 1^R`. -/
def Fre (l j r : Nat) : Config := ⟨rep l [true, true] (blank), cons false (cons false (rep j [true, false] (rep r [true] (blank)))), .E⟩

/-- `1 11^L E 00 10^j 1^R`. -/
def FrE (l j r : Nat) : Config := ⟨rep l [true, true] (cons true (blank)), cons false (cons false (rep j [true, false] (rep r [true] (blank)))), .E⟩

/-- `11^L F 1^R`. -/
def Frf (l r : Nat) : Config := ⟨rep l [true, true] (blank), rep r [true] (blank), .F⟩

/-- `1 11^L F 1^R`. -/
def FrF (l r : Nat) : Config := ⟨rep l [true, true] (cons true (blank)), rep r [true] (blank), .F⟩

/-- `F 0 10^j 1^R`. -/
def Frg (j r : Nat) : Config := ⟨blank, cons false (rep j [true, false] (rep r [true] (blank))), .F⟩

/-- `11^L 0 11^M F 1^R`. -/
def Frh (l m r : Nat) : Config := ⟨rep m [true, true] (cons false (rep l [true, true] (blank))), rep r [true] (blank), .F⟩

/-- `11^L 0 1 11^M F 1^R`. -/
def FrH (l m r : Nat) : Config := ⟨rep m [true, true] (cons true (cons false (rep l [true, true] (blank)))), rep r [true] (blank), .F⟩

/-- `1 11^L 0 11^M F 1^R`. -/
def Fri (l m r : Nat) : Config := ⟨rep m [true, true] (cons false (rep l [true, true] (cons true (blank)))), rep r [true] (blank), .F⟩

/-- `1 11^L 0 1 11^M F 1^R`. -/
def FrI (l m r : Nat) : Config := ⟨rep m [true, true] (cons true (cons false (rep l [true, true] (cons true (blank))))), rep r [true] (blank), .F⟩

/-- `11^L 0 1^M B`. -/
def Frk (l m : Nat) : Config := ⟨rep m [true] (cons false (rep l [true, true] (blank))), blank, .B⟩

/-- `1 11^L 0 1^M B`. -/
def FrK (l m : Nat) : Config := ⟨rep m [true] (cons false (rep l [true, true] (cons true (blank)))), blank, .B⟩

/-- A frame. -/
inductive Ph where
  | e (l j r : Nat)
  | E (l j r : Nat)
  | f (l r : Nat)
  | F (l r : Nat)
  | g (j r : Nat)
  | h (l m r : Nat)
  | H (l m r : Nat)
  | i (l m r : Nat)
  | I (l m r : Nat)
  | k (l m : Nat)
  | K (l m : Nat)
  deriving DecidableEq, Repr

def Ph.cfg : Ph → Config
  | .e l j r => Fre l j r
  | .E l j r => FrE l j r
  | .f l r => Frf l r
  | .F l r => FrF l r
  | .g j r => Frg j r
  | .h l m r => Frh l m r
  | .H l m r => FrH l m r
  | .i l m r => Fri l m r
  | .I l m r => FrI l m r
  | .k l m => Frk l m
  | .K l m => FrK l m

/-- The frame map. -/
def next : Ph → Option Ph
  | .e l 0 0 => none
  | .e 0 0 1 => some (.g (0) (1))
  | .e 0 0 (r + 2) => some (.g (1) (r + 1))
  | .e (l + 1) 0 1 => some (.g (1) (2 * l + 5))
  | .e (l + 1) 0 2 => some (.g (1) (2 * l + 7))
  | .e (l + 1) 0 (r + 3) => some (.f (l + 3) (r + 1))
  | .e 0 1 0 => some (.g (0) (1))
  | .e (l + 1) 1 0 => some (.g (1) (2 * l + 5))
  | .e l (j + 2) 0 => some (.k (l + 2) (2 * j + 2))
  | .e l 1 1 => some (.k (l + 2) (2))
  | .e l (j + 2) 1 => some (.k (l + 2) (2 * j + 4))
  | .e l 1 (r + 2) => some (.h (l + 2) (0) (r + 1))
  | .e l (j + 2) (r + 2) => some (.h (l + 2) (j + 1) (r + 1))
  | .E l 0 0 => none
  | .E l 0 1 => some (.g (1) (2 * l + 4))
  | .E l 0 2 => some (.g (1) (2 * l + 6))
  | .E l 0 (r + 3) => some (.F (l + 2) (r + 1))
  | .E l 1 0 => some (.g (1) (2 * l + 4))
  | .E l (j + 2) 0 => some (.K (l + 2) (2 * j + 2))
  | .E l 1 1 => some (.K (l + 2) (2))
  | .E l (j + 2) 1 => some (.K (l + 2) (2 * j + 4))
  | .E l 1 (r + 2) => some (.i (l + 2) (0) (r + 1))
  | .E l (j + 2) (r + 2) => some (.i (l + 2) (j + 1) (r + 1))
  | .f l 0 => some (.g (1) (2 * l + 1))
  | .f 0 1 => none
  | .f (l + 1) 1 => some (.e (0) (l) (1))
  | .f 0 (r + 2) => some (.e (0) (0) (r + 1))
  | .f (l + 1) (r + 2) => some (.e (0) (l + 1) (r + 1))
  | .F l 0 => some (.g (1) (2 * l + 2))
  | .F l 1 => some (.g (l) (1))
  | .F 0 (r + 2) => some (.g (1) (r + 1))
  | .F (l + 1) (r + 2) => some (.g (l + 2) (r + 1))
  | .g j 0 => some (.g (1) (2 * j + 1))
  | .g j 1 => some (.g (1) (2 * j + 3))
  | .g j (r + 2) => some (.f (j + 1) (r + 1))
  | .h 0 m 0 => some (.g (1) (2 * m + 1))
  | .h (l + 1) m 0 => some (.k (l + 1) (2 * m + 2))
  | .h l 0 1 => none
  | .h l (m + 1) 1 => some (.e (l) (m) (1))
  | .h l 0 (r + 2) => some (.e (l) (0) (r + 1))
  | .h l (m + 1) (r + 2) => some (.e (l) (m + 1) (r + 1))
  | .H 0 m 0 => some (.g (1) (2 * m + 2))
  | .H 0 m 1 => some (.g (m) (1))
  | .H 0 0 (r + 2) => some (.g (1) (r + 1))
  | .H 0 (m + 1) (r + 2) => some (.g (m + 2) (r + 1))
  | .H (l + 1) m 0 => some (.k (l + 1) (2 * m + 3))
  | .H (l + 1) m 1 => some (.g (1) (2 * l + 2 * m + 5))
  | .H (l + 1) m 2 => some (.g (1) (2 * l + 2 * m + 7))
  | .H (l + 1) 0 (r + 3) => some (.f (l + 3) (r + 1))
  | .H (l + 1) (m + 1) (r + 3) => some (.f (l + m + 4) (r + 1))
  | .i l m 0 => some (.K (l) (2 * m + 2))
  | .i l 0 1 => none
  | .i l (m + 1) 1 => some (.E (l) (m) (1))
  | .i l 0 (r + 2) => some (.E (l) (0) (r + 1))
  | .i l (m + 1) (r + 2) => some (.E (l) (m + 1) (r + 1))
  | .I l m 0 => some (.K (l) (2 * m + 3))
  | .I l m 1 => some (.g (1) (2 * l + 2 * m + 4))
  | .I l m 2 => some (.g (1) (2 * l + 2 * m + 6))
  | .I l 0 (r + 3) => some (.F (l + 2) (r + 1))
  | .I l (m + 1) (r + 3) => some (.F (l + m + 3) (r + 1))
  | .k l 0 => none
  | .k l 1 => some (.g (l) (1))
  | .k l (m + 2) => some (.g (l + 1) (m + 1))
  | .K l 0 => none
  | .K l 1 => some (.e (0) (l) (1))
  | .K l (m + 2) => some (.e (0) (l + 1) (m + 1))

macro "piece" t:term:max : tactic =>
  `(tactic| focus
    simp only [next, Option.some.injEq] at *
    subst_vars
    simp only [Ph.cfg, Fre, FrE, Frf, FrF, Frg, Frh, FrH, Fri, FrI, Frk, FrK]
    refine ⟨_, ?_, steps_eq_of ($t) (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))⟩
    omega)

macro "piece2" t:term:max u:term:max : tactic =>
  `(tactic| focus
    simp only [next, Option.some.injEq] at *
    subst_vars
    simp only [Ph.cfg, Fre, FrE, Frf, FrF, Frg, Frh, FrH, Fri, FrI, Frk, FrK]
    refine ⟨_, ?_, steps_eq_of (steps_seq trans ($t) (steps_eq_of ($u) (cfg_eq (by tape_eq) (by tape_eq)) rfl))
      (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))⟩
    omega)

macro "hpiece" t:term:max : tactic =>
  `(tactic| focus
    simp only [Ph.cfg, Fre, FrE, Frf, FrF, Frg, Frh, FrH, Fri, FrI, Frk, FrK]
    exact ⟨_, _, steps_eq_of ($t) (cfg_eq (by tape_eq) (by tape_eq)) rfl, rfl⟩)

theorem next_sound : ∀ p p', next p = some p' → ∃ n, 0 < n ∧ steps n p.cfg = some p'.cfg
  | .e l 0 0, _, h => by simp [next] at h
  | .e 0 0 1, _, h => by piece pc_e1
  | .e 0 0 (r + 2), _, h => by piece (pc_e2 r)
  | .e (l + 1) 0 1, _, h => by piece (pc_e3 l)
  | .e (l + 1) 0 2, _, h => by piece (pc_e4 l)
  | .e (l + 1) 0 (r + 3), _, h => by piece (pc_e5 l r)
  | .e 0 1 0, _, h => by piece pc_e6
  | .e (l + 1) 1 0, _, h => by piece (pc_e7 l)
  | .e l (j + 2) 0, _, h => by piece (pc_e8 j l)
  | .e l 1 1, _, h => by piece (pc_e9a l)
  | .e l (j + 2) 1, _, h => by piece (pc_e9b j l)
  | .e l 1 (r + 2), _, h => by piece (pc_e10a l r)
  | .e l (j + 2) (r + 2), _, h => by piece (pc_e10b j l r)
  | .E l 0 0, _, h => by simp [next] at h
  | .E l 0 1, _, h => by piece (pc_E1 l)
  | .E l 0 2, _, h => by piece (pc_E2 l)
  | .E l 0 (r + 3), _, h => by piece (pc_E3 l r)
  | .E l 1 0, _, h => by piece (pc_E4 l)
  | .E l (j + 2) 0, _, h => by piece (pc_E5 j l)
  | .E l 1 1, _, h => by piece (pc_E6a l)
  | .E l (j + 2) 1, _, h => by piece (pc_E6b j l)
  | .E l 1 (r + 2), _, h => by piece (pc_E7a l r)
  | .E l (j + 2) (r + 2), _, h => by piece (pc_E7b j l r)
  | .f l 0, _, h => by piece (pc_f0 l)
  | .f 0 1, _, h => by simp [next] at h
  | .f (l + 1) 1, _, h => by piece (pc_f2 l)
  | .f 0 (r + 2), _, h => by piece (pc_f3a r)
  | .f (l + 1) (r + 2), _, h => by piece (pc_f3b l r)
  | .F l 0, _, h => by piece (pc_F0 l)
  | .F l 1, _, h => by piece (pc_F1 l)
  | .F 0 (r + 2), _, h => by piece (pc_F2a r)
  | .F (l + 1) (r + 2), _, h => by piece (pc_F2b l r)
  | .g j 0, _, h => by piece (pc_g0 j)
  | .g j 1, _, h => by piece (pc_g1 j)
  | .g j (r + 2), _, h => by piece (pc_g2 j r)
  | .h 0 m 0, _, h => by piece (pc_h0 m)
  | .h (l + 1) m 0, _, h => by piece (pc_h1 l m)
  | .h l 0 1, _, h => by simp [next] at h
  | .h l (m + 1) 1, _, h => by piece (pc_h3 l m)
  | .h l 0 (r + 2), _, h => by piece (pc_h4a l r)
  | .h l (m + 1) (r + 2), _, h => by piece (pc_h4b l m r)
  | .H 0 m 0, _, h => by piece (pc_H0 m)
  | .H 0 m 1, _, h => by piece (pc_H1 m)
  | .H 0 0 (r + 2), _, h => by piece (pc_H2a r)
  | .H 0 (m + 1) (r + 2), _, h => by piece (pc_H2b m r)
  | .H (l + 1) m 0, _, h => by piece (pc_H3 l m)
  | .H (l + 1) m 1, _, h => by piece (pc_H4 l m)
  | .H (l + 1) m 2, _, h => by piece (pc_H5 l m)
  | .H (l + 1) 0 (r + 3), _, h => by piece (pc_H6a l r)
  | .H (l + 1) (m + 1) (r + 3), _, h => by piece (pc_H6b l m r)
  | .i l m 0, _, h => by piece (pc_i0 l m)
  | .i l 0 1, _, h => by simp [next] at h
  | .i l (m + 1) 1, _, h => by piece (pc_i2 l m)
  | .i l 0 (r + 2), _, h => by piece (pc_i3a l r)
  | .i l (m + 1) (r + 2), _, h => by piece (pc_i3b l m r)
  | .I l m 0, _, h => by piece (pc_I0 l m)
  | .I l m 1, _, h => by piece (pc_I1 l m)
  | .I l m 2, _, h => by piece (pc_I2 l m)
  | .I l 0 (r + 3), _, h => by piece (pc_I3a l r)
  | .I l (m + 1) (r + 3), _, h => by piece (pc_I3b l m r)
  | .k l 0, _, h => by simp [next] at h
  | .k l 1, _, h => by piece (pc_k1 l)
  | .k l (m + 2), _, h => by piece (pc_k2 l m)
  | .K l 0, _, h => by simp [next] at h
  | .K l 1, _, h => by piece (pc_K1 l)
  | .K l (m + 2), _, h => by piece (pc_K2 l m)

/-- Where `next` is `none`, the machine halts. -/
theorem none_halts : ∀ p, next p = none → TM.Halts trans p.cfg
  | .e l 0 0, h => by hpiece (pc_e0 l)
  | .e 0 0 1, h => by simp [next] at h
  | .e 0 0 (r + 2), h => by simp [next] at h
  | .e (l + 1) 0 1, h => by simp [next] at h
  | .e (l + 1) 0 2, h => by simp [next] at h
  | .e (l + 1) 0 (r + 3), h => by simp [next] at h
  | .e 0 1 0, h => by simp [next] at h
  | .e (l + 1) 1 0, h => by simp [next] at h
  | .e l (j + 2) 0, h => by simp [next] at h
  | .e l 1 1, h => by simp [next] at h
  | .e l (j + 2) 1, h => by simp [next] at h
  | .e l 1 (r + 2), h => by simp [next] at h
  | .e l (j + 2) (r + 2), h => by simp [next] at h
  | .E l 0 0, h => by hpiece (pc_E0 l)
  | .E l 0 1, h => by simp [next] at h
  | .E l 0 2, h => by simp [next] at h
  | .E l 0 (r + 3), h => by simp [next] at h
  | .E l 1 0, h => by simp [next] at h
  | .E l (j + 2) 0, h => by simp [next] at h
  | .E l 1 1, h => by simp [next] at h
  | .E l (j + 2) 1, h => by simp [next] at h
  | .E l 1 (r + 2), h => by simp [next] at h
  | .E l (j + 2) (r + 2), h => by simp [next] at h
  | .f l 0, h => by simp [next] at h
  | .f 0 1, h => by hpiece pc_f1
  | .f (l + 1) 1, h => by simp [next] at h
  | .f 0 (r + 2), h => by simp [next] at h
  | .f (l + 1) (r + 2), h => by simp [next] at h
  | .F l 0, h => by simp [next] at h
  | .F l 1, h => by simp [next] at h
  | .F 0 (r + 2), h => by simp [next] at h
  | .F (l + 1) (r + 2), h => by simp [next] at h
  | .g j 0, h => by simp [next] at h
  | .g j 1, h => by simp [next] at h
  | .g j (r + 2), h => by simp [next] at h
  | .h 0 m 0, h => by simp [next] at h
  | .h (l + 1) m 0, h => by simp [next] at h
  | .h l 0 1, h => by hpiece (pc_h2 l)
  | .h l (m + 1) 1, h => by simp [next] at h
  | .h l 0 (r + 2), h => by simp [next] at h
  | .h l (m + 1) (r + 2), h => by simp [next] at h
  | .H 0 m 0, h => by simp [next] at h
  | .H 0 m 1, h => by simp [next] at h
  | .H 0 0 (r + 2), h => by simp [next] at h
  | .H 0 (m + 1) (r + 2), h => by simp [next] at h
  | .H (l + 1) m 0, h => by simp [next] at h
  | .H (l + 1) m 1, h => by simp [next] at h
  | .H (l + 1) m 2, h => by simp [next] at h
  | .H (l + 1) 0 (r + 3), h => by simp [next] at h
  | .H (l + 1) (m + 1) (r + 3), h => by simp [next] at h
  | .i l m 0, h => by simp [next] at h
  | .i l 0 1, h => by hpiece (pc_i1 l)
  | .i l (m + 1) 1, h => by simp [next] at h
  | .i l 0 (r + 2), h => by simp [next] at h
  | .i l (m + 1) (r + 2), h => by simp [next] at h
  | .I l m 0, h => by simp [next] at h
  | .I l m 1, h => by simp [next] at h
  | .I l m 2, h => by simp [next] at h
  | .I l 0 (r + 3), h => by simp [next] at h
  | .I l (m + 1) (r + 3), h => by simp [next] at h
  | .k l 0, h => by hpiece (pc_k0 l)
  | .k l 1, h => by simp [next] at h
  | .k l (m + 2), h => by simp [next] at h
  | .K l 0, h => by hpiece (pc_K0 l)
  | .K l 1, h => by simp [next] at h
  | .K l (m + 2), h => by simp [next] at h

/-- `k` steps of the frame map. -/
def iter : Nat → Ph → Option Ph
  | 0, p => some p
  | k + 1, p => (next p).bind (iter k)

theorem reach_iter : ∀ k p p', iter k p = some p' → ∃ n, k ≤ n ∧ steps n p.cfg = some p'.cfg
  | 0, p, p', h => by simp only [iter, Option.some.injEq] at h; subst h; exact ⟨0, Nat.le_refl 0, rfl⟩
  | k + 1, p, p', h => by
    simp only [iter] at h
    cases hp : next p with
    | none => simp [hp] at h
    | some q =>
      simp only [hp, Option.bind_some] at h
      obtain ⟨n1, p1, h1⟩ := next_sound p q hp
      obtain ⟨n2, p2, h2⟩ := reach_iter k q p' h
      exact ⟨n1 + n2, by omega, steps_seq trans h1 h2⟩

theorem iter_succ (k : Nat) (p p' : Ph) (h : iter k p = some p') : iter (k + 1) p = next p' := by
  induction k generalizing p with
  | zero => simp only [iter, Option.some.injEq] at h; subst h; simp [iter]
  | succ k ih =>
    simp only [iter] at h ⊢
    cases hp : next p with
    | none => simp [hp] at h
    | some q => simp only [hp, Option.bind_some] at h ⊢; exact ih q h

/-- The run from blank tape reaches the first frame. -/
theorem init_start : steps 6 init = some (Ph.g 0 1).cfg := by
  simp only [Ph.cfg, Fre, FrE, Frf, FrF, Frg, Frh, FrH, Fri, FrI, Frk, FrK]
  exact steps_eq_of pc_init (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))

/-- **The machine halts from blank tape if and only if the frame map, iterated from `Ph.g 0 1`, reaches a frame
where it is `none`.** -/
theorem halts_iff :
    HaltsFromBlank ↔ ∃ k p, iter k (Ph.g 0 1) = some p ∧ next p = none := by
  constructor
  · intro hh
    apply Classical.byContradiction
    intro hno
    have hall : ∀ k, ∃ p, iter k (Ph.g 0 1) = some p := by
      intro k
      induction k with
      | zero => exact ⟨_, rfl⟩
      | succ k ih =>
        obtain ⟨p, hp⟩ := ih
        rw [iter_succ k _ p hp]
        cases hn : next p with
        | some q => exact ⟨q, rfl⟩
        | none => exact absurd ⟨k, p, hp, hn⟩ hno
    apply TM.not_halts_of_forall trans _ hh
    apply TM.forall_of_unbounded trans (fun m => ∃ c', steps m init = some c')
    · intro n
      obtain ⟨p, hp⟩ := hall n
      obtain ⟨m, hm, h⟩ := reach_iter n _ p hp
      exact ⟨6 + m, by omega, p.cfg, steps_seq trans init_start h⟩
    · exact fun _ h => h
  · rintro ⟨k, p, h, hn⟩
    obtain ⟨n, -, h1⟩ := reach_iter k _ _ h
    obtain ⟨m, c', h2, h3⟩ := none_halts p hn
    exact ⟨6 + n + m, c', steps_seq trans (steps_seq trans init_start h1) h2, h3⟩

/-- `next` is defined `k` times in a row from `p`. -/
def okFor : Nat → Ph → Bool
  | 0, _ => true
  | k + 1, p => match next p with
    | none => false
    | some q => okFor k q

theorem okFor_sound : ∀ k p, okFor k p = true → ∀ j, j < k → ∀ q, iter j p = some q → next q ≠ none
  | 0, _, _, j, hj, _, _ => absurd hj (Nat.not_lt_zero j)
  | k + 1, p, h, j, hj, q, hi => by
    simp only [okFor] at h
    cases hp : next p with
    | none => simp [hp] at h
    | some r =>
      simp only [hp] at h
      cases j with
      | zero =>
        simp only [iter, Option.some.injEq] at hi; subst hi; simp [hp]
      | succ j =>
        simp only [iter, hp, Option.bind_some] at hi
        exact okFor_sound k r h j (by omega) q hi

/-- No halting frame among the first 100000000 frames of the run from blank tape. -/
theorem no_halt_phases : ∀ j, j < 100000000 → ∀ q, iter j (Ph.g 0 1) = some q → next q ≠ none :=
  okFor_sound _ _ (by native_decide)

end H151878
