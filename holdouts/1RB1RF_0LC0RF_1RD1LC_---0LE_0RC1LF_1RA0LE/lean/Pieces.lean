    steps (2 * m + 3) ⟨rep (m + 1) [true, true] (cons false (rep (l) [true, true] (cons true (blank)))), cons true (blank), .F⟩ = some ⟨rep (l) [true, true] (cons true (blank)), cons false (cons false (rep (m + 1) [true, false] (blank))), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((m + 1) * 2) ⟨rep (m + 1) [true, true] (cons false (rep (l) [true, true] (cons true (blank)))), cons true (blank), .F⟩ = some ⟨cons false (rep (l) [true, true] (cons true (blank))), cons true (rep (m + 1) [true, false] (blank)), .F⟩ :=
    cross_l trans c0 (m + 1) (cons false (rep (l) [true, true] (cons true (blank)))) (blank)
  have h1 : steps 1 ⟨cons false (rep (l) [true, true] (cons true (blank))), cons true (rep (m + 1) [true, false] (blank)), .F⟩ = some ⟨rep (l) [true, true] (cons true (blank)), cons false (cons false (rep (m + 1) [true, false] (blank))), .E⟩ := rfl
  exact steps_congr trans (a := (m + 1) * 2 + (1)) (by omega) (steps_seq trans h0 (h1))

