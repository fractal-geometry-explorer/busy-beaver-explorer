    steps (2) ⟨cons true (blank), rep (r + 2) [true] (blank), .F⟩ = some ⟨blank, cons false (cons true (cons false (rep (r + 1) [true] (blank)))), .F⟩ := by
  have h0 : steps 2 ⟨cons true (blank), rep (r + 2) [true] (blank), .F⟩ = some ⟨blank, cons false (cons true (cons false (rep (r + 1) [true] (blank)))), .F⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- F((l + 1), (r + 2)) reaches g(l + 2, r + 1). -/
theorem pc_F2b (l r : Nat) :
    steps (2 * l + 4) ⟨rep (l + 1) [true, true] (cons true (blank)), rep (r + 2) [true] (blank), .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (l) [false, true] (cons false (rep (r + 1) [true] (blank))))))), .F⟩ := by
  have h0 : steps 1 ⟨rep (l + 1) [true, true] (cons true (blank)), rep (r + 2) [true] (blank), .F⟩ = some ⟨cons true (rep (l) [true, true] (cons true (blank))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (l) [true, true] (cons true (blank))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ = some ⟨rep (l) [true, true] (cons true (cons true (blank))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (l) [true, true] (cons true (blank))) = rep (l) [true, true] (cons true (cons true (blank))) from
      rep_rotate (l) [true] [true, true] [true, true] rfl (cons true (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((l) * 2) ⟨rep (l) [true, true] (cons true (cons true (blank))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ = some ⟨cons true (cons true (blank)), cons true (rep (l) [false, true] (cons false (rep (r + 1) [true] (blank)))), .E⟩ :=
    cross_l trans c2 (l) (cons true (cons true (blank))) (cons false (rep (r + 1) [true] (blank)))
  have h3 : steps 3 ⟨cons true (cons true (blank)), cons true (rep (l) [false, true] (cons false (rep (r + 1) [true] (blank)))), .E⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (l) [false, true] (cons false (rep (r + 1) [true] (blank))))))), .F⟩ := rfl
  exact steps_congr trans (a := 1 + (0 + ((l) * 2 + (3)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- g(j, 0) reaches g(1, 2 * j + 1). -/
theorem pc_g0 (j : Nat) :
    steps (4 * j + 8) ⟨blank, cons false (rep (j) [true, false] (blank)), .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (j) [true, true] (cons false (blank)))))), .F⟩ := by
  have h0 : steps 0 ⟨blank, cons false (rep (j) [true, false] (blank)), .F⟩ = some ⟨blank, rep (j) [false, true] (cons false (blank)), .F⟩ := by
    simp only [steps_zero, show cons false (rep (j) [true, false] (blank)) = rep (j) [false, true] (cons false (blank)) from
      rep_rotate (j) [false] [true, false] [false, true] rfl (blank)]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [true, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 2) ⟨blank, rep (j) [false, true] (cons false (blank)), .F⟩ = some ⟨rep (j) [true, true] (blank), cons false (blank), .F⟩ :=
    cross_r trans c1 (j) (blank) (cons false (blank))
  have h2 : steps 3 ⟨rep (j) [true, true] (blank), cons false (blank), .F⟩ = some ⟨cons true (rep (j) [true, true] (blank)), cons true (cons false (blank)), .C⟩ := rfl
  have h3 : steps 0 ⟨cons true (rep (j) [true, true] (blank)), cons true (cons false (blank)), .C⟩ = some ⟨rep (j) [true, true] (cons true (blank)), cons true (cons false (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (rep (j) [true, true] (blank)) = rep (j) [true, true] (cons true (blank)) from
      rep_rotate (j) [true] [true, true] [true, true] rfl (blank)]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 2) ⟨rep (j) [true, true] (cons true (blank)), cons true (cons false (blank)), .C⟩ = some ⟨cons true (blank), cons true (rep (j) [true, true] (cons false (blank))), .C⟩ :=
    cross_l trans c4 (j) (cons true (blank)) (cons false (blank))
  have h5 : steps 5 ⟨cons true (blank), cons true (rep (j) [true, true] (cons false (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (j) [true, true] (cons false (blank)))))), .F⟩ := rfl
  exact steps_congr trans (a := 0 + ((j) * 2 + (3 + (0 + ((j) * 2 + (5)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- g(j, 1) reaches g(1, 2 * j + 3). -/
theorem pc_g1 (j : Nat) :
    steps (4 * j + 12) ⟨blank, cons false (rep (j) [true, false] (cons true (blank))), .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (j) [true, true] (cons true (cons true (cons false (blank)))))))), .F⟩ := by
  have h0 : steps 0 ⟨blank, cons false (rep (j) [true, false] (cons true (blank))), .F⟩ = some ⟨blank, rep (j) [false, true] (cons false (cons true (blank))), .F⟩ := by
    simp only [steps_zero, show cons false (rep (j) [true, false] (cons true (blank))) = rep (j) [false, true] (cons false (cons true (blank))) from
      rep_rotate (j) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [true, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 2) ⟨blank, rep (j) [false, true] (cons false (cons true (blank))), .F⟩ = some ⟨rep (j) [true, true] (blank), cons false (cons true (blank)), .F⟩ :=
    cross_r trans c1 (j) (blank) (cons false (cons true (blank)))
  have h2 : steps 7 ⟨rep (j) [true, true] (blank), cons false (cons true (blank)), .F⟩ = some ⟨cons true (rep (j) [true, true] (blank)), cons true (cons true (cons true (cons false (blank)))), .C⟩ := rfl
  have h3 : steps 0 ⟨cons true (rep (j) [true, true] (blank)), cons true (cons true (cons true (cons false (blank)))), .C⟩ = some ⟨rep (j) [true, true] (cons true (blank)), cons true (cons true (cons true (cons false (blank)))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (j) [true, true] (blank)) = rep (j) [true, true] (cons true (blank)) from
      rep_rotate (j) [true] [true, true] [true, true] rfl (blank)]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 2) ⟨rep (j) [true, true] (cons true (blank)), cons true (cons true (cons true (cons false (blank)))), .C⟩ = some ⟨cons true (blank), cons true (rep (j) [true, true] (cons true (cons true (cons false (blank))))), .C⟩ :=
    cross_l trans c4 (j) (cons true (blank)) (cons true (cons true (cons false (blank))))
  have h5 : steps 5 ⟨cons true (blank), cons true (rep (j) [true, true] (cons true (cons true (cons false (blank))))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (j) [true, true] (cons true (cons true (cons false (blank)))))))), .F⟩ := rfl
  exact steps_congr trans (a := 0 + ((j) * 2 + (7 + (0 + ((j) * 2 + (5)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- g(j, (r + 2)) reaches f(j + 1, r + 1). -/
theorem pc_g2 (j r : Nat) :
    steps (2 * j + 2) ⟨blank, cons false (rep (j) [true, false] (rep (r + 2) [true] (blank))), .F⟩ = some ⟨cons true (cons true (rep (j) [true, true] (blank))), rep (r + 1) [true] (blank), .F⟩ := by
  have h0 : steps 0 ⟨blank, cons false (rep (j) [true, false] (rep (r + 2) [true] (blank))), .F⟩ = some ⟨blank, rep (j) [false, true] (cons false (rep (r + 2) [true] (blank))), .F⟩ := by
    simp only [steps_zero, show cons false (rep (j) [true, false] (rep (r + 2) [true] (blank))) = rep (j) [false, true] (cons false (rep (r + 2) [true] (blank))) from
      rep_rotate (j) [false] [true, false] [false, true] rfl (rep (r + 2) [true] (blank))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [true, true] L), R, .F⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 2) ⟨blank, rep (j) [false, true] (cons false (rep (r + 2) [true] (blank))), .F⟩ = some ⟨rep (j) [true, true] (blank), cons false (rep (r + 2) [true] (blank)), .F⟩ :=
    cross_r trans c1 (j) (blank) (cons false (rep (r + 2) [true] (blank)))
  have h2 : steps 2 ⟨rep (j) [true, true] (blank), cons false (rep (r + 2) [true] (blank)), .F⟩ = some ⟨cons true (cons true (rep (j) [true, true] (blank))), rep (r + 1) [true] (blank), .F⟩ := rfl
  exact steps_congr trans (a := 0 + ((j) * 2 + (2))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- h(0, m, 0) reaches g(1, 2 * m + 1). -/
theorem pc_h0 (m : Nat) :
    steps (2 * m + 8) ⟨rep (m) [true, true] (cons false (blank)), blank, .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (m) [true, true] (cons false (blank)))))), .F⟩ := by
  have h0 : steps 3 ⟨rep (m) [true, true] (cons false (blank)), blank, .F⟩ = some ⟨cons true (rep (m) [true, true] (cons false (blank))), cons true (cons false (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (m) [true, true] (cons false (blank))), cons true (cons false (blank)), .C⟩ = some ⟨rep (m) [true, true] (cons true (cons false (blank))), cons true (cons false (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (rep (m) [true, true] (cons false (blank))) = rep (m) [true, true] (cons true (cons false (blank))) from
      rep_rotate (m) [true] [true, true] [true, true] rfl (cons false (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((m) * 2) ⟨rep (m) [true, true] (cons true (cons false (blank))), cons true (cons false (blank)), .C⟩ = some ⟨cons true (cons false (blank)), cons true (rep (m) [true, true] (cons false (blank))), .C⟩ :=
    cross_l trans c2 (m) (cons true (cons false (blank))) (cons false (blank))
  have h3 : steps 5 ⟨cons true (cons false (blank)), cons true (rep (m) [true, true] (cons false (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (m) [true, true] (cons false (blank)))))), .F⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((m) * 2 + (5)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- h((l + 1), m, 0) reaches k(l + 1, 2 * m + 2). -/
theorem pc_h1 (l m : Nat) :
    steps (2) ⟨rep (m) [true, true] (cons false (rep (l + 1) [true, true] (blank))), blank, .F⟩ = some ⟨cons true (cons true (rep (m) [true, true] (cons false (rep (l + 1) [true, true] (blank))))), blank, .B⟩ := by
  have h0 : steps 2 ⟨rep (m) [true, true] (cons false (rep (l + 1) [true, true] (blank))), blank, .F⟩ = some ⟨cons true (cons true (rep (m) [true, true] (cons false (rep (l + 1) [true, true] (blank))))), blank, .B⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- h(l, 0, 1) runs into the halting transition. -/
theorem pc_h2 (l : Nat) :
    steps (3) ⟨cons false (rep (l) [true, true] (blank)), cons true (blank), .F⟩ = some ⟨cons true (cons false (rep (l) [true, true] (blank))), blank, .D⟩ := by
  have h0 : steps 3 ⟨cons false (rep (l) [true, true] (blank)), cons true (blank), .F⟩ = some ⟨cons true (cons false (rep (l) [true, true] (blank))), blank, .D⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)

/-- h(l, (m + 1), 1) reaches e(l, m, 1). -/
theorem pc_h3 (l m : Nat) :
    steps (2 * m + 3) ⟨rep (m + 1) [true, true] (cons false (rep (l) [true, true] (blank))), cons true (blank), .F⟩ = some ⟨rep (l) [true, true] (blank), cons false (cons false (rep (m + 1) [true, false] (blank))), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((m + 1) * 2) ⟨rep (m + 1) [true, true] (cons false (rep (l) [true, true] (blank))), cons true (blank), .F⟩ = some ⟨cons false (rep (l) [true, true] (blank)), cons true (rep (m + 1) [true, false] (blank)), .F⟩ :=
    cross_l trans c0 (m + 1) (cons false (rep (l) [true, true] (blank))) (blank)
  have h1 : steps 1 ⟨cons false (rep (l) [true, true] (blank)), cons true (rep (m + 1) [true, false] (blank)), .F⟩ = some ⟨rep (l) [true, true] (blank), cons false (cons false (rep (m + 1) [true, false] (blank))), .E⟩ := rfl
  exact steps_congr trans (a := (m + 1) * 2 + (1)) (by omega) (steps_seq trans h0 (h1))

/-- h(l, 0, (r + 2)) reaches e(l, 0, r + 1). -/
theorem pc_h4a (l r : Nat) :
    steps (1) ⟨cons false (rep (l) [true, true] (blank)), rep (r + 2) [true] (blank), .F⟩ = some ⟨rep (l) [true, true] (blank), cons false (cons false (rep (r + 1) [true] (blank))), .E⟩ := by
  have h0 : steps 1 ⟨cons false (rep (l) [true, true] (blank)), rep (r + 2) [true] (blank), .F⟩ = some ⟨rep (l) [true, true] (blank), cons false (cons false (rep (r + 1) [true] (blank))), .E⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

/-- h(l, (m + 1), (r + 2)) reaches e(l, m + 1, r + 1). -/
theorem pc_h4b (l m r : Nat) :
    steps (2 * m + 3) ⟨rep (m + 1) [true, true] (cons false (rep (l) [true, true] (blank))), rep (r + 2) [true] (blank), .F⟩ = some ⟨rep (l) [true, true] (blank), cons false (cons false (cons true (rep (m) [false, true] (cons false (rep (r + 1) [true] (blank)))))), .E⟩ := by
  have h0 : steps 1 ⟨rep (m + 1) [true, true] (cons false (rep (l) [true, true] (blank))), rep (r + 2) [true] (blank), .F⟩ = some ⟨cons true (rep (m) [true, true] (cons false (rep (l) [true, true] (blank)))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (m) [true, true] (cons false (rep (l) [true, true] (blank)))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ = some ⟨rep (m) [true, true] (cons true (cons false (rep (l) [true, true] (blank)))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (m) [true, true] (cons false (rep (l) [true, true] (blank)))) = rep (m) [true, true] (cons true (cons false (rep (l) [true, true] (blank)))) from
      rep_rotate (m) [true] [true, true] [true, true] rfl (cons false (rep (l) [true, true] (blank)))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((m) * 2) ⟨rep (m) [true, true] (cons true (cons false (rep (l) [true, true] (blank)))), cons true (cons false (rep (r + 1) [true] (blank))), .E⟩ = some ⟨cons true (cons false (rep (l) [true, true] (blank))), cons true (rep (m) [false, true] (cons false (rep (r + 1) [true] (blank)))), .E⟩ :=
    cross_l trans c2 (m) (cons true (cons false (rep (l) [true, true] (blank)))) (cons false (rep (r + 1) [true] (blank)))
  have h3 : steps 2 ⟨cons true (cons false (rep (l) [true, true] (blank))), cons true (rep (m) [false, true] (cons false (rep (r + 1) [true] (blank)))), .E⟩ = some ⟨rep (l) [true, true] (blank), cons false (cons false (cons true (rep (m) [false, true] (cons false (rep (r + 1) [true] (blank)))))), .E⟩ := rfl
  exact steps_congr trans (a := 1 + (0 + ((m) * 2 + (2)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- H(0, m, 0) reaches g(1, 2 * m + 2). -/
theorem pc_H0 (m : Nat) :
    steps (2 * m + 9) ⟨rep (m) [true, true] (cons true (cons false (blank))), blank, .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (m) [true, true] (cons false (blank))))))), .F⟩ := by
  have h0 : steps 3 ⟨rep (m) [true, true] (cons true (cons false (blank))), blank, .F⟩ = some ⟨cons true (rep (m) [true, true] (cons true (cons false (blank)))), cons true (cons false (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (m) [true, true] (cons true (cons false (blank)))), cons true (cons false (blank)), .C⟩ = some ⟨rep (m) [true, true] (cons true (cons true (cons false (blank)))), cons true (cons false (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (rep (m) [true, true] (cons true (cons false (blank)))) = rep (m) [true, true] (cons true (cons true (cons false (blank)))) from
      rep_rotate (m) [true] [true, true] [true, true] rfl (cons true (cons false (blank)))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((m) * 2) ⟨rep (m) [true, true] (cons true (cons true (cons false (blank)))), cons true (cons false (blank)), .C⟩ = some ⟨cons true (cons true (cons false (blank))), cons true (rep (m) [true, true] (cons false (blank))), .C⟩ :=
    cross_l trans c2 (m) (cons true (cons true (cons false (blank)))) (cons false (blank))
  have h3 : steps 6 ⟨cons true (cons true (cons false (blank))), cons true (rep (m) [true, true] (cons false (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (m) [true, true] (cons false (blank))))))), .F⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((m) * 2 + (6)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- H(0, m, 1) reaches g(m, 1). -/
theorem pc_H1 (m : Nat) :
    steps (2 * m + 2) ⟨rep (m) [true, true] (cons true (cons false (blank))), cons true (blank), .F⟩ = some ⟨blank, cons false (cons true (cons false (rep (m) [true, false] (blank)))), .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((m) * 2) ⟨rep (m) [true, true] (cons true (cons false (blank))), cons true (blank), .F⟩ = some ⟨cons true (cons false (blank)), cons true (rep (m) [true, false] (blank)), .F⟩ :=
    cross_l trans c0 (m) (cons true (cons false (blank))) (blank)
  have h1 : steps 2 ⟨cons true (cons false (blank)), cons true (rep (m) [true, false] (blank)), .F⟩ = some ⟨blank, cons false (cons true (cons false (rep (m) [true, false] (blank)))), .F⟩ := rfl
  exact steps_congr trans (a := (m) * 2 + (2)) (by omega) (steps_seq trans h0 (h1))

/-- H(0, 0, (r + 2)) reaches g(1, r + 1). -/
theorem pc_H2a (r : Nat) :
    steps (2) ⟨cons true (cons false (blank)), rep (r + 2) [true] (blank), .F⟩ = some ⟨blank, cons false (cons true (cons false (rep (r + 1) [true] (blank)))), .F⟩ := by
  have h0 : steps 2 ⟨cons true (cons false (blank)), rep (r + 2) [true] (blank), .F⟩ = some ⟨blank, cons false (cons true (cons false (rep (r + 1) [true] (blank)))), .F⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- H(0, (m + 1), (r + 2)) reaches g(m + 2, r + 1). -/
theorem pc_H2b (m r : Nat) :
    steps (2 * m + 4) ⟨rep (m + 1) [true, true] (cons true (cons false (blank))), rep (r + 2) [true] (blank), .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (m) [false, true] (cons false (rep (r + 1) [true] (blank))))))), .F⟩ := by
