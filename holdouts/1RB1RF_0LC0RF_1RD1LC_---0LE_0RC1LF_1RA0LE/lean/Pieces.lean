      rep_rotate (m) [true] [false, true] [true, false] rfl (cons false (rep (r + 2) [true] (blank)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((m) * 2) ⟨cons true (cons true (cons true (rep (l) [true, true] (cons true (blank))))), rep (m) [true, false] (cons true (cons false (rep (r + 2) [true] (blank)))), .A⟩ = some ⟨rep (m) [true, true] (cons true (cons true (cons true (rep (l) [true, true] (cons true (blank)))))), cons true (cons false (rep (r + 2) [true] (blank))), .A⟩ :=
    cross_r trans c5 (m) (cons true (cons true (cons true (rep (l) [true, true] (cons true (blank)))))) (cons true (cons false (rep (r + 2) [true] (blank))))
  have h6 : steps 3 ⟨rep (m) [true, true] (cons true (cons true (cons true (rep (l) [true, true] (cons true (blank)))))), cons true (cons false (rep (r + 2) [true] (blank))), .A⟩ = some ⟨cons true (cons true (cons true (rep (m) [true, true] (cons true (cons true (cons true (rep (l) [true, true] (cons true (blank))))))))), rep (r + 1) [true] (blank), .F⟩ := rfl
  exact steps_congr trans (a := 1 + (0 + ((m) * 2 + (6 + (0 + ((m) * 2 + (3))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- k(l, 0) runs into the halting transition. -/
theorem pc_k0 (l : Nat) :
    steps (2) ⟨cons false (rep (l) [true, true] (blank)), blank, .B⟩ = some ⟨cons true (rep (l) [true, true] (blank)), cons false (blank), .D⟩ := by
  have h0 : steps 2 ⟨cons false (rep (l) [true, true] (blank)), blank, .B⟩ = some ⟨cons true (rep (l) [true, true] (blank)), cons false (blank), .D⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- k(l, 1) reaches g(l, 1). -/
theorem pc_k1 (l : Nat) :
    steps (2 * l + 5) ⟨cons true (cons false (rep (l) [true, true] (blank))), blank, .B⟩ = some ⟨blank, cons false (cons true (rep (l) [false, true] (cons false (cons false (blank))))), .F⟩ := by
  have h0 : steps 4 ⟨cons true (cons false (rep (l) [true, true] (blank))), blank, .B⟩ = some ⟨rep (l) [true, true] (blank), cons true (cons false (cons false (blank))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h1 : steps ((l) * 2) ⟨rep (l) [true, true] (blank), cons true (cons false (cons false (blank))), .E⟩ = some ⟨blank, cons true (rep (l) [false, true] (cons false (cons false (blank)))), .E⟩ :=
    cross_l trans c1 (l) (blank) (cons false (cons false (blank)))
  have h2 : steps 1 ⟨blank, cons true (rep (l) [false, true] (cons false (cons false (blank)))), .E⟩ = some ⟨blank, cons false (cons true (rep (l) [false, true] (cons false (cons false (blank))))), .F⟩ := rfl
  exact steps_congr trans (a := 4 + ((l) * 2 + (1))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- k(l, (m + 2)) reaches g(l + 1, m + 1). -/
theorem pc_k2 (l m : Nat) :
    steps (2 * l + m + 6) ⟨rep (m + 2) [true] (cons false (rep (l) [true, true] (blank))), blank, .B⟩ = some ⟨blank, cons false (cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank)))))), .F⟩ := by
  have h0 : steps 1 ⟨rep (m + 2) [true] (cons false (rep (l) [true, true] (blank))), blank, .B⟩ = some ⟨rep (m + 1) [true] (cons false (rep (l) [true, true] (blank))), cons true (cons false (blank)), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((m + 1) * 1) ⟨rep (m + 1) [true] (cons false (rep (l) [true, true] (blank))), cons true (cons false (blank)), .C⟩ = some ⟨cons false (rep (l) [true, true] (blank)), cons true (rep (m + 1) [true] (cons false (blank))), .C⟩ :=
    cross_l trans c1 (m + 1) (cons false (rep (l) [true, true] (blank))) (cons false (blank))
  have h2 : steps 3 ⟨cons false (rep (l) [true, true] (blank)), cons true (rep (m + 1) [true] (cons false (blank))), .C⟩ = some ⟨rep (l) [true, true] (blank), cons true (cons false (rep (m + 1) [true] (cons false (blank)))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((l) * 2) ⟨rep (l) [true, true] (blank), cons true (cons false (rep (m + 1) [true] (cons false (blank)))), .E⟩ = some ⟨blank, cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank))))), .E⟩ :=
    cross_l trans c3 (l) (blank) (cons false (rep (m + 1) [true] (cons false (blank))))
  have h4 : steps 1 ⟨blank, cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank))))), .E⟩ = some ⟨blank, cons false (cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank)))))), .F⟩ := rfl
  exact steps_congr trans (a := 1 + ((m + 1) * 1 + (3 + ((l) * 2 + (1))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- K(l, 0) runs into the halting transition. -/
theorem pc_K0 (l : Nat) :
    steps (2) ⟨cons false (rep (l) [true, true] (cons true (blank))), blank, .B⟩ = some ⟨cons true (rep (l) [true, true] (cons true (blank))), cons false (blank), .D⟩ := by
  have h0 : steps 2 ⟨cons false (rep (l) [true, true] (cons true (blank))), blank, .B⟩ = some ⟨cons true (rep (l) [true, true] (cons true (blank))), cons false (blank), .D⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- K(l, 1) reaches e(0, l, 1). -/
theorem pc_K1 (l : Nat) :
    steps (2 * l + 6) ⟨cons true (cons false (rep (l) [true, true] (cons true (blank)))), blank, .B⟩ = some ⟨blank, cons false (cons false (cons true (rep (l) [false, true] (cons false (cons false (blank)))))), .E⟩ := by
  have h0 : steps 4 ⟨cons true (cons false (rep (l) [true, true] (cons true (blank)))), blank, .B⟩ = some ⟨rep (l) [true, true] (cons true (blank)), cons true (cons false (cons false (blank))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h1 : steps ((l) * 2) ⟨rep (l) [true, true] (cons true (blank)), cons true (cons false (cons false (blank))), .E⟩ = some ⟨cons true (blank), cons true (rep (l) [false, true] (cons false (cons false (blank)))), .E⟩ :=
    cross_l trans c1 (l) (cons true (blank)) (cons false (cons false (blank)))
  have h2 : steps 2 ⟨cons true (blank), cons true (rep (l) [false, true] (cons false (cons false (blank)))), .E⟩ = some ⟨blank, cons false (cons false (cons true (rep (l) [false, true] (cons false (cons false (blank)))))), .E⟩ := rfl
  exact steps_congr trans (a := 4 + ((l) * 2 + (2))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- K(l, (m + 2)) reaches e(0, l + 1, m + 1). -/
theorem pc_K2 (l m : Nat) :
    steps (2 * l + m + 7) ⟨rep (m + 2) [true] (cons false (rep (l) [true, true] (cons true (blank)))), blank, .B⟩ = some ⟨blank, cons false (cons false (cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank))))))), .E⟩ := by
  have h0 : steps 1 ⟨rep (m + 2) [true] (cons false (rep (l) [true, true] (cons true (blank)))), blank, .B⟩ = some ⟨rep (m + 1) [true] (cons false (rep (l) [true, true] (cons true (blank)))), cons true (cons false (blank)), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((m + 1) * 1) ⟨rep (m + 1) [true] (cons false (rep (l) [true, true] (cons true (blank)))), cons true (cons false (blank)), .C⟩ = some ⟨cons false (rep (l) [true, true] (cons true (blank))), cons true (rep (m + 1) [true] (cons false (blank))), .C⟩ :=
    cross_l trans c1 (m + 1) (cons false (rep (l) [true, true] (cons true (blank)))) (cons false (blank))
  have h2 : steps 3 ⟨cons false (rep (l) [true, true] (cons true (blank))), cons true (rep (m + 1) [true] (cons false (blank))), .C⟩ = some ⟨rep (l) [true, true] (cons true (blank)), cons true (cons false (rep (m + 1) [true] (cons false (blank)))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((l) * 2) ⟨rep (l) [true, true] (cons true (blank)), cons true (cons false (rep (m + 1) [true] (cons false (blank)))), .E⟩ = some ⟨cons true (blank), cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank))))), .E⟩ :=
    cross_l trans c3 (l) (cons true (blank)) (cons false (rep (m + 1) [true] (cons false (blank))))
  have h4 : steps 2 ⟨cons true (blank), cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank))))), .E⟩ = some ⟨blank, cons false (cons false (cons true (rep (l) [false, true] (cons false (rep (m + 1) [true] (cons false (blank))))))), .E⟩ := rfl
  exact steps_congr trans (a := 1 + ((m + 1) * 1 + (3 + ((l) * 2 + (2))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The run from blank tape reaches the first frame. -/
theorem pc_init :
    steps (6) ⟨blank, blank, .A⟩ = some ⟨blank, cons false (cons true (cons false (cons false (blank)))), .F⟩ := by
  have h0 : steps 6 ⟨blank, blank, .A⟩ = some ⟨blank, cons false (cons true (cons false (cons false (blank)))), .F⟩ := rfl
  exact steps_congr trans (a := 6) (by omega) (h0)

