import Machine

/-! # Shift rules of 1RB---_0RC0LA_1LD0RB_1LE1LD_1LF0LC_1LB1RE

The rightward pass of the bouncer: C runs right over the dense half of the tape, turning each block `1^(4n+3) 0`
into the sparse word `(1010)^n 1000`; two 1s cost 4 steps (`pass_pair`); the same pass seen from B crosses `0111`
in 6 steps (`pass_b`).  The halting situations: A on a 0 with a 1 after it, and B on a 1 with a 1 before it, halt
within two steps (`halt_A`, `halt_B`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H24506

open TM

/-- C turns `1 1` into `1 0`, four steps a pair. -/
theorem pass_pair (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨L, rep (n) [true, true] (R), .C⟩ = some ⟨rep (n) [false, true] (L), R, .C⟩ := by
  have hn : (n) * 4 = 4 * n := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true] R, .C⟩ = some ⟨app [] (app [false, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨L, rep (n) [true, true] (R), .C⟩ = some ⟨rep (n) [false, true] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- A dense block `1^(4n+3) 0` becomes the sparse word `(1010)^n 1000` (left of the head, in tape order). -/
theorem pass_block (n : Nat) (L R : Tape) :
    steps (8 * n + 6) ⟨L, rep (n) [true, true, true, true] (cons true (cons true (cons true (cons false (R))))), .C⟩ = some ⟨cons false (cons false (cons false (cons true (rep (n) [false, true, false, true] (L))))), R, .C⟩ := by
  have hn : (n) * 8 + (6) = 8 * n + 6 := by omega
  have c0 : ∀ L R : Tape, steps 8 ⟨app [] L, app [true, true, true, true] R, .C⟩ = some ⟨app [] (app [false, true, false, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 8) ⟨L, rep (n) [true, true, true, true] (cons true (cons true (cons true (cons false (R))))), .C⟩ = some ⟨rep (n) [false, true, false, true] (L), cons true (cons true (cons true (cons false (R)))), .C⟩ :=
    cross_r trans c0 (n) (L) (cons true (cons true (cons true (cons false (R)))))
  have h1 : steps 6 ⟨rep (n) [false, true, false, true] (L), cons true (cons true (cons true (cons false (R)))), .C⟩ = some ⟨cons false (cons false (cons false (cons true (rep (n) [false, true, false, true] (L))))), R, .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

/-- The last 1 of a block and the 0 after it. -/
theorem pass_end (L R : Tape) :
    steps (2) ⟨L, cons true (cons false (R)), .C⟩ = some ⟨cons false (cons false (L)), R, .C⟩ := by
  have hn : 2 = 2 := by omega
  have h0 : steps 2 ⟨L, cons true (cons false (R)), .C⟩ = some ⟨cons false (cons false (L)), R, .C⟩ := rfl
  exact steps_congr trans hn (h0)

/-- The same pass seen from B: each `0111` becomes `0100`, six steps a copy. -/
theorem pass_b (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨L, rep (n) [false, true, true, true] (R), .B⟩ = some ⟨rep (n) [false, false, true, false] (L), R, .B⟩ := by
  have hn : (n) * 6 = 6 * n := by omega
  have c0 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, true, true] R, .B⟩ = some ⟨app [] (app [false, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨L, rep (n) [false, true, true, true] (R), .B⟩ = some ⟨rep (n) [false, false, true, false] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `A> 0 1` halts: A writes 1, B reads the 1 and steps back left onto it in state A. -/
theorem halt_A (L R : Tape) : ∃ c, steps 2 ⟨L, cons false (cons true (R)), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `1 B> 1` halts: B erases its 1 and steps left onto a 1 in state A. -/
theorem halt_B (L R : Tape) : ∃ c, steps 1 ⟨cons true (L), cons true (R), .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H24506
