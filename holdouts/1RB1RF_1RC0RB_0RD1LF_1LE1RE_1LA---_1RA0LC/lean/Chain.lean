import Rules

/-!
# One step of a doubling chain, for all parameters

Samples `X L K n` = `L (10)^K 1^(2n) A>0 0^inf` (any tape `L` on the left, the head in A at the right end).
Inside a doubling chain (see `py/chains.py`) the machine goes from one sample to the next by

* `chain_even`: `L (10)^(K+2j+5) 1^(4j+2)` reaches `L (10)^K 1^(8j+16)`;
* `chain_odd`:  `L (10)^(K+2j+5) 1^(4j+4)` reaches `L (10)^K 1^(8j+22)`;
* `chain_start`: `L (10)^(k+1) 0 1^5` reaches `L (10)^k 1^18` (through `L (10)^(k+1) 1^11`).

Each is a start piece (`st2` / `st0`), then `j` or `j+1` inner cycles (`cyc`, chained here by induction: each moves
two `10` pairs from the left into the ones and uses up two pairs on the right), then an end piece (`r1` and `en2`,
or `en0`).  The pieces are in `Rules.lean` (generated by `py/gen_rules.py`); this file is written by hand.
-/

namespace H131324

open TM

def Reach (c c' : Config) : Prop := ∃ n, steps n c = some c'

theorem Reach.join {a b c : Config} (h₁ : Reach a b) (h₂ : Reach b c) : Reach a c :=
  let ⟨n, hn⟩ := h₁
  let ⟨m, hm⟩ := h₂
  ⟨n + m, steps_seq trans hn hm⟩

theorem reach_of {n : Nat} {c c' c'' : Config} (h : steps n c = some c') (e : c' = c'') : Reach c c'' :=
  ⟨n, e ▸ h⟩

/-- The sample `L (10)^K 1^(2n) A>0`. -/
def X (L : Tape) (K n : Nat) : Config := ⟨rep n [true, true] (rep K [false, true] L), cons false blank, .A⟩

/-- The frame of the inner cycles: `L (10)^p 1^(8u+4) C>1 0 0 (10)^r 1`. -/
def S (L : Tape) (p u r : Nat) : Config :=
  ⟨rep (2 * u + 1) [true, true, true, true] (rep p [false, true] L),
   cons true (cons false (cons false (rep r [true, false] (cons true blank)))), .C⟩

theorem rep_double (n : Nat) (w : List Bool) (Z : Tape) : rep n (w ++ w) Z = rep (2 * n) w Z := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [rep_succ, ← app_app, ih, show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, rep_succ]

theorem quad (n : Nat) (Z : Tape) : rep n [true, true, true, true] Z = rep (2 * n) [true, true] Z :=
  rep_double n [true, true] Z

theorem L8 (n : Nat) (Y : Tape) :
    cons true (cons true (cons true (rep n [true, true, true, true] (cons true (cons true (cons true (cons true
      (cons true Y)))))))) = rep (n + 2) [true, true, true, true] Y := by
  show app [true, true, true] (rep n [true, true, true, true] (app [true, true, true, true] (cons true Y))) = _
  rw [rep_app_comm, rep_rotate (n + 1) [true, true, true] [true, true, true, true] [true, true, true, true] rfl]
  exact rep_app_comm (n + 1) [true, true, true, true] Y

theorem two_out (n : Nat) (Y : Tape) :
    rep n [true, true, true, true] (cons true (cons true Y)) = cons true (cons true (rep n [true, true, true, true] Y)) :=
  (rep_rotate n [true, true] [true, true, true, true] [true, true, true, true] rfl Y).symm

theorem R1 (j : Nat) :
    cons true (rep j [false, true, false, true] (cons false (cons true blank))) =
      rep (2 * j + 1) [true, false] (cons true blank) := by
  show app [true] (rep j [false, true, false, true] (app [false, true] blank)) = _
  rw [rep_rotate j [true] [false, true, false, true] [true, false, true, false] rfl]
  have h := rep_double j [true, false] (app [true, false] (cons true blank))
  rw [rep_app_comm] at h
  exact h

theorem cyc' (L : Tape) (p u r : Nat) : Reach (S L (p + 2) u (r + 2)) (S L p (u + 1) r) :=
  reach_of (cyc p r u L) (by
    unfold S
    rw [L8, show 2 * u + 1 + 2 = 2 * (u + 1) + 1 by omega])

theorem cycN (L : Tape) (t : Nat) : ∀ p u r, Reach (S L (p + 2 * t) u (r + 2 * t)) (S L p (u + t) r) := by
  induction t with
  | zero => intro p u r; exact ⟨0, rfl⟩
  | succ t ih =>
    intro p u r
    rw [show p + 2 * (t + 1) = (p + 2 * t) + 2 by omega, show r + 2 * (t + 1) = (r + 2 * t) + 2 by omega]
    have h := ih p (u + 1) r
    rw [show u + 1 + t = u + (t + 1) by omega] at h
    exact (cyc' L (p + 2 * t) u (r + 2 * t)).join h

/-- The frame before the last end piece: `L (10)^p 1^(8v+4) C>1 0 0`. -/
def T (L : Tape) (p v : Nat) : Config :=
  ⟨rep (2 * v + 1) [true, true, true, true] (rep p [false, true] L), cons true (cons false (cons false blank)), .C⟩

/-- A chain step with `m = 4j+2`: `L (10)^(K+2j+5) 1^(4j+2) A>0` reaches `L (10)^K 1^(8j+16) A>0`. -/
theorem chain_even (L : Tape) (K j : Nat) : Reach (X L (K + 2 * j + 5) (2 * j + 1)) (X L K (4 * j + 8)) := by
  have hs := st2 j (K + 2 * j + 3) L
  rw [R1, quad] at hs
  have a : Reach (X L (K + 2 * j + 5) (2 * j + 1)) (S L (K + 2 * j + 3) 0 (2 * j + 1)) := ⟨_, hs⟩
  have b := cycN L j (K + 3) 0 1
  rw [show K + 3 + 2 * j = K + 2 * j + 3 by omega, show 1 + 2 * j = 2 * j + 1 by omega, Nat.zero_add] at b
  have hr := r1 (K + 1) j L
  rw [L8] at hr
  have c : Reach (S L (K + 3) j 1) (T L (K + 1) (j + 1)) := by
    refine reach_of hr ?_
    unfold T
    rw [show 2 * (j + 1) + 1 = 2 * j + 1 + 2 by omega, congrArg (cons false) cons_false_blank]
  have he := en2 K (j + 1) L
  have d : Reach (T L (K + 1) (j + 1)) (X L K (4 * j + 8)) := by
    refine reach_of he ?_
    unfold X
    rw [two_out, quad, show 2 * (2 * (j + 1) + 1) = 4 * j + 6 by omega]
    rfl
  exact a.join (b.join (c.join d))

/-- A chain step with `m = 4j+4`: `L (10)^(K+2j+5) 1^(4j+4) A>0` reaches `L (10)^K 1^(8j+22) A>0`. -/
theorem chain_odd (L : Tape) (K j : Nat) : Reach (X L (K + 2 * j + 5) (2 * j + 2)) (X L K (4 * j + 11)) := by
  have hs := st0 j (K + 2 * j + 3) L
  rw [quad, show [true, false, true, false] = [true, false] ++ [true, false] from rfl, rep_double] at hs
  have a : Reach (X L (K + 2 * j + 5) (2 * j + 2)) (S L (K + 2 * j + 3) 0 (2 * (j + 1))) := ⟨_, hs⟩
  have b := cycN L (j + 1) (K + 1) 0 0
  rw [show K + 1 + 2 * (j + 1) = K + 2 * j + 3 by omega, Nat.zero_add, Nat.zero_add] at b
  have he := en0 K (j + 1) L
  have c : Reach (S L (K + 1) (j + 1) 0) (X L K (4 * j + 11)) := by
    refine reach_of he ?_
    unfold X
    rw [two_out, quad, cons_false_blank, show 4 * j + 11 = 2 * (2 * (j + 1) + 1) + 4 + 1 by omega]
    rfl
  exact a.join (b.join c)

/-- The start of a chain: `L (10)^(k+1) 0 1^5 A>0` reaches `L (10)^(k+1) 1^11 A>0` and then `L (10)^k 1^18 A>0`. -/
theorem chain_start (L : Tape) (k : Nat) :
    Reach ⟨cons true (cons true (cons true (cons true (cons true (cons false (rep (k + 1) [false, true] L)))))),
      cons false blank, .A⟩ (X L k 9) := by
  have h1 := s5 (k + 1) L
  have h2 := s11 k L
  have a : Reach ⟨cons true (cons true (cons true (cons true (cons true (cons false (rep (k + 1) [false, true] L)))))),
      cons false blank, .A⟩ ⟨rep 5 [true, true] (cons true (rep (k + 1) [false, true] L)), cons false blank, .A⟩ :=
    reach_of h1 (by rw [cons_false_blank]; rfl)
  exact a.join (reach_of h2 (by unfold X; rw [cons_false_blank]; rfl))

end H131324
