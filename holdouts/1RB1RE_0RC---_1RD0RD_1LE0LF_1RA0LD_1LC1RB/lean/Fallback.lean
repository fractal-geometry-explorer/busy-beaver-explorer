import Machine

/-! # 1RB1RE_0RC---_1RD0RD_1LE0LF_1RA0LD_1LC1RB: the drain rules next to a block with no gap

Each rule holds for every count and every tape in the contexts L, R; written by `py/chain_rules.py` with `bbtools.symtm` (a symbolic run, its trace checked by the kernel).  `0^inf` is blank tape. -/

namespace H8002

open TM

/-- The odd sweep at a last pair `0 (10) 1` with a block `(10)^c 1` right after it (no gap): both are used up, D(A+3,B) -> D(A+1,B+c+4). -/
theorem f_oe1z (b c : Nat) (L R : Tape) :
    steps (6 * b + 4 * c + 28) ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons false (cons false (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .C⟩ = some ⟨cons false (cons true (rep (c) [false, true] (cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))))))), cons false (R), .C⟩ := by
  have hn : 2 + (0 + ((b) * 2 + (10 + (0 + ((b) * 4 + (12 + (0 + ((c) * 4 + (4))))))))) = 6 * b + 4 * c + 28 := by omega
  have h0 : steps 2 ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons false (cons false (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .C⟩ = some ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons true (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons true (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .E⟩ = some ⟨rep (b) [false, true] (cons false (cons true (cons true (cons true (L))))), cons true (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .E⟩ := by
    simp only [steps_zero, show cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))) = rep (b) [false, true] (cons false (cons true (cons true (cons true (L))))) from
      rep_rotate (b) [false] [true, false] [false, true] rfl (cons true (cons true (cons true (L))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((b) * 2) ⟨rep (b) [false, true] (cons false (cons true (cons true (cons true (L))))), cons true (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (b) [true, false] (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))), .E⟩ :=
    cross_l trans c2 (b) (cons false (cons true (cons true (cons true (L))))) (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))
  have h3 : steps 10 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (b) [true, false] (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))), .E⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons false (rep (b) [true, false] (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons false (cons true (L)))), cons false (rep (b) [true, false] (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), rep (b) [false, true] (cons false (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (b) [true, false] (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))) = rep (b) [false, true] (cons false (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))) from
      rep_rotate (b) [false] [true, false] [false, true] rfl (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [false, true] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((b) * 4) ⟨cons false (cons true (cons false (cons true (L)))), rep (b) [false, true] (cons false (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R))))))))), .C⟩ = some ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .C⟩ :=
    cross_r trans c5 (b) (cons false (cons true (cons false (cons true (L))))) (cons false (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))))
  have h6 : steps 12 ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (cons false (R)))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))))), cons false (rep (c) [true, false] (cons true (cons false (R)))), .C⟩ := rfl
  have h7 : steps 0 ⟨cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))))), cons false (rep (c) [true, false] (cons true (cons false (R)))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))))), rep (c) [false, true] (cons false (cons true (cons false (R)))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (c) [true, false] (cons true (cons false (R)))) = rep (c) [false, true] (cons false (cons true (cons false (R)))) from
      rep_rotate (c) [false] [true, false] [false, true] rfl (cons true (cons false (R)))]
  have c8 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [false, true] L), R, .C⟩ := fun _ _ => rfl
  have h8 : steps ((c) * 4) ⟨cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))))), rep (c) [false, true] (cons false (cons true (cons false (R)))), .C⟩ = some ⟨rep (c) [false, true] (cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))))), cons false (cons true (cons false (R))), .C⟩ :=
    cross_r trans c8 (c) (cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))))) (cons false (cons true (cons false (R))))
  have h9 : steps 4 ⟨rep (c) [false, true] (cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))))), cons false (cons true (cons false (R))), .C⟩ = some ⟨cons false (cons true (rep (c) [false, true] (cons false (cons true (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))))))), cons false (R), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

/-- The drain at a block `0 0 (10)^c 1` with a block `(10)^(d+2) 1` right after it (no gap): the first block is merged and the second becomes `0 (10)^d 1`, D(A+3,B) -> D(A+1,B+c+4). -/
theorem f_ab_z (b c d : Nat) (L R : Tape) :
    steps (6 * b + 4 * c + 28) ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons false (cons false (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))))))), cons false (cons false (rep (d) [true, false] (cons true (R)))), .C⟩ := by
  have hn : 2 + (0 + ((b) * 2 + (10 + (0 + ((b) * 4 + (4 + (0 + ((c) * 4 + (12))))))))) = 6 * b + 4 * c + 28 := by omega
  have h0 : steps 2 ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons false (cons false (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .C⟩ = some ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons true (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))), cons true (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .E⟩ = some ⟨rep (b) [false, true] (cons false (cons true (cons true (cons true (L))))), cons true (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .E⟩ := by
    simp only [steps_zero, show cons false (rep (b) [true, false] (cons true (cons true (cons true (L))))) = rep (b) [false, true] (cons false (cons true (cons true (cons true (L))))) from
      rep_rotate (b) [false] [true, false] [false, true] rfl (cons true (cons true (cons true (L))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((b) * 2) ⟨rep (b) [false, true] (cons false (cons true (cons true (cons true (L))))), cons true (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (b) [true, false] (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))), .E⟩ :=
    cross_l trans c2 (b) (cons false (cons true (cons true (cons true (L))))) (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))
  have h3 : steps 10 ⟨cons false (cons true (cons true (cons true (L)))), cons true (rep (b) [true, false] (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))), .E⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons false (rep (b) [true, false] (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons false (cons true (L)))), cons false (rep (b) [true, false] (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), rep (b) [false, true] (cons false (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (b) [true, false] (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))) = rep (b) [false, true] (cons false (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))) from
      rep_rotate (b) [false] [true, false] [false, true] rfl (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [false, true] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((b) * 4) ⟨cons false (cons true (cons false (cons true (L)))), rep (b) [false, true] (cons false (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R)))))))), .C⟩ = some ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .C⟩ :=
    cross_r trans c5 (b) (cons false (cons true (cons false (cons true (L))))) (cons false (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))))
  have h6 : steps 4 ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))), cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))), .C⟩ := rfl
  have h7 : steps 0 ⟨cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))), cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))), .C⟩ = some ⟨cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))), rep (c) [false, true] (cons false (cons true (rep (d + 2) [true, false] (cons true (R))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (c) [true, false] (cons true (rep (d + 2) [true, false] (cons true (R))))) = rep (c) [false, true] (cons false (cons true (rep (d + 2) [true, false] (cons true (R))))) from
      rep_rotate (c) [false] [true, false] [false, true] rfl (cons true (rep (d + 2) [true, false] (cons true (R))))]
  have c8 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [false, true] L), R, .C⟩ := fun _ _ => rfl
  have h8 : steps ((c) * 4) ⟨cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L))))))), rep (c) [false, true] (cons false (cons true (rep (d + 2) [true, false] (cons true (R))))), .C⟩ = some ⟨rep (c) [false, true] (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))), cons false (cons true (rep (d + 2) [true, false] (cons true (R)))), .C⟩ :=
    cross_r trans c8 (c) (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))) (cons false (cons true (rep (d + 2) [true, false] (cons true (R)))))
  have h9 : steps 12 ⟨rep (c) [false, true] (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))), cons false (cons true (rep (d + 2) [true, false] (cons true (R)))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (rep (c) [false, true] (cons false (cons true (rep (b) [false, true] (cons false (cons true (cons false (cons true (L)))))))))))), cons false (cons false (rep (d) [true, false] (cons true (R)))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

/-- The odd sweep at a block `0 1` with a block `(10)^(c+1) 1` right after it, an odd number of pairs: D(A+3,2k+1) -> S = D(1,0) with blocks `0^(A-1) (10)^(2k+3) 1` and `(10)^c 1` in front of the rest. -/
theorem f_oe0z_odd (a c k : Nat) (R : Tape) :
    steps (3 * a + 26 * k + 57) ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank)))))))), cons false (cons false (cons true (rep (c + 1) [true, false] (cons true (R))))), .C⟩ = some ⟨cons false (cons true (blank)), cons false (rep (a) [false] (cons false (cons false (cons true (cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))))))))))), .C⟩ := by
  have hn : 2 + (0 + ((k) * 4 + (12 + (0 + ((k) * 8 + (19 + (0 + ((k) * 14 + (17 + ((a) * 3 + (7))))))))))) = 3 * a + 26 * k + 57 := by omega
  have h0 : steps 2 ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank)))))))), cons false (cons false (cons true (rep (c + 1) [true, false] (cons true (R))))), .C⟩ = some ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank)))))))), cons true (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank)))))))), cons true (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))), .E⟩ = some ⟨rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank)))))))), cons true (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))), .E⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank)))))))) = rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank)))))))) from
      rep_rotate (k) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons true (cons true (rep (a) [true] (blank)))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 4) ⟨rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank)))))))), cons true (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))), .E⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank))))))), cons true (rep (k) [true, false, true, false] (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))), .E⟩ :=
    cross_l trans c2 (k) (cons false (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank)))))))) (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))
  have h3 : steps 12 ⟨cons false (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank))))))), cons true (rep (k) [true, false, true, false] (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))), .E⟩ = some ⟨cons false (cons true (cons false (cons true (rep (a) [true] (blank))))), cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons false (cons true (rep (a) [true] (blank))))), cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (rep (a) [true] (blank))))), rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))))) = rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))))) from
      rep_rotate (k) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))]
  have c5 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, true, false, true] R, .C⟩ = some ⟨app [] (app [false, true, false, true] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((k) * 8) ⟨cons false (cons true (cons false (cons true (rep (a) [true] (blank))))), rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))))), .C⟩ = some ⟨rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (rep (a) [true] (blank)))))), cons false (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))))), .C⟩ :=
    cross_r trans c5 (k) (cons false (cons true (cons false (cons true (rep (a) [true] (blank)))))) (cons false (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))))))
  have h6 : steps 19 ⟨rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (rep (a) [true] (blank)))))), cons false (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ := rfl
  have h7 : steps 0 ⟨cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ = some ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))))) from
      rep_rotate (k) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))]
  have c8 : ∀ L R : Tape, steps 14 ⟨app [true, false, true, false] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .E⟩ := fun _ _ => rfl
  have h8 : steps ((k) * 14) ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank)))))))), cons true (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))), .E⟩ :=
    cross_l trans c8 (k) (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))))) (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))
  have h9 : steps 17 ⟨cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank)))))))), cons true (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))), .E⟩ = some ⟨rep (a) [true] (blank), cons true (cons true (cons false (cons false (cons true (cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))))))))))), .C⟩ := rfl
  have c10 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true, true] R, .C⟩ = some ⟨L, app [true, true] (app [false] R), .C⟩ := fun _ _ => rfl
  have h10 : steps ((a) * 3) ⟨rep (a) [true] (blank), cons true (cons true (cons false (cons false (cons true (cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))))))))))), .C⟩ = some ⟨blank, cons true (cons true (rep (a) [false] (cons false (cons false (cons true (cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))))))))))), .C⟩ :=
    cross_l trans c10 (a) (blank) (cons false (cons false (cons true (cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))))))))))
  have h11 : steps 7 ⟨blank, cons true (cons true (rep (a) [false] (cons false (cons false (cons true (cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))))))))))), .C⟩ = some ⟨cons false (cons true (blank)), cons false (rep (a) [false] (cons false (cons false (cons true (cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (h11))))))))))))

/-- The same with an even number of pairs: D(A+3,2k) -> D(A+2,0) with blocks `0 0 (10)^(2k+1) 1` and `(10)^c 1` in front of the rest. -/
theorem f_oe0z_even (a c k : Nat) (R : Tape) :
    steps (26 * k + 37) ⟨cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank)))))), cons false (cons false (cons true (rep (c + 1) [true, false] (cons true (R))))), .C⟩ = some ⟨cons false (cons true (cons true (rep (a) [true] (blank)))), cons false (cons false (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))))), .C⟩ := by
  have hn : 1 + (0 + ((k) * 4 + (8 + (0 + ((k) * 8 + (18 + (0 + ((k) * 14 + (10))))))))) = 26 * k + 37 := by omega
  have h0 : steps 1 ⟨cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank)))))), cons false (cons false (cons true (rep (c + 1) [true, false] (cons true (R))))), .C⟩ = some ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank))))))), cons false (cons true (rep (c + 1) [true, false] (cons true (R)))), .D⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank))))))), cons false (cons true (rep (c + 1) [true, false] (cons true (R)))), .D⟩ = some ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank))))))), cons false (cons true (rep (c + 1) [true, false] (cons true (R)))), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (k) [true, false, true, false] (cons true (cons true (cons true (rep (a) [true] (blank))))))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank))))))) from
      rep_rotate (k) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons true (cons true (cons true (rep (a) [true] (blank)))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 4) ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank))))))), cons false (cons true (rep (c + 1) [true, false] (cons true (R)))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank)))))), cons false (rep (k) [false, true, false, true] (cons true (rep (c + 1) [true, false] (cons true (R))))), .D⟩ :=
    cross_l trans c2 (k) (cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank))))))) (cons true (rep (c + 1) [true, false] (cons true (R))))
  have h3 : steps 8 ⟨cons true (cons false (cons true (cons true (cons true (rep (a) [true] (blank)))))), cons false (rep (k) [false, true, false, true] (cons true (rep (c + 1) [true, false] (cons true (R))))), .D⟩ = some ⟨cons true (cons false (cons true (rep (a) [true] (blank)))), cons true (cons false (cons true (rep (k) [false, true, false, true] (cons true (rep (c + 1) [true, false] (cons true (R))))))), .D⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (rep (a) [true] (blank)))), cons true (cons false (cons true (rep (k) [false, true, false, true] (cons true (rep (c + 1) [true, false] (cons true (R))))))), .D⟩ = some ⟨cons true (cons false (cons true (rep (a) [true] (blank)))), rep (k) [true, false, true, false] (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))))), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (k) [false, true, false, true] (cons true (rep (c + 1) [true, false] (cons true (R))))))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))))) from
      rep_rotate (k) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (rep (c + 1) [true, false] (cons true (R))))]
  have c5 : ∀ L R : Tape, steps 8 ⟨app [true] L, app [true, false, true, false] R, .D⟩ = some ⟨app [true] (app [false, true, false, true] L), R, .D⟩ := fun _ _ => rfl
  have h5 : steps ((k) * 8) ⟨cons true (cons false (cons true (rep (a) [true] (blank)))), rep (k) [true, false, true, false] (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R))))))), .D⟩ = some ⟨cons true (rep (k) [false, true, false, true] (cons false (cons true (rep (a) [true] (blank))))), cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))), .D⟩ :=
    cross_r trans c5 (k) (cons false (cons true (rep (a) [true] (blank)))) (cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))))
  have h6 : steps 18 ⟨cons true (rep (k) [false, true, false, true] (cons false (cons true (rep (a) [true] (blank))))), cons true (cons false (cons true (cons true (rep (c + 1) [true, false] (cons true (R)))))), .D⟩ = some ⟨cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (rep (a) [true] (blank))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ := rfl
  have h7 : steps 0 ⟨cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (rep (a) [true] (blank))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ = some ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (rep (a) [true] (blank))))))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))) from
      rep_rotate (k) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (rep (a) [true] (blank))))]
  have c8 : ∀ L R : Tape, steps 14 ⟨app [true, false, true, false] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .E⟩ := fun _ _ => rfl
  have h8 : steps ((k) * 14) ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))), cons true (cons true (cons false (cons true (rep (c) [true, false] (cons true (R)))))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank)))))), cons true (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))), .E⟩ :=
    cross_l trans c8 (k) (cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank))))))) (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))
  have h9 : steps 10 ⟨cons true (cons false (cons true (cons false (cons true (rep (a) [true] (blank)))))), cons true (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))), .E⟩ = some ⟨cons false (cons true (cons true (rep (a) [true] (blank)))), cons false (cons false (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons true (rep (c) [true, false] (cons true (R))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

