theorem cs (d : Nat) (L R : Tape) :
    steps (d + 3) ⟨L, cons false (rep (d + 2) [true] (cons false (R))), .C⟩ = some ⟨rep (d) [true] (cons true (cons false (cons true (L)))), cons false (R), .C⟩ := by
  have hn : 3 + ((d) * 1) = d + 3 := by omega
  have h0 : steps 3 ⟨L, cons false (rep (d + 2) [true] (cons false (R))), .C⟩ = some ⟨cons true (cons false (cons true (L))), rep (d) [true] (cons false (R)), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .C⟩ = some ⟨app [] (app [true] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((d) * 1) ⟨cons true (cons false (cons true (L))), rep (d) [true] (cons false (R)), .C⟩ = some ⟨rep (d) [true] (cons true (cons false (cons true (L)))), cons false (R), .C⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 1) ⟨L, rep k [true] (R), .C⟩ = some ⟨rep k [true] (L), R, .C⟩ from cross_r trans c1) (d) (cons true (cons false (cons true (L)))) (cons false (R))
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- The run reaches the fixed tail: back to S0. -/
theorem cfin (L : Tape) :
    steps (37) ⟨L, cons false (rep (14) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))))), .C⟩ = some ⟨cons false (cons true (rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))))))))), rep (1) [true] (blank), .A⟩ := by
  have hn : 3 + ((12) * 1 + (3 + ((5) * 1 + (3 + ((4) * 1 + (3 + ((2) * 1 + (2)))))))) = 37 := by omega
  have h0 : steps 3 ⟨L, cons false (rep (14) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))))), .C⟩ = some ⟨cons true (cons false (cons true (L))), rep (12) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .C⟩ = some ⟨app [] (app [true] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((12) * 1) ⟨cons true (cons false (cons true (L))), rep (12) [true] (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))))), .C⟩ = some ⟨rep (12) [true] (cons true (cons false (cons true (L)))), cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))), .C⟩ :=
    cross_r trans c1 (12) (cons true (cons false (cons true (L)))) (cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))))
  have h2 : steps 3 ⟨rep (12) [true] (cons true (cons false (cons true (L)))), cons false (rep (7) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L))))))), rep (5) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))), .C⟩ := rfl
  have c3 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .C⟩ = some ⟨app [] (app [true] L), R, .C⟩ := fun _ _ => rfl
  have h3 : steps ((5) * 1) ⟨cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L))))))), rep (5) [true] (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))))), .C⟩ = some ⟨rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))), cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))), .C⟩ :=
    cross_r trans c3 (5) (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))) (cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))))
  have h4 : steps 3 ⟨rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))), cons false (rep (6) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L))))))))))), rep (4) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))), .C⟩ := rfl
  have c5 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .C⟩ = some ⟨app [] (app [true] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((4) * 1) ⟨cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L))))))))))), rep (4) [true] (cons false (rep (4) [true] (cons false (rep (2) [true] (blank))))), .C⟩ = some ⟨rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))), cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))), .C⟩ :=
    cross_r trans c5 (4) (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))) (cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))))
  have h6 : steps 3 ⟨rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))), cons false (rep (4) [true] (cons false (rep (2) [true] (blank)))), .C⟩ = some ⟨cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L))))))))))))))), rep (2) [true] (cons false (rep (2) [true] (blank))), .C⟩ := rfl
  have c7 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .C⟩ = some ⟨app [] (app [true] L), R, .C⟩ := fun _ _ => rfl
  have h7 : steps ((2) * 1) ⟨cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L))))))))))))))), rep (2) [true] (cons false (rep (2) [true] (blank))), .C⟩ = some ⟨rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))))))), cons false (rep (2) [true] (blank)), .C⟩ :=
    cross_r trans c7 (2) (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))))))) (cons false (rep (2) [true] (blank)))
  have h8 : steps 2 ⟨rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))))))), cons false (rep (2) [true] (blank)), .C⟩ = some ⟨cons false (cons true (rep (2) [true] (cons true (cons false (cons true (rep (4) [true] (cons true (cons false (cons true (rep (5) [true] (cons true (cons false (cons true (rep (12) [true] (cons true (cons false (cons true (L)))))))))))))))))), rep (1) [true] (blank), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))


/-- W 1 at the left end of the tape: E reads a 0 next (a halt). -/
theorem halt1 (g : Nat) (R : Tape) :
    steps (5) ⟨cons true (blank), cons true (cons true (cons false (rep (g + 2) [true] (cons false (R))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (cons false (rep (g + 2) [true] (cons false (R)))))))), .E⟩ := by
  have hn : 5 = 5 := by omega
  have h0 : steps 5 ⟨cons true (blank), cons true (cons true (cons false (rep (g + 2) [true] (cons false (R))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons false (cons true (cons false (rep (g + 2) [true] (cons false (R)))))))), .E⟩ := rfl
  exact steps_congr trans hn (h0)


