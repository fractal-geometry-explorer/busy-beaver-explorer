/-- **The clock carries the real run**: from step 9321 the run of the mirror image from blank tape goes
through 4 ticks of `tick_left_end` (levels 0 to 3) and is at `blank, J 4 W, D` at step 10317;
mirrored (`MirrorBridge.of_mirror`), the same holds for the run of the machine. -/
theorem run_ticks : steps 10317 init = some ⟨blank, J 4 (app w15 blank), .D⟩ := by
  have h0 := at_start
  have h1 := steps_congr trans (show 9321 + 56 = 9377 by decide) (steps_seq trans h0 tick0)
  have h2 := steps_congr trans (show 9377 + 132 = 9509 by decide) (steps_seq trans h1 tick1)
  have h3 := steps_congr trans (show 9509 + 276 = 9785 by decide) (steps_seq trans h2 tick2)
  have h4 := steps_congr trans (show 9785 + 532 = 10317 by decide) (steps_seq trans h3 tick3)
  exact h4

