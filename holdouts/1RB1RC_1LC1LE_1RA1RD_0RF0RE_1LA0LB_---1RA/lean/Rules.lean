      rep_rotate (k) [true] [false, true] [true, false] rfl (cons false (cons true (cons false (cons true (cons true (cons true (blank)))))))]
  have c6 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h6 : steps ((k) * 2) ⟨cons true (cons true (cons true (blank))), rep (k) [true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons true (blank)))))))), .A⟩ = some ⟨rep (k) [true, true] (cons true (cons true (cons true (blank)))), cons true (cons false (cons true (cons false (cons true (cons true (cons true (blank))))))), .A⟩ :=
    cross_r trans c6 (k) (cons true (cons true (cons true (blank)))) (cons true (cons false (cons true (cons false (cons true (cons true (cons true (blank))))))))
  have h7 : steps 15 ⟨rep (k) [true, true] (cons true (cons true (cons true (blank)))), cons true (cons false (cons true (cons false (cons true (cons true (cons true (blank))))))), .A⟩ = some ⟨cons true (rep (k) [true, true] (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), .B⟩ := rfl
  have h8 : steps 0 ⟨cons true (rep (k) [true, true] (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), .B⟩ = some ⟨rep (k) [true, true] (cons true (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (k) [true, true] (cons true (cons true (cons true (blank))))) = rep (k) [true, true] (cons true (cons true (cons true (cons true (blank))))) from
      rep_rotate (k) [true] [true, true] [true, true] rfl (cons true (cons true (cons true (blank))))]
  have c9 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, true] R), .B⟩ := fun _ _ => rfl
  have h9 : steps ((k) * 2) ⟨rep (k) [true, true] (cons true (cons true (cons true (cons true (blank))))), cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), .B⟩ = some ⟨cons true (cons true (cons true (cons true (blank)))), cons true (rep (k) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .B⟩ :=
    cross_l trans c9 (k) (cons true (cons true (cons true (cons true (blank))))) (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))
  have h10 : steps 6 ⟨cons true (cons true (cons true (cons true (blank)))), cons true (rep (k) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .B⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (k) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))), .A⟩ := rfl
  exact steps_congr trans (a := (k) * 2 + (19 + (0 + ((k) * 2 + (6 + (0 + ((k) * 2 + (15 + (0 + ((k) * 2 + (6))))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (h10)))))))))))

/-- Z, one copy left: a new counter of one copy. -/
theorem zOdd (k : Nat) :
    steps (4 * k + 26) ⟨blank, rep (k) [false, true] (cons false (cons true (cons true (cons false (cons true (blank)))))), .C⟩ = some ⟨blank, cons false (cons true (cons true (cons false (rep (k) [true, false] (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))))), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((k) * 2) ⟨blank, rep (k) [false, true] (cons false (cons true (cons true (cons false (cons true (blank)))))), .C⟩ = some ⟨rep (k) [true, true] (blank), cons false (cons true (cons true (cons false (cons true (blank))))), .C⟩ :=
    cross_r trans c0 (k) (blank) (cons false (cons true (cons true (cons false (cons true (blank))))))
  have h1 : steps 23 ⟨rep (k) [true, true] (blank), cons false (cons true (cons true (cons false (cons true (blank))))), .C⟩ = some ⟨cons true (rep (k) [true, true] (blank)), cons true (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))), .E⟩ := rfl
  have h2 : steps 0 ⟨cons true (rep (k) [true, true] (blank)), cons true (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))), .E⟩ = some ⟨rep (k) [true, true] (cons true (blank)), cons true (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (k) [true, true] (blank)) = rep (k) [true, true] (cons true (blank)) from
      rep_rotate (k) [true] [true, true] [true, true] rfl (blank)]
  have c3 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((k) * 2) ⟨rep (k) [true, true] (cons true (blank)), cons true (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))), .E⟩ = some ⟨cons true (blank), cons true (rep (k) [true, false] (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), .E⟩ :=
    cross_l trans c3 (k) (cons true (blank)) (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))
  have h4 : steps 3 ⟨cons true (blank), cons true (rep (k) [true, false] (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))), .E⟩ = some ⟨blank, cons false (cons true (cons true (cons false (rep (k) [true, false] (cons true (cons false (cons true (cons true (cons false (cons true (blank))))))))))), .A⟩ := rfl
  exact steps_congr trans (a := (k) * 2 + (23 + (0 + ((k) * 2 + (3))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- Z, no copy left: the head runs off the right end in state F, which halts on a 0. -/
theorem zEven (k : Nat) :
    steps (2 * k + 4) ⟨blank, rep (k) [false, true] (cons false (cons true (cons true (blank)))), .C⟩ = some ⟨cons false (cons true (cons true (cons true (rep (k) [true, true] (blank))))), blank, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((k) * 2) ⟨blank, rep (k) [false, true] (cons false (cons true (cons true (blank)))), .C⟩ = some ⟨rep (k) [true, true] (blank), cons false (cons true (cons true (blank))), .C⟩ :=
    cross_r trans c0 (k) (blank) (cons false (cons true (cons true (blank))))
  have h1 : steps 4 ⟨rep (k) [true, true] (blank), cons false (cons true (cons true (blank))), .C⟩ = some ⟨cons false (cons true (cons true (cons true (rep (k) [true, true] (blank))))), blank, .F⟩ := rfl
  exact steps_congr trans (a := (k) * 2 + (4)) (by omega) (steps_seq trans h0 (h1))

