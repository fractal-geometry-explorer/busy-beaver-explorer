/-! ## Tape identities -/

theorem rep_double (n : Nat) (w : List Bool) (s : Tape) : rep (2 * n) w s = rep n (w ++ w) s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, rep_succ, ih, app_app, rep_succ]

/-- `(10)^(2k+1) 1 s = 1 (0101)^k 0 1 s`. -/
theorem alt_odd (k : Nat) (s : Tape) :
    rep (2 * k + 1) [true, false] (cons true s) =
      cons true (rep k [false, true, false, true] (cons false (cons true s))) := by
  rw [rep_add, rep_double]
  show rep k [true, false, true, false] (app [true] (app [false, true] s)) = _
  rw [← rep_rotate k [true] [false, true, false, true] [true, false, true, false] rfl]
  rfl

/-- `(0101)^k 0 1 s = 0 1 (0101)^k s`. -/
theorem rot01 (k : Nat) (s : Tape) :
    rep k [false, true, false, true] (cons false (cons true s)) =
      cons false (cons true (rep k [false, true, false, true] s)) :=
  (rep_rotate k [false, true] [false, true, false, true] [false, true, false, true] rfl s).symm

/-! ## Block lists

The right part of the tape holds plain blocks `(10)^b`, each followed by a single 1, then blank tape. The left part
holds *spread* blocks `1 0 0 (1000)^q T_p`, where the tail `T_p` is the phase: T_1 = 10, T_2 = 1, T_3 = 1001,
T_4 = 101, T_5 = 11 (written here nearest cell first). -/

/-- Plain blocks `(10)^b0 1 (10)^b1 1 ... 0^inf`. -/
def enc : List Nat → Tape
  | [] => blank
  | b :: P => rep b [true, false] (cons true (enc P))

/-- The tail of phase p, nearest cell first. -/
def trev : Nat → List Bool
  | 1 => [false, true]
  | 2 => [true]
  | 3 => [true, false, false, true]
  | 4 => [true, false, true]
  | _ => [true, true]

/-- A spread block `1 0 0 (1000)^q T_p` in front of the left context `L`. -/
def ctxL (q p : Nat) (L : Tape) : Tape :=
  app (trev p) (rep q [false, false, false, true] (app [false, false, true] L))

/-! ## The seven rules, in block-list form -/

/-- PUSH: the head crosses the first plain block `(10)^(2k+3)` and leaves it spread, `(1000)^k`, phase 1; the next
block gains one. -/
theorem push (k c : Nat) (L R : Tape) :
    steps (6 * k + 15) ⟨L, cons false (rep (2 * k + 3) [true, false] (cons true (rep (c + 1) [true, false] R))), .A⟩ =
      some ⟨ctxL k 1 L, cons false (rep (c + 2) [true, false] R), .A⟩ := by
  have e1 : rep (2 * k + 3) [true, false] (cons true (rep (c + 1) [true, false] R)) =
      cons true (cons false (rep (k + 1) [true, false, true, false] (cons true (cons true (cons false (rep c [true, false] R)))))) := by
    rw [show 2 * k + 3 = 2 * (k + 1) + 1 by omega, rep_succ, rep_double]; rfl
  have e2 : ctxL k 1 L = rep (k + 1) [false, true, false, false] (cons true L) := by
    show app [false, true] (rep k [false, false, false, true] (app [false, false, true] L)) = _
    rw [rep_rotate k [false, true] [false, false, false, true] [false, true, false, false] rfl]
    exact rep_app_comm k [false, true, false, false] (cons true L)
  rw [e1, e2]
  exact push_raw k L (rep c [true, false] R)

/-- TURN: the last block `(10)^(2k+1)` is crossed, the head turns on blank tape and comes back; it is one longer. -/
theorem turn (k : Nat) (L : Tape) :
    steps (10 * k + 14) ⟨L, cons false (enc [2 * k + 1]), .A⟩ =
      some ⟨L, cons true (cons false (enc [2 * k + 2])), .E⟩ := by
  have e1 : enc [2 * k + 1] = cons true (cons false (rep k [true, false, true, false] (cons true blank))) := by
    show rep (2 * k + 1) [true, false] (cons true blank) = _
    rw [rep_succ, rep_double]; rfl
  have e2 : enc [2 * k + 2] =
      cons true (cons false (cons true (rep k [false, true, false, true] (cons false (cons true blank))))) := by
    show rep (2 * k + 1 + 1) [true, false] (cons true blank) = _
    rw [rep_succ, alt_odd]; rfl
  rw [e1, e2]
  exact turn_raw k L

/-- TAIL 1: back at a spread block of phase 1, one more `1000` is used, the phase becomes 2, the first block gains 3. -/
theorem tail1 (q x : Nat) (L R : Tape) :
    steps 9 ⟨ctxL (q + 1) 1 L, cons true (cons false (rep (x + 1) [true, false] (cons true R))), .E⟩ =
      some ⟨ctxL q 2 L, cons false (rep (x + 4) [true, false] (cons true R)), .A⟩ :=
  tail1_raw q x L R

/-- TAIL 2: phase 2 to 3, one `1000` used, the first block gains 1. -/
theorem tail2 (q x : Nat) (L R : Tape) :
    steps 15 ⟨ctxL (q + 1) 2 L, cons true (cons false (rep (x + 1) [true, false] (cons true R))), .E⟩ =
      some ⟨ctxL q 3 L, cons false (rep (x + 2) [true, false] (cons true R)), .A⟩ :=
  tail2_raw q x L R

/-- TAIL 3: phase 3 to 4, the first block gains 1. -/
theorem tail3 (q x : Nat) (L R : Tape) :
    steps 15 ⟨ctxL q 3 L, cons true (cons false (rep (x + 1) [true, false] (cons true R))), .E⟩ =
      some ⟨ctxL q 4 L, cons false (rep (x + 2) [true, false] (cons true R)), .A⟩ :=
  tail3_raw q x L R

/-- TAIL 4: phase 4 to 5, the first block gains 1. -/
theorem tail4 (q x : Nat) (L R : Tape) :
    steps 15 ⟨ctxL q 4 L, cons true (cons false (rep (x + 1) [true, false] (cons true R))), .E⟩ =
      some ⟨ctxL q 5 L, cons false (rep (x + 2) [true, false] (cons true R)), .A⟩ :=
  tail4_raw q x L R

/-- POP: at a spread block of phase 5 the head keeps going left; the block becomes plain again, `(10)^(2q+2)`. -/
theorem pop (q : Nat) (L X : Tape) :
    steps (4 * q + 9) ⟨ctxL q 5 L, cons true (cons false X), .E⟩ =
      some ⟨L, cons true (cons false (rep (2 * q + 2) [true, false] (cons true X))), .E⟩ := by
  rw [rep_succ, alt_odd, rot01]
  exact pop_raw q L X

/-! ## The round on a list of blocks, for every depth

`go n l` is what one visit of the head to the plain blocks `l` (the head arriving in A on the 0 left of them, and
leaving in E on the same cell) does to them: the first block is spread (PUSH), the rest of the list gets five rounds
with the spread block as its left context in phases 1..5 (the four TAILs in between), and the spread block becomes
plain again (POP).  For a single block it is TURN.  `n` is fuel (the depth). -/

/-- Add `d` to the first block. -/
def bump (d : Nat) : List Nat → List Nat
  | [] => []
  | x :: X => (x + d) :: X

/-- The blocks after one visit. -/
def go : Nat → List Nat → List Nat
  | _, [] => []
  | _, [b] => [b + 1]
  | 0, b :: c :: bs => b :: c :: bs
  | n + 1, b :: c :: bs =>
    (b - 5) :: go n (bump 1 (go n (bump 1 (go n (bump 1 (go n (bump 3 (go n ((c + 1) :: bs)))))))))

/-- Its exact step count. -/
def goT : Nat → List Nat → Nat
  | _, [] => 0
  | _, [b] => 5 * b + 9
  | 0, _ :: _ :: _ => 0
  | n + 1, b :: c :: bs =>
    let l0 := (c + 1) :: bs
    let l1 := bump 3 (go n l0)
    let l2 := bump 1 (go n l1)
    let l3 := bump 1 (go n l2)
    let l4 := bump 1 (go n l3)
    (3 * b + 6) + goT n l0 + 9 + goT n l1 + 15 + goT n l2 + 15 + goT n l3 + 15 + goT n l4 + (2 * b - 5)

/-- The visit is clean: every block the head spreads is odd and at least 7 (so that its five rounds fit), every
block it turns on is odd, and every second block is nonempty. -/
def clean : Nat → List Nat → Prop
  | _, [] => False
  | _, [b] => b % 2 = 1
  | 0, _ :: _ :: _ => False
  | n + 1, b :: c :: bs =>
    let l0 := (c + 1) :: bs
    let l1 := bump 3 (go n l0)
    let l2 := bump 1 (go n l1)
    let l3 := bump 1 (go n l2)
    let l4 := bump 1 (go n l3)
    b % 2 = 1 ∧ 7 ≤ b ∧ 1 ≤ c ∧ clean n l0 ∧ clean n l1 ∧ clean n l2 ∧ clean n l3 ∧ clean n l4

instance : ∀ n l, Decidable (clean n l) := by
  intro n
  induction n with
  | zero => intro l; match l with
    | [] => exact isFalse id
    | [b] => exact inferInstanceAs (Decidable (b % 2 = 1))
    | _ :: _ :: _ => exact isFalse id
  | succ n ih => intro l; match l with
    | [] => exact isFalse id
    | [b] => exact inferInstanceAs (Decidable (b % 2 = 1))
    | b :: c :: bs => unfold clean; exact inferInstance

theorem go_pos : ∀ n l, clean n l → ∃ x X, go n l = (x + 1) :: X := by
  intro n l h
  match n, l, h with
  | 0, [b], _ => exact ⟨b, [], rfl⟩
  | n + 1, [b], _ => exact ⟨b, [], rfl⟩
  | n + 1, b :: c :: bs, h =>
    obtain ⟨_, h7, _⟩ := h
    exact ⟨b - 6, _, by simp only [go]; congr 1; omega⟩

/-- **The round rule for every depth.**  A clean visit to the plain blocks `l` turns them into `go n l` in
`goT n l` steps, whatever the tape on the left. -/
theorem go_spec : ∀ n l, clean n l → ∀ L : Tape,
    steps (goT n l) ⟨L, cons false (enc l), .A⟩ = some ⟨L, cons true (cons false (enc (go n l))), .E⟩ := by
  intro n
  induction n with
  | zero =>
    intro l h L
    match l, h with
    | [b], h =>
      have hb : b % 2 = 1 := h
      obtain ⟨k, rfl⟩ : ∃ k, b = 2 * k + 1 := ⟨b / 2, by omega⟩
      have := turn k L
      simp only [goT, go]
      rw [show 5 * (2 * k + 1) + 9 = 10 * k + 14 by omega]
      exact this
  | succ n ih =>
    intro l h L
    match l, h with
    | [b], h =>
      have hb : b % 2 = 1 := h
      obtain ⟨k, rfl⟩ : ∃ k, b = 2 * k + 1 := ⟨b / 2, by omega⟩
      have := turn k L
      simp only [goT, go]
      rw [show 5 * (2 * k + 1) + 9 = 10 * k + 14 by omega]
      exact this
    | b :: c :: bs, h =>
      have h' := h
      obtain ⟨hb, h7, hc, c0, c1, c2, c3, c4⟩ := h'
      obtain ⟨j, rfl⟩ : ∃ j, b = 2 * j + 7 := ⟨(b - 7) / 2, by omega⟩
      obtain ⟨c', rfl⟩ : ∃ c', c = c' + 1 := ⟨c - 1, by omega⟩
      -- the five inner lists
      generalize hl0 : (c' + 1 + 1) :: bs = l0 at c0 c1 c2 c3 c4
      obtain ⟨x0, X0, e0⟩ := go_pos n l0 c0
      generalize hl1 : bump 3 (go n l0) = l1 at c1 c2 c3 c4
      obtain ⟨x1, X1, e1⟩ := go_pos n l1 c1
      generalize hl2 : bump 1 (go n l1) = l2 at c2 c3 c4
      obtain ⟨x2, X2, e2⟩ := go_pos n l2 c2
      generalize hl3 : bump 1 (go n l2) = l3 at c3 c4
      obtain ⟨x3, X3, e3⟩ := go_pos n l3 c3
      generalize hl4 : bump 1 (go n l3) = l4 at c4
      -- the pieces
      have s0 := push (j + 2) c' L (cons true (enc bs))
      have r0 := ih l0 c0 (ctxL (j + 2) 1 L)
      rw [e0] at r0
      have t1 := tail1 (j + 1) x0 L (enc X0)
      have r1 := ih l1 c1 (ctxL (j + 1) 2 L)
      rw [e1] at r1
      have t2 := tail2 j x1 L (enc X1)
      have r2 := ih l2 c2 (ctxL j 3 L)
      rw [e2] at r2
      have t3 := tail3 j x2 L (enc X2)
      have r3 := ih l3 c3 (ctxL j 4 L)
      rw [e3] at r3
      have t4 := tail4 j x3 L (enc X3)
      have r4 := ih l4 c4 (ctxL j 5 L)
      have p5 := pop j L (enc (go n l4))
      -- the lists the tails produce
      have f1 : cons false (rep (x0 + 4) [true, false] (cons true (enc X0))) = cons false (enc l1) := by
        rw [← hl1, e0]; rfl
      have f2 : cons false (rep (x1 + 2) [true, false] (cons true (enc X1))) = cons false (enc l2) := by
        rw [← hl2, e1]; rfl
      have f3 : cons false (rep (x2 + 2) [true, false] (cons true (enc X2))) = cons false (enc l3) := by
        rw [← hl3, e2]; rfl
      have f4 : cons false (rep (x3 + 2) [true, false] (cons true (enc X3))) = cons false (enc l4) := by
        rw [← hl4, e3]; rfl
      rw [f1] at t1
      rw [f2] at t2
      rw [f3] at t3
      rw [f4] at t4
      have g0 : cons false (rep (c' + 2) [true, false] (cons true (enc bs))) = cons false (enc l0) := by
        rw [← hl0]; rfl
      rw [g0] at s0
      have hs : rep (2 * (j + 2) + 3) [true, false] (cons true (rep (c' + 1) [true, false] (cons true (enc bs)))) =
          enc ((2 * j + 7) :: (c' + 1) :: bs) := by
        show _ = rep (2 * j + 7) [true, false] (cons true (rep (c' + 1) [true, false] (cons true (enc bs))))
        rw [show 2 * (j + 2) + 3 = 2 * j + 7 by omega]
      rw [hs] at s0
      have hgo : go (n + 1) ((2 * j + 7) :: (c' + 1) :: bs) = (2 * j + 2) :: go n l4 := by
        simp only [go]
        rw [hl0, hl1, hl2, hl3, hl4]
        congr 1
      have hT : goT (n + 1) ((2 * j + 7) :: (c' + 1) :: bs) =
          (6 * (j + 2) + 15) + (goT n l0 + (9 + (goT n l1 + (15 + (goT n l2 + (15 + (goT n l3 + (15 + (goT n l4 + (4 * j + 9)))))))))) := by
        simp only [goT]
        rw [hl0, hl1, hl2, hl3, hl4]
        omega
      rw [hgo, hT]
      have := steps_seq trans s0 (steps_seq trans r0 (steps_seq trans t1 (steps_seq trans r1 (steps_seq trans t2
        (steps_seq trans r2 (steps_seq trans t3 (steps_seq trans r3 (steps_seq trans t4 (steps_seq trans r4 p5)))))))))
      exact this


/-! ## The closed form -/

/-- The change of the blocks after the first, the i-th of them (from 0) scaled by 5^i: every block but the last
loses 18·5^i, the last gains 12·5^i. -/
def tailEff : Nat → List Nat → List Nat
  | _, [] => []
  | i, [x] => [x + 12 * 5 ^ i]
  | i, x :: y :: r => (x - 18 * 5 ^ i) :: tailEff (i + 1) (y :: r)

/-- The blocks after a clean visit: the first loses 5 (gains 1 if it is alone), the others as `tailEff 0`. -/
def cfl : List Nat → List Nat
  | [] => []
  | [b] => [b + 1]
  | b :: c :: r => (b - 5) :: tailEff 0 (c :: r)

/-- Blocks after the first: even, and every block but the last at least 2 + k·18·5^i (the last at least 2). -/
def bigT (k : Nat) : Nat → List Nat → Prop
  | _, [] => True
  | _, [x] => x % 2 = 0 ∧ 2 ≤ x
  | i, x :: y :: r => x % 2 = 0 ∧ 2 + k * (18 * 5 ^ i) ≤ x ∧ bigT k (i + 1) (y :: r)

/-- A list the closed form applies to. -/
def big : List Nat → Prop
  | [] => False
  | [b] => b % 2 = 1
  | b :: c :: r => b % 2 = 1 ∧ 7 ≤ b ∧ bigT 1 0 (c :: r)

theorem bigT_five (i : Nat) : ∀ r, bigT 5 i r ↔ bigT 1 (i + 1) r := by
  intro r
  induction r generalizing i with
  | nil => simp [bigT]
  | cons x r ih =>
    cases r with
    | nil => simp [bigT]
    | cons y r =>
      simp only [bigT]
      rw [ih (i + 1)]
      rw [Nat.pow_succ]
      generalize 5 ^ i = a
      constructor <;> intro h <;> refine ⟨h.1, ?_, h.2.2⟩ <;> omega

theorem bigT_mono (k i : Nat) : ∀ r, bigT (k + 1) i r → bigT k i r := by
  intro r
  induction r generalizing i with
  | nil => simp [bigT]
  | cons x r ih =>
    cases r with
    | nil => simp [bigT]
    | cons y r =>
      simp only [bigT]
      intro ⟨h1, h2, h3⟩
      refine ⟨h1, ?_, ih (i + 1) h3⟩
      generalize 18 * 5 ^ i = a at h2
      rw [Nat.succ_mul] at h2
      omega

theorem tailEff_big (k i : Nat) : ∀ r, bigT (k + 1) i r → bigT k i (tailEff i r) := by
  intro r
  induction r generalizing i with
  | nil => simp [bigT, tailEff]
  | cons x r ih =>
    cases r with
    | nil =>
      simp only [bigT, tailEff]
      intro ⟨h1, h2⟩
      have : (12 * 5 ^ i) % 2 = 0 := by rw [Nat.mul_mod]; simp
      omega
    | cons y r =>
      simp only [bigT, tailEff]
      intro ⟨h1, h2, h3⟩
      cases r with
      | nil =>
        refine ⟨?_, ?_, ih (i + 1) h3⟩
        · have : (18 * 5 ^ i) % 2 = 0 := by rw [Nat.mul_mod]; simp
          generalize 18 * 5 ^ i = a at *
          rw [Nat.succ_mul] at h2
          omega
        · generalize 18 * 5 ^ i = a at *
          rw [Nat.succ_mul] at h2
          omega
      | cons z r =>
        refine ⟨?_, ?_, ih (i + 1) h3⟩
        · have : (18 * 5 ^ i) % 2 = 0 := by rw [Nat.mul_mod]; simp
          generalize 18 * 5 ^ i = a at *
          rw [Nat.succ_mul] at h2
          omega
        · generalize 18 * 5 ^ i = a at *
          rw [Nat.succ_mul] at h2
          omega

theorem tailEff_length (i : Nat) : ∀ r, (tailEff i r).length = r.length := by
  intro r
  induction r generalizing i with
  | nil => rfl
  | cons x r ih =>
    cases r with
    | nil => rfl
    | cons y r => simp only [tailEff, List.length_cons, ih (i + 1)]

theorem tailEff_cc (i x : Nat) (s : List Nat) (h : s ≠ []) :
    tailEff i (x :: s) = (x - 18 * 5 ^ i) :: tailEff (i + 1) s := by
  cases s with
  | nil => exact absurd rfl h
  | cons y r => rfl

theorem tailEff_ne (i : Nat) (s : List Nat) (h : s ≠ []) : tailEff i s ≠ [] := by
  intro e
  have := tailEff_length i s
  rw [e] at this
  cases s with
  | nil => exact h rfl
  | cons _ _ => simp at this

theorem tailEff_five (i : Nat) : ∀ r, bigT 5 i r →
    tailEff i (tailEff i (tailEff i (tailEff i (tailEff i r)))) = tailEff (i + 1) r := by
  intro r
  induction r generalizing i with
  | nil => simp [tailEff]
  | cons x r ih =>
    cases r with
    | nil =>
      intro _
      simp only [tailEff, Nat.pow_succ]
      congr 1
      omega
    | cons y r =>
      simp only [bigT]
      intro ⟨_, h2, h3⟩
      have e := ih (i + 1) h3
      have ne : ∀ s : List Nat, s ≠ [] → tailEff (i + 1) s ≠ [] := fun s h => tailEff_ne (i + 1) s h
      have n0 : (y :: r) ≠ [] := by simp
      rw [tailEff_cc i x _ n0, tailEff_cc i _ _ (ne _ n0), tailEff_cc i _ _ (ne _ (ne _ n0)),
        tailEff_cc i _ _ (ne _ (ne _ (ne _ n0))), tailEff_cc i _ _ (ne _ (ne _ (ne _ (ne _ n0)))), e,
        tailEff_cc (i + 1) x _ n0]
      congr 1
      rw [Nat.pow_succ]
      generalize 5 ^ i = a at *
      omega

theorem bigT_tail (k i x : Nat) (t : List Nat) (h : t ≠ []) (hb : bigT k i (x :: t)) : bigT k (i + 1) t := by
  cases t with
  | nil => exact absurd rfl h
  | cons y r => exact hb.2.2

theorem bigT_head (k i x : Nat) (t : List Nat) (h : t ≠ []) (hb : bigT k i (x :: t)) :
    x % 2 = 0 ∧ 2 + k * (18 * 5 ^ i) ≤ x := by
  cases t with
  | nil => exact absurd rfl h
  | cons y r => exact ⟨hb.1, hb.2.1⟩

theorem cfl_cons (x : Nat) (t : List Nat) (h : t ≠ []) : cfl (x :: t) = (x - 5) :: tailEff 0 t := by
  cases t with
  | nil => exact absurd rfl h
  | cons y r => rfl

theorem big_cons (x : Nat) (t : List Nat) (h : t ≠ []) (h1 : x % 2 = 1) (h2 : 7 ≤ x) (h3 : bigT 1 0 t) :
    big (x :: t) := by
  cases t with
  | nil => exact absurd rfl h
  | cons y r => exact ⟨h1, h2, h3⟩

/-- **The closed form of a visit.**  A `big` list of length at most n+1 is clean at depth n, and its visit ends
with the blocks `cfl l`: the first loses 5 (or gains 1 if alone), block i ≥ 2 of k loses 18·5^(i-2), the last gains
12·5^(k-2). -/
theorem go_closed : ∀ n l, l.length ≤ n + 1 → big l → clean n l ∧ go n l = cfl l := by
  intro n
  induction n with
  | zero =>
    intro l hl hb
    match l, hl, hb with
    | [b], _, hb => exact ⟨hb, rfl⟩
    | _ :: _ :: _, hl, _ => simp at hl
  | succ n ih =>
    intro l hl hb
    match l, hl, hb with
    | [b], _, hb => exact ⟨hb, rfl⟩
    | b :: c :: r, hl, hb =>
      obtain ⟨hb1, hb2, hbt⟩ := hb
      have hlen : ((c + 1) :: r).length ≤ n + 1 := by simp at hl ⊢; omega
      cases r with
      | nil =>
        have hc : c % 2 = 0 := hbt.1
        refine ⟨⟨hb1, hb2, by have := hbt.2; omega, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩ <;>
          simp only [go, bump, clean, cfl, tailEff, Nat.pow_zero] <;> omega
      | cons y r =>
        have nr : (y :: r) ≠ [] := by simp
        have ⟨hc0, hc1⟩ := bigT_head 1 0 c (y :: r) nr hbt
        have t1 : bigT 1 1 (y :: r) := bigT_tail 1 0 c _ nr hbt
        have t5 : bigT 5 0 (y :: r) := (bigT_five 0 _).2 t1
        have t4 : bigT 4 0 (y :: r) := bigT_mono 4 0 _ t5
        have t3 : bigT 3 0 (y :: r) := bigT_mono 3 0 _ t4
        have t2 : bigT 2 0 (y :: r) := bigT_mono 2 0 _ t3
        have t1' : bigT 1 0 (y :: r) := bigT_mono 1 0 _ t2
        have u1 : bigT 1 0 (tailEff 0 (y :: r)) := tailEff_big 1 0 _ t2
        have u2 : bigT 1 0 (tailEff 0 (tailEff 0 (y :: r))) :=
          tailEff_big 1 0 _ (tailEff_big 2 0 _ t3)
        have u3 : bigT 1 0 (tailEff 0 (tailEff 0 (tailEff 0 (y :: r)))) :=
          tailEff_big 1 0 _ (tailEff_big 2 0 _ (tailEff_big 3 0 _ t4))
        have u4 : bigT 1 0 (tailEff 0 (tailEff 0 (tailEff 0 (tailEff 0 (y :: r))))) :=
          tailEff_big 1 0 _ (tailEff_big 2 0 _ (tailEff_big 3 0 _ (tailEff_big 4 0 _ t5)))
        have n1 := tailEff_ne 0 _ nr
        have n2 := tailEff_ne 0 _ n1
        have n3 := tailEff_ne 0 _ n2
        have n4 := tailEff_ne 0 _ n3
        have L : ∀ x (t : List Nat), t.length = r.length + 1 → ((x :: t).length ≤ n + 1) := by
          intro x t ht; simp at hl ⊢; omega
        have len1 := tailEff_length 0 (y :: r)
        have len2 := tailEff_length 0 (tailEff 0 (y :: r))
        have len3 := tailEff_length 0 (tailEff 0 (tailEff 0 (y :: r)))
        have len4 := tailEff_length 0 (tailEff 0 (tailEff 0 (tailEff 0 (y :: r))))
        simp only [List.length_cons] at len1 len2 len3 len4
        have p : 20 ≤ c := by simp at hc1; omega
        obtain ⟨c0, g0⟩ := ih _ hlen (big_cons _ _ nr (by omega) (by omega) t1')
        rw [cfl_cons _ _ nr] at g0
        have e1 : bump 3 (go n ((c + 1) :: y :: r)) = (c - 1) :: tailEff 0 (y :: r) := by
          rw [g0]; simp only [bump]; congr 1; omega
        obtain ⟨c1, g1⟩ := ih _ (L _ _ (by omega)) (big_cons (c - 1) _ n1 (by omega) (by omega) u1)
        rw [cfl_cons _ _ n1] at g1
        have e2 : bump 1 (go n ((c - 1) :: tailEff 0 (y :: r))) = (c - 5) :: tailEff 0 (tailEff 0 (y :: r)) := by
          rw [g1]; simp only [bump]; congr 1; omega
        obtain ⟨c2, g2⟩ := ih _ (L _ _ (by omega)) (big_cons (c - 5) _ n2 (by omega) (by omega) u2)
        rw [cfl_cons _ _ n2] at g2
        have e3 : bump 1 (go n ((c - 5) :: tailEff 0 (tailEff 0 (y :: r)))) =
            (c - 9) :: tailEff 0 (tailEff 0 (tailEff 0 (y :: r))) := by
          rw [g2]; simp only [bump]; congr 1; omega
        obtain ⟨c3, g3⟩ := ih _ (L _ _ (by omega)) (big_cons (c - 9) _ n3 (by omega) (by omega) u3)
        rw [cfl_cons _ _ n3] at g3
        have e4 : bump 1 (go n ((c - 9) :: tailEff 0 (tailEff 0 (tailEff 0 (y :: r))))) =
            (c - 13) :: tailEff 0 (tailEff 0 (tailEff 0 (tailEff 0 (y :: r)))) := by
          rw [g3]; simp only [bump]; congr 1; omega
        obtain ⟨c4, g4⟩ := ih _ (L _ _ (by omega)) (big_cons (c - 13) _ n4 (by omega) (by omega) u4)
        rw [cfl_cons _ _ n4, tailEff_five 0 _ t5] at g4
        refine ⟨⟨hb1, hb2, by omega, c0, ?_, ?_, ?_, ?_⟩, ?_⟩
        · show clean n (bump 3 (go n ((c + 1) :: y :: r))); rw [e1]; exact c1
        · show clean n (bump 1 (go n (bump 3 (go n ((c + 1) :: y :: r))))); rw [e1, e2]; exact c2
        · show clean n (bump 1 (go n (bump 1 (go n (bump 3 (go n ((c + 1) :: y :: r))))))); rw [e1, e2, e3]; exact c3
        · show clean n (bump 1 (go n (bump 1 (go n (bump 1 (go n (bump 3 (go n ((c + 1) :: y :: r)))))))))
          rw [e1, e2, e3, e4]; exact c4
        · show (b - 5) :: go n (bump 1 (go n (bump 1 (go n (bump 1 (go n (bump 3 (go n ((c + 1) :: y :: r))))))))) =
            cfl (b :: c :: y :: r)
          rw [e1, e2, e3, e4, g4, cfl_cons _ _ (by simp), tailEff_cc 0 c _ nr]
          congr 2

/-- The closed form on the tape: a `big` list of k blocks is visited in `goT k l` steps and leaves `cfl l`. -/
theorem visit_closed (l : List Nat) (h : big l) (L : Tape) :
    steps (goT l.length l) ⟨L, cons false (enc l), .A⟩ =
      some ⟨L, cons true (cons false (enc (cfl l))), .E⟩ := by
  obtain ⟨hc, hg⟩ := go_closed l.length l (Nat.le_succ _) h
  rw [← hg]
  exact go_spec _ l hc L

/-! ## What a clean visit conserves

Between exceptional events the blocks after the first only drain (`go_closed`): the i-th of them (from 0) loses
18·5^i a visit, and only the last one grows.  Two quantities are therefore conserved by every clean visit, for
every block that is neither the first nor the last: its residue modulo 18·5^i (`res`), and its difference to five
times the block before it (`drift`).  The residue decides at which phase and with which small value the block runs
out; the drift decides how long the next block still is at that moment.  Only the exceptional events (a block
running out, a birth, an F-event, the left end) change them. -/

/-- The residues of the blocks after the first, the i-th (from 0) modulo 18·5^i; the last block is left out. -/
def res : Nat → List Nat → List Nat
  | _, [] => []
  | _, [_] => []
  | i, x :: y :: r => x % (18 * 5 ^ i) :: res (i + 1) (y :: r)

/-- `y - 5x` for every two neighbours x, y among the blocks after the first, the last block left out. -/
def drift : List Nat → List Int
  | [] => []
  | [_] => []
  | [_, _] => []
  | x :: y :: z :: r => ((y : Int) - 5 * (x : Int)) :: drift (y :: z :: r)

theorem tailEff_res (i : Nat) : ∀ r, bigT 1 i r → res i (tailEff i r) = res i r := by
  intro r
  induction r generalizing i with
  | nil => intro _; rfl
  | cons x r ih =>
    cases r with
    | nil => intro _; rfl
    | cons y r =>
      intro h
      simp only [bigT] at h
      obtain ⟨_, h2, h3⟩ := h
      have e : tailEff i (x :: y :: r) = (x - 18 * 5 ^ i) :: tailEff (i + 1) (y :: r) := rfl
      rw [e]
      have hne : tailEff (i + 1) (y :: r) ≠ [] := tailEff_ne _ _ (by simp)
      obtain ⟨y', r', e'⟩ : ∃ y' r', tailEff (i + 1) (y :: r) = y' :: r' := by
        cases h' : tailEff (i + 1) (y :: r) with
        | nil => exact absurd h' hne
        | cons a b => exact ⟨a, b, rfl⟩
      have ih' := ih (i + 1) h3
      rw [e'] at ih' ⊢
      show (x - 18 * 5 ^ i) % (18 * 5 ^ i) :: res (i + 1) (y' :: r') = x % (18 * 5 ^ i) :: res (i + 1) (y :: r)
      rw [ih']
      congr 1
      generalize 18 * 5 ^ i = a at *
      have ha : a ≤ x := by omega
      have : x = (x - a) + a := by omega
      conv => rhs; rw [this, Nat.add_mod_right]

theorem tailEff_drift (i : Nat) : ∀ r, bigT 1 i r → drift (tailEff i r) = drift r := by
  intro r
  induction r generalizing i with
  | nil => intro _; rfl
  | cons x r ih =>
    cases r with
    | nil => intro _; rfl
    | cons y r =>
      cases r with
      | nil => intro _; rfl
      | cons z r =>
        intro h
        simp only [bigT] at h
        obtain ⟨_, h2, _, h4, h5⟩ := h
        have ih' := ih (i + 1) ⟨by assumption, h4, h5⟩
        have e : tailEff i (x :: y :: z :: r) =
            (x - 18 * 5 ^ i) :: (y - 18 * 5 ^ (i + 1)) :: tailEff (i + 2) (z :: r) := rfl
        have e1 : tailEff (i + 1) (y :: z :: r) = (y - 18 * 5 ^ (i + 1)) :: tailEff (i + 2) (z :: r) := rfl
        rw [e]
        rw [e1] at ih'
        have hne : tailEff (i + 2) (z :: r) ≠ [] := tailEff_ne _ _ (by simp)
        obtain ⟨z', r', e'⟩ : ∃ z' r', tailEff (i + 2) (z :: r) = z' :: r' := by
          cases h' : tailEff (i + 2) (z :: r) with
          | nil => exact absurd h' hne
          | cons a b => exact ⟨a, b, rfl⟩
        rw [e'] at ih' ⊢
        show (((y - 18 * 5 ^ (i + 1) : Nat) : Int) - 5 * ((x - 18 * 5 ^ i : Nat) : Int)) ::
            drift ((y - 18 * 5 ^ (i + 1)) :: z' :: r') = ((y : Int) - 5 * (x : Int)) :: drift (y :: z :: r)
        rw [ih']
        congr 1
        have p : 18 * 5 ^ (i + 1) = 5 * (18 * 5 ^ i) := by rw [Nat.pow_succ]; omega
        rw [p] at h4 ⊢
        generalize 18 * 5 ^ i = a at *
        omega

/-- **A clean visit conserves the residues and the drifts** of the blocks after the first: the visit of
`visit_closed` leaves `(b - 5) :: t` with the same `res` and the same `drift` as before. -/
theorem visit_conserves (b c : Nat) (r : List Nat) (h : big (b :: c :: r)) :
    ∃ t, cfl (b :: c :: r) = (b - 5) :: t ∧ res 0 t = res 0 (c :: r) ∧ drift t = drift (c :: r) := by
  obtain ⟨_, _, h3⟩ := h
  exact ⟨tailEff 0 (c :: r), rfl, tailEff_res 0 _ h3, tailEff_drift 0 _ h3⟩

/-! ## Rounds: a visit, then the TAIL of the spread block on its left (phase p to p + 1) -/

theorem round1 (n q : Nat) (l : List Nat) (h : clean n l) (L : Tape) :
    steps (goT n l + 9) ⟨ctxL (q + 1) 1 L, cons false (enc l), .A⟩ =
      some ⟨ctxL q 2 L, cons false (enc (bump 3 (go n l))), .A⟩ := by
  obtain ⟨x, X, e⟩ := go_pos n l h
  have r := go_spec n l h (ctxL (q + 1) 1 L)
  rw [e] at r ⊢
  exact steps_seq trans r (tail1 q x L (enc X))

theorem round2 (n q : Nat) (l : List Nat) (h : clean n l) (L : Tape) :
    steps (goT n l + 15) ⟨ctxL (q + 1) 2 L, cons false (enc l), .A⟩ =
      some ⟨ctxL q 3 L, cons false (enc (bump 1 (go n l))), .A⟩ := by
  obtain ⟨x, X, e⟩ := go_pos n l h
  have r := go_spec n l h (ctxL (q + 1) 2 L)
  rw [e] at r ⊢
  exact steps_seq trans r (tail2 q x L (enc X))

theorem round3 (n q : Nat) (l : List Nat) (h : clean n l) (L : Tape) :
    steps (goT n l + 15) ⟨ctxL q 3 L, cons false (enc l), .A⟩ =
      some ⟨ctxL q 4 L, cons false (enc (bump 1 (go n l))), .A⟩ := by
  obtain ⟨x, X, e⟩ := go_pos n l h
  have r := go_spec n l h (ctxL q 3 L)
  rw [e] at r ⊢
  exact steps_seq trans r (tail3 q x L (enc X))

theorem round4 (n q : Nat) (l : List Nat) (h : clean n l) (L : Tape) :
    steps (goT n l + 15) ⟨ctxL q 4 L, cons false (enc l), .A⟩ =
      some ⟨ctxL q 5 L, cons false (enc (bump 1 (go n l))), .A⟩ := by
  obtain ⟨x, X, e⟩ := go_pos n l h
  have r := go_spec n l h (ctxL q 4 L)
  rw [e] at r ⊢
  exact steps_seq trans r (tail4 q x L (enc X))

/-! ## The F-events

Every F-event of the runs (to 10^100 steps) is this one: a visit that ends in state C on the 0 of a phase-1 tail
(`... (1000)^q 1 0 C> 0 | 0 ...`, the C exit of an unclean visit).  C0 writes 1 and moves left onto the 1 of the
tail, D1 enters F, and F reads the cell left of the tail: the last cell of a `1000`, or of the `1 0 0` in front of
the spread block when q = 0.  Both are 0, so this entry into F never halts, for every q and every tape around. -/

theorem fevent (q : Nat) (L X : Tape) :
    steps 2 ⟨app [true] (rep q [false, false, false, true] (app [false, false, true] L)), cons false X, .C⟩ =
      some ⟨tail (rep q [false, false, false, true] (app [false, false, true] L)),
        cons false (cons false (cons true X)), .F⟩ := by
  cases q <;> rfl

/-- The cell F reads there is 0. -/
theorem fevent_reads_zero (q : Nat) (L : Tape) :
    rep q [false, false, false, true] (app [false, false, true] L) 0 = false := by
  cases q <;> rfl

/-! ## Birth of a block

The one exception at the right end: a visit to a single *even* block does not just turn.  The block loses 2 and a
new last block `(10)^8` is born behind it (10k + 188 steps).  Blocks born this way are where the deep blocks of
the run come from. -/

theorem birth (k : Nat) (L : Tape) :
    steps (10 * k + 188) ⟨L, cons false (enc [2 * k + 4]), .A⟩ =
      some ⟨L, cons true (cons false (enc [2 * k + 2, 8])), .E⟩ := by
  have h := birth_raw k L
  try rw [cons_false_blank] at h
  have e1 : enc [2 * k + 4] = rep (k + 2) [true, false, true, false] (cons true blank) := by
    show rep (2 * k + 4) [true, false] (cons true blank) = _
    rw [show 2 * k + 4 = 2 * (k + 2) by omega, rep_double]; rfl
  have e2 : enc [2 * k + 2, 8] = cons true (cons false (cons true (rep k [false, true, false, true]
      (cons false (cons true (rep 8 [true, false] (cons true blank))))))) := by
    show rep (2 * k + 1 + 1) [true, false] (cons true (rep 8 [true, false] (cons true blank))) = _
    rw [rep_succ, alt_odd]; rfl
  rw [e1, e2]
  exact h

end FA

open TM

/-! ## The machine is its frame-A conjugate seen through `img` (frame G: the mirror image of frame A, states renamed) -/

/-- Frame-A state to this machine's state. -/
def sigma : St → St
  | .A => .B
  | .B => .C
  | .C => .D
  | .D => .E
  | .E => .A
  | .F => .F

/-- A frame-A configuration as a configuration of this machine. -/
def img (c : Cfg St) : Cfg St := ⟨tail c.r, cons (c.r 0) c.l, sigma c.st⟩

theorem hsig (q : St) (b : Bool) :
    trans (sigma q) b = (FA.trans q b).map (fun x => (x.1, (fun d => match d with | .L => .R | .R => .L) x.2.1, sigma x.2.2)) := by
  cases q <;> cases b <;> rfl

theorem cons_head_tail (s : Tape) : cons (s 0) (tail s) = s := by
  funext n; cases n <;> rfl

/-- One step of the machine is one step of its frame-A conjugate. -/
theorem step_img (c : Cfg St) : TM.step trans (img c) = (TM.step FA.trans c).map img := by
  obtain ⟨l, r, q⟩ := c
  cases q <;> cases h : r 0 <;> simp [TM.step, img, trans, FA.trans, sigma, h, cons_head_tail]

/-- Every run of the machine is a run of its frame-A conjugate. -/
theorem steps_img (n : Nat) (c : Cfg St) : TM.steps trans n (img c) = (TM.steps FA.trans n c).map img := by
  induction n generalizing c with
  | zero => rfl
  | succ n ih =>
    unfold TM.steps
    rw [step_img]
    cases TM.step FA.trans c with
    | none => rfl
    | some c' => exact ih c'

/-- The run from blank tape is the image of the frame-A run from blank tape in state E. -/
theorem init_img : img ⟨blank, blank, .E⟩ = init := by
  show (⟨blank, cons false blank, .A⟩ : Cfg St) = ⟨blank, blank, .A⟩
  rw [cons_false_blank]

/-- The machine halts from blank tape if and only if its frame-A conjugate halts from blank tape in state E. -/
theorem halts_iff : HaltsFromBlank ↔ TM.Halts FA.trans ⟨blank, blank, .E⟩ := by
  unfold HaltsFromBlank
  rw [← init_img]
  constructor
  · rintro ⟨n, d, h1, h2⟩
    rw [steps_img] at h1
    cases e : TM.steps FA.trans n ⟨blank, blank, .E⟩ with
    | none => rw [e] at h1; cases h1
    | some c' =>
      rw [e] at h1
      cases h1
      refine ⟨n, c', e, ?_⟩
      have := step_img c'
      rw [h2] at this
      cases e2 : TM.step FA.trans c' with
      | none => rfl
      | some _ => rw [e2] at this; cases this
  · rintro ⟨n, c', h1, h2⟩
    refine ⟨n, img c', ?_, ?_⟩
    · rw [steps_img, h1]; rfl
    · rw [step_img, h2]; rfl

/-- **The visit rule on this machine**: a clean visit to the block list `l` (frame A) is a run of this machine. -/
theorem visit (n : Nat) (l : List Nat) (h : FA.clean n l) (L : Tape) :
    steps (FA.goT n l) (img ⟨L, cons false (FA.enc l), .A⟩) =
      some (img ⟨L, cons true (cons false (FA.enc (FA.go n l))), .E⟩) := by
  have e := FA.go_spec n l h L
  show TM.steps trans _ _ = _
  rw [steps_img]
  exact congrArg (Option.map img) e

end H99697
