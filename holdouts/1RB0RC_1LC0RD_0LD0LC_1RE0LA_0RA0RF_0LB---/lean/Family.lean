/-!
# 1RB0RC_1LC0RD_0LD0LC_1RE0LA_0RA0RF_0LB---: the round rule of the nested block counter for every depth

Generated by `py/gen_family_lean.py` in the folder of the family's first machine
(holdouts/1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_0RA---); do not edit by hand.

`FA.trans` is this machine's frame-A conjugate 1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_0RA--- (frames.py); the run from blank tape starts there in state
E.  In frame A the right part of the tape is a list of plain blocks `(10)^b`, each followed by a 1, and the left part
a stack of spread blocks `1 0 0 (1000)^q T_p` (phase p = 1..5).  A *visit* to a list `l` starts with the head in A
on the 0 in front of the blocks and ends with the head back on that cell in E: PUSH spreads the first block, the
rest gets five visits with the four TAILs between them, POP makes the first block plain again; one block is a TURN.
`go_spec` proves it for every list and every depth (`clean` says the blocks are large enough and of the right
parity, a decidable condition); `visit` and `halts_iff` carry it over to the machine itself.
-/

namespace H99697
namespace FA

open TM

/-- The frame-A conjugate of 1RB0RC_1LC0RD_0LD0LC_1RE0LA_0RA0RF_0LB---: 1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_0RA---. -/
def trans : St → Bool → Option (Bool × Dir × St)
  | .A, false => some (true, .R, .B)
  | .A, true => some (false, .L, .C)
  | .B, false => some (false, .R, .C)
  | .B, true => some (false, .R, .B)
  | .C, false => some (true, .L, .D)
  | .C, true => some (false, .R, .E)
  | .D, false => some (false, .L, .E)
  | .D, true => some (false, .L, .F)
  | .E, false => some (true, .L, .A)
  | .E, true => some (false, .L, .B)
  | .F, false => some (false, .R, .A)
  | .F, true => none

abbrev steps := TM.steps trans

/-! ## The seven rules as bbtools.symtm proves them -/

theorem push_raw (k : Nat) (L R : Tape) :
    steps (6 * k + 15) ⟨L, cons false (cons true (cons false (rep (k + 1) [true, false, true, false] (cons true (cons true (cons false (R))))))), .A⟩ = some ⟨rep (k + 1) [false, true, false, false] (cons true (L)), cons false (cons true (cons false (cons true (cons false (R))))), .A⟩ := by
  have hn : 1 + (0 + ((k + 1) * 6 + (8))) = 6 * k + 15 := by omega
  have h0 : steps 1 ⟨L, cons false (cons true (cons false (rep (k + 1) [true, false, true, false] (cons true (cons true (cons false (R))))))), .A⟩ = some ⟨cons true (L), cons true (cons false (rep (k + 1) [true, false, true, false] (cons true (cons true (cons false (R)))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (L), cons true (cons false (rep (k + 1) [true, false, true, false] (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨cons true (L), rep (k + 1) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (k + 1) [true, false, true, false] (cons true (cons true (cons false (R)))))) = rep (k + 1) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))) from
      rep_rotate (k + 1) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons true (cons true (cons false (R))))]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [false, true, false, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((k + 1) * 6) ⟨cons true (L), rep (k + 1) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨rep (k + 1) [false, true, false, false] (cons true (L)), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ :=
    cross_r trans c2 (k + 1) (cons true (L)) (cons true (cons false (cons true (cons true (cons false (R))))))
  have h3 : steps 8 ⟨rep (k + 1) [false, true, false, false] (cons true (L)), cons true (cons false (cons true (cons true (cons false (R))))), .B⟩ = some ⟨rep (k + 1) [false, true, false, false] (cons true (L)), cons false (cons true (cons false (cons true (cons false (R))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

theorem turn_raw (k : Nat) (L : Tape) :
    steps (10 * k + 14) ⟨L, cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (blank))))), .A⟩ = some ⟨L, cons true (cons false (cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (blank)))))))), .E⟩ := by
  have hn : 1 + (0 + ((k) * 6 + (9 + (0 + ((k) * 4 + (4)))))) = 10 * k + 14 := by omega
  have h0 : steps 1 ⟨L, cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (blank))))), .A⟩ = some ⟨cons true (L), cons true (cons false (rep (k) [true, false, true, false] (cons true (blank)))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (L), cons true (cons false (rep (k) [true, false, true, false] (cons true (blank)))), .B⟩ = some ⟨cons true (L), rep (k) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (k) [true, false, true, false] (cons true (blank)))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (k) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons true (blank))]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [false, true, false, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 6) ⟨cons true (L), rep (k) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ = some ⟨rep (k) [false, true, false, false] (cons true (L)), cons true (cons false (cons true (blank))), .B⟩ :=
    cross_r trans c2 (k) (cons true (L)) (cons true (cons false (cons true (blank))))
  have h3 : steps 9 ⟨rep (k) [false, true, false, false] (cons true (L)), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons true (cons false (cons false (rep (k) [false, true, false, false] (cons true (L))))), cons false (cons false (cons true (blank))), .E⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons false (rep (k) [false, true, false, false] (cons true (L))))), cons false (cons false (cons true (blank))), .E⟩ = some ⟨rep (k) [true, false, false, false] (cons true (cons false (cons false (cons true (L))))), cons false (cons false (cons true (blank))), .E⟩ := by
    simp only [steps_zero, show cons true (cons false (cons false (rep (k) [false, true, false, false] (cons true (L))))) = rep (k) [true, false, false, false] (cons true (cons false (cons false (cons true (L))))) from
      rep_rotate (k) [true, false, false] [false, true, false, false] [true, false, false, false] rfl (cons true (L))]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [true, false, false, false] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .E⟩ := fun _ _ => rfl
  have h5 : steps ((k) * 4) ⟨rep (k) [true, false, false, false] (cons true (cons false (cons false (cons true (L))))), cons false (cons false (cons true (blank))), .E⟩ = some ⟨cons true (cons false (cons false (cons true (L)))), cons false (rep (k) [false, true, false, true] (cons false (cons true (blank)))), .E⟩ :=
    cross_l trans c5 (k) (cons true (cons false (cons false (cons true (L))))) (cons false (cons true (blank)))
  have h6 : steps 4 ⟨cons true (cons false (cons false (cons true (L)))), cons false (rep (k) [false, true, false, true] (cons false (cons true (blank)))), .E⟩ = some ⟨L, cons true (cons false (cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (blank)))))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

