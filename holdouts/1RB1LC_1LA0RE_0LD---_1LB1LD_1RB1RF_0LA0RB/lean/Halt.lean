import Machine
import Blank

/-!
# What a halt needs

Generated by `py/rules.py`; do not edit by hand.

The only ways to the halt (C reading 1) are B or F reading 0 with `1 1` on its left: B writes 1 or F writes 0, either steps left, A reads the first 1 and steps left again, and C meets the second 1.

`halt_pred` is about every configuration, reachable or not: a case analysis on the state and the cells near the
head.  `halt_needs_pattern` applies it to the run from blank tape (the first steps are covered by
`blank_runs_kernel`).  Kernel only.
-/

namespace H107251

open TM

/-- A configuration whose run is defined for 2 steps but not for 3 (it halts at step 3) has this shape. -/
theorem halt_pred (l r : Tape) (s : St)
    (h3 : steps 2 ⟨l, r, s⟩ ≠ none) (h4 : steps 3 ⟨l, r, s⟩ = none) :
    (s = .B ∧ r 0 = false ∧ l 0 = true ∧ l 1 = true) ∨ (s = .F ∧ r 0 = false ∧ l 0 = true ∧ l 1 = true) := by
  cases s <;> cases e0 : r 0 <;> cases e1 : r 1 <;> cases e2 : r 2 <;> cases f0 : l 0 <;> cases f1 : l 1 <;>
    simp_all [TM.steps, TM.step, trans, TM.cons, TM.tail]

theorem steps_split (a b : Nat) (c c'' : Config) (h : TM.steps trans (a + b) c = some c'') :
    ∃ c', TM.steps trans a c = some c' ∧ TM.steps trans b c' = some c'' := by
  induction a generalizing c with
  | zero => exact ⟨c, rfl, by simpa using h⟩
  | succ a ih =>
    have e : a + 1 + b = (a + b) + 1 := by omega
    rw [e] at h
    cases hs : TM.step trans c with
    | none => simp [TM.steps, hs] at h
    | some d =>
      rw [TM.steps_succ_of_step trans (a + b) hs] at h
      obtain ⟨c', h1, h2⟩ := ih d h
      exact ⟨c', by rw [TM.steps_succ_of_step trans a hs]; exact h1, h2⟩

/-- If the machine halts from blank tape, the run passes through a configuration of this shape. -/
theorem halt_needs_pattern (h : HaltsFromBlank) :
    ∃ n c, steps n init = some c ∧ ((c.st = .B ∧ c.r 0 = false ∧ c.l 0 = true ∧ c.l 1 = true) ∨ (c.st = .F ∧ c.r 0 = false ∧ c.l 0 = true ∧ c.l 1 = true)) := by
  obtain ⟨n, c', h1, h2⟩ := h
  obtain ⟨c0, hc0⟩ := blank_runs_kernel
  by_cases hn : n < 3
  · exfalso
    have hz := TM.steps_halt trans h1 h2 (2 - n)
    have e : n + (2 - n + 1) = 3 := by omega
    rw [e] at hz
    have e2 : (10000 : Nat) = 3 + 9997 := by omega
    rw [e2] at hc0
    obtain ⟨c5, h5⟩ := TM.steps_le trans hc0
    rw [hz] at h5
    cases h5
  · obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
    obtain ⟨c, hc, hk⟩ := steps_split m 2 init c' h1
    refine ⟨m, c, hc, ?_⟩
    obtain ⟨l, r, s⟩ := c
    have hk1 : steps 3 ⟨l, r, s⟩ = none := by
      have := TM.steps_halt trans hk h2 0
      simpa using this
    exact halt_pred l r s (by show TM.steps trans 2 _ ≠ none; rw [hk]; simp) hk1

end H107251
