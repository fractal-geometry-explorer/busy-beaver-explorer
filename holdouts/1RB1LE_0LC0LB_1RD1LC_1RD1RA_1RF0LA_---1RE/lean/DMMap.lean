import Blank
import DMRules
import TM.MapOrbit

/-!
# A halts-iff map, after DeepMind's

`DM.State`, `DM.start`, `DM.next` are DeepMind's (google-deepmind/cryptids,
`BusyBeaver/BB6/M_1RB1LE_0LC0LB_1RD1LC_1RD1RA_1RF0LA_HHH1RE.lean`, commit 3647718), copied unchanged but for `ℕ`
written `Nat`.  Their file proves with Mathlib that the machine halts iff the orbit of `next` from `start` stops; here
the same statement is proved on this repository's machine semantics with core Lean only (`deepmind_halts_iff`), so
it no longer needs to be cited.

`A a c d` is the configuration `0^∞ 1^a A> (10)^c 1^(d+1) 0^∞` and `Run a` is `0^∞ 1^a D> 0^∞`.  Most steps of `next`
are one rule of `DMRules.lean` (generated by `py/dmrules.py`).  The steps from `A 1 (c + 1) d` take `c / 2` passes
(`rounds`): each eats `0101` on the right and puts six more 1s on the left.  DeepMind's `next` sends every state
whose run goes off to the right on blank tape to `Run 1`, while the machine reaches `Run a` for some other `a`; so a
`Run` state stands for every `Run a` configuration (`Rel`).  Nothing else is lost: `Run` never stops in either.
-/

set_option autoImplicit false

namespace H89542

namespace DM

inductive State where
  /-- $A(a, c, d) := 0^\infty\,1^a\,\mathrm{A}{>}\,(10)^c\,1^{d+1}\,0^\infty$. -/
  | A (a c d : Nat)
  /-- $\mathrm{Run}(a) := 0^\infty\,1^a\,\mathrm{D}{>}\,0^\infty$. -/
  | Run (a : Nat)
  deriving DecidableEq, Repr

def start : State := .A 2 0 1

def next : State → Option State
  | .Run a => some (.Run (a + 1))
  | .A (a + 2) c d => some (.A a (c + 1) d)
  | .A 0 _ 0 => none
  | .A 0 c 1 => some (.A (2 * c + 1) 0 0)
  | .A 0 c (d + 2) => some (.A (2 * c + 1) 1 d)
  | .A 1 c 0 =>
      if c % 2 = 0 then some (.Run 1) else some (.A 2 0 (3 * c + 4))
  | .A 1 c 1 =>
      if c % 2 = 0 then some (.A 2 0 (3 * c + 6)) else some (.A (3 * c + 5) 0 0)
  | .A 1 c (d + 2) =>
      if c % 2 = 0 then some (.A (3 * c + 7) 0 d) else some (.A (3 * c + 5) 0 (d + 1))

/-- `n` steps of `next` from `start`: DeepMind's `(Option.bind · next)^[n] (some start)` in `CollatzHalts`. -/
def orbit : Nat → Option State
  | 0 => some start
  | n + 1 => Option.bind (orbit n) next

end DM

open TM DM

/-- The configuration of a state. -/
def enc : State → Config
  | .A a c d => ⟨rep a [true] blank, rep c [true, false] (rep (d + 1) [true] blank), .A⟩
  | .Run a => ⟨rep a [true] blank, blank, .D⟩

/-- Which configurations a state stands for: `A a c d` its own, `Run a` every `Run a'`. -/
def Rel : State → Config → Prop
  | .A a c d, c' => c' = enc (.A a c d)
  | .Run _, c' => ∃ a', c' = enc (.Run a')

abbrev Plus := TM.Plus trans
abbrev Star := TM.Star trans
abbrev Lands := TM.Lands trans Rel

theorem landA {c : Config} {a b d : Nat} (h : Plus c (enc (.A a b d))) : Lands c (some (.A a b d)) :=
  ⟨_, h, rfl⟩

theorem landRun {c : Config} {a a' : Nat} (h : Plus c (enc (.Run a'))) : Lands c (some (.Run a)) :=
  ⟨_, h, a', rfl⟩

theorem rep_one_tf (s : Tape) : rep 1 [true, false] s = cons true (cons false s) := rfl

/-- Configurations equal up to how their runs of ones are written. -/
macro "tape_eq" : tactic => `(tactic| (
  simp only [enc, rep_zero, rep_one_tf, cons_false_blank, ones_two, ones_one, ones_snoc, ones_ones, ones_cons, Nat.add_zero]
  tape_cong))

/-- `(0101)^j` crossed: six 1s per copy. -/
theorem rounds (j : Nat) : ∀ (n : Nat) (R : Tape),
    Star ⟨rep n [true] blank, rep j [false, true, false, true] R, .A⟩ ⟨rep (n + 6 * j) [true] blank, R, .A⟩ := by
  induction j with
  | zero => intro n R; exact Star.refl _
  | succ j ih =>
    intro n R
    have h₁ := round n (rep j [false, true, false, true] R)
    have h₂ := ih (n + 6) R
    rw [show n + 6 + 6 * j = n + 6 * (j + 1) by omega] at h₂
    refine (plus_of h₁ rfl ?_).star.trans h₂
    simp only [ones_one, ones_ones]
    congr 1; apply ones_eq; omega

theorem zero_rot (m : Nat) (X : Tape) : cons false (rep m [true, false] X) = rep m [false, true] (cons false X) :=
  rep_rotate m [false] [true, false] [false, true] rfl X

theorem rep_ft_even (j : Nat) (X : Tape) : rep (2 * j) [false, true] X = rep j [false, true, false, true] X :=
  rep_double j [false, true] X

theorem rep_ft_odd (j : Nat) (X : Tape) :
    rep (2 * j + 1) [false, true] X = rep j [false, true, false, true] (cons false (cons true X)) := by
  rw [rep_add, rep_double]; rfl

/-- The steps from `A 1 (c + 1) d`. -/
theorem step_A1 (c d : Nat) : Lands (enc (.A 1 (c + 1) d)) (next (.A 1 (c + 1) d)) := by
  -- the first `10` becomes `0 1 0`, leaving `0 (10)^(c+1)` = `(01)^(c+1) 0`
  have hp := p1 (rep c [true, false] (rep (d + 1) [true] blank))
  have h₁ : Plus (enc (.A 1 (c + 1) d))
      ⟨rep 2 [true] blank, rep (c + 1) [false, true] (cons false (rep (d + 1) [true] blank)), .A⟩ :=
    plus_of hp rfl (by rw [← zero_rot]; rfl)
  obtain ⟨j, rfl | rfl⟩ : ∃ j, c = 2 * j + 1 ∨ c = 2 * j := ⟨c / 2, by omega⟩
  · -- c + 1 even
    rw [show 2 * j + 1 + 1 = 2 * (j + 1) by omega, rep_ft_even] at h₁
    have h₁₂ := h₁.trans_star (rounds (j + 1) 2 (cons false (rep (d + 1) [true] blank)))
    rw [show 2 * (j + 1) = 2 * j + 1 + 1 by omega] at h₁₂
    rcases d with _ | _ | d
    · simp only [next, show (2 * j + 1 + 1) % 2 = 0 by omega, ite_true]
      exact landRun (a' := 2 + 6 * (j + 1) + 3) (h₁₂.trans (plus_of (e0 (2 + 6 * (j + 1))) rfl (by tape_eq)))
    · simp only [next, show (2 * j + 1 + 1) % 2 = 0 by omega, ite_true]
      exact landA (h₁₂.trans (plus_of (e1 (2 + 6 * (j + 1))) rfl (by tape_eq)))
    · simp only [next, show (2 * j + 1 + 1) % 2 = 0 by omega, ite_true]
      exact landA (h₁₂.trans (plus_of (e2 d (2 + 6 * (j + 1))) rfl (by tape_eq)))
  · -- c + 1 odd
    rw [rep_ft_odd] at h₁
    have h₁₂ := h₁.trans_star (rounds j 2 (cons false (cons true (cons false (rep (d + 1) [true] blank)))))
    rcases d with _ | _ | d
    · simp only [next, show (2 * j + 1) % 2 = 1 by omega]
      exact landA (h₁₂.trans (plus_of (o0 (2 + 6 * j)) rfl (by tape_eq)))
    · simp only [next, show (2 * j + 1) % 2 = 1 by omega]
      exact landA (h₁₂.trans (plus_of (round (2 + 6 * j) (rep (0 + 1) [true] blank)) rfl (by tape_eq)))
    · simp only [next, show (2 * j + 1) % 2 = 1 by omega]
      exact landA (h₁₂.trans (plus_of (round (2 + 6 * j) (rep (d + 1 + 1) [true] blank)) rfl (by tape_eq)))

/-- Every state lands where `next` says. -/
theorem step_rel : ∀ s c, Rel s c → Lands c (next s) := by
  intro s c₀ h
  cases s with
  | Run _ =>
    obtain ⟨a', h⟩ := h
    subst h
    exact landRun (a' := a' + 1) (plus_of (runD a') rfl rfl)
  | A a c d =>
    simp only [Rel] at h
    subst h
    rcases a with _ | _ | a
    · rcases d with _ | _ | d
      · rcases c with _ | c
        · exact halts_at (h00) rfl rfl
        · exact halts_at (h0c c) rfl rfl
      · rcases c with _ | c
        · exact landA (plus_of a0c1_0 rfl (by tape_eq))
        · exact landA (plus_of (a0c1 c) rfl (by tape_eq))
      · rcases c with _ | c
        · exact landA (plus_of (a0d_0 d) rfl rfl)
        · exact landA (plus_of (a0d c d) rfl (by tape_eq))
    · rcases c with _ | c
      · rcases d with _ | _ | d
        · exact landRun (a' := 1) (plus_of a1_00 rfl (by tape_eq))
        · exact landA (plus_of a1_01 rfl (by tape_eq))
        · exact landA (plus_of (a1_0d d) rfl rfl)
      · exact step_A1 c d
    · rcases c with _ | c
      · exact landA (plus_of (sA (rep a [true] blank) (rep d [true] blank)) rfl rfl)
      · exact landA (plus_of (sA (rep a [true] blank) (cons false (rep c [true, false] (rep (d + 1) [true] blank))))
          rfl rfl)

/-- **DeepMind's halts-iff map, proved here.**  The machine halts from blank tape if and only if the orbit of
DeepMind's `next` from `start` stops. -/
theorem deepmind_halts_iff : HaltsFromBlank ↔ ∃ n, (DM.orbit n).isNone = true := by
  have h : HaltsFromBlank ↔ ∃ n, TM.orbit next start n = none :=
    halts_iff_orbit ⟨12, _, blank_A, by simp only [Rel, start]; tape_eq⟩ step_rel
  have e : ∀ n, DM.orbit n = TM.orbit next start n := by
    intro n; induction n with
    | zero => rfl
    | succ n ih => simp only [DM.orbit, TM.orbit, ih]
  rw [h]
  constructor
  · rintro ⟨n, hn⟩; exact ⟨n, by rw [e, hn]; rfl⟩
  · rintro ⟨n, hn⟩; refine ⟨n, ?_⟩; rw [← e]; cases h' : DM.orbit n <;> simp_all

end H89542
