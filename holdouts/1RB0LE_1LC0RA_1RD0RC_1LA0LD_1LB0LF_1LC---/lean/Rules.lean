import Machine

/-! # Shift rules of 1RB0LE_1LC0RA_1RD0RC_1LA0LD_1LB0LF_1LC---

Two erasing runs: C walks right over a block of 1s, erasing it, one step a cell (`erase_C`), and D, with a 1 ahead,
walks left over a block of 1s, erasing it (`erase_D`).  The halting situations: only F reading a 1 halts, and
`1 E> 1`, `1 1 A> 1`, `1 1 1 D> 0` and `1 1 C> 0 0` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H69718

open TM

/-- C erases a block of 1s going right, one step a cell. -/
theorem erase_C (n : Nat) (L R : Tape) :
    steps (n) ⟨L, rep (n) [true] (R), .C⟩ = some ⟨rep (n) [false] (L), R, .C⟩ := by
  have hn : (n) * 1 = n := by omega
  have c0 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .C⟩ = some ⟨app [] (app [false] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 1) ⟨L, rep (n) [true] (R), .C⟩ = some ⟨rep (n) [false] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- D, with a 1 ahead, erases a block of 1s going left, one step a cell. -/
theorem erase_D (n : Nat) (L R : Tape) :
    steps (n) ⟨rep (n) [true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [false] (R)), .D⟩ := by
  have hn : (n) * 1 = n := by omega
  have c0 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 1) ⟨rep (n) [true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [false] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `1 E> 1` halts: E erases the 1 and steps left onto a 1 in state F. -/
theorem halt_E (L R : Tape) : ∃ c, steps 1 ⟨cons true (L), cons true (R), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `1 1 A> 1` halts after two steps. -/
theorem halt_A (L R : Tape) : ∃ c, steps 2 ⟨cons true (cons true (L)), cons true (R), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `1 1 1 D> 0` halts after three steps. -/
theorem halt_D (L R : Tape) : ∃ c, steps 3 ⟨cons true (cons true (cons true (L))), cons false (R), .D⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `1 1 C> 0 0` halts after four steps. -/
theorem halt_C (L R : Tape) : ∃ c, steps 4 ⟨cons true (cons true (L)), cons false (cons false (R)), .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H69718
