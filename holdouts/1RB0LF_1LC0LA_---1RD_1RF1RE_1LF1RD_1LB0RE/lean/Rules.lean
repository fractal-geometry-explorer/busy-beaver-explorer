import Machine

/-! # Shift rules of 1RB0LF_1LC0LA_---1RD_1RF1RE_1LF1RD_1LB0RE

Passes of the machine.  Over the regular left part of the tape, E moving right rewrites each copy of
`1101101101` as `1011110110` (`pass_right`, 12 steps a copy) and A moving left rewrites it back (`pass_left`, 50
steps a copy).  In the irregular right part the head crosses runs of three-cell words: `D> (011)^n` (`cross_D`),
`(101)^n B> 1` (`cross_B`).  The only halt is C reading a 0, and C is entered only from B reading a 0 (writing a 1,
stepping left), so `0 B> 0` halts after two steps (`halt_B`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H125689

open TM

/-- E moving right over the left part, 12 steps a copy. -/
theorem pass_right (n : Nat) (L R : Tape) :
    steps (12 * n) ⟨L, rep (n) [true, true, false, true, true, false, true, true, false, true] (R), .E⟩ = some ⟨rep (n) [false, true, true, false, true, true, true, true, false, true] (L), R, .E⟩ := by
  have c0 : ∀ L R : Tape, steps 12 ⟨app [] L, app [true, true, false, true, true, false, true, true, false, true] R, .E⟩ = some ⟨app [] (app [false, true, true, false, true, true, true, true, false, true] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 12) ⟨L, rep (n) [true, true, false, true, true, false, true, true, false, true] (R), .E⟩ = some ⟨rep (n) [false, true, true, false, true, true, true, true, false, true] (L), R, .E⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 12) (by omega) (h0)

/-- A moving left over the left part, 50 steps a copy; `1 (0110110111)^n` is `(1011011011)^n 1`, a rotation of the word E crosses. -/
theorem pass_left (n : Nat) (L R : Tape) :
    steps (50 * n) ⟨rep (n) [false, true, true, false, true, true, true, true, false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [false, true, true, false, true, true, false, true, true, true] (R)), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 50 ⟨app [false, true, true, false, true, true, true, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, true, true, false, true, true, false, true, true, true] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 50) ⟨rep (n) [false, true, true, false, true, true, true, true, false, true] (L), cons true (R), .A⟩ = some ⟨L, cons true (rep (n) [false, true, true, false, true, true, false, true, true, true] (R)), .A⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 50) (by omega) (h0)

/-- D moving right over `011`, three steps a copy. -/
theorem cross_D (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨L, rep (n) [false, true, true] (R), .D⟩ = some ⟨rep (n) [true, false, true] (L), R, .D⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [] L, app [false, true, true] R, .D⟩ = some ⟨app [] (app [true, false, true] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨L, rep (n) [false, true, true] (R), .D⟩ = some ⟨rep (n) [true, false, true] (L), R, .D⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 3) (by omega) (h0)

/-- B moving left over `101`, three steps a copy. -/
theorem cross_B (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [true, false, true] (L), cons true (R), .B⟩ = some ⟨L, cons true (rep (n) [true, false, false] (R)), .B⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true, false, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [true, false, false] R), .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true, false, true] (L), cons true (R), .B⟩ = some ⟨L, cons true (rep (n) [true, false, false] (R)), .B⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 3) (by omega) (h0)

/-- `0 B> 0` halts: B writes a 1 and steps left in state C onto a 0, which has no transition. -/
theorem halt_B (L R : Tape) :
    ∃ c, steps 1 ⟨cons false L, cons false R, .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H125689
