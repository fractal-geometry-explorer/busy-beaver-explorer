  have c0 : ∀ L R : Tape, steps 10 ⟨app [true, false, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true, false, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n + 1) * 10) ⟨rep (n + 1) [true, false, false, true] (cons true (blank)), cons true (R), .A⟩ = some ⟨cons true (blank), cons true (rep (n + 1) [true, true, false, false] (R)), .A⟩ :=
    cross_l trans c0 (n + 1) (cons true (blank)) (R)
  have h1 : steps 12 ⟨cons true (blank), cons true (rep (n + 1) [true, true, false, false] (R)), .A⟩ = some ⟨cons false (cons true (blank)), cons true (cons false (cons false (rep (n + 1) [true, true, false, false] (R)))), .F⟩ := rfl
  have h2 : steps 0 ⟨cons false (cons true (blank)), cons true (cons false (cons false (rep (n + 1) [true, true, false, false] (R)))), .F⟩ = some ⟨cons false (cons true (blank)), rep (n + 1) [true, false, false, true] (cons true (cons false (cons false (R)))), .F⟩ := by
    simp only [steps_zero, show cons true (cons false (cons false (rep (n + 1) [true, true, false, false] (R)))) = rep (n + 1) [true, false, false, true] (cons true (cons false (cons false (R)))) from
