/-- The head comes back over the block of n+1 words c in C, bounces off the blank tape and crosses it again. -/
theorem bounce_c (n : Nat) (R : Tape) :
    steps (16 * n + 32) ⟨rep (n + 1) [false, false, true, true] (blank), cons true (cons true (R)), .C⟩ = some ⟨cons true (cons false (cons false (cons true (rep (n + 1) [true, false, false, true] (cons true (blank)))))), R, .B⟩ := by
  have hn : (n + 1) * 10 + (11 + (0 + ((n + 1) * 6 + (5)))) = 16 * n + 32 := by omega
  have c0 : ∀ L R : Tape, steps 10 ⟨app [false, false, true, true] L, app [true, true] R, .C⟩ = some ⟨L, app [true, true] (app [true, true, false, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n + 1) * 10) ⟨rep (n + 1) [false, false, true, true] (blank), cons true (cons true (R)), .C⟩ = some ⟨blank, cons true (cons true (rep (n + 1) [true, true, false, false] (R))), .C⟩ :=
    cross_l trans c0 (n + 1) (blank) (R)
  have h1 : steps 11 ⟨blank, cons true (cons true (rep (n + 1) [true, true, false, false] (R))), .C⟩ = some ⟨cons false (cons true (blank)), cons true (cons false (cons false (rep (n + 1) [true, true, false, false] (R)))), .F⟩ := rfl
  have h2 : steps 0 ⟨cons false (cons true (blank)), cons true (cons false (cons false (rep (n + 1) [true, true, false, false] (R)))), .F⟩ = some ⟨cons false (cons true (blank)), rep (n + 1) [true, false, false, true] (cons true (cons false (cons false (R)))), .F⟩ := by
    simp only [steps_zero, show cons true (cons false (cons false (rep (n + 1) [true, true, false, false] (R)))) = rep (n + 1) [true, false, false, true] (cons true (cons false (cons false (R)))) from
      rep_rotate (n + 1) [true, false, false] [true, true, false, false] [true, false, false, true] rfl (R)]
  have c3 : ∀ L R : Tape, steps 6 ⟨app [false] L, app [true, false, false, true] R, .F⟩ = some ⟨app [false] (app [true, false, false, true] L), R, .F⟩ := fun _ _ => rfl
  have h3 : steps ((n + 1) * 6) ⟨cons false (cons true (blank)), rep (n + 1) [true, false, false, true] (cons true (cons false (cons false (R)))), .F⟩ = some ⟨cons false (rep (n + 1) [true, false, false, true] (cons true (blank))), cons true (cons false (cons false (R))), .F⟩ :=
    cross_r trans c3 (n + 1) (cons true (blank)) (cons true (cons false (cons false (R))))
  have h4 : steps 5 ⟨cons false (rep (n + 1) [true, false, false, true] (cons true (blank))), cons true (cons false (cons false (R))), .F⟩ = some ⟨cons true (cons false (cons false (cons true (rep (n + 1) [true, false, false, true] (cons true (blank)))))), R, .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

