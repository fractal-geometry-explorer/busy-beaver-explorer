import Periods
import ResetRules

/-!
# 1RB1LC_1RC0RF_1RD0LB_1RE0LD_1LF---_0RA1LA: the resets, and the phase map as a theorem

A phase ends at `cfg n r (tl t R)` = `0^inf B> 0 0 1 (1100)^n (10110110)^r 1 0 (1110)^t R` with r < 5.  The rules of
`ResetRules.lean` (generated by `resets.py`, one per row of the reset table and parity of n) are restated here in
that form (`reset0` .. `reset4`), for every n (n ≥ 1 for r = 2), every t and every tape R (never read).  With the
periods of `Periods.lean` (here with exact step counts, `periods_exact`) they give the phase map `phase` on
(n, r, t), the table that `py/m7map.py` iterates; `phaseRun_spec` says the machine follows it, with the step counts.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 10000

namespace H66813

open TM

/-- The tail `1 0 (1110)^t R`. -/
def tl (t : Nat) (R : Tape) : Tape := cons true (cons false (rep t [true, true, true, false] R))

theorem rep_two_mul (a : Nat) (w : List Bool) (s : Tape) : rep (2 * a) w s = rep a (w ++ w) s := by
  induction a with
  | zero => rfl
  | succ a ih =>
    rw [show 2 * (a + 1) = 2 * a + 1 + 1 by omega, rep_succ, rep_succ, ih, app_app, rep_succ]

/-- `rep` split in three: j copies, a copies, l copies. -/
theorem rep_split (j a l : Nat) (w : List Bool) (s : Tape) : rep (j + a + l) w s = rep j w (rep a w (rep l w s)) := by
  rw [rep_add, rep_add]

/-! ## The rows of the reset table -/

theorem reset0_even (a t : Nat) (R : Tape) :
    steps (151 * (2 * a) + 1560) (cfg (2 * a) 0 (tl (t + 4) R)) = some (cfg 10 (a + 2) (tl t R)) := by
  have h := reset0_even_raw a t R
  rw [show 151 * (2 * a) + 1560 = 302 * a + 1560 by omega]
  simp only [cfg, tl]
  rw [rep_two_mul, show a + 2 = 1 + a + 1 by omega, rep_split]
  exact h

theorem reset0_odd (a t : Nat) (R : Tape) :
    steps (151 * (2 * a + 1) + 1605) (cfg (2 * a + 1) 0 (tl (t + 4) R)) = some (cfg 10 (a + 3) (tl t R)) := by
  have h := reset0_odd_raw a t R
  rw [show 151 * (2 * a + 1) + 1605 = 302 * a + 1756 by omega]
  simp only [cfg, tl]
  rw [rep_succ, rep_two_mul, show a + 3 = 2 + a + 1 by omega, rep_split]
  exact h

theorem reset1 (n t : Nat) (R : Tape) :
    steps (192 * n + 1374) (cfg n 1 (tl (t + 1) R)) = some (cfg (n + 12) 0 (tl t R)) := by
  have h := reset1_raw n t R
  have e : ∀ s : Tape, cons true (cons true (rep n [false, false, true, true] s))
      = rep n [true, true, false, false] (cons true (cons true s)) :=
    fun s => rep_rotate n [true, true] [false, false, true, true] [true, true, false, false] rfl s
  rw [e] at h
  simp only [cfg, tl]
  rw [show n + 12 = 11 + n + 1 by omega, rep_split]
  exact h

theorem reset2 (n t : Nat) (R : Tape) :
    steps (512 * (n + 1) + 8840) (cfg (n + 1) 2 (tl (t + 4) R)) = some (cfg (n + 1 + 32) 0 (tl t R)) := by
  have h := reset2_raw n t R
  rw [show 512 * (n + 1) + 8840 = 512 * n + 9352 by omega]
  simp only [cfg, tl]
  rw [show n + 1 + 32 = 32 + n + 1 by omega, rep_split]
  exact h

theorem reset3_even (a t : Nat) (R : Tape) :
    steps (471 * (2 * a) + 8170) (cfg (2 * a) 3 (tl (t + 3) R)) = some (cfg 10 (a + 12) (tl t R)) := by
  have h := reset3_even_raw a t R
  rw [show 471 * (2 * a) + 8170 = 942 * a + 8170 by omega]
  simp only [cfg, tl]
  rw [rep_two_mul, show a + 12 = 11 + a + 1 by omega, rep_split]
  exact h

theorem reset3_odd (a t : Nat) (R : Tape) :
    steps (471 * (2 * a + 1) + 8215) (cfg (2 * a + 1) 3 (tl (t + 3) R)) = some (cfg 10 (a + 13) (tl t R)) := by
  have h := reset3_odd_raw a t R
  rw [show 471 * (2 * a + 1) + 8215 = 942 * a + 8686 by omega]
  simp only [cfg, tl]
  rw [rep_succ, rep_two_mul, show a + 13 = 12 + a + 1 by omega, rep_split]
  exact h

theorem reset4_even (a t : Nat) (R : Tape) :
    steps (471 * (2 * a) + 8286) (cfg (2 * a) 4 (tl (t + 2) R)) = some (cfg 10 (a + 13) (tl t R)) := by
  have h := reset4_even_raw a t R
  rw [show 471 * (2 * a) + 8286 = 942 * a + 8286 by omega]
  simp only [cfg, tl]
  rw [rep_two_mul, show a + 13 = 12 + a + 1 by omega, rep_split]
  exact h

theorem reset4_odd (a t : Nat) (R : Tape) :
    steps (471 * (2 * a + 1) + 8241) (cfg (2 * a + 1) 4 (tl (t + 2) R)) = some (cfg 10 (a + 13) (tl t R)) := by
  have h := reset4_odd_raw a t R
  rw [show 471 * (2 * a + 1) + 8241 = 942 * a + 8712 by omega]
  simp only [cfg, tl]
  rw [rep_succ, rep_two_mul, show a + 13 = 12 + a + 1 by omega, rep_split]
  exact h

/-! ## The table, as functions of n -/

/-- The steps of the reset at a phase end (n, r): the table of README.md. -/
def resetSteps (n r : Nat) : Nat :=
  match r with
  | 0 => if n % 2 = 0 then 151 * n + 1560 else 151 * n + 1605
  | 1 => 192 * n + 1374
  | 2 => 512 * n + 8840
  | 3 => if n % 2 = 0 then 471 * n + 8170 else 471 * n + 8215
  | _ => if n % 2 = 0 then 471 * n + 8286 else 471 * n + 8241

/-- The reset at a phase end (n, r, t): the configuration `cfg n' m' (tl t' R)` it reaches (`none`: the table does
not apply, t too small, r ≥ 5, or r = 2 with n = 0). -/
def reset : Nat × Nat × Nat → Option (Nat × Nat × Nat)
  | (n, 0, t) => if 4 ≤ t then some (10, (n + 5) / 2, t - 4) else none
  | (n, 1, t) => if 1 ≤ t then some (n + 12, 0, t - 1) else none
  | (n, 2, t) => if 1 ≤ n ∧ 4 ≤ t then some (n + 32, 0, t - 4) else none
  | (n, 3, t) => if 3 ≤ t then some (10, (n + 25) / 2, t - 3) else none
  | (n, 4, t) => if 2 ≤ t then some (10, (n + 26) / 2, t - 2) else none
  | _ => none

theorem parity (n : Nat) : ∃ a, n = 2 * a ∨ n = 2 * a + 1 := ⟨n / 2, by omega⟩

/-- Every row of the reset table, for every n, t and tape R. -/
theorem reset_spec {n r t n' m' t' : Nat} (h : reset (n, r, t) = some (n', m', t')) (R : Tape) :
    steps (resetSteps n r) (cfg n r (tl t R)) = some (cfg n' m' (tl t' R)) := by
  match r, h with
  | 0, h =>
    simp only [reset] at h
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      obtain ⟨t, rfl⟩ : ∃ s, t = s + 4 := ⟨t - 4, by omega⟩
      rw [show t + 4 - 4 = t by omega]
      obtain ⟨a, rfl | rfl⟩ := parity n
      · have e : resetSteps (2 * a) 0 = 151 * (2 * a) + 1560 := by simp [resetSteps]
        rw [e, show (2 * a + 5) / 2 = a + 2 by omega]
        exact reset0_even a t R
      · have e : resetSteps (2 * a + 1) 0 = 151 * (2 * a + 1) + 1605 := by simp [resetSteps]
        rw [e, show (2 * a + 1 + 5) / 2 = a + 3 by omega]
        exact reset0_odd a t R
    · simp at h
  | 1, h =>
    simp only [reset] at h
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      obtain ⟨t, rfl⟩ : ∃ s, t = s + 1 := ⟨t - 1, by omega⟩
      rw [show t + 1 - 1 = t by omega]
      exact reset1 n t R
    · simp at h
  | 2, h =>
    simp only [reset] at h
    split at h
    · rename_i hc
      simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      obtain ⟨t, rfl⟩ : ∃ s, t = s + 4 := ⟨t - 4, by omega⟩
      obtain ⟨n, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
      rw [show t + 4 - 4 = t by omega]
      exact reset2 n t R
    · simp at h
  | 3, h =>
    simp only [reset] at h
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      obtain ⟨t, rfl⟩ : ∃ s, t = s + 3 := ⟨t - 3, by omega⟩
      rw [show t + 3 - 3 = t by omega]
      obtain ⟨a, rfl | rfl⟩ := parity n
      · have e : resetSteps (2 * a) 3 = 471 * (2 * a) + 8170 := by simp [resetSteps]
        rw [e, show (2 * a + 25) / 2 = a + 12 by omega]
        exact reset3_even a t R
      · have e : resetSteps (2 * a + 1) 3 = 471 * (2 * a + 1) + 8215 := by simp [resetSteps]
        rw [e, show (2 * a + 1 + 25) / 2 = a + 13 by omega]
        exact reset3_odd a t R
    · simp at h
  | 4, h =>
    simp only [reset] at h
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      obtain ⟨t, rfl⟩ : ∃ s, t = s + 2 := ⟨t - 2, by omega⟩
      rw [show t + 2 - 2 = t by omega]
      obtain ⟨a, rfl | rfl⟩ := parity n
      · have e : resetSteps (2 * a) 4 = 471 * (2 * a) + 8286 := by simp [resetSteps]
        rw [e, show (2 * a + 26) / 2 = a + 13 by omega]
        exact reset4_even a t R
      · have e : resetSteps (2 * a + 1) 4 = 471 * (2 * a + 1) + 8241 := by simp [resetSteps]
        rw [e, show (2 * a + 1 + 26) / 2 = a + 13 by omega]
        exact reset4_odd a t R
    · simp at h
  | r + 5, h => simp [reset] at h

/-! ## Periods with exact step counts -/

/-- The steps of q periods from n: the i-th (from 0) takes 448 (n + 31 i) + 6952 steps (`period'`). -/
def periodSteps (q n : Nat) : Nat := q * (448 * n + 6952) + 6944 * (q * (q - 1))

theorem periodSteps_succ (q n : Nat) : periodSteps (q + 1) n = 448 * n + 6952 + periodSteps q (n + 31) := by
  unfold periodSteps
  cases q with
  | zero => simp
  | succ p =>
    simp only [Nat.add_sub_cancel, Nat.add_mul, Nat.mul_add, Nat.one_mul, Nat.mul_one, Nat.mul_assoc, Nat.mul_comm,
      Nat.mul_left_comm]
    omega

theorem periods_exact (q : Nat) : ∀ n m R,
    steps (periodSteps q n) (cfg n (m + 5 * q) R) = some (cfg (n + 31 * q) m R) := by
  induction q with
  | zero => intro n m R; rw [show periodSteps 0 n = 0 by simp [periodSteps]]; rfl
  | succ q ih =>
    intro n m R
    rw [periodSteps_succ]
    have hs := ih (n + 31) m R
    rw [show n + 31 + 31 * q = n + 31 * (q + 1) by omega] at hs
    rw [show m + 5 * (q + 1) = (m + 5 * q) + 5 by omega]
    exact steps_seq trans (period' n (m + 5 * q) R) hs

/-! ## The phase map -/

/-- From a phase end (n, r, t) to the next one: the reset, then floor(m'/5) periods. -/
def phase (x : Nat × Nat × Nat) : Option (Nat × Nat × Nat) :=
  (reset x).map fun (n', m', t') => (n' + 31 * (m' / 5), m' % 5, t')

/-- The steps of that phase map. -/
def phaseSteps (x : Nat × Nat × Nat) : Nat :=
  match reset x with
  | some (n', m', _) => resetSteps x.1 x.2.1 + periodSteps (m' / 5) n'
  | none => 0

/-- The machine follows the phase map: from the phase end (n, r, t) it reaches the next phase end in
`phaseSteps (n, r, t)` steps, for every tape R beyond the tail. -/
theorem phase_spec {n r t n' r' t' : Nat} (h : phase (n, r, t) = some (n', r', t')) (R : Tape) :
    steps (phaseSteps (n, r, t)) (cfg n r (tl t R)) = some (cfg n' r' (tl t' R)) := by
  unfold phase at h
  unfold phaseSteps
  cases hr : reset (n, r, t) with
  | none => rw [hr] at h; simp at h
  | some y =>
    obtain ⟨n1, m1, t1⟩ := y
    rw [hr] at h
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl, rfl⟩ := h
    have h1 := reset_spec hr R
    have h2 := periods_exact (m1 / 5) n1 (m1 % 5) (tl t1 R)
    rw [show m1 % 5 + 5 * (m1 / 5) = m1 by omega] at h2
    exact steps_seq trans h1 h2

/-- The phase map applies at every phase end with r < 5, n ≥ 1 and t ≥ 4, and the next phase end is again one
(r' < 5, n' ≥ 10) with t' ≥ t - 4. -/
theorem phase_some {n r t : Nat} (hr : r < 5) (hn : 1 ≤ n) (ht : 4 ≤ t) :
    ∃ n' r' t', phase (n, r, t) = some (n', r', t') ∧ r' < 5 ∧ 10 ≤ n' ∧ t - 4 ≤ t' := by
  unfold phase
  match r, hr with
  | 0, _ => exact ⟨10 + 31 * ((n + 5) / 2 / 5), (n + 5) / 2 % 5, t - 4, by simp [reset, ht], by omega, by omega,
      by omega⟩
  | 1, _ => exact ⟨n + 12 + 31 * (0 / 5), 0 % 5, t - 1, by simp [reset, show 1 ≤ t by omega], by omega, by omega,
      by omega⟩
  | 2, _ => exact ⟨n + 32 + 31 * (0 / 5), 0 % 5, t - 4, by simp [reset, hn, ht], by omega, by omega, by omega⟩
  | 3, _ => exact ⟨10 + 31 * ((n + 25) / 2 / 5), (n + 25) / 2 % 5, t - 3, by simp [reset, show 3 ≤ t by omega],
      by omega, by omega, by omega⟩
  | 4, _ => exact ⟨10 + 31 * ((n + 26) / 2 / 5), (n + 26) / 2 % 5, t - 2, by simp [reset, show 2 ≤ t by omega],
      by omega, by omega, by omega⟩

/-- k phases, with the total step count. -/
def phaseRun : Nat → Nat × Nat × Nat → Option ((Nat × Nat × Nat) × Nat)
  | 0, x => some (x, 0)
  | k + 1, x =>
    match phase x with
    | some y => (phaseRun k y).map fun (z, s) => (z, phaseSteps x + s)
    | none => none

/-- The machine follows k phases of the map, with the exact step count. -/
theorem phaseRun_spec (k : Nat) : ∀ {n r t n' r' t' s : Nat}, phaseRun k (n, r, t) = some ((n', r', t'), s) →
    ∀ R, steps s (cfg n r (tl t R)) = some (cfg n' r' (tl t' R)) := by
  induction k with
  | zero =>
    intro n r t n' r' t' s h R
    simp only [phaseRun, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨⟨rfl, rfl, rfl⟩, rfl⟩ := h
    rfl
  | succ k ih =>
    intro n r t n' r' t' s h R
    simp only [phaseRun] at h
    cases hp : phase (n, r, t) with
    | none => rw [hp] at h; simp at h
    | some y =>
      obtain ⟨n1, r1, t1⟩ := y
      cases hk : phaseRun k (n1, r1, t1) with
      | none => simp [hp, hk] at h
      | some z =>
        obtain ⟨⟨n2, r2, t2⟩, s2⟩ := z
        simp only [hp, hk, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
        obtain ⟨⟨rfl, rfl, rfl⟩, rfl⟩ := h
        exact steps_seq trans (phase_spec hp R) (ih hk R)

/-- While t ≥ 4k (and r < 5, n ≥ 1) the map runs k phases: the run is a theorem for that long. -/
theorem phaseRun_some (k : Nat) : ∀ {n r t : Nat}, r < 5 → 1 ≤ n → 4 * k ≤ t →
    ∃ y s, phaseRun k (n, r, t) = some (y, s) := by
  induction k with
  | zero => intro n r t _ _ _; exact ⟨_, _, rfl⟩
  | succ k ih =>
    intro n r t hr hn ht
    obtain ⟨n', r', t', hp, hr', hn', ht'⟩ := phase_some (t := t) hr hn (by omega)
    obtain ⟨y, s, hy⟩ := ih (n := n') (r := r') (t := t') hr' (by omega) (by omega)
    exact ⟨y, phaseSteps (n, r, t) + s, by simp [phaseRun, hp, hy]⟩

/-- The first five phase ends after the tail of 6805 words, as in README.md (m7map.py: steps 374,475,636 to
381,184,262). -/
theorem run_from_17 : phaseRun 5 (17, 0, 6805) = some ((910, 0, 6790), 6708626) := by decide

/-- From the phase end (17, 0, 6805) the map runs 2177 phases (n grows to 772 digits, about 10^1541 steps) to a phase
end with r = 3 and t = 0, where the table stops (the next reset reads past the words 1110 into R). -/
theorem level1_end : (phaseRun 2177 (17, 0, 6805)).map (fun x => (x.1.2.1, x.1.2.2)) = some (3, 0) := by decide

theorem level1_end' : ∃ n s, phaseRun 2177 (17, 0, 6805) = some ((n, 3, 0), s) ∧
    ∀ R, steps s (cfg 17 0 (tl 6805 R)) = some (cfg n 3 (tl 0 R)) := by
  have h := level1_end
  cases hk : phaseRun 2177 (17, 0, 6805) with
  | none => rw [hk] at h; simp at h
  | some y =>
    obtain ⟨⟨n, r, t⟩, s⟩ := y
    rw [hk] at h
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨n, s, rfl, phaseRun_spec 2177 hk⟩

end H66813
