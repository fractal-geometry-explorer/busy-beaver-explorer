import Resets
import TailResetRules

/-!
# 1RB1LC_1RC0RF_1RD0LB_1RE0LD_1LF---_0RA1LA: the run from blank tape, as a theorem, to the start of level 2

The resets at a nearly empty tail that the run goes through (`TailResetRules.lean`, generated by `tailresets.py`)
are restated in the `cfg` form, for every n:

* with the tail `1001` (`tl 0 s0`, before the long tail exists): r = 0 sends (n, 0) to the new phase
  (10, floor(n/2) - 1), r = 2 sends (n, 2) to (10, ceil(n/2) + 6), both keeping the tail `1001`; r = 1 sends (n, 1)
  to (17, 0) with the tail `1 0 (1110)^(n+6) 1` (`tl (n+6) s1`): the long tail of level 1;
* at the end of level 1, (n, 3) with the tail `1 0 1` (`tl 0 s1`) goes to (17, 0) with the tail
  `1 0 (1110)^(n+20) 1001101011001` (`tl (n+20) s2`): the start of level 2.

`blank_to_17`: from blank tape the machine reaches `cfg 17 0 (tl 6805 s1)` at step 374,475,636 (7106 steps by
`decide`, then five phases of the tail `1001` and the reset that builds the tail of 6805 words).  With `level1_end'`
of `Resets.lean` and `level2_entry`, `blank_to_level2`: from blank tape the machine reaches, without halting, the
record `cfg 17 0 (tl (N + 20) s2)` with N the 772-digit n of the end of level 1 (N = 63 mod 100, 10^771 ≤ N), the
first configuration of level 2.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 100000
set_option exponentiation.threshold 2000

namespace H66813

open TM

/-- The tail `1001` before the long tail exists is `tl 0 s0`: `1 0 | 0 1 0^inf`. -/
def s0 : Tape := cons false (cons true blank)
/-- The suffix of level 1: `tl t s1` = `1 0 (1110)^t 1 0^inf`. -/
def s1 : Tape := cons true blank
/-- The suffix of level 2: `tl t s2` = `1 0 (1110)^t 1001101011001 0^inf`. -/
def s2 : Tape := app [true, false, false, true, true, false, true, false, true, true, false, false, true] blank

/-! ## The resets at a nearly empty tail, in `cfg` form -/

theorem tail0_even (a : Nat) :
    steps (110 * a + 950) (cfg (2 * a + 2) 0 (tl 0 s0)) = some (cfg 10 a (tl 0 s0)) := by
  have h := tail0_even_raw a
  simp only [cfg, tl, s0, rep_zero]
  rw [show 2 * a + 2 = 2 * (a + 1) by omega, rep_two_mul]
  exact h

theorem tail0_odd (a : Nat) :
    steps (110 * a + 960) (cfg (2 * a + 3) 0 (tl 0 s0)) = some (cfg 10 a (tl 0 s0)) := by
  have h := tail0_odd_raw a
  simp only [cfg, tl, s0, rep_zero]
  rw [show 2 * a + 3 = 2 * (a + 1) + 1 by omega, rep_succ, rep_two_mul]
  exact h

theorem tail2_even (a : Nat) :
    steps (590 * a + 3703) (cfg (2 * a) 2 (tl 0 s0)) = some (cfg 10 (a + 6) (tl 0 s0)) := by
  have h := tail2_even_raw a
  simp only [cfg, tl, s0, rep_zero]
  rw [rep_two_mul, show a + 6 = 6 + a by omega, rep_add]
  exact h

theorem tail2_odd (a : Nat) :
    steps (590 * a + 4043) (cfg (2 * a + 1) 2 (tl 0 s0)) = some (cfg 10 (a + 7) (tl 0 s0)) := by
  have h := tail2_odd_raw a
  simp only [cfg, tl, s0, rep_zero]
  rw [rep_succ, rep_two_mul, show a + 7 = 7 + a by omega, rep_add]
  exact h

theorem tail1 (n : Nat) :
    steps (200 * n + 4132) (cfg n 1 (tl 0 s0)) = some (cfg 17 0 (tl (n + 6) s1)) := by
  have h := tail1_raw n
  have e : cons true (rep n [true, true, false, true] (cons true (cons true (cons false (cons true blank)))))
      = rep n [true, true, true, false] (app [true, true, true, false] (cons true blank)) :=
    rep_rotate n [true] [true, true, false, true] [true, true, true, false] rfl _
  rw [e, rep_app_comm] at h
  simp only [cfg, tl, s0, s1, rep_zero]
  rw [show n + 6 = 5 + (n + 1) by omega, rep_add]
  exact h

theorem level2_entry (n : Nat) :
    steps (440 * n + 9367) (cfg n 3 (tl 0 s1)) = some (cfg 17 0 (tl (n + 20) s2)) := by
  have h := level2_entry_raw n
  have e : cons true (rep n [true, true, false, true] (app [false, false, true, true, false, true, false, true,
        true, false, false, true] blank))
      = rep n [true, true, true, false] (cons true (app [false, false, true, true, false, true, false, true,
        true, false, false, true] blank)) :=
    rep_rotate n [true] [true, true, false, true] [true, true, true, false] rfl _
  simp only [app_cons, app_nil] at e
  rw [e] at h
  simp only [cfg, tl, s1, s2, rep_zero, app_cons, app_nil]
  rw [show n + 20 = 20 + n by omega, rep_add]
  exact h

/-! ## From blank tape to (17, 0, 6805) -/

/-- The first 7106 steps (by `decide`, on the list simulator): the record (10, 10) with the tail `1001`. -/
theorem blank_prefix : steps 7106 init = some (cfg 10 10 (tl 0 s0)) := by
  have h : fsteps 7106 (FCfg.blank .A) = some ⟨[], [false, false, true] ++
      (List.replicate 10 [true, true, false, false]).flatten ++
      (List.replicate 10 [true, false, true, true, false, true, true, false]).flatten ++ [true, false, false, true],
      .B⟩ := by decide
  exact blank_reaches trans h

theorem periods_s (q n m : Nat) (R : Tape) :
    steps (periodSteps q n) (cfg n (m + 5 * q) R) = some (cfg (n + 31 * q) m R) := periods_exact q n m R

/-- From blank tape to the phase end (17, 0, 6805) with the tail `1 0 (1110)^6805 1 0^inf`, in 374,475,636 steps:
five phases with the tail `1001` (ends (72, 0), (227, 0), (692, 2), (2180, 2), (6799, 1)) and the reset of
(6799, 1), which builds the tail of 6805 words. -/
theorem blank_to_17 : steps 374475636 init = some (cfg 17 0 (tl 6805 s1)) := by
  have h1 := periods_s 2 10 0 (tl 0 s0)                  -- (10, 10) -> (72, 0)
  have h2 := tail0_even 35                               -- (72, 0) -> (10, 35)
  have h3 := periods_s 7 10 0 (tl 0 s0)                  -- -> (227, 0)
  have h4 := tail0_odd 112                               -- (227, 0) -> (10, 112)
  have h5 := periods_s 22 10 2 (tl 0 s0)                 -- -> (692, 2)
  have h6 := tail2_even 346                              -- (692, 2) -> (10, 352)
  have h7 := periods_s 70 10 2 (tl 0 s0)                 -- -> (2180, 2)
  have h8 := tail2_even 1090                             -- (2180, 2) -> (10, 1096)
  have h9 := periods_s 219 10 1 (tl 0 s0)                -- -> (6799, 1)
  have h10 := tail1 6799                                 -- (6799, 1) -> (17, 0, 6805)
  have e : 7106 + (periodSteps 2 10 + ((110 * 35 + 950) + (periodSteps 7 10 + ((110 * 112 + 960) +
      (periodSteps 22 10 + ((590 * 346 + 3703) + (periodSteps 70 10 + ((590 * 1090 + 3703) +
      (periodSteps 219 10 + (200 * 6799 + 4132)))))))))) = 374475636 := by decide
  exact steps_congr trans e (steps_seq trans blank_prefix (steps_seq trans h1 (steps_seq trans h2
    (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7
    (steps_seq trans h8 (steps_seq trans h9 h10))))))))))

/-! ## To the end of level 1 and the start of level 2 -/

/-- The end of level 1, with what level 2 needs of n: odd, = 63 mod 100, and 772 digits. -/
theorem level1_end_info : (phaseRun 2177 (17, 0, 6805)).map (fun x => (x.1.2.1, x.1.2.2, x.1.1 % 100,
    decide (10 ^ 771 ≤ x.1.1), decide (x.1.1 < 10 ^ 772), decide (10 ^ 1543 ≤ x.2))) =
    some (3, 0, 63, true, true, true) := by decide

/-- From blank tape the machine reaches, without halting, the first record of level 2: `cfg 17 0 (tl (N + 20) s2)`
= `0^inf B> 0 0 1 (1100)^17 1 0 (1110)^(N+20) 1001101011001 0^inf`, with N the n at which level 1 ends after 2177
phases (N = 63 mod 100, 772 digits), after more than 10^1543 steps. -/
theorem blank_to_level2 : ∃ N s, N % 100 = 63 ∧ 10 ^ 771 ≤ N ∧ N < 10 ^ 772 ∧ 10 ^ 1543 ≤ s ∧
    steps s init = some (cfg 17 0 (tl (N + 20) s2)) := by
  have hi := level1_end_info
  cases hk : phaseRun 2177 (17, 0, 6805) with
  | none => rw [hk] at hi; simp at hi
  | some y =>
    obtain ⟨⟨N, r, t⟩, s⟩ := y
    rw [hk] at hi
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq, decide_eq_true_eq] at hi
    obtain ⟨rfl, rfl, h63, hlo, hhi, hs⟩ := hi
    have h := phaseRun_spec 2177 hk s1
    exact ⟨N, 374475636 + (s + (440 * N + 9367)), h63, hlo, hhi, by omega,
      steps_seq trans blank_to_17 (steps_seq trans h (level2_entry N))⟩

end H66813
