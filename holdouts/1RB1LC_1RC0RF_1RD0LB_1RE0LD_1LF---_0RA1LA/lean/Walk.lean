theorem nearL_good (s : Suf) (r t N : Nat) (hr : r < 5) (ht : t < need r) (hN : 2 ≤ N) :
    Good (N, r, .long s t) (nearL s r t N) := by
  match s, r, t, hr, ht with
  | .s1, 0, 0, _, _ => exact row_s1_0_0_good N hN
  | .s1, 0, 1, _, _ => exact row_s1_1_0_good N hN
  | .s1, 0, 2, _, _ => exact row_s1_2_0_good N hN
  | .s1, 0, 3, _, _ => exact row_s1_3_0_good N hN
  | .s1, 0, t + 4, _, ht => simp only [need] at ht; omega
  | .s1, 1, 0, _, _ => exact row_s1_0_1_good N hN
  | .s1, 1, t + 1, _, ht => simp only [need] at ht; omega
  | .s1, 2, 0, _, _ => exact row_s1_0_2_good N hN
  | .s1, 2, 1, _, _ => exact row_s1_1_2_good N hN
  | .s1, 2, 2, _, _ => exact row_s1_2_2_good N hN
  | .s1, 2, 3, _, _ => exact row_s1_3_2_good N hN
  | .s1, 2, t + 4, _, ht => simp only [need] at ht; omega
  | .s1, 3, 0, _, _ => exact row_s1_0_3_good N hN
  | .s1, 3, 1, _, _ => exact row_s1_1_3_good N hN
  | .s1, 3, 2, _, _ => exact row_s1_2_3_good N hN
  | .s1, 3, t + 3, _, ht => simp only [need] at ht; omega
  | .s1, 4, 0, _, _ => exact row_s1_0_4_good N hN
  | .s1, 4, 1, _, _ => exact row_s1_1_4_good N hN
  | .s1, 4, t + 2, _, ht => simp only [need] at ht; omega
  | .s2, 0, 0, _, _ => exact row_s2_0_0_good N hN
  | .s2, 0, 1, _, _ => exact row_s2_1_0_good N hN
  | .s2, 0, 2, _, _ => exact row_s2_2_0_good N hN
  | .s2, 0, 3, _, _ => exact row_s2_3_0_good N hN
  | .s2, 0, t + 4, _, ht => simp only [need] at ht; omega
  | .s2, 1, 0, _, _ => exact row_s2_0_1_good N hN
  | .s2, 1, t + 1, _, ht => simp only [need] at ht; omega
