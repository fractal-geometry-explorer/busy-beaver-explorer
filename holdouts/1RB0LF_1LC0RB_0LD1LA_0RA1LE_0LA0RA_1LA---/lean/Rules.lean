/-- The only way to a halt: A on a 1 with a 1 to its left reaches F on a 1 (which halts) in 1 step. -/
theorem halt_shape (L R : Tape) :
    steps (1) ⟨cons true (L), cons true (R), .A⟩ = some ⟨L, cons true (cons false (R)), .F⟩ := by
  have h0 : steps 1 ⟨cons true (L), cons true (R), .A⟩ = some ⟨L, cons true (cons false (R)), .F⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

/-- F reading a 1 halts (the end of `halt_shape`). -/
theorem halt_after_shape (L R : Tape) : step ⟨L, cons true R, .F⟩ = none := rfl

