theorem b_run (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨cons false (cons false (L)), rep (n) [false, true] (R), .B⟩ = some ⟨cons false (cons false (rep (n) [true, false] (L))), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 6 ⟨app [false, false] L, app [false, true] R, .B⟩ = some ⟨app [false, false] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
