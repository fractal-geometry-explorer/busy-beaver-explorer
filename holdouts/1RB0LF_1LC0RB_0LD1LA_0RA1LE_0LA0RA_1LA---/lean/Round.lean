import Rules
import Conv

/-!
# 1RB0LF_1LC0RB_0LD1LA_0RA1LE_0LA0RA_1LA---: the round map, proved for four branches

Hand-written; it chains `sweep` (`Rules.lean`) and the rules of `Conv.lean` (generated by `py/round.py` with
`bbtools.symtm`).

`RS N T` is a round start: the head in state A on the leftmost cell of `(10)^4 110 (10)^N 10010 T` (blank tape to the
left; the tail `T` ends in blank tape). One round:

* `sweep0`: the first sweep, `(10)^4 110 (10)^N 10010 T → (10)^7 110 (10)^(N-2) 10010 110 T`;
* `sweeps`: the counting phase, `sweep` used k times: `CF a (x + 2k) c R → CF (a + 3k) x (c + k) R` where
  `CF a x c R = (10)^(a+1) 110 (10)^x 10010 (110)^(c+1) R`, in `k (14a + 8x + 83) + 58 k(k-1)/2` steps;
* a conversion (`conv*`), one symbolic run that turns the `(110)^(c+1)` back into pairs and starts the next round.

Proved branches, for all `j` (and all `m`):

* `round_A`: `RS (4j+5) Ts      → RS (6j+10) (Tl (3j+6))`
* `round_B`: `RS (4j+2) (Tl m)  → RS (9j+m+27) Ts`
* `round_C`: `RS (4j+4) Ts      → RS (9j+33) Ts`
* `round_D`: `RS (4j+4) (Tl m)  → RS (6j+11) (TD (3j+m+5))`

with the short tail `Ts = (10)^11 1`, the long tail `Tl m = (10)^m 1 (10)^11 0101` and `TD p = 1 (10)^p 1 (10)^9 0101101`.
From blank tape the machine reaches `RS 13 Ts` in 1817 steps (`first`), and these four branches carry it through
ten more rounds to `RS 19199 (TD 15998)` at step 1,842,640,229 (`reach_19199`): no halt before.
-/

namespace H9146

open TM

theorem steps_conv {n : Nat} {a a' b b' : Config} (h : steps n a = some b) (ha : a' = a) (hb : b = b') :
    steps n a' = some b' := by
  subst ha; subst hb; exact h

/-- `n (n - 1) / 2`. -/
def tri (n : Nat) : Nat := n * (n - 1) / 2

theorem tri_succ (n : Nat) : tri (n + 1) = tri n + n := by
  unfold tri
  cases n with
  | zero => rfl
  | succ n =>
    rw [show n + 1 + 1 - 1 = n + 1 by omega, show n + 1 - 1 = n by omega, Nat.succ_mul, Nat.mul_succ]
    omega

/-! ## Writing the same tape two ways -/

theorem push (n : Nat) (w : List Bool) (s : Tape) : rep n w (app w s) = app w (rep n w s) := by
  rw [rep_app_comm]; rfl
theorem push_tf (n : Nat) (s : Tape) :
    rep n [true, false] (cons true (cons false s)) = cons true (cons false (rep n [true, false] s)) := push n _ s
theorem push_ttf (n : Nat) (s : Tape) :
    rep n [true, true, false] (cons true (cons true (cons false s))) =
      cons true (cons true (cons false (rep n [true, true, false] s))) := push n _ s
theorem rot_ft0 (n : Nat) (s : Tape) : rep n [false, true] (cons false s) = cons false (rep n [true, false] s) :=
  (rep_rotate n [false] [true, false] [false, true] rfl s).symm
theorem rot_ft1 (n : Nat) (s : Tape) : cons true (rep n [false, true] s) = rep n [true, false] (cons true s) :=
  rep_rotate n [true] [false, true] [true, false] rfl s
theorem tf3 (n : Nat) (s : Tape) : rep n [true, false, true, false, true, false] s = rep (3 * n) [true, false] s := by
  induction n with
  | zero => rfl
  | succ n ih => rw [show 3 * (n + 1) = 3 * n + 1 + 1 + 1 by omega, rep_succ, ih]; rfl
theorem ft3 (n : Nat) (s : Tape) : rep n [false, true, false, true, false, true] s = rep (3 * n) [false, true] s := by
  induction n with
  | zero => rfl
  | succ n ih => rw [show 3 * (n + 1) = 3 * n + 1 + 1 + 1 by omega, rep_succ, ih]; rfl
theorem ttf2 (n : Nat) (s : Tape) : rep n [true, true, false, true, true, false] s = rep (2 * n) [true, true, false] s := by
  induction n with
  | zero => rfl
  | succ n ih => rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, ih]; rfl
theorem merge (a b : Nat) (w : List Bool) (s : Tape) : rep a w (rep b w s) = rep (a + b) w s := (rep_add a b w s).symm

/-- A normal form for tapes made of `10`, `01`, `110` runs: constants peeled, literal copies pushed in front of the
runs, `01` runs turned into `10` runs, runs of one word merged. -/
macro "tf_norm" : tactic => `(tactic| simp only [rep_succ, app_cons, app_nil, rep_zero, push_tf, push_ttf, rot_ft0,
  rot_ft1, tf3, ft3, ttf2, merge, Nat.add_zero])

/-- `tf_norm`, then the counts compared by `omega`. -/
macro "tf_eq" : tactic => `(tactic| (tf_norm; try simp +arith only []))

/-! ## Round starts and the counting phase -/

/-- A round start `A> (10)^4 110 (10)^N 10010 T` on blank tape to the left. -/
def RS (N : Nat) (T : Tape) : Config := ⟨blank, rep (4) [true, false] (cons true (cons true (cons false (rep (N) [true, false] (cons true (cons false (cons false (cons true (cons false (T)))))))))), .A⟩
/-- The short tail `(10)^11 1`. -/
def Ts : Tape := rep (11) [true, false] (cons true (blank))
/-- The long tail `(10)^m 1 (10)^11 0101`. -/
def Tl (m : Nat) : Tape := rep (m) [true, false] (cons true (rep (11) [true, false] (cons false (cons true (cons false (cons true (blank)))))))
/-- The tail `1 (10)^p 1 (10)^9 0101101` (after `round_D`). -/
def TD (p : Nat) : Tape := cons true (rep (p) [true, false] (cons true (rep (9) [true, false] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (blank)))))))))))
/-- The counting phase `A> (10)^(a+1) 110 (10)^x 10010 (110)^(c+1) R`. -/
def CF (a x c : Nat) (R : Tape) : Config := ⟨blank, rep (a+1) [true, false] (cons true (cons true (cons false (rep (x) [true, false] (cons true (cons false (cons false (cons true (cons false (rep (c+1) [true, true, false] (R))))))))))), .A⟩

theorem sweep' (a b c : Nat) (R : Tape) :
    steps (14 * a + 8 * b + 83) (CF a (b + 2) c R) = some (CF (a + 3) b (c + 1) R) :=
  steps_conv (sweep a b c R) (by simp only [CF]) (by simp only [CF]; tf_eq)

theorem sweeps_count (k a x : Nat) :
    (14 * a + 8 * (x + 2 * k) + 83) + (k * (14 * (a + 3) + 8 * x + 83) + 58 * tri k)
      = (k + 1) * (14 * a + 8 * x + 83) + 58 * tri (k + 1) := by
  simp only [tri_succ, Nat.mul_add, Nat.add_mul, Nat.one_mul, Nat.mul_one]
  simp only [Nat.mul_comm k, Nat.mul_assoc, Nat.mul_left_comm]
  omega

/-- The counting phase: `sweep` used `k` times. -/
theorem sweeps (x : Nat) (R : Tape) (k : Nat) : ∀ a c,
    steps (k * (14 * a + 8 * x + 83) + 58 * tri k) (CF a (x + 2 * k) c R) = some (CF (a + 3 * k) x (c + k) R) := by
  induction k with
  | zero => intro a c; simp [tri]
  | succ k ih =>
    intro a c
    have h1 := sweep' a (x + 2 * k) c R
    have h2 := ih (a + 3) (c + 1)
    rw [show a + 3 + 3 * k = a + 3 * (k + 1) by omega, show c + 1 + k = c + (k + 1) by omega] at h2
    rw [← sweeps_count k a x, show x + 2 * (k + 1) = x + 2 * k + 2 by omega]
    exact steps_seq trans h1 h2

theorem sweep0' (b : Nat) (T : Tape) : steps (8 * b + 125) (RS (b + 2) T) = some (CF 6 b 0 T) :=
  steps_conv (sweep0 b T) (by simp only [RS]) (by simp only [CF]; tf_eq)

/-! ## Four branches of the round map -/

theorem round_A (j : Nat) :
    steps ((8 * (4 * j + 3) + 125) + (((2 * j + 1) * (14 * 6 + 8 * 1 + 83) + 58 * tri (2 * j + 1)) + (210 * j + 674)))
      (RS (4 * j + 5) Ts) = some (RS (6 * j + 10) (Tl (3 * j + 6))) := by
  have h1 := sweep0' (4 * j + 3) Ts
  have h2 := sweeps 1 Ts (2 * j + 1) 6 0
  rw [show 1 + 2 * (2 * j + 1) = 4 * j + 3 by omega, show 6 + 3 * (2 * j + 1) = 6 * j + 9 by omega,
    show 0 + (2 * j + 1) = 2 * j + 1 by omega] at h2
  have h3 := steps_conv (convA j) (a' := CF (6 * j + 9) 1 (2 * j + 1) Ts) (b' := RS (6 * j + 10) (Tl (3 * j + 6)))
    (by simp only [CF, Ts]; tf_eq) (by simp only [RS, Tl]; tf_eq)
  exact steps_seq trans h1 (steps_seq trans h2 h3)

theorem round_B (j m : Nat) :
    steps ((8 * (4 * j) + 125) + (((2 * j) * (14 * 6 + 8 * 0 + 83) + 58 * tri (2 * j)) + (846 * j + 86 * m + 2761)))
      (RS (4 * j + 2) (Tl m)) = some (RS (9 * j + m + 27) Ts) := by
  have h1 := sweep0' (4 * j) (Tl m)
  have h2 := sweeps 0 (Tl m) (2 * j) 6 0
  rw [show 0 + 2 * (2 * j) = 4 * j by omega, show 6 + 3 * (2 * j) = 6 * j + 6 by omega,
    show 0 + 2 * j = 2 * j by omega] at h2
  have h3 := steps_conv (convB j m) (a' := CF (6 * j + 6) 0 (2 * j) (Tl m)) (b' := RS (9 * j + m + 27) Ts)
    (by simp only [CF, Tl]; tf_eq) (by simp only [RS, Ts]; tf_eq)
  exact steps_seq trans h1 (steps_seq trans h2 h3)

theorem round_C (j : Nat) :
    steps ((8 * (4 * j + 2) + 125) + (((2 * j + 1) * (14 * 6 + 8 * 0 + 83) + 58 * tri (2 * j + 1)) + (972 * j + 3712)))
      (RS (4 * j + 4) Ts) = some (RS (9 * j + 33) Ts) := by
  have h1 := sweep0' (4 * j + 2) Ts
  have h2 := sweeps 0 Ts (2 * j + 1) 6 0
  rw [show 0 + 2 * (2 * j + 1) = 4 * j + 2 by omega, show 6 + 3 * (2 * j + 1) = 6 * j + 9 by omega,
    show 0 + (2 * j + 1) = 2 * j + 1 by omega] at h2
  have h3 := steps_conv (convC j) (a' := CF (6 * j + 9) 0 (2 * j + 1) Ts) (b' := RS (9 * j + 33) Ts)
    (by simp only [CF, Ts]; tf_eq) (by simp only [RS, Ts]; tf_eq)
  exact steps_seq trans h1 (steps_seq trans h2 h3)

theorem round_D (j m : Nat) :
    steps ((8 * (4 * j + 2) + 125) + (((2 * j + 1) * (14 * 6 + 8 * 0 + 83) + 58 * tri (2 * j + 1))
      + (210 * j + 14 * m + 654)))
      (RS (4 * j + 4) (Tl m)) = some (RS (6 * j + 11) (TD (3 * j + m + 5))) := by
  have h1 := sweep0' (4 * j + 2) (Tl m)
  have h2 := sweeps 0 (Tl m) (2 * j + 1) 6 0
  rw [show 0 + 2 * (2 * j + 1) = 4 * j + 2 by omega, show 6 + 3 * (2 * j + 1) = 6 * j + 9 by omega,
    show 0 + (2 * j + 1) = 2 * j + 1 by omega] at h2
  have h3 := steps_conv (convD j m) (a' := CF (6 * j + 9) 0 (2 * j + 1) (Tl m)) (b' := RS (6 * j + 11) (TD (3 * j + m + 5)))
    (by simp only [CF, Tl]; tf_eq) (by simp only [RS, TD]; tf_eq)
  exact steps_seq trans h1 (steps_seq trans h2 h3)

/-! ## From blank tape through eleven rounds -/

theorem first' : steps 1817 init = some (RS 13 Ts) :=
  steps_conv first rfl (by simp only [RS, Ts]; tf_eq)

/-- From blank tape the machine reaches the round start `RS 19199 (TD 15998)` in exactly 1,842,640,229 steps,
through the rounds N = 13, 22, 84, 213, 322, 909, 1366, 3780, 8529, 12796 (branches A B C A B A B C A D). -/
theorem reach_19199 : steps 1842640229 init = some (RS 19199 (TD 15998)) := by
  have h := steps_seq trans first' (steps_seq trans (round_A 2) (steps_seq trans (round_B 5 12)
    (steps_seq trans (round_C 20) (steps_seq trans (round_A 52) (steps_seq trans (round_B 80 162)
    (steps_seq trans (round_A 226) (steps_seq trans (round_B 341 684) (steps_seq trans (round_C 944)
    (steps_seq trans (round_A 2131) (round_D 3198 6399))))))))))
  exact steps_congr trans (by simp only [tri]) h

/-- No halt in the first 1,842,640,229 steps from blank tape. -/
theorem no_halt_1842640229 : ∃ c, steps 1842640229 init = some c := ⟨_, reach_19199⟩

end H9146
