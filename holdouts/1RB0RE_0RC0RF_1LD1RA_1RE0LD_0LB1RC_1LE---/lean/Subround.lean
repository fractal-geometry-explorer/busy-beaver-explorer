/-- Sub-round from a single block 3(k + 1) with last block b + 5 >= 5: the block becomes 3 2^k, the last block 5, and a new zone gap b + 1. -/
theorem single (b k : Nat) (R : Tape) :
    steps (b + 12 * k + 33) ⟨rep (b + 5) [true] (cons false (rep (k + 1) [true, true, true] (blank))), cons false (R), .C⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (rep (k + 1) [false, true, true] (cons true (blank))))))), rep (b + 1) [false] (cons true (R)), .C⟩ := by
  have hn : 1 + ((b + 4) * 1 + (2 + (0 + ((k + 1) * 9 + (7 + (0 + ((k + 1) * 3 + (7)))))))) = b + 12 * k + 33 := by omega
  have h0 : steps 1 ⟨rep (b + 5) [true] (cons false (rep (k + 1) [true, true, true] (blank))), cons false (R), .C⟩ = some ⟨rep (b + 4) [true] (cons false (rep (k + 1) [true, true, true] (blank))), cons true (cons true (R)), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((b + 4) * 1) ⟨rep (b + 4) [true] (cons false (rep (k + 1) [true, true, true] (blank))), cons true (cons true (R)), .D⟩ = some ⟨cons false (rep (k + 1) [true, true, true] (blank)), cons true (rep (b + 4) [false] (cons true (R))), .D⟩ :=
    cross_l trans c1 (b + 4) (cons false (rep (k + 1) [true, true, true] (blank))) (cons true (R))
  have h2 : steps 2 ⟨cons false (rep (k + 1) [true, true, true] (blank)), cons true (rep (b + 4) [false] (cons true (R))), .D⟩ = some ⟨cons true (rep (k + 1) [true, true, true] (blank)), cons false (rep (b + 4) [false] (cons true (R))), .E⟩ := rfl
  have h3 : steps 0 ⟨cons true (rep (k + 1) [true, true, true] (blank)), cons false (rep (b + 4) [false] (cons true (R))), .E⟩ = some ⟨rep (k + 1) [true, true, true] (cons true (blank)), cons false (rep (b + 4) [false] (cons true (R))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (k + 1) [true, true, true] (blank)) = rep (k + 1) [true, true, true] (cons true (blank)) from
      rep_rotate (k + 1) [true] [true, true, true] [true, true, true] rfl (blank)]
  have c4 : ∀ L R : Tape, steps 9 ⟨app [true, true, true] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [true, true, true] R), .E⟩ := fun _ _ => rfl
  have h4 : steps ((k + 1) * 9) ⟨rep (k + 1) [true, true, true] (cons true (blank)), cons false (rep (b + 4) [false] (cons true (R))), .E⟩ = some ⟨cons true (blank), cons false (rep (k + 1) [true, true, true] (rep (b + 4) [false] (cons true (R)))), .E⟩ :=
    cross_l trans c4 (k + 1) (cons true (blank)) (rep (b + 4) [false] (cons true (R)))
  have h5 : steps 7 ⟨cons true (blank), cons false (rep (k + 1) [true, true, true] (rep (b + 4) [false] (cons true (R)))), .E⟩ = some ⟨cons true (blank), cons true (cons true (rep (k + 1) [true, true, true] (rep (b + 4) [false] (cons true (R))))), .E⟩ := rfl
  have h6 : steps 0 ⟨cons true (blank), cons true (cons true (rep (k + 1) [true, true, true] (rep (b + 4) [false] (cons true (R))))), .E⟩ = some ⟨cons true (blank), rep (k + 1) [true, true, true] (cons true (cons true (rep (b + 4) [false] (cons true (R))))), .E⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (k + 1) [true, true, true] (rep (b + 4) [false] (cons true (R))))) = rep (k + 1) [true, true, true] (cons true (cons true (rep (b + 4) [false] (cons true (R))))) from
      rep_rotate (k + 1) [true, true] [true, true, true] [true, true, true] rfl (rep (b + 4) [false] (cons true (R)))]
  have c7 : ∀ L R : Tape, steps 3 ⟨app [] L, app [true, true, true] R, .E⟩ = some ⟨app [] (app [false, true, true] L), R, .E⟩ := fun _ _ => rfl
  have h7 : steps ((k + 1) * 3) ⟨cons true (blank), rep (k + 1) [true, true, true] (cons true (cons true (rep (b + 4) [false] (cons true (R))))), .E⟩ = some ⟨rep (k + 1) [false, true, true] (cons true (blank)), cons true (cons true (rep (b + 4) [false] (cons true (R)))), .E⟩ :=
    cross_r trans c7 (k + 1) (cons true (blank)) (cons true (cons true (rep (b + 4) [false] (cons true (R)))))
  have h8 : steps 7 ⟨rep (k + 1) [false, true, true] (cons true (blank)), cons true (cons true (rep (b + 4) [false] (cons true (R)))), .E⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (rep (k + 1) [false, true, true] (cons true (blank))))))), rep (b + 1) [false] (cons true (R)), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))


/-- Sub-round from a single block 3(k + 1) with last block 1 and a first zone gap of at least 3 cells: the block becomes 3 2^k, the last block 4, and the first gap loses 2. -/
theorem singleone (k : Nat) (R : Tape) :
    steps (12 * k + 30) ⟨cons true (cons false (rep (k + 1) [true, true, true] (blank))), cons false (cons false (cons false (R))), .C⟩ = some ⟨cons true (cons true (cons true (cons true (rep (k + 1) [false, true, true] (cons true (blank)))))), cons false (R), .C⟩ := by
  have hn : 3 + (0 + ((k + 1) * 9 + (7 + (0 + ((k + 1) * 3 + (8)))))) = 12 * k + 30 := by omega
  have h0 : steps 3 ⟨cons true (cons false (rep (k + 1) [true, true, true] (blank))), cons false (cons false (cons false (R))), .C⟩ = some ⟨cons true (rep (k + 1) [true, true, true] (blank)), cons false (cons true (cons false (cons false (R)))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (k + 1) [true, true, true] (blank)), cons false (cons true (cons false (cons false (R)))), .E⟩ = some ⟨rep (k + 1) [true, true, true] (cons true (blank)), cons false (cons true (cons false (cons false (R)))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (k + 1) [true, true, true] (blank)) = rep (k + 1) [true, true, true] (cons true (blank)) from
      rep_rotate (k + 1) [true] [true, true, true] [true, true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 9 ⟨app [true, true, true] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [true, true, true] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((k + 1) * 9) ⟨rep (k + 1) [true, true, true] (cons true (blank)), cons false (cons true (cons false (cons false (R)))), .E⟩ = some ⟨cons true (blank), cons false (rep (k + 1) [true, true, true] (cons true (cons false (cons false (R))))), .E⟩ :=
    cross_l trans c2 (k + 1) (cons true (blank)) (cons true (cons false (cons false (R))))
  have h3 : steps 7 ⟨cons true (blank), cons false (rep (k + 1) [true, true, true] (cons true (cons false (cons false (R))))), .E⟩ = some ⟨cons true (blank), cons true (cons true (rep (k + 1) [true, true, true] (cons true (cons false (cons false (R)))))), .E⟩ := rfl
  have h4 : steps 0 ⟨cons true (blank), cons true (cons true (rep (k + 1) [true, true, true] (cons true (cons false (cons false (R)))))), .E⟩ = some ⟨cons true (blank), rep (k + 1) [true, true, true] (cons true (cons true (cons true (cons false (cons false (R)))))), .E⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (k + 1) [true, true, true] (cons true (cons false (cons false (R)))))) = rep (k + 1) [true, true, true] (cons true (cons true (cons true (cons false (cons false (R)))))) from
      rep_rotate (k + 1) [true, true] [true, true, true] [true, true, true] rfl (cons true (cons false (cons false (R))))]
  have c5 : ∀ L R : Tape, steps 3 ⟨app [] L, app [true, true, true] R, .E⟩ = some ⟨app [] (app [false, true, true] L), R, .E⟩ := fun _ _ => rfl
  have h5 : steps ((k + 1) * 3) ⟨cons true (blank), rep (k + 1) [true, true, true] (cons true (cons true (cons true (cons false (cons false (R)))))), .E⟩ = some ⟨rep (k + 1) [false, true, true] (cons true (blank)), cons true (cons true (cons true (cons false (cons false (R))))), .E⟩ :=
    cross_r trans c5 (k + 1) (cons true (blank)) (cons true (cons true (cons true (cons false (cons false (R))))))
  have h6 : steps 8 ⟨rep (k + 1) [false, true, true] (cons true (blank)), cons true (cons true (cons true (cons false (cons false (R))))), .E⟩ = some ⟨cons true (cons true (cons true (cons true (rep (k + 1) [false, true, true] (cons true (blank)))))), cons false (R), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


end H4320
