/-- A on 010 after an open block of o: the block moves right, the block before it grows by 3. -/
theorem azoz (o : Nat) (L R : Tape) :
    steps (3 * o + 12) ⟨rep (o) [true] (cons false (L)), cons false (cons true (cons false (R))), .A⟩ = some ⟨cons true (cons true (cons true (L))), rep (o) [true] (cons true (R)), .A⟩ := by
  have hn : 4 + ((o) * 3 + (8)) = 3 * o + 12 := by omega
  have h0 : steps 4 ⟨rep (o) [true] (cons false (L)), cons false (cons true (cons false (R))), .A⟩ = some ⟨rep (o) [true] (cons false (L)), cons true (cons false (cons true (R))), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true, false] R, .B⟩ = some ⟨L, app [true, false] (app [true] R), .B⟩ := fun _ _ => rfl
  have h1 : steps ((o) * 3) ⟨rep (o) [true] (cons false (L)), cons true (cons false (cons true (R))), .B⟩ = some ⟨cons false (L), cons true (cons false (rep (o) [true] (cons true (R)))), .B⟩ :=
    cross_l trans c1 (o) (cons false (L)) (cons true (R))
  have h2 : steps 8 ⟨cons false (L), cons true (cons false (rep (o) [true] (cons true (R)))), .B⟩ = some ⟨cons true (cons true (cons true (L))), rep (o) [true] (cons true (R)), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- A on 011 halts: two steps, then F reads a 1. -/
theorem a011 (L R : Tape) :
    steps 2 ⟨L, cons false (cons true (cons true R)), .A⟩ = some ⟨cons false (cons true L), cons true R, .F⟩ ∧
      step ⟨cons false (cons true L), cons true R, .F⟩ = none := ⟨rfl, rfl⟩

