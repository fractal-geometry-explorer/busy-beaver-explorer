/-- A over 3a ones: `(011)^a`, still A. -/
theorem conv (a : Nat) (L R : Tape) :
    steps (3 * a) ⟨L, rep (a) [true, true, true] (R), .A⟩ = some ⟨rep (a) [true, true, false] (L), R, .A⟩ := by
  have hn : (a) * 3 = 3 * a := by omega
  have c0 : ∀ L R : Tape, steps 3 ⟨app [] L, app [true, true, true] R, .A⟩ = some ⟨app [] (app [true, true, false] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((a) * 3) ⟨L, rep (a) [true, true, true] (R), .A⟩ = some ⟨rep (a) [true, true, false] (L), R, .A⟩ :=
    cross_r trans c0 (a) (L) (R)
  exact steps_congr trans hn (h0)


