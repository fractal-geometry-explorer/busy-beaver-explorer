/-- E on a 0 after an open block of o + 1: the block moves one cell right, the block before it grows by 3. -/
theorem eshift (o : Nat) (L R : Tape) :
    steps (3 * o + 9) ⟨rep (o + 1) [true] (cons false (L)), cons false (R), .E⟩ = some ⟨cons true (cons true (cons true (L))), rep (o) [true] (R), .A⟩ := by
  have hn : (o + 1) * 3 + (6) = 3 * o + 9 := by omega
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [true] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((o + 1) * 3) ⟨rep (o + 1) [true] (cons false (L)), cons false (R), .E⟩ = some ⟨cons false (L), cons false (rep (o + 1) [true] (R)), .E⟩ :=
    cross_l trans c0 (o + 1) (cons false (L)) (R)
  have h1 : steps 6 ⟨cons false (L), cons false (rep (o + 1) [true] (R)), .E⟩ = some ⟨cons true (cons true (cons true (L))), rep (o) [true] (R), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


