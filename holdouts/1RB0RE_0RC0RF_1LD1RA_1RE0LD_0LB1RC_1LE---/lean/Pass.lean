/-- The left sweep: the last block (l + 1) is erased, the block before it (p + 1) moves one cell right, the block before that grows by 3 (3 new cells if `L` is blank), and A starts in front of the moved block. -/
theorem start (l p : Nat) (L R : Tape) :
    steps (l + 3 * p + 15) ⟨rep (l + 1) [true] (cons false (rep (p + 1) [true] (cons false (L)))), cons false (R), .C⟩ = some ⟨cons true (cons true (cons true (L))), rep (p + 1) [true] (rep (l) [false] (cons true (R))), .A⟩ := by
  have hn : 1 + ((l) * 1 + (3 + ((p + 1) * 3 + (8)))) = l + 3 * p + 15 := by omega
  have h0 : steps 1 ⟨rep (l + 1) [true] (cons false (rep (p + 1) [true] (cons false (L)))), cons false (R), .C⟩ = some ⟨rep (l) [true] (cons false (rep (p + 1) [true] (cons false (L)))), cons true (cons true (R)), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((l) * 1) ⟨rep (l) [true] (cons false (rep (p + 1) [true] (cons false (L)))), cons true (cons true (R)), .D⟩ = some ⟨cons false (rep (p + 1) [true] (cons false (L))), cons true (rep (l) [false] (cons true (R))), .D⟩ :=
    cross_l trans c1 (l) (cons false (rep (p + 1) [true] (cons false (L)))) (cons true (R))
  have h2 : steps 3 ⟨cons false (rep (p + 1) [true] (cons false (L))), cons true (rep (l) [false] (cons true (R))), .D⟩ = some ⟨rep (p + 1) [true] (cons false (L)), cons true (cons false (rep (l) [false] (cons true (R)))), .B⟩ := rfl
  have c3 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true, false] R, .B⟩ = some ⟨L, app [true, false] (app [true] R), .B⟩ := fun _ _ => rfl
  have h3 : steps ((p + 1) * 3) ⟨rep (p + 1) [true] (cons false (L)), cons true (cons false (rep (l) [false] (cons true (R)))), .B⟩ = some ⟨cons false (L), cons true (cons false (rep (p + 1) [true] (rep (l) [false] (cons true (R))))), .B⟩ :=
    cross_l trans c3 (p + 1) (cons false (L)) (rep (l) [false] (cons true (R)))
  have h4 : steps 8 ⟨cons false (L), cons true (cons false (rep (p + 1) [true] (rep (l) [false] (cons true (R))))), .B⟩ = some ⟨cons true (cons true (cons true (L))), rep (p + 1) [true] (rep (l) [false] (cons true (R))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))


/-- A on a 1 writes 0. -/
theorem aone (L R : Tape) :
    steps (1) ⟨L, cons true (R), .A⟩ = some ⟨cons false (L), R, .E⟩ := by
  have hn : 1 = 1 := by omega
  have h0 : steps 1 ⟨L, cons true (R), .A⟩ = some ⟨cons false (L), R, .E⟩ := rfl
  exact steps_congr trans hn (h0)


