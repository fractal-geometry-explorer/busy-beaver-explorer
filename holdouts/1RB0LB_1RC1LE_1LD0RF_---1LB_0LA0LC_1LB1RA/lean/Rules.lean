import Machine

/-! # Shift rules of 1RB0LB_1RC1LE_1LD0RF_---1LB_0LA0LC_1LB1RA

Two crossings that the run uses: A, with a 1 behind it, turns `01` into `10` going right (`walk_A`), and B, with
`11` ahead, turns `0101` into `1010` going left (`walk_B`).  The halting situations: only D reading a 0 halts, and
`0 C> 0`, `0 0 E> 1`, `0 0 1 B> 1` and `0 0 A> 0 1` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H154458

open TM

/-- A, carrying a 1, turns each `01` into `10`, eight steps a copy. -/
theorem walk_A (n : Nat) (L R : Tape) :
    steps (8 * n) ⟨cons true (L), rep (n) [false, true] (R), .A⟩ = some ⟨cons true (rep (n) [false, true] (L)), R, .A⟩ := by
  have hn : (n) * 8 = 8 * n := by omega
  have c0 : ∀ L R : Tape, steps 8 ⟨app [true] L, app [false, true] R, .A⟩ = some ⟨app [true] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 8) ⟨cons true (L), rep (n) [false, true] (R), .A⟩ = some ⟨cons true (rep (n) [false, true] (L)), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- B, with `11` ahead, turns each `0101` into `1010` going left, 22 steps a copy. -/
theorem walk_B (n : Nat) (L R : Tape) :
    steps (22 * n) ⟨rep (n) [true, false, true, false] (L), cons true (cons true (R)), .B⟩ = some ⟨L, cons true (cons true (rep (n) [true, false, true, false] (R))), .B⟩ := by
  have hn : (n) * 22 = 22 * n := by omega
  have c0 : ∀ L R : Tape, steps 22 ⟨app [true, false, true, false] L, app [true, true] R, .B⟩ = some ⟨L, app [true, true] (app [true, false, true, false] R), .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 22) ⟨rep (n) [true, false, true, false] (L), cons true (cons true (R)), .B⟩ = some ⟨L, cons true (cons true (rep (n) [true, false, true, false] (R))), .B⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `0 C> 0` halts: C writes 1 and steps left onto the 0 in state D. -/
theorem halt_C (L R : Tape) : ∃ c, steps 1 ⟨cons false (L), cons false (R), .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 0 E> 1` halts: E steps left in state C onto a 0, then D reads the next 0. -/
theorem halt_E (L R : Tape) : ∃ c, steps 2 ⟨cons false (cons false (L)), cons true (R), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 0 1 B> 1` halts after three steps. -/
theorem halt_B (L R : Tape) : ∃ c, steps 3 ⟨cons true (cons false (cons false (L))), cons true (R), .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 0 A> 0 1` halts after four steps. -/
theorem halt_A (L R : Tape) : ∃ c, steps 4 ⟨cons false (cons false (L)), cons false (cons true (R)), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H154458
