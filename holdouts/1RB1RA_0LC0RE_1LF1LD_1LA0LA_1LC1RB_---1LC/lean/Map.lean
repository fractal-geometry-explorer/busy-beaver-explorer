import Rules

/-!
# The visit map of 1RB1RA_0LC0RE_1LF1LD_1LA0LA_1LC1RB_---1LC, proved

Configurations (tapes left to right, the head reads the cell after `S>`; `T4` is the tail `1111 0^inf`):

* `S c p b`    = `0^inf (10)^c 1^(2p+2) 0 (10)^b 1 B> 0^inf`                 (a visit of the right end, pool a = 2p+2)
* `Rc c p k z` = `0^inf (10)^c 1^(2p) A> 1 0 1^(4k+1) 0 (10)^z 1111 0^inf`   (inside a sweep)

The rules of `Rules.lean` (generated by `py/rules.py`) restated on these configurations are the moves of the odometer:
a round takes a pair of the pool and a pair of the right block (`r_round`), the end of the right block makes the
visit with the doubled block (`r_final`), an empty pool is refilled from the left block (`r_carry`, and the three
short cases), an empty left block is refilled from the middle block (`r_reset`, `r_reset1`), and the reset that finds
everything empty halts (`r_halt`).  They are assembled into a map `F` on visits `(c, p, b)`.

Main results:
* `F_sem`: `F v = some v'` → the machine goes from the visit `v` to `v'` (at least one step); `F v = none` → it
  halts from `v`;
* `halts_iff`: **the machine halts from blank tape iff the orbit of `(0, 1, 1)` (= `S(0, 4, 1)`, step 43) under `F`
  reaches `none`**.
-/

namespace H50923

open TM

/-! ## Tape identities -/

theorem t_rot (n : Nat) (X : Tape) : cons true (rep n [false, true] X) = rep n [true, false] (cons true X) :=
  rep_rotate n [true] [false, true] [true, false] rfl X

theorem t_w4 (n : Nat) (X : Tape) : rep n [true, true, true, true] X = rep (2 * n) [true, true] X := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, ih, rep_succ, rep_succ]; rfl

theorem t_tftf (n : Nat) (X : Tape) : rep n [true, false, true, false] X = rep (2 * n) [true, false] X := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, ih, rep_succ, rep_succ]; rfl

theorem t_ftft (n : Nat) (X : Tape) : rep n [false, true, false, true] X = rep (2 * n) [false, true] X := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, ih, rep_succ, rep_succ]; rfl

/-- `11 (1111)^n 11 = (11)^(2n+2)`. -/
theorem t_tt (n : Nat) (X : Tape) :
    cons true (cons true (rep n [true, true, true, true] (cons true (cons true X)))) = rep (2 * n + 2) [true, true] X := by
  have h := rep_rotate n [true, true] [true, true, true, true] [true, true, true, true] rfl (cons true (cons true X))
  simp only [app_cons, app_nil] at h
  rw [h, show (cons true (cons true (cons true (cons true X)))) = app [true, true, true, true] X from rfl,
    rep_app_comm, t_w4]
  congr 1

/-- `(10)^4 (1010)^n = (10)^(2n+4)`, and `1 (01)^m 0 = (10)^(m+1)`. -/
theorem t_tf_succ (m : Nat) (Y : Tape) : cons true (rep m [false, true] (cons false Y)) = rep (m + 1) [true, false] Y := by
  rw [t_rot, ← rep_app_comm]; rfl

theorem t_ft_succ (n : Nat) (X : Tape) :
    cons false (cons true (rep n [false, true, false, true] (cons false (cons true X)))) = rep (2 * n + 2) [false, true] X := by
  have h := rep_rotate n [false, true] [false, true, false, true] [false, true, false, true] rfl (cons false (cons true X))
  simp only [app_cons, app_nil] at h
  rw [h, show (cons false (cons true (cons false (cons true X)))) = app [false, true, false, true] X from rfl,
    rep_app_comm, t_ftft]
  congr 1

/-! ## The configurations -/

/-- The tail `1111 0^inf`. -/
def T4 : Tape := cons true (cons true (cons true (cons true blank)))
/-- Left of the head: the pool `1^(2p)`, then the left block `(10)^c` (nearest cell first). -/
def Lft (c p : Nat) : Tape := rep p [true, true] (rep c [false, true] blank)
/-- The visit `S(c, 2p+2, b) = 0^inf (10)^c 1^(2p+2) 0 (10)^b 1 B> 0^inf`. -/
def S (c p b : Nat) : Config := ⟨cons true (rep b [false, true] (cons false (Lft c (p + 1)))), blank, .B⟩
/-- Right of the head inside a sweep: `1 0 1^(4k+1) 0 (10)^z 1111 0^inf`. -/
def Rt (k z : Nat) : Tape :=
  cons true (cons false (cons true (rep k [true, true, true, true] (cons false (rep z [true, false] T4)))))
/-- Inside a sweep: `0^inf (10)^c 1^(2p) A> 1 0 1^(4k+1) 0 (10)^z 1111 0^inf`. -/
def Rc (c p k z : Nat) : Config := ⟨Lft c p, Rt k z, .A⟩

/-! ## Reaching -/

/-- `c` reaches `c'` in at least one step. -/
def Reach (c c' : Config) : Prop := ∃ n, steps (n + 1) c = some c'
/-- `c` reaches `c'` (possibly in no step). -/
def Reaches (c c' : Config) : Prop := ∃ n, steps n c = some c'

theorem reach_trans {a b c : Config} : Reach a b → Reach b c → Reach a c
  | ⟨n, h1⟩, ⟨m, h2⟩ => ⟨n + m + 1, steps_congr trans (by omega) (steps_seq trans h1 h2)⟩
theorem Reach.reaches {a b : Config} : Reach a b → Reaches a b
  | ⟨n, h⟩ => ⟨n + 1, h⟩
theorem halts_pre {a b : Config} : Reaches a b → Halts trans b → Halts trans a
  | ⟨n, h1⟩, ⟨m, c, h2, h3⟩ => ⟨n + m, c, steps_seq trans h1 h2, h3⟩
theorem reach_of {n : Nat} {c c' d d' : Config} (h : steps n d = some d') (e1 : c = d) (e2 : c' = d')
    (hn : 0 < n) : Reach c c' := by
  subst e1; subst e2; exact ⟨n - 1, by rw [show n - 1 + 1 = n by omega]; exact h⟩

/-! ## The moves -/

theorem lft_succ (c p : Nat) : Lft c (p + 1) = cons true (cons true (Lft c p)) := rfl
theorem lft_c (c : Nat) : Lft (c + 1) 0 = cons false (cons true (Lft c 0)) := rfl

/-- `S(c, a, 0)` to `S(c, a, 1)`. -/
theorem r_start0 (c p : Nat) : Reach (S c p 0) (S c p 1) := reach_of (start0 (Lft c p)) rfl rfl (by omega)

/-- `S(c, 2p+2, n+1)` to `Rc c p 0 n`. -/
theorem r_start (c p n : Nat) : Reach (S c p (n + 1)) (Rc c p 0 n) := by
  refine reach_of (start_g n (Lft c p)) rfl ?_ (by omega)
  simp only [Rc, Rt, rep_zero]
  rw [t_rot]; rfl

/-- A round: `Rc c (p+1) k (z+1)` to `Rc c p (k+1) z`. -/
theorem r_round (c p k z : Nat) : Reach (Rc c (p + 1) k (z + 1)) (Rc c p (k + 1) z) := by
  refine reach_of (round k (Lft c p) (rep z [true, false] T4)) rfl ?_ (by omega)
  simp only [Rc, Rt]
  have h := rep_rotate k [true, true] [true, true, true, true] [true, true, true, true] rfl
    (cons true (cons true (cons false (rep z [true, false] T4))))
  simp only [app_cons, app_nil] at h
  rw [h, show (cons true (cons true (cons true (cons true (cons false (rep z [true, false] T4))))))
    = app [true, true, true, true] (cons false (rep z [true, false] T4)) from rfl, rep_app_comm]

/-- The right block is used up: `Rc c (p+1) k 0` to the visit `S(c, 2p+2, 2k+3)`. -/
theorem r_final (c p k : Nat) : Reach (Rc c (p + 1) k 0) (S c p (2 * k + 3)) := by
  refine reach_of (final_g k (Lft c p)) rfl ?_ (by omega)
  simp only [S, lft_succ]
  rw [t_tf_succ, t_tftf]
  rw [show 2 * k + 3 + 1 = 2 * k + 1 + 1 + 1 + 1 by omega]
  simp only [rep_succ, app_cons, app_nil]

/-- A carry: the pool is empty, a pair of the left block refills it: `Rc (c+1) 0 k (z+3)` to `Rc c (2k+2) 1 z`. -/
theorem r_carry (c k z : Nat) : Reach (Rc (c + 1) 0 k (z + 3)) (Rc c (2 * k + 2) 1 z) := by
  refine reach_of (carry k (Lft c 0) (rep (z + 1) [true, false] T4)) rfl ?_ (by omega)
  simp only [Rc, Rt]
  rw [t_tt]; rfl

theorem r_carry2 (c k : Nat) : Reach (Rc (c + 1) 0 k 2) (S c (2 * k + 2) 3) := by
  refine reach_of (carry_z2 k (Lft c 0)) rfl ?_ (by omega)
  simp only [S, Lft]
  rw [t_tt]; rfl

theorem r_carry1 (c k : Nat) : Reach (Rc (c + 1) 0 k 1) (S c (2 * k + 3) 1) := by
  refine reach_of (carry_z1 k (Lft c 0)) rfl ?_ (by omega)
  simp only [S, Lft]
  rw [t_tt]; rfl

theorem r_carry0 (c k : Nat) : Reach (Rc (c + 1) 0 k 0) (S c (2 * k + 3) 1) := by
  refine reach_of (carry_z0 k (Lft c 0)) rfl ?_ (by omega)
  simp only [S, Lft]
  rw [t_tt]; rfl

/-- A reset: pool and left block empty, the middle block becomes the left block: `Rc 0 0 k (z+2)` to
`Rc (2k+2) 1 0 z`. -/
theorem r_reset (k z : Nat) : Reach (Rc 0 0 k (z + 2)) (Rc (2 * k + 2) 1 0 z) := by
  refine reach_of (reset k (rep (z + 1) [true, false] T4)) rfl ?_ (by omega)
  simp only [Rc, Rt, Lft]
  rw [t_ft_succ]; rfl

theorem r_reset1 (k : Nat) : Reach (Rc 0 0 k 1) (S (2 * k + 2) 1 1) := by
  refine reach_of (reset_z1 k) rfl ?_ (by omega)
  simp only [S, Lft]
  rw [t_ft_succ]; rfl

/-- Pool, left block and right block all empty: the machine halts. -/
theorem r_halt (k : Nat) : Halts trans (Rc 0 0 k 0) := halt_R k

/-! ## The map on visits -/

/-- One sweep from inside, `Rc c p k z`, to the next visit `(c', p', b')` (= `S c' p' b'`), or `none` for the halt. -/
def inner : Nat → Nat → Nat → Nat → Option (Nat × Nat × Nat)
  | c, p + 1, k, z + 1 => inner c p (k + 1) z
  | c, p + 1, k, 0 => some (c, p, 2 * k + 3)
  | c + 1, 0, k, z + 3 => inner c (2 * k + 2) 1 z
  | c + 1, 0, k, 2 => some (c, 2 * k + 2, 3)
  | c + 1, 0, k, 1 => some (c, 2 * k + 3, 1)
  | c + 1, 0, k, 0 => some (c, 2 * k + 3, 1)
  | 0, 0, k, z + 2 => inner (2 * k + 2) 1 0 z
  | 0, 0, k, 1 => some (2 * k + 2, 1, 1)
  | 0, 0, _, 0 => none

/-- The visit map: from `S c p b` to the next visit, or `none` when the machine halts first. -/
def F : Nat × Nat × Nat → Option (Nat × Nat × Nat)
  | (c, p, 0) => some (c, p, 1)
  | (c, p, n + 1) => inner c p 0 n

/-- What `F` claims about a configuration. -/
def Sem (x : Config) : Option (Nat × Nat × Nat) → Prop
  | some (c, p, b) => Reach x (S c p b)
  | none => Halts trans x

theorem sem_pre {x y : Config} {o : Option (Nat × Nat × Nat)} (h : Reach x y) (hy : Sem y o) : Sem x o := by
  cases o with
  | none => exact halts_pre h.reaches hy
  | some v => obtain ⟨c, p, b⟩ := v; exact reach_trans h hy

theorem inner_sem (z : Nat) : ∀ c p k, Sem (Rc c p k z) (inner c p k z) := by
  induction z using Nat.strongRecOn with
  | ind z ih =>
    intro c p k
    match c, p, z with
    | c, p + 1, z + 1 => exact sem_pre (r_round c p k z) (ih z (by omega) c p (k + 1))
    | c, p + 1, 0 => exact r_final c p k
    | c + 1, 0, z + 3 => exact sem_pre (r_carry c k z) (ih z (by omega) c (2 * k + 2) 1)
    | c + 1, 0, 2 => exact r_carry2 c k
    | c + 1, 0, 1 => exact r_carry1 c k
    | c + 1, 0, 0 => exact r_carry0 c k
    | 0, 0, z + 2 => exact sem_pre (r_reset k z) (ih z (by omega) (2 * k + 2) 1 0)
    | 0, 0, 1 => exact r_reset1 k
    | 0, 0, 0 => exact r_halt k

/-- **`F` is the machine on visits.** -/
theorem F_sem (v : Nat × Nat × Nat) : Sem (S v.1 v.2.1 v.2.2) (F v) := by
  obtain ⟨c, p, b⟩ := v
  cases b with
  | zero => exact r_start0 c p
  | succ n => exact sem_pre (r_start c p n) (inner_sem n c p 0)

/-! ## Halting is the orbit question -/

/-- The orbit of `v` under `F`, `none` once it has hit the halt. -/
def orbit (v : Nat × Nat × Nat) : Nat → Option (Nat × Nat × Nat)
  | 0 => some v
  | k + 1 => (F v).bind (fun v' => orbit v' k)

/-- The run from blank tape is at the visit `S(0, 4, 1)` after 43 steps. -/
theorem blank_to_S : steps 43 init = some (S 0 1 1) :=
  blank_reaches trans (q := .A) (n := 43)
    (c := ⟨[true, false, true, false, true, true, true, true], [], .B⟩) (by decide)

theorem runs_long (N : Nat) : ∀ v, (∀ k, orbit v k ≠ none) →
    ∃ m, N ≤ m ∧ ∃ c, steps m (S v.1 v.2.1 v.2.2) = some c := by
  induction N with
  | zero => intro v _; exact ⟨0, Nat.le_refl 0, _, rfl⟩
  | succ N ih =>
    intro v hs
    have hr := F_sem v
    cases hF : F v with
    | none => exact absurd (by simp [orbit, hF]) (hs 1)
    | some v' =>
      have hs' : ∀ k, orbit v' k ≠ none := fun k h => hs (k + 1) (by simp [orbit, hF, h])
      obtain ⟨m, hm, c, hc⟩ := ih v' hs'
      rw [hF] at hr
      obtain ⟨c', p', b'⟩ := v'
      obtain ⟨k, hk⟩ := hr
      exact ⟨k + 1 + m, by omega, c, steps_seq trans hk hc⟩

/-- The machine halts from the visit `v` iff the orbit of `v` under `F` reaches `none`. -/
theorem halts_from (v : Nat × Nat × Nat) : Halts trans (S v.1 v.2.1 v.2.2) ↔ ∃ k, orbit v k = none := by
  constructor
  · intro hh
    refine Classical.byContradiction fun hne => ?_
    have hs : ∀ k, orbit v k ≠ none := fun k h => hne ⟨k, h⟩
    refine not_halts_of_forall trans ?_ hh
    exact forall_of_unbounded trans (fun m => ∃ c, steps m (S v.1 v.2.1 v.2.2) = some c) (runs_long · v hs)
      (fun _ h => h)
  · rintro ⟨k, hk⟩
    induction k generalizing v with
    | zero => simp [orbit] at hk
    | succ k ih =>
      have hr := F_sem v
      cases hF : F v with
      | none => rw [hF] at hr; exact hr
      | some v' =>
        rw [hF] at hr
        have hk' : orbit v' k = none := by simpa [orbit, hF] using hk
        obtain ⟨c', p', b'⟩ := v'
        exact halts_pre hr.reaches (ih _ hk')

/-- **Main theorem.** The machine halts from blank tape iff the orbit of `(0, 1, 1)` (the visit `S(0, 4, 1)`,
reached after 43 steps) under the visit map `F` reaches `none`. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ k, orbit (0, 1, 1) k = none := by
  rw [← halts_from]
  constructor
  · intro hh
    refine Classical.byContradiction fun hne => ?_
    have hs : ∀ k, orbit (0, 1, 1) k ≠ none := fun k h => hne ((halts_from _).2 ⟨k, h⟩)
    refine not_halts_of_forall trans ?_ hh
    refine forall_of_unbounded trans (fun m => ∃ c, steps m init = some c) (fun N => ?_) (fun _ h => h)
    obtain ⟨m, hm, c, hc⟩ := runs_long N (0, 1, 1) hs
    exact ⟨43 + m, by omega, c, steps_seq trans blank_to_S hc⟩
  · exact halts_pre ⟨43, blank_to_S⟩

end H50923
