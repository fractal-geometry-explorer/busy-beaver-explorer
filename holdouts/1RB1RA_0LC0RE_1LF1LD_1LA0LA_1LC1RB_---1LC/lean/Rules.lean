import Machine

/-! # The building blocks of the odometer of 1RB1RA_0LC0RE_1LF1LD_1LA0LA_1LC1RB_---1LC

Between two visits `S(c, a, b) = 0^inf (10)^c 1^a 0 (10)^b 1 B> 0^inf` of the right end the machine works through
the inner configurations `R(x, q, z) = ... 1^x [A> 1] 0 1^q 0 (10)^z 1^4 0^inf` (q = 1, 5, 9, ...).  Each theorem is
one move of the odometer, for every value of its parameters and every tape in the contexts `L`, `R`:

* `start`, `start0`: from `S(c, a, n+1)` to `R(a-2, 1, n)`; from `S(c, a, 0)` to `S(c, a, 1)`;
* `round`: a round takes two 1s from the pool and one `10` from the right block, and adds four 1s to the middle
  block: `R(x, q, z) -> R(x-2, q+4, z-1)`;
* `final`: the right block is used up: `R(x, 4n+1, 0)` becomes the visit `S(c, x, 2n+3)` (the doubled block);
* `carry`: the pool is empty and a `10` of the left block is next: that `10` and the middle block become the new
  pool (`1^(q+3)`), and the next round starts;
* `reset`: the pool is empty and so is the left block: the middle block becomes the new left block `(10)^((q+3)/2)`
  and the pool is `1^2`;
* `halt_run`, `halt_R`: pool, left block and right block all empty: `R(0, 4n+1, 0)` on blank tape runs into the
  undefined transition (F reading 0).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l`, re-bracketings and `omega`, checked by Lean's kernel. -/

namespace H50923

open TM

/-- `S(c, a, n+1)` to `R(a-2, 1, n)` (the tail `0 1 (01)^n 1 1 1` is `0 (10)^n 1^4`). -/
theorem start (n : Nat) (L : Tape) :
    steps (4 * n + 22) ⟨cons true (cons false (cons true (rep (n) [false, true] (cons false (cons true (cons true (cons true (cons true (L))))))))), blank, .B⟩ = some ⟨cons true (cons true (L)), cons true (cons false (cons true (cons false (cons true (rep (n) [false, true] (cons true (cons true (cons true (blank))))))))), .A⟩ := by
  have h0 : steps 16 ⟨cons true (cons false (cons true (rep (n) [false, true] (cons false (cons true (cons true (cons true (cons true (L))))))))), blank, .B⟩ = some ⟨cons true (rep (n) [false, true] (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (cons true (cons true (blank)))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (n) [false, true] (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (cons true (cons true (blank)))), .C⟩ = some ⟨rep (n) [true, false] (cons true (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (cons true (cons true (blank)))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (n) [false, true] (cons false (cons true (cons true (cons true (cons true (L))))))) = rep (n) [true, false] (cons true (cons false (cons true (cons true (cons true (cons true (L))))))) from
      rep_rotate (n) [true] [false, true] [true, false] rfl (cons false (cons true (cons true (cons true (cons true (L))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, false] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 4) ⟨rep (n) [true, false] (cons true (cons false (cons true (cons true (cons true (cons true (L))))))), cons true (cons true (cons true (cons true (blank)))), .C⟩ = some ⟨cons true (cons false (cons true (cons true (cons true (cons true (L)))))), cons true (rep (n) [false, true] (cons true (cons true (cons true (blank))))), .C⟩ :=
    cross_l trans c2 (n) (cons true (cons false (cons true (cons true (cons true (cons true (L))))))) (cons true (cons true (cons true (blank))))
  have h3 : steps 6 ⟨cons true (cons false (cons true (cons true (cons true (cons true (L)))))), cons true (rep (n) [false, true] (cons true (cons true (cons true (blank))))), .C⟩ = some ⟨cons true (cons true (L)), cons true (cons false (cons true (cons false (cons true (rep (n) [false, true] (cons true (cons true (cons true (blank))))))))), .A⟩ := rfl
  exact steps_congr trans (a := 16 + (0 + ((n) * 4 + (6)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

