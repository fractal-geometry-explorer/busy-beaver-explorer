  have h7 : steps ((n) * 4) ⟨cons false (cons true (blank)), rep (n) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))), .E⟩ = some ⟨rep (n) [false, true, false, true] (cons false (cons true (blank))), cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))), .E⟩ :=
    cross_r trans c7 (n) (cons false (cons true (blank))) (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))))
  have h8 : steps 16 ⟨rep (n) [false, true, false, true] (cons false (cons true (blank))), cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (rep (n) [false, true, false, true] (cons false (cons true (blank))))))))))))), blank, .B⟩ := rfl
  exact steps_congr trans (a := 2 + (0 + ((n) * 4 + (2 + ((n) * 4 + (6 + (0 + ((n) * 4 + (16))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- `R(0, 4n+1, 0)` on blank tape halts, for every n: the reset that finds the right block used up exactly. -/
theorem halt_R (n : Nat) :
    TM.Halts trans ⟨blank, cons true (cons false (cons true (rep (n) [true, true, true, true]
      (cons false (cons true (cons true (cons true (cons true (blank))))))))), .A⟩ :=
  ⟨_, _, halt_run n, rfl⟩

end H50923
