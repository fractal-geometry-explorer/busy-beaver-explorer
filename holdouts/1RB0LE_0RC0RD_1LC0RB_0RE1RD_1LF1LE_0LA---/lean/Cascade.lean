import Rules
import TM.Fin

/-! # The halving cascade of 1RB0LE_0RC0RD_1LC0RB_0RE1RD_1LF1LE_0LA---, as a theorem

At the moments the head, in A, is at the left wall the tape is `Wall ns = 0^inf A> 0 0 1^n1 0 0 1^n2 … 0 0 1^nk 0^inf`
(`enc ns`). This file proves, for every list ns with entries ≥ 1:

* `F_some`: if the cascade map `F` (below) sends ns to ns', the machine goes from `Wall ns` to `Wall ns'`, and the
  entries of ns' are again ≥ 1;
* `F_none`: if `F ns = none` (the cascade would make a block 0), the machine halts from `Wall ns`;
* `blank_to_wall`: the run from blank tape is at `Wall [1, 1]` after 13 steps.

Hence **`halts_iff`**: the machine halts from blank tape iff the orbit of [1, 1] under F reaches `none`.

The map, as the machine computes it (v is the value being halved, written u + 2; `hs` the halved blocks so far,
nearest first; `split` takes the next block, 0 past the end of the list):

* a first block 1 merges: (1, x, y, …) ↦ (x + 3, y + 1, …);
* otherwise the first block v is halved: the block becomes ⌊v/2⌋ and the rest c = v − ⌊v/2⌋ goes on. If v is even,
  the next block n becomes the value halved next, v' = n + v/2 (`cascM`, `tailM` past the end of the list), and if
  v' = 1 there is no block left to make: that is the halt. If v is odd, the next block gets c + 2 more and the one
  after it one more, and the round ends.

Machine pieces: `Rules.lean`, generated by `py/rules.py` with `bbtools.symtm`. The induction over the list and the
assembly are by hand. -/

namespace H95916

open TM

/-! ## Tapes -/

/-- The blocks right of the head at the wall: `0 0 1^n1 0 0 1^n2 … 0 0 1^nk` then blank. -/
def enc : List Nat → Tape
  | [] => blank
  | n :: ns => cons false (cons false (rep n [true] (enc ns)))

/-- The same blocks in front of any tape T. -/
def encPre : List Nat → Tape → Tape
  | [], T => T
  | n :: ns, T => cons false (cons false (rep n [true] (encPre ns T)))

/-- Halved blocks left of the head, nearest first: `… 0 0 1^h2 0 0 1^h1` read leftwards. -/
def lenc : List Nat → Tape
  | [] => blank
  | h :: hs => rep h [true] (cons false (cons false (lenc hs)))

/-- The next block and the blocks after it (a block 0 past the end of the list). -/
def split : List Nat → Nat × List Nat
  | [] => (0, [])
  | n :: r => (n, r)

theorem encPre_append (a b : List Nat) (T : Tape) : encPre (a ++ b) T = encPre a (encPre b T) := by
  induction a with
  | nil => rfl
  | cons n a ih => simp only [List.cons_append, encPre, ih]

theorem encPre_enc (a b : List Nat) : encPre a (enc b) = enc (a ++ b) := by
  induction a with
  | nil => rfl
  | cons n a ih => simp only [List.cons_append, encPre, enc, ih]

theorem enc_split (rest : List Nat) :
    enc rest = cons false (cons false (rep (split rest).1 [true] (enc (split rest).2))) := by
  cases rest with
  | nil => show blank = cons false (cons false blank); simp only [cons_false_blank]
  | cons n r => rfl

theorem split_valid {rest : List Nat} (h : ∀ x ∈ rest, 1 ≤ x) : ∀ x ∈ (split rest).2, 1 ≤ x := by
  cases rest with
  | nil => simp [split]
  | cons n r => intro x hx; exact h x (List.mem_cons_of_mem n hx)

theorem split_zero {rest : List Nat} (h : ∀ x ∈ rest, 1 ≤ x) (h0 : (split rest).1 = 0) : rest = [] := by
  cases rest with
  | nil => rfl
  | cons n r => have := h n (List.mem_cons_self ..); simp [split] at h0; omega

theorem ones_cons (n : Nat) (s : Tape) : rep n [true] (cons true s) = rep (n + 1) [true] s :=
  rep_app_comm n [true] s

/-! ## Configurations -/

/-- At the wall: `0^inf A> enc ns`. -/
def Wall (ns : List Nat) : Config := ⟨blank, enc ns, .A⟩

/-- Halving the value u + 2 (halved blocks `hs` to the left, the blocks `rest` to the right):
`lenc 0 0 1 0 0 0 D> 1^u enc rest`. -/
def Hc (hs : List Nat) (u : Nat) (rest : List Nat) : Config :=
  ⟨cons false (cons false (cons false (cons true (cons false (cons false (lenc hs)))))), rep u [true] (enc rest), .D⟩

/-- The sweep back to the wall: E on the right cell of a gap `0 0`, the halved blocks `hs` to the left. -/
def Sw (hs : List Nat) (R : Tape) : Config := ⟨cons false (lenc hs), cons false R, .E⟩

/-! ## The map -/

/-- The cascade past the end of the list (every further block is 0). -/
def tailM (hs : List Nat) (u : Nat) : Option (List Nat) :=
  if u % 2 = 1 then some (hs.reverse ++ [u / 2 + 1, u / 2 + 4, 1])
  else if h : u / 2 = 0 then none
  else tailM ((u / 2 + 1) :: hs) (u / 2 - 1)
termination_by u
decreasing_by omega

/-- The cascade: halving the value u + 2 with halved blocks `hs` and the blocks `rest` still to come. -/
def cascM : List Nat → Nat → List Nat → Option (List Nat)
  | hs, u, [] => tailM hs u
  | hs, u, n :: r =>
    if u % 2 = 1 then some (hs.reverse ++ (u / 2 + 1) :: (n + u / 2 + 4) :: ((split r).1 + 1) :: (split r).2)
    else if n + u / 2 = 0 then none
    else cascM ((u / 2 + 1) :: hs) (n + u / 2 - 1) r

/-- One round, from one wall visit to the next; `none` when the machine halts on the way. -/
def F : List Nat → Option (List Nat)
  | [] => none
  | 0 :: _ => none
  | 1 :: rest => some (((split rest).1 + 3) :: ((split (split rest).2).1 + 1) :: (split (split rest).2).2)
  | (u + 2) :: rest => cascM [] u rest

/-- The orbit of the run: [1, 1] at step 13, then F again and again. -/
def orbit : Nat → Option (List Nat)
  | 0 => some [1, 1]
  | t + 1 => (orbit t).bind F

/-- Lists the run can be at: nonempty, every block at least 1. -/
def Valid (ns : List Nat) : Prop := ns ≠ [] ∧ ∀ x ∈ ns, 1 ≤ x

/-! ## Runs -/

theorem reach_trans {c₁ c₂ c₃ : Config} (h₁ : ∃ t, steps t c₁ = some c₂) (h₂ : ∃ t, steps t c₂ = some c₃) :
    ∃ t, steps t c₁ = some c₃ := by
  obtain ⟨a, ha⟩ := h₁; obtain ⟨b, hb⟩ := h₂; exact ⟨a + b, steps_seq trans ha hb⟩

theorem halts_of_reach {c c' : Config} (h : ∃ t, steps t c = some c') (h' : Halts trans c') : Halts trans c := by
  obtain ⟨t, ht⟩ := h
  obtain ⟨n, d, h1, h2⟩ := h'
  exact ⟨t + n, d, steps_seq trans ht h1, h2⟩

/-- r rounds of the halving: the block left of the gap gets r more ones, the block right of the head too. -/
theorem rounds (r : Nat) : ∀ (e k n : Nat) (L R : Tape),
    ∃ t, steps t ⟨rep (2 * r + e) [true] (cons false (cons false (cons false (rep k [true] (cons false L))))),
        cons false (cons false (rep n [true] R)), .D⟩ =
      some ⟨rep e [true] (cons false (cons false (cons false (rep (k + r) [true] (cons false L))))),
        cons false (cons false (rep (n + r) [true] R)), .D⟩ := by
  induction r with
  | zero => intro e k n L R; exact ⟨0, by simp⟩
  | succ r ih =>
    intro e k n L R
    have h1 := halve k (2 * r + e) n L R
    obtain ⟨t, h2⟩ := ih e (k + 1) (n + 1) L R
    have e1 : 2 * (r + 1) + e = 2 * r + e + 2 := by omega
    have e2 : k + 1 + r = k + (r + 1) := by omega
    have e3 : n + 1 + r = n + (r + 1) := by omega
    rw [e2, e3] at h2
    rw [e1]
    exact ⟨_, steps_seq trans h1 h2⟩

/-- The halving of u + 2 runs to its end: `u % 2` ones left of the head, the halved block u/2 + 1 behind the gap,
and the next block grown by u/2. -/
theorem halving (hs : List Nat) (u : Nat) (rest : List Nat) :
    ∃ t, steps t (Hc hs u rest) = some ⟨rep (u % 2) [true] (cons false (cons false (cons false
        (rep (u / 2 + 1) [true] (cons false (cons false (lenc hs))))))),
      cons false (cons false (rep ((split rest).1 + u / 2) [true] (enc (split rest).2))), .D⟩ := by
  have h1 := d_run u (cons false (cons false (cons false (cons true (cons false (cons false (lenc hs))))))) (enc rest)
  have hd : u = 2 * (u / 2) + u % 2 := by omega
  obtain ⟨t, h2⟩ := rounds (u / 2) (u % 2) 1 (split rest).1 (cons false (lenc hs)) (enc (split rest).2)
  rw [← hd, Nat.add_comm 1 (u / 2)] at h2
  unfold Hc
  rw [enc_split rest] at h1 ⊢
  exact ⟨_, steps_seq trans h1 h2⟩

/-- One move of the sweep back: across a halved block h ≥ 1. -/
theorem sweep_one (h : Nat) (hh : 1 ≤ h) (hs : List Nat) (R : Tape) :
    ∃ t, steps t (Sw (h :: hs) R) = some (Sw hs (rep (h - 1) [true] (cons false (cons false (cons true R))))) := by
  obtain ⟨c, rfl⟩ : ∃ c, h = c + 1 := ⟨h - 1, by omega⟩
  cases c with
  | zero => exact ⟨3, atom1 (lenc hs) R⟩
  | succ c => exact ⟨_, atom c (lenc hs) R⟩

/-- The whole sweep back over the halved blocks. -/
theorem sweep (hs : List Nat) (hv : ∀ x ∈ hs, 1 ≤ x) (R : Tape) :
    ∃ R', (∃ t, steps t (Sw hs R) = some (Sw [] R')) ∧
      cons false (cons false (cons true R')) = encPre hs.reverse (cons false (cons false (cons true R))) := by
  induction hs generalizing R with
  | nil => exact ⟨R, ⟨0, rfl⟩, rfl⟩
  | cons h hs ih =>
    have hh := hv h (List.mem_cons_self ..)
    obtain ⟨R', h2, e2⟩ := ih (fun x hx => hv x (List.mem_cons_of_mem h hx))
      (rep (h - 1) [true] (cons false (cons false (cons true R))))
    refine ⟨R', reach_trans (sweep_one h hh hs R) h2, ?_⟩
    rw [e2, List.reverse_cons, encPre_append]
    obtain ⟨c, rfl⟩ : ∃ c, h = c + 1 := ⟨h - 1, by omega⟩
    rfl

/-- The sweep back ends at the wall. -/
theorem sweep_wall (hs : List Nat) (hv : ∀ x ∈ hs, 1 ≤ x) (R : Tape) :
    ∃ t, steps t (Sw hs R) = some ⟨blank, encPre hs.reverse (cons false (cons false (cons true R))), .A⟩ := by
  obtain ⟨R', h1, e1⟩ := sweep hs hv R
  rw [← e1]
  exact reach_trans h1 ⟨2, wall_end R'⟩

/-- An odd halving: from its end the machine goes back to the wall with the next block grown by 4 and the one
after it by 1. -/
theorem odd_finish (hs : List Nat) (hv : ∀ x ∈ hs, 1 ≤ x) (k N : Nat) (rest : List Nat) :
    ∃ t, steps t ⟨rep 1 [true] (cons false (cons false (cons false (rep (k + 1) [true] (cons false (cons false (lenc hs))))))),
        cons false (cons false (rep N [true] (enc rest))), .D⟩ =
      some (Wall (hs.reverse ++ (k + 1) :: (N + 4) :: ((split rest).1 + 1) :: (split rest).2)) := by
  have h1 := odd_run N (rep (k + 1) [true] (cons false (cons false (lenc hs)))) (enc rest)
  have e1 : rep N [true] (cons true (cons true (cons true (cons true (cons false (cons false
      (rep (k + 1) [true] (cons false (cons false (lenc hs)))))))))) =
      rep (N + 2 + 2) [true] (cons false (cons false (lenc ((k + 1) :: hs)))) := by
    rw [ones_cons, ones_cons, ones_cons, ones_cons]; rfl
  rw [e1] at h1
  rw [enc_split rest] at h1 ⊢
  have h2 := dgap (N + 2) (lenc ((k + 1) :: hs)) (rep (split rest).1 [true] (enc (split rest).2))
  have hv' : ∀ x ∈ (k + 1) :: hs, 1 ≤ x := by
    intro x hx; cases hx with
    | head => omega
    | tail _ hx => exact hv x hx
  obtain ⟨t3, h3⟩ := sweep_wall ((k + 1) :: hs) hv' (rep (N + 3) [true] (cons false (cons false (cons true
    (rep (split rest).1 [true] (enc (split rest).2))))))
  have e3 : encPre ((k + 1) :: hs).reverse (cons false (cons false (cons true (rep (N + 3) [true]
      (cons false (cons false (cons true (rep (split rest).1 [true] (enc (split rest).2))))))))) =
      enc (hs.reverse ++ (k + 1) :: (N + 4) :: ((split rest).1 + 1) :: (split rest).2) := by
    rw [List.reverse_cons, encPre_append]
    show encPre hs.reverse (enc ((k + 1) :: (N + 4) :: ((split rest).1 + 1) :: (split rest).2)) = _
    rw [encPre_enc]
  rw [e3] at h3
  exact reach_trans ⟨_, steps_seq trans h1 h2⟩ ⟨t3, h3⟩

/-- An even halving that leaves a next value u' + 2 ≥ 2: the halving of the next block starts. -/
theorem even_next (hs : List Nat) (k w : Nat) (rest : List Nat) :
    ∃ t, steps t ⟨rep 0 [true] (cons false (cons false (cons false (rep (k + 1) [true] (cons false (cons false (lenc hs))))))),
        cons false (cons false (rep (w + 1) [true] (enc rest))), .D⟩ = some (Hc ((k + 1) :: hs) w rest) :=
  ⟨7, even_end (rep (k + 1) [true] (cons false (cons false (lenc hs)))) (rep w [true] (enc rest))⟩

/-- An even halving of 2 past the end of the list: the machine halts. -/
theorem even_halt (hs : List Nat) (k : Nat) :
    Halts trans ⟨rep 0 [true] (cons false (cons false (cons false (rep (k + 1) [true] (cons false (cons false (lenc hs))))))),
        cons false (cons false (rep 0 [true] (enc []))), .D⟩ :=
  ⟨62, _, past_end (rep k [true] (cons false (cons false (lenc hs)))), rfl⟩

/-- The cascade past the end of the list. -/
theorem tail_correct (u : Nat) : ∀ (hs : List Nat), (∀ x ∈ hs, 1 ≤ x) →
    (∀ ns, tailM hs u = some ns → (∃ t, steps t (Hc hs u []) = some (Wall ns)) ∧ ∀ x ∈ ns, 1 ≤ x) ∧
    (tailM hs u = none → Halts trans (Hc hs u [])) := by
  induction u using Nat.strongRecOn with
  | _ u ih =>
  intro hs hv
  obtain ⟨t0, h0⟩ := halving hs u []
  rw [tailM]
  by_cases hodd : u % 2 = 1
  · simp only [hodd, ite_true]
    refine ⟨?_, fun h => by cases h⟩
    intro ns hns
    cases hns
    rw [hodd] at h0
    have h1 := odd_finish hs hv (u / 2) (0 + u / 2) []
    refine ⟨reach_trans ⟨t0, h0⟩ ?_, ?_⟩
    · have e : 0 + u / 2 + 4 = u / 2 + 4 := by omega
      simpa [split, e] using h1
    · intro x hx
      simp only [List.mem_append, List.mem_reverse, List.mem_cons, List.mem_nil_iff, or_false] at hx
      rcases hx with hx | hx | hx | hx
      · exact hv x hx
      all_goals omega
  · have hev : u % 2 = 0 := by omega
    simp only [hodd, ite_false]
    rw [hev] at h0
    by_cases hz : u / 2 = 0
    · simp only [hz, dite_eq_left]
      refine ⟨fun ns h => (by cases h), fun _ => ?_⟩
      have hk : u / 2 = 0 := hz
      simp only [split, hk, Nat.add_zero] at h0
      exact halts_of_reach ⟨t0, h0⟩ (even_halt hs 0)
    · simp only [hz, dite_eq_right, not_false_eq_true]
      have hlt : u / 2 - 1 < u := by omega
      have hv' : ∀ x ∈ (u / 2 + 1) :: hs, 1 ≤ x := by
        intro x hx; cases hx with
        | head => omega
        | tail _ hx => exact hv x hx
      obtain ⟨ihs, ihn⟩ := ih (u / 2 - 1) hlt ((u / 2 + 1) :: hs) hv'
      have e : (split []).1 + u / 2 = (u / 2 - 1) + 1 := by simp [split]; omega
      rw [e] at h0
      have h1 := even_next hs (u / 2) (u / 2 - 1) (split []).2
      have hstep := reach_trans ⟨t0, h0⟩ h1
      refine ⟨fun ns hns => ?_, fun hn => halts_of_reach hstep (ihn hn)⟩
      obtain ⟨hr, hvn⟩ := ihs ns hns
      exact ⟨reach_trans hstep hr, hvn⟩

/-- **The cascade.** From the halving of u + 2, with halved blocks `hs` and blocks `rest` to come (all ≥ 1), the
machine reaches the wall with the list `cascM hs u rest`, or halts when that is `none`. -/
theorem casc_correct (rest : List Nat) : ∀ (hs : List Nat) (u : Nat), (∀ x ∈ hs, 1 ≤ x) → (∀ x ∈ rest, 1 ≤ x) →
    (∀ ns, cascM hs u rest = some ns → (∃ t, steps t (Hc hs u rest) = some (Wall ns)) ∧ ∀ x ∈ ns, 1 ≤ x) ∧
    (cascM hs u rest = none → Halts trans (Hc hs u rest)) := by
  induction rest with
  | nil => intro hs u hv _; simp only [cascM]; exact tail_correct u hs hv
  | cons n r ih =>
    intro hs u hv hr
    have hn : 1 ≤ n := hr n (List.mem_cons_self ..)
    have hr' : ∀ x ∈ r, 1 ≤ x := fun x hx => hr x (List.mem_cons_of_mem n hx)
    obtain ⟨t0, h0⟩ := halving hs u (n :: r)
    simp only [split] at h0
    simp only [cascM]
    by_cases hodd : u % 2 = 1
    · simp only [hodd, ite_true]
      refine ⟨?_, fun h => by cases h⟩
      intro ns hns
      cases hns
      rw [hodd] at h0
      have h1 := odd_finish hs hv (u / 2) (n + u / 2) r
      refine ⟨reach_trans ⟨t0, h0⟩ h1, ?_⟩
      intro x hx
      simp only [List.mem_append, List.mem_reverse, List.mem_cons] at hx
      rcases hx with hx | hx | hx | hx | hx
      · exact hv x hx
      · omega
      · omega
      · omega
      · exact split_valid hr' x hx
    · have hev : u % 2 = 0 := by omega
      simp only [hodd, ite_false]
      rw [hev] at h0
      have hz : ¬ (n + u / 2 = 0) := by omega
      simp only [hz, ite_false]
      have hv' : ∀ x ∈ (u / 2 + 1) :: hs, 1 ≤ x := by
        intro x hx; cases hx with
        | head => omega
        | tail _ hx => exact hv x hx
      obtain ⟨ihs, ihn⟩ := ih ((u / 2 + 1) :: hs) (n + u / 2 - 1) hv' hr'
      have e : n + u / 2 = (n + u / 2 - 1) + 1 := by omega
      rw [e] at h0
      have h1 := even_next hs (u / 2) (n + u / 2 - 1) r
      have hstep := reach_trans ⟨t0, h0⟩ h1
      refine ⟨fun ns hns => ?_, fun hn' => halts_of_reach hstep (ihn hn')⟩
      obtain ⟨hres, hvn⟩ := ihs ns hns
      exact ⟨reach_trans hstep hres, hvn⟩

/-! ## One round from the wall -/

/-- From the wall, a first block u + 2 ≥ 2 starts its halving. -/
theorem wall_halving (u : Nat) (rest : List Nat) : steps 4 (Wall ((u + 2) :: rest)) = some (Hc [] u rest) := by
  have h := wall_start blank (rep u [true] (enc rest))
  unfold Hc Wall
  simp only [lenc, enc]
  rw [cons_false_blank, cons_false_blank]
  exact h

/-- From the wall, a first block 1 merges into the next one. -/
theorem wall_merge (rest : List Nat) :
    ∃ t, steps (t + 1) (Wall (1 :: rest)) =
      some (Wall (((split rest).1 + 3) :: ((split (split rest).2).1 + 1) :: (split (split rest).2).2)) := by
  have h1 := merge_run (split rest).1 blank (enc (split rest).2)
  have e1 : rep (split rest).1 [true] (cons true (cons true (cons true (cons false (cons false blank))))) =
      rep ((split rest).1 + 1 + 2) [true] (cons false (cons false (lenc []))) := by
    rw [ones_cons, ones_cons, ones_cons]; rfl
  rw [e1, enc_split (split rest).2] at h1
  have h2 := dgap ((split rest).1 + 1) (lenc [])
    (rep (split (split rest).2).1 [true] (enc (split (split rest).2).2))
  have h3 := wall_end (cons true (rep ((split rest).1 + 1) [true] (cons false (cons false (cons true
    (rep (split (split rest).2).1 [true] (enc (split (split rest).2).2)))))))
  have h := steps_seq trans h1 (steps_seq trans h2 h3)
  have hw : Wall (1 :: rest) = ⟨blank, cons false (cons false (cons true (cons false (cons false
      (rep (split rest).1 [true] (cons false (cons false (rep (split (split rest).2).1 [true]
        (enc (split (split rest).2).2))))))))), .A⟩ := by
    unfold Wall
    simp only [enc]
    rw [enc_split rest, enc_split (split rest).2]
    rfl
  rw [hw]
  exact ⟨_, h⟩

theorem tailM_ne (u : Nat) : ∀ (hs ns : List Nat), tailM hs u = some ns → ns ≠ [] := by
  induction u using Nat.strongRecOn with
  | _ u ih =>
  intro hs ns h
  rw [tailM] at h
  by_cases hodd : u % 2 = 1
  · simp only [hodd, ite_true, Option.some.injEq] at h; subst h; simp
  · simp only [hodd, ite_false] at h
    by_cases hz : u / 2 = 0
    · simp [hz] at h
    · simp only [hz, dite_eq_right, not_false_eq_true] at h
      exact ih (u / 2 - 1) (by omega) _ ns h

theorem cascM_ne (rest : List Nat) : ∀ (hs : List Nat) (u : Nat) (ns : List Nat), cascM hs u rest = some ns → ns ≠ [] := by
  induction rest with
  | nil => intro hs u ns h; exact tailM_ne u hs ns h
  | cons n r ih =>
    intro hs u ns h
    simp only [cascM] at h
    by_cases hodd : u % 2 = 1
    · simp only [hodd, ite_true, Option.some.injEq] at h; subst h; simp
    · simp only [hodd, ite_false] at h
      by_cases hz : n + u / 2 = 0
      · simp [hz] at h
      · simp only [hz, ite_false] at h
        exact ih _ _ ns h

theorem F_correct (ns : List Nat) (hv : Valid ns) :
    (∀ ns', F ns = some ns' → (∃ t, steps (t + 1) (Wall ns) = some (Wall ns')) ∧ Valid ns') ∧
    (F ns = none → Halts trans (Wall ns)) := by
  obtain ⟨hne, hall⟩ := hv
  match ns, hne, hall with
  | 0 :: _, _, hall => exact absurd (hall 0 (List.mem_cons_self ..)) (by omega)
  | 1 :: rest, _, hall =>
    refine ⟨fun ns' h => ?_, fun h => by simp [F] at h⟩
    simp only [F, Option.some.injEq] at h
    subst h
    refine ⟨wall_merge rest, by simp, ?_⟩
    have hr : ∀ x ∈ rest, 1 ≤ x := fun x hx => hall x (List.mem_cons_of_mem 1 hx)
    intro x hx
    simp only [List.mem_cons] at hx
    rcases hx with hx | hx | hx
    · omega
    · omega
    · exact split_valid (split_valid hr) x hx
  | (u + 2) :: rest, _, hall =>
    have hr : ∀ x ∈ rest, 1 ≤ x := fun x hx => hall x (List.mem_cons_of_mem _ hx)
    obtain ⟨hs, hn⟩ := casc_correct rest [] u (by simp) hr
    simp only [F]
    refine ⟨fun ns' h => ?_, fun h => halts_of_reach ⟨4, wall_halving u rest⟩ (hn h)⟩
    obtain ⟨⟨t, ht⟩, hvn⟩ := hs ns' h
    refine ⟨⟨3 + t, ?_⟩, ?_, hvn⟩
    · have := steps_seq trans (wall_halving u rest) ht
      rwa [show 3 + t + 1 = 4 + t by omega]
    · exact cascM_ne rest [] u ns' h

/-! ## The run from blank tape -/

/-- The run from blank tape is at the wall with the list [1, 1] after 13 steps. -/
theorem blank_to_wall : steps 13 init = some (Wall [1, 1]) :=
  blank_reaches trans (q := .A) (n := 13) (c := ⟨[], [false, false, true, false, false, true], .A⟩) (by decide)

/-- Along the orbit: every list reached is valid and the machine is at its wall after at least t steps. -/
theorem orbit_run (t : Nat) : ∀ ns, orbit t = some ns → Valid ns ∧ ∃ m, t ≤ m ∧ steps m init = some (Wall ns) := by
  induction t with
  | zero =>
    intro ns h
    simp only [orbit, Option.some.injEq] at h
    subst h
    exact ⟨⟨by simp, by simp⟩, 13, by omega, blank_to_wall⟩
  | succ t ih =>
    intro ns h
    simp only [orbit] at h
    cases ho : orbit t with
    | none => rw [ho] at h; cases h
    | some ms =>
      rw [ho] at h
      obtain ⟨hv, m, hm, hrun⟩ := ih ms ho
      obtain ⟨⟨k, hk⟩, hv'⟩ := (F_correct ms hv).1 ns h
      exact ⟨hv', m + (k + 1), by omega, steps_seq trans hrun hk⟩

/-- An orbit that reaches `none` is a halting run. -/
theorem halts_of_orbit_none (t : Nat) (h : orbit t = none) : HaltsFromBlank := by
  induction t with
  | zero => simp [orbit] at h
  | succ t ih =>
    simp only [orbit] at h
    cases ho : orbit t with
    | none => exact ih ho
    | some ms =>
      rw [ho] at h
      obtain ⟨hv, m, _, hrun⟩ := orbit_run t ms ho
      exact halts_of_reach ⟨m, hrun⟩ ((F_correct ms hv).2 h)

/-- **The machine halts from blank tape iff the orbit of [1, 1] under the cascade map reaches `none`**, i.e. iff
some halving cascade runs past the end of the list with a carry that is a power of 2. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ t, orbit t = none := by
  constructor
  · intro hH
    apply Classical.byContradiction
    intro hne
    have hsome : ∀ t, ∃ ns, orbit t = some ns := by
      intro t
      cases ho : orbit t with
      | none => exact absurd ⟨t, ho⟩ hne
      | some ns => exact ⟨ns, rfl⟩
    have hall : ∀ n, ∃ c, steps n init = some c := by
      apply forall_of_unbounded trans (fun m => ∃ ns, steps m init = some (Wall ns))
      · intro n
        obtain ⟨ns, hns⟩ := hsome n
        obtain ⟨_, m, hm, hrun⟩ := orbit_run n ns hns
        exact ⟨m, hm, ns, hrun⟩
      · intro m ⟨ns, h⟩
        exact ⟨_, h⟩
    exact not_halts_of_forall trans hall hH
  · intro ⟨t, h⟩
    exact halts_of_orbit_none t h

end H95916
