    simp only [steps_zero, show cons true (rep (k) [true, true] (cons false (cons false (L)))) = rep (k) [true, true] (cons true (cons false (cons false (L)))) from
      rep_rotate (k) [true] [true, true] [true, true] rfl (cons false (cons false (L)))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
