theorem step_001h7_e (r : Nat) (X : List Bool) (Ltop : Tape) (v0 : List Bool) (R0 : Tape) (hv : 2 ^ (2 * r + 3) ≤ val v0) :
    ∃ z : List Bool, z.length = v0.length + 0 ∧ val z + 8 * 2 ^ (2 * r) + 0 = 1 * val v0 + 0 * 2 ^ (2 * r) + 2 ∧
      Reach ⟨cons false (cons false (app [true, false, false] (encU (rf (2 * r + 2) false ++ [true, false] ++ X) Ltop))), app hdr1 (encV (v0) R0), .D⟩
        ⟨cons false (cons false (app [false, false, false] (encU X Ltop))), app hdr1 (encV (rf (5 * r + 8) true ++ [false, false] ++ z) R0), .D⟩ := by
  have hv' : 8 * 2 ^ (2 * r) ≤ val v0 := by
    rw [show 8 = 2 ^ 3 from rfl, ← Nat.pow_add, Nat.add_comm]; exact hv
  have hQ1 : 1 ≤ 2 ^ (2 * r) := Nat.one_le_two_pow
  generalize hQ : 2 ^ (2 * r) = Q at *
  have hval0 : val (v0) = 0 + 1 * val v0 := by simp [val_append, val] <;> omega
