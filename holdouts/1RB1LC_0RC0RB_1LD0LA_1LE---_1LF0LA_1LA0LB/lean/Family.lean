/-- A tick whose carry ends in a cell 0 of any word (header 0110101, V odd): only that cell is read. `L 0 (00001)^j 00 D> 0 110101 01 R` --> `L 1 (00000)^j 00 D> 0 110101 11 R` -/
theorem carry0_odd (j : Nat) (L R : Tape) :
    steps (10 * j + 34) ⟨cons false (cons false (rep (j) [true, false, false, false, false] (cons false (L)))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ = some ⟨cons false (cons false (rep (j) [false, false, false, false, false] (cons true (L)))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons true (R))))))))), .D⟩ := by
  have h0 : steps 0 ⟨cons false (cons false (rep (j) [true, false, false, false, false] (cons false (L)))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ = some ⟨rep (j) [false, false, true, false, false] (cons false (cons false (cons false (L)))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ := by
    simp only [steps_zero, show cons false (cons false (rep (j) [true, false, false, false, false] (cons false (L)))) = rep (j) [false, false, true, false, false] (cons false (cons false (cons false (L)))) from
      rep_rotate (j) [false, false] [true, false, false, false, false] [false, false, true, false, false] rfl (cons false (L))]
  have c1 : ∀ L R : Tape, steps 5 ⟨app [false, false, true, false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, true, true, true, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 5) ⟨rep (j) [false, false, true, false, false] (cons false (cons false (cons false (L)))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ = some ⟨cons false (cons false (cons false (L))), cons false (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .D⟩ :=
    cross_l trans c1 (j) (cons false (cons false (cons false (L)))) (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))
  have h2 : steps 4 ⟨cons false (cons false (cons false (L))), cons false (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .D⟩ = some ⟨cons true (L), cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ := rfl
  have h3 : steps 0 ⟨cons true (L), cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ = some ⟨cons true (L), rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))) = rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))) from
      rep_rotate (j) [true, true, true] [true, true, true, true, true] [true, true, true, true, true] rfl (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))]
  have c4 : ∀ L R : Tape, steps 5 ⟨app [] L, app [true, true, true, true, true] R, .B⟩ = some ⟨app [] (app [false, false, false, false, false] L), R, .B⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 5) ⟨cons true (L), rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ = some ⟨rep (j) [false, false, false, false, false] (cons true (L)), cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))), .B⟩ :=
    cross_r trans c4 (j) (cons true (L)) (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))))
  have h5 : steps 30 ⟨rep (j) [false, false, false, false, false] (cons true (L)), cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))), .B⟩ = some ⟨cons false (cons false (rep (j) [false, false, false, false, false] (cons true (L)))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons true (R))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 0 + ((j) * 5 + (4 + (0 + ((j) * 5 + (30)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

