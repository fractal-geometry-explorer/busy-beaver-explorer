  have c1 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .C⟩ = some ⟨app [true] (app [false] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((k) * 3) ⟨cons true (cons true (L)), rep (k) [true] (cons false (R)), .C⟩ = some ⟨cons true (rep (k) [false] (cons true (L))), cons false (R), .C⟩ :=
    cross_r trans c1 (k) (cons true (L)) (cons false (R))
  have h2 : steps 1 ⟨cons true (rep (k) [false] (cons true (L))), cons false (R), .C⟩ = some ⟨rep (k) [false] (cons true (L)), cons true (cons true (R)), .A⟩ := rfl
  exact steps_congr trans (a := 2 + ((k) * 3 + (1))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))


