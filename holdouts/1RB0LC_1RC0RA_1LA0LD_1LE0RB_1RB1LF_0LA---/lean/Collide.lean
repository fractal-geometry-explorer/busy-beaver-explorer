  have h6 : steps 25 ⟨cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons false (rep (a + 2) [true, false] (cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank)))))))))))))))), cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), .A⟩ = some ⟨cons false (rep (a + 2) [true, false] (cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank))))))), cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons false (cons false (cons true (blank)))))))))))))))))), .F⟩ := rfl
