    cross_r trans c0 (m + 2) (blank) (cons false (cons false (cons true (cons true (cons false (rep (a + 2) [false, true] (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))))))))
  have h1 : steps 14 ⟨rep (m + 2) [false, true] (blank), cons false (cons false (cons true (cons true (cons false (rep (a + 2) [false, true] (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))))))), .A⟩ = some ⟨cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank))))), cons true (rep (a + 2) [false, true] (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank))))), cons true (rep (a + 2) [false, true] (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank))))), rep (a + 2) [true, false] (cons true (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (a + 2) [false, true] (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))) = rep (a + 2) [true, false] (cons true (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))) from
      rep_rotate (a + 2) [true] [false, true] [true, false] rfl (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))]
  have c3 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((a + 2) * 2) ⟨cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank))))), rep (a + 2) [true, false] (cons true (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank)))))))))))))), .B⟩ = some ⟨rep (a + 2) [true, false] (cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank)))))), cons true (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank))))))))))))), .B⟩ :=
    cross_r trans c3 (a + 2) (cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank)))))) (cons true (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank))))))))))))))
  have h4 : steps 40 ⟨rep (a + 2) [true, false] (cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank)))))), cons true (cons false (cons false (cons true (cons true (cons true (cons true (cons false (cons false (cons false (cons true (cons true (cons false (blank))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (rep (a + 2) [true, false] (cons true (cons false (cons true (cons true (rep (m + 2) [false, true] (blank)))))))))))))))))))), cons true (cons true (blank)), .A⟩ := rfl
