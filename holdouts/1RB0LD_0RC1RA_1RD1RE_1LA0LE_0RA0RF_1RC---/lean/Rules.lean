/-- `k` trips: `1^(3k) (01)^(m+1) C>` becomes `(01)^(m+1+5k) C>`. -/
theorem trips (k : Nat) : ∀ (m : Nat) (L : Tape),
    steps (k * (6 * m + 30) + 15 * (k * k)) ⟨rep (m + 1) [true, false] (rep k [true, true, true] L), blank, .C⟩ =
      some ⟨rep (m + 1 + 5 * k) [true, false] L, blank, .C⟩ := by
  induction k with
  | zero => intro m L; simp
  | succ k ih =>
    intro m L
    have h1 := trip m (rep k [true, true, true] L)
    have e : ∀ s : Tape, cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false
        (rep m [true, false] (cons true (cons false (cons true (cons false s))))))))))))
        = rep (m + 5 + 1) [true, false] s := by
      intro s
      rw [show m + 5 + 1 = 4 + (m + 2) by omega, rep_add, rep_add m 2]
      rfl
    rw [e] at h1
    have h2 := ih (m + 5) L
    have h := steps_seq trans h1 h2
    rw [show m + 5 + 1 + 5 * k = m + 1 + 5 * (k + 1) by omega] at h
    refine steps_congr trans ?_ h
    simp only [Nat.add_mul, Nat.mul_add, Nat.one_mul, Nat.mul_one]
    omega

