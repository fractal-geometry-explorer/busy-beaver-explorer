  have h2 : steps 20 ⟨cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))))), blank, .E⟩ = some ⟨cons false (cons true (blank)), cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))))), .F⟩ := rfl
  have h3 : steps 20 ⟨cons false (cons true (blank)), cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))))), .F⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), cons false (cons false (cons true (cons false (cons true (blank))))), .F⟩ := rfl
  have h4 : steps 9 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), cons false (cons false (cons true (cons false (cons true (blank))))), .F⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))))))), blank, .C⟩ := rfl
  exact steps_congr trans (a := 20 + (20 + (20 + (20 + (9))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))


/-- From blank tape the machine reaches the first stack configuration, `(01)^9 C>`, in 89 steps. -/
theorem start : steps 89 init = some ⟨rep 9 [true, false] blank, blank, .C⟩ := by
  simp only [rep_succ, rep_zero, app_cons, app_nil, cons_false_blank]
  exact start_run

end H47099
