import Machine

/-! Rules of 1RB1RC_0LC1RE_1RA0LD_1LB0RD_0RF---_0RA0RF, generated by `py/rules.py`; do not edit by hand. -/

set_option maxRecDepth 20000
set_option maxHeartbeats 10000000

namespace H1965

open TM

/-- The counter's lowest digit 1 -> 0: the last gap 000 becomes 00 and the block before it gains 3 cells (last block of even length 2y+2; the head at the right end in state A). -/
theorem dec_last (x y : Nat) (L : Tape) :
    steps (6 * y + 16) ⟨cons true (cons true (rep (y) [true, true] (cons false (cons false (cons false (rep (x) [true] (cons false (L)))))))), blank, .A⟩ = some ⟨cons true (cons true (rep (y) [true, true] (cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L)))))))))), blank, .A⟩ := by
  have hn : 3 + (0 + ((y) * 4 + (11 + (0 + ((y) * 2 + (2)))))) = 6 * y + 16 := by omega
  have h0 : steps 3 ⟨cons true (cons true (rep (y) [true, true] (cons false (cons false (cons false (rep (x) [true] (cons false (L)))))))), blank, .A⟩ = some ⟨cons true (rep (y) [true, true] (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))), cons true (cons false (cons false (blank))), .D⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (y) [true, true] (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))), cons true (cons false (cons false (blank))), .D⟩ = some ⟨rep (y) [true, true] (cons true (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))), cons true (cons false (cons false (blank))), .D⟩ := by
    simp only [steps_zero, show cons true (rep (y) [true, true] (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))) = rep (y) [true, true] (cons true (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))) from
      rep_rotate (y) [true] [true, true] [true, true] rfl (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true, false] R, .D⟩ = some ⟨L, app [true, false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h2 : steps ((y) * 4) ⟨rep (y) [true, true] (cons true (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))), cons true (cons false (cons false (blank))), .D⟩ = some ⟨cons true (cons false (cons false (cons false (rep (x) [true] (cons false (L)))))), cons true (cons false (rep (y) [false, true] (cons false (blank)))), .D⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 4) ⟨rep k [true, true] (L), cons true (cons false (R)), .D⟩ = some ⟨L, cons true (cons false (rep k [false, true] (R))), .D⟩ from cross_l trans c2) (y) (cons true (cons false (cons false (cons false (rep (x) [true] (cons false (L))))))) (cons false (blank))
  have h3 : steps 11 ⟨cons true (cons false (cons false (cons false (rep (x) [true] (cons false (L)))))), cons true (cons false (rep (y) [false, true] (cons false (blank)))), .D⟩ = some ⟨cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (rep (y) [false, true] (cons false (blank))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (rep (y) [false, true] (cons false (blank))), .A⟩ = some ⟨cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L))))))), rep (y) [true, false] (cons true (cons false (blank))), .A⟩ := by
    simp only [steps_zero, show cons true (rep (y) [false, true] (cons false (blank))) = rep (y) [true, false] (cons true (cons false (blank))) from
      rep_rotate (y) [true] [false, true] [true, false] rfl (cons false (blank))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((y) * 2) ⟨cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L))))))), rep (y) [true, false] (cons true (cons false (blank))), .A⟩ = some ⟨rep (y) [true, true] (cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L)))))))), cons true (cons false (blank)), .A⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 2) ⟨L, rep k [true, false] (R), .A⟩ = some ⟨rep k [true, true] (L), R, .A⟩ from cross_r trans c5) (y) (cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L)))))))) (cons true (cons false (blank)))
  have h6 : steps 2 ⟨rep (y) [true, true] (cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L)))))))), cons true (cons false (blank)), .A⟩ = some ⟨cons true (cons true (rep (y) [true, true] (cons false (cons false (cons true (cons true (cons true (rep (x) [true] (cons false (L)))))))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


/-- At the right end, A writes a 1 and turns: the leftward sweep starts on that 1. -/
theorem p_start (L : Tape) :
    steps (2) ⟨L, blank, .A⟩ = some ⟨L, cons true (cons false (blank)), .C⟩ := by
  have hn : 2 = 2 := by omega
  have h0 : steps 2 ⟨L, blank, .A⟩ = some ⟨L, cons true (cons false (blank)), .C⟩ := rfl
  exact steps_congr trans hn (h0)


/-- The sweep crosses an odd block whose gap on the left is 00 (the block before is nonempty): it is left in the sparse form 0 1 0 (01)^w and the sweep goes on in the block before. -/
theorem p_pass (w : Nat) (L R : Tape) :
    steps (4 * w + 3) ⟨rep (w) [true, true] (cons false (cons false (cons true (L)))), cons true (R), .C⟩ = some ⟨L, cons true (cons false (cons true (cons false (rep (w) [false, true] (R))))), .C⟩ := by
  have hn : (w) * 4 + (3) = 4 * w + 3 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((w) * 4) ⟨rep (w) [true, true] (cons false (cons false (cons true (L)))), cons true (R), .C⟩ = some ⟨cons false (cons false (cons true (L))), cons true (rep (w) [false, true] (R)), .C⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 4) ⟨rep k [true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep k [false, true] (R)), .C⟩ from cross_l trans c0) (w) (cons false (cons false (cons true (L)))) (R)
  have h1 : steps 3 ⟨cons false (cons false (cons true (L))), cons true (rep (w) [false, true] (R)), .C⟩ = some ⟨L, cons true (cons false (cons true (cons false (rep (w) [false, true] (R))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- The sweep stops at an odd block whose gap on the left is 000: a 1 is written in the gap and A turns right. -/
theorem p_stop_odd (w : Nat) (L R : Tape) :
    steps (4 * w + 4) ⟨rep (w) [true, true] (cons false (cons false (cons false (L)))), cons true (R), .C⟩ = some ⟨cons true (L), cons false (cons true (cons false (rep (w) [false, true] (R)))), .A⟩ := by
  have hn : (w) * 4 + (4) = 4 * w + 4 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((w) * 4) ⟨rep (w) [true, true] (cons false (cons false (cons false (L)))), cons true (R), .C⟩ = some ⟨cons false (cons false (cons false (L))), cons true (rep (w) [false, true] (R)), .C⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 4) ⟨rep k [true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep k [false, true] (R)), .C⟩ from cross_l trans c0) (w) (cons false (cons false (cons false (L)))) (R)
  have h1 : steps 4 ⟨cons false (cons false (cons false (L))), cons true (rep (w) [false, true] (R)), .C⟩ = some ⟨cons true (L), cons false (cons true (cons false (rep (w) [false, true] (R)))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- The sweep stops at an even block (any gap of at least one 0 on its left): A turns right. -/
theorem p_stop_even (w : Nat) (L R : Tape) :
    steps (4 * w + 5) ⟨rep (w) [true, true] (cons true (cons false (L))), cons true (R), .C⟩ = some ⟨cons true (L), cons false (cons true (rep (w) [false, true] (R))), .A⟩ := by
  have hn : (w) * 4 + (5) = 4 * w + 5 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((w) * 4) ⟨rep (w) [true, true] (cons true (cons false (L))), cons true (R), .C⟩ = some ⟨cons true (cons false (L)), cons true (rep (w) [false, true] (R)), .C⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 4) ⟨rep k [true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep k [false, true] (R)), .C⟩ from cross_l trans c0) (w) (cons true (cons false (L))) (R)
  have h1 : steps 5 ⟨cons true (cons false (L)), cons true (rep (w) [false, true] (R)), .C⟩ = some ⟨cons true (L), cons false (cons true (rep (w) [false, true] (R))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- The only way the sweep can halt: an odd block whose gap on the left is a single 0 (state E then reads a 1). -/
theorem p_halt (w : Nat) (L R : Tape) :
    steps (4 * w + 3) ⟨rep (w) [true, true] (cons false (cons true (L))), cons true (R), .C⟩ = some ⟨cons true (L), cons true (cons false (rep (w) [false, true] (R))), .E⟩ := by
  have hn : (w) * 4 + (3) = 4 * w + 3 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((w) * 4) ⟨rep (w) [true, true] (cons false (cons true (L))), cons true (R), .C⟩ = some ⟨cons false (cons true (L)), cons true (rep (w) [false, true] (R)), .C⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 4) ⟨rep k [true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep k [false, true] (R)), .C⟩ from cross_l trans c0) (w) (cons false (cons true (L))) (R)
  have h1 : steps 3 ⟨cons false (cons true (L)), cons true (rep (w) [false, true] (R)), .C⟩ = some ⟨cons true (L), cons true (cons false (rep (w) [false, true] (R))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- Refilling, first segment: 0 1 0 0 1 (01)^w becomes 1 1 0 0 (11)^w (the old 000 gap is now 00). -/
theorem p_fill_first (w : Nat) (L R : Tape) :
    steps (2 * w + 4) ⟨L, cons false (cons true (cons false (cons false (cons true (rep (w) [false, true] (R)))))), .A⟩ = some ⟨rep (w) [true, true] (cons false (cons false (cons true (cons true (L))))), cons true (R), .A⟩ := by
  have hn : 4 + (0 + ((w) * 2)) = 2 * w + 4 := by omega
  have h0 : steps 4 ⟨L, cons false (cons true (cons false (cons false (cons true (rep (w) [false, true] (R)))))), .A⟩ = some ⟨cons false (cons false (cons true (cons true (L)))), cons true (rep (w) [false, true] (R)), .A⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons false (cons true (cons true (L)))), cons true (rep (w) [false, true] (R)), .A⟩ = some ⟨cons false (cons false (cons true (cons true (L)))), rep (w) [true, false] (cons true (R)), .A⟩ := by
    simp only [steps_zero, show cons true (rep (w) [false, true] (R)) = rep (w) [true, false] (cons true (R)) from
      rep_rotate (w) [true] [false, true] [true, false] rfl (R)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h2 : steps ((w) * 2) ⟨cons false (cons false (cons true (cons true (L)))), rep (w) [true, false] (cons true (R)), .A⟩ = some ⟨rep (w) [true, true] (cons false (cons false (cons true (cons true (L))))), cons true (R), .A⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 2) ⟨L, rep k [true, false] (R), .A⟩ = some ⟨rep k [true, true] (L), R, .A⟩ from cross_r trans c2) (w) (cons false (cons false (cons true (cons true (L))))) (cons true (R))
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- Refilling across a segment boundary: 1 0 1 0 becomes 1 1 1 1. -/
theorem p_fill_two (L R : Tape) :
    steps (4) ⟨L, cons true (cons false (cons true (cons false (R)))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), R, .A⟩ := by
  have hn : 4 = 4 := by omega
  have h0 : steps 4 ⟨L, cons true (cons false (cons true (cons false (R)))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), R, .A⟩ := rfl
  exact steps_congr trans hn (h0)


/-- Refilling a later segment: (01)^(v+3) becomes 1 1 0 0 0 (11)^v and a 1 (the old 00 gap is now 000). -/
theorem p_fill_mid (v : Nat) (L R : Tape) :
    steps (2 * v + 5) ⟨L, cons false (cons true (cons false (cons true (cons false (cons true (rep (v) [false, true] (R))))))), .A⟩ = some ⟨rep (v) [true, true] (cons false (cons false (cons false (cons true (cons true (L)))))), cons true (R), .A⟩ := by
  have hn : 5 + (0 + ((v) * 2)) = 2 * v + 5 := by omega
  have h0 : steps 5 ⟨L, cons false (cons true (cons false (cons true (cons false (cons true (rep (v) [false, true] (R))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons true (cons true (L))))), cons true (rep (v) [false, true] (R)), .A⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons false (cons false (cons true (cons true (L))))), cons true (rep (v) [false, true] (R)), .A⟩ = some ⟨cons false (cons false (cons false (cons true (cons true (L))))), rep (v) [true, false] (cons true (R)), .A⟩ := by
    simp only [steps_zero, show cons true (rep (v) [false, true] (R)) = rep (v) [true, false] (cons true (R)) from
      rep_rotate (v) [true] [false, true] [true, false] rfl (R)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h2 : steps ((v) * 2) ⟨cons false (cons false (cons false (cons true (cons true (L))))), rep (v) [true, false] (cons true (R)), .A⟩ = some ⟨rep (v) [true, true] (cons false (cons false (cons false (cons true (cons true (L)))))), cons true (R), .A⟩ :=
    (show ∀ k : Nat, ∀ L R : Tape, steps (k * 2) ⟨L, rep k [true, false] (R), .A⟩ = some ⟨rep k [true, true] (L), R, .A⟩ from cross_r trans c2) (v) (cons false (cons false (cons false (cons true (cons true (L)))))) (cons true (R))
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- The last 1 before blank tape: A comes back to the right end. -/
theorem p_fill_end (L : Tape) :
    steps (2) ⟨L, cons true (blank), .A⟩ = some ⟨cons true (cons true (L)), blank, .A⟩ := by
  have hn : 2 = 2 := by omega
  have h0 : steps 2 ⟨L, cons true (blank), .A⟩ = some ⟨cons true (cons true (L)), blank, .A⟩ := rfl
  exact steps_congr trans hn (h0)


end H1965
