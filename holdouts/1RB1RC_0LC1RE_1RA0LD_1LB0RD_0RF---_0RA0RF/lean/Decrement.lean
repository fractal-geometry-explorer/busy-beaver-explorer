import Rules

/-!
# The ordinary decrement of the counter, for any number of blocks

Written by hand: the pieces of `Rules.lean` (generated by `py/rules.py`, each for every length) composed by
induction over the list of blocks the sweep crosses.

At the right end, in state A, written left to right with the head at the right:

    L 000 1^(2a+1) 00 1^(2b₁+1) ... 00 1^(2bᵣ+1) 00 1^(2m) A>

(the gaps are the digits of the counter, `00` = 0 and `000` = 1, the lowest at the right).  One visit of the right
end gives

    L 111 00 1^(2a+4) 000 1^(2b₁) ... 000 1^(2bᵣ) 000 1^(2m-4) A>

the counter going down by one, with the block changes `+3`, `+3`, `-1` each, `-4` of `py/counter.py`.  It needs
`a ≥ 1`, every `b ≥ 3` and `m ≥ 3` (short blocks take other paths through the pieces).  In Lean the left of the
head is written nearest first: `rep m [true, true] (chainL (bs ++ [a]) (000 L))` with `bs = [bᵣ, ..., b₁]`.
-/

namespace H1965

open TM

/-- `c` reaches `c'` in some number of steps. -/
def Reach (c c' : Config) : Prop := ∃ n, steps n c = some c'

theorem Reach.of {n : Nat} {c c' : Config} (h : steps n c = some c') : Reach c c' := ⟨n, h⟩

theorem Reach.trans {a b c : Config} (h1 : Reach a b) (h2 : Reach b c) : Reach a c := by
  obtain ⟨n, hn⟩ := h1
  obtain ⟨m, hm⟩ := h2
  exact ⟨n + m, steps_seq H1965.trans hn hm⟩

/-- Left of the head (nearest first): the gap `00`, then an odd block `1^(2b+1)`. -/
def gapOdd (b : Nat) (t : Tape) : Tape := cons false (cons false (cons true (rep b [true, true] t)))

/-- A list of such gaps and blocks, nearest the head first. -/
def chainL : List Nat → Tape → Tape
  | [], t => t
  | b :: bs, t => gapOdd b (chainL bs t)

/-- Right of the head: the sparse segment `0 1 0 (01)^k` that the sweep leaves of the block `1^(2k+1)`. -/
def seg (k : Nat) (R : Tape) : Tape := cons false (cons true (cons false (rep k [false, true] R)))

/-- A list of segments, nearest the head first. -/
def chainR : List Nat → Tape → Tape
  | [], R => R
  | k :: ks, R => seg k (chainR ks R)

/-- Left of the head (nearest first): the gap `000`, then an even block `1^(2b)`. -/
def chainE : List Nat → Tape → Tape
  | [], t => t
  | b :: bs, t => cons false (cons false (cons false (rep b [true, true] (chainE bs t))))

theorem chainR_append (xs ys : List Nat) (R : Tape) : chainR (xs ++ ys) R = chainR xs (chainR ys R) := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp only [List.cons_append, chainR, ih]

theorem chainE_append (xs ys : List Nat) (t : Tape) : chainE (xs ++ ys) t = chainE xs (chainE ys t) := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp only [List.cons_append, chainE, ih]

/-- The leftward sweep crosses every odd block behind a gap `00`, whatever their number and lengths, leaving each in
its sparse form. -/
theorem sweep (a : Nat) (T : Tape) : ∀ (bs : List Nat) (k : Nat) (R : Tape),
    Reach ⟨rep k [true, true] (chainL (bs ++ [a]) T), cons true R, .C⟩
          ⟨rep a [true, true] T, cons true (chainR (List.reverse (k :: bs)) R), .C⟩
  | [], k, R => Reach.of (p_pass k (rep a [true, true] T) R)
  | b :: bs, k, R => by
    have h1 := p_pass k (rep b [true, true] (chainL (bs ++ [a]) T)) R
    have h2 := sweep a T bs b (seg k R)
    have e : chainR (List.reverse (k :: b :: bs)) R = chainR (List.reverse (b :: bs)) (seg k R) := by
      rw [List.reverse_cons (a := k), chainR_append]; rfl
    rw [e]
    exact (Reach.of h1).trans h2

/-- What the refill leaves left of the head, with `rep u [true, true] t` left of the head before it. -/
def refill : List Nat → Nat → Tape → Tape
  | [], u, t => rep (u + 1) [true, true] t
  | c :: cs, u, t => refill cs (c - 3) (cons false (cons false (cons false (rep (u + 3) [true, true] t))))

/-- The rightward refill: A turns every segment `0 1 0 (01)^c` (c ≥ 3) back into 1s, the gaps `00` into `000`, and
comes back to the right end. -/
theorem refill_run : ∀ (cs : List Nat), (∀ c ∈ cs, 3 ≤ c) → ∀ (u : Nat) (t : Tape),
    Reach ⟨rep u [true, true] t, cons true (chainR cs blank), .A⟩ ⟨refill cs u t, blank, .A⟩
  | [], _, u, t => Reach.of (p_fill_end (rep u [true, true] t))
  | c :: cs, h, u, t => by
    obtain ⟨v, rfl⟩ : ∃ v, c = v + 3 := ⟨c - 3, by have := h c (List.mem_cons_self ..); omega⟩
    have h1 := p_fill_two (rep u [true, true] t) (rep (v + 3) [false, true] (chainR cs blank))
    have h2 := p_fill_mid v (cons true (cons true (cons true (cons true (rep u [true, true] t)))))
      (chainR cs blank)
    have h3 := refill_run cs (fun c hc => h c (List.mem_cons_of_mem _ hc)) v
      (cons false (cons false (cons false (rep (u + 3) [true, true] t))))
    have e : refill ((v + 3) :: cs) u t = refill cs v (cons false (cons false (cons false (rep (u + 3) [true, true] t)))) := by
      simp only [refill, Nat.add_sub_cancel]
    rw [e]
    exact (Reach.of h1).trans ((Reach.of h2).trans h3)

theorem refill_eq (m : Nat) (hm : 3 ≤ m) : ∀ (ys : List Nat), (∀ y ∈ ys, 3 ≤ y) → ∀ (u : Nat) (t : Tape),
    refill (ys ++ [m]) u t =
      rep (m - 2) [true, true] (chainE (List.reverse ys) (cons false (cons false (cons false (rep (u + 3) [true, true] t)))))
  | [], _, u, t => by
    have e : m - 3 + 1 = m - 2 := by omega
    simp only [List.nil_append, refill, e, List.reverse_nil, chainE]
  | y :: ys, h, u, t => by
    obtain ⟨v, rfl⟩ : ∃ v, y = v + 3 := ⟨y - 3, by have := h y (List.mem_cons_self ..); omega⟩
    have ih := refill_eq m hm ys (fun c hc => h c (List.mem_cons_of_mem _ hc)) v
      (cons false (cons false (cons false (rep (u + 3) [true, true] t))))
    simp only [List.cons_append, refill, Nat.add_sub_cancel]
    rw [ih, List.reverse_cons, chainE_append]
    rfl

/-- **The ordinary decrement, for any number of blocks** (see the header for the tape-order form). -/
theorem dec_general (L : Tape) (a m : Nat) (bs : List Nat) (ha : 1 ≤ a) (hm : 3 ≤ m) (hb : ∀ b ∈ bs, 3 ≤ b) :
    Reach ⟨rep m [true, true] (chainL (bs ++ [a]) (cons false (cons false (cons false L)))), blank, .A⟩
      ⟨rep (m - 2) [true, true] (chainE bs (cons false (cons false (cons false (rep (a + 2) [true, true]
        (cons false (cons false (cons true (cons true (cons true L)))))))))), blank, .A⟩ := by
  obtain ⟨a', rfl⟩ : ∃ a', a = a' + 1 := ⟨a - 1, by omega⟩
  have h0 := p_start (rep m [true, true] (chainL (bs ++ [a' + 1]) (cons false (cons false (cons false L)))))
  rw [cons_false_blank] at h0
  have h1 := sweep (a' + 1) (cons false (cons false (cons false L))) bs m blank
  have h2 := p_stop_odd (a' + 1) L (chainR (List.reverse (m :: bs)) blank)
  have h3 := p_fill_first a' (cons true L) (chainR (List.reverse (m :: bs)) blank)
  have hcs : ∀ c ∈ List.reverse (m :: bs), 3 ≤ c := by
    intro c hc
    rw [List.mem_reverse, List.mem_cons] at hc
    rcases hc with rfl | hc
    · exact hm
    · exact hb c hc
  have h4 := refill_run (List.reverse (m :: bs)) hcs a'
    (cons false (cons false (cons true (cons true (cons true L)))))
  have e := refill_eq m hm (List.reverse bs) (fun y hy => hb y (List.mem_reverse.mp hy)) a'
    (cons false (cons false (cons true (cons true (cons true L)))))
  have e' : refill (List.reverse (m :: bs)) a' (cons false (cons false (cons true (cons true (cons true L))))) =
      rep (m - 2) [true, true] (chainE bs (cons false (cons false (cons false (rep (a' + 3) [true, true]
        (cons false (cons false (cons true (cons true (cons true L)))))))))) := by
    rw [List.reverse_cons, e, List.reverse_reverse]
  rw [e'] at h4
  rw [show a' + 1 + 2 = a' + 3 by omega]
  exact (Reach.of h0).trans (h1.trans ((Reach.of h2).trans ((Reach.of h3).trans h4)))

end H1965
