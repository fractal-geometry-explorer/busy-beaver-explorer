/-- From P(n), C sweeps left: (10)^n becomes 1^(2n+2). -/
theorem r_sweep (n : Nat) :
    steps (2 * n + 2) ⟨rep (n) [false, true] (blank), blank, .A⟩ = some ⟨blank, cons true (rep (n) [true, true] (cons true (blank))), .C⟩ := by
  have h0 : steps 2 ⟨rep (n) [false, true] (blank), blank, .A⟩ = some ⟨rep (n) [false, true] (blank), cons true (cons true (blank)), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨rep (n) [false, true] (blank), cons true (cons true (blank)), .C⟩ = some ⟨blank, cons true (rep (n) [true, true] (cons true (blank))), .C⟩ :=
    cross_l trans c1 (n) (blank) (cons true (blank))
  exact steps_congr trans (a := 2 + ((n) * 2)) (by omega) (steps_seq trans h0 (h1))

