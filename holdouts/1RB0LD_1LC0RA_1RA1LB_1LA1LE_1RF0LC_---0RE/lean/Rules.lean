theorem r_t2 (c : Nat) :
    steps (2 * c + 8) ⟨cons true (blank), rep (c + 1) [true, false] (rep (2) [true] (blank)), .F⟩ = some ⟨rep (c + 1) [true, false] (cons true (blank)), cons true (cons true (cons true (blank))), .B⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .F⟩ = some ⟨app [] (app [true, false] L), R, .F⟩ := fun _ _ => rfl
  have h0 : steps ((c + 1) * 2) ⟨cons true (blank), rep (c + 1) [true, false] (rep (2) [true] (blank)), .F⟩ = some ⟨rep (c + 1) [true, false] (cons true (blank)), rep (2) [true] (blank), .F⟩ :=
    cross_r trans c0 (c + 1) (cons true (blank)) (rep (2) [true] (blank))
  have h1 : steps 6 ⟨rep (c + 1) [true, false] (cons true (blank)), rep (2) [true] (blank), .F⟩ = some ⟨rep (c + 1) [true, false] (cons true (blank)), cons true (cons true (cons true (blank))), .B⟩ := rfl
  exact steps_congr trans (a := (c + 1) * 2 + (6)) (by omega) (steps_seq trans h0 (h1))

/-- T with no 1s left: F reaches blank tape (and halts there). -/
theorem r_t0 (c : Nat) :
    steps (2 * c) ⟨cons true (blank), rep (c) [true, false] (blank), .F⟩ = some ⟨rep (c) [true, false] (cons true (blank)), blank, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .F⟩ = some ⟨app [] (app [true, false] L), R, .F⟩ := fun _ _ => rfl
  have h0 : steps ((c) * 2) ⟨cons true (blank), rep (c) [true, false] (blank), .F⟩ = some ⟨rep (c) [true, false] (cons true (blank)), blank, .F⟩ :=
    cross_r trans c0 (c) (cons true (blank)) (blank)
  exact steps_congr trans (a := (c) * 2) (by omega) (h0)

/-- T with one 1 left: F reaches blank tape (and halts there). -/
theorem r_t1 (c : Nat) :
    steps (2 * c + 2) ⟨cons true (blank), rep (c) [true, false] (rep (1) [true] (blank)), .F⟩ = some ⟨cons true (cons false (rep (c) [true, false] (cons true (blank)))), blank, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .F⟩ = some ⟨app [] (app [true, false] L), R, .F⟩ := fun _ _ => rfl
  have h0 : steps ((c) * 2) ⟨cons true (blank), rep (c) [true, false] (rep (1) [true] (blank)), .F⟩ = some ⟨rep (c) [true, false] (cons true (blank)), rep (1) [true] (blank), .F⟩ :=
    cross_r trans c0 (c) (cons true (blank)) (rep (1) [true] (blank))
  have h1 : steps 2 ⟨rep (c) [true, false] (cons true (blank)), rep (1) [true] (blank), .F⟩ = some ⟨cons true (cons false (rep (c) [true, false] (cons true (blank)))), blank, .F⟩ := rfl
  exact steps_congr trans (a := (c) * 2 + (2)) (by omega) (steps_seq trans h0 (h1))

/-- One round of the final sweep: two 1s become a (10) on the left. -/
theorem r_xround (c m : Nat) :
    steps (4 * c + 10) ⟨rep (c) [true, false] (cons true (blank)), rep (m + 2) [true] (blank), .B⟩ = some ⟨cons true (cons false (rep (c) [true, false] (cons true (cons false (cons true (blank)))))), rep (m) [true] (blank), .B⟩ := by
  have h0 : steps 2 ⟨rep (c) [true, false] (cons true (blank)), rep (m + 2) [true] (blank), .B⟩ = some ⟨rep (c) [true, false] (cons true (blank)), cons false (cons false (rep (m) [true] (blank))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((c) * 2) ⟨rep (c) [true, false] (cons true (blank)), cons false (cons false (rep (m) [true] (blank))), .D⟩ = some ⟨cons true (blank), cons false (rep (c) [false, true] (cons false (rep (m) [true] (blank)))), .D⟩ :=
    cross_l trans c1 (c) (cons true (blank)) (cons false (rep (m) [true] (blank)))
  have h2 : steps 6 ⟨cons true (blank), cons false (rep (c) [false, true] (cons false (rep (m) [true] (blank)))), .D⟩ = some ⟨cons true (cons false (cons true (blank))), cons true (rep (c) [false, true] (cons false (rep (m) [true] (blank)))), .B⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons false (cons true (blank))), cons true (rep (c) [false, true] (cons false (rep (m) [true] (blank)))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), rep (c) [true, false] (cons true (cons false (rep (m) [true] (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (c) [false, true] (cons false (rep (m) [true] (blank)))) = rep (c) [true, false] (cons true (cons false (rep (m) [true] (blank)))) from
      rep_rotate (c) [true] [false, true] [true, false] rfl (cons false (rep (m) [true] (blank)))]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h4 : steps ((c) * 2) ⟨cons true (cons false (cons true (blank))), rep (c) [true, false] (cons true (cons false (rep (m) [true] (blank)))), .B⟩ = some ⟨rep (c) [true, false] (cons true (cons false (cons true (blank)))), cons true (cons false (rep (m) [true] (blank))), .B⟩ :=
    cross_r trans c4 (c) (cons true (cons false (cons true (blank)))) (cons true (cons false (rep (m) [true] (blank))))
  have h5 : steps 2 ⟨rep (c) [true, false] (cons true (cons false (cons true (blank)))), cons true (cons false (rep (m) [true] (blank))), .B⟩ = some ⟨cons true (cons false (rep (c) [true, false] (cons true (cons false (cons true (blank)))))), rep (m) [true] (blank), .B⟩ := rfl
  exact steps_congr trans (a := 2 + ((c) * 2 + (6 + (0 + ((c) * 2 + (2)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The final sweep ends: P(c+1). -/
theorem r_xend (c : Nat) :
    steps (1) ⟨rep (c) [true, false] (cons true (blank)), rep (1) [true] (blank), .B⟩ = some ⟨cons false (rep (c) [true, false] (cons true (blank))), blank, .A⟩ := by
  have h0 : steps 1 ⟨rep (c) [true, false] (cons true (blank)), rep (1) [true] (blank), .B⟩ = some ⟨cons false (rep (c) [true, false] (cons true (blank))), blank, .A⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

end H50372
