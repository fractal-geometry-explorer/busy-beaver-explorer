import Rules

/-!
# The macro step of 1RB0LD_1LC0RA_1RA1LB_1LA1LE_1RF0LC_---0RE

The run from blank tape passes through the configurations

* `P n  =  0^∞ (10)^n A> 0^∞`                       (the head at the right end of the tape),

and between two of them it does the following (every rule is in `Rules.lean`, generated by `py/rules.py`):

* `P n` sweeps left and starts a *doubling phase* `T 1 (2n+2)`, with
  `T c m = 0^∞ 1 F> (10)^c 1^m 0^∞`;
* a doubling round `T c (m + 2c + 6) → T (2c+4) m` (`t_round`) goes through the zigzag
  `S a b m = 0^∞ (10)^a 1 1 A> (01)^b 1^m 0^∞`, which moves one `10` from the left into two `01` on the right and uses
  two of the 1s per zigzag (`zig_iter`);
* when fewer than `2c + 6` ones are left the phase ends (`tend`): with 0 or 1 ones left **the machine halts**
  (`T0_halts`, `T1_halts`); otherwise the final sweep `X c m = 0^∞ 1 (01)^c B> 1^m 0^∞` turns two 1s at a time into
  a `10` (`x_iter`) and stops at the next `P`.

`tphase c m` computes the end of the phase that starts at `T c m` (with its exact step count) and `tphase_sound` says
the machine really does it.  `pstep n` is the macro step from `P n`; `pstep_sound` is the theorem: for every `n`,
`P n` reaches `P n'` after exactly the steps `pstep` gives, or halts.  All of it is checked by Lean's kernel.
-/

namespace H50372

open TM

/-! ## The macro configurations -/

def P (n : Nat) : Config := ⟨rep n [false, true] blank, blank, .A⟩
def T (c m : Nat) : Config := ⟨cons true blank, rep c [true, false] (rep m [true] blank), .F⟩
def S (a b m : Nat) : Config :=
  ⟨cons true (cons true (rep a [false, true] blank)), rep b [false, true] (rep m [true] blank), .A⟩
def X (c m : Nat) : Config := ⟨rep c [true, false] (cons true blank), rep m [true] blank, .B⟩

/-! ## Tape identities -/

theorem rot (a b : Bool) (n : Nat) (s : Tape) : rep n [a, b] (cons a s) = cons a (rep n [b, a] s) := by
  have h := rep_rotate n [a] [b, a] [a, b] rfl s
  simp only [app_cons, app_nil] at h
  exact h.symm

theorem ones_comm (n : Nat) (s : Tape) : rep n [true] (cons true s) = rep (n + 1) [true] s := by
  have h := rep_app_comm n [true] s
  simp only [app_cons, app_nil] at h
  exact h

theorem rep_two (n : Nat) (s : Tape) : rep n [true, true] s = rep (2 * n) [true] s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega, rep_succ, ih, rep_succ, rep_succ]
    simp only [app_cons, app_nil]

/-- `rep (n+2) w s` with the last copy written out (useful after a zigzag). -/
theorem rep_back (n : Nat) (w : List Bool) (s : Tape) : rep (n + 1) w s = rep n w (app w s) :=
  (rep_app_comm n w s).symm

/-! ## The rules in terms of the macro configurations -/

theorem sweep_start (n : Nat) : steps (2 * n + 8) (P n) = some (T 1 (2 * n + 2)) := by
  have h₁ := r_sweep n
  rw [rep_two, ones_comm] at h₁
  have h₂ := r_start (2 * n)
  have e : steps (2 * n + 1 + 1) ⟨rep n [false, true] blank, blank, .A⟩ = some ⟨blank, cons true (rep (2 * n + 1) [true] blank), .C⟩ := h₁
  rw [rep_succ] at e
  simp only [app_cons, app_nil] at e
  have h := steps_seq trans e h₂
  rw [show 2 * n + 1 + 1 + 6 = 2 * n + 8 by omega] at h
  simpa [P, T, rep_succ] using h

theorem ts (c m : Nat) : steps (2 * c + 3) (T c (m + 3)) = some (S c 1 m) := by
  have h := r_ts c m
  rw [rot] at h
  simpa [T, S, rep_succ] using h

theorem zig (a b m : Nat) : steps (4 * b + 8) (S (a + 1) (b + 1) (m + 2)) = some (S a (b + 3) m) := by
  have h := r_zig a b m
  have e : rep (b + 3) [false, true] (rep m [true] blank)
      = cons false (cons true (cons false (cons true (rep b [false, true] (cons false (rep (m + 1) [true] blank)))))) := by
    rw [show b + 3 = (b + 1) + 2 by omega, rep_succ, rep_succ, rep_back]
    simp [rep_succ]
  simp only [S]
  rw [e]
  exact h

theorem st (b m : Nat) : steps (8 * b + 23) (S 0 (b + 1) (m + 3)) = some (T (b + 4) m) := by
  have h := r_st b m
  have e : rep (b + 4) [true, false] (rep m [true] blank)
      = cons true (cons false (cons true (cons false (cons true (cons false (rep b [true, false]
          (cons true (cons false (rep m [true] blank))))))))) := by
    rw [show b + 4 = (b + 1) + 3 by omega, rep_succ, rep_succ, rep_succ, rep_back]
    simp
  simp only [S, T]
  rw [e]
  simpa using h

theorem e0 (a b : Nat) : steps (4 * b + 7) (S (a + 1) (b + 1) 0) = some (X (a + 1) (2 * b + 5)) := by
  have h₁ := r_e0 a b
  rw [rep_two, ones_comm] at h₁
  have h₂ := r_e0b a (2 * (b + 1) + 1)
  have h := steps_seq trans h₁ h₂
  simp only [S, X]
  rw [rot, show 4 * b + 7 = 4 * b + 6 + 1 by omega, show 2 * b + 5 = 2 * (b + 1) + 1 + 2 by omega]
  simpa [rep_succ] using h

theorem e1 (a b : Nat) : steps (8 * b + 4 * a + 29) (S (a + 1) (b + 1) 1) = some (X (a + 2) (2 * b + 5)) := by
  have h₁ := r_e1 a b
  rw [rep_two, ones_comm] at h₁
  have e : cons true (cons true (cons true (rep (2 * b + 1) [true] blank))) = cons true (rep (2 * b + 3) [true] blank) := by
    simp [rep_succ]
  rw [e] at h₁
  have h₂ := r_e1b a (2 * b + 3)
  have h := steps_seq trans h₁ h₂
  have e2 : rep (a + 2) [true, false] (cons true blank)
      = cons true (cons false (rep a [true, false] (cons true (cons false (cons true blank))))) := by
    rw [rep_succ, rep_back]
    simp
  simp only [S, X]
  rw [e2, show 8 * b + 4 * a + 29 = 8 * b + 16 + (4 * a + 13) by omega, show 2 * b + 5 = 2 * b + 3 + 2 by omega]
  simpa [rep_succ] using h

theorem s00 (b : Nat) : steps (4 * b + 7) (S 0 (b + 1) 0) = some (X 0 (2 * b + 5)) := by
  have h₁ := r_s00 b
  rw [rep_two, ones_comm] at h₁
  have h₂ := r_s00b (2 * (b + 1) + 1)
  have h := steps_seq trans h₁ h₂
  simp only [S, X]
  rw [show 2 * b + 5 = 2 * (b + 1) + 1 + 2 by omega]
  simpa [rep_succ] using h

theorem s01 (b : Nat) : steps (8 * b + 25) (S 0 (b + 1) 1) = some (X 1 (2 * b + 5)) := by
  have h₁ := r_s01 b
  rw [rep_two, ones_comm] at h₁
  have e : cons true (cons true (cons true (rep (2 * b + 1) [true] blank))) = cons true (rep (2 * b + 3) [true] blank) := by
    simp [rep_succ]
  rw [e] at h₁
  have h₂ := r_s01b (2 * b + 3)
  have h := steps_seq trans h₁ h₂
  simp only [S, X]
  rw [show 8 * b + 25 = 8 * b + 16 + 9 by omega, show 2 * b + 5 = 2 * b + 3 + 2 by omega]
  simpa [rep_succ] using h

theorem s02 (b : Nat) : steps (8 * b + 65) (S 0 (b + 1) 2) = some (X 5 (2 * b + 3)) := by
  have h₁ := r_s02 b
  rw [rep_two] at h₁
  have e : cons true (rep (2 * b) [true] (cons true (cons true (cons true blank))))
      = cons true (cons true (rep (2 * b + 2) [true] blank)) := by
    rw [ones_comm, ones_comm, ones_comm]
    simp [rep_succ]
  rw [e] at h₁
  have e2 : cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true blank)))))))
      = rep 4 [false, true] blank := rfl
  rw [e2] at h₁
  have h₂ := r_s02b (2 * b + 2)
  have h := steps_seq trans h₁ h₂
  simp only [S, X]
  rw [show 8 * b + 65 = 8 * b + 44 + 21 by omega, show 2 * b + 3 = 2 * b + 2 + 1 by omega]
  simpa [rep_succ] using h

theorem t2 (c : Nat) : steps (2 * c + 8) (T (c + 1) 2) = some (X (c + 1) 3) := by
  have h := r_t2 c
  simpa [T, X, rep_succ] using h

theorem xround (c m : Nat) : steps (4 * c + 10) (X c (m + 2)) = some (X (c + 2) m) := by
  have h := r_xround c m
  have e : rep (c + 2) [true, false] (cons true blank)
      = cons true (cons false (rep c [true, false] (cons true (cons false (cons true blank))))) := by
    rw [rep_succ, rep_back]
    simp
  simp only [X]
  rw [e]
  exact h

theorem xend (c : Nat) : steps 1 (X c 1) = some (P (c + 1)) := by
  have h := r_xend c
  rw [rot] at h
  simp only [X, P]
  rw [rot]
  simpa [rep_succ] using h

/-! ## Halting: a doubling phase with no 1s or one 1 left -/

theorem T0_halts (c : Nat) : ∃ c', steps (2 * c) (T c 0) = some c' ∧ step c' = none :=
  ⟨_, by simpa [T] using r_t0 c, rfl⟩

theorem T1_halts (c : Nat) : ∃ c', steps (2 * c + 2) (T c 1) = some c' ∧ step c' = none :=
  ⟨_, by simpa [T] using r_t1 c, rfl⟩

/-! ## Iterated rules (step counts in closed form) -/

/-- Steps of `j` zigzags starting with `b + 1` blocks `01`. -/
def zsteps (b j : Nat) : Nat := 4 * (j * b) + 4 * (j * j) + 4 * j

theorem zsteps_succ (b j : Nat) : zsteps b (j + 1) = (4 * b + 8) + zsteps (b + 2) j := by
  simp only [zsteps, Nat.succ_mul, Nat.mul_succ, Nat.mul_add]
  omega

theorem zig_iter (a m : Nat) : ∀ j b, steps (zsteps b j) (S (a + j) (b + 1) (m + 2 * j))
    = some (S a (b + 1 + 2 * j) m) := by
  intro j
  induction j with
  | zero => intro b; simp [zsteps]
  | succ j ih =>
    intro b
    have h₁ := zig (a + j) b (m + 2 * j)
    rw [show a + j + 1 = a + (j + 1) by omega, show m + 2 * j + 2 = m + 2 * (j + 1) by omega] at h₁
    have h₂ := ih (b + 2)
    rw [show b + 2 + 1 = b + 3 by omega, show b + 3 + 2 * j = b + 1 + 2 * (j + 1) by omega] at h₂
    rw [zsteps_succ]
    exact steps_seq trans h₁ h₂

/-- Steps of `j` rounds of the final sweep from `X c _`. -/
def xsteps (c j : Nat) : Nat := 4 * (j * c) + 4 * (j * j) + 6 * j

theorem xsteps_succ (c j : Nat) : xsteps c (j + 1) = (4 * c + 10) + xsteps (c + 2) j := by
  simp only [xsteps, Nat.succ_mul, Nat.mul_succ, Nat.mul_add]
  omega

theorem x_iter (m : Nat) : ∀ j c, steps (xsteps c j) (X c (m + 2 * j)) = some (X (c + 2 * j) m) := by
  intro j
  induction j with
  | zero => intro c; simp [xsteps]
  | succ j ih =>
    intro c
    have h₁ := xround c (m + 2 * j)
    rw [show m + 2 * j + 2 = m + 2 * (j + 1) by omega] at h₁
    have h₂ := ih (c + 2)
    rw [show c + 2 + 2 * j = c + 2 * (j + 1) by omega] at h₂
    rw [xsteps_succ]
    exact steps_seq trans h₁ h₂

/-- From `X c (2j+1)` the final sweep ends at `P (c + 2j + 1)`. -/
theorem x_out (c j : Nat) : steps (xsteps c j + 1) (X c (2 * j + 1)) = some (P (c + 2 * j + 1)) := by
  have h₁ := x_iter 1 j c
  rw [show 1 + 2 * j = 2 * j + 1 by omega] at h₁
  exact steps_seq trans h₁ (xend (c + 2 * j))

/-- One doubling round: `T c (m + 2c + 6) → T (2c+4) m`. -/
theorem t_round (c m : Nat) :
    steps ((2 * c + 3) + (zsteps 0 c + (16 * c + 23))) (T c (m + 2 * c + 6)) = some (T (2 * c + 4) m) := by
  have h₁ := ts c (m + 2 * c + 3)
  have h₂ := zig_iter 0 (m + 3) c 0
  rw [show 0 + c = c by omega, show m + 3 + 2 * c = m + 2 * c + 3 by omega] at h₂
  have h₃ := st (2 * c) m
  rw [show 0 + 1 + 2 * c = 2 * c + 1 by omega] at h₂
  rw [show 8 * (2 * c) + 23 = 16 * c + 23 by omega, show 2 * c + 4 = 2 * c + 4 by rfl] at h₃
  exact steps_seq trans h₁ (steps_seq trans h₂ h₃)

/-! ## The end of a doubling phase -/

/-- Where a macro step ends: at `P n` after `t` steps, or at a configuration whose step halts after `t` steps. -/
inductive Out where
  | go (n t : Nat)
  | halt (t : Nat)
  /-- Not computed (out of fuel); says nothing. -/
  | unknown
  deriving DecidableEq, Repr

def Out.Sound (c : Config) : Out → Prop
  | .go n t => steps t c = some (P n)
  | .halt t => ∃ c', steps t c = some c' ∧ step c' = none
  | .unknown => True

def Out.addT (a : Nat) : Out → Out
  | .go n t => .go n (a + t)
  | .halt t => .halt (a + t)
  | .unknown => .unknown

theorem Out.sound_addT {a : Nat} {c c' : Config} (h : steps a c = some c') {o : Out} (ho : o.Sound c') :
    (o.addT a).Sound c := by
  cases o with
  | go n t => exact steps_seq trans h ho
  | halt t =>
    obtain ⟨d, h₁, h₂⟩ := ho
    exact ⟨d, steps_seq trans h h₁, h₂⟩
  | unknown => trivial

/-- The end of the phase at `T c m` with `m < 2c + 6` (`c ≥ 1`). -/
def tend (c m : Nat) : Out :=
  if m = 0 then .halt (2 * c)
  else if m = 1 then .halt (2 * c + 2)
  else if m = 2 then .go (c + 3) ((2 * (c - 1) + 8) + (xsteps c 1 + 1))
  else
    -- the zigzag S c 1 (m - 3), with m - 3 = 2 j + e
    let j := (m - 3) / 2
    let e := (m - 3) % 2
    if j < c then
      -- the 1s run out with a = c - j ≥ 1 left
      if e = 0 then
        .go (c + 3 * j + 5) ((2 * c + 3) + (zsteps 0 j + ((4 * (2 * j) + 7) + (xsteps (c - j) (2 * j + 2) + 1))))
      else
        .go (c + 3 * j + 6)
          ((2 * c + 3) + (zsteps 0 j + ((8 * (2 * j) + 4 * (c - j - 1) + 29) + (xsteps (c - j + 1) (2 * j + 2) + 1))))
    else
      -- the zigzag reaches the left end with m - 3 - 2c ∈ {0, 1, 2} ones left
      let r := m - 3 - 2 * c
      if r = 0 then .go (4 * c + 5) ((2 * c + 3) + (zsteps 0 c + ((4 * (2 * c) + 7) + (xsteps 0 (2 * c + 2) + 1))))
      else if r = 1 then
        .go (4 * c + 6) ((2 * c + 3) + (zsteps 0 c + ((8 * (2 * c) + 25) + (xsteps 1 (2 * c + 2) + 1))))
      else .go (4 * c + 8) ((2 * c + 3) + (zsteps 0 c + ((8 * (2 * c) + 65) + (xsteps 5 (2 * c + 1) + 1))))

theorem tend_sound (c m : Nat) (hc : 1 ≤ c) (hm : m < 2 * c + 6) : (tend c m).Sound (T c m) := by
  unfold tend
  by_cases h0 : m = 0
  · subst h0; exact T0_halts c
  by_cases h1 : m = 1
  · subst h1; exact T1_halts c
  by_cases h2 : m = 2
  · subst h2
    simp only [Out.Sound, if_neg (by decide : (2:Nat) ≠ 0), if_neg (by decide : (2:Nat) ≠ 1), if_true]
    obtain ⟨c', rfl⟩ : ∃ c', c = c' + 1 := ⟨c - 1, by omega⟩
    have h₁ := t2 c'
    have h₂ := x_out (c' + 1) 1
    rw [show c' + 1 - 1 = c' by omega]
    rw [show c' + 1 + 2 * 1 + 1 = c' + 1 + 3 by omega] at h₂
    exact steps_seq trans h₁ h₂
  simp only [if_neg h0, if_neg h1, if_neg h2]
  -- m ≥ 3
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 3 := ⟨m - 3, by omega⟩
  have hk : k + 3 - 3 = k := by omega
  simp only [hk]
  have hts := ts c k
  have hsplit : k = 2 * (k / 2) + k % 2 := by omega
  by_cases hj : k / 2 < c
  · simp only [if_pos hj]
    -- zigzag j times: S c 1 k → S (c - j) (1 + 2j) e
    have hz := zig_iter (c - k / 2) (k % 2) (k / 2) 0
    rw [show c - k / 2 + k / 2 = c by omega, show k % 2 + 2 * (k / 2) = k by omega,
      show 0 + 1 + 2 * (k / 2) = 2 * (k / 2) + 1 by omega] at hz
    by_cases he : k % 2 = 0
    · simp only [if_pos he]
      rw [he] at hz
      obtain ⟨a, ha⟩ : ∃ a, c - k / 2 = a + 1 := ⟨c - k / 2 - 1, by omega⟩
      rw [ha] at hz
      have he0 := e0 a (2 * (k / 2))
      have hx := x_out (a + 1) (2 * (k / 2) + 2)
      rw [show 2 * (2 * (k / 2)) + 5 = 2 * (2 * (k / 2) + 2) + 1 by omega] at he0
      rw [show a + 1 + 2 * (2 * (k / 2) + 2) + 1 = c + 3 * (k / 2) + 5 by omega] at hx
      rw [ha]
      exact steps_seq trans hts (steps_seq trans hz (steps_seq trans he0 hx))
    · simp only [if_neg he]
      have he1 : k % 2 = 1 := by omega
      rw [he1] at hz
      obtain ⟨a, ha⟩ : ∃ a, c - k / 2 = a + 1 := ⟨c - k / 2 - 1, by omega⟩
      rw [ha] at hz
      have hE := e1 a (2 * (k / 2))
      have hx := x_out (a + 2) (2 * (k / 2) + 2)
      rw [show 2 * (2 * (k / 2)) + 5 = 2 * (2 * (k / 2) + 2) + 1 by omega] at hE
      rw [show a + 2 + 2 * (2 * (k / 2) + 2) + 1 = c + 3 * (k / 2) + 6 by omega] at hx
      rw [show c - k / 2 - 1 = a by omega, show c - k / 2 + 1 = a + 2 by omega]
      exact steps_seq trans hts (steps_seq trans hz (steps_seq trans hE hx))
  · simp only [if_neg hj]
    -- the zigzag reaches the left end: S c 1 k → S 0 (2c + 1) (k - 2c)
    have hz := zig_iter 0 (k - 2 * c) c 0
    rw [show 0 + c = c by omega, show k - 2 * c + 2 * c = k by omega,
      show 0 + 1 + 2 * c = 2 * c + 1 by omega] at hz
    have hr : k + 3 - 3 - 2 * c = k - 2 * c := by omega
    try simp only [hr]
    by_cases r0 : k - 2 * c = 0
    · simp only [if_pos r0]
      rw [r0] at hz
      have hs := s00 (2 * c)
      have hx := x_out 0 (2 * c + 2)
      rw [show 2 * (2 * c) + 5 = 2 * (2 * c + 2) + 1 by omega] at hs
      rw [show 0 + 2 * (2 * c + 2) + 1 = 4 * c + 5 by omega] at hx
      exact steps_seq trans hts (steps_seq trans hz (steps_seq trans hs hx))
    by_cases r1 : k - 2 * c = 1
    · simp only [if_neg r0, if_pos r1]
      rw [r1] at hz
      have hs := s01 (2 * c)
      have hx := x_out 1 (2 * c + 2)
      rw [show 2 * (2 * c) + 5 = 2 * (2 * c + 2) + 1 by omega] at hs
      rw [show 1 + 2 * (2 * c + 2) + 1 = 4 * c + 6 by omega] at hx
      exact steps_seq trans hts (steps_seq trans hz (steps_seq trans hs hx))
    · simp only [if_neg r0, if_neg r1]
      have r2 : k - 2 * c = 2 := by omega
      rw [r2] at hz
      have hs := s02 (2 * c)
      have hx := x_out 5 (2 * c + 1)
      rw [show 2 * (2 * c) + 3 = 2 * (2 * c + 1) + 1 by omega] at hs
      rw [show 5 + 2 * (2 * c + 1) + 1 = 4 * c + 8 by omega] at hx
      exact steps_seq trans hts (steps_seq trans hz (steps_seq trans hs hx))

/-! ## The doubling phase and the macro step -/

/-- The whole phase from `T c m`: doubling rounds while at least `2c + 6` ones are left, then `tend`.  The first
argument is fuel (structural recursion, so that the kernel can evaluate it); `2n + 2` is always enough. -/
def tphase : Nat → Nat → Nat → Out
  | 0, c, m => if 2 * c + 6 ≤ m then .unknown else tend c m
  | f + 1, c, m =>
    if 2 * c + 6 ≤ m then
      (tphase f (2 * c + 4) (m - (2 * c + 6))).addT ((2 * c + 3) + (zsteps 0 c + (16 * c + 23)))
    else tend c m

theorem tphase_sound : ∀ f m c, 1 ≤ c → (tphase f c m).Sound (T c m) := by
  intro f
  induction f with
  | zero =>
    intro m c hc
    simp only [tphase]
    by_cases h : 2 * c + 6 ≤ m
    · rw [if_pos h]; trivial
    · rw [if_neg h]; exact tend_sound c m hc (by omega)
  | succ f ih =>
    intro m c hc
    simp only [tphase]
    by_cases h : 2 * c + 6 ≤ m
    · rw [if_pos h]
      have hr := t_round c (m - (2 * c + 6))
      rw [show m - (2 * c + 6) + 2 * c + 6 = m by omega] at hr
      exact Out.sound_addT hr (ih (m - (2 * c + 6)) (2 * c + 4) (by omega))
    · rw [if_neg h]
      exact tend_sound c m hc (by omega)

/-- The macro step from `P n`. -/
def pstep (n : Nat) : Out := (tphase (2 * n + 2) 1 (2 * n + 2)).addT (2 * n + 8)

/-- **The macro step is proved for every `n`**: from `P n` the machine reaches `P n'` after the steps `pstep n`
gives, or halts (the fuel never runs out: `pstep` is never `unknown`, see `Orbit.lean`). -/
theorem pstep_sound (n : Nat) : (pstep n).Sound (P n) :=
  Out.sound_addT (sweep_start n) (tphase_sound _ _ 1 (by decide))

end H50372
