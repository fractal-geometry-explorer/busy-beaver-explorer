/-- The collisions: `t = 2s + p` gaps of 2, the misaligned gap `g`, then the gaps `flat S`.  The answer is the blocks added in front of the word (last first), the new counter low part, the new gaps and how much the word's last block grows. -/
def xcoll (s : Nat) : Nat → Nat → List Sg → Option (List Nat × Nat × List Nat × Nat)
  | 0, 0, .five (k0 + 1) :: S => some (3 :: (List.replicate (3 * s) 1 ++ ([])), 1, 0 :: List.replicate (k0) 5 ++ flat S, 2)
  | 0, 0, .big q0 :: S => some (3 :: (List.replicate (3 * s) 1 ++ ([])), 1, (3 * q0 + 3) :: flat S, 2)
  | 0, 0, [] => some (3 :: (List.replicate (3 * s) 1 ++ ([])), 1, [], 2)
  | 0, 0, .two 1 :: .five (k1 + 1) :: S => some (5 :: (List.replicate (3 * s) 1 ++ ([])), 1, 1 :: List.replicate (k1) 5 ++ flat S, 2)
  | 0, 0, .two 1 :: .big q1 :: S => some (5 :: (List.replicate (3 * s) 1 ++ ([])), 1, (3 * q1 + 4) :: flat S, 2)
  | 0, 0, .two 1 :: [] => some (5 :: (List.replicate (3 * s) 1 ++ ([])), 1, [], 2)
  | 0, 0, .two 2 :: .five (k2 + 1) :: .two (m3 + 1) :: .five (k4 + 1) :: S => some (4 :: (3 :: (List.replicate (k2) 5 ++ (7 :: (List.replicate (3 * s) 1 ++ ([]))))), (m3 + 1), 2 :: List.replicate (k4) 5 ++ flat S, 2)
  | 0, 0, .two 2 :: .five (k2 + 1) :: .two (m3 + 1) :: .big q4 :: S => some (4 :: (3 :: (List.replicate (k2) 5 ++ (7 :: (List.replicate (3 * s) 1 ++ ([]))))), (m3 + 1), (3 * q4 + 5) :: flat S, 2)
  | 0, 0, .two 2 :: .five (k2 + 1) :: .two (m3 + 1) :: [] => some (4 :: (3 :: (List.replicate (k2) 5 ++ (7 :: (List.replicate (3 * s) 1 ++ ([]))))), (m3 + 1), [], 2)
  | 0, 0, .two 2 :: .five (k2 + 1) :: .big q3 :: S => some (3 :: (5 :: (List.replicate (k2) 5 ++ (7 :: (List.replicate (3 * s) 1 ++ ([]))))), 1, (3 * q3 + 1) :: flat S, 2)
  | 0, 0, .two 2 :: .five (k2 + 1) :: [] => some (3 :: (5 :: (List.replicate (k2) 5 ++ (7 :: (List.replicate (3 * s) 1 ++ ([]))))), 1, [], 2)
