/-- The anomaly with a one-unit counter: word `[1, 2c+2]`, counter low part 1, gaps `flat S`. -/
def xanu : Nat → List Sg → Option AC
  | c, .two (m0 + 1) :: .five (k1 + 1) :: S => some ⟨4 :: (3 :: (List.replicate (c) 1 ++ ([])) ++ [2]), (m0 + 1), 2 :: List.replicate (k1) 5 ++ flat S⟩
  | c, .two (m0 + 1) :: .big q1 :: S => some ⟨4 :: (3 :: (List.replicate (c) 1 ++ ([])) ++ [2]), (m0 + 1), (3 * q1 + 5) :: flat S⟩
  | c, .two (m0 + 1) :: [] => some ⟨4 :: (3 :: (List.replicate (c) 1 ++ ([])) ++ [2]), (m0 + 1), []⟩
  | c, .five (k0 + 1) :: .two (m2 + 1) :: .five (k3 + 1) :: S => some ⟨4 :: (3 :: (List.replicate (k0) 5 ++ (5 :: (List.replicate (c) 1 ++ ([])))) ++ [2]), (m2 + 1), 2 :: List.replicate (k3) 5 ++ flat S⟩
  | c, .five (k0 + 1) :: .two (m2 + 1) :: .big q3 :: S => some ⟨4 :: (3 :: (List.replicate (k0) 5 ++ (5 :: (List.replicate (c) 1 ++ ([])))) ++ [2]), (m2 + 1), (3 * q3 + 5) :: flat S⟩
  | c, .five (k0 + 1) :: .two (m2 + 1) :: [] => some ⟨4 :: (3 :: (List.replicate (k0) 5 ++ (5 :: (List.replicate (c) 1 ++ ([])))) ++ [2]), (m2 + 1), []⟩
  | c, .five (k0 + 1) :: .big q2 :: S => some ⟨3 :: (5 :: (List.replicate (k0) 5 ++ (5 :: (List.replicate (c) 1 ++ ([])))) ++ [2]), 1, (3 * q2 + 1) :: flat S⟩
  | c, .five (k0 + 1) :: [] => some ⟨3 :: (5 :: (List.replicate (k0) 5 ++ (5 :: (List.replicate (c) 1 ++ ([])))) ++ [2]), 1, []⟩
  | c, .big q0 :: S => some ⟨3 :: (5 :: (List.replicate (c) 1 ++ ([])) ++ [2]), 1, (3 * q0 + 1) :: flat S⟩
  | c, [] => some ⟨3 :: (5 :: (List.replicate (c) 1 ++ ([])) ++ [2]), 1, []⟩
  | _, _ => none

theorem xanu_sound (c : Nat) (S : List Sg) {c' : AC} (h : xanu c S = some c') :
    ∃ n, 1 ≤ n ∧ steps n (qr [1, 2 * c + 2] 1 (flat S)) = some c'.enc := by
  unfold xanu at h
  split at h
  · cases h
    exact ⟨_, by omega, xq_u_0 _ _ _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_1 _ _ _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_2 _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_3 _ _ _ _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_4 _ _ _ _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_5 _ _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_6 _ _ _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_7 _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_8 _ _ _ _ (by omega)⟩
  · cases h
    exact ⟨_, by omega, xq_u_9 _ _ (by omega)⟩
  · cases h


/-! ## The anomaly inside the word -/

theorem qr_inner (x v a : Nat) (V G : List Nat) :
    qr (x :: (v + 1) :: V) a G = qx a [x] (rep 1 [true] (rep v [true] (cons false (wl V)))) G := by
  simp only [qr, qx, wl, wlx, rep_succ, rep_zero, app_cons, app_nil]

theorem qr_inner' (c v : Nat) (V H : List Nat) :
    qr (List.replicate c 1 ++ (v + 1 + 2) :: V) 1 H
      = qx 1 (List.replicate c 1) (rep 3 [true] (rep v [true] (cons false (wl V)))) H := by
  simp only [qr, qx, wl_append, wl, rep_succ, rep_zero, app_cons, app_nil]

/-- A last block `2c+2` with more of the word behind it: `c` single 1s, the next block grows by 2, and a gap of
`3(a-1)` (misaligned) is added in front of the gaps. -/
theorem inner_step (c a y : Nat) (V G : List Nat) (hy : 1 ≤ y) (ha : 1 ≤ a) :
    ∃ n, 1 ≤ n ∧ steps n (qr ((2 * c + 2) :: y :: V) a G)
      = some (qr (List.replicate c 1 ++ (y + 2) :: V) 1 ((3 * (a - 1)) :: G)) := by
  obtain ⟨v, rfl⟩ : ∃ v, y = v + 1 := ⟨y - 1, by omega⟩
  rw [qr_inner, qr_inner']
  rcases Nat.lt_or_ge a 2 with ha2 | ha2
  · obtain rfl : a = 1 := by omega
    rcases c with _ | c
    · have e := xq_inner00 G (rep v [true] (cons false (wl V))) (2 * 0 + 2) (by omega) 1 rfl
      simp only [List.replicate_zero, List.append_nil, show 3 * (1 - 1) = 0 from rfl] at e ⊢
      exact ⟨_, by omega, e⟩
    · have e := xq_inner10 c G (rep v [true] (cons false (wl V))) (2 * (c + 1) + 2) (by omega) 1 rfl
      simp only [List.append_nil, show 3 * (1 - 1) = 0 from rfl] at e ⊢
      exact ⟨_, by omega, e⟩
  · obtain ⟨a', rfl⟩ : ∃ a', a = a' + 2 := ⟨a - 2, by omega⟩
    rcases c with _ | c
    · have e := xq_inner01 a' G (rep v [true] (cons false (wl V))) (2 * 0 + 2) (by omega) (a' + 2) rfl
      simp only [List.replicate_zero, List.append_nil, show 3 * (a' + 2 - 1) = 3 * a' + 3 by omega] at e ⊢
      exact ⟨_, by omega, e⟩
    · have e := xq_inner11 a' c G (rep v [true] (cons false (wl V))) (2 * (c + 1) + 2) (by omega) (a' + 2) rfl
      simp only [List.append_nil, show 3 * (a' + 2 - 1) = 3 * a' + 3 by omega] at e ⊢
      exact ⟨_, by omega, e⟩

/-! ## The map -/

/-- The irregular steps that `astep` leaves out: the anomaly with a one-unit counter, the anomaly inside the word,
and the collisions. -/
def xstep (c : AC) : Option AC :=
  match c.W with
  | x :: y :: V =>
    if x = 1 ∧ V = [] then
      (if y % 2 = 0 ∧ 2 ≤ y ∧ c.a = 1 then xanu ((y - 2) / 2) (rl c.G) else none)
    else if x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ y ∧ 1 ≤ c.a then
      some ⟨List.replicate ((x - 2) / 2) 1 ++ (y + 2) :: V, 1, (3 * (c.a - 1)) :: c.G⟩
    else if wshape (x :: y :: V) = true ∧ c.a = 1 then
      match lead2 c.G with
      | (t, h :: G0) =>
        if h ≤ 1 then
          match xcoll (t / 2) (t % 2) h (rl G0) with
          | some (C, a', G', j) => some ⟨C ++ addh j (phi (phi (x :: y :: V))), a', G'⟩
          | none => none
        else none
      | (_, []) => none
    else none
  | _ => none

theorem xstep_sound (c c' : AC) (h : xstep c = some c') : ∃ n, 1 ≤ n ∧ steps n c.enc = some c'.enc := by
  obtain ⟨W, a, G⟩ := c
  simp only [AC.enc]
  rcases W with _ | ⟨x, _ | ⟨y, V⟩⟩
  · simp [xstep] at h
  · simp [xstep] at h
  simp only [xstep] at h
  by_cases h1 : x = 1 ∧ V = []
  · rw [ite_t h1] at h
    obtain ⟨rfl, rfl⟩ := h1
    by_cases hc : y % 2 = 0 ∧ 2 ≤ y ∧ a = 1
    · rw [ite_t hc] at h
      obtain ⟨c0, rfl⟩ : ∃ c0, y = 2 * c0 + 2 := ⟨(y - 2) / 2, by omega⟩
      obtain rfl : a = 1 := hc.2.2
      have e := xanu_sound _ _ h
      rw [show (2 * c0 + 2 - 2) / 2 = c0 by omega, flat_rl] at e
      exact e
    · rw [ite_f hc] at h; cases h
  rw [ite_f h1] at h
  by_cases h2 : x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ y ∧ 1 ≤ a
  · rw [ite_t h2] at h; cases h
    obtain ⟨c0, rfl⟩ : ∃ c0, x = 2 * c0 + 2 := ⟨(x - 2) / 2, by omega⟩
    rw [show (2 * c0 + 2 - 2) / 2 = c0 by omega]
    exact inner_step c0 a y V G h2.2.2.1 h2.2.2.2
  rw [ite_f h2] at h
  by_cases h3 : wshape (x :: y :: V) = true ∧ a = 1
  · rw [ite_t h3] at h
    obtain ⟨hw, rfl⟩ := h3
    have hne : phi (phi (x :: y :: V)) ≠ [] := phi_ne_nil _ (phi_ne_nil _ (wshape_ne_nil hw))
    cases e : lead2 G with
    | mk t R =>
      rw [e] at h
      cases R with
      | nil => simp at h
      | cons hh G0 =>
        simp only at h
        have hG : G = List.replicate t 2 ++ hh :: G0 := by
          have hs := lead2_spec G
          rw [e] at hs
          exact hs
        subst hG
        have wp := wphase (x :: y :: V) hw (gl (List.replicate t 2 ++ hh :: G0))
        by_cases hh1 : hh ≤ 1
        · rw [ite_t hh1] at h
          cases e2 : xcoll (t / 2) (t % 2) hh (rl G0) with
          | none => rw [e2] at h; cases h
          | some r =>
            obtain ⟨C, a', G', j⟩ := r
            rw [e2] at h; cases h
            have hz := xcoll_sound _ _ _ _ e2 (wl (phi (phi (x :: y :: V))))
            have ht : 2 * (t / 2) + t % 2 = t := Nat.div_add_mod t 2
            rw [flat_rl, ht] at hz
            obtain ⟨n, hn, hz⟩ := hz
            obtain ⟨m, hm, wp⟩ := wp
            refine ⟨m + n, by omega, ?_⟩
            have e3 : qr (C ++ addh j (phi (phi (x :: y :: V)))) a' G'
                = qx a' C (rep j [true] (wl (phi (phi (x :: y :: V))))) G' := by
              simp only [qr, qx, wl_append, wl_addh j _ hne]
            rw [e3]
            exact steps_seq trans wp hz
        · rw [ite_f hh1] at h; cases h
  · rw [ite_f h3] at h; cases h

/-- `astep` where it applies, the rules above elsewhere. -/
def bstep (c : AC) : Option AC :=
  match astep c with
  | some c' => some c'
  | none => xstep c

theorem bstep_sound (c c' : AC) (h : bstep c = some c') : ∃ n, 1 ≤ n ∧ steps n c.enc = some c'.enc := by
  unfold bstep at h
  cases e : astep c with
  | some c1 =>
    obtain ⟨n, hn, hs⟩ := astep_sound c c1 e
    rw [e] at h; cases h
    exact ⟨n, by omega, hs⟩
  | none => rw [e] at h; exact xstep_sound c c' h

/-- `k` steps of `bstep`. -/
def brun : Nat → AC → Option AC
  | 0, c => some c
  | k + 1, c => (bstep c).bind (brun k)

theorem brun_adv : ∀ (k : Nat) (c c' : AC), brun k c = some c' → ∃ n, k ≤ n ∧ steps n c.enc = some c'.enc
  | 0, c, c', h => by cases h; exact ⟨0, Nat.le_refl _, rfl⟩
  | k + 1, c, c', h => by
    simp only [brun] at h
    cases h1 : bstep c with
    | none => rw [h1] at h; cases h
    | some c1 =>
      rw [h1] at h
      obtain ⟨n, hn, hs⟩ := bstep_sound c c1 h1
      obtain ⟨m, hm, hs'⟩ := brun_adv k c1 c' h
      exact ⟨n + m, by omega, steps_seq trans hs hs'⟩

/-- **The closed-form reduction**: if `bstep` can be applied for ever from the configuration at step 27, the
machine never halts from blank tape. -/
theorem not_halts_of_brun (h : ∀ k, (brun k start).isSome) : ¬ HaltsFromBlank := by
  apply not_halts_of_forall
  intro n
  have hk := h n
  cases e : brun n start with
  | none => rw [e] at hk; cases hk
  | some c =>
    obtain ⟨m, hm, hs⟩ := brun_adv n start c e
    have h3 := steps_seq trans start_reached hs
    have e2 : 27 + m = n + (27 + m - n) := by omega
    rw [e2] at h3
    exact steps_le trans h3

/-- The run of `bstep` as a loop (for compiled evaluation): the number of steps left when it fails, 0 if all
succeed. -/
def brunN : Nat → AC → Nat
  | 0, _ => 0
  | k + 1, c => match bstep c with
    | some c' => brunN k c'
    | none => k + 1

theorem brunN_sound : ∀ (k : Nat) (c : AC), brunN k c = 0 → (brun k c).isSome
  | 0, _, _ => rfl
  | k + 1, c, h => by
    simp only [brunN] at h
    simp only [brun]
    cases e : bstep c with
    | none => rw [e] at h; cases h
    | some c' => rw [e] at h; exact brunN_sound k c' h

