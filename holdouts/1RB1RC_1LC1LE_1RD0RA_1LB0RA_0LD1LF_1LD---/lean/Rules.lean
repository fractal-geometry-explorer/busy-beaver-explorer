  have hn : 8 + (0 + ((b) * 8 + (4 + (0 + ((a) * 8 + (14 + (0 + ((a) * 4 + (10 + (0 + ((b) * 4 + (6)))))))))))) = 12 * a + 12 * b + 42 := by omega
  have h0 : steps 8 ⟨cons false (cons true (rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L)))))))), blank, .A⟩ = some ⟨cons false (cons true (rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L)))))))), cons false (cons true (cons true (cons true (blank)))), .F⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L)))))))), cons false (cons true (cons true (cons true (blank)))), .F⟩ = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L)))))))), cons false (cons true (cons true (cons true (blank)))), .F⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L)))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L)))))))) from
