    cross_l trans c1 (b) (cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L)))))) (cons true (cons true (cons true (blank))))
  have h2 : steps 4 ⟨cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L))))), cons false (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))), .F⟩ = some ⟨cons false (rep (a) [false, true, false, true] (cons false (L))), cons true (cons true (cons true (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))))), .A⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (a) [false, true, false, true] (cons false (L))), cons true (cons true (cons true (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))))), .A⟩ = some ⟨cons false (rep (a) [false, true, false, true] (cons false (L))), rep (b) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), .A⟩ := by
