  have h2 : steps ((b) * 8) ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L)))))))), cons false (cons true (cons true (cons true (blank)))), .F⟩ = some ⟨cons false (cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (rep (z + 1) [false, true, false, true] (cons false (L))))))), cons false (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))), .F⟩ :=
