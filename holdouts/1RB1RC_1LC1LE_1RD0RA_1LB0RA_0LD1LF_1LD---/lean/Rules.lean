import Machine

/-! One cycle (A at the right end to A at the right end) of the counter dynamics, every parity case of the last two counters. Generated by `py/rules.py`. -/

namespace H16609

open TM

/-- sep 0, c = 2a+2 even, k = 2b even: c loses 1, k gains 3. -/
theorem sep0_ce_ke (a b : Nat) (L : Tape) :
    steps (12 * b + 18) ⟨rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (L)))), blank, .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L)))))))))))), blank, .A⟩ := by
  have hn : 8 + ((b) * 8 + (4 + (0 + ((b) * 4 + (6))))) = 12 * b + 18 := by omega
  have h0 : steps 8 ⟨rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (L)))), blank, .A⟩ = some ⟨rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (L)))), cons false (cons true (cons true (cons true (blank)))), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 8 ⟨app [false, true, false, true] L, app [false] R, .F⟩ = some ⟨L, app [false] (app [true, true, true, true] R), .F⟩ := fun _ _ => rfl
  have h1 : steps ((b) * 8) ⟨rep (b) [false, true, false, true] (cons false (rep (a + 1) [false, true, false, true] (cons false (L)))), cons false (cons true (cons true (cons true (blank)))), .F⟩ = some ⟨cons false (rep (a + 1) [false, true, false, true] (cons false (L))), cons false (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))), .F⟩ :=
    cross_l trans c1 (b) (cons false (rep (a + 1) [false, true, false, true] (cons false (L)))) (cons true (cons true (cons true (blank))))
  have h2 : steps 4 ⟨cons false (rep (a + 1) [false, true, false, true] (cons false (L))), cons false (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))), .F⟩ = some ⟨cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L))))), cons true (cons true (cons true (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))))), .A⟩ := rfl
  have h3 : steps 0 ⟨cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L))))), cons true (cons true (cons true (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))))), .A⟩ = some ⟨cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L))))), rep (b) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), .A⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (b) [true, true, true, true] (cons true (cons true (cons true (blank))))))) = rep (b) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))) from
      rep_rotate (b) [true, true, true] [true, true, true, true] [true, true, true, true] rfl (cons true (cons true (cons true (blank))))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true, true, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h4 : steps ((b) * 4) ⟨cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L))))), rep (b) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), .A⟩ = some ⟨rep (b) [false, true, false, true] (cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L)))))), cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), .A⟩ :=
    cross_r trans c4 (b) (cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L)))))) (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))
  have h5 : steps 6 ⟨rep (b) [false, true, false, true] (cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L)))))), cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (cons false (cons true (rep (a) [false, true, false, true] (cons false (L)))))))))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- sep 0, c = 2a+1 odd, k = 2b even: c loses 1, k gains 3. -/
