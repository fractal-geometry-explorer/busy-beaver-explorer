      rep_rotate (b) [true, true, true] [true, true, true, true] [true, true, true, true] rfl (cons true (cons true (cons true (blank))))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true, true, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h4 : steps ((b) * 4) ⟨cons false (rep (a) [false, true, false, true] (cons false (L))), rep (b) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), .A⟩ = some ⟨rep (b) [false, true, false, true] (cons false (rep (a) [false, true, false, true] (cons false (L)))), cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), .A⟩ :=
    cross_r trans c4 (b) (cons false (rep (a) [false, true, false, true] (cons false (L)))) (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))
  have h5 : steps 6 ⟨rep (b) [false, true, false, true] (cons false (rep (a) [false, true, false, true] (cons false (L)))), cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons false (rep (a) [false, true, false, true] (cons false (L)))))))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

