import MacroRules

/-!
# 1RB1RC_1LC1LE_1RD0RA_1LB0RA_0LD1LF_1LD---: the ordinary visits, for every counter list

At a visit (A at the right end, on blank) the tape is a list of counters `(10)^c` with single separator cells.
`V k ps` is that tape: `k` the last counter, `ps` the pairs (separator right of a counter, the counter), nearest
first, the front counter last.  `ordinary k ps` is the visit-to-visit rule of `py/counters.py` for the ordinary
visits (every visit that is not a rebuild): the carry starts at the last counter and passes every odd counter with a
separator 0 on its left; it stops at the first counter that is even or has a separator 1 on its left, and

* odd with separator 1, or even with separator 0: the counter left of it loses one;
* even with separator 1: it loses one itself;

the separator there becomes 0 and the last counter gains 3.  It is `none` for the rebuilds (the carry passes the
front counter, or the target is a zero counter).

Theorem `ordinary_visit`: whenever `ordinary k ps = some (k', ps')`, the machine goes from `V k ps` to `V k' ps'`.
The proof composes the pieces of `MacroRules.lean` (generated by `py/macro.py`): the leftward pass turns each counter
it crosses into a block of 1s, and the rightward pass after the turn rebuilds every counter, the last one with 3
more units.  Written by hand.
-/

namespace H16609

open TM

/-- `c` units `10`, nearest cell first. -/
def u (c : Nat) (s : Tape) : Tape := rep c [false, true] s
/-- `n` cells holding 1. -/
def ones (n : Nat) (s : Tape) : Tape := rep n [true] s

/-- The pairs (separator, counter) in front of a tape `t`, nearest first. -/
def encLT : List (Bool × Nat) → Tape → Tape
  | [], t => t
  | (s, c) :: ps, t => cons s (u c (encLT ps t))

/-- The visit: last counter `k`, then the pairs, then blank tape. -/
def V (k : Nat) (ps : List (Bool × Nat)) : Config := ⟨u k (encLT ps blank), blank, .A⟩

/-! ## Tape identities -/

theorem u_add (a b : Nat) (s : Tape) : u a (u b s) = u (a + b) s := by
  unfold u; rw [← rep_add]

theorem ones_add (a b : Nat) (s : Tape) : ones a (ones b s) = ones (a + b) s := by
  unfold ones; rw [← rep_add]

theorem ones_succ (n : Nat) (s : Tape) : ones (n + 1) s = cons true (ones n s) := rfl

theorem u_two (b : Nat) (s : Tape) : u (2 * b) s = rep b [false, true, false, true] s := by
  induction b with
  | zero => rfl
  | succ b ih =>
    rw [show 2 * (b + 1) = 2 * b + 1 + 1 by omega]
    show cons false (cons true (cons false (cons true (u (2 * b) s)))) =
      cons false (cons true (cons false (cons true (rep b [false, true, false, true] s))))
    rw [ih]

theorem u_odd (b : Nat) (s : Tape) : u (2 * b + 1) s = cons false (cons true (rep b [false, true, false, true] s)) := by
  show cons false (cons true (u (2 * b) s)) = _
  rw [u_two]

theorem ones_four (b : Nat) (s : Tape) : rep b [true, true, true, true] s = ones (4 * b) s := by
  induction b with
  | zero => rfl
  | succ b ih =>
    rw [show 4 * (b + 1) = 4 * b + 1 + 1 + 1 + 1 by omega]
    show cons true (cons true (cons true (cons true (rep b [true, true, true, true] s)))) = _
    rw [ih]; rfl

theorem rot (b : Nat) (s : Tape) : cons false (rep b [true, false, true, false] (cons true s)) = u (2 * b + 1) s := by
  have h := rep_rotate b [false] [true, false, true, false] [false, true, false, true] rfl (cons true s)
  simp only [app] at h
  rw [h, u_odd]
  have h2 := rep_rotate b [false, true] [false, true, false, true] [false, true, false, true] rfl s
  simp only [app] at h2
  exact h2.symm

theorem even_or_odd (n : Nat) : ∃ b, n = 2 * b ∨ n = 2 * b + 1 := ⟨n / 2, by omega⟩

/-! ## Reachability -/

/-- `c` reaches `c'` in at least one step. -/
def Reach (c c' : Config) : Prop := ∃ n, steps (n + 1) c = some c'

theorem reach_trans {a b c : Config} (h₁ : Reach a b) (h₂ : Reach b c) : Reach a c := by
  obtain ⟨n, hn⟩ := h₁
  obtain ⟨m, hm⟩ := h₂
  exact ⟨n + (m + 1), steps_congr trans (by omega) (steps_seq trans hn hm)⟩

theorem reach_of {n : Nat} {c c' : Config} (hn : 1 ≤ n) (h : steps n c = some c') : Reach c c' :=
  ⟨n - 1, by rw [show n - 1 + 1 = n by omega]; exact h⟩

/-! ## The pieces for every length -/

/-- The parity state: D after crossing an even counter, E after an odd one. -/
def par (c : Nat) : St := if c % 2 = 0 then .D else .E

theorem start (k : Nat) (hk : 1 ≤ k) (s : Bool) (L : Tape) :
    Reach ⟨u k (cons s L), blank, .A⟩ ⟨L, cons s (ones (2 * k + 4) blank), par k⟩ := by
  obtain ⟨b, rfl | rfl⟩ := even_or_odd k
  · obtain ⟨a, rfl⟩ : ∃ a, b = a + 1 := ⟨b - 1, by omega⟩
    have hp : par (2 * (a + 1)) = .D := by simp [par]
    rw [hp, show 2 * (a + 1) = 2 * a + 2 by omega, show 2 * a + 2 = 2 * (a + 1) by omega, u_two]
    have e : ones (2 * (2 * (a + 1)) + 4) blank = cons true (rep (a + 1) [true, true, true, true] (cons true (cons true (cons true blank)))) := by
      rw [ones_four]; show _ = ones 1 (ones (4 * (a + 1)) (ones 3 blank))
      rw [ones_add, ones_add]; congr 1 <;> omega
    rw [e]
    cases s
    · exact reach_of (by omega) (start_e0 a L)
    · exact reach_of (by omega) (start_e1 a L)
  · have hp : par (2 * b + 1) = .E := by simp [par]
    rw [hp, u_odd]
    have e : ones (2 * (2 * b + 1) + 4) blank = cons true (cons true (cons true (rep b [true, true, true, true] (cons true (cons true (cons true blank)))))) := by
      rw [ones_four]; show _ = ones 3 (ones (4 * b) (ones 3 blank))
      rw [ones_add, ones_add]; congr 1 <;> omega
    rw [e]
    cases s
    · exact reach_of (by omega) (start_o0 b L)
    · exact reach_of (by omega) (start_o1 b L)

/-- E on a separator 0 crosses the counter `c` left of it, to the separator `s2` beyond. -/
theorem cross (c : Nat) (s2 : Bool) (L R : Tape) :
    Reach ⟨u c (cons s2 L), cons false R, .E⟩ ⟨L, cons s2 (ones (2 * c) (cons false R)), par c⟩ := by
  obtain ⟨b, rfl | rfl⟩ := even_or_odd c
  · have hp : par (2 * b) = .D := by simp [par]
    rw [hp]
    cases b with
    | zero =>
      cases s2
      · exact reach_of (by omega) (cross_z0 L R)
      · exact reach_of (by omega) (cross_z1 L R)
    | succ b =>
      rw [u_two]
      have e : ones (2 * (2 * (b + 1))) (cons false R) = cons true (cons true (cons true (cons true (rep b [true, true, true, true] (cons false R))))) := by
        rw [ones_four]; show _ = ones 4 (ones (4 * b) (cons false R))
        rw [ones_add]; congr 1 <;> omega
      rw [e]
      cases s2
      · exact reach_of (by omega) (cross_e0 b L R)
      · exact reach_of (by omega) (cross_e1 b L R)
  · have hp : par (2 * b + 1) = .E := by simp [par]
    rw [hp, u_odd]
    have e : ones (2 * (2 * b + 1)) (cons false R) = cons true (cons true (rep b [true, true, true, true] (cons false R))) := by
      rw [ones_four]; show _ = ones 2 (ones (4 * b) (cons false R))
      rw [ones_add]; congr 1 <;> omega
    rw [e]
    cases s2
    · exact reach_of (by omega) (cross_o0 b L R)
    · exact reach_of (by omega) (cross_o1 b L R)

/-- The turn: E on a separator 1, or D on a separator 0: the counter `c + 1` left of it loses one. -/
theorem turn (q : St) (w : Bool) (hq : (q = .E ∧ w = true) ∨ (q = .D ∧ w = false)) (c : Nat) (s2 : Bool) (L R : Tape) :
    Reach ⟨u (c + 1) (cons s2 L), cons w R, q⟩ ⟨cons true (cons false (u c (cons s2 L))), cons true R, .C⟩ := by
  obtain ⟨b, rfl | rfl⟩ := even_or_odd c
  · rw [u_odd, u_two]
    rcases hq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> cases s2
    · exact reach_of (by omega) (turnE_o0 b L R)
    · exact reach_of (by omega) (turnE_o1 b L R)
    · exact reach_of (by omega) (turnD_o0 b L R)
    · exact reach_of (by omega) (turnD_o1 b L R)
  · rw [show 2 * b + 1 + 1 = 2 * (b + 1) by omega, u_two, u_odd]
    show Reach ⟨cons false (cons true (cons false (cons true (rep b [false, true, false, true] (cons s2 L))))), cons w R, q⟩ _
    rcases hq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> cases s2
    · exact reach_of (by omega) (turnE_e0 b L R)
    · exact reach_of (by omega) (turnE_e1 b L R)
    · exact reach_of (by omega) (turnD_e0 b L R)
    · exact reach_of (by omega) (turnD_e1 b L R)

/-- D on a separator 1 after crossing a counter of at least one: the turn right, A then C. -/
theorem turnA (L R : Tape) : Reach ⟨L, cons true (cons true R), .D⟩ ⟨cons true (cons false L), R, .C⟩ :=
  reach_of (n := 2) (by omega) rfl

/-- C rebuilding one counter on the way back. -/
theorem ret (j : Nat) (X R : Tape) :
    Reach ⟨cons true X, ones (2 * j + 1) (cons false (cons true R)), .C⟩ ⟨cons true (u 1 (cons false (u j X))), R, .C⟩ := by
  obtain ⟨b, rfl | rfl⟩ := even_or_odd j
  · cases b with
    | zero => exact reach_of (by omega) (ret_z X R)
    | succ b =>
      have e : ones (2 * (2 * (b + 1)) + 1) (cons false (cons true R)) = cons true (rep (b + 1) [true, true, true, true] (cons false (cons true R))) := by
        rw [ones_four]; show _ = ones 1 (ones (4 * (b + 1)) (cons false (cons true R)))
        rw [ones_add]; congr 1 <;> omega
      rw [e]
      have h := ret_e b X R
      have e2 : cons false (cons true (cons false (rep b [true, false, true, false] (cons true X)))) = u (2 * (b + 1)) X := by
        rw [rot, show 2 * (b + 1) = 2 * b + 1 + 1 by omega]; rfl
      rw [e2] at h
      exact reach_of (by omega) h
  · have e : ones (2 * (2 * b + 1) + 1) (cons false (cons true R)) = cons true (cons true (cons true (rep b [true, true, true, true] (cons false (cons true R))))) := by
      rw [ones_four]; show _ = ones 3 (ones (4 * b) (cons false (cons true R)))
      rw [ones_add]; congr 1 <;> omega
    rw [e]
    have h := ret_o b X R
    rw [rot] at h
    exact reach_of (by omega) h

/-- C at the last block: the next visit. -/
theorem endr (j : Nat) (X : Tape) : Reach ⟨cons true X, ones (2 * j + 1) blank, .C⟩ ⟨u (j + 1) X, blank, .A⟩ := by
  obtain ⟨b, rfl | rfl⟩ := even_or_odd j
  · cases b with
    | zero => exact reach_of (by omega) (end_z X)
    | succ b =>
      have e : ones (2 * (2 * (b + 1)) + 1) blank = cons true (rep (b + 1) [true, true, true, true] blank) := by
        rw [ones_four]; show _ = ones 1 (ones (4 * (b + 1)) blank)
        rw [ones_add]; congr 1 <;> omega
      rw [e]
      have h := end_e b X
      rw [rot] at h
      rw [show 2 * (b + 1) + 1 = 2 * b + 1 + 1 + 1 by omega]
      exact reach_of (by omega) h
  · have e : ones (2 * (2 * b + 1) + 1) blank = cons true (cons true (cons true (rep b [true, true, true, true] blank))) := by
      rw [ones_four]; show _ = ones 3 (ones (4 * b) blank)
      rw [ones_add]; congr 1 <;> omega
    rw [e]
    have h := end_o b X
    rw [rot] at h
    rw [show 2 * b + 1 + 1 = 2 * b + 1 + 1 by rfl]
    exact reach_of (by omega) h

/-! ## The rule -/

/-- The blocks of 1s right of the head in the leftward pass: the crossed counters `bl` (nearest first), then the
last counter `k` as `1^(2k+4)`. -/
def encB : List Nat → Nat → Tape
  | [], k => ones (2 * k + 4) blank
  | v :: bl, k => ones (2 * v) (cons false (encB bl k))

/-- The crossed counters put back, with separators 0, nearest the last counter first. -/
def back (bl : List Nat) : List (Bool × Nat) := bl.reverse.map (fun p => (false, p))

/-- The leftward scan, the head on the separator of the first pair of `ps`; the counter right of that separator is
the first of `bl`, or the last counter `k` if `bl` is empty. -/
def scan (k : Nat) : List Nat → List (Bool × Nat) → Option (Nat × List (Bool × Nat))
  | _, [] => none
  | bl, (s, c) :: rest =>
    if bl.headD k % 2 = 1 then
      if s then (if c = 0 then none else some (k + 3, back bl ++ (false, c - 1) :: rest))
      else match rest with
        | [] => none
        | _ :: _ => scan k (c :: bl) rest
    else
      if s then
        (match bl with
          | [] => some (k + 2, (false, c) :: rest)
          | v :: bl' => if v = 0 then none else some (k + 3, back bl' ++ (false, v - 1) :: (false, c) :: rest))
      else (if c = 0 then none else some (k + 3, back bl ++ (false, c - 1) :: rest))

/-- The ordinary visits: `none` for the rebuilds (the carry passes the front counter, or meets a zero counter). -/
def ordinary (k : Nat) (ps : List (Bool × Nat)) : Option (Nat × List (Bool × Nat)) :=
  if k = 0 then none else scan k [] ps

/-! ## The composition -/

theorem encLT_append (A B : List (Bool × Nat)) (t : Tape) : encLT (A ++ B) t = encLT A (encLT B t) := by
  induction A with
  | nil => rfl
  | cons p A ih => obtain ⟨s, c⟩ := p; simp [encLT, ih]

theorem back_cons (p : Nat) (bl : List Nat) : back (p :: bl) = back bl ++ [(false, p)] := by
  simp [back]

theorem encLT_cons_split (rest : List (Bool × Nat)) : ∃ s2 L, encLT rest blank = cons s2 L := by
  cases rest with
  | nil => exact ⟨false, blank, cons_false_blank.symm⟩
  | cons p rest => obtain ⟨s, c⟩ := p; exact ⟨s, _, rfl⟩

theorem ones_pos (n : Nat) (s : Tape) (h : 1 ≤ n) : ones n s = cons true (ones (n - 1) s) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  rfl

/-- The way back: C rebuilds every crossed counter and the last one gains 3. -/
theorem retB (k : Nat) : ∀ (bl : List Nat) (X : Tape) (j : Nat), (∀ p ∈ bl, 1 ≤ p) →
    Reach ⟨cons true X, ones (2 * j + 1) (cons false (encB bl k)), .C⟩
      ⟨u (k + 3) (encLT (back bl ++ [(false, j)]) X), blank, .A⟩ := by
  intro bl
  induction bl with
  | nil =>
    intro X j _
    have e : encB [] k = cons true (ones (2 * (k + 1) + 1) blank) := by
      show ones (2 * k + 4) blank = _
      rw [ones_pos _ _ (by omega)]; congr 2 <;> omega
    rw [e]
    refine reach_trans (ret j X _) ?_
    have h := endr (k + 1) (u 1 (cons false (u j X)))
    rw [u_add] at h
    exact h
  | cons p bl ih =>
    intro X j hp
    have h1 : 1 ≤ p := hp p (by simp)
    have e : encB (p :: bl) k = cons true (ones (2 * (p - 1) + 1) (cons false (encB bl k))) := by
      show ones (2 * p) _ = _
      rw [ones_pos _ _ (by omega)]; congr 2 <;> omega
    rw [e]
    refine reach_trans (ret j X _) ?_
    have h := ih (u 1 (cons false (u j X))) (p - 1) (fun q hq => hp q (by simp [hq]))
    have e2 : encLT (back bl ++ [(false, p - 1)]) (u 1 (cons false (u j X))) =
        encLT (back (p :: bl) ++ [(false, j)]) X := by
      rw [back_cons, List.append_assoc, encLT_append, encLT_append]
      simp only [List.singleton_append, encLT]
      rw [u_add, show p - 1 + 1 = p by omega]
    rw [e2] at h
    exact h

/-- The head on the separator `s` of the pair `(s, c)`, the counter right of it the first of `bl` (or `k`). -/
def PS (k : Nat) (bl : List Nat) (s : Bool) (c : Nat) (rest : List (Bool × Nat)) : Config :=
  ⟨u c (encLT rest blank), cons s (encB bl k), par (bl.headD k)⟩

theorem turn_out (k : Nat) (bl : List Nat) (c : Nat) (rest : List (Bool × Nat)) (hbl : ∀ p ∈ bl.drop 1, 1 ≤ p) :
    Reach ⟨cons true (cons false (u c (encLT rest blank))), cons true (encB bl k), .C⟩
      (V (k + 3) (back bl ++ (false, c) :: rest)) := by
  unfold V
  rw [encLT_append]
  cases bl with
  | nil =>
    have e : cons true (encB [] k) = ones (2 * (k + 2) + 1) blank := by
      show ones 1 (ones (2 * k + 4) blank) = _
      rw [ones_add]; congr 1 <;> omega
    rw [e]
    exact endr (k + 2) _
  | cons v bl =>
    have e : cons true (encB (v :: bl) k) = ones (2 * v + 1) (cons false (encB bl k)) := by
      show ones 1 (ones (2 * v) _) = _
      rw [ones_add]; congr 1 <;> omega
    rw [e]
    have h := retB k bl (cons false (u c (encLT rest blank))) v (fun p hp => hbl p (by simpa using hp))
    rw [back_cons]
    simp only [encLT_append, encLT] at h ⊢
    exact h

theorem scan_turns (k : Nat) (bl : List Nat) (s : Bool) (c : Nat) (rest : List (Bool × Nat))
    (r : Nat × List (Bool × Nat)) (hbl : ∀ p ∈ bl.drop 1, 1 ≤ p) (hnp : ¬ (bl.headD k % 2 = 1 ∧ s = false))
    (hs : scan k bl ((s, c) :: rest) = some r) : Reach (PS k bl s c rest) (V r.1 r.2) := by
  obtain ⟨s2, L, hL⟩ := encLT_cons_split rest
  unfold scan at hs
  by_cases hv : bl.headD k % 2 = 1
  · have hp : par (bl.headD k) = .E := by unfold par; exact ite_eq_right_iff.mpr (fun h => absurd h (by omega))
    have hs1 : s = true := by cases s <;> simp_all
    subst hs1
    simp only [hv, ↓reduceIte] at hs
    by_cases hc : c = 0
    · simp [hc] at hs
    simp only [hc, ↓reduceIte, Option.some.injEq] at hs
    subst hs
    obtain ⟨c', rfl⟩ : ∃ c', c = c' + 1 := ⟨c - 1, by omega⟩
    refine reach_trans ?_ (by simpa using turn_out k bl c' rest hbl)
    unfold PS
    rw [hp]
    have h := turn .E true (Or.inl ⟨rfl, rfl⟩) c' s2 L (encB bl k)
    rw [← hL] at h
    exact h
  · have hp : par (bl.headD k) = .D := by unfold par; exact ite_eq_left_iff.mpr (fun h => absurd (by omega) h)
    simp only [hv, ↓reduceIte] at hs
    cases s
    · -- D on a separator 0: the counter c loses one
      simp only [Bool.false_eq_true, ↓reduceIte] at hs
      by_cases hc : c = 0
      · simp [hc] at hs
      simp only [hc, ↓reduceIte, Option.some.injEq] at hs
      subst hs
      obtain ⟨c', rfl⟩ : ∃ c', c = c' + 1 := ⟨c - 1, by omega⟩
      refine reach_trans ?_ (by simpa using turn_out k bl c' rest hbl)
      unfold PS
      rw [hp]
      have h := turn .D false (Or.inr ⟨rfl, rfl⟩) c' s2 L (encB bl k)
      rw [← hL] at h
      exact h
    · -- D on a separator 1: the counter right of it loses one
      simp only [↓reduceIte] at hs
      unfold PS
      rw [hp]
      cases bl with
      | nil =>
        simp only [Option.some.injEq] at hs
        subst hs
        have e : encB [] k = cons true (ones (2 * (k + 1) + 1) blank) := by
          show ones (2 * k + 4) blank = _
          rw [ones_pos _ _ (by omega)]; congr 2 <;> omega
        rw [e]
        refine reach_trans (turnA _ _) ?_
        exact endr (k + 1) _
      | cons v bl' =>
        by_cases h0 : v = 0
        · simp [h0] at hs
        simp only [h0, ↓reduceIte, Option.some.injEq] at hs
        subst hs
        have e : encB (v :: bl') k = cons true (ones (2 * (v - 1) + 1) (cons false (encB bl' k))) := by
          show ones (2 * v) _ = _
          rw [ones_pos _ _ (by omega)]; congr 2 <;> omega
        rw [e]
        refine reach_trans (turnA _ _) ?_
        have h := retB k bl' (cons false (u c (encLT rest blank))) (v - 1) (fun p hp' => hbl p (by simpa using hp'))
        unfold V
        rw [encLT_append]
        rw [encLT_append] at h
        exact h

theorem scan_reach (k : Nat) : ∀ (rest : List (Bool × Nat)) (bl : List Nat) (s : Bool) (c : Nat)
    (r : Nat × List (Bool × Nat)), (∀ p ∈ bl.drop 1, 1 ≤ p) → scan k bl ((s, c) :: rest) = some r →
    Reach (PS k bl s c rest) (V r.1 r.2) := by
  intro rest
  induction rest with
  | nil =>
    intro bl s c r hbl hs
    by_cases hnp : bl.headD k % 2 = 1 ∧ s = false
    · obtain ⟨hv, rfl⟩ := hnp
      have hv' := hv
      simp at hv'
      unfold scan at hs
      simp [hv'] at hs
    · exact scan_turns k bl s c [] r hbl hnp hs
  | cons q rest2 ih =>
    intro bl s c r hbl hs
    by_cases hnp : bl.headD k % 2 = 1 ∧ s = false
    · obtain ⟨hv, rfl⟩ := hnp
      obtain ⟨s3, c2⟩ := q
      have hs' : scan k (c :: bl) ((s3, c2) :: rest2) = some r := by
        have hv' := hv
        simp at hv'
        unfold scan at hs
        simpa [hv'] using hs
      have hp : par (bl.headD k) = .E := by unfold par; exact ite_eq_right_iff.mpr (fun h => absurd h (by omega))
      refine reach_trans ?_ (ih (c :: bl) s3 c2 r ?_ hs')
      · unfold PS
        rw [hp]
        exact cross c s3 (u c2 (encLT rest2 blank)) (encB bl k)
      · intro p hp'
        cases bl with
        | nil => simp at hp'
        | cons v bl' =>
          simp only [List.drop_succ_cons, List.drop_zero, List.mem_cons] at hp'
          rcases hp' with rfl | hp'
          · simp [List.headD] at hv; omega
          · exact hbl p (by simpa using hp')
    · exact scan_turns k bl s c (q :: rest2) r hbl hnp hs

/-- **The ordinary visits.** For every counter list on which `ordinary` is defined, the machine goes from its tape
to the tape of the result. -/
theorem ordinary_visit (k : Nat) (ps : List (Bool × Nat)) (r : Nat × List (Bool × Nat)) (h : ordinary k ps = some r) :
    Reach (V k ps) (V r.1 r.2) := by
  unfold ordinary at h
  by_cases hk : k = 0
  · simp [hk] at h
  simp only [hk, ↓reduceIte] at h
  cases ps with
  | nil => simp [scan] at h
  | cons q rest =>
    obtain ⟨s, c⟩ := q
    refine reach_trans ?_ (scan_reach k rest [] s c r (by simp) h)
    unfold V PS
    exact start k (by omega) s _

end H16609
