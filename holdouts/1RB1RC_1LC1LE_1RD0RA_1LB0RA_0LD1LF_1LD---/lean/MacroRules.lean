/-- C over 1^(2j+1) 0 1, j = 2b+1. -/
theorem ret_o (b : Nat) (L R : Tape) :
    steps (4 * b + 11) ⟨cons true (L), cons true (cons true (cons true (rep (b) [true, true, true, true] (cons false (cons true (R)))))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (L))))))), R, .C⟩ := by
  have hn : 0 + ((b) * 4 + (11)) = 4 * b + 11 := by omega
  have h0 : steps 0 ⟨cons true (L), cons true (cons true (cons true (rep (b) [true, true, true, true] (cons false (cons true (R)))))), .C⟩ = some ⟨cons true (L), rep (b) [true, true, true, true] (cons true (cons true (cons true (cons false (cons true (R)))))), .C⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (b) [true, true, true, true] (cons false (cons true (R)))))) = rep (b) [true, true, true, true] (cons true (cons true (cons true (cons false (cons true (R)))))) from
      rep_rotate (b) [true, true, true] [true, true, true, true] [true, true, true, true] rfl (cons false (cons true (R)))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true, true, true] R, .C⟩ = some ⟨app [] (app [true, false, true, false] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((b) * 4) ⟨cons true (L), rep (b) [true, true, true, true] (cons true (cons true (cons true (cons false (cons true (R)))))), .C⟩ = some ⟨rep (b) [true, false, true, false] (cons true (L)), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ :=
    cross_r trans c1 (b) (cons true (L)) (cons true (cons true (cons true (cons false (cons true (R))))))
  have h2 : steps 11 ⟨rep (b) [true, false, true, false] (cons true (L)), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (rep (b) [true, false, true, false] (cons true (L))))))), R, .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- C over 1^(2j+1) 0 1, j = 2b+2. -/
theorem ret_e (b : Nat) (L R : Tape) :
    steps (4 * b + 13) ⟨cons true (L), cons true (rep (b + 1) [true, true, true, true] (cons false (cons true (R)))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (L))))))))), R, .C⟩ := by
  have hn : 0 + ((b + 1) * 4 + (9)) = 4 * b + 13 := by omega
  have h0 : steps 0 ⟨cons true (L), cons true (rep (b + 1) [true, true, true, true] (cons false (cons true (R)))), .C⟩ = some ⟨cons true (L), rep (b + 1) [true, true, true, true] (cons true (cons false (cons true (R)))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (b + 1) [true, true, true, true] (cons false (cons true (R)))) = rep (b + 1) [true, true, true, true] (cons true (cons false (cons true (R)))) from
      rep_rotate (b + 1) [true] [true, true, true, true] [true, true, true, true] rfl (cons false (cons true (R)))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true, true, true] R, .C⟩ = some ⟨app [] (app [true, false, true, false] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((b + 1) * 4) ⟨cons true (L), rep (b + 1) [true, true, true, true] (cons true (cons false (cons true (R)))), .C⟩ = some ⟨rep (b + 1) [true, false, true, false] (cons true (L)), cons true (cons false (cons true (R))), .C⟩ :=
    cross_r trans c1 (b + 1) (cons true (L)) (cons true (cons false (cons true (R))))
  have h2 : steps 9 ⟨rep (b + 1) [true, false, true, false] (cons true (L)), cons true (cons false (cons true (R))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (L))))))))), R, .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- C over 1 at the end (j = 0): the visit. -/
theorem end_z (L : Tape) :
    steps (1) ⟨cons true (L), cons true (blank), .C⟩ = some ⟨cons false (cons true (L)), blank, .A⟩ := by
  have hn : 1 = 1 := by omega
  have h0 : steps 1 ⟨cons true (L), cons true (blank), .C⟩ = some ⟨cons false (cons true (L)), blank, .A⟩ := rfl
