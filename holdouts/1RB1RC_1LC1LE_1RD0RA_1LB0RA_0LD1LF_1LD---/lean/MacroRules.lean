/-- C over 1 0 1 (j = 0). -/
theorem ret_z (L R : Tape) :
    steps (9) ⟨cons true (L), cons true (cons false (cons true (R))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), R, .C⟩ := by
  have hn : 9 = 9 := by omega
  have h0 : steps 9 ⟨cons true (L), cons true (cons false (cons true (R))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), R, .C⟩ := rfl
