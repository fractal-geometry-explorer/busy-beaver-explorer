/-- C over 1^(2j+1) at the end, j = 2b+1: the visit. -/
theorem end_o (b : Nat) (L : Tape) :
    steps (4 * b + 3) ⟨cons true (L), cons true (cons true (cons true (rep (b) [true, true, true, true] (blank)))), .C⟩ = some ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (L))))), blank, .A⟩ := by
  have hn : 0 + ((b) * 4 + (3)) = 4 * b + 3 := by omega
  have h0 : steps 0 ⟨cons true (L), cons true (cons true (cons true (rep (b) [true, true, true, true] (blank)))), .C⟩ = some ⟨cons true (L), rep (b) [true, true, true, true] (cons true (cons true (cons true (blank)))), .C⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (b) [true, true, true, true] (blank)))) = rep (b) [true, true, true, true] (cons true (cons true (cons true (blank)))) from
      rep_rotate (b) [true, true, true] [true, true, true, true] [true, true, true, true] rfl (blank)]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true, true, true] R, .C⟩ = some ⟨app [] (app [true, false, true, false] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((b) * 4) ⟨cons true (L), rep (b) [true, true, true, true] (cons true (cons true (cons true (blank)))), .C⟩ = some ⟨rep (b) [true, false, true, false] (cons true (L)), cons true (cons true (cons true (blank))), .C⟩ :=
    cross_r trans c1 (b) (cons true (L)) (cons true (cons true (cons true (blank))))
  have h2 : steps 3 ⟨rep (b) [true, false, true, false] (cons true (L)), cons true (cons true (cons true (blank))), .C⟩ = some ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (L))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- C over 1^(2j+1) at the end, j = 2b+2: the visit. -/
theorem end_e (b : Nat) (L : Tape) :
    steps (4 * b + 5) ⟨cons true (L), cons true (rep (b + 1) [true, true, true, true] (blank)), .C⟩ = some ⟨cons false (rep (b + 1) [true, false, true, false] (cons true (L))), blank, .A⟩ := by
  have hn : 0 + ((b + 1) * 4 + (1)) = 4 * b + 5 := by omega
  have h0 : steps 0 ⟨cons true (L), cons true (rep (b + 1) [true, true, true, true] (blank)), .C⟩ = some ⟨cons true (L), rep (b + 1) [true, true, true, true] (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (rep (b + 1) [true, true, true, true] (blank)) = rep (b + 1) [true, true, true, true] (cons true (blank)) from
      rep_rotate (b + 1) [true] [true, true, true, true] [true, true, true, true] rfl (blank)]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, true, true, true] R, .C⟩ = some ⟨app [] (app [true, false, true, false] L), R, .C⟩ := fun _ _ => rfl
  have h1 : steps ((b + 1) * 4) ⟨cons true (L), rep (b + 1) [true, true, true, true] (cons true (blank)), .C⟩ = some ⟨rep (b + 1) [true, false, true, false] (cons true (L)), cons true (blank), .C⟩ :=
    cross_r trans c1 (b + 1) (cons true (L)) (cons true (blank))
  have h2 : steps 1 ⟨rep (b + 1) [true, false, true, false] (cons true (L)), cons true (blank), .C⟩ = some ⟨cons false (rep (b + 1) [true, false, true, false] (cons true (L))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

