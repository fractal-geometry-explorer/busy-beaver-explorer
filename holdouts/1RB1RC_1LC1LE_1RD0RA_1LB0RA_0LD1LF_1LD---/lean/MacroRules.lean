/-- D on a separator 0, counter c+1 = 2b+1 left of it: it loses one, C turns right. -/
theorem turnD_o1 (b : Nat) (L R : Tape) :
    steps (4) ⟨cons false (cons true (rep (b) [false, true, false, true] (cons true (L)))), cons false (R), .D⟩ = some ⟨cons true (cons false (rep (b) [false, true, false, true] (cons true (L)))), cons true (R), .C⟩ := by
  have hn : 4 = 4 := by omega
  have h0 : steps 4 ⟨cons false (cons true (rep (b) [false, true, false, true] (cons true (L)))), cons false (R), .D⟩ = some ⟨cons true (cons false (rep (b) [false, true, false, true] (cons true (L)))), cons true (R), .C⟩ := rfl
  exact steps_congr trans hn (h0)

/-- D on a separator 0, counter c+1 = 2b+2 left of it: it loses one, C turns right. -/
theorem turnD_e1 (b : Nat) (L R : Tape) :
