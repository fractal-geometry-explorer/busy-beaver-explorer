namespace H4608

open TM

/-- Rightward over the (10)^n part, C shifts each 01 to 10. -/
theorem c_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [false, true] (R), .C⟩ = some ⟨rep (n) [false, true] (L), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [false, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [false, true] (R), .C⟩ = some ⟨rep (n) [false, true] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Rightward, D shifts each 10 to 01 (C and D alternate the phase). -/
theorem d_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, false] (R), .D⟩ = some ⟨rep (n) [true, false] (L), R, .D⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .D⟩ = some ⟨app [] (app [true, false] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, false] (R), .D⟩ = some ⟨rep (n) [true, false] (L), R, .D⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Leftward, D runs over (01)^n. -/
theorem d_back (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [true, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [false, true] (R)), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [true, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [false, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Leftward, E runs over (10)^n. -/
theorem e_back (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [false, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [true, false] (R)), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [false, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [true, false] (R)), .E⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Rightward over the counter blocks a = 1101010, D rewrites each one as 0011001 ... -/
theorem d_blocks (n : Nat) (L R : Tape) :
    steps (7 * n) ⟨L, rep (n) [true, true, false, true, false, true, false] (R), .D⟩ = some ⟨rep (n) [true, false, false, true, true, false, false] (L), R, .D⟩ := by
  have c0 : ∀ L R : Tape, steps 7 ⟨app [] L, app [true, true, false, true, false, true, false] R, .D⟩ = some ⟨app [] (app [true, false, false, true, true, false, false] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 7) ⟨L, rep (n) [true, true, false, true, false, true, false] (R), .D⟩ = some ⟨rep (n) [true, false, false, true, true, false, false] (L), R, .D⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 7) (by omega) (h0)

/-- ... leftward D rewrites it as 0101101 ... -/
theorem d_blocks_back (n : Nat) (L R : Tape) :
    steps (17 * n) ⟨rep (n) [true, false, false, true, true, false, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [false, true, false, true, true, false, true] (R)), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 17 ⟨app [true, false, false, true, true, false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 17) ⟨rep (n) [true, false, false, true, true, false, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [false, true, false, true, true, false, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 17) (by omega) (h0)

/-- ... and rightward F rewrites it again: the blocks cycle through a few phases as the head crosses them. -/
theorem f_blocks (n : Nat) (L R : Tape) :
    steps (7 * n) ⟨L, rep (n) [false, true, false, true, true, false, true] (R), .F⟩ = some ⟨rep (n) [true, true, false, false, true, false, false] (L), R, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 7 ⟨app [] L, app [false, true, false, true, true, false, true] R, .F⟩ = some ⟨app [] (app [true, true, false, false, true, false, false] L), R, .F⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 7) ⟨L, rep (n) [false, true, false, true, true, false, true] (R), .F⟩ = some ⟨rep (n) [true, true, false, false, true, false, false] (L), R, .F⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 7) (by omega) (h0)

/-- The only way to a halt: C on 1 0 1 1 reaches F on a 1 (which halts) in 3 steps. -/
theorem halt_shape (L R : Tape) :
    steps (3) ⟨L, cons true (cons false (cons true (cons true (R)))), .C⟩ = some ⟨cons true (cons true (cons false (L))), cons true (R), .F⟩ := by
  have h0 : steps 3 ⟨L, cons true (cons false (cons true (cons true (R)))), .C⟩ = some ⟨cons true (cons true (cons false (L))), cons true (R), .F⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)

/-- F reading a 1 halts (the end of `halt_shape`). -/
theorem halt_after_shape (L R : Tape) : step ⟨L, cons true R, .F⟩ = none := rfl

