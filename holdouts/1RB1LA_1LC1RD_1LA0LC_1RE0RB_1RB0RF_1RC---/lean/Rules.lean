  have h3 : steps ((j) * 3) ⟨cons true (rep (k + 2) [false, true] (cons true (cons true (L)))), rep (j) [false, false, true] (cons false (cons true (cons true (R)))), .D⟩ = some ⟨rep (j) [true, true, true] (cons true (rep (k + 2) [false, true] (cons true (cons true (L))))), cons false (cons true (cons true (R))), .D⟩ :=
