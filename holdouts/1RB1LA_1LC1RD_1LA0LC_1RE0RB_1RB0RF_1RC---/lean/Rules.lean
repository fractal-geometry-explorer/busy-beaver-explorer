/-- An even top block in front of a gap of length one: the gap is filled and the pass ends normally.  (Ends at `L 1 1 (10)^k 1 A> 0 1 1 1 1 1 R`.) -/
theorem pass_even_g1 (k : Nat) (L R : Tape) :
