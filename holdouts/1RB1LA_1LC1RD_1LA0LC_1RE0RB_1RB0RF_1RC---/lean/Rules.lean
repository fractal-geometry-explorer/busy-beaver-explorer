  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [false, true] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((k + 2) * 2) ⟨cons true (cons true (L)), rep (k + 2) [true, true] (cons false (cons true (cons true (R)))), .B⟩ = some ⟨rep (k + 2) [false, true] (cons true (cons true (L))), cons false (cons true (cons true (R))), .B⟩ :=
    cross_r trans c1 (k + 2) (cons true (cons true (L))) (cons false (cons true (cons true (R))))
  have h2 : steps 3 ⟨rep (k + 2) [false, true] (cons true (cons true (L))), cons false (cons true (cons true (R))), .B⟩ = some ⟨cons true (rep (k) [false, true] (cons true (cons true (L)))), cons false (cons true (cons true (cons true (cons true (cons true (R)))))), .A⟩ := rfl
