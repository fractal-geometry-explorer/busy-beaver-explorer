import Machine

/-! # Shift rules of 1RB0LD_1LC0RE_---1LD_1LE1LA_1RA0LF_1LC1RE

Two fast moves of the machine over the alternating background `1010...` of its tape: A moving right turns each
`0101` into `1101` (`fill_A`), B moving right turns each `1010` into `1011` (`fill_B`), eight steps a copy.  The only
halt is C reading a 0; C is entered from B and from F reading a 0, writing a 1 and stepping left, so `0 B> 0` and
`0 F> 0` halt after two steps (`halt_B`, `halt_F`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H152404

open TM

/-- A moving right over the alternating background, eight steps a copy. -/
theorem fill_A (n : Nat) (L R : Tape) :
    steps (8 * n) ⟨L, rep (n) [false, true, false, true] (R), .A⟩ = some ⟨rep (n) [true, false, true, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, false, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 8) ⟨L, rep (n) [false, true, false, true] (R), .A⟩ = some ⟨rep (n) [true, false, true, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 8) (by omega) (h0)

/-- B moving right over the alternating background, eight steps a copy. -/
theorem fill_B (n : Nat) (L R : Tape) :
    steps (8 * n) ⟨L, rep (n) [true, false, true, false] (R), .B⟩ = some ⟨rep (n) [true, true, false, true] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 8) ⟨L, rep (n) [true, false, true, false] (R), .B⟩ = some ⟨rep (n) [true, true, false, true] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 8) (by omega) (h0)

/-- `0 B> 0` halts: B writes a 1 and steps left in state C onto a 0, which has no transition. -/
theorem halt_B (L R : Tape) :
    ∃ c, steps 1 ⟨cons false L, cons false R, .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 F> 0` halts the same way. -/
theorem halt_F (L R : Tape) :
    ∃ c, steps 1 ⟨cons false L, cons false R, .F⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H152404
