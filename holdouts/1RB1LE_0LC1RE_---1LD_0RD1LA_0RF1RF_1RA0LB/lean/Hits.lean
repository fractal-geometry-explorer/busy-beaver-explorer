/-- The front `2 1`, a hit on the rest and the bounce visit: two visits, 107 steps outside the rest. -/
theorem frontH {Y Y' : Tape} {n : Nat} (h : HitH Y Y' n) :
    steps (n + 107) ⟨app fH Y, blank, .A⟩ = some ⟨app fV Y', blank, .A⟩ := by
