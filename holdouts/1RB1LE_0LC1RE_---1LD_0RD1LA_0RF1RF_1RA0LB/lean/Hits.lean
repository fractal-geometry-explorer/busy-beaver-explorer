theorem level_halt (p j : Nat) (hk hk' : HK) (a b : Nat) (e : haltTab p hk = some (hk', a, b))
    {Y : Tape} {m : Nat} (h : Dies hk Y m) : Dies hk' (W p j Y) (m + (a * j + b)) := by
  unfold haltTab at e
  split at e
  · cases e; exact halt2_H4 j h
  · cases e; exact halt2_HC j h
  · cases e; exact halt4_HC j h
  · cases e; exact halt7_H4 j h
  · cases e; exact halt7_HC j h
  · cases e; exact halt10_HC j h
  · cases e; exact halt12_H4 j h
  · cases e; exact halt12_HC j h
  · cases e; exact halt15_HC j h
  · cases e

