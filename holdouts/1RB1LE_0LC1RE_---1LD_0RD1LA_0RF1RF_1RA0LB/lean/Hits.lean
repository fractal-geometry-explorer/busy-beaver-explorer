/-- The level table: a hit at position `p`, absorbed or passed on. -/
theorem level_hit (p j : Nat) (hp : p < 16) :
    (passOf p = none → ∀ Y, Hit (kindOf p) (W p j Y) (W (nxt p) (j + inc p) Y) (la p * (j + 1) + lb p)) ∧
    (∀ k, passOf p = some k → ∀ Y Y' m, Hit k Y Y' m →
      Hit (kindOf p) (W p j Y) (W (nxt p) (j + inc p) Y') (la p * (j + 1) + lb p + m)) := by
  match p, hp with
  | 0, _ => exact ⟨fun _ Y => hit0 j Y, fun k hk => (by cases hk)⟩
  | 1, _ => exact ⟨fun _ Y => hit1 j Y, fun k hk => (by cases hk)⟩
  | 2, _ => exact ⟨fun h => (by cases h), fun k hk Y Y' m h => (by cases hk; exact hit2 j h)⟩
  | 3, _ => exact ⟨fun _ Y => hit3 j Y, fun k hk => (by cases hk)⟩
  | 4, _ => exact ⟨fun h => (by cases h), fun k hk Y Y' m h => (by cases hk; exact hit4 j h)⟩
  | 5, _ => exact ⟨fun _ Y => hit5 j Y, fun k hk => (by cases hk)⟩
  | 6, _ => exact ⟨fun _ Y => hit6 j Y, fun k hk => (by cases hk)⟩
  | 7, _ => exact ⟨fun h => (by cases h), fun k hk Y Y' m h => (by cases hk; exact hit7 j h)⟩
  | 8, _ => exact ⟨fun _ Y => hit8 j Y, fun k hk => (by cases hk)⟩
  | 9, _ => exact ⟨fun _ Y => hit9 j Y, fun k hk => (by cases hk)⟩
  | 10, _ => exact ⟨fun h => (by cases h), fun k hk Y Y' m h => (by cases hk; exact hit10 j h)⟩
  | 11, _ => exact ⟨fun _ Y => hit11 j Y, fun k hk => (by cases hk)⟩
  | 12, _ => exact ⟨fun h => (by cases h), fun k hk Y Y' m h => (by cases hk; exact hit12 j h)⟩
  | 13, _ => exact ⟨fun _ Y => hit13 j Y, fun k hk => (by cases hk)⟩
  | 14, _ => exact ⟨fun _ Y => hit14 j Y, fun k hk => (by cases hk)⟩
  | 15, _ => exact ⟨fun h => (by cases h), fun k hk Y Y' m h => (by cases hk; exact hit15 j h)⟩
  | n + 16, h => omega

