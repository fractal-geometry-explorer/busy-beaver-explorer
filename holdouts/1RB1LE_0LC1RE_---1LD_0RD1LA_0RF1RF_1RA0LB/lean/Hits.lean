/-- A hit that halts: the first call halts, or the fourth call of an H-hit. -/
inductive HK where
  | HC | H4
  deriving DecidableEq, Repr

def Dies : HK → Tape → Nat → Prop
  | .HC => HC
  | .H4 => H4

/-- Position and the way the rest's hit halts: the way the level's hit halts, and `(a, b)` for the
`a j + b` steps made inside the level before. -/
def haltTab : Nat → HK → Option (HK × Nat × Nat)
  | 2, .H4 => some (.HC, 24, 119)
  | 2, .HC => some (.HC, 24, 72)
  | 4, .HC => some (.H4, 80, 129)
