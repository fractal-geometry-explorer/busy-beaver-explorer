/-- V(X U) = Y Y U: the last pair 0 1 becomes 1 1 1 1, 8 steps. -/
theorem bounce (L : Tape) :
    steps (8) ⟨cons true (cons false (L)), blank, .A⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), blank, .A⟩ := by
  have hn : 8 = 8 := by omega
  have h0 : steps 8 ⟨cons true (cons false (L)), blank, .A⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), blank, .A⟩ := rfl
  exact steps_congr trans hn (h0)

