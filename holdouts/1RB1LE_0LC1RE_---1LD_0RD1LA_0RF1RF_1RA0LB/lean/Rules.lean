/-- The visit of the word Y Y X with blank tape to its left: 17 steps to a configuration with C on a 0. -/
theorem edge_run :
    steps (17) ⟨cons true (cons true (cons true (cons true (cons true (cons false (blank)))))), blank, .A⟩ = some ⟨blank, cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (cons false (blank))))))))), .C⟩ := by
  have hn : 17 = 17 := by omega
  have h0 : steps 17 ⟨cons true (cons true (cons true (cons true (cons true (cons false (blank)))))), blank, .A⟩ = some ⟨blank, cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (cons false (blank))))))))), .C⟩ := rfl
  exact steps_congr trans hn (h0)

/-- A tape of pairs on which the visit reaches the blank left end and halts (not a tape of the run from blank). -/
theorem edge_halts : ∃ c, steps (17) ⟨cons true (cons true (cons true (cons true (cons true (cons false (blank)))))), blank, .A⟩ = some c ∧ step c = none :=
  ⟨_, edge_run, rfl⟩
