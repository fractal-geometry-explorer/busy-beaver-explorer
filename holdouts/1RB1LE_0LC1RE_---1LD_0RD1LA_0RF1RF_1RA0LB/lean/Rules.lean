/-- V(Y^(3j+4) X U) = X X (Y X X)^(j+1) Y U. -/
theorem fam1 (j : Nat) (L : Tape) :
    steps (28 * j + 52) ⟨cons true (cons true (rep (j + 1) [true, true, true, true, true, true] (cons true (cons false (cons true (L)))))), blank, .A⟩ = some ⟨cons true (cons false (cons true (cons false (rep (j + 1) [true, true, true, false, true, false] (cons true (cons true (cons true (L)))))))), blank, .A⟩ := by
  have hn : 2 + (0 + ((j + 1) * 18 + (14 + (0 + ((j + 1) * 10 + (8)))))) = 28 * j + 52 := by omega
  have h0 : steps 2 ⟨cons true (cons true (rep (j + 1) [true, true, true, true, true, true] (cons true (cons false (cons true (L)))))), blank, .A⟩ = some ⟨cons true (cons true (rep (j + 1) [true, true, true, true, true, true] (cons true (cons false (cons true (L)))))), cons true (cons false (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (rep (j + 1) [true, true, true, true, true, true] (cons true (cons false (cons true (L)))))), cons true (cons false (blank)), .C⟩ = some ⟨rep (j + 1) [true, true, true, true, true, true] (cons true (cons true (cons true (cons false (cons true (L)))))), cons true (cons false (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (j + 1) [true, true, true, true, true, true] (cons true (cons false (cons true (L)))))) = rep (j + 1) [true, true, true, true, true, true] (cons true (cons true (cons true (cons false (cons true (L)))))) from
      rep_rotate (j + 1) [true, true] [true, true, true, true, true, true] [true, true, true, true, true, true] rfl (cons true (cons false (cons true (L))))]
  have c2 : ∀ L R : Tape, steps 18 ⟨app [true, true, true, true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, false, true, false, false, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((j + 1) * 18) ⟨rep (j + 1) [true, true, true, true, true, true] (cons true (cons true (cons true (cons false (cons true (L)))))), cons true (cons false (blank)), .C⟩ = some ⟨cons true (cons true (cons true (cons false (cons true (L))))), cons true (rep (j + 1) [false, false, true, false, false, true] (cons false (blank))), .C⟩ :=
    cross_l trans c2 (j + 1) (cons true (cons true (cons true (cons false (cons true (L)))))) (cons false (blank))
  have h3 : steps 14 ⟨cons true (cons true (cons true (cons false (cons true (L))))), cons true (rep (j + 1) [false, false, true, false, false, true] (cons false (blank))), .C⟩ = some ⟨cons true (cons true (cons true (L))), cons false (cons false (cons true (rep (j + 1) [false, false, true, false, false, true] (cons false (blank))))), .E⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons true (cons true (L))), cons false (cons false (cons true (rep (j + 1) [false, false, true, false, false, true] (cons false (blank))))), .E⟩ = some ⟨cons true (cons true (cons true (L))), rep (j + 1) [false, false, true, false, false, true] (cons false (cons false (cons true (cons false (blank))))), .E⟩ := by
    simp only [steps_zero, show cons false (cons false (cons true (rep (j + 1) [false, false, true, false, false, true] (cons false (blank))))) = rep (j + 1) [false, false, true, false, false, true] (cons false (cons false (cons true (cons false (blank))))) from
      rep_rotate (j + 1) [false, false, true] [false, false, true, false, false, true] [false, false, true, false, false, true] rfl (cons false (blank))]
  have c5 : ∀ L R : Tape, steps 10 ⟨app [] L, app [false, false, true, false, false, true] R, .E⟩ = some ⟨app [] (app [true, true, true, false, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h5 : steps ((j + 1) * 10) ⟨cons true (cons true (cons true (L))), rep (j + 1) [false, false, true, false, false, true] (cons false (cons false (cons true (cons false (blank))))), .E⟩ = some ⟨rep (j + 1) [true, true, true, false, true, false] (cons true (cons true (cons true (L)))), cons false (cons false (cons true (cons false (blank)))), .E⟩ :=
    cross_r trans c5 (j + 1) (cons true (cons true (cons true (L)))) (cons false (cons false (cons true (cons false (blank)))))
  have h6 : steps 8 ⟨rep (j + 1) [true, true, true, false, true, false] (cons true (cons true (cons true (L)))), cons false (cons false (cons true (cons false (blank)))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (rep (j + 1) [true, true, true, false, true, false] (cons true (cons true (cons true (L)))))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

