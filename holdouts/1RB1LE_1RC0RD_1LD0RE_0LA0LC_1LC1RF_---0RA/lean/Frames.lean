import Cases

/-! The run-length frame map from blank tape, generated by `bbtools.listframe`; do not edit.

`init_f0`: the run from blank tape reaches the frame `f0` (its first head turn) after 2 steps.  `frames_100000`:
the frame map is defined for the first 100000 frames (`native_decide`), so by `rl_reach` the machine runs on through
them.  `no_halt_of_total`: if the frame map is defined forever along this orbit, the machine never halts; that is
the open part. -/

namespace H158007

open TM

def f0 : RLFrame St := (⟨.C, [(true, 2)], []⟩ : RLFrame St)

theorem init_f0 : steps 2 init = some f0.cfg := blank_frame trans (by decide)

theorem frames_100000 : ∀ j, j ≤ 100000 → ∃ f, iterF next j f0 = some f :=
  checkF_sound next 100000 f0 (by native_decide)

theorem no_halt_of_total (h : ∀ k, ∃ f, iterF next k f0 = some f) : ¬ HaltsFromBlank :=
  rl_no_halt trans cases init_f0 h

end H158007
