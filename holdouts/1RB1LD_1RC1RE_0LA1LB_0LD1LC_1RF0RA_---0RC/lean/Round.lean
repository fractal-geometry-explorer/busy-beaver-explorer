import Rules

/-!
# One round of 1RB1LD_1RC1RE_0LA1LB_0LD1LC_1RF0RA_---0RC, for every value, and the reduction to a map

At the end of each round the head is in D at the left end of `110 (10)^m (110)^k`: the configuration `E m k`.
`Rules.lean` (generated by `py/gen_rules.py`) proves the pieces of a round with `bbtools.symtm`; here they are put
in one shape and chained: the start (one rule per residue of `m` mod 3), the sweeps (three `10`s of the left block
become four of the right block, by induction on the sweeps), and the finish.  The result is the map `next`:

* `m = 3t`     : `(m, k) → (4t + 4, k - 1)`   (k = 0 stays 0)
* `m = 3t + 1` : `(m, k) → (4t + 4, k + 1)`
* `m = 3t + 2` : `(m, k) → (4t + 5, k + 1)` if `k ≥ 1`; if `k = 0` the machine halts.

From blank tape the machine reaches `E 8 1` after 280 steps (`blank_to_E`).
-/

namespace H91443

open TM

abbrev P : List Bool := [true, false]
abbrev C3 : List Bool := [true, true, false]
abbrev W : List Bool := [true, false, true, false, true, false]
abbrev W' : List Bool := [false, true, false, true, false, true]
abbrev C3' : List Bool := [false, true, true]

/-- End of a round: `0^inf D> 110 (10)^m (110)^k 0^inf`. -/
def E (m k : Nat) : Config := ⟨blank, cons true (cons true (cons false (rep m P (rep k C3 blank)))), .D⟩

/-- In a round, at the left end: `0^inf B> 1110 (101010)^u 10 110 (10)^y (110)^k 0^inf`. -/
def S (u y k : Nat) : Config :=
  ⟨blank, cons true (cons true (cons true (cons false (rep u W (cons true (cons false (cons true (cons true
    (cons false (rep y P (rep k C3 blank))))))))))), .B⟩

theorem rot101 (u : Nat) (X : Tape) :
    cons true (cons false (cons true (rep u W' X))) = rep u W (cons true (cons false (cons true X))) :=
  rep_rotate u [true, false, true] W' W (by decide) X

theorem rot11 (k : Nat) (X : Tape) : cons true (cons true (rep k C3' X)) = rep k C3 (cons true (cons true X)) :=
  rep_rotate k [true, true] C3' C3 (by decide) X

theorem rep_P3 (t : Nat) (s : Tape) : rep (3 * t) P s = rep t W s := by
  induction t with
  | zero => rfl
  | succ t ih =>
    rw [show 3 * (t + 1) = 3 + 3 * t by omega, rep_add, ih]; rfl

theorem rep_P3_add (t r : Nat) (s : Tape) : rep (3 * t + r) P s = rep t W (rep r P s) := by
  rw [rep_add, rep_P3]

theorem C3_two (k : Nat) : rep (k + 2) C3 blank = cons true (cons true (cons false (rep k C3 (cons true (cons true
    (cons false blank)))))) := by
  rw [show k + 2 = 1 + (k + 1) by omega, rep_add, rep_add k 1]; rfl

theorem C3_one (k : Nat) : rep (k + 1) C3 blank = rep k C3 (cons true (cons true (cons false blank))) := by
  rw [rep_add k 1]; rfl

theorem sweep' (u y k : Nat) : steps (30 * u + 64) (S (u + 1) y k) = some (S u (y + 4) k) := by
  have h := sweep k u y
  have e : (⟨blank, cons true (cons true (cons true (cons false (cons true (cons false (cons true (rep (u) [false, true, false, true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (y) [true, false] (rep (k) [true, true, false] (blank)))))))))))))))))))), .B⟩ : Config) = S u (y + 4) k := by
    unfold S; rw [rot101, show y + 4 = 4 + y by omega, rep_add]; rfl
  rw [← e]; exact h

theorem finish' (y k : Nat) : steps 38 (S 0 y k) = some (E (y + 4) k) := by
  have h := finish k y
  have e : (⟨blank, cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (y) [true, false] (rep (k) [true, true, false] (blank))))))))))))), .D⟩ : Config) = E (y + 4) k := by
    unfold E; rw [show y + 4 = 4 + y by omega, rep_add]; rfl
  rw [← e]; exact h

theorem start1' (t k : Nat) : steps (6 * k + 30 * t + 57) (E (3 * t + 1) k) = some (S t 0 (k + 1)) := by
  have h := start1 k t
  have e : (⟨blank, cons true (cons true (cons true (cons false (cons true (cons false (cons true (rep (t) [false, true, false, true, false, true] (cons true (cons false (cons true (cons true (rep (k) [false, true, true] (cons false (blank)))))))))))))), .B⟩ : Config) = S t 0 (k + 1) := by
    unfold S; rw [rot101, rot11, C3_one]; rfl
  have e2 : E (3 * t + 1) k = ⟨blank, cons true (cons true (cons false (rep (t) [true, false, true, false, true, false] (cons true (cons false (rep (k) [true, true, false] (blank))))))), .D⟩ := by
    unfold E; rw [rep_P3_add]; rfl
  rw [← e, e2]; exact h

theorem start2' (t k : Nat) :
    steps (6 * k + 30 * t + 105) (E (3 * t + 5) (k + 1)) = some (S (t + 1) 1 (k + 2)) := by
  have h := start2 k t
  have e : (⟨blank, cons true (cons true (cons true (cons false (cons true (cons false (cons true (rep (t + 1) [false, true, false, true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (k) [false, true, true] (cons false (blank))))))))))))))))))), .B⟩ : Config) = S (t + 1) 1 (k + 2) := by
    unfold S; rw [rot101, rot11, C3_two]; rfl
  have e2 : E (3 * t + 5) (k + 1) = ⟨blank, cons true (cons true (cons false (rep (t + 1) [true, false, true, false, true, false] (cons true (cons false (cons true (cons false (rep (k + 1) [true, true, false] (blank))))))))), .D⟩ := by
    unfold E; rw [show 3 * t + 5 = 3 * (t + 1) + 2 by omega, rep_P3_add]; rfl
  rw [← e, e2]; exact h

theorem start2_small' (k : Nat) : steps (6 * k + 75) (E 2 (k + 1)) = some (S 0 1 (k + 2)) := by
  have h := start2_small k
  have e : (⟨blank, cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (k) [false, true, true] (cons false (blank)))))))))))))))))), .B⟩ : Config) = S 0 1 (k + 2) := by
    unfold S; rw [rot11, C3_two]; rfl
  rw [← e]; exact h

theorem start0' (t k : Nat) : steps (30 * t + 77) (E (3 * t + 3) (k + 1)) = some (S t 4 k) := by
  have h := start0 k t
  have e : (⟨blank, cons true (cons true (cons true (cons false (cons true (cons false (cons true (rep (t) [false, true, false, true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (k) [true, true, false] (blank))))))))))))))))))), .B⟩ : Config) = S t 4 k := by
    unfold S; rw [rot101]; rfl
  have e2 : E (3 * t + 3) (k + 1) = ⟨blank, cons true (cons true (cons false (rep (t + 1) [true, false, true, false, true, false] (rep (k + 1) [true, true, false] (blank))))), .D⟩ := by
    unfold E; rw [show 3 * t + 3 = 3 * (t + 1) + 0 by omega, rep_P3_add]; rfl
  rw [← e, e2]; exact h

theorem start0z' (t : Nat) : steps (60 * t + 203) (E (3 * t + 6) 0) = some (S (t + 1) 4 0) := by
  have h := start0z t
  have e : (⟨blank, cons true (cons true (cons true (cons false (cons true (cons false (cons true (rep (t + 1) [false, true, false, true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))))))))))))), .B⟩ : Config) = S (t + 1) 4 0 := by
    unfold S; rw [rot101]; rfl
  have e2 : E (3 * t + 6) 0 = ⟨blank, cons true (cons true (cons false (rep (t + 2) [true, false, true, false, true, false] (blank)))), .D⟩ := by
    unfold E; rw [show 3 * t + 6 = 3 * (t + 2) + 0 by omega, rep_P3_add]; rfl
  rw [← e, e2]; exact h

theorem start0z_small' : steps 143 (E 3 0) = some (S 0 4 0) := start0z_small

theorem to_halt' (t : Nat) : ∃ c, steps (10 * t + 37) (E (3 * t + 2) 0) = some c ∧ step c = none := by
  have h := to_halt t
  have e2 : E (3 * t + 2) 0 = ⟨blank, cons true (cons true (cons false (rep (t) [true, false, true, false, true, false] (cons true (cons false (cons true (cons false (blank)))))))), .D⟩ := by
    unfold E; rw [rep_P3_add]; rfl
  rw [e2]
  exact ⟨_, h, rfl⟩

/-- All the sweeps of a round. -/
theorem sweeps (u y k : Nat) : ∃ n, steps n (S u y k) = some (S 0 (y + 4 * u) k) := by
  induction u generalizing y with
  | zero => exact ⟨0, rfl⟩
  | succ u ih =>
    obtain ⟨n, hn⟩ := ih (y + 4)
    refine ⟨30 * u + 64 + n, ?_⟩
    rw [show y + 4 * (u + 1) = y + 4 + 4 * u by omega]
    exact steps_seq trans (sweep' u y k) hn

theorem sweeps_finish (u y k : Nat) : ∃ n, steps n (S u y k) = some (E (y + 4 * u + 4) k) := by
  obtain ⟨n, hn⟩ := sweeps u y k
  exact ⟨n + 38, steps_seq trans hn (finish' _ k)⟩

/-- The map on round ends: `none` where the machine halts. -/
def next (m k : Nat) : Option (Nat × Nat) :=
  if m % 3 = 0 then some (4 * (m / 3) + 4, k - 1)
  else if m % 3 = 1 then some (4 * (m / 3) + 4, k + 1)
  else if k = 0 then none
  else some (4 * (m / 3) + 5, k + 1)

theorem chain {a b c : Config} (h1 : ∃ n, steps n a = some b) (h2 : ∃ n, steps n b = some c) :
    ∃ n, steps n a = some c := by
  obtain ⟨n1, h1⟩ := h1
  obtain ⟨n2, h2⟩ := h2
  exact ⟨n1 + n2, steps_seq trans h1 h2⟩

theorem chain_pos {a b c : Config} {n1 : Nat} (h1 : steps n1 a = some b) (hn : 0 < n1)
    (h2 : ∃ n, steps n b = some c) : ∃ n, 0 < n ∧ steps n a = some c := by
  obtain ⟨n2, h2⟩ := h2
  exact ⟨n1 + n2, by omega, steps_seq trans h1 h2⟩

theorem round_some (m k m' k' : Nat) (hm : 1 ≤ m) (h : next m k = some (m', k')) :
    ∃ n, 0 < n ∧ steps n (E m k) = some (E m' k') := by
  obtain ⟨t, r, hr, rfl⟩ : ∃ t r, r < 3 ∧ m = 3 * t + r := ⟨m / 3, m % 3, Nat.mod_lt _ (by omega), by omega⟩
  have hmod : (3 * t + r) % 3 = r := by omega
  have hdiv : (3 * t + r) / 3 = t := by omega
  unfold next at h
  rw [hmod, hdiv] at h
  rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2) with rfl | rfl | rfl
  · obtain ⟨t, rfl⟩ : ∃ t', t = t' + 1 := ⟨t - 1, by omega⟩
    simp only [ite_true, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    cases k with
    | succ k =>
      have := chain_pos (start0' t k) (by omega) (sweeps_finish t 4 k)
      rw [show 3 * (t + 1) + 0 = 3 * t + 3 by omega, show 4 * (t + 1) + 4 = 4 + 4 * t + 4 by omega]
      simpa using this
    | zero =>
      cases t with
      | zero => exact chain_pos (start0z_small') (by omega) (sweeps_finish 0 4 0)
      | succ t =>
        have := chain_pos (start0z' t) (by omega) (sweeps_finish (t + 1) 4 0)
        rw [show 3 * (t + 1 + 1) + 0 = 3 * t + 6 by omega,
          show 4 * (t + 1 + 1) + 4 = 4 + 4 * (t + 1) + 4 by omega]
        exact this
  · simp only [Nat.one_ne_zero, ite_false, ite_true, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    have := chain_pos (start1' t k) (by omega) (sweeps_finish t 0 (k + 1))
    rw [show 4 * t + 4 = 0 + 4 * t + 4 by omega]
    exact this
  · cases k with
    | zero => simp at h
    | succ k =>
      simp only [show (2 : Nat) ≠ 0 by omega, show (2 : Nat) ≠ 1 by omega, Nat.add_one_ne_zero, ite_false,
        Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      cases t with
      | zero => exact chain_pos (start2_small' k) (by omega) (sweeps_finish 0 1 (k + 2))
      | succ t =>
        have := chain_pos (start2' t k) (by omega) (sweeps_finish (t + 1) 1 (k + 2))
        rw [show 3 * (t + 1) + 2 = 3 * t + 5 by omega, show 4 * (t + 1) + 5 = 1 + 4 * (t + 1) + 4 by omega]
        exact this

theorem round_none (m k : Nat) (h : next m k = none) : ∃ n c, steps n (E m k) = some c ∧ step c = none := by
  obtain ⟨t, r, hr, rfl⟩ : ∃ t r, r < 3 ∧ m = 3 * t + r := ⟨m / 3, m % 3, Nat.mod_lt _ (by omega), by omega⟩
  have hmod : (3 * t + r) % 3 = r := by omega
  unfold next at h
  rw [hmod] at h
  rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2) with rfl | rfl | rfl
  · simp at h
  · simp at h
  · cases k with
    | zero => obtain ⟨c, h1, h2⟩ := to_halt' t; exact ⟨_, c, h1, h2⟩
    | succ k => simp at h

/-- From blank tape: the end of the first full round, `E 8 1`, after 280 steps. -/
theorem blank_to_E : steps 280 init = some (E 8 1) :=
  blank_reaches trans (n := 280) (q := .A) (c := ⟨[], [true, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, true, false], .D⟩) (by decide +kernel)


/-- The orbit of the first round end under the map (`none` once the map has said "halt"). -/
def orbit : Nat → Option (Nat × Nat)
  | 0 => some (8, 1)
  | n + 1 => match orbit n with
    | none => none
    | some (m, k) => next m k

theorem next_ge (m k m' k' : Nat) (h : next m k = some (m', k')) : 4 ≤ m' := by
  unfold next at h
  split at h
  · simp only [Option.some.injEq, Prod.mk.injEq] at h; omega
  · split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h; omega
    · split at h
      · cases h
      · simp only [Option.some.injEq, Prod.mk.injEq] at h; omega

theorem orbit_ge (n m k : Nat) (h : orbit n = some (m, k)) : 1 ≤ m := by
  cases n with
  | zero => simp [orbit] at h; omega
  | succ n =>
    simp only [orbit] at h
    split at h
    · cases h
    · exact Nat.le_trans (by omega) (next_ge _ _ _ _ h)

/-- Every point of the orbit is a configuration of the run from blank tape, at a time at least its index. -/
theorem reach (n : Nat) : ∀ m k, orbit n = some (m, k) → ∃ T, n ≤ T ∧ steps T init = some (E m k) := by
  induction n with
  | zero =>
    intro m k h
    simp only [orbit, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨280, by omega, blank_to_E⟩
  | succ n ih =>
    intro m' k' h
    simp only [orbit] at h
    split at h
    · cases h
    · rename_i m k hmk
      obtain ⟨T, hT, hs⟩ := ih m k hmk
      obtain ⟨r, hr, hr'⟩ := round_some m k m' k' (orbit_ge n m k hmk) h
      exact ⟨T + r, by omega, steps_seq trans hs hr'⟩

/-- If the orbit never reaches a halting pair, the machine runs forever from blank tape. -/
theorem not_halts_of_orbit (h : ∀ n, orbit n ≠ none) : ¬ HaltsFromBlank := by
  apply not_halts_of_forall
  apply forall_of_unbounded trans (fun T => ∃ c, steps T init = some c)
  · intro n
    cases e : orbit n with
    | none => exact absurd e (h n)
    | some p =>
      obtain ⟨m, k⟩ := p
      obtain ⟨T, hT, hs⟩ := reach n m k e
      exact ⟨T, hT, _, hs⟩
  · intro m hm; exact hm

/-- If the orbit reaches a halting pair `(3t+2, 0)`, the machine halts from blank tape. -/
theorem halts_of_orbit (n : Nat) (h : orbit n = none) : HaltsFromBlank := by
  induction n with
  | zero => simp [orbit] at h
  | succ n ih =>
    simp only [orbit] at h
    split at h
    · exact ih (by assumption)
    · rename_i m k hmk
      obtain ⟨T, -, hs⟩ := reach n m k hmk
      obtain ⟨r, c, hr, hc⟩ := round_none m k h
      exact ⟨T + r, c, steps_seq trans hs hr, hc⟩

/-- The reduction: the machine halts from blank tape if and only if the orbit of `(8, 1)` under `next` reaches a
pair `(3t + 2, 0)`. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ n, orbit n = none := by
  constructor
  · intro hh
    exact Classical.byContradiction fun hne => not_halts_of_orbit (fun n hn => hne ⟨n, hn⟩) hh
  · rintro ⟨n, hn⟩
    exact halts_of_orbit n hn

end H91443
