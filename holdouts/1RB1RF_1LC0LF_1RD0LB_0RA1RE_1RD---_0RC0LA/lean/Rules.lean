/-- In state E moving right, every `00100101` becomes `10101111`: 8n steps. -/
theorem sweepE (n : Nat) (L R : Tape) :
    steps (8 * n) ⟨L, rep (n) [false, false, true, false, false, true, false, true] (R), .E⟩ = some ⟨rep (n) [true, true, true, true, false, true, false, true] (L), R, .E⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [] L, app [false, false, true, false, false, true, false, true] R, .E⟩ = some ⟨app [] (app [true, true, true, true, false, true, false, true] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 8) ⟨L, rep (n) [false, false, true, false, false, true, false, true] (R), .E⟩ = some ⟨rep (n) [true, true, true, true, false, true, false, true] (L), R, .E⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 8) (by omega) (h0)

