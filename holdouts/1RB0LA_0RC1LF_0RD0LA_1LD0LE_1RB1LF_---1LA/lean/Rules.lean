import Machine

/-! # Shift rules of 1RB0LA_0RC1LF_0RD0LA_1LD0LE_1RB1LF_---1LA

Two of the crossings the run uses most: C, with a 0 behind it, walks right through a block of 1s, three steps a
cell, moving the 0 along (`walk_ones`), and C turns `0111` into `1110` (`shift_0111`).  The halting situations:
only F reading a 0 halts, and `0 B> 1`, `0 E> 1` and `0 1 1 D> 0` lead there (`halt_B`, `halt_E`, `halt_D`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H45336

open TM

/-- C carries a 0 rightwards through a block of 1s, three steps a cell. -/
theorem walk_ones (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨cons false (L), rep (n) [true] (R), .C⟩ = some ⟨cons false (rep (n) [true] (L)), R, .C⟩ := by
  have hn : (n) * 3 = 3 * n := by omega
  have c0 : ∀ L R : Tape, steps 3 ⟨app [false] L, app [true] R, .C⟩ = some ⟨app [false] (app [true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨cons false (L), rep (n) [true] (R), .C⟩ = some ⟨cons false (rep (n) [true] (L)), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- C turns each `0111` into `1110`, ten steps a copy. -/
theorem shift_0111 (n : Nat) (L R : Tape) :
    steps (10 * n) ⟨L, rep (n) [false, true, true, true] (R), .C⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .C⟩ := by
  have hn : (n) * 10 = 10 * n := by omega
  have c0 : ∀ L R : Tape, steps 10 ⟨app [] L, app [false, true, true, true] R, .C⟩ = some ⟨app [] (app [false, true, true, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 10) ⟨L, rep (n) [false, true, true, true] (R), .C⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `0 B> 1` halts: B writes 1, steps left onto the 0 in state F. -/
theorem halt_B (L R : Tape) : ∃ c, steps 1 ⟨cons false (L), cons true (R), .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 E> 1` halts: E steps left onto the 0 in state F. -/
theorem halt_E (L R : Tape) : ∃ c, steps 1 ⟨cons false (L), cons true (R), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 1 1 D> 0` halts: D writes 1 and steps left onto a 1, erases it moving left in state E, and E steps from the next 1 onto the 0 in state F. -/
theorem halt_D (L R : Tape) : ∃ c, steps 3 ⟨cons true (cons true (cons false (L))), cons false (R), .D⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H45336
