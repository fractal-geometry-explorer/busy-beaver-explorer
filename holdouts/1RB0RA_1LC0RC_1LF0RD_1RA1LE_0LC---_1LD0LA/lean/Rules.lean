import Machine

/-! # Sweep rules of 1RB0RA_1LC0RC_1LF0RD_1RA1LE_0LC---_1LD0LA

Going right, D and A take turns crossing the blocks `011`, each turned into `100`, three steps a block (`walk_DA`).
Two whole sweeps of the separator counter, for every length of the first two blocks and every tape beyond them:
with an even first block and the separator `1`, the sweep lengthens the first block by one and turns the separator
into `01` (`sweep_1`); with an odd first block and the separator `01`, it lengthens the first block by two, turns
the separator into `111` and takes one block from the second run (`sweep_01`).  These are four of the eight sweeps of
the first level's cycle.  The halting situation: E reads a 1 only right after D read a 1 with a 1 on its left
(`halt_D`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H26127

open TM

/-- Going right, D and A take turns: each pair of blocks `011 011` becomes `100 100`, six steps a pair. -/
theorem walk_DA (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨L, rep (n) [false, true, true, false, true, true] (R), .D⟩ = some ⟨rep (n) [false, false, true, false, false, true] (L), R, .D⟩ := by
  have hn : (n) * 6 = 6 * n := by omega
  have c0 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, true, false, true, true] R, .D⟩ = some ⟨app [] (app [false, false, true, false, false, true] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨L, rep (n) [false, true, true, false, true, true] (R), .D⟩ = some ⟨rep (n) [false, false, true, false, false, true] (L), R, .D⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- A sweep from the left end with first block of even length 2k+2 and separator `1`: the block gains one `011` and the separator becomes `01`. -/
theorem sweep_1 (k m : Nat) (R : Tape) :
    steps (20 * k + 24) ⟨blank, rep (k + 1) [false, true, true, false, true, true] (cons true (rep (m + 2) [false, true, true] (R))), .D⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons false (cons true (rep (m + 2) [false, true, true] (R))))))))))))), .D⟩ := by
  have hn : (k + 1) * 6 + (10 + ((k) * 14 + (8))) = 20 * k + 24 := by omega
  have c0 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, true, false, true, true] R, .D⟩ = some ⟨app [] (app [false, false, true, false, false, true] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((k + 1) * 6) ⟨blank, rep (k + 1) [false, true, true, false, true, true] (cons true (rep (m + 2) [false, true, true] (R))), .D⟩ = some ⟨rep (k + 1) [false, false, true, false, false, true] (blank), cons true (rep (m + 2) [false, true, true] (R)), .D⟩ :=
    cross_r trans c0 (k + 1) (blank) (cons true (rep (m + 2) [false, true, true] (R)))
  have h1 : steps 10 ⟨rep (k + 1) [false, false, true, false, false, true] (blank), cons true (rep (m + 2) [false, true, true] (R)), .D⟩ = some ⟨rep (k) [false, false, true, false, false, true] (blank), cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (m + 2) [false, true, true] (R)))))))), .F⟩ := rfl
  have c2 : ∀ L R : Tape, steps 14 ⟨app [false, false, true, false, false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false, true, true, false, true] R), .F⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 14) ⟨rep (k) [false, false, true, false, false, true] (blank), cons true (cons true (cons false (cons true (cons true (cons false (cons true (rep (m + 2) [false, true, true] (R)))))))), .F⟩ = some ⟨blank, cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons false (cons true (rep (m + 2) [false, true, true] (R))))))))), .F⟩ :=
    cross_l trans c2 (k) (blank) (cons true (cons false (cons true (cons true (cons false (cons true (rep (m + 2) [false, true, true] (R))))))))
  have h3 : steps 8 ⟨blank, cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons false (cons true (rep (m + 2) [false, true, true] (R))))))))), .F⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons false (cons true (rep (m + 2) [false, true, true] (R))))))))))))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- A sweep from the left end with first block of odd length 2k+1 and separator `01`: the block gains two, the separator becomes `111` and the next block loses one. -/
theorem sweep_01 (k m : Nat) (R : Tape) :
    steps (20 * k + 18) ⟨blank, rep (k) [false, true, true, false, true, true] (cons false (cons true (cons true (cons false (cons true (rep (m + 1) [false, true, true] (R))))))), .D⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (m) [false, true, true] (R)))))))))))))), .D⟩ := by
  have hn : (k) * 6 + (10 + ((k) * 14 + (8))) = 20 * k + 18 := by omega
  have c0 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, true, false, true, true] R, .D⟩ = some ⟨app [] (app [false, false, true, false, false, true] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((k) * 6) ⟨blank, rep (k) [false, true, true, false, true, true] (cons false (cons true (cons true (cons false (cons true (rep (m + 1) [false, true, true] (R))))))), .D⟩ = some ⟨rep (k) [false, false, true, false, false, true] (blank), cons false (cons true (cons true (cons false (cons true (rep (m + 1) [false, true, true] (R)))))), .D⟩ :=
    cross_r trans c0 (k) (blank) (cons false (cons true (cons true (cons false (cons true (rep (m + 1) [false, true, true] (R)))))))
  have h1 : steps 10 ⟨rep (k) [false, false, true, false, false, true] (blank), cons false (cons true (cons true (cons false (cons true (rep (m + 1) [false, true, true] (R)))))), .D⟩ = some ⟨rep (k) [false, false, true, false, false, true] (blank), cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (m) [false, true, true] (R))))))))), .F⟩ := rfl
  have c2 : ∀ L R : Tape, steps 14 ⟨app [false, false, true, false, false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false, true, true, false, true] R), .F⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 14) ⟨rep (k) [false, false, true, false, false, true] (blank), cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (m) [false, true, true] (R))))))))), .F⟩ = some ⟨blank, cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (m) [false, true, true] (R)))))))))), .F⟩ :=
    cross_l trans c2 (k) (blank) (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (m) [false, true, true] (R)))))))))
  have h3 : steps 8 ⟨blank, cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (m) [false, true, true] (R)))))))))), .F⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (rep (k) [true, false, true, true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (cons true (rep (m) [false, true, true] (R)))))))))))))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- `1 D> 1` halts: D writes 1 and moves left onto the 1 in state E, which has no transition on 1. -/
theorem halt_D (L R : Tape) : ∃ c, steps 1 ⟨cons true (L), cons true (R), .D⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H26127
