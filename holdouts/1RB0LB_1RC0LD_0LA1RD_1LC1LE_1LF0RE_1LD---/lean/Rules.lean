import Machine

/-! # Shift rules of 1RB0LB_1RC0LD_0LA1RD_1LC1LE_1LF0RE_1LD---

Two fast moves of the machine: E moving right erases a run of 1s (`erase`), D moving left turns each `100` into
`111` (`fill`).  The only halt is F reading a 1; F is entered from E reading a 0, so `1 0 D> 1` halts (D keeps the 1
and steps left, E writes a 1 and steps left onto a 1) (`halt_D`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H33448

open TM

/-- E erases a run of 1s moving right, one step a cell. -/
theorem erase (n : Nat) (L R : Tape) :
    steps (n) ⟨L, rep (n) [true] (R), .E⟩ = some ⟨rep (n) [false] (L), R, .E⟩ := by
  have c0 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .E⟩ = some ⟨app [] (app [false] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 1) ⟨L, rep (n) [true] (R), .E⟩ = some ⟨rep (n) [false] (L), R, .E⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 1) (by omega) (h0)

/-- D crosses `100` leftwards in three steps and leaves `111`. -/
theorem fill (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [false, false, true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [true, true, true] (R)), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [false, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, true, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [false, false, true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [true, true, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 3) (by omega) (h0)

/-- `1 0 D> 1` halts: D keeps its 1 and steps left in state E, E writes a 1 and steps left in state F onto a 1. -/
theorem halt_D (L R : Tape) :
    ∃ c, steps 2 ⟨cons false (cons true L), cons true R, .D⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H33448
