  have h0 : steps 14 ⟨cons true (cons false (cons false (cons false (rep (c) [true, false, true, false] (cons true (cons false (cons false (cons false (L))))))))), cons false (cons false (cons false (cons false (R)))), .F⟩ = some ⟨rep (c) [true, false, true, false] (cons true (cons false (cons false (cons false (L))))), cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons false (R)))))))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 8 ⟨app [true, false, true, false] L, app [false, false] R, .D⟩ = some ⟨L, app [false, false] (app [true, false, true, false] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((c) * 8) ⟨rep (c) [true, false, true, false] (cons true (cons false (cons false (cons false (L))))), cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons false (R)))))))), .D⟩ = some ⟨cons true (cons false (cons false (cons false (L)))), cons false (cons false (rep (c) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (R))))))))), .D⟩ :=
    cross_l trans c1 (c) (cons true (cons false (cons false (cons false (L))))) (cons true (cons false (cons true (cons false (cons false (cons false (R)))))))
  have h2 : steps 12 ⟨cons true (cons false (cons false (cons false (L)))), cons false (cons false (rep (c) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (R))))))))), .D⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons false (L)))))), rep (c) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (R))))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [false, false, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h3 : steps ((c) * 4) ⟨cons false (cons false (cons true (cons false (cons true (cons false (L)))))), rep (c) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (R))))))), .E⟩ = some ⟨rep (c) [false, false, true, false] (cons false (cons false (cons true (cons false (cons true (cons false (L))))))), cons true (cons false (cons true (cons false (cons false (cons false (R)))))), .E⟩ :=
    cross_r trans c3 (c) (cons false (cons false (cons true (cons false (cons true (cons false (L))))))) (cons true (cons false (cons true (cons false (cons false (cons false (R)))))))
  have h4 : steps 16 ⟨rep (c) [false, false, true, false] (cons false (cons false (cons true (cons false (cons true (cons false (L))))))), cons true (cons false (cons true (cons false (cons false (cons false (R)))))), .E⟩ = some ⟨rep (c) [false, false, true, false] (cons false (cons false (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (cons false (cons true (cons false (cons true (R)))))), .F⟩ := rfl
  exact steps_congr trans (a := 14 + ((c) * 8 + (12 + ((c) * 4 + (16))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

