/-- Start of a cycle: B crosses (1010)^n to the right, leaving (0001)^n: the middle counter is n zero digits. -/
theorem middle_reset (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨L, rep (n) [true, false, true, false] (R), .B⟩ = some ⟨rep (n) [true, false, false, false] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, false, false] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨L, rep (n) [true, false, true, false] (R), .B⟩ = some ⟨rep (n) [true, false, false, false] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 4) (by omega) (h0)

/-- Carry of the middle counter: the c trailing one-digits 0101 become zeros, the zero-digit above them a one, and the head ends two cells further left with 01 pushed into the tail. -/
theorem middle_carry (c : Nat) (L R : Tape) :
