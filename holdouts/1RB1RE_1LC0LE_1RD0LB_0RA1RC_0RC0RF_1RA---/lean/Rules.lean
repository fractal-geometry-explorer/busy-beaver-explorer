  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((b + 11) * 2) ⟨rep (b + 11) [false, true] (cons false (cons false (rep (p) [true, false] (cons true (cons false (L)))))), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨cons false (cons false (rep (p) [true, false] (cons true (cons false (L))))), cons true (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ :=
    cross_l trans c2 (b + 11) (cons false (cons false (rep (p) [true, false] (cons true (cons false (L)))))) (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))
  have h3 : steps 4 ⟨cons false (cons false (rep (p) [true, false] (cons true (cons false (L))))), cons true (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨cons true (cons true (rep (p) [true, false] (cons true (cons false (L))))), cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons true (rep (p) [true, false] (cons true (cons false (L))))), cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨cons true (cons true (rep (p) [true, false] (cons true (cons false (L))))), rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) = rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) from
      rep_rotate (b + 11) [false] [true, false] [false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, true] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((b + 11) * 2) ⟨cons true (cons true (rep (p) [true, false] (cons true (cons false (L))))), rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨rep (b + 11) [true, true] (cons true (cons true (rep (p) [true, false] (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ :=
    cross_r trans c5 (b + 11) (cons true (cons true (rep (p) [true, false] (cons true (cons false (L)))))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))
  have h6 : steps 10 ⟨rep (b + 11) [true, true] (cons true (cons true (rep (p) [true, false] (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (b + 11) [true, true] (cons true (cons true (rep (p) [true, false] (cons true (cons false (L)))))))))))))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


/-- Active run empty after a run x+1: that run loses one cell and merges with the new run 2B+11. -/
theorem q0_long (b x : Nat) (L : Tape) :
    steps (4 * b + 77) ⟨rep (b + 12) [true, false] (cons false (rep (x + 1) [true] (cons false (L)))), blank, .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (b + 11) [true, true] (cons true (cons true (rep (x + 1) [true] (cons false (L))))))))))))))), blank, .A⟩ := by
  have hn : 19 + (0 + ((b + 11) * 2 + (4 + (0 + ((b + 11) * 2 + (10)))))) = 4 * b + 77 := by omega
  have h0 : steps 19 ⟨rep (b + 12) [true, false] (cons false (rep (x + 1) [true] (cons false (L)))), blank, .A⟩ = some ⟨cons false (rep (b + 11) [true, false] (cons false (rep (x + 1) [true] (cons false (L))))), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (rep (b + 11) [true, false] (cons false (rep (x + 1) [true] (cons false (L))))), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨rep (b + 11) [false, true] (cons false (cons false (rep (x + 1) [true] (cons false (L))))), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (b + 11) [true, false] (cons false (rep (x + 1) [true] (cons false (L))))) = rep (b + 11) [false, true] (cons false (cons false (rep (x + 1) [true] (cons false (L))))) from
      rep_rotate (b + 11) [false] [true, false] [false, true] rfl (cons false (rep (x + 1) [true] (cons false (L))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((b + 11) * 2) ⟨rep (b + 11) [false, true] (cons false (cons false (rep (x + 1) [true] (cons false (L))))), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨cons false (cons false (rep (x + 1) [true] (cons false (L)))), cons true (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ :=
    cross_l trans c2 (b + 11) (cons false (cons false (rep (x + 1) [true] (cons false (L))))) (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))
  have h3 : steps 4 ⟨cons false (cons false (rep (x + 1) [true] (cons false (L)))), cons true (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨cons true (cons true (rep (x + 1) [true] (cons false (L)))), cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons true (rep (x + 1) [true] (cons false (L)))), cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨cons true (cons true (rep (x + 1) [true] (cons false (L)))), rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) = rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) from
      rep_rotate (b + 11) [false] [true, false] [false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, true] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((b + 11) * 2) ⟨cons true (cons true (rep (x + 1) [true] (cons false (L)))), rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨rep (b + 11) [true, true] (cons true (cons true (rep (x + 1) [true] (cons false (L))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ :=
    cross_r trans c5 (b + 11) (cons true (cons true (rep (x + 1) [true] (cons false (L))))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))
  have h6 : steps 10 ⟨rep (b + 11) [true, true] (cons true (cons true (rep (x + 1) [true] (cons false (L))))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (b + 11) [true, true] (cons true (cons true (rep (x + 1) [true] (cons false (L))))))))))))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


/-- Only units, blank tape to the left: they become one run of 2B+11. -/
theorem units_blank (b : Nat) :
    steps (4 * b + 77) ⟨rep (b + 12) [true, false] (blank), blank, .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (b + 11) [true, true] (cons true (cons true (blank))))))))))))), blank, .A⟩ := by
  have hn : 19 + (0 + ((b + 11) * 2 + (4 + (0 + ((b + 11) * 2 + (10)))))) = 4 * b + 77 := by omega
  have h0 : steps 19 ⟨rep (b + 12) [true, false] (blank), blank, .A⟩ = some ⟨cons false (rep (b + 11) [true, false] (blank)), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (rep (b + 11) [true, false] (blank)), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨rep (b + 11) [false, true] (cons false (blank)), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (b + 11) [true, false] (blank)) = rep (b + 11) [false, true] (cons false (blank)) from
      rep_rotate (b + 11) [false] [true, false] [false, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((b + 11) * 2) ⟨rep (b + 11) [false, true] (cons false (blank)), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨cons false (blank), cons true (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ :=
    cross_l trans c2 (b + 11) (cons false (blank)) (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))
  have h3 : steps 4 ⟨cons false (blank), cons true (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨cons true (cons true (blank)), cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons true (blank)), cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨cons true (cons true (blank)), rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (b + 11) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) = rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))) from
      rep_rotate (b + 11) [false] [true, false] [false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, true] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((b + 11) * 2) ⟨cons true (cons true (blank)), rep (b + 11) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))), .C⟩ = some ⟨rep (b + 11) [true, true] (cons true (cons true (blank))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ :=
    cross_r trans c5 (b + 11) (cons true (cons true (blank))) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))
  have h6 : steps 10 ⟨rep (b + 11) [true, true] (cons true (cons true (blank))), cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (b + 11) [true, true] (cons true (cons true (blank))))))))))))), blank, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


