  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [true, false] R), .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨rep (n) [true, true] (cons true (cons true (cons false (L)))), cons false (R), .B⟩ = some ⟨cons true (cons true (cons false (L))), cons false (rep (n) [true, false] (R)), .B⟩ :=
