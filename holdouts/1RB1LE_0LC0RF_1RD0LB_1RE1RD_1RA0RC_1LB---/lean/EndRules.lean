/-- An odd group touching the next group (`... 1 1 ...`), read in E: the sweep turns back.  `L E> 1 (0101)^n 1 R` to `L B> 0 0 (0100)^n R`. -/
theorem touch_E (n : Nat) (L R : Tape) :
    steps (10 * n + 2) ⟨L, cons true (rep (n) [false, true, false, true] (cons true (R))), .E⟩ = some ⟨L, cons false (cons false (rep (n) [false, true, false, false] (R))), .B⟩ := by
  have hn : 0 + ((n) * 4 + (1 + (0 + ((n) * 6 + (1))))) = 10 * n + 2 := by omega
  have h0 : steps 0 ⟨L, cons true (rep (n) [false, true, false, true] (cons true (R))), .E⟩ = some ⟨L, rep (n) [true, false, true, false] (cons true (cons true (R))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (n) [false, true, false, true] (cons true (R))) = rep (n) [true, false, true, false] (cons true (cons true (R))) from
      rep_rotate (n) [true] [false, true, false, true] [true, false, true, false] rfl (cons true (R))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, true, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨L, rep (n) [true, false, true, false] (cons true (cons true (R))), .E⟩ = some ⟨rep (n) [true, true, true, false] (L), cons true (cons true (R)), .E⟩ :=
    cross_r trans c1 (n) (L) (cons true (cons true (R)))
  have h2 : steps 1 ⟨rep (n) [true, true, true, false] (L), cons true (cons true (R)), .E⟩ = some ⟨cons false (rep (n) [true, true, true, false] (L)), cons true (R), .C⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (n) [true, true, true, false] (L)), cons true (R), .C⟩ = some ⟨rep (n) [false, true, true, true] (cons false (L)), cons true (R), .C⟩ := by
    simp only [steps_zero, show cons false (rep (n) [true, true, true, false] (L)) = rep (n) [false, true, true, true] (cons false (L)) from
      rep_rotate (n) [false] [true, true, true, false] [false, true, true, true] rfl (L)]
  have c4 : ∀ L R : Tape, steps 6 ⟨app [false, true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, false, false] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((n) * 6) ⟨rep (n) [false, true, true, true] (cons false (L)), cons true (R), .C⟩ = some ⟨cons false (L), cons true (rep (n) [false, true, false, false] (R)), .C⟩ :=
    cross_l trans c4 (n) (cons false (L)) (R)
  have h5 : steps 1 ⟨cons false (L), cons true (rep (n) [false, true, false, false] (R)), .C⟩ = some ⟨L, cons false (cons false (rep (n) [false, true, false, false] (R))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

