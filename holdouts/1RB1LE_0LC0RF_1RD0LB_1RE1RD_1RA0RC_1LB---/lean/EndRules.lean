/-- The run of `halt_even_touch`: `L E> 1 (0101)^n 0 1 0 0 0 1 1 R` to `L (0111)^n 0 1 1 1 1 1 0 F> 1 R`. -/
theorem even_touch_run (n : Nat) (L R : Tape) :
    steps (4 * n + 7) ⟨L, cons true (rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons false (rep (n) [true, true, true, false] (L)))))))), cons true (R), .F⟩ := by
  have hn : 0 + ((n) * 4 + (7)) = 4 * n + 7 := by omega
  have h0 : steps 0 ⟨L, cons true (rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))), .E⟩ = some ⟨L, rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))) = rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))) from
      rep_rotate (n) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, true, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨L, rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))), .E⟩ = some ⟨rep (n) [true, true, true, false] (L), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R)))))))), .E⟩ :=
    cross_r trans c1 (n) (L) (cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R)))))))))
  have h2 : steps 7 ⟨rep (n) [true, true, true, false] (L), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R)))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (cons true (cons false (rep (n) [true, true, true, false] (L)))))))), cons true (R), .F⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- The halting pattern of the end layer: an even group (2n+2 ones) read in E, followed after its `000` by a single
1 that touches the next group, halts for every n (F reads a 1).  `L E> 1 (0101)^n 0 1 0 0 0 1 1 R`. -/
theorem halt_even_touch (n : Nat) (L R : Tape) :
    ∃ c, steps (4 * n + 7) ⟨L, cons true (rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons true (R))))))))), .E⟩ = some c ∧ step c = none :=
  ⟨_, even_touch_run n L R, rfl⟩

