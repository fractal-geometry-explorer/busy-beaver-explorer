/-- Leftward sweep at a block of even length (made by `gap2_E`): B turns right again, in D.  `L 0 1 1 (11)^n B> 0 R` to `L 1 1 0 1 D> (10)^n R`. -/
theorem even_block_B (n : Nat) (L R : Tape) :
    steps (4 * n + 9) ⟨rep (n) [true, true] (cons true (cons true (cons false (L)))), cons false (R), .B⟩ = some ⟨cons true (cons false (cons true (cons true (L)))), rep (n) [true, false] (R), .D⟩ := by
