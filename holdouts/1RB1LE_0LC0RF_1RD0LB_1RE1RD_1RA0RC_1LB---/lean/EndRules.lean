/-- An even group (2n+2 ones) read in E: the sweep turns back (B, going left).  `L E> 1 (0101)^n 0 1 0 0 0 R` to `L (0111)^n 0 1 1 1 1 1 B> R`. -/
theorem even_E (n : Nat) (L R : Tape) :
    steps (4 * n + 6) ⟨L, cons true (rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (R))))))), .E⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons false (rep (n) [true, true, true, false] (L))))))), R, .B⟩ := by
  have hn : 0 + ((n) * 4 + (6)) = 4 * n + 6 := by omega
  have h0 : steps 0 ⟨L, cons true (rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (R))))))), .E⟩ = some ⟨L, rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (R))))))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (R))))))) = rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (R))))))) from
      rep_rotate (n) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (cons false (cons false (cons false (R))))))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, true, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 4) ⟨L, rep (n) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons false (R))))))), .E⟩ = some ⟨rep (n) [true, true, true, false] (L), cons true (cons false (cons true (cons false (cons false (cons false (R)))))), .E⟩ :=
    cross_r trans c1 (n) (L) (cons true (cons false (cons true (cons false (cons false (cons false (R)))))))
  have h2 : steps 6 ⟨rep (n) [true, true, true, false] (L), cons true (cons false (cons true (cons false (cons false (cons false (R)))))), .E⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons false (rep (n) [true, true, true, false] (L))))))), R, .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

