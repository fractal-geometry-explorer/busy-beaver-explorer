  have h1 : steps 9 ⟨cons true (cons true (cons false (L))), cons false (rep (n) [true, false] (R)), .B⟩ = some ⟨cons true (cons false (cons true (cons true (L)))), rep (n) [true, false] (R), .D⟩ := rfl
