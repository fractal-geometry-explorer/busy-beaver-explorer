    show 1 ≤ T_CV_g1 ((a - 4) / 2) ((b - 8 - 2 * ((a - 4) / 2)) / 2)
    unfold T_CV_g1
    omega
  rw [if_neg hc] at h
  by_cases hc : a = 2 ∧ b = 2 * ((b - 6) / 2) + 6
  · rw [if_pos hc] at h
    cases h
    show 1 ≤ T_CV_a2 ((b - 6) / 2)
    unfold T_CV_a2
    omega
  rw [if_neg hc] at h
  by_cases hc : a = 2 * ((a - 6 - 2 * ((b - 4) / 2)) / 2) + 2 * ((b - 4) / 2) + 6 ∧ b = 2 * ((b - 4) / 2) + 4
  · rw [if_pos hc] at h
    cases h
    show 1 ≤ T_DV_g1 ((a - 6 - 2 * ((b - 4) / 2)) / 2) ((b - 4) / 2)
    unfold T_DV_g1
    omega
  rw [if_neg hc] at h
  by_cases hc : a = 2 * ((a - 4) / 2) + 4 ∧ b = 2
  · rw [if_pos hc] at h
    cases h
    show 1 ≤ T_DV_b2 ((a - 4) / 2)
    unfold T_DV_b2
    omega
  rw [if_neg hc] at h
  by_cases hc : a = 2 * ((a - 4) / 2) + 4 ∧ b = 2 * ((a - 4) / 2) + 4
  · rw [if_pos hc] at h
    cases h
    show 1 ≤ T_EV0_g1 ((a - 4) / 2)
    unfold T_EV0_g1
    omega
  rw [if_neg hc] at h
  by_cases hc : a = 2 ∧ b = 2
  · rw [if_pos hc] at h
    cases h
    show 1 ≤ T_EV0_a2 
    unfold T_EV0_a2
    omega
  rw [if_neg hc] at h
  by_cases hc : a = 2 * ((a - 2) / 2) + 2 ∧ b = 2 * ((a - 2) / 2) + 4
  · rw [if_pos hc] at h
    cases h
    show 1 ≤ T_EV2_g0 ((a - 2) / 2)
    unfold T_EV2_g0
    omega
  rw [if_neg hc] at h
  cases h

/-- The A-event map (even a): the next kind, a, b and the number of steps; `none` at the halting events and for
odd a or a = 0, which the run never reaches. -/
def next : Tag → Nat → Nat → Option (Tag × Nat × Nat × Nat)
  | .U, a, b => nextU a b
  | .V, a, b => nextV a b

/-- **The map is sound**: wherever `next` is defined, the machine goes from the event `Ev F a b` to the one `next`
gives, in exactly the number of steps it gives. -/
theorem next_sound (F : Tag) (a b : Nat) (r : Tag × Nat × Nat × Nat) (h : next F a b = some r) :
    steps r.2.2.2 (Ev F a b) = some (Ev r.1 r.2.1 r.2.2.1) := by
  cases F with
  | U => exact nextU_sound a b r h
  | V => exact nextV_sound a b r h

/-- Every pass takes at least one step. -/
theorem next_pos (F : Tag) (a b : Nat) (r : Tag × Nat × Nat × Nat) (h : next F a b = some r) : 1 ≤ r.2.2.2 := by
  cases F with
  | U => exact nextU_pos a b r h
  | V => exact nextV_pos a b r h

/-- Where the map is defined: at every event with `a` even, `a ≥ 2` and `b ≥ 1`, except the halting events. -/
theorem next_isSome (F : Tag) (a b : Nat) (h2 : a % 2 = 0) (ha : 2 ≤ a) (hb : 1 ≤ b)
    (hh : ¬(a % 4 = 0 ∧ b = 1)) : (next F a b).isSome = true := by
  cases F with
  | U => exact nextU_isSome a b h2 ha hb hh
  | V => exact nextV_isSome a b h2 ha hb hh

end H13743
