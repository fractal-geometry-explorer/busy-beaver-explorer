import Orbit
import HaltCases
import Blank

/-!
# Halts iff the map's orbit reaches a halting event

`halt_event`: every halting event `U(a, 1)`, `V(a, 1)` with `a ≡ 0 (mod 4)`, `a ≥ 4` halts (the head ends in
state F on a 0 right of `1^n`; `HaltCases.lean`, generated by `py/gen_halt.py`).  `orbit_inv`: along the orbit of
`next`, a stays even and at least 2 and b at least 1, so by `next_isSome` the orbit only ever gets stuck at a
halting event.  Together with `not_halts_of_orbit` (in `Orbit.lean`) this gives `halts_iff`: the machine halts from
blank tape exactly when the orbit of `next` from `U(4, 3)` reaches an event with `a ≡ 0 (mod 4)` and `b = 1`.
-/

namespace H13743

open TM

/-- The configuration `1^n F> 0` (blank elsewhere) halts at once. -/
theorem final_halt (n : Nat) : step (⟨rep n [true] blank, blank, .F⟩ : Config) = none :=
  (step_none_iff _).2 ⟨rfl, rfl⟩

/-- **The halting events halt.** -/
theorem halt_event (F : Tag) (a : Nat) (h4 : a % 4 = 0) (ha : 4 ≤ a) : Halts trans (Ev F a 1) := by
  by_cases e : a = 4
  · subst e
    cases F with
    | U => exact ⟨_, _, HU_a4, final_halt _⟩
    | V => exact ⟨_, _, HV_a4, final_halt _⟩
  · have hx : a = 4 * ((a - 8) / 4) + 8 := by omega
    rw [hx]
    cases F with
    | U => exact ⟨_, _, HU_g1 ((a - 8) / 4), final_halt _⟩
    | V => exact ⟨_, _, HV_g1 ((a - 8) / 4), final_halt _⟩

theorem ite_cases {α : Type} {c : Prop} [Decidable c] {v : α} {e : Option α} {r : α}
    (h : (if c then some v else e) = some r) : (c ∧ v = r) ∨ (¬c ∧ e = some r) := by
  by_cases hc : c
  · rw [if_pos hc] at h; exact Or.inl ⟨hc, Option.some.inj h⟩
  · rw [if_neg hc] at h; exact Or.inr ⟨hc, h⟩

/-- The invariant of the orbit: a even, a ≥ 2, b ≥ 1. -/
def Inv (a b : Nat) : Prop := a % 2 = 0 ∧ 2 ≤ a ∧ 1 ≤ b

theorem nextU_inv (a b : Nat) (r : Tag × Nat × Nat × Nat) (hi : Inv a b) (h : nextU a b = some r) :
    Inv r.2.1 r.2.2.1 := by
  unfold Inv at *
  unfold nextU at h
  repeat' (obtain ⟨_, rfl⟩ | ⟨_, h⟩ := ite_cases h)
  all_goals first | (dsimp only; omega) | cases h

theorem nextV_inv (a b : Nat) (r : Tag × Nat × Nat × Nat) (hi : Inv a b) (h : nextV a b = some r) :
    Inv r.2.1 r.2.2.1 := by
  unfold Inv at *
  unfold nextV at h
  repeat' (obtain ⟨_, rfl⟩ | ⟨_, h⟩ := ite_cases h)
  all_goals first | (dsimp only; omega) | cases h

theorem next_inv (F : Tag) (a b : Nat) (r : Tag × Nat × Nat × Nat) (hi : Inv a b) (h : next F a b = some r) :
    Inv r.2.1 r.2.2.1 := by
  cases F with
  | U => exact nextU_inv a b r hi h
  | V => exact nextV_inv a b r hi h

/-- The invariant holds along every orbit that starts inside it. -/
theorem orbit_inv : ∀ k F a b F' a' b' t, Inv a b → orbit k F a b = some (F', a', b', t) → Inv a' b' := by
  intro k
  induction k with
  | zero => intro F a b F' a' b' t hi h; simp [orbit] at h; obtain ⟨rfl, rfl, rfl, rfl⟩ := h; exact hi
  | succ k ih =>
    intro F a b F' a' b' t hi h
    unfold orbit at h
    cases e : next F a b with
    | none => rw [e] at h; cases h
    | some q =>
      obtain ⟨F₁, a₁, b₁, s⟩ := q
      rw [e] at h
      dsimp only at h
      cases e2 : orbit k F₁ a₁ b₁ with
      | none => rw [e2] at h; cases h
      | some p =>
        rw [e2] at h
        simp only [Option.map_some, Option.some.injEq] at h
        obtain ⟨F₂, a₂, b₂, t₂⟩ := p
        simp only [Prod.mk.injEq] at h
        obtain ⟨rfl, rfl, rfl, rfl⟩ := h
        exact ih F₁ a₁ b₁ F₂ a₂ b₂ t₂ (next_inv F a b _ hi e) e2

/-- One more pass at the end of an orbit. -/
theorem orbit_succ : ∀ k F a b F' a' b' t, orbit k F a b = some (F', a', b', t) →
    orbit (k + 1) F a b = (next F' a' b').map (fun q => (q.1, q.2.1, q.2.2.1, t + q.2.2.2)) := by
  intro k
  induction k with
  | zero =>
    intro F a b F' a' b' t h
    simp [orbit] at h; obtain ⟨rfl, rfl, rfl, rfl⟩ := h
    unfold orbit
    cases e : next F a b with
    | none => rfl
    | some q => obtain ⟨F₁, a₁, b₁, s⟩ := q; simp [orbit]
  | succ k ih =>
    intro F a b F' a' b' t h
    unfold orbit at h
    cases e : next F a b with
    | none => rw [e] at h; cases h
    | some q =>
      obtain ⟨F₁, a₁, b₁, s⟩ := q
      rw [e] at h
      dsimp only at h
      cases e2 : orbit k F₁ a₁ b₁ with
      | none => rw [e2] at h; cases h
      | some p =>
        rw [e2] at h
        simp only [Option.map_some, Option.some.injEq] at h
        obtain ⟨F₂, a₂, b₂, t₂⟩ := p
        simp only [Prod.mk.injEq] at h
        obtain ⟨rfl, rfl, rfl, rfl⟩ := h
        have h3 := ih F₁ a₁ b₁ F₂ a₂ b₂ t₂ e2
        unfold orbit
        rw [e]
        dsimp only
        rw [h3]
        cases next F₂ a₂ b₂ with
        | none => rfl
        | some q => simp [Nat.add_assoc]

/-- The orbit of `next` from `U(4, 3)` reaches a halting event after `k` passes. -/
def HitsHalt (k : Nat) : Prop := ∃ F a b t, orbit k .U 4 3 = some (F, a, b, t) ∧ a % 4 = 0 ∧ b = 1

/-- **Halts iff.** The machine halts from blank tape exactly when the orbit of the map `next` from `U(4, 3)`
reaches an event with `a ≡ 0 (mod 4)` and `b = 1`. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ k, HitsHalt k := by
  have hi0 : Inv 4 3 := by unfold Inv; omega
  constructor
  · intro hh
    apply Classical.byContradiction
    intro hn
    apply not_halts_of_orbit _ hh
    intro k
    induction k with
    | zero => rfl
    | succ k ih =>
      cases e : orbit k .U 4 3 with
      | none => rw [e] at ih; cases ih
      | some p =>
        obtain ⟨F, a, b, t⟩ := p
        have hi := orbit_inv k .U 4 3 F a b t hi0 e
        rw [orbit_succ k .U 4 3 F a b t e]
        have hs : (next F a b).isSome = true := by
          apply next_isSome F a b hi.1 hi.2.1 hi.2.2
          intro hab
          exact hn ⟨k, F, a, b, t, e, hab⟩
        cases e2 : next F a b with
        | none => rw [e2] at hs; cases hs
        | some q => rfl
  · rintro ⟨k, F, a, b, t, e, h4, rfl⟩
    have hi := orbit_inv k .U 4 3 F a 1 t hi0 e
    have hr := steps_seq trans init_U (orbit_sound k .U 4 3 F a 1 t e)
    exact (halts_iff_of_steps' trans hr).2 (halt_event F a h4 (by unfold Inv at hi; omega))

/-- The same with the orbit getting stuck: by `next_isSome` the orbit is stuck only at a halting event. -/
theorem halts_iff_stuck : HaltsFromBlank ↔ ∃ k, orbit k .U 4 3 = none := by
  have hi0 : Inv 4 3 := by unfold Inv; omega
  rw [halts_iff]
  constructor
  · rintro ⟨k, F, a, b, t, e, h4, rfl⟩
    refine ⟨k + 1, ?_⟩
    rw [orbit_succ k .U 4 3 F a 1 t e]
    have : next F a 1 = none := by
      cases F <;> simp only [next, nextU, nextV] <;> (repeat rw [if_neg (by omega)])
    rw [this]; rfl
  · rintro ⟨k, hk⟩
    induction k with
    | zero => cases hk
    | succ k ih =>
      cases e : orbit k .U 4 3 with
      | none => exact ih e
      | some p =>
        obtain ⟨F, a, b, t⟩ := p
        rw [orbit_succ k .U 4 3 F a b t e] at hk
        have hi := orbit_inv k .U 4 3 F a b t hi0 e
        refine ⟨k, F, a, b, t, e, ?_⟩
        apply Classical.byContradiction
        intro hab
        have hs := next_isSome F a b hi.1 hi.2.1 hi.2.2 hab
        cases e2 : next F a b with
        | none => rw [e2] at hs; cases hs
        | some q => rw [e2] at hk; cases hk

end H13743
