  have h2 : steps ((k + 2) * 8) ⟨rep (k + 2) [false, true] (cons false (cons false (rep (j) [true, false, true, false, true] (blank)))), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons false (cons false (rep (j) [true, false, true, false, true] (blank))), cons true (cons false (rep (k + 2) [true, true] (cons true (blank)))), .B⟩ :=
    cross_l trans c2 (k + 2) (cons false (cons false (rep (j) [true, false, true, false, true] (blank)))) (cons true (blank))
  have h3 : steps 10 ⟨cons false (cons false (rep (j) [true, false, true, false, true] (blank))), cons true (cons false (rep (k + 2) [true, true] (cons true (blank)))), .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank))))))), rep (k + 1) [true, true] (cons true (blank)), .D⟩ := rfl
  have c4 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .D⟩ = some ⟨app [] (app [true, false] L), R, .D⟩ := fun _ _ => rfl
  have h4 : steps ((k + 1) * 2) ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank))))))), rep (k + 1) [true, true] (cons true (blank)), .D⟩ = some ⟨rep (k + 1) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))))))), cons true (blank), .D⟩ :=
    cross_r trans c4 (k + 1) (cons false (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))))))) (cons true (blank))
  have h5 : steps 1 ⟨rep (k + 1) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))))))), cons true (blank), .D⟩ = some ⟨cons false (rep (k + 1) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank))))))))), blank, .A⟩ := rfl
  exact steps_congr trans (a := 6 + (0 + ((k + 2) * 8 + (10 + ((k + 1) * 2 + (1)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The last `01`: the `10101`s become 1s and the next round starts. -/
theorem end1 (j : Nat) :
    steps (19 * j + 83) ⟨cons false (cons true (cons false (cons false (rep (j) [true, false, true, false, true] (blank))))), blank, .A⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))))))))), .B⟩ := by
  have h0 : steps 40 ⟨cons false (cons true (cons false (cons false (rep (j) [true, false, true, false, true] (blank))))), blank, .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank))))))))))), blank, .B⟩ := rfl
  have h1 : steps 27 ⟨cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank))))))))))), blank, .B⟩ = some ⟨cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))))), .B⟩ = some ⟨rep (j) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))) = rep (j) [true, false, true, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (j) [true, false, true] [true, false, true, false, true] [true, false, true, true, false] rfl (blank)]
  have c3 : ∀ L R : Tape, steps 19 ⟨app [true, false, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [true, true, true, true, true] R), .B⟩ := fun _ _ => rfl
  have h3 : steps ((j) * 19) ⟨rep (j) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))))), .B⟩ :=
    cross_l trans c3 (j) (cons true (cons false (cons true (blank)))) (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))))
  have h4 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 40 + (27 + (0 + ((j) * 19 + (16))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The same with no `01` left (n = 4). -/
theorem end0 (j : Nat) :
    steps (19 * j + 39) ⟨cons false (cons false (rep (j) [true, false, true, false, true] (blank))), blank, .A⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (blank))))))))), .B⟩ := by
  have h0 : steps 23 ⟨cons false (cons false (rep (j) [true, false, true, false, true] (blank))), blank, .A⟩ = some ⟨cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ = some ⟨rep (j) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (j) [true, false, true, false, true] (blank)))) = rep (j) [true, false, true, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (j) [true, false, true] [true, false, true, false, true] [true, false, true, true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 19 ⟨app [true, false, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [true, true, true, true, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((j) * 19) ⟨rep (j) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (j) [true, true, true, true, true] (cons true (cons true (blank))))), .B⟩ :=
    cross_l trans c2 (j) (cons true (cons false (cons true (blank)))) (cons true (cons true (blank)))
  have h3 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (j) [true, true, true, true, true] (cons true (cons true (blank))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (blank))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 23 + (0 + ((j) * 19 + (16)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- One sweep on an odd block (README, rule T1): `w^i C> 0 1 0 1^x 0 1^y` with x = 2m + 7 loses six 1s, a `10101` appears on its left and the next block grows by one.  Any tape on both sides. -/
theorem odd_sweep (m y : Nat) (L R : Tape) :
    steps (10 * m + 17) ⟨L, cons false (cons true (cons false (cons true (rep (m + 3) [true, true] (cons false (rep (y + 1) [true] (cons false (R)))))))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons false (cons true (rep (m) [true, true] (cons false (cons true (rep (y + 1) [true] (cons false (R))))))))), .C⟩ := by
  have h0 : steps 6 ⟨L, cons false (cons true (cons false (cons true (rep (m + 3) [true, true] (cons false (rep (y + 1) [true] (cons false (R)))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), rep (m + 2) [true, true] (cons false (rep (y + 1) [true] (cons false (R)))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .D⟩ = some ⟨app [] (app [true, false] L), R, .D⟩ := fun _ _ => rfl
  have h1 : steps ((m + 2) * 2) ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), rep (m + 2) [true, true] (cons false (rep (y + 1) [true] (cons false (R)))), .D⟩ = some ⟨rep (m + 2) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (rep (y + 1) [true] (cons false (R))), .D⟩ :=
    cross_r trans c1 (m + 2) (cons false (cons true (cons false (cons true (cons false (cons true (L))))))) (cons false (rep (y + 1) [true] (cons false (R))))
  have h2 : steps 3 ⟨rep (m + 2) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (rep (y + 1) [true] (cons false (R))), .D⟩ = some ⟨cons false (rep (m) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (m) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ = some ⟨rep (m) [false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ := by
    simp only [steps_zero, show cons false (rep (m) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))) = rep (m) [false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))) from
      rep_rotate (m) [false] [true, false] [false, true] rfl (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))]
  have c4 : ∀ L R : Tape, steps 8 ⟨app [false, true] L, app [true, false] R, .B⟩ = some ⟨L, app [true, false] (app [true, true] R), .B⟩ := fun _ _ => rfl
  have h4 : steps ((m) * 8) ⟨rep (m) [false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons true (cons false (rep (m) [true, true] (cons false (cons true (rep (y + 1) [true] (cons false (R))))))), .B⟩ :=
    cross_l trans c4 (m) (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))) (cons false (cons true (rep (y + 1) [true] (cons false (R)))))
  have h5 : steps 4 ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons true (cons false (rep (m) [true, true] (cons false (cons true (rep (y + 1) [true] (cons false (R))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons false (cons true (rep (m) [true, true] (cons false (cons true (rep (y + 1) [true] (cons false (R))))))))), .C⟩ := rfl
  exact steps_congr trans (a := 6 + ((m + 2) * 2 + (3 + (0 + ((m) * 8 + (4)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The same when no block follows: a new block of one 1 appears. -/
theorem odd_sweep_new (m : Nat) (L R : Tape) :
    steps (10 * m + 17) ⟨L, cons false (cons true (cons false (cons true (rep (m + 3) [true, true] (cons false (cons false (R))))))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons false (cons true (rep (m) [true, true] (cons false (cons true (cons false (R)))))))), .C⟩ := by
  have h0 : steps 6 ⟨L, cons false (cons true (cons false (cons true (rep (m + 3) [true, true] (cons false (cons false (R))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), rep (m + 2) [true, true] (cons false (cons false (R))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .D⟩ = some ⟨app [] (app [true, false] L), R, .D⟩ := fun _ _ => rfl
  have h1 : steps ((m + 2) * 2) ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), rep (m + 2) [true, true] (cons false (cons false (R))), .D⟩ = some ⟨rep (m + 2) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (cons false (R)), .D⟩ :=
    cross_r trans c1 (m + 2) (cons false (cons true (cons false (cons true (cons false (cons true (L))))))) (cons false (cons false (R)))
  have h2 : steps 3 ⟨rep (m + 2) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (cons false (R)), .D⟩ = some ⟨cons false (rep (m) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (cons false (R))))), .B⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (m) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (cons false (R))))), .B⟩ = some ⟨rep (m) [false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (cons false (R))))), .B⟩ := by
    simp only [steps_zero, show cons false (rep (m) [true, false] (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))) = rep (m) [false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))) from
      rep_rotate (m) [false] [true, false] [false, true] rfl (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))]
  have c4 : ∀ L R : Tape, steps 8 ⟨app [false, true] L, app [true, false] R, .B⟩ = some ⟨L, app [true, false] (app [true, true] R), .B⟩ := fun _ _ => rfl
  have h4 : steps ((m) * 8) ⟨rep (m) [false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))), cons true (cons false (cons false (cons true (cons false (R))))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons true (cons false (rep (m) [true, true] (cons false (cons true (cons false (R)))))), .B⟩ :=
    cross_l trans c4 (m) (cons false (cons false (cons true (cons false (cons true (cons false (cons true (L)))))))) (cons false (cons true (cons false (R))))
  have h5 : steps 4 ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons true (cons false (rep (m) [true, true] (cons false (cons true (cons false (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (L))))), cons false (cons true (cons false (cons true (rep (m) [true, true] (cons false (cons true (cons false (R)))))))), .C⟩ := rfl
  exact steps_congr trans (a := 6 + ((m + 2) * 2 + (3 + (0 + ((m) * 8 + (4)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- End of a round with three 1s left: everything up to the end of the next block becomes one block of 5i + 6 + (y+1) ones. -/
theorem end3 (i y : Nat) (R : Tape) :
    steps (19 * i + 27) ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons false (rep (y + 1) [true] (cons false (R))))))))), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (rep (y + 1) [true] (cons false (R))))))))))), .B⟩ := by
  have h0 : steps 11 ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons false (rep (y + 1) [true] (cons false (R))))))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ = some ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))) = rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (i) [true, false, true] [true, false, true, false, true] [true, false, true, true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 19 ⟨app [true, false, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [true, true, true, true, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((i) * 19) ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (rep (y + 1) [true] (cons false (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (rep (y + 1) [true] (cons false (R))))))), .B⟩ :=
    cross_l trans c2 (i) (cons true (cons false (cons true (blank)))) (cons true (cons true (rep (y + 1) [true] (cons false (R)))))
  have h3 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (rep (y + 1) [true] (cons false (R))))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (rep (y + 1) [true] (cons false (R))))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 11 + (0 + ((i) * 19 + (16)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The same with no next block: 5i + 6 ones. -/
theorem end3_new (i : Nat) (R : Tape) :
    steps (19 * i + 27) ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons false (cons false (R)))))))), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (R)))))))))), .B⟩ := by
  have h0 : steps 11 ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons false (cons false (R)))))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons false (R))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons false (R))))), .B⟩ = some ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons false (R))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))) = rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (i) [true, false, true] [true, false, true, false, true] [true, false, true, true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 19 ⟨app [true, false, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [true, true, true, true, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((i) * 19) ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons false (R))))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (R)))))), .B⟩ :=
    cross_l trans c2 (i) (cons true (cons false (cons true (blank)))) (cons true (cons true (cons false (R))))
  have h3 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (R)))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (R)))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 11 + (0 + ((i) * 19 + (16)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- End of a round with five 1s left: a block of 5i + 6 ones, and the next block grows by one. -/
theorem end5 (i y : Nat) (R : Tape) :
    steps (19 * i + 35) ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons false (rep (y + 1) [true] (cons false (R))))))))))), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R))))))))))))), .B⟩ := by
  have h0 : steps 19 ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons false (rep (y + 1) [true] (cons false (R))))))))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R)))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R)))))))), .B⟩ = some ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R)))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))) = rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (i) [true, false, true] [true, false, true, false, true] [true, false, true, true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 19 ⟨app [true, false, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [true, true, true, true, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((i) * 19) ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R)))))))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R))))))))), .B⟩ :=
    cross_l trans c2 (i) (cons true (cons false (cons true (blank)))) (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R)))))))
  have h3 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R))))))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (rep (y + 1) [true] (cons false (R))))))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 19 + (0 + ((i) * 19 + (16)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The same with no next block: blocks 5i + 6 and 1. -/
theorem end5_new (i : Nat) (R : Tape) :
    steps (19 * i + 35) ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons false (cons false (R)))))))))), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (R)))))))))))), .B⟩ := by
  have h0 : steps 19 ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons false (cons false (R)))))))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (cons false (R))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (cons false (R))))))), .B⟩ = some ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (cons false (R))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))) = rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (i) [true, false, true] [true, false, true, false, true] [true, false, true, true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 19 ⟨app [true, false, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [true, true, true, true, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((i) * 19) ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (cons false (cons true (cons false (R))))))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (R)))))))), .B⟩ :=
    cross_l trans c2 (i) (cons true (cons false (cons true (blank)))) (cons true (cons true (cons false (cons true (cons false (R))))))
  have h3 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (R)))))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (R)))))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 19 + (0 + ((i) * 19 + (16)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- End of a round with two 1s left and nothing after: 5i + 6 ones. -/
theorem end2 (i : Nat) :
    steps (19 * i + 29) ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (blank))))), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (blank))))))))), .B⟩ := by
  have h0 : steps 13 ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (cons true (blank))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ = some ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))) = rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (i) [true, false, true] [true, false, true, false, true] [true, false, true, true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 19 ⟨app [true, false, true, true, false] L, app [false, false] R, .B⟩ = some ⟨L, app [false, false] (app [true, true, true, true, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((i) * 19) ⟨rep (i) [true, false, true, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (cons true (blank)))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (blank))))), .B⟩ :=
    cross_l trans c2 (i) (cons true (cons false (cons true (blank)))) (cons true (cons true (blank)))
  have h3 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (i) [true, true, true, true, true] (cons true (cons true (blank))))), .B⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons true (cons true (rep (i) [true, true, true, true, true] (cons true (cons true (blank))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 13 + (0 + ((i) * 19 + (16)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- One 1 left and nothing after: the machine reaches the halting transition F0. -/
theorem halt1 (i : Nat) :
    steps (5) ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (blank)))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))))), blank, .F⟩ := by
  have h0 : steps 5 ⟨rep (i) [true, false, true, false, true] (blank), cons false (cons true (cons false (cons true (blank)))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons true (rep (i) [true, false, true, false, true] (blank)))))), blank, .F⟩ := rfl
  exact steps_congr trans (a := 5) (by omega) (h0)

