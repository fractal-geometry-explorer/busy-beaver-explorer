import Blank
import DMRules

/-!
# A halts-iff map, after DeepMind's

`C k a b` is the configuration `0^∞ (10101)^k C> 0 1 0 1^a 0 1^b 0^∞`.  The run from blank tape reaches `C 0 2 0`
after 10 steps, and from every `C k a b` the machine either halts or reaches another `C k' a' b'`, as the function
`next` says (`step_state`, for all `k`, `a`, `b`).  So the machine halts from blank tape if and only if the orbit of
`next` from `C 0 2 0` reaches `none` (`halts_iff`).

The map and the shape of the proof are those of `BusyBeaver/BB6/M_1RB1RD_1LC0RD_1RF1RB_1LE0RA_0LB0LE_HHH0RC.lean`
in google-deepmind/cryptids (commit 3647718), which proves the same statement on its own definitions with Mathlib.
Here it is restated on this repository's machine semantics and proved with core Lean only: the machine runs are the
symbolic rules of `DMRules.lean` (generated by `py/dmrules.py`), and the rest is induction.

The left part of the tape, while the machine works its way back, is a stack of blocks `1`, `01` and `10101` over a
base tape `L` (`et L xs`).  State E sweeps left over the stack, adding 1, 2 or 5 ones to the run on its right per
block (`sweep`).  When the machine is in state B on a run of `b` ones over a stack, `drainB` says where it ends; it
calls itself on a smaller run in one case (`B_drain`, by strong induction on `b`).
-/

namespace H135376

open TM

/-! ## Runs of at least one step -/

/-- `c` reaches `c'` in one step or more. -/
def Plus (c c' : Config) : Prop := ∃ n, steps (n + 1) c = some c'

/-- `c` reaches `c'` in zero steps or more. -/
def Star (c c' : Config) : Prop := ∃ n, steps n c = some c'

theorem Plus.star {c c' : Config} (h : Plus c c') : Star c c' := let ⟨n, hn⟩ := h; ⟨n + 1, hn⟩

theorem Plus.trans {a b c : Config} (h₁ : Plus a b) (h₂ : Plus b c) : Plus a c := by
  obtain ⟨n, hn⟩ := h₁
  obtain ⟨m, hm⟩ := h₂
  exact ⟨n + m + 1, by rw [show n + m + 1 + 1 = (n + 1) + (m + 1) by omega]; exact steps_seq H135376.trans hn hm⟩

theorem Plus.trans_star {a b c : Config} (h₁ : Plus a b) (h₂ : Star b c) : Plus a c := by
  obtain ⟨n, hn⟩ := h₁
  obtain ⟨m, hm⟩ := h₂
  exact ⟨n + m, by rw [show n + m + 1 = (n + 1) + m by omega]; exact steps_seq H135376.trans hn hm⟩

theorem Star.trans_plus {a b c : Config} (h₁ : Star a b) (h₂ : Plus b c) : Plus a c := by
  obtain ⟨n, hn⟩ := h₁
  obtain ⟨m, hm⟩ := h₂
  exact ⟨n + m, by rw [show n + m + 1 = n + (m + 1) by omega]; exact steps_seq H135376.trans hn hm⟩

theorem Star.trans {a b c : Config} (h₁ : Star a b) (h₂ : Star b c) : Star a c := by
  obtain ⟨n, hn⟩ := h₁
  obtain ⟨m, hm⟩ := h₂
  exact ⟨n + m, steps_seq H135376.trans hn hm⟩

theorem Star.refl (c : Config) : Star c c := ⟨0, rfl⟩

/-- A rule (a run of `n + 1` steps) as `Plus`, up to equal start and end configurations. -/
theorem plus_of {n : Nat} {c c' d d' : Config} (h : steps (n + 1) c = some d) (e₁ : c' = c) (e₂ : d = d') :
    Plus c' d' := ⟨n, by rw [e₁, h, e₂]⟩

/-- The machine halts from `c`: it reaches a configuration with no next step. -/
def HaltsAt (c : Config) : Prop := ∃ c', Star c c' ∧ step c' = none

theorem HaltsAt.pre {c c' : Config} (h₁ : Star c c') (h₂ : HaltsAt c') : HaltsAt c :=
  let ⟨d, h, hd⟩ := h₂; ⟨d, h₁.trans h, hd⟩

/-! ## Tapes -/

abbrev w5 : List Bool := [true, false, true, false, true]

/-- `0^∞ (10101)^k` on the left. -/
def Lk (k : Nat) : Tape := rep k w5 blank

/-- A C-configuration over the left tape `L`: `L C> 0 1 0 1^a 0 1^b 0^∞`. -/
def Cc (L : Tape) (a b : Nat) : Config :=
  ⟨L, cons false (cons true (cons false (rep a [true] (cons false (rep b [true] blank))))), .C⟩

/-- `10101` pushed on the left tape `L`. -/
def push5 (L : Tape) : Tape := cons true (cons false (cons true (cons false (cons true L))))

/-- Blocks of the left tape. -/
inductive Blk where
  | b1
  | b01
  | b5

/-- A stack of blocks over the left tape `L`, the nearest block first; an empty stack is `0 0` over `L`. -/
def et (L : Tape) : List Blk → Tape
  | [] => cons false (cons false L)
  | .b1 :: xs => cons true (et L xs)
  | .b01 :: xs => cons false (cons true (et L xs))
  | .b5 :: xs => cons true (cons false (cons true (cons false (cons true (et L xs)))))

/-- The ones a sweep over a stack adds. -/
def wt : List Blk → Nat
  | [] => 1
  | .b1 :: xs => wt xs + 1
  | .b01 :: xs => wt xs + 2
  | .b5 :: xs => wt xs + 5

def add01 : Nat → List Blk → List Blk
  | 0, xs => xs
  | m + 1, xs => .b01 :: add01 m xs

def add5 : Nat → List Blk → List Blk
  | 0, xs => xs
  | m + 1, xs => .b5 :: add5 m xs

theorem add01_cons (m : Nat) (xs : List Blk) : add01 m (.b01 :: xs) = .b01 :: add01 m xs := by
  induction m with
  | zero => rfl
  | succ m ih => simp only [add01, ih]

theorem add5_cons (m : Nat) (xs : List Blk) : add5 m (.b5 :: xs) = .b5 :: add5 m xs := by
  induction m with
  | zero => rfl
  | succ m ih => simp only [add5, ih]

theorem wt_add01 (m : Nat) (xs : List Blk) : wt (add01 m xs) = 2 * m + wt xs := by
  induction m with
  | zero => simp [add01]
  | succ m ih => simp only [add01, wt, ih]; omega

theorem wt_add5 (m : Nat) (xs : List Blk) : wt (add5 m xs) = 5 * m + wt xs := by
  induction m with
  | zero => simp [add5]
  | succ m ih => simp only [add5, wt, ih]; omega

theorem ones_succ (a : Nat) (s : Tape) : cons true (rep a [true] s) = rep (a + 1) [true] s := rfl

theorem ones_eq {a b : Nat} (h : a = b) (s : Tape) : rep a [true] s = rep b [true] s := by rw [h]

/-- The empty stack over a blank tape is blank. -/
theorem et_blank_nil : et blank [] = blank := by simp only [et, cons_false_blank]

/-- `(10101)^k` over a blank tape is a stack of `k` blocks `10101`. -/
theorem et_add5 (k : Nat) : et blank (add5 k []) = Lk k := by
  induction k with
  | zero => exact et_blank_nil
  | succ k ih => simp only [add5, et, ih, Lk, rep_succ, app_cons, app_nil]

/-! ## Sweeps and crossings -/

/-- E sweeps left over a stack, adding its weight to the run of ones on the right. -/
theorem sweep (L : Tape) : ∀ (xs : List Blk) (a : Nat) (r : Tape),
    Plus ⟨et L xs, cons false (cons true (rep a [true] r)), .E⟩
      ⟨L, cons false (cons true (cons false (rep (a + wt xs) [true] r))), .C⟩ := by
  intro xs
  induction xs with
  | nil => intro a r; exact plus_of (sw_nil L (rep a [true] r)) rfl rfl
  | cons blk xs ih =>
    intro a r
    cases blk with
    | b1 =>
      have h := ih (a + 1) r
      rw [ones_eq (show a + 1 + wt xs = a + wt (.b1 :: xs) by simp only [wt]; omega)] at h
      exact (plus_of (sw_b1 (et L xs) (rep a [true] r)) rfl rfl).trans h
    | b01 =>
      have h := ih (a + 2) r
      rw [ones_eq (show a + 2 + wt xs = a + wt (.b01 :: xs) by simp only [wt]; omega)] at h
      exact (plus_of (sw_b01 (et L xs) (rep a [true] r)) rfl rfl).trans h
    | b5 =>
      have h := ih (a + 5) r
      rw [ones_eq (show a + 5 + wt xs = a + wt (.b5 :: xs) by simp only [wt]; omega)] at h
      exact (plus_of (sw_b5 (et L xs) (rep a [true] r)) rfl rfl).trans h

/-- A crosses `1^(2m)` to the right, leaving `m` blocks `01`. -/
theorem shiftA (L : Tape) (m : Nat) : ∀ (xs : List Blk) (r : Tape),
    Star ⟨et L xs, rep (2 * m) [true] r, .A⟩ ⟨et L (add01 m xs), r, .A⟩ := by
  induction m with
  | zero => intro xs r; exact Star.refl _
  | succ m ih =>
    intro xs r
    have h := ih (.b01 :: xs) r
    rw [add01_cons] at h
    refine (plus_of (shA (et L xs) (rep (2 * m) [true] r)) ?_ rfl).star.trans h
    rw [show 2 * (m + 1) = 2 * m + 1 + 1 by omega]; rfl

/-- The sweep that ends every crossing of A: from `0 1 1^a r` in state E over `m` blocks `01` and a stack. -/
theorem sweep01 (L : Tape) (m : Nat) (xs : List Blk) (a : Nat) (r : Tape) :
    Plus ⟨et L (add01 m xs), cons false (cons true (rep a [true] r)), .E⟩
      ⟨L, cons false (cons true (cons false (rep (a + 2 * m + wt xs) [true] r))), .C⟩ := by
  have h := sweep L (add01 m xs) a r
  rw [ones_eq (show a + wt (add01 m xs) = a + 2 * m + wt xs by rw [wt_add01]; omega)] at h
  exact h

/-- B bounces on `1^(2m+2)`. -/
theorem bounce_even (m : Nat) (L : Tape) : Plus ⟨L, rep (2 * m + 2) [true] blank, .B⟩ (Cc L (2 * m + 2) 0) := by
  have h₁ := plus_of (bB L (rep (2 * m) [true] blank)) (c' := ⟨L, rep (2 * m + 2) [true] blank, .B⟩)
    (d' := ⟨et L [], rep (2 * m) [true] blank, .A⟩) rfl rfl
  have h₂ := shiftA L m [] blank
  have h₃ := plus_of (aE0 (et L (add01 m []))) rfl rfl
  have h₄ := sweep01 L m [] 1 blank
  refine h₁.trans (h₂.trans_plus (h₃.trans ?_))
  simp only [Cc, rep_zero, cons_false_blank]
  rw [ones_eq (show 2 * m + 2 = 1 + 2 * m + wt [] by simp only [wt]; omega)]
  exact h₄

/-- B bounces on `1^(2m+5)`. -/
theorem bounce_odd (m : Nat) (L : Tape) : Plus ⟨L, rep (2 * m + 5) [true] blank, .B⟩ (Cc L (2 * m + 1) 1) := by
  have h₁ := plus_of (bB L (rep (2 * m) [true] (rep 3 [true] blank))) (c' := ⟨L, rep (2 * m + 5) [true] blank, .B⟩)
    (d' := ⟨et L [], rep (2 * m) [true] (rep 3 [true] blank), .A⟩)
    (by rw [show 2 * m + 5 = 2 * m + 3 + 1 + 1 by omega, rep_succ, rep_succ, ← rep_add]; rfl) rfl
  have h₂ := shiftA L m [] (rep 3 [true] blank)
  have h₃ := plus_of (aE3 (et L (add01 m [])) blank) (c' := ⟨et L (add01 m []), rep 3 [true] blank, .A⟩)
    (by simp only [cons_false_blank]; rfl) rfl
  have h₄ := sweep01 L m [] 0 (cons false (cons true blank))
  refine h₁.trans (h₂.trans_plus (h₃.trans ?_))
  simp only [Cc]
  rw [ones_eq (show 2 * m + 1 = 0 + 2 * m + wt [] by simp only [wt]; omega)]
  exact h₄

/-- C with `a = 2m + 7`: push `10101`, `a` down by 6, `b` up by 1. -/
theorem et_b5 (L : Tape) (xs : List Blk) : (push5 (et L xs)) = et L (.b5 :: xs) := rfl

theorem step_odd (m : Nat) (L : Tape) (b : Nat) :
    Plus (Cc L (2 * m + 7) b) (Cc (push5 L) (2 * m + 1) (b + 1)) := by
  have e : Cc L (2 * m + 7) b = ⟨L, cons false (cons true (cons false (cons true (cons true (cons true (cons true
      (rep (2 * m) [true] (rep 3 [true] (cons false (rep b [true] blank)))))))))), .C⟩ := by
    simp only [Cc]; rw [show 2 * m + 7 = 2 * m + 3 + 1 + 1 + 1 + 1 by omega, ← rep_add]; rfl
  have h₁ := plus_of (cA L (rep (2 * m) [true] (rep 3 [true] (cons false (rep b [true] blank))))) e rfl
  have h₂ := shiftA (push5 L) m [] (rep 3 [true] (cons false (rep b [true] blank)))
  have h₃ := plus_of (aE3 (et (push5 L) (add01 m [])) (rep b [true] blank)) rfl rfl
  have h₄ := sweep01 (push5 L) m [] 0 (cons false (rep (b + 1) [true] blank))
  refine h₁.trans (h₂.trans_plus (h₃.trans ?_))
  simp only [Cc]
  rw [ones_eq (show 2 * m + 1 = 0 + 2 * m + wt [] by simp only [wt]; omega)]
  exact h₄


/-- C with `a = 2m + 4, b = 0`: push `10101`, `a` down by 2. -/
theorem step_even (m : Nat) (L : Tape) :
    Plus (Cc L (2 * m + 4) 0) (Cc (push5 L) (2 * m + 2) 0) := by
  have e : Cc L (2 * m + 4) 0 = ⟨L, cons false (cons true (cons false (cons true (cons true (cons true (cons true
      (rep (2 * m) [true] blank))))))), .C⟩ := by
    simp only [Cc, rep_zero, cons_false_blank]; rw [show 2 * m + 4 = 2 * m + 1 + 1 + 1 + 1 by omega]; rfl
  have h₁ := plus_of (cA L (rep (2 * m) [true] blank)) e rfl
  have h₂ := shiftA (push5 L) m [] blank
  have h₃ := plus_of (aE0 (et (push5 L) (add01 m []))) rfl rfl
  have h₄ := sweep01 (push5 L) m [] 1 blank
  refine h₁.trans (h₂.trans_plus (h₃.trans ?_))
  simp only [Cc, rep_zero, cons_false_blank]
  rw [ones_eq (show 2 * m + 2 = 1 + 2 * m + wt [] by simp only [wt]; omega)]
  exact h₄

/-- `step_even` `m` times. -/
theorem loop_even (L : Tape) (m : Nat) : ∀ xs : List Blk,
    Star (Cc (et L xs) (2 * m + 2) 0) (Cc (et L (add5 m xs)) 2 0) := by
  induction m with
  | zero => intro xs; exact Star.refl _
  | succ m ih =>
    intro xs
    have h := ih (.b5 :: xs)
    rw [add5_cons] at h
    exact (step_even m (et L xs)).star.trans h

/-- `step_odd` `q` times. -/
theorem loop_odd (L : Tape) (q r : Nat) : ∀ (xs : List Blk) (b : Nat),
    Star (Cc (et L xs) (2 * (r + 3 * q) + 3) b) (Cc (et L (add5 q xs)) (2 * r + 3) (b + q)) := by
  induction q with
  | zero => intro xs b; exact Star.refl _
  | succ q ih =>
    intro xs b
    have h := ih (.b5 :: xs) (b + 1)
    rw [add5_cons, show b + 1 + q = b + (q + 1) by omega] at h
    have h₁ := step_odd (r + 3 * q + 1) (et L xs) b
    rw [show 2 * (r + 3 * q + 1) + 7 = 2 * (r + 3 * (q + 1)) + 3 by omega,
      show 2 * (r + 3 * q + 1) + 1 = 2 * (r + 3 * q) + 3 by omega] at h₁
    exact h₁.star.trans h

/-! ## Draining a run of ones in state B -/

/-- Where B ends on a run of `b` ones over a stack of weight `w`: `C a' b'` over the base tape, or `none` if the
machine halts. -/
def drainB (b w : Nat) : Option (Nat × Nat) :=
  if b % 2 = 0 then
    if b = 0 then some (w + 1, 0)
    else some (5 * (b / 2 - 1) + w + 6, 0)
  else if b = 1 then some (w + 1, 0)
  else if b = 3 then some (w + 1, 1)
  else if b = 5 then none
  else
    if (b / 2 - 3) % 3 = 0 then some (6 * ((b / 2 - 3) / 3) + w + 7, 0)
    else if (b / 2 - 3) % 3 = 1 then some (5 * ((b / 2 - 3) / 3) + w + 6, (b / 2 - 3) / 3 + 2)
    else drainB ((b / 2 - 3) / 3) (5 * ((b / 2 - 3) / 3) + w + 12)
termination_by b
decreasing_by omega

/-- What a run from `c` does when the target is a C-configuration over `L`: reach `Cc L a' b'`, or halt. -/
def Lands (L : Tape) (c : Config) : Option (Nat × Nat) → Prop
  | some (a', b') => Plus c (Cc L a' b')
  | none => HaltsAt c

theorem Lands.pre {L : Tape} {c c' : Config} (h : Plus c c') : ∀ {o}, Lands L c' o → Lands L c o
  | some _, h' => h.trans h'
  | none, h' => HaltsAt.pre h.star h'

theorem halts_of {n : Nat} {c c' d : Config} (h : steps n c = some d) (e : c' = c) (hd : step d = none) :
    HaltsAt c' := ⟨d, ⟨n, by rw [e, h]⟩, hd⟩

/-- The sweep that ends a drain: `L`-stack `ys`, E on `0 1 1^a r`. -/
theorem land_sweep (L : Tape) (ys : List Blk) (a a' b' : Nat) (r : Tape) (ha : a' = a + wt ys)
    (hr : r = cons false (rep b' [true] blank)) :
    Plus ⟨et L ys, cons false (cons true (rep a [true] r)), .E⟩ (Cc L a' b') := by
  subst ha hr; exact sweep L ys a _

theorem B_drain (L : Tape) (b : Nat) : ∀ xs : List Blk,
    Lands L ⟨et L (.b1 :: xs), rep b [true] blank, .B⟩ (drainB b (wt xs)) := by
  induction b using Nat.strongRecOn with
  | _ b ih =>
  intro xs
  obtain ⟨m, hm2⟩ : ∃ m, b = 2 * m ∨ b = 2 * m + 1 := ⟨b / 2, by omega⟩
  rcases hm2 with rfl | rfl
  · rcases m with _ | m
    · rw [drainB]; simp only [Lands]
      exact (plus_of (b0 (et L xs)) rfl rfl).trans
        (land_sweep L xs 1 _ 0 blank (by omega) (by simp only [rep_zero, cons_false_blank]))
    · rw [drainB, if_pos (by omega), if_neg (by omega)]; simp only [Lands]
      have h₁ := bounce_even m (et L (.b1 :: xs))
      have h₂ := loop_even L m (.b1 :: xs)
      have h₃ := plus_of (c2 (et L (add5 m (.b1 :: xs)))) (c' := Cc (et L (add5 m (.b1 :: xs))) 2 0)
        (by simp only [Cc, rep_zero, cons_false_blank]; rfl) rfl
      have h₄ := land_sweep L (.b5 :: add5 m (.b1 :: xs)) 0 (5 * (2 * (m + 1) / 2 - 1) + wt xs + 6) 0 blank
        (by simp only [wt, wt_add5]; omega) (by simp only [rep_zero, cons_false_blank])
      rw [show 2 * (m + 1) = 2 * m + 2 by omega]
      exact (h₁.trans_star h₂).trans (h₃.trans h₄)
  · rcases m with _ | _ | _ | m
    · rw [drainB]; simp only [Lands]
      exact (plus_of (b1 (et L xs)) rfl rfl).trans
        (land_sweep L xs 1 _ 0 blank (by omega) (by simp only [rep_zero, cons_false_blank]))
    · rw [drainB]; simp only [Lands]
      exact (plus_of (b3 (et L xs)) rfl rfl).trans
        (land_sweep L xs 1 _ 1 _ (by omega) rfl)
    · rw [drainB]; simp only [Lands]
      exact halts_of (halt_b5 (et L xs)) rfl rfl
    · -- b = 2m + 7: bounce, then `q` rounds of `step_odd`, then one of three ends
      have hb : 2 * (m + 3) + 1 = 2 * (m + 1) + 5 := by omega
      have h₁ := bounce_odd (m + 1) (et L (.b1 :: xs))
      rw [← hb, show 2 * (m + 1) + 1 = 2 * (m % 3 + 3 * (m / 3)) + 3 by omega] at h₁
      have h₂ := loop_odd L (m / 3) (m % 3) (.b1 :: xs) 1
      have h₁₂ := h₁.trans_star h₂
      have hm : (2 * (m + 3) + 1) / 2 - 3 = m := by omega
      rw [drainB, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), hm]
      have hwt : wt (.b5 :: add5 (m / 3) (.b1 :: xs)) = 5 * (m / 3) + wt xs + 6 := by
        simp only [wt, wt_add5]; omega
      rcases (by omega : m % 3 = 0 ∨ m % 3 = 1 ∨ m % 3 = 2) with h0 | h0 | h0
      · rw [if_pos h0]; simp only [Lands]
        rw [h0] at h₁₂
        have h₃ := plus_of (c3 (1 + m / 3) (et L (add5 (m / 3) (.b1 :: xs))))
          (c' := Cc (et L (add5 (m / 3) (.b1 :: xs))) (2 * 0 + 3) (1 + m / 3)) rfl rfl
        have h₄ := land_sweep L (.b5 :: add5 (m / 3) (.b1 :: xs)) (1 + m / 3) (6 * (m / 3) + wt xs + 7) 0 blank
          (by omega) (by simp only [rep_zero, cons_false_blank])
        exact Plus.trans h₁₂ (h₃.trans h₄)
      · rw [if_neg (by omega), if_pos h0]; simp only [Lands]
        rw [h0] at h₁₂
        have h₃ := plus_of (c5 (et L (add5 (m / 3) (.b1 :: xs))) (rep (1 + m / 3) [true] blank))
          (c' := Cc (et L (add5 (m / 3) (.b1 :: xs))) (2 * 1 + 3) (1 + m / 3)) rfl rfl
        have h₄ := land_sweep L (.b5 :: add5 (m / 3) (.b1 :: xs)) 0 (5 * (m / 3) + wt xs + 6) (m / 3 + 2)
          (cons false (cons true (rep (1 + m / 3) [true] blank))) (by omega)
          (by rw [ones_succ, show 1 + m / 3 + 1 = m / 3 + 2 by omega])
        exact Plus.trans h₁₂ (h₃.trans h₄)
      · rw [if_neg (by omega), if_neg (by omega)]
        rw [h0] at h₁₂
        have h₃ := step_odd 0 (et L (add5 (m / 3) (.b1 :: xs))) (1 + m / 3)
        rw [et_b5] at h₃
        have h₄ := plus_of (c1 (et L (.b5 :: add5 (m / 3) (.b1 :: xs))) (rep (m / 3) [true] blank))
          (c' := Cc (et L (.b5 :: add5 (m / 3) (.b1 :: xs))) (2 * 0 + 1) (1 + m / 3 + 1))
          (by simp only [Cc]; rw [show 1 + m / 3 + 1 = m / 3 + 1 + 1 by omega]; rfl) rfl
        have hpre := (Plus.trans h₁₂ h₃).trans h₄
        have hlt : m / 3 < 2 * (m + 3) + 1 := by omega
        have h₅ := ih (m / 3) hlt (.b01 :: .b01 :: .b01 :: .b5 :: add5 (m / 3) (.b1 :: xs))
        have hw : wt (.b01 :: .b01 :: .b01 :: .b5 :: add5 (m / 3) (.b1 :: xs)) = 5 * (m / 3) + wt xs + 12 := by
          simp only [wt, wt_add5]; omega
        rw [hw] at h₅
        exact Lands.pre hpre h₅

/-! ## The map -/

/-- `C k a b`. -/
inductive State where
  | C (k a b : Nat)

/-- `0^∞ (10101)^k C> 0 1 0 1^a 0 1^b 0^∞`. -/
def enc : State → Config
  | .C k a b => Cc (Lk k) a b

/-- The map, as in DeepMind's cryptids: `none` is a halt. -/
def next : State → Option State
  | .C k a b =>
    if a % 2 = 0 then
      if a = 0 then none
      else if a = 2 then
        if b % 2 = 0 then
          if b = 0 then some (.C 0 (5 * k + 6) 0)
          else if b = 2 then some (.C 0 (5 * k + 6) 1)
          else some (.C (k + 1) (b - 3) 1)
        else some (.C (k + 1) (b + 1) 0)
      else
        match drainB b (a - 3) with
        | some (a', b') => some (.C (k + 1) a' b')
        | none => none
    else if a = 1 then
      if b = 0 then none
      else if b = 1 then none
      else
        match drainB (b - 2) (5 * k + 7) with
        | some (a', b') => some (.C 0 a' b')
        | none => none
    else if a = 3 then some (.C 0 (5 * k + b + 6) 0)
    else if a = 5 then some (.C 0 (5 * k + 6) (b + 1))
    else some (.C (k + 1) (a - 6) (b + 1))

/-- What `next` promises about the machine from `enc s`. -/
def Sound (s : State) : Option State → Prop
  | some s' => Plus (enc s) (enc s')
  | none => HaltsAt (enc s)

theorem Lk_succ (k : Nat) : (push5 (Lk k)) = Lk (k + 1) := by
  simp only [Lk, rep_succ, app_cons, app_nil]; rfl

/-- **Every step of the map is a run of the machine** (or a halt), for all `k`, `a`, `b`. -/
theorem step_state (k a b : Nat) : Sound (.C k a b) (next (.C k a b)) := by
  obtain ⟨n, hn2⟩ : ∃ n, a = 2 * n ∨ a = 2 * n + 1 := ⟨a / 2, by omega⟩
  rcases hn2 with rfl | rfl
  · rcases n with _ | _ | n
    · -- a = 0: halt
      rw [show next (.C k (2 * 0) b) = none by simp [next]]
      exact halts_of (halt_a0 (Lk k) (rep b [true] blank)) rfl rfl
    · -- a = 2
      obtain ⟨m, hm2⟩ : ∃ m, b = 2 * m ∨ b = 2 * m + 1 := ⟨b / 2, by omega⟩
      rcases hm2 with rfl | rfl
      · rcases m with _ | _ | m
        · rw [show next (.C k (2 * (0 + 1)) (2 * 0)) = some (.C 0 (5 * k + 6) 0) by simp [next]]
          have h₁ := plus_of (c2 (Lk k)) (c' := enc (.C k (2 * (0 + 1)) (2 * 0)))
            (d' := ⟨et blank (.b5 :: add5 k []), cons false (cons true (rep 0 [true] blank)), .E⟩) rfl
            (by simp only [et, et_add5] <;> rfl)
          exact h₁.trans (land_sweep blank _ 0 _ 0 blank (by simp only [wt, wt_add5]; omega)
            (by simp only [rep_zero, cons_false_blank]))
        · rw [show next (.C k (2 * (0 + 1)) (2 * (0 + 1))) = some (.C 0 (5 * k + 6) 1) by simp [next]]
          have h₁ := plus_of (c2_2 (Lk k)) (c' := enc (.C k (2 * (0 + 1)) (2 * (0 + 1))))
            (d' := ⟨et blank (.b5 :: add5 k []), cons false (cons true (rep 0 [true] (cons false (cons true blank)))), .E⟩)
            rfl (by simp only [et, et_add5] <;> rfl)
          exact h₁.trans (land_sweep blank _ 0 _ 1 _ (by simp only [wt, wt_add5]; omega) rfl)
        · rw [show next (.C k (2 * (0 + 1)) (2 * (m + 1 + 1))) = some (.C (k + 1) (2 * m + 1) 1) by
            simp only [next]; repeat' split
            all_goals first | rfl | (congr 2 <;> omega) | omega | simp_all]
          have h₁ := plus_of (c2b (Lk k) (rep (2 * m + 3) [true] blank))
            (c' := enc (.C k (2 * (0 + 1)) (2 * (m + 1 + 1))))
            (d' := ⟨Lk (k + 1), rep (2 * m + 5) [true] blank, .B⟩)
            (by simp only [enc, Cc]; rw [show 2 * (m + 1 + 1) = 2 * m + 3 + 1 by omega]; rfl)
            (by rw [← Lk_succ] <;> rfl)
          exact h₁.trans (bounce_odd m (Lk (k + 1)))
      · rw [show next (.C k (2 * (0 + 1)) (2 * m + 1)) = some (.C (k + 1) (2 * m + 2) 0) by
          simp only [next]; repeat' split
          all_goals first | rfl | (congr 2 <;> omega) | omega | simp_all]
        have h₁ := plus_of (c2b (Lk k) (rep (2 * m) [true] blank))
          (c' := enc (.C k (2 * (0 + 1)) (2 * m + 1)))
          (d' := ⟨Lk (k + 1), rep (2 * m + 2) [true] blank, .B⟩) rfl (by rw [← Lk_succ] <;> rfl)
        exact h₁.trans (bounce_even m (Lk (k + 1)))
    · -- a = 2n + 4: cross, then drain
      have hnx : next (.C k (2 * (n + 1 + 1)) b) =
          (drainB b (2 * n + 1)).map (fun p => State.C (k + 1) p.1 p.2) := by
        simp only [next]
        rw [if_pos (by omega), if_neg (by omega), if_neg (by omega), show 2 * (n + 1 + 1) - 3 = 2 * n + 1 by omega]
        cases drainB b (2 * n + 1) <;> rfl
      rw [hnx]
      have h₁ := plus_of (cA (Lk k) (rep (2 * n) [true] (cons false (rep b [true] blank))))
        (c' := enc (.C k (2 * (n + 1 + 1)) b))
        (d' := ⟨et (Lk (k + 1)) [], rep (2 * n) [true] (cons false (rep b [true] blank)), .A⟩)
        (by simp only [enc, Cc]; rw [show 2 * (n + 1 + 1) = 2 * n + 1 + 1 + 1 + 1 by omega]; rfl)
        (by rw [← Lk_succ] <;> rfl)
      have h₂ := shiftA (Lk (k + 1)) n [] (cons false (rep b [true] blank))
      have h₃ := plus_of (aB (et (Lk (k + 1)) (add01 n [])) (rep b [true] blank))
        (d' := ⟨et (Lk (k + 1)) (.b1 :: add01 n []), rep b [true] blank, .B⟩) rfl rfl
      have h₄ := B_drain (Lk (k + 1)) b (add01 n [])
      rw [wt_add01, show 2 * n + wt [] = 2 * n + 1 by rfl] at h₄
      have hpre := h₁.trans (h₂.trans_plus h₃)
      cases e : drainB b (2 * n + 1) with
      | none => rw [e] at h₄; exact HaltsAt.pre hpre.star h₄
      | some p => obtain ⟨a', b'⟩ := p; rw [e] at h₄; exact hpre.trans h₄
  · rcases n with _ | _ | _ | n
    · -- a = 1
      rcases b with _ | _ | b
      · rw [show next (.C k (2 * 0 + 1) 0) = none by simp [next]]
        exact halts_of (halt_a1b0 (Lk k)) rfl rfl
      · rw [show next (.C k (2 * 0 + 1) (0 + 1)) = none by simp [next]]
        exact halts_of (halt_a1b1 (Lk k)) rfl rfl
      · have hnx : next (.C k (2 * 0 + 1) (b + 1 + 1)) =
            (drainB b (5 * k + 7)).map (fun p => State.C 0 p.1 p.2) := by
          simp [next]
          cases drainB b (5 * k + 7) <;> rfl
        rw [hnx]
        let xs : List Blk := .b01 :: .b01 :: .b01 :: add5 k []
        have h₁ := plus_of (c1 (Lk k) (rep b [true] blank)) (c' := enc (.C k (2 * 0 + 1) (b + 1 + 1)))
          (d' := ⟨et blank (.b1 :: xs), rep b [true] blank, .B⟩) rfl (by simp only [xs, et, et_add5])
        have h₄ := B_drain blank b xs
        rw [show wt xs = 5 * k + 7 by simp only [xs, wt, wt_add5] <;> omega] at h₄
        cases e : drainB b (5 * k + 7) with
        | none => rw [e] at h₄; exact HaltsAt.pre h₁.star h₄
        | some p => obtain ⟨a', b'⟩ := p; rw [e] at h₄; exact h₁.trans h₄
    · -- a = 3
      rw [show next (.C k (2 * (0 + 1) + 1) b) = some (.C 0 (5 * k + b + 6) 0) by simp [next]]
      have h₁ := plus_of (c3 b (Lk k)) (c' := enc (.C k (2 * (0 + 1) + 1) b))
        (d' := ⟨et blank (.b5 :: add5 k []), cons false (cons true (rep b [true] blank)), .E⟩) rfl
        (by simp only [et, et_add5] <;> rfl)
      exact h₁.trans (land_sweep blank _ b _ 0 blank (by simp only [wt, wt_add5]; omega)
        (by simp only [rep_zero, cons_false_blank]))
    · -- a = 5
      rw [show next (.C k (2 * (0 + 1 + 1) + 1) b) = some (.C 0 (5 * k + 6) (b + 1)) by simp [next]]
      have h₁ := plus_of (c5 (Lk k) (rep b [true] blank)) (c' := enc (.C k (2 * (0 + 1 + 1) + 1) b))
        (d' := ⟨et blank (.b5 :: add5 k []), cons false (cons true (rep 0 [true]
          (cons false (rep (b + 1) [true] blank)))), .E⟩) rfl (by simp only [et, et_add5] <;> rfl)
      exact h₁.trans (land_sweep blank _ 0 _ (b + 1) _ (by simp only [wt, wt_add5]; omega) rfl)
    · -- a = 2n + 7
      rw [show next (.C k (2 * (n + 1 + 1 + 1) + 1) b) = some (.C (k + 1) (2 * n + 1) (b + 1)) by
        simp only [next]; repeat' split
        all_goals first | rfl | (congr 2 <;> omega) | omega | simp_all]
      have h := step_odd n (Lk k) b
      rw [Lk_succ, show 2 * n + 7 = 2 * (n + 1 + 1 + 1) + 1 by omega] at h
      exact h

/-! ## The orbit from blank tape -/

/-- The first C-configuration: `C 0 2 0`, after 10 steps. -/
def start : State := .C 0 2 0

theorem init_start : steps 10 init = some (enc start) := by
  have h := blank_C
  simp only [enc, start, Cc, Lk, rep_zero, cons_false_blank]
  exact h

/-- `n` steps of the map from `start`: `none` once a step halts. -/
def orbit : Nat → Option State
  | 0 => some start
  | n + 1 => (orbit n).bind next

/-- While the orbit has not stopped, the machine reaches its states, after at least `n` steps. -/
theorem orbit_reach : ∀ n s, orbit n = some s → ∃ t, n ≤ t ∧ steps t init = some (enc s) := by
  intro n
  induction n with
  | zero => intro s h; cases h; exact ⟨10, by omega, init_start⟩
  | succ n ih =>
    intro s h
    simp only [orbit] at h
    cases e : orbit n with
    | none => rw [e] at h; cases h
    | some s₀ =>
      rw [e] at h
      obtain ⟨t, ht, h₁⟩ := ih s₀ e
      have hs := step_state' s₀
      simp only [Option.bind] at h
      rw [h] at hs
      obtain ⟨u, hu⟩ := hs
      exact ⟨t + (u + 1), by omega, steps_seq H135376.trans h₁ hu⟩
where
  step_state' : ∀ s, Sound s (next s)
    | .C k a b => step_state k a b

/-- If the orbit stops, the machine halts. -/
theorem halts_of_orbit : ∀ n, orbit n = none → HaltsFromBlank := by
  intro n
  induction n with
  | zero => intro h; cases h
  | succ n ih =>
    intro h
    cases e : orbit n with
    | none => exact ih e
    | some s =>
      simp only [orbit, e, Option.bind] at h
      obtain ⟨t, -, h₁⟩ := orbit_reach n s e
      have hs := orbit_reach.step_state' s
      rw [h] at hs
      obtain ⟨c', ⟨u, hu⟩, hc'⟩ := hs
      exact ⟨t + u, c', steps_seq H135376.trans h₁ hu, hc'⟩

/-- **The halts-iff map.**  The machine halts from blank tape if and only if the orbit of `next` from `C 0 2 0`
stops. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ n, orbit n = none := by
  constructor
  · intro hb
    apply Classical.byContradiction
    intro hn
    have hall : ∀ n, ∃ s, orbit n = some s := by
      intro n
      cases e : orbit n with
      | none => exact absurd ⟨n, e⟩ hn
      | some s => exact ⟨s, rfl⟩
    apply not_halts_of_forall H135376.trans _ hb
    apply forall_of_unbounded H135376.trans (fun t => ∃ n s, orbit n = some s ∧ n ≤ t ∧ steps t init = some (enc s))
    · intro N
      obtain ⟨s, hs⟩ := hall N
      obtain ⟨t, ht, h⟩ := orbit_reach N s hs
      exact ⟨t, ht, N, s, hs, ht, h⟩
    · rintro t ⟨n, s, -, -, h⟩
      exact ⟨_, h⟩
  · rintro ⟨n, h⟩
    exact halts_of_orbit n h

end H135376
