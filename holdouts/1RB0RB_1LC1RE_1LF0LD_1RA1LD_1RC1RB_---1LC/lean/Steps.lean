  have h5 : steps ((m) * 2) ⟨rep (m) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))))), cons true (cons false (cons true (blank))), .D⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))), cons true (rep (m) [true, true] (cons false (cons true (blank)))), .D⟩ :=
