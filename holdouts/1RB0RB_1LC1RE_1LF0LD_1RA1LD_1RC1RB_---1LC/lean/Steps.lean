  have h6 : steps 8 ⟨cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))), cons true (rep (m) [true, true] (cons false (cons true (blank)))), .D⟩ = some ⟨blank, cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (m) [true, true] (cons false (cons true (blank)))))))))))), .D⟩ := rfl
