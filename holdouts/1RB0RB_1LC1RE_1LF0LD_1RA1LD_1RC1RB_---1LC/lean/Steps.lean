/-- p = 3, r = 2m+3. -/
theorem p3as (m : Nat) :
    steps (4 * m + 34) ⟨blank, cons true (cons true (cons true (cons false (cons true (rep (m + 1) [true, true] (blank)))))), .D⟩ = some ⟨blank, cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (m) [true, true] (cons false (cons true (cons true (blank)))))))))))), .D⟩ := by
  have hn : 20 + (0 + ((m + 1) * 2 + (5 + (0 + ((m) * 2 + (7)))))) = 4 * m + 34 := by omega
  have h0 : steps 20 ⟨blank, cons true (cons true (cons true (cons false (cons true (rep (m + 1) [true, true] (blank)))))), .D⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), cons true (rep (m + 1) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), cons true (rep (m + 1) [true, true] (blank)), .B⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), rep (m + 1) [true, true] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (m + 1) [true, true] (blank)) = rep (m + 1) [true, true] (cons true (blank)) from
      rep_rotate (m + 1) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((m + 1) * 2) ⟨cons true (cons true (cons true (cons true (cons true (cons true (blank)))))), rep (m + 1) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (m + 1) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), cons true (blank), .B⟩ :=
    cross_r trans c2 (m + 1) (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))) (cons true (blank))
  have h3 : steps 5 ⟨rep (m + 1) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), cons true (blank), .B⟩ = some ⟨cons true (rep (m) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))), cons true (cons false (cons true (cons true (blank)))), .D⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (m) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))), cons true (cons false (cons true (cons true (blank)))), .D⟩ = some ⟨rep (m) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))), cons true (cons false (cons true (cons true (blank)))), .D⟩ := by
    simp only [steps_zero, show cons true (rep (m) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))) = rep (m) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))) from
      rep_rotate (m) [true] [true, true] [true, true] rfl (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((m) * 2) ⟨rep (m) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))), cons true (cons false (cons true (cons true (blank)))), .D⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), cons true (rep (m) [true, true] (cons false (cons true (cons true (blank))))), .D⟩ :=
    cross_l trans c5 (m) (cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank)))))))) (cons false (cons true (cons true (blank))))
  have h6 : steps 7 ⟨cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), cons true (rep (m) [true, true] (cons false (cons true (cons true (blank))))), .D⟩ = some ⟨blank, cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (m) [true, true] (cons false (cons true (cons true (blank)))))))))))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- p = 3, r = 2. -/
theorem p3b0 :
    steps (30) ⟨blank, cons true (cons true (cons true (cons false (cons true (cons true (blank)))))), .D⟩ = some ⟨blank, cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons false (cons true (blank))))))))), .D⟩ := by
  have hn : 30 = 30 := by omega
  have h0 : steps 30 ⟨blank, cons true (cons true (cons true (cons false (cons true (cons true (blank)))))), .D⟩ = some ⟨blank, cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons false (cons true (blank))))))))), .D⟩ := rfl
  exact steps_congr trans hn (h0)

