import Steps
import Rules

/-!
# 1RB0RB_1LC1RE_1LF0LD_1RA1LD_1RC1RB_---1LC: the hole map, proved

Hand-written; the rules it chains are proved in `Steps.lean` (generated by `py/steps.py` with `bbtools.symtm`) and
the halting family in `Rules.lean`. Same construction as for `holdouts/1RB0RB_1LB0LC_1RD1LC_1RE0RA_0RF1RA_---1LB`
(division by 3 there, by 2 here); the generic lemmas (`iterate`, `tri`, the runs of ones) are copied from it.

`S p r` is the sample: the head in state D on the leftmost cell of `1^p 0 1^r` (blank tape on both sides). For
`p, r ≥ 1` the machine goes from `S p r` to `S p' r'` given by `f p r`, in `cost p r` steps, or halts (`p = 1`):

* `p = 1`:          halts
* `p = 3`:          `S 3 r → S (r + 5) 2` (r odd),  `S 3 r → S (r + 5) 1` (r even)
* `p = 2k + 2`:     `S p r → S (3k + r + 4) 1`
* `p = 2m + 1 ≥ 5`: `S p r → S (m - 1) (m + r + 3)`   (the halving)

From blank tape the machine reaches `S 2 2` in 11 steps. `halts_iff`: the machine halts from blank tape iff the
orbit of `(2, 2)` under `f` reaches `p = 1`.
-/

namespace H53489

open TM

/-! ## Iterating a rule -/

/-- `g` applied `n` times. -/
def it {α : Type} (g : α → α) : Nat → α → α
  | 0, a => a
  | n + 1, a => it g n (g a)

/-- The steps of `n` uses of a rule whose `n`-th use costs `s n a`. -/
def iterSteps {α : Type} (s : Nat → α → Nat) (g : α → α) : Nat → α → Nat
  | 0, _ => 0
  | n + 1, a => s n a + iterSteps s g n (g a)

/-- A rule `F (n+1) a → F n (g a)` used `n` times. -/
theorem iterate {α : Type} (F : Nat → α → Config) (g : α → α) (s : Nat → α → Nat)
    (h : ∀ n a, steps (s n a) (F (n + 1) a) = some (F n (g a))) :
    ∀ n a, steps (iterSteps s g n a) (F n a) = some (F 0 (it g n a)) := by
  intro n
  induction n with
  | zero => intro a; rfl
  | succ n ih => intro a; exact steps_seq trans (h n a) (ih (g a))

theorem it_app (w : List Bool) (n : Nat) : ∀ L, it (app w) n L = rep n w L := by
  induction n with
  | zero => intro L; rfl
  | succ n ih => intro L; show it (app w) n (app w L) = _; rw [ih, rep_app_comm]

theorem it_pair (u v : List Bool) (n : Nat) : ∀ L R,
    it (fun x : Tape × Tape => (app u x.1, app v x.2)) n (L, R) = (rep n u L, rep n v R) := by
  induction n with
  | zero => intro L R; rfl
  | succ n ih =>
    intro L R
    show it (fun x : Tape × Tape => (app u x.1, app v x.2)) n (app u L, app v R) = _
    rw [ih, rep_app_comm, rep_app_comm]

/-- `n (n - 1) / 2`. -/
def tri (n : Nat) : Nat := n * (n - 1) / 2

theorem tri_succ (n : Nat) : tri (n + 1) = tri n + n := by
  unfold tri
  cases n with
  | zero => rfl
  | succ n =>
    rw [show n + 1 + 1 - 1 = n + 1 by omega, show n + 1 - 1 = n by omega, Nat.succ_mul, Nat.mul_succ]
    omega

theorem iter_const {α : Type} (c : Nat) (g : α → α) (n : Nat) : ∀ a, iterSteps (fun _ _ => c) g n a = c * n := by
  induction n with
  | zero => intro a; rfl
  | succ n ih => intro a; simp only [iterSteps, ih, Nat.mul_succ]; omega

theorem iter_lin {α : Type} (x y : Nat) (g : α → α) (n : Nat) :
    ∀ a, iterSteps (fun n _ => x * n + y) g n a = x * tri n + y * n := by
  induction n with
  | zero => intro a; rfl
  | succ n ih => intro a; simp only [iterSteps, ih, tri_succ, Nat.mul_succ, Nat.mul_add]; omega

/-! ## Runs of ones -/

theorem ones_cons (n : Nat) (s : Tape) : rep n [true] (cons true s) = rep (n + 1) [true] s :=
  rep_app_comm n [true] s

theorem ones_add (a b : Nat) (s : Tape) : rep a [true] (rep b [true] s) = rep (a + b) [true] s :=
  (rep_add a b [true] s).symm

theorem ones3 (k : Nat) (s : Tape) : rep k [true, true, true] s = rep (3 * k) [true] s := by
  induction k with
  | zero => rfl
  | succ k ih => rw [show 3 * (k + 1) = 3 * k + 1 + 1 + 1 by omega, rep_succ, ih]; rfl

theorem ones4 (k : Nat) (s : Tape) : rep k [true, true, true, true] s = rep (4 * k) [true] s := by
  induction k with
  | zero => rfl
  | succ k ih => rw [show 4 * (k + 1) = 4 * k + 1 + 1 + 1 + 1 by omega, rep_succ, ih]; rfl

theorem ones2 (k : Nat) (s : Tape) : rep k [true, true] s = rep (2 * k) [true] s := by
  induction k with
  | zero => rfl
  | succ k ih => rw [show 2 * (k + 1) = 2 * k + 1 + 1 by omega, rep_succ, ih]; rfl

theorem rep2_comm (k : Nat) (s : Tape) :
    rep k [true, true] (cons true (cons true s)) = rep (k + 1) [true, true] s :=
  rep_app_comm k [true, true] s

theorem rep3_comm (k : Nat) (s : Tape) :
    rep k [true, true, true] (cons true (cons true (cons true s))) = rep (k + 1) [true, true, true] s :=
  rep_app_comm k [true, true, true] s

/-! ## The sample and the map -/

/-- The sample `D> 1^p 0 1^r` on blank tape. -/
def S (p r : Nat) : Config := ⟨blank, rep p [true] (cons false (rep r [true] blank)), .D⟩

/-- The hole map (`none`: the machine halts). Meant for `p, r ≥ 1`. -/
def f (p r : Nat) : Option (Nat × Nat) :=
  if p = 1 then none
  else if p = 3 then (if r % 2 = 1 then some (r + 5, 2) else some (r + 5, 1))
  else if p % 2 = 0 then some (3 * ((p - 2) / 2) + r + 4, 1)
  else some ((p - 1) / 2 - 1, (p - 1) / 2 + r + 3)

/-- Steps from `S p r` to the next sample. -/
def cost (p r : Nat) : Nat :=
  if p = 3 then (if r % 2 = 1 then 2 * r + 28 else 2 * r + 26)
  else if p % 2 = 0 then
    (4 * ((p - 2) / 2) + 6) + ((4 * ((p - 2) / 2) + 7) * (r - 1) + ((12 * tri ((p - 2) / 2) + 25 * ((p - 2) / 2))
      + (3 * ((p - 2) / 2) + r + 18)))
  else 1 + ((4 * tri ((p - 1) / 2) + 7 * ((p - 1) / 2)) + ((p - 1) / 2 + 4))

/-! ## The cases -/

theorem steps_conv {n : Nat} {a a' b b' : Config} (h : steps n a = some b) (ha : a' = a) (hb : b = b') :
    steps n a' = some b' := by
  subst ha; subst hb; exact h

theorem one_rep (s : Tape) : cons true s = rep 1 [true] s := rfl

/-- Two configurations that differ only in how their runs of ones are written. -/
macro "tape_eq" : tactic =>
  `(tactic| (simp only [S, one_rep, ones_add, ones2, ones3, ones4]; repeat (first | omega | rfl | congr 1)))

/-- `0 1 D> 1 (11)^k 0` drifting right over `n` ones. -/
theorem drift_n (k n : Nat) (L : Tape) :
    steps ((4 * k + 7) * n) ⟨cons true (cons false L), cons true (rep k [true, true] (cons false (rep n [true] blank))), .D⟩
      = some ⟨cons true (cons false (rep n [true] L)), cons true (rep k [true, true] (cons false blank)), .D⟩ := by
  have h := iterate (fun n L => ⟨cons true (cons false L), cons true (rep k [true, true] (cons false (rep n [true] blank))), .D⟩)
    (app [true]) (fun _ _ => 4 * k + 7) (fun n L => drift k L (rep n [true] blank)) n L
  rw [iter_const, it_app] at h
  exact h

/-- The block at the right end, used up `k` times. -/
theorem loop_n (k : Nat) (L : Tape) :
    steps (12 * tri k + 25 * k) ⟨cons true (cons false L), cons true (rep k [true, true] (cons false blank)), .D⟩
      = some ⟨cons true (cons false (rep (3 * k) [true] L)), cons true (cons false blank), .D⟩ := by
  have h := iterate (fun n L => ⟨cons true (cons false L), cons true (rep n [true, true] (cons false blank)), .D⟩)
    (app [true, true, true]) (fun n _ => 12 * n + 25)
    (fun n L => by have := loop n L; rw [rep2_comm] at this; exact this) k L
  rw [iter_lin, it_app, ones3] at h
  exact h

/-- `m` halving rounds. -/
theorem round_n (m : Nat) (L R : Tape) :
    steps (4 * tri m + 7 * m) ⟨L, cons false (cons true (rep m [true, true] (cons false R))), .D⟩
      = some ⟨rep m [true] L, cons false (cons true (cons false (rep m [true] R))), .D⟩ := by
  have h := iterate (fun n (x : Tape × Tape) =>
      (⟨x.1, cons false (cons true (rep n [true, true] (cons false x.2))), .D⟩ : Config))
    (fun x : Tape × Tape => (app [true] x.1, app [true] x.2)) (fun n _ => 4 * n + 7)
    (fun n x => by have := round n x.1 x.2; rw [rep2_comm] at this; exact this) m (L, R)
  rw [iter_lin, it_pair] at h
  exact h

theorem finalE' (j : Nat) :
    steps (j + 18) ⟨cons true (cons false (rep j [true] blank)), cons true (cons false blank), .D⟩ = some (S (j + 4) 1) :=
  steps_conv (finalE j) rfl (by tape_eq)

theorem caseE (k R : Nat) :
    steps ((4 * k + 6) + ((4 * k + 7) * R + ((12 * tri k + 25 * k) + (3 * k + (R + 1) + 18))))
      (S (2 * k + 2) (R + 1)) = some (S (3 * k + R + 5) 1) := by
  have h1 := steps_conv (initE k (rep R [true] blank)) (a' := S (2 * k + 2) (R + 1))
    (b' := ⟨cons true (cons false (cons true blank)), cons true (rep k [true, true] (cons false (rep R [true] blank))), .D⟩)
    (by tape_eq) rfl
  have h2 := steps_conv (drift_n k R (cons true blank)) rfl
    (b' := ⟨cons true (cons false (rep (R + 1) [true] blank)), cons true (rep k [true, true] (cons false blank)), .D⟩)
    (by tape_eq)
  have h3 := steps_conv (loop_n k (rep (R + 1) [true] blank)) rfl
    (b' := ⟨cons true (cons false (rep (3 * k + (R + 1)) [true] blank)), cons true (cons false blank), .D⟩) (by tape_eq)
  have h4 := steps_conv (finalE' (3 * k + (R + 1))) rfl (b' := S (3 * k + R + 5) 1) (by tape_eq)
  exact steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 h4))

theorem caseO (a r : Nat) :
    steps (1 + ((4 * tri (a + 2) + 7 * (a + 2)) + (a + 6))) (S (2 * a + 5) r) = some (S (a + 1) (a + r + 5)) := by
  have h1 := steps_conv (initO (rep (2 * a + 4) [true] (cons false (rep r [true] blank)))) (a' := S (2 * a + 5) r)
    (b' := ⟨blank, cons false (cons true (rep (a + 2) [true, true] (cons false (rep r [true] blank)))), .D⟩)
    (by tape_eq) (by tape_eq)
  have h2 := round_n (a + 2) blank (rep r [true] blank)
  have h3 := steps_conv (endO a (rep (a + 2) [true] (rep r [true] blank)))
    (a' := ⟨rep (a + 2) [true] blank, cons false (cons true (cons false (rep (a + 2) [true] (rep r [true] blank)))), .D⟩)
    (b' := S (a + 1) (a + r + 5)) (by tape_eq) (by tape_eq)
  exact steps_seq trans h1 (steps_seq trans h2 h3)

theorem caseP3a0 : steps 30 (S 3 1) = some (S 6 2) := steps_conv p3a0 (by tape_eq) (by tape_eq)
theorem caseP3as (m : Nat) : steps (4 * m + 34) (S 3 (2 * m + 3)) = some (S (2 * m + 8) 2) :=
  steps_conv (p3as m) (by tape_eq) (by tape_eq)
theorem caseP3b0 : steps 30 (S 3 2) = some (S 7 1) := steps_conv p3b0 (by tape_eq) (by tape_eq)
theorem caseP3bs (m : Nat) : steps (4 * m + 34) (S 3 (2 * m + 4)) = some (S (2 * m + 9) 1) :=
  steps_conv (p3bs m) (by tape_eq) (by tape_eq)

theorem caseP1 (r : Nat) : Halts trans (S 1 r) := halts_family (rep r [true] blank)

theorem f_c1 (r : Nat) : f 1 r = none := by simp [f]
theorem f_c3o (r : Nat) (h : r % 2 = 1) : f 3 r = some (r + 5, 2) := by
  unfold f; rw [if_neg (by omega), if_pos rfl, if_pos h]
theorem f_c3e (r : Nat) (h : r % 2 = 0) : f 3 r = some (r + 5, 1) := by
  unfold f; rw [if_neg (by omega), if_pos rfl, if_neg (by omega)]
theorem cost_c3o (r : Nat) (h : r % 2 = 1) : cost 3 r = 2 * r + 28 := by
  unfold cost; rw [if_pos rfl, if_pos h]
theorem cost_c3e (r : Nat) (h : r % 2 = 0) : cost 3 r = 2 * r + 26 := by
  unfold cost; rw [if_pos rfl, if_neg (by omega)]
theorem f_cE (k R : Nat) : f (2 * k + 2) (R + 1) = some (3 * k + R + 5, 1) := by
  unfold f; rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  rw [show (2 * k + 2 - 2) / 2 = k by omega, show 3 * k + (R + 1) + 4 = 3 * k + R + 5 by omega]
theorem cost_cE (k R : Nat) : cost (2 * k + 2) (R + 1) =
    (4 * k + 6) + ((4 * k + 7) * R + ((12 * tri k + 25 * k) + (3 * k + (R + 1) + 18))) := by
  unfold cost; rw [if_neg (by omega), if_pos (by omega)]
  rw [show (2 * k + 2 - 2) / 2 = k by omega, show R + 1 - 1 = R by omega]
theorem f_cO (a r : Nat) : f (2 * a + 5) r = some (a + 1, a + r + 5) := by
  unfold f; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega)]
  rw [show (2 * a + 5 - 1) / 2 = a + 2 by omega]
  simp only [Option.some.injEq, Prod.mk.injEq]; omega
theorem cost_cO (a r : Nat) : cost (2 * a + 5) r = 1 + ((4 * tri (a + 2) + 7 * (a + 2)) + (a + 6)) := by
  unfold cost; rw [if_neg (by omega), if_neg (by omega)]
  rw [show (2 * a + 5 - 1) / 2 = a + 2 by omega]

/-- One sample to the next: for `p, r ≥ 1`, `S p r` reaches `S p' r'` in `cost p r` steps when `f p r = some (p', r')`,
and halts when `f p r = none`. -/
theorem sample_step (p r : Nat) (hp : 1 ≤ p) (hr : 1 ≤ r) :
    match f p r with
    | some (p', r') => steps (cost p r) (S p r) = some (S p' r')
    | none => Halts trans (S p r) := by
  by_cases h1 : p = 1
  · subst h1; rw [f_c1]; exact caseP1 r
  by_cases h3 : p = 3
  · subst h3
    by_cases ho : r % 2 = 1
    · rw [f_c3o r ho, cost_c3o r ho]
      by_cases r1 : r = 1
      · subst r1; exact caseP3a0
      · obtain ⟨m, rfl⟩ : ∃ m, r = 2 * m + 3 := ⟨(r - 3) / 2, by omega⟩
        rw [show 2 * (2 * m + 3) + 28 = 4 * m + 34 by omega, show 2 * m + 3 + 5 = 2 * m + 8 by omega]
        exact caseP3as m
    · have he : r % 2 = 0 := by omega
      rw [f_c3e r he, cost_c3e r he]
      by_cases r2 : r = 2
      · subst r2; exact caseP3b0
      · obtain ⟨m, rfl⟩ : ∃ m, r = 2 * m + 4 := ⟨(r - 4) / 2, by omega⟩
        rw [show 2 * (2 * m + 4) + 26 = 4 * m + 34 by omega, show 2 * m + 4 + 5 = 2 * m + 9 by omega]
        exact caseP3bs m
  by_cases he : p % 2 = 0
  · obtain ⟨k, rfl⟩ : ∃ k, p = 2 * k + 2 := ⟨(p - 2) / 2, by omega⟩
    obtain ⟨R, rfl⟩ : ∃ R, r = R + 1 := ⟨r - 1, by omega⟩
    rw [f_cE, cost_cE]; exact caseE k R
  · obtain ⟨a, rfl⟩ : ∃ a, p = 2 * a + 5 := ⟨(p - 5) / 2, by omega⟩
    rw [f_cO, cost_cO]; exact caseO a r

theorem f_dom (p r p' r' : Nat) (hr : 1 ≤ r) (h : f p r = some (p', r')) : 1 ≤ p' ∧ 1 ≤ r' := by
  unfold f at h
  split at h
  · cases h
  split at h
  · split at h
    · cases h; omega
    · cases h; omega
  split at h
  · cases h; omega
  · cases h
    rename_i h1 h3 h2
    omega

theorem cost_pos (p r : Nat) : 1 ≤ cost p r := by
  unfold cost
  split
  · split <;> omega
  · split <;> omega

/-! ## The reduction -/

/-- The orbit of the first sample `(2, 2)`; `none` once the map has halted. -/
def orb : Nat → Option (Nat × Nat)
  | 0 => some (2, 2)
  | n + 1 => match orb n with
    | some (p, r) => f p r
    | none => none

theorem start_S : steps 11 init = some (S 2 2) := start

theorem halts_of_steps {a : Nat} {c c' : Config} (h : steps a c = some c') (h' : Halts trans c') : Halts trans c := by
  obtain ⟨n, c'', h1, h2⟩ := h'
  exact ⟨a + n, c'', steps_seq trans h h1, h2⟩

theorem reach (n : Nat) : ∀ p r, orb n = some (p, r) → 1 ≤ p ∧ 1 ≤ r ∧ ∃ t, n ≤ t ∧ steps t init = some (S p r) := by
  induction n with
  | zero =>
    intro p r h
    simp only [orb, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨by omega, by omega, 11, by omega, start_S⟩
  | succ n ih =>
    intro p' r' h
    simp only [orb] at h
    split at h
    · rename_i p r hpr
      obtain ⟨hp, hr, t, hn, ht⟩ := ih p r hpr
      have hs := sample_step p r hp hr
      rw [h] at hs
      obtain ⟨hp', hr'⟩ := f_dom p r p' r' hr h
      exact ⟨hp', hr', t + cost p r, by have := cost_pos p r; omega, steps_seq trans ht hs⟩
    · cases h

/-- **The reduction.** The machine halts from blank tape iff the orbit of `(2, 2)` under the hole map `f` reaches
the halting case `p = 1`. -/
theorem halts_iff : HaltsFromBlank ↔ ∃ n, orb n = none := by
  constructor
  · intro hh
    apply Classical.byContradiction
    intro hne
    have hall : ∀ n, ∃ p r, orb n = some (p, r) := by
      intro n
      cases h : orb n with
      | none => exact absurd ⟨n, h⟩ hne
      | some x => exact ⟨x.1, x.2, rfl⟩
    apply not_halts_of_forall trans _ hh
    apply forall_of_unbounded trans (fun m => ∃ n p r, orb n = some (p, r) ∧ steps m init = some (S p r))
    · intro n
      obtain ⟨p, r, h⟩ := hall n
      obtain ⟨_, _, t, hn, ht⟩ := reach n p r h
      exact ⟨t, hn, n, p, r, h, ht⟩
    · rintro m ⟨n, p, r, _, hm⟩
      exact ⟨_, hm⟩
  · rintro ⟨n, hn⟩
    induction n with
    | zero => simp [orb] at hn
    | succ n ih =>
      cases h : orb n with
      | none => exact ih h
      | some x =>
        obtain ⟨p, r⟩ := x
        obtain ⟨hp, hr, t, _, ht⟩ := reach n p r h
        simp only [orb, h] at hn
        have hs := sample_step p r hp hr
        rw [hn] at hs
        exact halts_of_steps ht hs

end H53489
