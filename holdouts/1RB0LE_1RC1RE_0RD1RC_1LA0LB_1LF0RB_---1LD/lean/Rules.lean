/-- The only way to a halt: D on a 0 with 1 0 0 to its left reaches F on a 0 (which halts) in 3 steps. -/
theorem halt_shape (L R : Tape) :
    steps (3) ⟨cons true (cons false (cons false (L))), cons false (R), .D⟩ = some ⟨L, cons false (cons true (cons false (cons true (R)))), .F⟩ := by
