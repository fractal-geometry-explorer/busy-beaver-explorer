  have h0 : steps ((n) * 20) ⟨L, rep (n) [true, true, true, false, true, true, true, false, true, true, true, false] (R), .E⟩ = some ⟨rep (n) [true, true, true, true, true, true, true, true, true, false, true, false] (L), R, .E⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 20) (by omega) (h0)

