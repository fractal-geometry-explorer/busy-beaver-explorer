/-- The first sweep of a phase: rightward, E (through B) turns each pair 11 into 01, 2 steps a pair. -/
theorem e_halve (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, true] (R), .E⟩ = some ⟨rep (n) [true, false] (L), R, .E⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (R), .E⟩ = some ⟨rep (n) [true, false] (L), R, .E⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- A merging sweep: rightward, E turns every three blocks 1110 1110 1110 into 0101 1111 1111 (20 steps a copy); later sweeps make blocks 1^11 0 out of them, three blocks into one. -/
theorem e_triple (n : Nat) (L R : Tape) :
    steps (20 * n) ⟨L, rep (n) [true, true, true, false, true, true, true, false, true, true, true, false] (R), .E⟩ = some ⟨rep (n) [true, true, true, true, true, true, true, true, true, false, true, false] (L), R, .E⟩ := by
