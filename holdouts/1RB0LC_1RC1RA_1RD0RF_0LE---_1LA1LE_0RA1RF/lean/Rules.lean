import Machine

/-! # Shift rules of 1RB0LC_1RC1RA_1RD0RF_0LE---_1LA1LE_0RA1RF

Passes over the regular parts of the tape.  The 24-cell word `q = 010110101101010110101101` (here in the rotation the
head meets) is rewritten by A moving right, 32 steps a copy (`pass_right_q`), and rewritten back by C moving left,
68 steps a copy (`pass_left_q`); A also crosses runs of `011` (`pass_right_c`).  The only halt is D reading a 1, and
D is entered only from C reading a 0, so `C> 0 1` halts (`halt_C`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H63327

open TM

set_option maxRecDepth 100000

/-- A moving right over the q-region, 32 steps a copy. -/
theorem pass_right_q (n : Nat) (L R : Tape) :
    steps (32 * n) ⟨L, rep (n) [false, true, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true] (R), .A⟩ = some ⟨rep (n) [true, true, true, true, false, false, true, true, true, false, false, true, true, true, true, true, false, false, true, true, true, false, false, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 32 ⟨app [] L, app [false, true, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true, false, false, true, true, true, false, false, true, true, true, true, true, false, false, true, true, true, false, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 32) ⟨L, rep (n) [false, true, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true] (R), .A⟩ = some ⟨rep (n) [true, true, true, true, false, false, true, true, true, false, false, true, true, true, true, true, false, false, true, true, true, false, false, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 32) (by omega) (h0)

/-- C moving left over the rewritten q-region, 68 steps a copy, restoring q. -/
theorem pass_left_q (n : Nat) (L R : Tape) :
    steps (68 * n) ⟨rep (n) [false, true, true, true, false, false, true, true, true, true, true, false, false, true, true, true, false, false, true, true, true, true, true, false] (L), cons false (cons false (R)), .C⟩ = some ⟨L, cons false (cons false (rep (n) [true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false] (R))), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 68 ⟨app [false, true, true, true, false, false, true, true, true, true, true, false, false, true, true, true, false, false, true, true, true, true, true, false] L, app [false, false] R, .C⟩ = some ⟨L, app [false, false] (app [true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 68) ⟨rep (n) [false, true, true, true, false, false, true, true, true, true, true, false, false, true, true, true, false, false, true, true, true, true, true, false] (L), cons false (cons false (R)), .C⟩ = some ⟨L, cons false (cons false (rep (n) [true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false] (R))), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 68) (by omega) (h0)

/-- A moving right over a run of `011`, 5 steps a copy. -/
theorem pass_right_c (n : Nat) (L R : Tape) :
    steps (5 * n) ⟨L, rep (n) [false, true, true] (R), .A⟩ = some ⟨rep (n) [false, false, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 5 ⟨app [] L, app [false, true, true] R, .A⟩ = some ⟨app [] (app [false, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 5) ⟨L, rep (n) [false, true, true] (R), .A⟩ = some ⟨rep (n) [false, false, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 5) (by omega) (h0)

/-- `C> 0 1` halts: C writes a 1 and steps right in state D onto a 1, which has no transition. -/
theorem halt_C (L R : Tape) :
    ∃ c, steps 1 ⟨L, cons false (cons true R), .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H63327
