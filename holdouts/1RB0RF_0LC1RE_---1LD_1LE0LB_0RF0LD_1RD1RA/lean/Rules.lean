  have h2 : steps ((b) * 4) ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), rep (b) [false, true] (cons false (blank)), .F⟩ = some ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (blank), .F⟩ :=
    cross_r trans c2 (b) (cons false (cons true (cons false (cons true (cons false (cons true (L))))))) (cons false (blank))
  have h3 : steps 2 ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (blank), .F⟩ = some ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons true (cons true (blank)), .E⟩ := rfl
  have c4 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h4 : steps ((b) * 2) ⟨rep (b) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (L))))))), cons true (cons true (blank)), .E⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), cons true (rep (b) [true, false] (cons true (blank))), .E⟩ :=
    cross_l trans c4 (b) (cons false (cons true (cons false (cons true (cons false (cons true (L))))))) (cons true (blank))
  have h5 : steps 6 ⟨cons false (cons true (cons false (cons true (cons false (cons true (L)))))), cons true (rep (b) [true, false] (cons true (blank))), .E⟩ = some ⟨L, cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (b) [true, false] (cons true (blank))))))))), .E⟩ := rfl
  exact steps_congr trans (a := 8 + (0 + ((b) * 4 + (2 + ((b) * 2 + (6)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- Later in the even branch: E going left takes one more 10 into the right-hand run. -/
theorem absorb_10 (b : Nat) (L : Tape) :
    steps (2) ⟨cons false (cons true (L)), cons true (cons true (cons false (rep (b) [true, false] (blank)))), .E⟩ = some ⟨L, cons true (cons true (cons false (cons true (cons false (rep (b) [true, false] (blank)))))), .E⟩ := by
  have h0 : steps 2 ⟨cons false (cons true (L)), cons true (cons true (cons false (rep (b) [true, false] (blank)))), .E⟩ = some ⟨L, cons true (cons true (cons false (cons true (cons false (rep (b) [true, false] (blank)))))), .E⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- F going right over 01 words. -/
theorem f_right (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨L, rep (n) [false, true] (R), .F⟩ = some ⟨rep (n) [false, true] (L), R, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨L, rep (n) [false, true] (R), .F⟩ = some ⟨rep (n) [false, true] (L), R, .F⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 4) (by omega) (h0)

/-- F going right turns 0111 into 1010. -/
theorem f_0111 (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨L, rep (n) [false, true, true, true] (R), .F⟩ = some ⟨rep (n) [false, true, false, true] (L), R, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, true, true] R, .F⟩ = some ⟨app [] (app [false, true, false, true] L), R, .F⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨L, rep (n) [false, true, true, true] (R), .F⟩ = some ⟨rep (n) [false, true, false, true] (L), R, .F⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 6) (by omega) (h0)

/-- D going left over 01 words. -/
theorem d_left (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [true, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [false, true] (R)), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [true, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [false, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- E going left over 10 words. -/
theorem e_left (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [false, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [true, false] (R)), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [false, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [true, false] (R)), .E⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

