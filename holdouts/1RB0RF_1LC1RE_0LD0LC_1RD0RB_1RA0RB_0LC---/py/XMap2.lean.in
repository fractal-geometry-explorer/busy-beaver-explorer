import XRules
import Sim

/-!
# The closed-form macro map of @@M@@

Generated by `py/gen_xmap2.py` in the folder of 1RB0RF_1LC1RE_0LD0LC_1RD0RB_1RA0RB_0LC---; do not edit by hand.

`Full.lean` has a partial macro map `astep` and `Sim.lean` completes it with a checked simulation (`tstep`).  Here
the simulated stretches are replaced by rules proved for all values of their parameters (XRules.lean, one rule per
case of the symbolic case split in `py/xleaves2.py`).  This machine needs more than its sisters:

* a collision on a misaligned gap of 1 rewrites the end of the word: the cases depend on the word's last block or
  two (`wv` sorts the word into six views, `xg01A` … `xg11F`);
* a second misaligned gap may be pending behind the colliding one (gap lengths `3q` and `3q+1` are runs `m0 q`,
  `m1 q` of the run-length form);
* when that second gap is 0, the step depends on the parity of the number of gaps of 2 between them (`xz…`);
  four of these configurations halt (they are left out, `hz` in XRace.lean lists them);
* the anomaly with a one-unit counter (`xanu`) and the anomaly inside the word (`inner_step`) as for the sisters.

`bstep` is `astep` where it applies and these rules elsewhere; `bstep_sound` and `not_halts_of_brun`: if `bstep` can
be applied for ever from the configuration at step 27, the machine never halts, and no step is a simulation.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxHeartbeats 0

namespace @@NS@@

open TM

/-! ## The run-length form of a gap list -/

/-- A run of the gap list: `two n` (n gaps of 2), `five n` (n gaps of 5), `big q` (one gap `3q+8`), and the
misaligned gaps `m0 q` (one gap `3q`) and `m1 q` (one gap `3q+1`). -/
inductive Sg where
  | two (n : Nat)
  | five (n : Nat)
  | big (q : Nat)
  | m0 (q : Nat)
  | m1 (q : Nat)
deriving Repr, DecidableEq

/-- The gaps of a run. -/
def Sg.gs : Sg → List Nat
  | .two n => List.replicate n 2
  | .five n => List.replicate n 5
  | .big q => [3 * q + 8]
  | .m0 q => [3 * q]
  | .m1 q => [3 * q + 1]

/-- The gaps of a list of runs. -/
def flat : List Sg → List Nat
  | [] => []
  | x :: S => x.gs ++ flat S

/-- A single gap as a run. -/
def one (g : Nat) (S : List Sg) : List Sg :=
  if g = 2 then .two 1 :: S
  else if g = 5 then .five 1 :: S
  else if 8 ≤ g ∧ g % 3 = 2 then .big ((g - 8) / 3) :: S
  else if g % 3 = 0 then .m0 (g / 3) :: S
  else .m1 (g / 3) :: S

/-- Put a gap in front, merging it into a run of the same gap. -/
def push (g : Nat) : List Sg → List Sg
  | .two n :: S => if g = 2 then .two (n + 1) :: S else one g (.two n :: S)
  | .five n :: S => if g = 5 then .five (n + 1) :: S else one g (.five n :: S)
  | S => one g S

/-- The run-length form. -/
def rl : List Nat → List Sg
  | [] => []
  | g :: G => push g (rl G)

theorem flat_one (g : Nat) (S : List Sg) : flat (one g S) = g :: flat S := by
  unfold one
  split
  · subst_vars; rfl
  · split
    · subst_vars; rfl
    · split
      · simp only [flat, Sg.gs, List.cons_append, List.nil_append]; congr 1; omega
      · split
        · simp only [flat, Sg.gs, List.cons_append, List.nil_append]; congr 1; omega
        · simp only [flat, Sg.gs, List.cons_append, List.nil_append]; congr 1; omega

theorem flat_push (g : Nat) : ∀ S : List Sg, flat (push g S) = g :: flat S
  | .two n :: S => by
    unfold push
    by_cases h : g = 2
    · subst h; simp [flat, Sg.gs, List.replicate_succ]
    · simp [h, flat_one]
  | .five n :: S => by
    unfold push
    by_cases h : g = 5
    · subst h; simp [flat, Sg.gs, List.replicate_succ]
    · simp [h, flat_one]
  | .big q :: S => by simp [push, flat_one]
  | .m0 x :: S => by simp [push, flat_one]
  | .m1 x :: S => by simp [push, flat_one]
  | [] => by simp [push, flat_one]

theorem flat_rl : ∀ G : List Nat, flat (rl G) = G
  | [] => rfl
  | g :: G => by simp only [rl, flat_push, flat_rl G]

/-! ## Tape terms -/

/-- A Q configuration whose word is the blocks `Wp` (last first) in front of the tape `L`. -/
def qx (A : Nat) (Wp : List Nat) (L : Tape) (G : List Nat) : Config :=
  ⟨rep A [true, true, true] (cons false (wlx Wp L)), cons false (gl G), .B⟩

theorem wl_wlx : ∀ W : List Nat, wl W = wlx W blank
  | [] => rfl
  | b :: W => by simp only [wl, wlx, wl_wlx W]

theorem qx_blank (A : Nat) (W G : List Nat) : qx A W blank G = qr W A G := by
  simp only [qx, qr, wl_wlx]

/-- Repeats of commuting words commute. -/
theorem rep_comm (m n : Nat) (u w : List Bool) (h : u ++ w = w ++ u) (X : Tape) :
    rep m u (rep n w X) = rep n w (rep m u X) := by
  induction m with
  | zero => rfl
  | succ m ih =>
    show app u (rep m u (rep n w X)) = rep n w (app u (rep m u X))
    rw [ih, rep_rotate n u w w h]

theorem rep_one (g : Nat) (b : Bool) (X : Tape) : rep g [b] X = app (List.replicate g b) X := by
  induction g with
  | zero => rfl
  | succ g ih => simp only [rep_succ, ih, List.replicate_succ, app_cons, app_nil]

theorem gl_rep (n g : Nat) (G : List Nat) :
    gl (List.replicate n g ++ G) = rep n (List.replicate g false ++ [true]) (gl G) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [List.replicate_succ, List.cons_append, gl, ih, rep_succ, rep_one, ← app_app, app_cons, app_nil]

theorem gl_rep_blank (n g : Nat) : gl (List.replicate n g) = rep n (List.replicate g false ++ [true]) blank := by
  have h := gl_rep n g []
  rwa [List.append_nil] at h

theorem wlx_rep (n b : Nat) (X : Tape) : wlx (List.replicate n b) X = rep n (List.replicate b true ++ [false]) X := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [List.replicate_succ, wlx, ih, rep_succ, rep_one, ← app_app, app_cons, app_nil]

/-- Add `j` to the last block of a word. -/
def addh (j : Nat) : List Nat → List Nat
  | b :: V => (b + j) :: V
  | [] => []

theorem wl_addh (j : Nat) : ∀ W : List Nat, W ≠ [] → wl (addh j W) = rep j [true] (wl W)
  | b :: V, _ => by simp only [addh, wl, Nat.add_comm b j, rep_add]
  | [], h => absurd rfl h

/-- Add `j` to the last block of a word, or make `[j]` the word if it is empty (a collision that rewrote the
whole word leaves its first block as `j` on blank tape). -/
def addj (j : Nat) : List Nat → List Nat
  | b :: V => (b + j) :: V
  | [] => [j]

theorem wl_addj (j : Nat) : ∀ V : List Nat, wl (addj j V) = rep j [true] (wl V)
  | b :: V => by simp only [addj, wl, Nat.add_comm b j, rep_add]
  | [] => by simp only [addj, wl, cons_false_blank]

/-- What a collision returns: blocks put in front of the word (last first), the new low part, the new gaps, and
how much the last block of the rest of the word grows. -/
abbrev Res := List Nat × Nat × List Nat × Nat

/-- The configuration a collision result makes with the rest `V` of the word. -/
def res (V : List Nat) (r : Res) : AC := ⟨r.1 ++ addj r.2.2.2 V, r.2.1, r.2.2.1⟩

theorem qx_res (V : List Nat) (C : List Nat) (a' : Nat) (G' : List Nat) (j : Nat) :
    qx a' C (rep j [true] (wl V)) G' = (res V (C, a', G', j)).enc := by
  simp only [res, AC.enc, qr, qx, wl_append, wl_addj]

/-! ## Misaligned gaps and the blocks a collision adds -/

/-- The number of misaligned gaps. -/
def nmis : List Nat → Nat
  | [] => 0
  | g :: G => (if g % 3 = 2 then 0 else 1) + nmis G

theorem nmis_append : ∀ A B : List Nat, nmis (A ++ B) = nmis A + nmis B
  | [], B => by simp [nmis]
  | g :: A, B => by simp only [List.cons_append, nmis, nmis_append A B]; omega

theorem nmis_rep (k g : Nat) : nmis (List.replicate k g) = if g % 3 = 2 then 0 else k := by
  induction k with
  | zero => simp [nmis]
  | succ k ih => simp only [List.replicate_succ, nmis, ih]; split <;> omega

/-- Blocks in front of a valid word: the last may be any positive block, the others odd. -/
def hd1 : List Nat → Prop
  | [] => True
  | c :: C => 1 ≤ c ∧ ∀ b ∈ C, b % 2 = 1

/-! ## The rules on word-and-counter configurations, and the decision functions -/

@@GEN@@

/-! ## The anomaly inside the word -/

theorem qr_inner (x v a : Nat) (V G : List Nat) :
    qr (x :: (v + 1) :: V) a G = qx a [x] (rep 1 [true] (rep v [true] (cons false (wl V)))) G := by
  simp only [qr, qx, wl, wlx, rep_succ, rep_zero, app_cons, app_nil]

theorem qr_inner' (c v : Nat) (V H : List Nat) :
    qr (List.replicate c 1 ++ (v + 1 + 2) :: V) 1 H
      = qx 1 (List.replicate c 1) (rep 3 [true] (rep v [true] (cons false (wl V)))) H := by
  simp only [qr, qx, wl_append, wl, rep_succ, rep_zero, app_cons, app_nil]

/-- A last block `2c+2` with more of the word behind it: `c` single 1s, the next block grows by 2, and a gap of
`3(a-1)` (misaligned) is added in front of the gaps. -/
theorem inner_step (c a y : Nat) (V G : List Nat) (hy : 1 ≤ y) (ha : 1 ≤ a) :
    ∃ n, 1 ≤ n ∧ steps n (qr ((2 * c + 2) :: y :: V) a G)
      = some (qr (List.replicate c 1 ++ (y + 2) :: V) 1 ((3 * (a - 1)) :: G)) := by
  obtain ⟨v, rfl⟩ : ∃ v, y = v + 1 := ⟨y - 1, by omega⟩
  rw [qr_inner, qr_inner']
  rcases Nat.lt_or_ge a 2 with ha2 | ha2
  · obtain rfl : a = 1 := by omega
    rcases c with _ | c
    · have e := xq_inner00 G (rep v [true] (cons false (wl V))) (2 * 0 + 2) (by omega) 1 rfl
      simp only [List.replicate_zero, List.append_nil, show 3 * (1 - 1) = 0 from rfl] at e ⊢
      exact ⟨_, by omega, e⟩
    · have e := xq_inner10 c G (rep v [true] (cons false (wl V))) (2 * (c + 1) + 2) (by omega) 1 rfl
      simp only [List.append_nil, show 3 * (1 - 1) = 0 from rfl] at e ⊢
      exact ⟨_, by omega, e⟩
  · obtain ⟨a', rfl⟩ : ∃ a', a = a' + 2 := ⟨a - 2, by omega⟩
    rcases c with _ | c
    · have e := xq_inner01 a' G (rep v [true] (cons false (wl V))) (2 * 0 + 2) (by omega) (a' + 2) rfl
      simp only [List.replicate_zero, List.append_nil, show 3 * (a' + 2 - 1) = 3 * a' + 3 by omega] at e ⊢
      exact ⟨_, by omega, e⟩
    · have e := xq_inner11 a' c G (rep v [true] (cons false (wl V))) (2 * (c + 1) + 2) (by omega) (a' + 2) rfl
      simp only [List.append_nil, show 3 * (a' + 2 - 1) = 3 * a' + 3 by omega] at e ⊢
      exact ⟨_, by omega, e⟩

/-! ## The map -/

/-- A gap 0 behind the first gaps of 2: the number of those gaps and the runs after the 0. -/
def zs : List Sg → Option (Nat × List Sg)
  | .m0 0 :: S => some (0, S)
  | .two u :: .m0 0 :: S => some (u, S)
  | _ => none

theorem zs_spec : ∀ {S S' : List Sg} {u : Nat}, zs S = some (u, S') → flat S = List.replicate u 2 ++ 0 :: flat S'
  | .m0 0 :: S, _, _, h => by simp only [zs, Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl⟩ := h; rfl
  | .two u :: .m0 0 :: S, _, _, h => by
    simp only [zs, Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl⟩ := h
    simp [flat, Sg.gs]

/-- The views of the word's end that a collision on a gap of 1 reads, with its parameter and the rest of the word:
0 `1, 2n+1` (more word behind), 1 `1, 2n+2` (all of the word), 2 `3`, 3 `2n+5` (more behind), 4 `2`, 5 `2n+4` (all of
the word). -/
def wv : List Nat → Option (Nat × Nat × List Nat)
  | 1 :: y :: V =>
    if y % 2 = 1 then some (0, (y - 1) / 2, V)
    else if V = [] ∧ 2 ≤ y then some (1, (y - 2) / 2, []) else none
  | b :: V =>
    if b = 3 then some (2, 0, V)
    else if b % 2 = 1 ∧ 5 ≤ b then some (3, (b - 5) / 2, V)
    else if V = [] ∧ b = 2 then some (4, 0, [])
    else if V = [] ∧ b % 2 = 0 ∧ 4 ≤ b then some (5, (b - 4) / 2, [])
    else none
  | [] => none

/-- The blocks of a view. -/
def wpre : Nat → Nat → List Nat
  | 0, n => [1, 2 * n + 1]
  | 1, n => [1, 2 * n + 2]
  | 2, _ => [3]
  | 3, n => [2 * n + 5]
  | 4, _ => [2]
  | _, n => [2 * n + 4]

theorem wv_spec {W V : List Nat} {k n : Nat} (h : wv W = some (k, n, V)) :
    W = wpre k n ++ V ∧ k ≤ 5 ∧ (k = 1 ∨ k = 4 ∨ k = 5 → V = []) := by
  unfold wv at h
  split at h
  · rename_i y V0
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl, rfl⟩ := h
      refine ⟨?_, by omega, by omega⟩
      simp only [wpre, List.cons_append, List.nil_append, List.cons.injEq, and_true, true_and]; omega
    · split at h
      · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl, rfl⟩ := h
        rename_i _ hc
        obtain ⟨rfl, _⟩ := hc
        refine ⟨?_, by omega, fun _ => rfl⟩
        simp only [wpre, List.cons_append, List.nil_append, List.cons.injEq, and_true, true_and]; omega
      · cases h
  · rename_i b V0 hne
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl, rfl⟩ := h
      rename_i hb; subst hb; exact ⟨rfl, by omega, by omega⟩
    · split at h
      · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl, rfl⟩ := h
        refine ⟨?_, by omega, by omega⟩
        simp only [wpre, List.cons_append, List.nil_append, List.cons.injEq, and_true]; omega
      · split at h
        · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl, rfl⟩ := h
          rename_i _ _ hc; obtain ⟨rfl, rfl⟩ := hc; exact ⟨rfl, by omega, fun _ => rfl⟩
        · split at h
          · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl, rfl⟩ := h
            rename_i _ _ _ hc; obtain ⟨rfl, _⟩ := hc
            refine ⟨?_, by omega, fun _ => rfl⟩
            simp only [wpre, List.cons_append, List.nil_append, List.cons.injEq, and_true]; omega
          · cases h
  · cases h

/-- The collisions on a gap of 1 that read the word, by view. -/
def xwk (p k s n : Nat) (S : List Sg) : Option Res :=
  match p, k with
  | 0, 0 => xg01A s n S
  | 0, 1 => xg01B s n S
  | 0, 2 => xg01C s n S
  | 0, 3 => xg01D s n S
  | 0, 4 => xg01E s n S
  | 0, 5 => xg01F s n S
  | 1, 0 => xg11A s n S
  | 1, 1 => xg11B s n S
  | 1, 2 => xg11C s n S
  | 1, 3 => xg11D s n S
  | 1, 4 => xg11E s n S
  | 1, 5 => xg11F s n S
  | _, _ => none

/-- The collisions on a gap of 0 (they do not read the word). -/
def xg0 (p s : Nat) (S : List Sg) : Option Res :=
  match p with
  | 0 => xg00 s S
  | _ => xg10 s S

/-- The collisions with a second gap 0 behind the colliding one, `2v + r` gaps of 2 between. -/
def xzz (p g r s v : Nat) (S : List Sg) : Option Res :=
  match p, g, r with
  | 0, 0, 0 => xz000 s v S
  | 0, 0, 1 => xz001 s v S
  | 0, 1, 0 => xz010 s v S
  | 0, 1, 1 => xz011 s v S
  | 1, 0, 0 => xz100 s v S
  | 1, 0, 1 => xz101 s v S
  | 1, 1, 0 => xz110 s v S
  | 1, 1, 1 => xz111 s v S
  | _, _, _ => none

/-- A collision: `2s + p` gaps of 2, the misaligned gap `g ≤ 1`, then the runs `S`, the word `W` after its double
step. -/
def xc (s p g : Nat) (W : List Nat) (S : List Sg) : Option AC :=
  match zs S with
  | some (u, S') => (xzz p g (u % 2) s (u / 2) S').map (res W)
  | none =>
    if g = 0 then (xg0 p s S).map (res W)
    else match wv W with
      | some (k, n, V) => (xwk p k s n S).map (res V)
      | none => none

theorem xc_sound (s p g : Nat) (W : List Nat) (S : List Sg) {c' : AC} (hp : p < 2) (hg : g ≤ 1)
    (h : xc s p g W S = some c') :
    ∃ n, 1 ≤ n ∧ steps n (zc (wl W) (List.replicate (2 * s + p) 2 ++ g :: flat S)) = some c'.enc := by
  unfold xc at h
  cases ez : zs S with
  | some r =>
    obtain ⟨u, S'⟩ := r
    rw [ez] at h
    simp only at h
    rw [zs_spec ez]
    cases er : xzz p g (u % 2) s (u / 2) S' with
    | none => rw [er] at h; cases h
    | some r =>
      obtain ⟨C, a', G', j⟩ := r
      rw [er] at h; simp only [Option.map_some, Option.some.injEq] at h; subst h
      rw [← qx_res]
      have hu : u = 2 * (u / 2) + u % 2 := (Nat.div_add_mod u 2).symm
      have hr : u % 2 < 2 := Nat.mod_lt _ (by decide)
      generalize u / 2 = v at er hu
      generalize u % 2 = r at er hu hr
      subst hu
      obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
      all_goals obtain rfl | rfl : g = 0 ∨ g = 1 := by omega
      all_goals obtain rfl | rfl : r = 0 ∨ r = 1 := by omega
      all_goals simp only [xzz] at er
      · exact xz000_sound _ _ _ er _
      · exact xz001_sound _ _ _ er _
      · exact xz010_sound _ _ _ er _
      · exact xz011_sound _ _ _ er _
      · exact xz100_sound _ _ _ er _
      · exact xz101_sound _ _ _ er _
      · exact xz110_sound _ _ _ er _
      · exact xz111_sound _ _ _ er _
  | none =>
    rw [ez] at h
    simp only at h
    by_cases hg0 : g = 0
    · subst hg0
      rw [ite_t rfl] at h
      cases er : xg0 p s S with
      | none => rw [er] at h; cases h
      | some r =>
        obtain ⟨C, a', G', j⟩ := r
        rw [er] at h; simp only [Option.map_some, Option.some.injEq] at h; subst h
        rw [← qx_res]
        obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
        · exact xg00_sound _ _ er _
        · exact xg10_sound _ _ er _
    · rw [ite_f hg0] at h
      obtain rfl : g = 1 := by omega
      cases ew : wv W with
      | none => rw [ew] at h; cases h
      | some r =>
        obtain ⟨k, n, V⟩ := r
        rw [ew] at h
        simp only at h
        obtain ⟨hW, hk, hV⟩ := wv_spec ew
        subst hW
        cases er : xwk p k s n S with
        | none => rw [er] at h; cases h
        | some r =>
          obtain ⟨C, a', G', j⟩ := r
          rw [er] at h; simp only [Option.map_some, Option.some.injEq] at h; subst h
          rw [← qx_res, wl_append]
          obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
          all_goals rcases (by omega : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5) with
            rfl | rfl | rfl | rfl | rfl | rfl
          all_goals simp only [xwk] at er
          · exact xg01A_sound _ _ _ er _
          · obtain rfl := hV (by omega); exact xg01B_sound _ _ _ er
          · exact xg01C_sound _ _ _ er _
          · exact xg01D_sound _ _ _ er _
          · obtain rfl := hV (by omega); exact xg01E_sound _ _ _ er
          · obtain rfl := hV (by omega); exact xg01F_sound _ _ _ er
          · exact xg11A_sound _ _ _ er _
          · obtain rfl := hV (by omega); exact xg11B_sound _ _ _ er
          · exact xg11C_sound _ _ _ er _
          · exact xg11D_sound _ _ _ er _
          · obtain rfl := hV (by omega); exact xg11E_sound _ _ _ er
          · obtain rfl := hV (by omega); exact xg11F_sound _ _ _ er

/-- The irregular steps that `astep` leaves out: the anomaly with a one-unit counter, the anomaly inside the word,
and the collisions. -/
def xstep (c : AC) : Option AC :=
  match c.W with
  | x :: y :: V =>
    if x = 1 ∧ V = [] then
      (if y % 2 = 0 ∧ 2 ≤ y ∧ c.a = 1 then xanu ((y - 2) / 2) (rl c.G) else none)
    else if x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ y ∧ 1 ≤ c.a then
      some ⟨List.replicate ((x - 2) / 2) 1 ++ (y + 2) :: V, 1, (3 * (c.a - 1)) :: c.G⟩
    else if wshape (x :: y :: V) = true ∧ c.a = 1 then
      match lead2 c.G with
      | (t, h :: G0) => if h ≤ 1 then xc (t / 2) (t % 2) h (phi (phi (x :: y :: V))) (rl G0) else none
      | (_, []) => none
    else none
  | _ => none

theorem xstep_sound (c c' : AC) (h : xstep c = some c') : ∃ n, 1 ≤ n ∧ steps n c.enc = some c'.enc := by
  obtain ⟨W, a, G⟩ := c
  simp only [AC.enc]
  rcases W with _ | ⟨x, _ | ⟨y, V⟩⟩
  · simp [xstep] at h
  · simp [xstep] at h
  simp only [xstep] at h
  by_cases h1 : x = 1 ∧ V = []
  · rw [ite_t h1] at h
    obtain ⟨rfl, rfl⟩ := h1
    by_cases hc : y % 2 = 0 ∧ 2 ≤ y ∧ a = 1
    · rw [ite_t hc] at h
      obtain ⟨c0, rfl⟩ : ∃ c0, y = 2 * c0 + 2 := ⟨(y - 2) / 2, by omega⟩
      obtain rfl : a = 1 := hc.2.2
      have e := xanu_sound _ _ h
      rw [show (2 * c0 + 2 - 2) / 2 = c0 by omega, flat_rl] at e
      exact e
    · rw [ite_f hc] at h; cases h
  rw [ite_f h1] at h
  by_cases h2 : x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ y ∧ 1 ≤ a
  · rw [ite_t h2] at h; cases h
    obtain ⟨c0, rfl⟩ : ∃ c0, x = 2 * c0 + 2 := ⟨(x - 2) / 2, by omega⟩
    rw [show (2 * c0 + 2 - 2) / 2 = c0 by omega]
    exact inner_step c0 a y V G h2.2.2.1 h2.2.2.2
  rw [ite_f h2] at h
  by_cases h3 : wshape (x :: y :: V) = true ∧ a = 1
  · rw [ite_t h3] at h
    obtain ⟨hw, rfl⟩ := h3
    have hne : phi (phi (x :: y :: V)) ≠ [] := phi_ne_nil _ (phi_ne_nil _ (wshape_ne_nil hw))
    cases e : lead2 G with
    | mk t R =>
      rw [e] at h
      cases R with
      | nil => simp at h
      | cons hh G0 =>
        simp only at h
        have hG : G = List.replicate t 2 ++ hh :: G0 := by
          have hs := lead2_spec G
          rw [e] at hs
          exact hs
        subst hG
        have wp := wphase (x :: y :: V) hw (gl (List.replicate t 2 ++ hh :: G0))
        by_cases hh1 : hh ≤ 1
        · rw [ite_t hh1] at h
          have hz := xc_sound _ _ _ _ _ (Nat.mod_lt t (by decide)) hh1 h
          have ht : 2 * (t / 2) + t % 2 = t := Nat.div_add_mod t 2
          rw [flat_rl, ht] at hz
          obtain ⟨n, hn, hz⟩ := hz
          obtain ⟨m, hm, wp⟩ := wp
          exact ⟨m + n, by omega, steps_seq trans wp hz⟩
        · rw [ite_f hh1] at h; cases h
  · rw [ite_f h3] at h; cases h

/-- `astep` where it applies, the rules above elsewhere. -/
def bstep (c : AC) : Option AC :=
  match astep c with
  | some c' => some c'
  | none => xstep c

theorem bstep_sound (c c' : AC) (h : bstep c = some c') : ∃ n, 1 ≤ n ∧ steps n c.enc = some c'.enc := by
  unfold bstep at h
  cases e : astep c with
  | some c1 =>
    obtain ⟨n, hn, hs⟩ := astep_sound c c1 e
    rw [e] at h; cases h
    exact ⟨n, by omega, hs⟩
  | none => rw [e] at h; exact xstep_sound c c' h

/-- `k` steps of `bstep`. -/
def brun : Nat → AC → Option AC
  | 0, c => some c
  | k + 1, c => (bstep c).bind (brun k)

theorem brun_adv : ∀ (k : Nat) (c c' : AC), brun k c = some c' → ∃ n, k ≤ n ∧ steps n c.enc = some c'.enc
  | 0, c, c', h => by cases h; exact ⟨0, Nat.le_refl _, rfl⟩
  | k + 1, c, c', h => by
    simp only [brun] at h
    cases h1 : bstep c with
    | none => rw [h1] at h; cases h
    | some c1 =>
      rw [h1] at h
      obtain ⟨n, hn, hs⟩ := bstep_sound c c1 h1
      obtain ⟨m, hm, hs'⟩ := brun_adv k c1 c' h
      exact ⟨n + m, by omega, steps_seq trans hs hs'⟩

/-- **The closed-form reduction**: if `bstep` can be applied for ever from the configuration at step 27, the
machine never halts from blank tape. -/
theorem not_halts_of_brun (h : ∀ k, (brun k start).isSome) : ¬ HaltsFromBlank := by
  apply not_halts_of_forall
  intro n
  have hk := h n
  cases e : brun n start with
  | none => rw [e] at hk; cases hk
  | some c =>
    obtain ⟨m, hm, hs⟩ := brun_adv n start c e
    have h3 := steps_seq trans start_reached hs
    have e2 : 27 + m = n + (27 + m - n) := by omega
    rw [e2] at h3
    exact steps_le trans h3

/-- The run of `bstep` as a loop (for compiled evaluation): the number of steps left when it fails, 0 if all
succeed. -/
def brunN : Nat → AC → Nat
  | 0, _ => 0
  | k + 1, c => match bstep c with
    | some c' => brunN k c'
    | none => k + 1

theorem brunN_sound : ∀ (k : Nat) (c : AC), brunN k c = 0 → (brun k c).isSome
  | 0, _, _ => rfl
  | k + 1, c, h => by
    simp only [brunN] at h
    simp only [brun]
    cases e : bstep c with
    | none => rw [e] at h; cases h
    | some c' => rw [e] at h; exact brunN_sound k c' h

end @@NS@@
