import XMap

/-!
# Halting needs a lost race: @@M@@

Generated by `py/gen_xmap2.py` in the folder of 1RB0RF_1LC1RE_0LD0LC_1RD0RB_1RA0RB_0LC---; do not edit by hand.

The race invariant of the sisters (XRace.lean of 1RB0RF_1LC1RE_0LD0LC_1RD0RB_1RA0RB_0RB---) fails here: in the run
from blank tape this machine starts an anomaly four times while a misaligned gap is still pending, and goes on.  The
invariant `Inv` therefore allows **two** misaligned gaps (lengths not `= 2 mod 3`): a valid word, a positive low part,
`nmis G ≤ 2`.  With two gaps pending a collision can meet the second one, and the case split of `xleaves2.py` covers
that, including the word's end where the collision reads it.  The result:

* `inv_step`: from a configuration with `Inv`, `bstep` is defined and keeps `Inv`, unless the configuration is a
  *lost race*: an anomaly comes next while two misaligned gaps are pending (or, for the anomaly with a one-unit
  counter, one), or a collision meets a gap 0 in one of four halting patterns `hz` (these halt: the machine reads
  F1).  No collision case adds a misaligned gap (`xg…_inv`, `xz…_inv`).
* `not_halts_of_races`: if no configuration of the orbit of `bstep` from the start is a lost race, the machine
  never halts from blank tape.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxHeartbeats 0

namespace @@NS@@

open TM

/-! ## Words and gaps -/

/-- A valid word (last block first) with an odd last block, or a single even block: the first block (the last of
the list) even and at least 2, the others odd. -/
def goodW : List Nat → Prop
  | [] => False
  | [x] => x % 2 = 0 ∧ 2 ≤ x
  | b :: x :: W => b % 2 = 1 ∧ goodW (x :: W)

/-- A valid word whose last block may also be even. -/
def goodH : List Nat → Prop
  | [] => False
  | [x] => x % 2 = 0 ∧ 2 ≤ x
  | x :: y :: V => 1 ≤ x ∧ goodW (y :: V)

/-- The invariant: a valid word, a positive low part, at most two misaligned gaps. -/
def Inv (c : AC) : Prop := goodH c.W ∧ 1 ≤ c.a ∧ nmis c.G ≤ 2

/-- An anomaly comes next: the word is one block, a block and a single 1, or its last block is even. -/
def ended : List Nat → Bool
  | [_] => true
  | x :: _ :: V => (x == 1 && V.isEmpty) || x % 2 == 0
  | [] => false

/-- The word `[1, x]` (the one-unit anomaly comes next when the counter is one unit). -/
def oneW : List Nat → Bool
  | [1, _] => true
  | _ => false

@@HZ@@
/-- A collision that halts: after `t` gaps of 2 the gap `h ≤ 1`, then `u` gaps of 2 and a gap 0, in one of the
patterns of `hz`. -/
def hcoll (G : List Nat) : Bool :=
  match lead2 G with
  | (t, h :: G0) => decide (h ≤ 1) && (match zs (rl G0) with
      | some (u, _) => hz (t % 2) h (u % 2) (u / 2)
      | none => false)
  | (_, []) => false

/-- A lost race: an anomaly comes next while two misaligned gaps are pending (it would make a third), or the
anomaly with a one-unit counter while one is pending, or a collision of `hcoll`. -/
def lost (c : AC) : Prop :=
  (ended c.W = true ∧ 2 ≤ nmis c.G) ∨ (oneW c.W = true ∧ c.a = 1 ∧ 1 ≤ nmis c.G) ∨
    (c.a = 1 ∧ hcoll c.G = true)

theorem nmis_twos (t : Nat) (R : List Nat) : nmis (List.replicate t 2 ++ R) = nmis R := by
  rw [nmis_append, nmis_rep]; simp

theorem nmis_lead2 (G : List Nat) : nmis G = nmis (lead2 G).2 := by
  conv => lhs; rw [lead2_spec G]
  exact nmis_twos _ _

theorem goodW_cons_odd {b : Nat} {W : List Nat} (hb : b % 2 = 1) (hW : goodW W) : goodW (b :: W) := by
  match W, hW with
  | x :: W', hW => exact ⟨hb, hW⟩

theorem goodW_append {C W : List Nat} (hC : ∀ b ∈ C, b % 2 = 1) (hW : goodW W) : goodW (C ++ W) := by
  induction C with
  | nil => exact hW
  | cons b C ih =>
    exact goodW_cons_odd (hC b (List.mem_cons_self ..)) (ih fun x hx => hC x (List.mem_cons_of_mem _ hx))

theorem ones_odd (n : Nat) : ∀ b ∈ List.replicate n 1, b % 2 = 1 := by
  intro b hb; rw [List.eq_of_mem_replicate hb]

/-- The second block keeps its parity under `+ 2`. -/
theorem goodW_add2 {x : Nat} {W : List Nat} (h : goodW (x :: W)) : goodW ((x + 2) :: W) := by
  match W, h with
  | [], h => exact ⟨by have := h.1; omega, by omega⟩
  | y :: W', h => exact ⟨by have := h.1; omega, h.2⟩

theorem goodW_phi {W : List Nat} (h : goodW W) : goodW (phi W) := by
  match W, h with
  | [x], h => exact h
  | b :: x :: W', h =>
    simp only [phi]
    exact goodW_append (ones_odd _) (goodW_add2 h.2)

theorem goodW_bump {W : List Nat} (h : goodW W) : goodW (bump W) := by
  match W, h with
  | b :: W', h => exact goodW_add2 h

theorem goodW_addh {W : List Nat} {j : Nat} (h : goodW W) (hj : j % 2 = 0) : goodW (addh j W) := by
  match W, h with
  | [x], h => exact ⟨by have := h.1; omega, by have := h.2; omega⟩
  | b :: y :: W', h => exact ⟨by have := h.1; omega, h.2⟩

theorem goodW_fresh {x : Nat} (_hx : x % 2 = 0 ∧ 2 ≤ x) : goodW (fresh x) :=
  goodW_append (ones_odd _) ⟨by decide, Nat.le_refl 2⟩

theorem goodW_pos : ∀ {y : Nat} {V : List Nat}, goodW (y :: V) → 1 ≤ y
  | _, [], h => by have := h.2; omega
  | _, _ :: _, h => by have := h.1; omega

theorem goodH_of_goodW : ∀ {W : List Nat}, goodW W → goodH W
  | [_], h => h
  | _ :: _ :: _, h => ⟨by have := h.1; omega, h.2⟩

theorem goodW_of_goodH {x y : Nat} {V : List Nat} (h : goodH (x :: y :: V)) (hx : x % 2 = 1) :
    goodW (x :: y :: V) := ⟨hx, h.2⟩

theorem goodH_hd1 {C W : List Nat} (hC : hd1 C) (hW : goodW W) : goodH (C ++ W) := by
  match C, hC with
  | [], _ => exact goodH_of_goodW hW
  | c :: C', hC =>
    have h2 : goodW (C' ++ W) := goodW_append hC.2 hW
    match e : C' ++ W, h2 with
    | y :: V, h2 => simp only [List.cons_append, e]; exact ⟨hC.1, h2⟩

theorem goodH_last2 (x : Nat) (C : List Nat) (hx : 1 ≤ x) (hC : ∀ b ∈ C, b % 2 = 1) : goodH (x :: (C ++ [2])) := by
  have h2 : goodW (C ++ [2]) := goodW_append hC ⟨rfl, Nat.le_refl 2⟩
  match e : C ++ [2], h2 with
  | y :: V, h2 => exact ⟨hx, h2⟩

/-- A word of at least two blocks with an odd last block, other than `[1, x]`, has one of the shapes of the regular
step. -/
theorem wshape_of_goodW {W : List Nat} (h : goodW W) (h1 : ∀ x, W ≠ [x]) (h2 : ∀ x, W ≠ [1, x]) :
    wshape W = true := by
  match W, h with
  | [x], _ => exact absurd rfl (h1 x)
  | b :: x :: V, h =>
    have hb := h.1
    simp only [wshape, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq]
    by_cases hb1 : b = 1
    · subst hb1
      cases V with
      | nil => exact absurd rfl (h2 x)
      | cons y V' =>
        right
        refine ⟨⟨rfl, ?_⟩, ?_⟩
        · exact h.2.1
        · simp
    · left; exact ⟨hb, by omega⟩

theorem goodW_of_wshape {W : List Nat} (h : goodH W) (hw : wshape W = true) : goodW W := by
  match W, h, hw with
  | b :: x :: V, h, hw =>
    simp only [wshape, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hw
    refine ⟨?_, h.2⟩
    rcases hw with ⟨hb, _⟩ | ⟨⟨rfl, _⟩, _⟩
    · exact hb
    · rfl

theorem coll_spec {s p g U : Nat} {C : List Nat} {a' d : Nat} (h : coll s p g U = some (C, a', d)) :
    1 ≤ a' ∧ ∀ b ∈ C, b % 2 = 1 := by
  unfold coll at h
  split at h <;> simp only [Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at h <;>
    obtain ⟨rfl, rfl, rfl⟩ := h <;>
    refine ⟨by omega, ?_⟩ <;> intro b hb <;>
    simp only [List.mem_cons, List.mem_replicate] at hb <;> omega

theorem nmis_sub3 {h : Nat} {G : List Nat} (h3 : 3 ≤ h) : nmis ((h - 3) :: G) = nmis (h :: G) := by
  simp only [nmis, show (h - 3) % 3 = h % 3 by omega]

/-! ## Run-length forms -/

def notTwo : List Sg → Bool
  | .two _ :: _ => false
  | _ => true

def notFive : List Sg → Bool
  | .five _ :: _ => false
  | _ => true

/-- A run-length form as `rl` makes it: maximal nonempty runs of 2s and of 5s. -/
def okS : List Sg → Bool
  | [] => true
  | .two n :: S => 0 < n && notTwo S && okS S
  | .five n :: S => 0 < n && notFive S && okS S
  | _ :: S => okS S

theorem okS_one (g : Nat) (S : List Sg) (hS : okS S = true) (h2 : g = 2 → notTwo S = true)
    (h5 : g = 5 → notFive S = true) : okS (one g S) = true := by
  unfold one
  by_cases e2 : g = 2
  · subst e2; simp [okS, h2 rfl, hS]
  · by_cases e5 : g = 5
    · subst e5; simp [okS, h5 rfl, hS]
    · simp only [e2, e5, if_false]
      split
      · simp [okS, hS]
      · split <;> simp [okS, hS]

theorem okS_push (g : Nat) : ∀ S : List Sg, okS S = true → okS (push g S) = true
  | .two n :: S, hS => by
    simp only [okS, Bool.and_eq_true, decide_eq_true_eq] at hS
    by_cases e : g = 2
    · subst e; simp [push, okS, hS.1.2, hS.2]
    · simp only [push, e, ite_false]
      exact okS_one g _ (by simp [okS, hS.1.1, hS.1.2, hS.2]) (fun h => absurd h e) (fun _ => rfl)
  | .five n :: S, hS => by
    simp only [okS, Bool.and_eq_true, decide_eq_true_eq] at hS
    by_cases e : g = 5
    · subst e; simp [push, okS, hS.1.2, hS.2]
    · simp only [push, e, ite_false]
      exact okS_one g _ (by simp [okS, hS.1.1, hS.1.2, hS.2]) (fun _ => rfl) (fun h => absurd h e)
  | .big q :: S, hS => okS_one g _ hS (fun _ => rfl) (fun _ => rfl)
  | .m0 q :: S, hS => okS_one g _ hS (fun _ => rfl) (fun _ => rfl)
  | .m1 q :: S, hS => okS_one g _ hS (fun _ => rfl) (fun _ => rfl)
  | [], _ => okS_one g _ rfl (fun _ => rfl) (fun _ => rfl)

theorem okS_rl : ∀ G : List Nat, okS (rl G) = true
  | [] => rfl
  | g :: G => okS_push g _ (okS_rl G)

theorem okS_tail : ∀ (x : Sg) (S : List Sg), okS (x :: S) = true → okS S = true
  | .two _, S, h => by simp only [okS, Bool.and_eq_true] at h; exact h.2
  | .five _, S, h => by simp only [okS, Bool.and_eq_true] at h; exact h.2
  | .big _, S, h => h
  | .m0 _, S, h => h
  | .m1 _, S, h => h

theorem zs_ok {S S' : List Sg} {u : Nat} (h : zs S = some (u, S')) (hS : okS S = true) : okS S' = true := by
  unfold zs at h
  split at h
  · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl⟩ := h; exact okS_tail _ _ hS
  · simp only [Option.some.injEq, Prod.mk.injEq] at h; obtain ⟨rfl, rfl⟩ := h
    exact okS_tail _ _ (okS_tail _ _ hS)
  · cases h

/-! ## The cases cover every run-length form and keep the invariant -/

@@GEN@@

/-! ## The dispatcher -/

theorem ne_nil_of_goodW {W : List Nat} (h : goodW W) : W ≠ [] := by
  intro e; subst e; exact h

theorem goodW_addj {j : Nat} {V : List Nat} (hj : j % 2 = 0) (h0 : V = [] → 2 ≤ j) (hV : V ≠ [] → goodW V) :
    goodW (addj j V) := by
  match V with
  | [] => exact ⟨hj, h0 rfl⟩
  | b :: V' =>
    have h := hV (by simp)
    match V', h with
    | [], h => exact ⟨by have := h.1; omega, by have := h.2; omega⟩
    | y :: W', h => exact ⟨by have := h.1; omega, h.2⟩

theorem goodH_res {V : List Nat} {C : List Nat} {a' : Nat} {G' : List Nat} {j : Nat} (hC : hd1 C) (hj : j % 2 = 0)
    (h0 : V = [] → 2 ≤ j) (hV : V ≠ [] → goodW V) : goodH (res V (C, a', G', j)).W :=
  goodH_hd1 hC (goodW_addj hj h0 hV)

theorem wv_total {W : List Nat} (h : goodW W) : (wv W).isSome = true := by
  match W, h with
  | [x], h =>
    have := h.1; have := h.2
    simp only [wv]
    by_cases e1 : x = 1
    · omega
    by_cases e3 : x = 3
    · omega
    simp only [e3, if_false]
    by_cases e5 : x % 2 = 1 ∧ 5 ≤ x
    · omega
    simp only [e5, if_false]
    by_cases e2 : x = 2
    · subst e2; rfl
    · have : ([] : List Nat) = [] ∧ x % 2 = 0 ∧ 4 ≤ x := ⟨rfl, by omega, by omega⟩
      simp [e2, this]
  | b :: y :: V, h =>
    have hb := h.1
    by_cases e1 : b = 1
    · subst e1
      simp only [wv]
      by_cases hy : y % 2 = 1
      · simp [hy]
      · have hg := h.2
        match V, hg with
        | [], hg => simp [hy, show 2 ≤ y by have := hg.2; omega]
        | z :: V', hg => have := hg.1; omega
    · have hwv : wv (b :: y :: V) = (if b = 3 then some (2, 0, y :: V)
          else if b % 2 = 1 ∧ 5 ≤ b then some (3, (b - 5) / 2, y :: V)
          else if y :: V = [] ∧ b = 2 then some (4, 0, [])
          else if y :: V = [] ∧ b % 2 = 0 ∧ 4 ≤ b then some (5, (b - 4) / 2, []) else none) := by
        simp only [wv]; split <;> simp_all
      rw [hwv]
      by_cases e3 : b = 3
      · simp [e3]
      · simp [e3, show b % 2 = 1 ∧ 5 ≤ b from ⟨hb, by omega⟩]

theorem wv_good {W V : List Nat} {k n : Nat} (hW : goodW W) (h : wv W = some (k, n, V)) :
    (k = 1 ∨ k = 4 ∨ k = 5) ∨ (V ≠ [] ∧ goodW V) := by
  obtain ⟨rfl, hk, hV⟩ := wv_spec h
  rcases (by omega : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5) with rfl | rfl | rfl | rfl | rfl | rfl
  · right
    match V, hW with
    | [], hW => have := hW.2.1; omega
    | z :: V', hW => exact ⟨by simp, hW.2.2⟩
  · left; omega
  · right
    match V, hW with
    | [], hW => have := hW.1; omega
    | z :: V', hW => exact ⟨by simp, hW.2⟩
  · right
    match V, hW with
    | [], hW => have := hW.1; omega
    | z :: V', hW => exact ⟨by simp, hW.2⟩
  · left; omega
  · left; omega

theorem nmis_zs {S S' : List Sg} {u : Nat} (h : zs S = some (u, S')) : nmis (flat S) = 1 + nmis (flat S') := by
  rw [zs_spec h, nmis_twos]; simp [nmis]

/-- **The collisions are total** outside the halting patterns, for a valid word and at most one more misaligned gap,
and they keep the invariant. -/
theorem xc_total_inv (s p g : Nat) (W : List Nat) (S : List Sg) (hp : p < 2) (hg : g ≤ 1) (hok : okS S = true)
    (hn : nmis (flat S) ≤ 1) (hW : goodW W)
    (hh : (match zs S with | some (u, _) => hz p g (u % 2) (u / 2) | none => false) = false) :
    ∃ c', xc s p g W S = some c' ∧ goodH c'.W ∧ 1 ≤ c'.a ∧ nmis c'.G ≤ 2 := by
  have hWne : W ≠ [] := ne_nil_of_goodW hW
  have hWV : W ≠ [] → goodW W := fun _ => hW
  unfold xc
  cases ez : zs S with
  | some r =>
    obtain ⟨u, S'⟩ := r
    rw [ez] at hh
    simp only at hh ⊢
    have h0 : nmis (flat S') = 0 := by have := nmis_zs ez; omega
    have hok' := zs_ok ez hok
    have key : ∀ r, xzz p g (u % 2) s (u / 2) S' = some r → ∃ c', Option.map (res W) (some r) = some c' ∧
        goodH c'.W ∧ 1 ≤ c'.a ∧ nmis c'.G ≤ 2 := by
      intro r er
      obtain ⟨C, a', G', j⟩ := r
      have hr : u % 2 < 2 := Nat.mod_lt _ (by decide)
      generalize u / 2 = v at er hh
      generalize u % 2 = r at er hh hr
      have hi : 1 ≤ a' ∧ hd1 C ∧ j % 2 = 0 ∧ nmis G' ≤ 2 + nmis (flat S') := by
        obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
        all_goals obtain rfl | rfl : g = 0 ∨ g = 1 := by omega
        all_goals obtain rfl | rfl : r = 0 ∨ r = 1 := by omega
        all_goals simp only [xzz] at er
        · have := xz000_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xz001_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xz010_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xz011_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xz100_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xz101_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xz110_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xz111_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
      exact ⟨_, rfl, goodH_res hi.2.1 hi.2.2.1 (fun e => absurd e hWne) hWV, hi.1, by
        show nmis G' ≤ 2; omega⟩
    have hs : (xzz p g (u % 2) s (u / 2) S').isSome = true := by
      have hr : u % 2 < 2 := Nat.mod_lt _ (by decide)
      generalize u / 2 = v at hh ⊢
      generalize u % 2 = r at hh hr ⊢
      obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
      all_goals obtain rfl | rfl : g = 0 ∨ g = 1 := by omega
      all_goals obtain rfl | rfl : r = 0 ∨ r = 1 := by omega
      · exact xz000_total _ _ _ hok' h0 hh
      · exact xz001_total _ _ _ hok' h0 hh
      · exact xz010_total _ _ _ hok' h0 hh
      · exact xz011_total _ _ _ hok' h0 hh
      · exact xz100_total _ _ _ hok' h0 hh
      · exact xz101_total _ _ _ hok' h0 hh
      · exact xz110_total _ _ _ hok' h0 hh
      · exact xz111_total _ _ _ hok' h0 hh
    obtain ⟨r, er⟩ := Option.isSome_iff_exists.mp hs
    rw [er]
    exact key r er
  | none =>
    simp only
    by_cases hg0 : g = 0
    · subst hg0
      rw [ite_t rfl]
      have hs : (xg0 p s S).isSome = true := by
        obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
        · exact xg00_total _ _ hok hn ez
        · exact xg10_total _ _ hok hn ez
      obtain ⟨⟨C, a', G', j⟩, er⟩ := Option.isSome_iff_exists.mp hs
      rw [er]
      have hi : 1 ≤ a' ∧ hd1 C ∧ j % 2 = 0 ∧ nmis G' ≤ 1 + nmis (flat S) := by
        obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
        · have := xg00_inv _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
        · have := xg10_inv _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.2⟩
      exact ⟨_, rfl, goodH_res hi.2.1 hi.2.2.1 (fun e => absurd e hWne) hWV, hi.1, by
        show nmis G' ≤ 2; omega⟩
    · rw [ite_f hg0]
      obtain rfl : g = 1 := by omega
      obtain ⟨⟨k, n, V⟩, ew⟩ := Option.isSome_iff_exists.mp (wv_total hW)
      rw [ew]
      simp only
      obtain ⟨_, hk, hV0⟩ := wv_spec ew
      have hgd := wv_good hW ew
      have hs : (xwk p k s n S).isSome = true := by
        obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
        all_goals rcases (by omega : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5) with
          rfl | rfl | rfl | rfl | rfl | rfl
        · exact xg01A_total _ _ _ hok hn ez
        · exact xg01B_total _ _ _ hok hn ez
        · exact xg01C_total _ _ _ hok hn ez
        · exact xg01D_total _ _ _ hok hn ez
        · exact xg01E_total _ _ _ hok hn ez
        · exact xg01F_total _ _ _ hok hn ez
        · exact xg11A_total _ _ _ hok hn ez
        · exact xg11B_total _ _ _ hok hn ez
        · exact xg11C_total _ _ _ hok hn ez
        · exact xg11D_total _ _ _ hok hn ez
        · exact xg11E_total _ _ _ hok hn ez
        · exact xg11F_total _ _ _ hok hn ez
      obtain ⟨⟨C, a', G', j⟩, er⟩ := Option.isSome_iff_exists.mp hs
      rw [er]
      have hi : 1 ≤ a' ∧ hd1 C ∧ j % 2 = 0 ∧ (k = 1 ∨ k = 4 ∨ k = 5 → 2 ≤ j) ∧ nmis G' ≤ 1 + nmis (flat S) := by
        obtain rfl | rfl : p = 0 ∨ p = 1 := by omega
        all_goals rcases (by omega : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5) with
          rfl | rfl | rfl | rfl | rfl | rfl
        all_goals simp only [xwk] at er
        all_goals first
          | (have := xg01A_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, by omega, this.2.2.2.2⟩)
          | (have := xg01B_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, fun _ => this.2.2.2.1, this.2.2.2.2⟩)
          | (have := xg01C_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, by omega, this.2.2.2.2⟩)
          | (have := xg01D_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, by omega, this.2.2.2.2⟩)
          | (have := xg01E_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, fun _ => this.2.2.2.1, this.2.2.2.2⟩)
          | (have := xg01F_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, fun _ => this.2.2.2.1, this.2.2.2.2⟩)
          | (have := xg11A_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, by omega, this.2.2.2.2⟩)
          | (have := xg11B_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, fun _ => this.2.2.2.1, this.2.2.2.2⟩)
          | (have := xg11C_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, by omega, this.2.2.2.2⟩)
          | (have := xg11D_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, by omega, this.2.2.2.2⟩)
          | (have := xg11E_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, fun _ => this.2.2.2.1, this.2.2.2.2⟩)
          | (have := xg11F_inv _ _ _ er; exact ⟨this.1, this.2.1, this.2.2.1, fun _ => this.2.2.2.1, this.2.2.2.2⟩)
      refine ⟨_, rfl, goodH_res hi.2.1 hi.2.2.1 ?_ ?_, hi.1, by show nmis G' ≤ 2; omega⟩
      · intro e; rcases hgd with hk' | ⟨hne, _⟩
        · exact hi.2.2.2.1 hk'
        · exact absurd e hne
      · intro e; rcases hgd with hk' | ⟨_, hg'⟩
        · exact absurd (hV0 hk') e
        · exact hg'

/-! ## The invariant is kept -/

theorem nmis_le_of_cons {g : Nat} {G : List Nat} {k : Nat} (h : nmis (g :: G) ≤ k + 1) (hg : g % 3 ≠ 2) :
    nmis G ≤ k := by
  simp only [nmis, if_neg hg] at h; omega

theorem nmis_new {g : Nat} {G : List Nat} (h : nmis G ≤ 1) : nmis (g :: G) ≤ 2 := by
  simp only [nmis]; split <;> omega

/-- The steps of `astep` keep the invariant (outside a lost race). -/
theorem astep_inv (c c' : AC) (hI : Inv c) (hl : ¬ lost c) (h : astep c = some c') : Inv c' := by
  obtain ⟨W, a, G⟩ := c
  obtain ⟨hW, ha, hG⟩ := hI
  simp only at hW ha hG
  simp only [lost, not_or, not_and, Nat.not_le] at hl
  obtain ⟨hl1, hl2, _⟩ := hl
  unfold astep at h
  split at h
  · rename_i x hWx
    simp only at hWx; subst hWx
    have h0 : nmis G ≤ 1 := by have := hl1 rfl; omega
    by_cases hc : x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ a
    · rw [ite_t hc] at h; cases h
      exact ⟨goodH_of_goodW (goodW_fresh ⟨hc.1, hc.2.1⟩), Nat.le_refl 1, nmis_new h0⟩
    · rw [ite_f hc] at h; cases h
  · rename_i x hWx
    simp only at hWx; subst hWx
    have h0 : nmis G ≤ 1 := by have := hl1 (by simp [ended]); omega
    by_cases hx : x % 2 = 0 ∧ 2 ≤ x
    · rw [ite_t hx] at h
      by_cases h2 : 2 ≤ a
      · rw [ite_t h2] at h; cases h
        exact ⟨goodH_of_goodW (goodW_cons_odd (by decide) (goodW_fresh hx)), Nat.le_refl 1, nmis_new h0⟩
      · rw [ite_f h2] at h; cases h
    · rw [ite_f hx] at h; cases h
  · rename_i hne1 hne2
    by_cases hw : wshape W = true
    · rw [ite_t hw] at h
      have gp := goodW_phi (goodW_phi (goodW_of_wshape hW hw))
      by_cases h2 : 2 ≤ a
      · rw [ite_t h2] at h; cases h
        refine ⟨goodH_of_goodW gp, Nat.le_refl 1, ?_⟩
        show nmis ((3 * (a - 2) + 2) :: G) ≤ 2
        simp only [nmis, show (3 * (a - 2) + 2) % 3 = 2 by omega, if_true]; omega
      · rw [ite_f h2] at h
        by_cases h1 : a = 1
        · rw [ite_t h1] at h
          have hs := nmis_lead2 G
          split at h
          · cases h; exact ⟨goodH_of_goodW gp, by (try dsimp only); omega, Nat.zero_le 2⟩
          · rename_i t hh G0 e
            have e2 := congrArg Prod.snd e
            simp only at e2
            rw [e2] at hs
            by_cases h3 : 3 ≤ hh
            · rw [ite_t h3] at h; cases h
              refine ⟨goodH_of_goodW gp, by (try dsimp only); omega, ?_⟩
              show nmis ((hh - 3) :: G0) ≤ 2
              rw [nmis_sub3 h3]; omega
            · rw [ite_f h3] at h
              by_cases hh1 : hh ≤ 1
              · rw [ite_t hh1] at h
                have h00 : nmis G0 ≤ 1 := by
                  have h01 : nmis (hh :: G0) ≤ 1 + 1 := by rw [← hs]; exact hG
                  exact nmis_le_of_cons (k := 1) h01 (by omega)
                have hs0 := nmis_lead2 G0
                split at h
                · rename_i C a' d hc e3; cases h
                  obtain ⟨ha', hC⟩ := coll_spec hc
                  exact ⟨goodH_of_goodW (goodW_append hC (goodW_bump gp)), ha', Nat.zero_le 2⟩
                · rename_i C a' d h' G' hc e3
                  by_cases h5 : 5 ≤ h'
                  · rw [ite_t h5] at h; cases h
                    obtain ⟨ha', hC⟩ := coll_spec hc
                    rw [e3] at hs0
                    refine ⟨goodH_of_goodW (goodW_append hC (goodW_bump gp)), ha', ?_⟩
                    show nmis ((h' - 5 + d) :: G') ≤ 2
                    simp only [nmis] at hs0 ⊢
                    split at hs0 <;> split <;> omega
                  · rw [ite_f h5] at h; cases h
                · cases h
              · rw [ite_f hh1] at h; cases h
        · rw [ite_f h1] at h; cases h
    · rw [ite_f hw] at h; cases h

/-- Where `astep` has no rule, `xstep` has one and it keeps the invariant (outside a lost race). -/
theorem xstep_inv (c : AC) (hI : Inv c) (hl : ¬ lost c) (hn : astep c = none) :
    ∃ c', xstep c = some c' ∧ Inv c' := by
  obtain ⟨W, a, G⟩ := c
  obtain ⟨hW, ha, hG⟩ := hI
  simp only at hW ha hG
  simp only [lost, not_or, not_and, Nat.not_le] at hl
  obtain ⟨hl1, hl2, hl3⟩ := hl
  unfold astep at hn
  split at hn
  · rename_i x hWx
    simp only at hWx; subst hWx
    have hx : x % 2 = 0 ∧ 2 ≤ x := hW
    rw [ite_t ⟨hx.1, hx.2, ha⟩] at hn; cases hn
  · rename_i y hWx
    simp only at hWx; subst hWx
    have hy : y % 2 = 0 ∧ 2 ≤ y := hW.2
    rw [ite_t hy] at hn
    have ha1 : a = 1 := by
      rcases Nat.lt_or_ge a 2 with h | h
      · omega
      · rw [ite_t h] at hn; cases hn
    subst ha1
    have h0 : nmis G = 0 := by have := hl2 rfl rfl; omega
    simp only [xstep]
    simp only [hy.1, hy.2, and_self, ite_true, if_true, true_and, and_true]
    obtain ⟨c', e⟩ := Option.isSome_iff_exists.mp (xanu_total ((y - 2) / 2) (rl G) (okS_rl G) (by rw [flat_rl]; exact h0))
    obtain ⟨g1, g2, g3⟩ := xanu_inv _ _ e
    rw [flat_rl, h0] at g3
    exact ⟨c', e, g1, g2, by omega⟩
  · rename_i hne1 hne2
    rcases W with _ | ⟨x, _ | ⟨y, V⟩⟩
    · exact absurd hW id
    · exact absurd rfl (hne1 x)
    have h1 : ¬ (x = 1 ∧ V = []) := by
      rintro ⟨rfl, rfl⟩; exact hne2 y rfl
    simp only [xstep]
    rw [ite_f h1]
    by_cases hx : x % 2 = 0
    · -- the anomaly inside the word
      have hy := goodW_pos hW.2
      have hx2 : 2 ≤ x := by have := hW.1; omega
      have h0 : nmis G ≤ 1 := by
        have := hl1 (by simp [ended, hx]); omega
      rw [ite_t ⟨hx, hx2, hy, ha⟩]
      refine ⟨_, rfl, ?_, Nat.le_refl 1, nmis_new h0⟩
      exact goodH_of_goodW (goodW_append (ones_odd _) (goodW_add2 hW.2))
    · have hx2 : ¬ (x % 2 = 0 ∧ 2 ≤ x ∧ 1 ≤ y ∧ 1 ≤ a) := fun h => hx h.1
      rw [ite_f hx2]
      have hWg : goodW (x :: y :: V) := goodW_of_goodH hW (by omega)
      have hw := wshape_of_goodW hWg (fun z e => by simp at e) (fun z e => by
        simp only [List.cons.injEq] at e; exact h1 ⟨e.1, e.2.2⟩)
      rw [ite_t hw] at hn
      have ha1 : a = 1 := by
        rcases Nat.lt_or_ge a 2 with h | h
        · omega
        · rw [ite_t h] at hn; cases hn
      subst ha1
      rw [ite_f (by omega : ¬ 2 ≤ 1), ite_t rfl] at hn
      rw [ite_t ⟨hw, rfl⟩]
      have hs := nmis_lead2 G
      have hc3 := hl3 rfl
      unfold hcoll at hc3
      cases e : lead2 G with
      | mk t R =>
        rw [e] at hn hs hc3
        cases R with
        | nil => simp at hn
        | cons hh G0 =>
          simp only at hn hs hc3 ⊢
          have hh1 : hh ≤ 1 := by
            have hne := lead2_head G hh G0 (by rw [e])
            rcases Nat.lt_or_ge hh 3 with h3 | h3
            · omega
            · rw [ite_t h3] at hn; cases hn
          rw [ite_t hh1]
          have h00 : nmis G0 ≤ 1 := by
            have h01 : nmis (hh :: G0) ≤ 1 + 1 := by rw [← hs]; exact hG
            exact nmis_le_of_cons (k := 1) h01 (by omega)
          have hz : (match zs (rl G0) with | some (u, _) => hz (t % 2) hh (u % 2) (u / 2) | none => false) = false := by
            simp only [hh1, decide_true, Bool.true_and] at hc3
            revert hc3; split <;> simp
          obtain ⟨c', e', g1, g2, g3⟩ := xc_total_inv (t / 2) (t % 2) hh (phi (phi (x :: y :: V))) (rl G0)
            (Nat.mod_lt _ (by decide)) hh1 (okS_rl G0) (by rw [flat_rl]; exact h00) (goodW_phi (goodW_phi hWg)) hz
          exact ⟨c', e', g1, g2, g3⟩

/-- **The invariant is kept** wherever the race is not lost. -/
theorem inv_step (c : AC) (hI : Inv c) (hl : ¬ lost c) : ∃ c', bstep c = some c' ∧ Inv c' := by
  unfold bstep
  cases e : astep c with
  | some c' => exact ⟨c', rfl, astep_inv c c' hI hl e⟩
  | none => exact xstep_inv c hI hl e

/-! ## Non-halting reduced to the races -/

theorem inv_start : Inv start := ⟨⟨Nat.le_refl 1, rfl, Nat.le_refl 2⟩, Nat.le_refl 1, Nat.zero_le 2⟩

/-- Along an orbit with no lost race, `bstep` is defined at every step and the invariant holds. -/
theorem brun_of_races (c : AC) (hI : Inv c) :
    ∀ k, (∀ j c', j < k → brun j c = some c' → ¬ lost c') → ∃ c', brun k c = some c' ∧ Inv c' := by
  intro k
  induction k generalizing c with
  | zero => intro _; exact ⟨c, rfl, hI⟩
  | succ k ih =>
    intro hno
    obtain ⟨c1, e1, hI1⟩ := inv_step c hI (hno 0 c (by omega) rfl)
    have hno' : ∀ j c', j < k → brun j c1 = some c' → ¬ lost c' := by
      intro j c' hj hr
      exact hno (j + 1) c' (by omega) (by simp only [brun, e1, Option.bind_some]; exact hr)
    obtain ⟨c', e', hI'⟩ := ih c1 hI1 hno'
    exact ⟨c', by simp only [brun, e1, Option.bind_some]; exact e', hI'⟩

/-- **Halting needs a lost race**: if no configuration on the orbit of the closed-form map from the first Q
configuration (step 27) is a lost race, the machine never halts from blank tape. -/
theorem not_halts_of_races (h : ∀ k c, brun k start = some c → ¬ lost c) : ¬ HaltsFromBlank := by
  apply not_halts_of_brun
  intro k
  obtain ⟨c, e, _⟩ := brun_of_races start inv_start k (fun j c' _ hr => h j c' hr)
  rw [e]; rfl

/-- The lost-race test as a Boolean (for compiled evaluation). -/
def lostB (c : AC) : Bool :=
  (ended c.W && decide (2 ≤ nmis c.G)) || (oneW c.W && c.a == 1 && decide (1 ≤ nmis c.G)) ||
    (c.a == 1 && hcoll c.G)

theorem lostB_iff (c : AC) : lostB c = true ↔ lost c := by
  simp only [lostB, lost, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, and_assoc, or_assoc]

/-- The first `k` steps of `bstep` from the start are defined and none is a lost race (for compiled evaluation). -/
def racesOK : Nat → AC → Bool
  | 0, _ => true
  | k + 1, c => !lostB c && (match bstep c with
    | some c' => racesOK k c'
    | none => false)

end @@NS@@
