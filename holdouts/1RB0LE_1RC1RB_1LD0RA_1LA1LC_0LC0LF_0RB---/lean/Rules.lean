namespace H67137

open TM

/-- B runs right over a run of 1s. -/
theorem b_run (n : Nat) (L R : Tape) :
    steps (n) ⟨L, rep (n) [true] (R), .B⟩ = some ⟨rep (n) [true] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .B⟩ = some ⟨app [] (app [true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 1) ⟨L, rep (n) [true] (R), .B⟩ = some ⟨rep (n) [true] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 1) (by omega) (h0)

/-- Rightward, A turns each pair `11` into `01` (6 steps a pair): a run of 2n ones becomes (01)^n. -/
theorem a_halve (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨cons false (cons true (L)), rep (n) [true, true] (R), .A⟩ = some ⟨cons false (cons true (rep (n) [true, false] (L))), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 6 ⟨app [false, true] L, app [true, true] R, .A⟩ = some ⟨app [false, true] (app [true, false] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨cons false (cons true (L)), rep (n) [true, true] (R), .A⟩ = some ⟨cons false (cons true (rep (n) [true, false] (L))), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 6) (by omega) (h0)

/-- The same conversion, carried by C. -/
theorem c_halve (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨cons true (L), rep (n) [true, true] (R), .C⟩ = some ⟨cons true (rep (n) [true, false] (L)), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 6 ⟨app [true] L, app [true, true] R, .C⟩ = some ⟨app [true] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨cons true (L), rep (n) [true, true] (R), .C⟩ = some ⟨cons true (rep (n) [true, false] (L)), R, .C⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 6) (by omega) (h0)

/-- Leftward, C turns each `01` back into `11` (2 steps a pair). -/
theorem c_double (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [true, false] (L), cons false (R), .C⟩ = some ⟨L, cons false (rep (n) [true, true] (R)), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [true, false] (L), cons false (R), .C⟩ = some ⟨L, cons false (rep (n) [true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- The same leftward conversion, carried by D. -/
theorem d_double (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [false, true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [true, true] (R)), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [false, true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [true, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- The only way to a halt: D on a 0 with three 1s to its left reaches F on a 1 (which halts) in 3 steps. -/
theorem halt_shape (L R : Tape) :
    steps (3) ⟨cons true (cons true (cons true (L))), cons false (R), .D⟩ = some ⟨L, cons true (cons false (cons false (cons true (R)))), .F⟩ := by
  have h0 : steps 3 ⟨cons true (cons true (cons true (L))), cons false (R), .D⟩ = some ⟨L, cons true (cons false (cons false (cons true (R)))), .F⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)

/-- F reading a 1 halts: with `halt_shape`, `1 1 1 D> 0` halts on the fourth step. -/
theorem halt_after_shape (L R : Tape) : step ⟨L, cons true R, .F⟩ = none := rfl

