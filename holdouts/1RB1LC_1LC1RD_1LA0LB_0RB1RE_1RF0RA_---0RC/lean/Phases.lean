import Pieces
import Norm

/-!
# 1RB1LC_1LC1RD_1LA0LB_0RB1RE_1RF0RA_---0RC: the frame map

Configurations (blank tape around, `S>` the head in state S on the next cell):
* `b`: `1^L B 10 10^j 1^R`
* `a`: `1^L 10^j 110 A 1^R`
* `c`: `1^L 0 C 0 10^j 1^R`
* `d`: `1^L A 01 10^j 1^R`
* `e`: `1^L 10^j B`
* `f`: `1^L 10^j 1101 B`

`next` sends each one to the next frame the machine reaches; `next_sound` proves every case for all parameters
(one symbolic run of `Pieces.lean` each, generated by `py/pieces.py`, glued by `tape_eq`).  Where `next` is `none`
the machine halts (`none_halts`).  The run from blank tape reaches `Ph.e 1 0` after 1 steps (`init_start`).
So the machine halts from blank tape iff the orbit of `Ph.e 1 0` under `next` reaches a phase where `next` is
`none` (`halts_iff`); `no_halt_phases` checks the first 100000000 phases by `native_decide`.
-/

namespace H8084

open TM

/-- `1^L B 10 10^j 1^R`. -/
def Frb (l j r : Nat) : Config := ⟨rep l [true] (blank), cons true (cons false (rep j [true, false] (rep r [true] (blank)))), .B⟩

/-- `1^L 10^j 110 A 1^R`. -/
def Fra (l j r : Nat) : Config := ⟨cons false (cons true (cons true (rep j [false, true] (rep l [true] (blank))))), rep r [true] (blank), .A⟩

/-- `1^L 0 C 0 10^j 1^R`. -/
def Frc (l j r : Nat) : Config := ⟨cons false (rep l [true] (blank)), cons false (rep j [true, false] (rep r [true] (blank))), .C⟩

/-- `1^L A 01 10^j 1^R`. -/
def Frd (l j r : Nat) : Config := ⟨rep l [true] (blank), cons false (cons true (rep j [true, false] (rep r [true] (blank)))), .A⟩

/-- `1^L 10^j B`. -/
def Fre (l j : Nat) : Config := ⟨rep j [false, true] (rep l [true] (blank)), blank, .B⟩

/-- `1^L 10^j 1101 B`. -/
def Frf (l j : Nat) : Config := ⟨cons true (cons false (cons true (cons true (rep j [false, true] (rep l [true] (blank)))))), blank, .B⟩

/-- A frame. -/
inductive Ph where
  | b (l j r : Nat)
  | a (l j r : Nat)
  | c (l j r : Nat)
  | d (l j r : Nat)
  | e (l j : Nat)
  | f (l j : Nat)
  deriving DecidableEq, Repr

def Ph.cfg : Ph → Config
  | .b l j r => Frb l j r
  | .a l j r => Fra l j r
  | .c l j r => Frc l j r
  | .d l j r => Frd l j r
  | .e l j => Fre l j
  | .f l j => Frf l j

/-- The frame map. -/
def next : Ph → Option Ph
  | .b l j 0 => some (.e (l) (j + 1))
  | .b l j 1 => some (.e (l) (j + 2))
  | .b l j 2 => none
  | .b l j 3 => some (.f (l) (j + 1))
  | .b l j (r + 4) => some (.a (l) (j + 1) (r + 1))
  | .a l j 0 => some (.f (l) (j))
  | .a 0 j (r + 1) => some (.d (0) (j + 1) (r + 3))
  | .a (l + 1) j (r + 1) => some (.b (l) (j) (r + 3))
  | .c l 0 r => some (.d (l) (0) (r))
  | .c l (j + 1) 0 => some (.d (l) (j) (1))
  | .c l (j + 1) (r + 1) => some (.d (l) (j + 1) (r + 1))
  | .d l 0 0 => some (.e (l + 1) (1))
  | .d l 0 1 => none
  | .d l 0 2 => some (.f (l + 1) (0))
  | .d l 0 (r + 3) => some (.a (l + 1) (0) (r + 1))
  | .d l 1 0 => none
  | .d l 1 1 => some (.c (l + 4) (0) (0))
  | .d l 1 2 => some (.b (l + 2) (0) (1))
  | .d l 1 (r + 3) => some (.b (l + 2) (1) (r + 1))
  | .d l 2 r => some (.c (l + 4) (0) (r))
  | .d l (j + 3) 0 => some (.c (l + 4) (j) (1))
  | .d l (j + 3) (r + 1) => some (.c (l + 4) (j + 1) (r + 1))
  | .e 0 0 => some (.d (0) (0) (1))
  | .e 0 (j + 1) => some (.d (0) (0) (2 * j + 3))
  | .e 1 0 => some (.d (0) (1) (1))
  | .e 1 (j + 1) => some (.d (0) (1) (2 * j + 3))
  | .e (l + 2) 0 => some (.b (l) (0) (1))
  | .e (l + 2) (j + 1) => some (.b (l) (0) (2 * j + 3))
  | .f l 0 => some (.b (l) (1) (1))
  | .f l (j + 1) => some (.e (l) (j + 4))

macro "piece" t:term:max : tactic =>
  `(tactic| focus
    simp only [next, Option.some.injEq] at *
    subst_vars
    simp only [Ph.cfg, Frb, Fra, Frc, Frd, Fre, Frf]
    refine ⟨_, ?_, steps_eq_of ($t) (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))⟩
    omega)

macro "piece2" t:term:max u:term:max : tactic =>
  `(tactic| focus
    simp only [next, Option.some.injEq] at *
    subst_vars
    simp only [Ph.cfg, Frb, Fra, Frc, Frd, Fre, Frf]
    refine ⟨_, ?_, steps_eq_of (steps_seq trans ($t) (steps_eq_of ($u) (cfg_eq (by tape_eq) (by tape_eq)) rfl))
      (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))⟩
    omega)

macro "hpiece" t:term:max : tactic =>
  `(tactic| focus
    simp only [Ph.cfg, Frb, Fra, Frc, Frd, Fre, Frf]
    exact ⟨_, _, steps_eq_of ($t) (cfg_eq (by tape_eq) (by tape_eq)) rfl, rfl⟩)

theorem next_sound : ∀ p p', next p = some p' → ∃ n, 0 < n ∧ steps n p.cfg = some p'.cfg
  | .b l j 0, _, h => by piece (pc_b0 j l)
  | .b l j 1, _, h => by piece (pc_b1 j l)
  | .b l j 2, _, h => by simp [next] at h
  | .b l j 3, _, h => by piece (pc_b3 j l)
  | .b l j (r + 4), _, h => by piece (pc_b4 j l r)
  | .a l j 0, _, h => by piece (pc_a0 j l)
  | .a 0 j (r + 1), _, h => by piece (pc_a1 j r)
  | .a (l + 1) j (r + 1), _, h => by piece (pc_a2 j l r)
  | .c l 0 r, _, h => by piece (pc_c0 l r)
  | .c l (j + 1) 0, _, h => by piece (pc_c1 j l)
  | .c l (j + 1) (r + 1), _, h => by piece (pc_c2 j l r)
  | .d l 0 0, _, h => by piece (pc_d0 l)
  | .d l 0 1, _, h => by simp [next] at h
  | .d l 0 2, _, h => by piece (pc_d2 l)
  | .d l 0 (r + 3), _, h => by piece (pc_d3 l r)
  | .d l 1 0, _, h => by simp [next] at h
  | .d l 1 1, _, h => by piece (pc_d5 l)
  | .d l 1 2, _, h => by piece (pc_d6 l)
  | .d l 1 (r + 3), _, h => by piece (pc_d7 l r)
  | .d l 2 r, _, h => by piece (pc_d8 l r)
  | .d l (j + 3) 0, _, h => by piece (pc_d9 j l)
  | .d l (j + 3) (r + 1), _, h => by piece (pc_d10 j l r)
  | .e 0 0, _, h => by piece pc_e0a
  | .e 0 (j + 1), _, h => by piece (pc_e0b j)
  | .e 1 0, _, h => by piece pc_e1a
  | .e 1 (j + 1), _, h => by piece (pc_e1b j)
  | .e (l + 2) 0, _, h => by piece (pc_e2a l)
  | .e (l + 2) (j + 1), _, h => by piece (pc_e2b j l)
  | .f l 0, _, h => by piece (pc_f0 l)
  | .f l (j + 1), _, h => by piece (pc_f1 j l)

/-- Where `next` is `none`, the machine halts. -/
theorem none_halts : ∀ p, next p = none → TM.Halts trans p.cfg
  | .b l j 0, h => by simp [next] at h
  | .b l j 1, h => by simp [next] at h
  | .b l j 2, h => by hpiece (pc_b2 j l)
  | .b l j 3, h => by simp [next] at h
  | .b l j (r + 4), h => by simp [next] at h
  | .a l j 0, h => by simp [next] at h
  | .a 0 j (r + 1), h => by simp [next] at h
  | .a (l + 1) j (r + 1), h => by simp [next] at h
  | .c l 0 r, h => by simp [next] at h
  | .c l (j + 1) 0, h => by simp [next] at h
  | .c l (j + 1) (r + 1), h => by simp [next] at h
  | .d l 0 0, h => by simp [next] at h
  | .d l 0 1, h => by hpiece (pc_d1 l)
  | .d l 0 2, h => by simp [next] at h
  | .d l 0 (r + 3), h => by simp [next] at h
  | .d l 1 0, h => by hpiece (pc_d4 l)
  | .d l 1 1, h => by simp [next] at h
  | .d l 1 2, h => by simp [next] at h
  | .d l 1 (r + 3), h => by simp [next] at h
  | .d l 2 r, h => by simp [next] at h
  | .d l (j + 3) 0, h => by simp [next] at h
  | .d l (j + 3) (r + 1), h => by simp [next] at h
  | .e 0 0, h => by simp [next] at h
  | .e 0 (j + 1), h => by simp [next] at h
  | .e 1 0, h => by simp [next] at h
  | .e 1 (j + 1), h => by simp [next] at h
  | .e (l + 2) 0, h => by simp [next] at h
  | .e (l + 2) (j + 1), h => by simp [next] at h
  | .f l 0, h => by simp [next] at h
  | .f l (j + 1), h => by simp [next] at h

/-- `k` steps of the frame map. -/
def iter : Nat → Ph → Option Ph
  | 0, p => some p
  | k + 1, p => (next p).bind (iter k)

theorem reach_iter : ∀ k p p', iter k p = some p' → ∃ n, k ≤ n ∧ steps n p.cfg = some p'.cfg
  | 0, p, p', h => by simp only [iter, Option.some.injEq] at h; subst h; exact ⟨0, Nat.le_refl 0, rfl⟩
  | k + 1, p, p', h => by
    simp only [iter] at h
    cases hp : next p with
    | none => simp [hp] at h
    | some q =>
      simp only [hp, Option.bind_some] at h
      obtain ⟨n1, p1, h1⟩ := next_sound p q hp
      obtain ⟨n2, p2, h2⟩ := reach_iter k q p' h
      exact ⟨n1 + n2, by omega, steps_seq trans h1 h2⟩

theorem iter_succ (k : Nat) (p p' : Ph) (h : iter k p = some p') : iter (k + 1) p = next p' := by
  induction k generalizing p with
  | zero => simp only [iter, Option.some.injEq] at h; subst h; simp [iter]
  | succ k ih =>
    simp only [iter] at h ⊢
    cases hp : next p with
    | none => simp [hp] at h
    | some q => simp only [hp, Option.bind_some] at h ⊢; exact ih q h

/-- The run from blank tape reaches the first frame. -/
theorem init_start : steps 1 init = some (Ph.e 1 0).cfg := by
  simp only [Ph.cfg, Frb, Fra, Frc, Frd, Fre, Frf]
  exact steps_eq_of pc_init (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))

/-- **The machine halts from blank tape if and only if the frame map, iterated from `Ph.e 1 0`, reaches a frame
where it is `none`.** -/
theorem halts_iff :
    HaltsFromBlank ↔ ∃ k p, iter k (Ph.e 1 0) = some p ∧ next p = none := by
  constructor
  · intro hh
    apply Classical.byContradiction
    intro hno
    have hall : ∀ k, ∃ p, iter k (Ph.e 1 0) = some p := by
      intro k
      induction k with
      | zero => exact ⟨_, rfl⟩
      | succ k ih =>
        obtain ⟨p, hp⟩ := ih
        rw [iter_succ k _ p hp]
        cases hn : next p with
        | some q => exact ⟨q, rfl⟩
        | none => exact absurd ⟨k, p, hp, hn⟩ hno
    apply TM.not_halts_of_forall trans _ hh
    apply TM.forall_of_unbounded trans (fun m => ∃ c', steps m init = some c')
    · intro n
      obtain ⟨p, hp⟩ := hall n
      obtain ⟨m, hm, h⟩ := reach_iter n _ p hp
      exact ⟨1 + m, by omega, p.cfg, steps_seq trans init_start h⟩
    · exact fun _ h => h
  · rintro ⟨k, p, h, hn⟩
    obtain ⟨n, -, h1⟩ := reach_iter k _ _ h
    obtain ⟨m, c', h2, h3⟩ := none_halts p hn
    exact ⟨1 + n + m, c', steps_seq trans (steps_seq trans init_start h1) h2, h3⟩

/-- `next` is defined `k` times in a row from `p`. -/
def okFor : Nat → Ph → Bool
  | 0, _ => true
  | k + 1, p => match next p with
    | none => false
    | some q => okFor k q

theorem okFor_sound : ∀ k p, okFor k p = true → ∀ j, j < k → ∀ q, iter j p = some q → next q ≠ none
  | 0, _, _, j, hj, _, _ => absurd hj (Nat.not_lt_zero j)
  | k + 1, p, h, j, hj, q, hi => by
    simp only [okFor] at h
    cases hp : next p with
    | none => simp [hp] at h
    | some r =>
      simp only [hp] at h
      cases j with
      | zero =>
        simp only [iter, Option.some.injEq] at hi; subst hi; simp [hp]
      | succ j =>
        simp only [iter, hp, Option.bind_some] at hi
        exact okFor_sound k r h j (by omega) q hi

/-- No halting frame among the first 100000000 frames of the run from blank tape. -/
theorem no_halt_phases : ∀ j, j < 100000000 → ∀ q, iter j (Ph.e 1 0) = some q → next q ≠ none :=
  okFor_sound _ _ (by native_decide)

end H8084
