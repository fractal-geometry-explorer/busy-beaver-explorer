/-- d(l, (j + 3), (r + 1)) reaches c(l + 4, j + 1, r + 1). -/
theorem pc_d10 (j l r : Nat) :
    steps (5) ⟨rep (l) [true] (blank), cons false (cons true (rep (j + 3) [true, false] (rep (r + 1) [true] (blank)))), .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (rep (l) [true] (blank)))))), cons false (rep (j + 1) [true, false] (rep (r + 1) [true] (blank))), .C⟩ := by
