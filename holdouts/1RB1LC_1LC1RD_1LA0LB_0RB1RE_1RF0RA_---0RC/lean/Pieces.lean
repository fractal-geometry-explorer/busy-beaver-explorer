/-- f(l, (j + 1)) reaches e(l, j + 4). -/
theorem pc_f1 (j l : Nat) :
    steps (10) ⟨cons true (cons false (cons true (cons true (rep (j + 1) [false, true] (rep (l) [true] (blank)))))), blank, .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (j + 1) [false, true] (rep (l) [true] (blank)))))))), blank, .B⟩ := by
  have h0 : steps 10 ⟨cons true (cons false (cons true (cons true (rep (j + 1) [false, true] (rep (l) [true] (blank)))))), blank, .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (rep (j + 1) [false, true] (rep (l) [true] (blank)))))))), blank, .B⟩ := rfl
