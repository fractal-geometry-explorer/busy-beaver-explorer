/-- The run from blank tape reaches the first frame. -/
theorem pc_init :
    steps (1) ⟨blank, blank, .A⟩ = some ⟨cons true (blank), blank, .B⟩ := by
  have h0 : steps 1 ⟨blank, blank, .A⟩ = some ⟨cons true (blank), blank, .B⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

