/-- d(l, (j + 3), 0) reaches c(l + 4, j, 1). -/
theorem pc_d9 (j l : Nat) :
    steps (5) ⟨rep (l) [true] (blank), cons false (cons true (rep (j + 3) [true, false] (blank))), .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (rep (l) [true] (blank)))))), cons false (rep (j + 1) [true, false] (blank)), .C⟩ := by
  have h0 : steps 5 ⟨rep (l) [true] (blank), cons false (cons true (rep (j + 3) [true, false] (blank))), .A⟩ = some ⟨cons false (cons true (cons true (cons true (cons true (rep (l) [true] (blank)))))), cons false (rep (j + 1) [true, false] (blank)), .C⟩ := rfl
