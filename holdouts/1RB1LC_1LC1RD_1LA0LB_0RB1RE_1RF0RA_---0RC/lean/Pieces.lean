/-- e((l + 2), (j + 1)) reaches b(l, 0, 2 * j + 3). -/
theorem pc_e2b (j l : Nat) :
    steps (2 * j + 4) ⟨rep (j + 1) [false, true] (rep (l + 2) [true] (blank)), blank, .B⟩ = some ⟨rep (l) [true] (blank), cons true (cons false (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .B⟩ := by
  have h0 : steps 1 ⟨rep (j + 1) [false, true] (rep (l + 2) [true] (blank)), blank, .B⟩ = some ⟨cons true (rep (j) [false, true] (rep (l + 2) [true] (blank))), cons false (cons true (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (j) [false, true] (rep (l + 2) [true] (blank))), cons false (cons true (blank)), .C⟩ = some ⟨rep (j) [true, false] (cons true (rep (l + 2) [true] (blank))), cons false (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (rep (j) [false, true] (rep (l + 2) [true] (blank))) = rep (j) [true, false] (cons true (rep (l + 2) [true] (blank))) from
      rep_rotate (j) [true] [false, true] [true, false] rfl (rep (l + 2) [true] (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((j) * 2) ⟨rep (j) [true, false] (cons true (rep (l + 2) [true] (blank))), cons false (cons true (blank)), .C⟩ = some ⟨cons true (rep (l + 2) [true] (blank)), cons false (rep (j) [true, true] (cons true (blank))), .C⟩ :=
    cross_l trans c2 (j) (cons true (rep (l + 2) [true] (blank))) (cons true (blank))
  have h3 : steps 3 ⟨cons true (rep (l + 2) [true] (blank)), cons false (rep (j) [true, true] (cons true (blank))), .C⟩ = some ⟨rep (l) [true] (blank), cons true (cons false (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .B⟩ := rfl
  exact steps_congr trans (a := 1 + (0 + ((j) * 2 + (3)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- f(l, 0) reaches b(l, 1, 1). -/
theorem pc_f0 (l : Nat) :
    steps (4) ⟨cons true (cons false (cons true (cons true (rep (l) [true] (blank))))), blank, .B⟩ = some ⟨rep (l) [true] (blank), cons true (cons false (cons true (cons false (cons true (blank))))), .B⟩ := by
  have h0 : steps 4 ⟨cons true (cons false (cons true (cons true (rep (l) [true] (blank))))), blank, .B⟩ = some ⟨rep (l) [true] (blank), cons true (cons false (cons true (cons false (cons true (blank))))), .B⟩ := rfl
