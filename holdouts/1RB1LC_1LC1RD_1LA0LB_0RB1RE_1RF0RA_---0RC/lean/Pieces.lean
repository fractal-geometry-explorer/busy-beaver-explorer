/-- e(0, 0) reaches d(0, 0, 1). -/
theorem pc_e0a :
    steps (2) ⟨blank, blank, .B⟩ = some ⟨blank, cons false (cons true (cons true (blank))), .A⟩ := by
  have h0 : steps 2 ⟨blank, blank, .B⟩ = some ⟨blank, cons false (cons true (cons true (blank))), .A⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- e(0, (j + 1)) reaches d(0, 0, 2 * j + 3). -/
theorem pc_e0b (j : Nat) :
    steps (2 * j + 4) ⟨rep (j + 1) [false, true] (blank), blank, .B⟩ = some ⟨blank, cons false (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .A⟩ := by
  have h0 : steps 1 ⟨rep (j + 1) [false, true] (blank), blank, .B⟩ = some ⟨cons true (rep (j) [false, true] (blank)), cons false (cons true (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (j) [false, true] (blank)), cons false (cons true (blank)), .C⟩ = some ⟨rep (j) [true, false] (cons true (blank)), cons false (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (rep (j) [false, true] (blank)) = rep (j) [true, false] (cons true (blank)) from
      rep_rotate (j) [true] [false, true] [true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((j) * 2) ⟨rep (j) [true, false] (cons true (blank)), cons false (cons true (blank)), .C⟩ = some ⟨cons true (blank), cons false (rep (j) [true, true] (cons true (blank))), .C⟩ :=
    cross_l trans c2 (j) (cons true (blank)) (cons true (blank))
  have h3 : steps 3 ⟨cons true (blank), cons false (rep (j) [true, true] (cons true (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .A⟩ := rfl
  exact steps_congr trans (a := 1 + (0 + ((j) * 2 + (3)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- e(1, 0) reaches d(0, 1, 1). -/
theorem pc_e1a :
    steps (4) ⟨cons true (blank), blank, .B⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (blank))))), .A⟩ := by
  have h0 : steps 4 ⟨cons true (blank), blank, .B⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (blank))))), .A⟩ := rfl
