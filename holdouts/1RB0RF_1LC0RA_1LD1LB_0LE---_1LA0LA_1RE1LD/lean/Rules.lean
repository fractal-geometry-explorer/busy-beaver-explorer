    cross_r trans c1 (q) (cons true (rep (p + 1) [true, false] (L))) (cons true (blank))
  have h2 : steps 3 ⟨rep (q) [true, false] (cons true (rep (p + 1) [true, false] (L))), cons true (blank), .B⟩ = some ⟨cons false (rep (q) [true, false] (cons true (rep (p + 1) [true, false] (L)))), cons true (cons true (blank)), .C⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (q) [true, false] (cons true (rep (p + 1) [true, false] (L)))), cons true (cons true (blank)), .C⟩ = some ⟨rep (q) [false, true] (cons false (cons true (rep (p + 1) [true, false] (L)))), cons true (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons false (rep (q) [true, false] (cons true (rep (p + 1) [true, false] (L)))) = rep (q) [false, true] (cons false (cons true (rep (p + 1) [true, false] (L)))) from
      rep_rotate (q) [false] [true, false] [false, true] rfl (cons true (rep (p + 1) [true, false] (L)))]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((q) * 2) ⟨rep (q) [false, true] (cons false (cons true (rep (p + 1) [true, false] (L)))), cons true (cons true (blank)), .C⟩ = some ⟨cons false (cons true (rep (p + 1) [true, false] (L))), cons true (rep (q) [true, true] (cons true (blank))), .C⟩ :=
    cross_l trans c4 (q) (cons false (cons true (rep (p + 1) [true, false] (L)))) (cons true (blank))
  have h5 : steps 9 ⟨cons false (cons true (rep (p + 1) [true, false] (L))), cons true (rep (q) [true, true] (cons true (blank))), .C⟩ = some ⟨cons true (rep (p) [true, false] (L)), cons true (cons false (cons true (cons true (rep (q) [true, true] (cons true (blank)))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The copies on the left are used up (none left): the head goes to the left end in state A. -/
theorem x_end0 (q : Nat) (R : Tape) :
    steps (6 * q + 15) ⟨cons true (cons true (blank)), cons true (rep (q + 1) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨blank, cons false (cons false (cons false (cons true (cons false (cons true (rep (q + 1) [false, true] (R))))))), .A⟩ := by
  have hn : 0 + ((q + 1) * 2 + (1 + (0 + ((q + 1) * 4 + (8))))) = 6 * q + 15 := by omega
  have h0 : steps 0 ⟨cons true (cons true (blank)), cons true (rep (q + 1) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨cons true (cons true (blank)), rep (q + 1) [true, false] (cons true (cons true (cons true (R)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (q + 1) [false, true] (cons true (cons true (R)))) = rep (q + 1) [true, false] (cons true (cons true (cons true (R)))) from
      rep_rotate (q + 1) [true] [false, true] [true, false] rfl (cons true (cons true (R)))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((q + 1) * 2) ⟨cons true (cons true (blank)), rep (q + 1) [true, false] (cons true (cons true (cons true (R)))), .B⟩ = some ⟨rep (q + 1) [true, false] (cons true (cons true (blank))), cons true (cons true (cons true (R))), .B⟩ :=
    cross_r trans c1 (q + 1) (cons true (cons true (blank))) (cons true (cons true (cons true (R))))
  have h2 : steps 1 ⟨rep (q + 1) [true, false] (cons true (cons true (blank))), cons true (cons true (cons true (R))), .B⟩ = some ⟨cons false (rep (q + 1) [true, false] (cons true (cons true (blank)))), cons true (cons true (R)), .A⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (q + 1) [true, false] (cons true (cons true (blank)))), cons true (cons true (R)), .A⟩ = some ⟨rep (q + 1) [false, true] (cons false (cons true (cons true (blank)))), cons true (cons true (R)), .A⟩ := by
    simp only [steps_zero, show cons false (rep (q + 1) [true, false] (cons true (cons true (blank)))) = rep (q + 1) [false, true] (cons false (cons true (cons true (blank)))) from
      rep_rotate (q + 1) [false] [true, false] [false, true] rfl (cons true (cons true (blank)))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true, true] R, .A⟩ = some ⟨L, app [true, true] (app [false, true] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((q + 1) * 4) ⟨rep (q + 1) [false, true] (cons false (cons true (cons true (blank)))), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons true (cons true (blank))), cons true (cons true (rep (q + 1) [false, true] (R))), .A⟩ :=
    cross_l trans c4 (q + 1) (cons false (cons true (cons true (blank)))) (R)
  have h5 : steps 8 ⟨cons false (cons true (cons true (blank))), cons true (cons true (rep (q + 1) [false, true] (R))), .A⟩ = some ⟨blank, cons false (cons false (cons false (cons true (cons false (cons true (rep (q + 1) [false, true] (R))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The same with one copy of `01` left over. -/
theorem x_end1 (q : Nat) (R : Tape) :
    steps (6 * q + 23) ⟨cons true (cons true (cons false (cons true (blank)))), cons true (rep (q + 1) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (q + 1) [false, true] (R))))))))), .A⟩ := by
  have hn : 0 + ((q + 1) * 2 + (1 + (0 + ((q + 1) * 4 + (16))))) = 6 * q + 23 := by omega
  have h0 : steps 0 ⟨cons true (cons true (cons false (cons true (blank)))), cons true (rep (q + 1) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (blank)))), rep (q + 1) [true, false] (cons true (cons true (cons true (R)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (q + 1) [false, true] (cons true (cons true (R)))) = rep (q + 1) [true, false] (cons true (cons true (cons true (R)))) from
      rep_rotate (q + 1) [true] [false, true] [true, false] rfl (cons true (cons true (R)))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((q + 1) * 2) ⟨cons true (cons true (cons false (cons true (blank)))), rep (q + 1) [true, false] (cons true (cons true (cons true (R)))), .B⟩ = some ⟨rep (q + 1) [true, false] (cons true (cons true (cons false (cons true (blank))))), cons true (cons true (cons true (R))), .B⟩ :=
    cross_r trans c1 (q + 1) (cons true (cons true (cons false (cons true (blank))))) (cons true (cons true (cons true (R))))
  have h2 : steps 1 ⟨rep (q + 1) [true, false] (cons true (cons true (cons false (cons true (blank))))), cons true (cons true (cons true (R))), .B⟩ = some ⟨cons false (rep (q + 1) [true, false] (cons true (cons true (cons false (cons true (blank)))))), cons true (cons true (R)), .A⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (q + 1) [true, false] (cons true (cons true (cons false (cons true (blank)))))), cons true (cons true (R)), .A⟩ = some ⟨rep (q + 1) [false, true] (cons false (cons true (cons true (cons false (cons true (blank)))))), cons true (cons true (R)), .A⟩ := by
    simp only [steps_zero, show cons false (rep (q + 1) [true, false] (cons true (cons true (cons false (cons true (blank)))))) = rep (q + 1) [false, true] (cons false (cons true (cons true (cons false (cons true (blank)))))) from
      rep_rotate (q + 1) [false] [true, false] [false, true] rfl (cons true (cons true (cons false (cons true (blank)))))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true, true] R, .A⟩ = some ⟨L, app [true, true] (app [false, true] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((q + 1) * 4) ⟨rep (q + 1) [false, true] (cons false (cons true (cons true (cons false (cons true (blank)))))), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (blank))))), cons true (cons true (rep (q + 1) [false, true] (R))), .A⟩ :=
    cross_l trans c4 (q + 1) (cons false (cons true (cons true (cons false (cons true (blank)))))) (R)
  have h5 : steps 16 ⟨cons false (cons true (cons true (cons false (cons true (blank))))), cons true (cons true (rep (q + 1) [false, true] (R))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (q + 1) [false, true] (R))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- No copies on the left and no ones on the right. -/
theorem x_end00 (q : Nat) :
    steps (4 * q + 15) ⟨cons true (cons true (blank)), cons true (rep (q + 1) [false, true] (blank)), .B⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (q + 1) [true, true] (cons true (blank))))))), .A⟩ := by
  have hn : 0 + ((q + 1) * 2 + (3 + (0 + ((q + 1) * 2 + (8))))) = 4 * q + 15 := by omega
  have h0 : steps 0 ⟨cons true (cons true (blank)), cons true (rep (q + 1) [false, true] (blank)), .B⟩ = some ⟨cons true (cons true (blank)), rep (q + 1) [true, false] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (q + 1) [false, true] (blank)) = rep (q + 1) [true, false] (cons true (blank)) from
      rep_rotate (q + 1) [true] [false, true] [true, false] rfl (blank)]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((q + 1) * 2) ⟨cons true (cons true (blank)), rep (q + 1) [true, false] (cons true (blank)), .B⟩ = some ⟨rep (q + 1) [true, false] (cons true (cons true (blank))), cons true (blank), .B⟩ :=
    cross_r trans c1 (q + 1) (cons true (cons true (blank))) (cons true (blank))
  have h2 : steps 3 ⟨rep (q + 1) [true, false] (cons true (cons true (blank))), cons true (blank), .B⟩ = some ⟨cons false (rep (q + 1) [true, false] (cons true (cons true (blank)))), cons true (cons true (blank)), .C⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (q + 1) [true, false] (cons true (cons true (blank)))), cons true (cons true (blank)), .C⟩ = some ⟨rep (q + 1) [false, true] (cons false (cons true (cons true (blank)))), cons true (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons false (rep (q + 1) [true, false] (cons true (cons true (blank)))) = rep (q + 1) [false, true] (cons false (cons true (cons true (blank)))) from
      rep_rotate (q + 1) [false] [true, false] [false, true] rfl (cons true (cons true (blank)))]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((q + 1) * 2) ⟨rep (q + 1) [false, true] (cons false (cons true (cons true (blank)))), cons true (cons true (blank)), .C⟩ = some ⟨cons false (cons true (cons true (blank))), cons true (rep (q + 1) [true, true] (cons true (blank))), .C⟩ :=
    cross_l trans c4 (q + 1) (cons false (cons true (cons true (blank)))) (cons true (blank))
  have h5 : steps 8 ⟨cons false (cons true (cons true (blank))), cons true (rep (q + 1) [true, true] (cons true (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons true (rep (q + 1) [true, true] (cons true (blank))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- A round of a head block with zeros on its left (inside the E-phase): two zeros and two ones become two copies of `01`. -/
theorem z_round (q : Nat) (L R : Tape) :
    steps (6 * q + 10) ⟨cons true (cons false (cons false (cons false (L)))), cons true (rep (q) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨cons true (cons false (L)), cons true (cons false (cons true (cons false (cons true (rep (q) [false, true] (R)))))), .B⟩ := by
  have hn : 0 + ((q) * 2 + (1 + (0 + ((q) * 4 + (9))))) = 6 * q + 10 := by omega
  have h0 : steps 0 ⟨cons true (cons false (cons false (cons false (L)))), cons true (rep (q) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨cons true (cons false (cons false (cons false (L)))), rep (q) [true, false] (cons true (cons true (cons true (R)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (q) [false, true] (cons true (cons true (R)))) = rep (q) [true, false] (cons true (cons true (cons true (R)))) from
      rep_rotate (q) [true] [false, true] [true, false] rfl (cons true (cons true (R)))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((q) * 2) ⟨cons true (cons false (cons false (cons false (L)))), rep (q) [true, false] (cons true (cons true (cons true (R)))), .B⟩ = some ⟨rep (q) [true, false] (cons true (cons false (cons false (cons false (L))))), cons true (cons true (cons true (R))), .B⟩ :=
    cross_r trans c1 (q) (cons true (cons false (cons false (cons false (L))))) (cons true (cons true (cons true (R))))
  have h2 : steps 1 ⟨rep (q) [true, false] (cons true (cons false (cons false (cons false (L))))), cons true (cons true (cons true (R))), .B⟩ = some ⟨cons false (rep (q) [true, false] (cons true (cons false (cons false (cons false (L)))))), cons true (cons true (R)), .A⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (q) [true, false] (cons true (cons false (cons false (cons false (L)))))), cons true (cons true (R)), .A⟩ = some ⟨rep (q) [false, true] (cons false (cons true (cons false (cons false (cons false (L)))))), cons true (cons true (R)), .A⟩ := by
    simp only [steps_zero, show cons false (rep (q) [true, false] (cons true (cons false (cons false (cons false (L)))))) = rep (q) [false, true] (cons false (cons true (cons false (cons false (cons false (L)))))) from
      rep_rotate (q) [false] [true, false] [false, true] rfl (cons true (cons false (cons false (cons false (L)))))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true, true] R, .A⟩ = some ⟨L, app [true, true] (app [false, true] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((q) * 4) ⟨rep (q) [false, true] (cons false (cons true (cons false (cons false (cons false (L)))))), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons true (cons false (cons false (cons false (L))))), cons true (cons true (rep (q) [false, true] (R))), .A⟩ :=
    cross_l trans c4 (q) (cons false (cons true (cons false (cons false (cons false (L)))))) (R)
  have h5 : steps 9 ⟨cons false (cons true (cons false (cons false (cons false (L))))), cons true (cons true (rep (q) [false, true] (R))), .A⟩ = some ⟨cons true (cons false (L)), cons true (cons false (cons true (cons false (cons true (rep (q) [false, true] (R)))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- A round with blank tape on the left: the tape grows by one cell at the left. -/
theorem b_round (q : Nat) (R : Tape) :
    steps (6 * q + 10) ⟨cons true (blank), cons true (rep (q) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨cons true (blank), cons true (cons false (cons true (cons false (cons true (rep (q) [false, true] (R)))))), .B⟩ := by
  have hn : 0 + ((q) * 2 + (1 + (0 + ((q) * 4 + (9))))) = 6 * q + 10 := by omega
  have h0 : steps 0 ⟨cons true (blank), cons true (rep (q) [false, true] (cons true (cons true (R)))), .B⟩ = some ⟨cons true (blank), rep (q) [true, false] (cons true (cons true (cons true (R)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (q) [false, true] (cons true (cons true (R)))) = rep (q) [true, false] (cons true (cons true (cons true (R)))) from
      rep_rotate (q) [true] [false, true] [true, false] rfl (cons true (cons true (R)))]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((q) * 2) ⟨cons true (blank), rep (q) [true, false] (cons true (cons true (cons true (R)))), .B⟩ = some ⟨rep (q) [true, false] (cons true (blank)), cons true (cons true (cons true (R))), .B⟩ :=
    cross_r trans c1 (q) (cons true (blank)) (cons true (cons true (cons true (R))))
  have h2 : steps 1 ⟨rep (q) [true, false] (cons true (blank)), cons true (cons true (cons true (R))), .B⟩ = some ⟨cons false (rep (q) [true, false] (cons true (blank))), cons true (cons true (R)), .A⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (q) [true, false] (cons true (blank))), cons true (cons true (R)), .A⟩ = some ⟨rep (q) [false, true] (cons false (cons true (blank))), cons true (cons true (R)), .A⟩ := by
    simp only [steps_zero, show cons false (rep (q) [true, false] (cons true (blank))) = rep (q) [false, true] (cons false (cons true (blank))) from
      rep_rotate (q) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true, true] R, .A⟩ = some ⟨L, app [true, true] (app [false, true] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((q) * 4) ⟨rep (q) [false, true] (cons false (cons true (blank))), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons true (blank)), cons true (cons true (rep (q) [false, true] (R))), .A⟩ :=
    cross_l trans c4 (q) (cons false (cons true (blank))) (R)
  have h5 : steps 9 ⟨cons false (cons true (blank)), cons true (cons true (rep (q) [false, true] (R))), .A⟩ = some ⟨cons true (blank), cons true (cons false (cons true (cons false (cons true (rep (q) [false, true] (R)))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The end of a cycle: `1 (01)^m 0` with the head in A at the right end becomes 2m+4 ones, head in C at the left end. -/
theorem fin (m : Nat) :
    steps (2 * m + 4) ⟨cons false (rep (m) [true, false] (cons true (blank))), blank, .A⟩ = some ⟨blank, cons true (cons true (cons true (rep (m) [true, true] (cons true (blank))))), .C⟩ := by
  have hn : 2 + (0 + ((m) * 2 + (2))) = 2 * m + 4 := by omega
  have h0 : steps 2 ⟨cons false (rep (m) [true, false] (cons true (blank))), blank, .A⟩ = some ⟨cons false (rep (m) [true, false] (cons true (blank))), cons true (cons true (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (rep (m) [true, false] (cons true (blank))), cons true (cons true (blank)), .C⟩ = some ⟨rep (m) [false, true] (cons false (cons true (blank))), cons true (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons false (rep (m) [true, false] (cons true (blank))) = rep (m) [false, true] (cons false (cons true (blank))) from
      rep_rotate (m) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((m) * 2) ⟨rep (m) [false, true] (cons false (cons true (blank))), cons true (cons true (blank)), .C⟩ = some ⟨cons false (cons true (blank)), cons true (rep (m) [true, true] (cons true (blank))), .C⟩ :=
    cross_l trans c2 (m) (cons false (cons true (blank))) (cons true (blank))
  have h3 : steps 2 ⟨cons false (cons true (blank)), cons true (rep (m) [true, true] (cons true (blank))), .C⟩ = some ⟨blank, cons true (cons true (cons true (rep (m) [true, true] (cons true (blank))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

end H10442
