import Machine

/-!
# 1RB1RF_1RC1LC_1LD0LE_---1LE_1RF0LB_0RA1RE: where it can halt, and the first steps from blank tape

Generated by `holdouts/gen.py`. The bounded runs are evaluated on the list simulator of `tools/lean/TM/Fin.lean`,
proved to agree with `steps`. They are a floor, not the way to the question.
-/

namespace H88925

open TM

/-- The halting configurations: the machine stops exactly when it reads the symbol of a halting transition (D0).
-/
theorem step_none_iff (c : Config) : step c = none ↔ (c.st = .D ∧ c.r 0 = false) := by
  obtain ⟨l, r, s⟩ := c
  cases s <;> cases h : r 0 <;> simp [step, TM.step, trans, h]

/-- 10,000 steps from blank tape without a halt, checked by Lean's kernel alone. -/
theorem blank_runs_kernel : ∃ c, steps 10000 init = some c :=
  blank_runs trans (by decide +kernel)

/-- 10,000,000 steps from blank tape without a halt, by compiled evaluation (`native_decide`). -/
theorem blank_runs_native : ∃ c, steps 10000000 init = some c :=
  blank_runs trans (by native_decide)

end H88925
