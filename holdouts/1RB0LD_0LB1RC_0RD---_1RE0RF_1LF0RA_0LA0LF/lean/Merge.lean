import Machine
import Counter

/-!
# The merge of two adjacent `e` digits

Two digits `e e` side by side (the gap between them empty) at the start of the tape.  The visit that reaches them
contains the near miss (the head reads `0 1 0` in the state where `0 1 1` would halt), so it uses the one transition
in which the four machines of the family differ; it is the commonest place where their runs part ways.  For this
machine the pair becomes one digit `d` (value 4), three `W` further right.

The rule is proved for every left gap `n`, every gap `m + 1` after the pair and every rest `R`.
-/

namespace H54516

open TM

/-- Two adjacent `e` digits after the left gap `W^n`: the pair becomes one digit `d` (value 4), three `W` further right. -/
theorem merge_ee (m n : Nat) (R : Tape) :
    steps (12 * n + 65) ⟨blank, cons false (cons false (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .D⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R))))))))))))))))))))), .D⟩ := by
  have h0 : steps 5 ⟨blank, cons false (cons false (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .D⟩ = some ⟨cons true (blank), cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .B⟩ = some ⟨cons true (blank), rep (n) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .B⟩ := by
    simp only [steps_zero, show cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))) = rep (n) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))) from
      rep_rotate (n) [false, false, true] [false, false, false, true] [false, false, true, false] rfl (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [true] L, app [false, false, true, false] R, .B⟩ = some ⟨app [true] (app [false, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 6) ⟨cons true (blank), rep (n) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .B⟩ = some ⟨cons true (rep (n) [false, true, false, true] (blank)), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .B⟩ :=
    cross_r trans c2 (n) (blank) (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))))
  have h3 : steps 54 ⟨cons true (rep (n) [false, true, false, true] (blank)), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (rep (n) [false, true, false, true] (blank)))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R)))))))))))))))), .D⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (rep (n) [false, true, false, true] (blank)))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R)))))))))))))))), .D⟩ = some ⟨rep (n) [true, false, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R)))))))))))))))), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (n) [false, true, false, true] (blank)))) = rep (n) [true, false, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (n) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (blank)]
  have c5 : ∀ L R : Tape, steps 6 ⟨app [true, false, true, false] L, app [false, false] R, .D⟩ = some ⟨L, app [false, false] (app [false, false, false, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((n) * 6) ⟨rep (n) [true, false, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R)))))))))))))))), .D⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R))))))))))))))))), .D⟩ :=
    cross_l trans c5 (n) (cons true (cons false (cons true (blank)))) (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R)))))))))))))))
  have h6 : steps 6 ⟨cons true (cons false (cons true (blank))), cons false (cons false (rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R))))))))))))))))), .D⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R))))))))))))))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 5 + (0 + ((n) * 6 + (54 + (0 + ((n) * 6 + (6))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

end H54516
