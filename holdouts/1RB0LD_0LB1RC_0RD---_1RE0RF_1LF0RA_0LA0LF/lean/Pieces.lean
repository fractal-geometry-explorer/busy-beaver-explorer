import Machine

/-!
# The piece rules of the counter

Generated by `py/gen_lean.py` with `bbtools.symtm.prove`: each rule is proved from single steps (`rfl`), the shift
rules `TM.cross_r` / `TM.cross_l` and re-bracketings `TM.rep_rotate`, for every value of the counts and every tape
`L`, `R` around.  Words are written left to right in the comments; in Lean the left tape is listed nearest the head
first.  `W = 0001`.  D is the state at the left end, B the state in which the head reaches a digit.
-/

namespace H54516

open TM

/-- From the sample configuration the head crosses the left gap `W^n` and arrives at the first digit. -/
theorem start (n : Nat) (R : Tape) :
    steps (6 * n + 5) ⟨blank, cons false (cons false (rep (n) [false, false, false, true] (R))), .D⟩ = some ⟨cons true (rep (n) [false, true, false, true] (blank)), cons false (cons false (cons true (R))), .B⟩ := by
  have h0 : steps 5 ⟨blank, cons false (cons false (rep (n) [false, false, false, true] (R))), .D⟩ = some ⟨cons true (blank), cons false (cons false (cons true (rep (n) [false, false, false, true] (R)))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons false (cons false (cons true (rep (n) [false, false, false, true] (R)))), .B⟩ = some ⟨cons true (blank), rep (n) [false, false, true, false] (cons false (cons false (cons true (R)))), .B⟩ := by
    simp only [steps_zero, show cons false (cons false (cons true (rep (n) [false, false, false, true] (R)))) = rep (n) [false, false, true, false] (cons false (cons false (cons true (R)))) from
      rep_rotate (n) [false, false, true] [false, false, false, true] [false, false, true, false] rfl (R)]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [true] L, app [false, false, true, false] R, .B⟩ = some ⟨app [true] (app [false, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 6) ⟨cons true (blank), rep (n) [false, false, true, false] (cons false (cons false (cons true (R)))), .B⟩ = some ⟨cons true (rep (n) [false, true, false, true] (blank)), cons false (cons false (cons true (R))), .B⟩ :=
    cross_r trans c2 (n) (blank) (cons false (cons false (cons true (R))))
  exact steps_congr trans (a := 5 + (0 + ((n) * 6))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A `d` is passed (the carry): the head crosses it and the gap `W^m` after it, and arrives at the next digit. -/
theorem carry (m : Nat) (L R : Tape) :
    steps (6 * m + 13) ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R))))))))), .B⟩ = some ⟨cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (cons false (cons true (R))), .B⟩ := by
  have h0 : steps 13 ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (m) [false, false, false, true] (R))))))))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (L)))))), cons false (cons false (cons true (rep (m) [false, false, false, true] (R)))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (cons false (cons true (cons false (cons true (L)))))), cons false (cons false (cons true (rep (m) [false, false, false, true] (R)))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (cons true (L)))))), rep (m) [false, false, true, false] (cons false (cons false (cons true (R)))), .B⟩ := by
    simp only [steps_zero, show cons false (cons false (cons true (rep (m) [false, false, false, true] (R)))) = rep (m) [false, false, true, false] (cons false (cons false (cons true (R)))) from
      rep_rotate (m) [false, false, true] [false, false, false, true] [false, false, true, false] rfl (R)]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [true] L, app [false, false, true, false] R, .B⟩ = some ⟨app [true] (app [false, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((m) * 6) ⟨cons true (cons true (cons false (cons true (cons false (cons true (L)))))), rep (m) [false, false, true, false] (cons false (cons false (cons true (R)))), .B⟩ = some ⟨cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (cons false (cons true (L))))))), cons false (cons false (cons true (R))), .B⟩ :=
    cross_r trans c2 (m) (cons true (cons false (cons true (cons false (cons true (L)))))) (cons false (cons false (cons true (R))))
  exact steps_congr trans (a := 13 + (0 + ((m) * 6))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- `a W` becomes `b`, and the head turns. -/
theorem bounce_a (L R : Tape) :
    steps (32) ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons false (cons false (cons false (cons true (R))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (R))))))))), .D⟩ := by
  have h0 : steps 32 ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons false (cons false (cons false (cons true (R))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons true (cons false (cons false (cons true (R))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 32) (by omega) (h0)

/-- `b W` becomes `c W`. -/
theorem bounce_b (L R : Tape) :
    steps (32) ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons false (cons false (cons true (cons false (cons false (cons false (cons true (R)))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons false (cons false (cons true (R)))))))))))), .D⟩ := by
  have h0 : steps 32 ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons false (cons false (cons true (cons false (cons false (cons false (cons true (R)))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons false (cons false (cons true (R)))))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 32) (by omega) (h0)

/-- `c W` becomes `d W`. -/
theorem bounce_c (L R : Tape) :
    steps (32) ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons false (cons false (cons true (R))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons false (cons true (R))))))))))), .D⟩ := by
  have h0 : steps 32 ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons false (cons false (cons true (R))))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons true (cons true (cons false (cons false (cons false (cons true (R))))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 32) (by omega) (h0)

/-- `e W` becomes `W a`. -/
theorem bounce_e (L R : Tape) :
    steps (32) ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons false (cons true (R)))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (R)))))))))), .D⟩ := by
  have h0 : steps 32 ⟨cons true (L), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons false (cons true (R)))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (cons true (R)))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 32) (by omega) (h0)

/-- Moving left, the head turns a crossed gap back into `W^k`. -/
theorem left_gap (k : Nat) (L R : Tape) :
    steps (6 * k) ⟨cons true (cons false (cons true (rep (k) [false, true, false, true] (L)))), cons false (cons false (R)), .D⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (rep (k) [false, false, false, true] (R))), .D⟩ := by
  have h0 : steps 0 ⟨cons true (cons false (cons true (rep (k) [false, true, false, true] (L)))), cons false (cons false (R)), .D⟩ = some ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (L)))), cons false (cons false (R)), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (k) [false, true, false, true] (L)))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (L)))) from
      rep_rotate (k) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (L)]
  have c1 : ∀ L R : Tape, steps 6 ⟨app [true, false, true, false] L, app [false, false] R, .D⟩ = some ⟨L, app [false, false] (app [false, false, false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((k) * 6) ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (L)))), cons false (cons false (R)), .D⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (rep (k) [false, false, false, true] (R))), .D⟩ :=
    cross_l trans c1 (k) (cons true (cons false (cons true (L)))) (R)
  exact steps_congr trans (a := 0 + ((k) * 6)) (by omega) (steps_seq trans h0 (h1))

/-- Moving left, a passed `d` becomes `e`. -/
theorem left_d (L R : Tape) :
    steps (17) ⟨cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (L)))))))), cons false (cons false (R)), .D⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons false (cons true (R))))))), .D⟩ := by
  have h0 : steps 17 ⟨cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (L)))))))), cons false (cons false (R)), .D⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons false (cons false (cons false (cons true (cons false (cons true (R))))))), .D⟩ := rfl
  exact steps_congr trans (a := 17) (by omega) (h0)

/-- At the left end the tape grows: the next sample configuration, with one more `W`. -/
theorem left_end (R : Tape) :
    steps (6) ⟨cons true (cons false (cons true (blank))), cons false (cons false (R)), .D⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons false (cons true (R)))))), .D⟩ := by
  have h0 : steps 6 ⟨cons true (cons false (cons true (blank))), cons false (cons false (R)), .D⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons false (cons true (R)))))), .D⟩ := rfl
  exact steps_congr trans (a := 6) (by omega) (h0)

end H54516
