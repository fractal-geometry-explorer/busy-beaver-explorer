import Machine

/-! # Shift rules of 1RB0LD_1RC1RB_1RD0RA_0LE1LF_---1LA_1LA0LC

The sweeps over the `(01)^n` segments: going right, B turns each `1010` into `1101` (`right_B`, four steps a copy);
going left, D with a 1 ahead turns each `1101` into `0101` (`left_D`, six steps a copy).  The halting situations:
only E reading a 0 halts, and `0 D> 0`, `0 0 A> 1` and `0 C> 1 1` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H21414

open TM

/-- Going right, B turns each `1010` into `1101`, four steps a copy. -/
theorem right_B (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨L, rep (n) [true, false, true, false] (R), .B⟩ = some ⟨rep (n) [true, false, true, true] (L), R, .B⟩ := by
  have hn : (n) * 4 = 4 * n := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨L, rep (n) [true, false, true, false] (R), .B⟩ = some ⟨rep (n) [true, false, true, true] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- Going left, D (with a 1 ahead) turns each `1101` into `0101`, six steps a copy. -/
theorem left_D (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨rep (n) [true, false, true, true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [false, true, false, true] (R)), .D⟩ := by
  have hn : (n) * 6 = 6 * n := by omega
  have c0 : ∀ L R : Tape, steps 6 ⟨app [true, false, true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨rep (n) [true, false, true, true] (L), cons true (R), .D⟩ = some ⟨L, cons true (rep (n) [false, true, false, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `0 D> 0` halts: D steps left onto a 0 in state E. -/
theorem halt_D (L R : Tape) : ∃ c, steps 1 ⟨cons false (L), cons false (R), .D⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 0 A> 1` halts after two steps. -/
theorem halt_A (L R : Tape) : ∃ c, steps 2 ⟨cons false (cons false (L)), cons true (R), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `0 C> 1 1` halts after three steps. -/
theorem halt_C (L R : Tape) : ∃ c, steps 3 ⟨cons false (L), cons true (cons true (R)), .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H21414
