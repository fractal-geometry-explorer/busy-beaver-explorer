import Machine

/-!
# The bouncer part of 1RB0LD_0RC---_0RD0RF_1LE0LA_1LF1LE_1RA0RD

Generated by `py/gen_sweep.py`; do not edit by hand.

Between the left wall and the right end, the tape is a run of the 8-cell word `P = 10011010` (after a rightward sweep)
or `Q = 11110001` (after a leftward one).  A leftward sweep turns `P^n` into `Q^n` (36 steps a copy), a rightward sweep
turns `Q^n` back into `P^n` (32 steps a copy), and at the right end the head turns in 5 steps, adding two cells.
The leftward sweep carries the word `10` on its left and `0` on its right, so it needs `cross_l2`, the two-sided form
of `TM.cross_l`.  Tapes left of the head are written nearest cell first.
-/

namespace H48815

open TM

/-- Crossing to the left with a word carried on each side: `w^k u₁ q> u₂ R` becomes `u₁ q> u₂ v^k R`. -/
theorem cross_l2 {s : Nat} {q : St} {u₁ u₂ w v : List Bool}
    (h : ∀ L R : Tape, steps s ⟨app u₁ (app w L), app u₂ R, q⟩ = some ⟨app u₁ L, app u₂ (app v R), q⟩) (k : Nat) :
    ∀ L R : Tape, steps (k * s) ⟨app u₁ (rep k w L), app u₂ R, q⟩ = some ⟨app u₁ L, app u₂ (rep k v R), q⟩ := by
  induction k with
  | zero => intro L R; simp
  | succ k ih =>
    intro L R
    have e : (k + 1) * s = s + k * s := by rw [Nat.succ_mul, Nat.add_comm]
    rw [e]
    have h₂ := ih L (app v R)
    rw [rep_app_comm] at h₂
    exact steps_seq trans (h (rep k w L) R) h₂

/-- One copy of the leftward sweep: `P 1 0 E> 0` becomes `1 0 E> 0 Q` in 36 steps. -/
theorem sweep_left_one : ∀ L R : Tape,
    steps 36 ⟨app [false, true] (app [false, true, false, true, true, false, false, true] L), app [false] R, .E⟩ = some ⟨app [false, true] L, app [false] (app [true, true, true, true, false, false, false, true] R), .E⟩ :=
  fun _ _ => rfl

/-- The leftward sweep: `P^n 1 0 E> 0` becomes `1 0 E> 0 Q^n` in 36n steps. -/
theorem sweep_left (n : Nat) (L R : Tape) :
    steps (n * 36) ⟨app [false, true] (rep n [false, true, false, true, true, false, false, true] L), app [false] R, .E⟩ =
      some ⟨app [false, true] L, app [false] (rep n [true, true, true, true, false, false, false, true] R), .E⟩ :=
  cross_l2 sweep_left_one n L R

/-- The rightward sweep: `0 D> (11110001)^n` becomes `(10011010)^n 0 D>` in 32n steps. -/
theorem sweep_right (n : Nat) (L R : Tape) :
    steps (32 * n) ⟨cons false (L), rep (n) [true, true, true, true, false, false, false, true] (R), .D⟩ = some ⟨cons false (rep (n) [false, true, false, true, true, false, false, true] (L)), R, .D⟩ := by
  have c0 : ∀ L R : Tape, steps 32 ⟨app [false] L, app [true, true, true, true, false, false, false, true] R, .D⟩ = some ⟨app [false] (app [false, true, false, true, true, false, false, true] L), R, .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 32) ⟨cons false (L), rep (n) [true, true, true, true, false, false, false, true] (R), .D⟩ = some ⟨cons false (rep (n) [false, true, false, true, true, false, false, true] (L)), R, .D⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 32) (by omega) (h0)


/-- The turn at the right end: `0 D> 1` followed by blank tape becomes `1 0 E> 0 1`, two cells wider, in 5 steps. -/
theorem turn_right (L : Tape) :
    steps 5 ⟨cons false L, cons true blank, .D⟩ = some ⟨cons false (cons true L), cons false (cons true blank), .E⟩ :=
  rfl

/-- The right half of every round trip: from `0 D> Q^n 1` at the wall, the head sweeps right, turns at the end
and sweeps back, leaving `1 0 E> 0 Q^n 1` (the tape two cells wider), in 68n + 5 steps. -/
theorem round_right (n : Nat) (L : Tape) :
    steps (68 * n + 5) ⟨cons false L, rep n [true, true, true, true, false, false, false, true] (cons true blank), .D⟩ =
      some ⟨app [false, true] L, app [false] (rep n [true, true, true, true, false, false, false, true] (cons true blank)), .E⟩ := by
  have h1 := sweep_right n L (cons true blank)
  have h2 := turn_right (rep n [false, true, false, true, true, false, false, true] L)
  have h3 := sweep_left n L (cons true blank)
  have h12 := steps_seq trans h1 h2
  have h123 := steps_seq trans h12 h3
  exact steps_congr trans (by omega) h123

end H48815
