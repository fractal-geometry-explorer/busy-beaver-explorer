import Machine
import Counter

/-!
# The merge of two adjacent `e` digits

Two digits `e e` side by side (the gap between them empty) at the start of the tape.  The visit that reaches them
contains the near miss (the head reads `0 1 0` in the state where `0 1 1` would halt), so it uses the one transition
in which the four machines of the family differ; it is the commonest place where their runs part ways.  For this
machine the pair becomes the word `001`, and a new digit `a` is born at the left end of the tape.

The rule is proved for every left gap `n`, every gap `m + 1` after the pair and every rest `R`.
-/

namespace H59221

open TM

/-- Two adjacent `e` digits after the left gap `W^n`: the pair becomes the word `001`, and a new digit `a` is born at the left end of the tape. -/
theorem merge_ee (m n : Nat) (R : Tape) :
    steps (10 * n + 53) ⟨blank, cons false (cons false (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .A⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons true (cons true (cons false (cons false (rep (n) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R))))))))))))))))))))))), .A⟩ := by
  have h0 : steps 5 ⟨blank, cons false (cons false (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .A⟩ = some ⟨cons true (blank), cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .E⟩ = some ⟨cons true (blank), rep (n) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .E⟩ := by
    simp only [steps_zero, show cons false (cons false (cons true (rep (n) [false, false, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))) = rep (n) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))) from
      rep_rotate (n) [false, false, true] [false, false, false, true] [false, false, true, false] rfl (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, false, true, false] R, .E⟩ = some ⟨app [] (app [true, false, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 4) ⟨cons true (blank), rep (n) [false, false, true, false] (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R))))))))))))))), .E⟩ = some ⟨rep (n) [true, false, true, false] (cons true (blank)), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .E⟩ :=
    cross_r trans c2 (n) (cons true (blank)) (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))))
  have h3 : steps 33 ⟨rep (n) [true, false, true, false] (cons true (blank)), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (rep (m + 1) [false, false, false, true] (R)))))))))))))), .E⟩ = some ⟨cons false (cons true (cons false (rep (n) [true, false, true, false] (cons true (blank))))), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R))))))))))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons false (rep (n) [true, false, true, false] (cons true (blank))))), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R))))))))))))))), .C⟩ = some ⟨rep (n) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R))))))))))))))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (n) [true, false, true, false] (cons true (blank))))) = rep (n) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))) from
      rep_rotate (n) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 6 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, false, false] R), .C⟩ := fun _ _ => rfl
  have h5 : steps ((n) * 6) ⟨rep (n) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R))))))))))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (blank)))), cons true (rep (n) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R)))))))))))))))), .C⟩ :=
    cross_l trans c5 (n) (cons false (cons true (cons false (cons true (blank))))) (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R)))))))))))))))
  have h6 : steps 15 ⟨cons false (cons true (cons false (cons true (blank)))), cons true (rep (n) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R)))))))))))))))), .C⟩ = some ⟨blank, cons false (cons false (cons false (cons false (cons true (cons true (cons false (cons false (rep (n) [false, true, false, false] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (m) [false, false, false, true] (R))))))))))))))))))))))), .A⟩ := rfl
  exact steps_congr trans (a := 5 + (0 + ((n) * 4 + (33 + (0 + ((n) * 6 + (15))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

end H59221
