  have c1 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true] R), .F⟩ := fun _ _ => rfl
  have h1 : steps ((r + 2) * 3) ⟨rep (r + 2) [true] (rep (q) [false, true] (cons false (cons false (blank)))), cons true (cons true (blank)), .F⟩ = some ⟨rep (q) [false, true] (cons false (cons false (blank))), cons true (rep (r + 2) [true] (cons true (blank))), .F⟩ :=
    cross_l trans c1 (r + 2) (rep (q) [false, true] (cons false (cons false (blank)))) (cons true (blank))
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false] R), .F⟩ := fun _ _ => rfl
  have h2 : steps ((q) * 2) ⟨rep (q) [false, true] (cons false (cons false (blank))), cons true (rep (r + 2) [true] (cons true (blank))), .F⟩ = some ⟨cons false (cons false (blank)), cons true (rep (q) [true, false] (rep (r + 2) [true] (cons true (blank)))), .F⟩ :=
    cross_l trans c2 (q) (cons false (cons false (blank))) (rep (r + 2) [true] (cons true (blank)))
  have h3 : steps 8 ⟨cons false (cons false (blank)), cons true (rep (q) [true, false] (rep (r + 2) [true] (cons true (blank)))), .F⟩ = some ⟨cons true (cons false (cons true (cons false (blank)))), cons false (rep (q) [true, false] (rep (r + 2) [true] (cons true (blank)))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (cons false (blank)))), cons false (rep (q) [true, false] (rep (r + 2) [true] (cons true (blank)))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (blank)))), rep (q) [false, true] (cons false (rep (r + 2) [true] (cons true (blank)))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (q) [true, false] (rep (r + 2) [true] (cons true (blank)))) = rep (q) [false, true] (cons false (rep (r + 2) [true] (cons true (blank)))) from
      rep_rotate (q) [false] [true, false] [false, true] rfl (rep (r + 2) [true] (cons true (blank)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((q) * 2) ⟨cons true (cons false (cons true (cons false (blank)))), rep (q) [false, true] (cons false (rep (r + 2) [true] (cons true (blank)))), .C⟩ = some ⟨rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))), cons false (rep (r + 2) [true] (cons true (blank))), .C⟩ :=
    cross_r trans c5 (q) (cons true (cons false (cons true (cons false (blank))))) (cons false (rep (r + 2) [true] (cons true (blank))))
  have h6 : steps 5 ⟨rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))), cons false (rep (r + 2) [true] (cons true (blank))), .C⟩ = some ⟨cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank)))))))), rep (r) [true] (cons true (blank)), .E⟩ := rfl
  have c7 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .E⟩ = some ⟨app [] (app [true] L), R, .E⟩ := fun _ _ => rfl
  have h7 : steps ((r) * 1) ⟨cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank)))))))), rep (r) [true] (cons true (blank)), .E⟩ = some ⟨rep (r) [true] (cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))))))), cons true (blank), .E⟩ :=
    cross_r trans c7 (r) (cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))))))) (cons true (blank))
  have h8 : steps 1 ⟨rep (r) [true] (cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))))))), cons true (blank), .E⟩ = some ⟨cons true (rep (r) [true] (cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank)))))))))), blank, .E⟩ := rfl
  exact steps_congr trans (a := 1 + ((r + 2) * 3 + ((q) * 2 + (8 + (0 + ((q) * 2 + (5 + ((r) * 1 + (1))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- the same with two ones: W 0 q 2 to W (q+2) 0 1 -/
theorem l5c (q : Nat) :
    steps (4 * q + 17) ⟨rep (2) [true] (rep (q) [false, true] (cons false (cons false (blank)))), blank, .E⟩ = some ⟨cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank)))))))), blank, .E⟩ := by
  have h0 : steps 1 ⟨rep (2) [true] (rep (q) [false, true] (cons false (cons false (blank)))), blank, .E⟩ = some ⟨rep (1) [true] (rep (q) [false, true] (cons false (cons false (blank)))), cons true (cons true (blank)), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true] R), .F⟩ := fun _ _ => rfl
  have h1 : steps ((1) * 3) ⟨rep (1) [true] (rep (q) [false, true] (cons false (cons false (blank)))), cons true (cons true (blank)), .F⟩ = some ⟨rep (q) [false, true] (cons false (cons false (blank))), cons true (rep (1) [true] (cons true (blank))), .F⟩ :=
    cross_l trans c1 (1) (rep (q) [false, true] (cons false (cons false (blank)))) (cons true (blank))
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false] R), .F⟩ := fun _ _ => rfl
  have h2 : steps ((q) * 2) ⟨rep (q) [false, true] (cons false (cons false (blank))), cons true (rep (1) [true] (cons true (blank))), .F⟩ = some ⟨cons false (cons false (blank)), cons true (rep (q) [true, false] (rep (1) [true] (cons true (blank)))), .F⟩ :=
    cross_l trans c2 (q) (cons false (cons false (blank))) (rep (1) [true] (cons true (blank)))
  have h3 : steps 8 ⟨cons false (cons false (blank)), cons true (rep (q) [true, false] (rep (1) [true] (cons true (blank)))), .F⟩ = some ⟨cons true (cons false (cons true (cons false (blank)))), cons false (rep (q) [true, false] (rep (1) [true] (cons true (blank)))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (cons false (blank)))), cons false (rep (q) [true, false] (rep (1) [true] (cons true (blank)))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (blank)))), rep (q) [false, true] (cons false (rep (1) [true] (cons true (blank)))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (q) [true, false] (rep (1) [true] (cons true (blank)))) = rep (q) [false, true] (cons false (rep (1) [true] (cons true (blank)))) from
      rep_rotate (q) [false] [true, false] [false, true] rfl (rep (1) [true] (cons true (blank)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h5 : steps ((q) * 2) ⟨cons true (cons false (cons true (cons false (blank)))), rep (q) [false, true] (cons false (rep (1) [true] (cons true (blank)))), .C⟩ = some ⟨rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))), cons false (rep (1) [true] (cons true (blank))), .C⟩ :=
    cross_r trans c5 (q) (cons true (cons false (cons true (cons false (blank))))) (cons false (rep (1) [true] (cons true (blank))))
  have h6 : steps 5 ⟨rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))), cons false (rep (1) [true] (cons true (blank))), .C⟩ = some ⟨cons true (cons false (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank)))))))), blank, .E⟩ := rfl
  exact steps_congr trans (a := 1 + ((1) * 3 + ((q) * 2 + (8 + (0 + ((q) * 2 + (5))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- W 0 q 1 reaches the halting configuration (state D reading 0) -/
theorem l6 (q : Nat) :
    steps (4 * q + 12) ⟨cons true (rep (q) [false, true] (cons false (cons false (blank)))), blank, .E⟩ = some ⟨cons false (cons true (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank)))))))), blank, .D⟩ := by
  have h0 : steps 1 ⟨cons true (rep (q) [false, true] (cons false (cons false (blank)))), blank, .E⟩ = some ⟨rep (q) [false, true] (cons false (cons false (blank))), cons true (cons true (blank)), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true, false] R), .F⟩ := fun _ _ => rfl
  have h1 : steps ((q) * 2) ⟨rep (q) [false, true] (cons false (cons false (blank))), cons true (cons true (blank)), .F⟩ = some ⟨cons false (cons false (blank)), cons true (rep (q) [true, false] (cons true (blank))), .F⟩ :=
    cross_l trans c1 (q) (cons false (cons false (blank))) (cons true (blank))
  have h2 : steps 8 ⟨cons false (cons false (blank)), cons true (rep (q) [true, false] (cons true (blank))), .F⟩ = some ⟨cons true (cons false (cons true (cons false (blank)))), cons false (rep (q) [true, false] (cons true (blank))), .C⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons false (cons true (cons false (blank)))), cons false (rep (q) [true, false] (cons true (blank))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (blank)))), rep (q) [false, true] (cons false (cons true (blank))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (q) [true, false] (cons true (blank))) = rep (q) [false, true] (cons false (cons true (blank))) from
      rep_rotate (q) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h4 : steps ((q) * 2) ⟨cons true (cons false (cons true (cons false (blank)))), rep (q) [false, true] (cons false (cons true (blank))), .C⟩ = some ⟨rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))), cons false (cons true (blank)), .C⟩ :=
    cross_r trans c4 (q) (cons true (cons false (cons true (cons false (blank))))) (cons false (cons true (blank)))
  have h5 : steps 3 ⟨rep (q) [true, false] (cons true (cons false (cons true (cons false (blank))))), cons false (cons true (blank)), .C⟩ = some ⟨cons false (cons true (cons false (rep (q) [true, false] (cons true (cons false (cons true (cons false (blank)))))))), blank, .D⟩ := rfl
  exact steps_congr trans (a := 1 + ((q) * 2 + (8 + (0 + ((q) * 2 + (3)))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

