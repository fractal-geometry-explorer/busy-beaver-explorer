import Rules

set_option linter.unusedSimpArgs false

/-!
# 1RB1RE_1LC0RA_0RD1LB_---1RC_1LF1RE_0LB0LE: the machine is a map on pairs of numbers

Configurations with the head at the right end of the visited tape, reading blank:

* `W p q r` = `0^inf 0 (10)^p 0 (10)^q 1^r E> 0^inf`
* `X p q`   = `0^inf 0 (10)^p 0 (10)^q A> 0^inf`

`Rules.lean` (generated by `py/gen_rules.py`) proves the one-sweep rules for all values; this file restates them with
`W` and `X`, chains a whole phase by induction, and derives the map on `(p, r)` read at the samples `W p 0 r`:

* `r ≥ p + 2`: `(p, r) ↦ (2p + 2, r - p - 1)`
* `r = p + 1`: the machine halts
* `r = p ≥ 1`: `(p, r) ↦ (2, 4p + 1)`
* `1 ≤ r < p`: `(p, r) ↦ (p - r, 4r + 2)`

and the run from blank tape reaches `W 2 0 1` after 27 steps.  So the machine halts from blank tape if and only if the
orbit of `(2, 1)` under the map reaches a pair with `r = p + 1` (`halts_iff_orbit`).
-/

namespace H107208

open TM

def W (p q r : Nat) : Config :=
  ⟨rep r [true] (rep q [false, true] (cons false (rep p [false, true] (cons false blank)))), blank, .E⟩

def X (p q : Nat) : Config :=
  ⟨rep q [false, true] (cons false (rep p [false, true] (cons false blank))), blank, .A⟩

theorem rep_comm1 (n : Nat) (a : Bool) (s : Tape) : rep n [a] (cons a s) = cons a (rep n [a] s) := by
  induction n with
  | zero => rfl
  | succ n ih => show cons a (rep n [a] (cons a s)) = cons a (cons a (rep n [a] s)); rw [ih]

theorem rep_comm2 (n : Nat) (a b : Bool) (s : Tape) :
    rep n [a, b] (cons a (cons b s)) = cons a (cons b (rep n [a, b] s)) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    show cons a (cons b (rep n [a, b] (cons a (cons b s)))) = cons a (cons b (cons a (cons b (rep n [a, b] s))))
    rw [ih]

theorem rot_tf (n : Nat) (s : Tape) : cons false (rep n [true, false] s) = rep n [false, true] (cons false s) :=
  rep_rotate n [false] [true, false] [false, true] rfl s

theorem rep_tt (n : Nat) (s : Tape) : rep n [true, true] s = rep (2 * n) [true] s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by omega]
    show cons true (cons true (rep n [true, true] s)) = cons true (cons true (rep (2 * n) [true] s))
    rw [ih]

theorem rep_one_add (a b : Nat) (s : Tape) : rep (a + b) [true] s = rep a [true] (rep b [true] s) := rep_add a b [true] s

/-! ## The rules with `W` and `X` -/

theorem w1 (p q r : Nat) : steps (4 * q + 4 * r + 17) (W (p + 1) q (r + 3)) = some (W p (q + 2) (r + 2)) := by
  have h := l1 p q r
  simp only [rep_comm1, rep_comm2] at h
  exact h

theorem w1c (p q : Nat) : steps (4 * q + 13) (W (p + 1) q 2) = some (W p (q + 2) 1) := by
  have h := l1c p q
  simp only [rep_comm1, rep_comm2] at h
  exact h

theorem w2 (p q : Nat) : steps (4 * q + 9) (W (p + 1) q 1) = some (X p (q + 2)) := by
  have h := l2 p q
  simp only [rep_comm1, rep_comm2] at h
  exact h

theorem w3 (p q : Nat) : steps (4 * q + 18) (X (p + 1) (q + 2)) = some (W (p + 1) 0 (2 * q + 6)) := by
  have h := l3 p q
  simp only [rep_comm1, rep_comm2, rep_tt] at h
  simp only [W]
  rw [show 2 * q + 6 = 2 * (q + 2) + 1 + 1 by omega]
  exact h

theorem w4 (q : Nat) : steps (12 * q + 51) (X 0 (q + 2)) = some (W 2 0 (2 * q + 5)) := by
  have h := l4 q
  simp only [rep_tt, rep_comm1] at h
  simp only [W]
  rw [show 2 * q + 5 = 2 * (q + 1) + 1 + 1 + 1 by omega]
  exact h

theorem w5 (q r : Nat) : steps (4 * q + 4 * r + 21) (W 0 q (r + 3)) = some (W (q + 2) 0 (r + 2)) := by
  have h := l5 q r
  simp only [rep_comm1, rot_tf, rep_comm2] at h
  exact h

theorem w5c (q : Nat) : steps (4 * q + 17) (W 0 q 2) = some (W (q + 2) 0 1) := by
  have h := l5c q
  simp only [rot_tf, rep_comm2] at h
  exact h

/-- `W 0 q 1` halts: after `4q + 12` steps the machine is in state D reading 0. -/
theorem w6 (q : Nat) : ∃ c, steps (4 * q + 12) (W 0 q 1) = some c ∧ step c = none :=
  ⟨_, l6 q, rfl⟩

/-! ## Chaining: a whole phase -/

/-- `c` reaches `c'` in a positive number of steps. -/
def Reach (c c' : Config) : Prop := ∃ n, 0 < n ∧ steps n c = some c'

theorem reach_trans {a b c : Config} (h₁ : Reach a b) (h₂ : Reach b c) : Reach a c := by
  obtain ⟨n, hn, h⟩ := h₁
  obtain ⟨m, _, h'⟩ := h₂
  exact ⟨n + m, by omega, steps_seq trans h h'⟩

theorem reach_of {n : Nat} {c c' : Config} (h : steps n c = some c') (hn : 0 < n) : Reach c c' := ⟨n, hn, h⟩

/-- One sweep, any number of ones left. -/
theorem w1' (p q r : Nat) : Reach (W (p + 1) q (r + 2)) (W p (q + 2) (r + 1)) := by
  cases r with
  | zero => exact reach_of (w1c p q) (by omega)
  | succ r => exact reach_of (w1 p q r) (by omega)

/-- `k` sweeps: the left block gives `k` cells, the middle block grows by `2k`, the ones shrink by `k`. -/
theorem iter (k p q r : Nat) : k = 0 ∨ Reach (W (p + k) q (r + k + 1)) (W p (q + 2 * k) (r + 1)) := by
  induction k generalizing q with
  | zero => exact Or.inl rfl
  | succ k ih =>
    right
    have h1 : Reach (W (p + (k + 1)) q (r + (k + 1) + 1)) (W (p + k) (q + 2) (r + k + 1)) := by
      have := w1' (p + k) q (r + k)
      rw [show p + (k + 1) = p + k + 1 by omega, show r + (k + 1) + 1 = r + k + 2 by omega]
      exact this
    rcases ih (q + 2) with h0 | h2
    · subst h0; simpa using h1
    · rw [show q + 2 * (k + 1) = q + 2 + 2 * k by omega]; exact reach_trans h1 h2

/-- `iter` with the zero case allowed as "equal". -/
theorem iter' (k p q r : Nat) :
    (k = 0 ∧ W (p + k) q (r + k + 1) = W p (q + 2 * k) (r + 1)) ∨ Reach (W (p + k) q (r + k + 1)) (W p (q + 2 * k) (r + 1)) := by
  rcases iter k p q r with h | h
  · left; subst h; exact ⟨rfl, rfl⟩
  · right; exact h

/-! ## The map -/

/-- The map on `(p, r)`, read at `W p 0 r`; `none` is a halt. -/
def f (x : Nat × Nat) : Option (Nat × Nat) :=
  if x.2 ≥ x.1 + 2 then some (2 * x.1 + 2, x.2 - x.1 - 1)
  else if x.2 = x.1 + 1 then none
  else if x.2 = x.1 then some (2, 4 * x.1 + 1)
  else some (x.1 - x.2, 4 * x.2 + 2)

theorem reach_or_eq_trans {a b c : Config} (h₁ : a = b ∨ Reach a b) (h₂ : Reach b c) : Reach a c := by
  rcases h₁ with h | h
  · subst h; exact h₂
  · exact reach_trans h h₂

/-- The map is what the machine does: a step of `f` is a positive run between samples, and a `none` is a halt. -/
theorem map_step (p r : Nat) (hr : 1 ≤ r) :
    (∀ y, f (p, r) = some y → 1 ≤ y.2 ∧ Reach (W p 0 r) (W y.1 0 y.2)) ∧
    (f (p, r) = none → Halts trans (W p 0 r)) := by
  by_cases h1 : r ≥ p + 2
  · have hf : f (p, r) = some (2 * p + 2, r - p - 1) := by simp [f, h1]
    refine ⟨fun y hy => ?_, fun h => (by rw [hf] at h; cases h)⟩
    rw [hf] at hy; cases hy
    refine ⟨by simp; omega, ?_⟩
    obtain ⟨t, rfl⟩ : ∃ t, r = t + p + 2 := ⟨r - p - 2, by omega⟩
    have hA : W p 0 (t + p + 2) = W (0 + p) 0 ((t + 1) + p + 1) := by
      congr 1 <;> omega
    have hB : W 0 (0 + 2 * p) (t + 1 + 1) = W 0 (2 * p) (t + 2) := by congr 1 <;> omega
    have hC : Reach (W 0 (2 * p) (t + 2)) (W (2 * p + 2) 0 (t + 1)) := by
      cases t with
      | zero => exact reach_of (w5c (2 * p)) (by omega)
      | succ t => exact reach_of (w5 (2 * p) t) (by omega)
    have e : t + p + 2 - p - 1 = t + 1 := by omega
    simp only [e]
    rw [hA]
    rcases iter' p 0 0 (t + 1) with ⟨_, he⟩ | h
    · rw [he, hB]; exact hC
    · rw [hB] at h; exact reach_trans h hC
  · by_cases h2 : r = p + 1
    · have hf : f (p, r) = none := by simp [f, h2]
      refine ⟨fun y hy => (by rw [hf] at hy; cases hy), fun _ => ?_⟩
      subst h2
      obtain ⟨c, hc, hs⟩ := w6 (2 * p)
      have hA : W p 0 (p + 1) = W (0 + p) 0 (0 + p + 1) := by congr 1 <;> omega
      have hB : W 0 (0 + 2 * p) (0 + 1) = W 0 (2 * p) 1 := by congr 1 <;> omega
      rw [hA]
      rcases iter' p 0 0 0 with ⟨_, he⟩ | ⟨n, _, h⟩
      · rw [he, hB]; exact ⟨_, _, hc, hs⟩
      · rw [hB] at h; exact ⟨_, _, steps_seq trans h hc, hs⟩
    · by_cases h3 : r = p
      · have hf : f (p, r) = some (2, 4 * p + 1) := by simp [f, h1, h2, h3]
        refine ⟨fun y hy => ?_, fun h => (by rw [hf] at h; cases h)⟩
        rw [hf] at hy; cases hy
        refine ⟨by simp, ?_⟩
        subst h3
        obtain ⟨m, rfl⟩ : ∃ m, r = m + 1 := ⟨r - 1, by omega⟩
        have hA : W (m + 1) 0 (m + 1) = W (1 + m) 0 (0 + m + 1) := by congr 1 <;> omega
        have hB : W 1 (0 + 2 * m) (0 + 1) = W (0 + 1) (2 * m) 1 := by congr 1 <;> omega
        have hC : Reach (W (0 + 1) (2 * m) 1) (W 2 0 (4 * (m + 1) + 1)) := by
          have h2' := w2 0 (2 * m)
          have h4 := w4 (2 * m)
          rw [show 2 * (2 * m) + 5 = 4 * (m + 1) + 1 by omega] at h4
          exact reach_trans (reach_of h2' (by omega)) (reach_of h4 (by omega))
        rw [hA]
        rcases iter' m 1 0 0 with ⟨_, he⟩ | h
        · rw [he, hB]; exact hC
        · rw [hB] at h; exact reach_trans h hC
      · have hf : f (p, r) = some (p - r, 4 * r + 2) := by simp [f, h1, h2, h3]
        refine ⟨fun y hy => ?_, fun h => (by rw [hf] at h; cases h)⟩
        rw [hf] at hy; cases hy
        refine ⟨by simp, ?_⟩
        obtain ⟨m, rfl⟩ : ∃ m, r = m + 1 := ⟨r - 1, by omega⟩
        obtain ⟨d, rfl⟩ : ∃ d, p = d + 1 + (m + 1) := ⟨p - (m + 1) - 1, by omega⟩
        have hA : W (d + 1 + (m + 1)) 0 (m + 1) = W ((d + 2) + m) 0 (0 + m + 1) := by congr 1 <;> omega
        have hB : W (d + 2) (0 + 2 * m) (0 + 1) = W (d + 1 + 1) (2 * m) 1 := by congr 1 <;> omega
        have hC : Reach (W (d + 1 + 1) (2 * m) 1) (W (d + 1 + (m + 1) - (m + 1)) 0 (4 * (m + 1) + 2)) := by
          have h2' := w2 (d + 1) (2 * m)
          have h3' := w3 d (2 * m)
          rw [show 2 * (2 * m) + 6 = 4 * (m + 1) + 2 by omega,
              show d + 1 = d + 1 + (m + 1) - (m + 1) by omega] at h3'
          rw [show d + 1 + (m + 1) - (m + 1) = d + 1 by omega] at h3' ⊢
          exact reach_trans (reach_of h2' (by omega)) (reach_of h3' (by omega))
        rw [hA]
        rcases iter' m (d + 2) 0 0 with ⟨_, he⟩ | h
        · rw [he, hB]; exact hC
        · rw [hB] at h; exact reach_trans h hC

/-! ## From blank tape -/

/-- The orbit of `(2, 1)`; `none` once it has halted. -/
def orbit : Nat → Option (Nat × Nat)
  | 0 => some (2, 1)
  | k + 1 => (orbit k).bind f

/-- 27 steps from blank tape reach `W 2 0 1` (`0 (10)^2 0 1 E> 0`). -/
theorem blank_27 : steps 27 init = some (W 2 0 1) := by
  have h := blank_reaches trans (n := 27) (q := St.A) (c := ⟨[true, false, false, true, false, true, false], [], .E⟩) (by decide)
  exact h

theorem orbit_reach (k : Nat) :
    ∀ x : Nat × Nat, orbit k = some x → 1 ≤ x.2 ∧ ∃ n, k ≤ n ∧ steps n init = some (W x.1 0 x.2) := by
  induction k with
  | zero =>
    intro x hx; cases hx
    exact ⟨by decide, 27, by omega, blank_27⟩
  | succ k ih =>
    intro y hy
    simp only [orbit] at hy
    cases hk : orbit k with
    | none => rw [hk] at hy; cases hy
    | some x =>
      rw [hk] at hy
      obtain ⟨hr, n, hn, h⟩ := ih x hk
      obtain ⟨hy1, m, hm, h'⟩ := (map_step x.1 x.2 hr).1 y hy
      exact ⟨hy1, n + m, by omega, steps_seq trans h h'⟩

/-- **The machine halts from blank tape if and only if the orbit of `(2, 1)` under `f` reaches a pair `(p, p + 1)`**
(where `f` gives `none`). -/
theorem halts_iff_orbit : HaltsFromBlank ↔ ∃ k, orbit k = none := by
  constructor
  · intro hH
    apply Classical.byContradiction
    intro hno
    have hall : ∀ k, ∃ x, orbit k = some x := by
      intro k
      cases e : orbit k with
      | none => exact absurd ⟨k, e⟩ hno
      | some x => exact ⟨x, rfl⟩
    apply not_halts_of_forall trans _ hH
    apply forall_of_unbounded trans (fun n => ∃ x : Nat × Nat, steps n init = some (W x.1 0 x.2))
    · intro n
      obtain ⟨x, hx⟩ := hall n
      obtain ⟨_, m, hm, h⟩ := orbit_reach n x hx
      exact ⟨m, hm, x, h⟩
    · rintro m ⟨x, h⟩; exact ⟨_, h⟩
  · rintro ⟨k, hk⟩
    induction k with
    | zero => cases hk
    | succ k ih =>
      simp only [orbit] at hk
      cases e : orbit k with
      | none => exact ih e
      | some x =>
        rw [e] at hk
        obtain ⟨hr, n, _, h⟩ := orbit_reach k x e
        obtain ⟨m, c, hc, hs⟩ := (map_step x.1 x.2 hr).2 hk
        exact ⟨n + m, c, steps_seq trans h hc, hs⟩

end H107208
