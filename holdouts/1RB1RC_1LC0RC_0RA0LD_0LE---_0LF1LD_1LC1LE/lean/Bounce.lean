import Machine
import Seq

/-! Whole bounces of 1RB1RC_1LC0RC_0RA0LD_0LE---_0LF1LD_1LC1LE between the left end and the first wall, for every list of blocks (generated by `py/bounce.py`). -/

namespace H34590

open TM

/-- bounce_w00, stretch 0. -/
theorem bounce_w00_s0 (x : Nat) (K1 : Tape) :
    steps (2 * x + 6) ⟨blank, rep (x + 3) [true, false] (K1), .A⟩ = some ⟨rep (x + 3) [false, true] (blank), K1, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((x + 3) * 2) ⟨blank, rep (x + 3) [true, false] (K1), .A⟩ = some ⟨rep (x + 3) [false, true] (blank), K1, .A⟩ :=
    cross_r trans c0 (x + 3) (blank) (K1)
  exact steps_congr trans (a := (x + 3) * 2) (by omega) (h0)

/-- One block of bounce_w00, move 1. -/
theorem bounce_w00_b1 (p q : Nat) (L R : Tape) :
    steps (2 * p + 2 * q + 14) ⟨L, cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (R)))), .A⟩ = some ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), R, .A⟩ := by
  have h0 : steps 3 ⟨L, cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (R)))), .A⟩ = some ⟨cons false (cons false (cons true (L))), rep (p + 2) [true, false] (cons false (rep (q + 3) [true, false] (R))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((p + 2) * 2) ⟨cons false (cons false (cons true (L))), rep (p + 2) [true, false] (cons false (rep (q + 3) [true, false] (R))), .A⟩ = some ⟨rep (p + 2) [false, true] (cons false (cons false (cons true (L)))), cons false (rep (q + 3) [true, false] (R)), .A⟩ :=
    cross_r trans c1 (p + 2) (cons false (cons false (cons true (L)))) (cons false (rep (q + 3) [true, false] (R)))
  have h2 : steps 3 ⟨rep (p + 2) [false, true] (cons false (cons false (cons true (L)))), cons false (rep (q + 3) [true, false] (R)), .A⟩ = some ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), rep (q + 2) [true, false] (R), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((q + 2) * 2) ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), rep (q + 2) [true, false] (R), .A⟩ = some ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), R, .A⟩ :=
    cross_r trans c3 (q + 2) (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))) (R)
  exact steps_congr trans (a := 3 + ((p + 2) * 2 + (3 + ((q + 2) * 2)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- bounce_w00, stretch 2. -/
theorem bounce_w00_s2 (y z : Nat) (K0 R : Tape) :
    steps (4 * y + 16) ⟨K0, cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R))))), .A⟩ = some ⟨K0, cons true (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))))))), .F⟩ := by
  have h0 : steps 3 ⟨K0, cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R))))), .A⟩ = some ⟨cons false (cons false (cons true (K0))), rep (y + 2) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R)))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((y + 2) * 2) ⟨cons false (cons false (cons true (K0))), rep (y + 2) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R)))), .A⟩ = some ⟨rep (y + 2) [false, true] (cons false (cons false (cons true (K0)))), cons false (cons false (rep (z + 3) [true, false] (R))), .A⟩ :=
    cross_r trans c1 (y + 2) (cons false (cons false (cons true (K0)))) (cons false (cons false (rep (z + 3) [true, false] (R))))
  have h2 : steps 4 ⟨rep (y + 2) [false, true] (cons false (cons false (cons true (K0)))), cons false (cons false (rep (z + 3) [true, false] (R))), .A⟩ = some ⟨rep (y + 1) [false, true] (cons false (cons false (cons true (K0)))), cons true (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((y + 1) * 2) ⟨rep (y + 1) [false, true] (cons false (cons false (cons true (K0)))), cons true (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))), .E⟩ = some ⟨cons false (cons false (cons true (K0))), cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R)))))), .E⟩ :=
    cross_l trans c3 (y + 1) (cons false (cons false (cons true (K0)))) (cons false (cons false (cons true (rep (z + 3) [true, false] (R)))))
  have h4 : steps 3 ⟨cons false (cons false (cons true (K0))), cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R)))))), .E⟩ = some ⟨K0, cons true (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))))))), .F⟩ := rfl
  exact steps_congr trans (a := 3 + ((y + 2) * 2 + (4 + ((y + 1) * 2 + (3))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- One block of bounce_w00, move 3. -/
theorem bounce_w00_b3 (p q : Nat) (L R : Tape) :
    steps (2 * p + 2 * q + 14) ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), cons true (R), .F⟩ = some ⟨L, cons true (cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))))))), .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [false, true] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((q + 2) * 2) ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), cons true (R), .F⟩ = some ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), cons true (rep (q + 2) [false, true] (R)), .F⟩ :=
    cross_l trans c0 (q + 2) (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))) (R)
  have h1 : steps 5 ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), cons true (rep (q + 2) [false, true] (R)), .F⟩ = some ⟨rep (p + 1) [false, true] (cons false (cons false (cons true (L)))), cons true (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))), .E⟩ := rfl
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((p + 1) * 2) ⟨rep (p + 1) [false, true] (cons false (cons false (cons true (L)))), cons true (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))), .E⟩ = some ⟨cons false (cons false (cons true (L))), cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R)))))))), .E⟩ :=
    cross_l trans c2 (p + 1) (cons false (cons false (cons true (L)))) (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R)))))))
  have h3 : steps 3 ⟨cons false (cons false (cons true (L))), cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R)))))))), .E⟩ = some ⟨L, cons true (cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))))))), .F⟩ := rfl
  exact steps_congr trans (a := (q + 2) * 2 + (5 + ((p + 1) * 2 + (3)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- bounce_w00, stretch 4. -/
theorem bounce_w00_s4 (x : Nat) (K1 : Tape) :
    steps (2 * x + 10) ⟨rep (x + 3) [false, true] (blank), cons true (K1), .F⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (K1)))), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [false, true] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((x + 3) * 2) ⟨rep (x + 3) [false, true] (blank), cons true (K1), .F⟩ = some ⟨blank, cons true (rep (x + 3) [false, true] (K1)), .F⟩ :=
    cross_l trans c0 (x + 3) (blank) (K1)
  have h1 : steps 4 ⟨blank, cons true (rep (x + 3) [false, true] (K1)), .F⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (K1)))), .A⟩ := rfl
  exact steps_congr trans (a := (x + 3) * 2 + (4)) (by omega) (steps_seq trans h0 (h1))

/-- A bounce against a wall in phase `0 0`: from the left end in state A back to the left end in state A, for every list `ts` of pairs of blocks; the wall becomes `0 1`. -/
theorem bounce_w00 (x y z : Nat) (ts : List (Nat × Nat)) (R : Tape) :
    ∃ n, steps n ⟨blank, rep (x + 3) [true, false] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R))))))), .A⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))))))))))), .A⟩ := by
  have h0 : ∃ n, steps n ⟨blank, rep (x + 3) [true, false] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R))))))), .A⟩ = some ⟨rep (x + 3) [false, true] (blank), sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R)))))), .A⟩ :=
    ⟨_, bounce_w00_s0 x (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R)))))))⟩
  have h1 : ∃ n, steps n ⟨rep (x + 3) [false, true] (blank), sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R)))))), .A⟩ = some ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R))))), .A⟩ :=
    seqR (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) (fun Y => Y) .A (fun p L R => match p with | (p, q) => ⟨_, bounce_w00_b1 p q L R⟩) ts (rep (x + 3) [false, true] (blank)) (cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R))))))
  have h2 : ∃ n, steps n ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons false (rep (y + 3) [true, false] (cons false (cons false (rep (z + 3) [true, false] (R))))), .A⟩ = some ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons true (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))))))), .F⟩ :=
    ⟨_, bounce_w00_s2 y z (sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank))) R⟩
  have h3 : ∃ n, steps n ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons true (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))))))), .F⟩ = some ⟨rep (x + 3) [false, true] (blank), cons true (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R)))))))))), .F⟩ :=
    seqL' (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) (fun Y => cons true (Y)) .F (fun p L R => match p with | (p, q) => ⟨_, bounce_w00_b3 p q L R⟩) ts (rep (x + 3) [false, true] (blank)) (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R)))))))))
  have h4 : ∃ n, steps n ⟨rep (x + 3) [false, true] (blank), cons true (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R)))))))))), .F⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))))))))))), .A⟩ :=
    ⟨_, bounce_w00_s4 x (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (rep (z + 3) [true, false] (R))))))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

/-- bounce_w01, stretch 0. -/
theorem bounce_w01_s0 (x : Nat) (K1 : Tape) :
    steps (2 * x + 6) ⟨blank, rep (x + 3) [true, false] (K1), .A⟩ = some ⟨rep (x + 3) [false, true] (blank), K1, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((x + 3) * 2) ⟨blank, rep (x + 3) [true, false] (K1), .A⟩ = some ⟨rep (x + 3) [false, true] (blank), K1, .A⟩ :=
    cross_r trans c0 (x + 3) (blank) (K1)
  exact steps_congr trans (a := (x + 3) * 2) (by omega) (h0)

/-- One block of bounce_w01, move 1. -/
theorem bounce_w01_b1 (p q : Nat) (L R : Tape) :
    steps (2 * p + 2 * q + 14) ⟨L, cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (R)))), .A⟩ = some ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), R, .A⟩ := by
  have h0 : steps 3 ⟨L, cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (R)))), .A⟩ = some ⟨cons false (cons false (cons true (L))), rep (p + 2) [true, false] (cons false (rep (q + 3) [true, false] (R))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((p + 2) * 2) ⟨cons false (cons false (cons true (L))), rep (p + 2) [true, false] (cons false (rep (q + 3) [true, false] (R))), .A⟩ = some ⟨rep (p + 2) [false, true] (cons false (cons false (cons true (L)))), cons false (rep (q + 3) [true, false] (R)), .A⟩ :=
    cross_r trans c1 (p + 2) (cons false (cons false (cons true (L)))) (cons false (rep (q + 3) [true, false] (R)))
  have h2 : steps 3 ⟨rep (p + 2) [false, true] (cons false (cons false (cons true (L)))), cons false (rep (q + 3) [true, false] (R)), .A⟩ = some ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), rep (q + 2) [true, false] (R), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((q + 2) * 2) ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), rep (q + 2) [true, false] (R), .A⟩ = some ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), R, .A⟩ :=
    cross_r trans c3 (q + 2) (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))) (R)
  exact steps_congr trans (a := 3 + ((p + 2) * 2 + (3 + ((q + 2) * 2)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- bounce_w01, stretch 2. -/
theorem bounce_w01_s2 (y z : Nat) (K0 R : Tape) :
    steps (4 * y + 18) ⟨K0, cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R))))), .A⟩ = some ⟨K0, cons true (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))))))), .F⟩ := by
  have h0 : steps 3 ⟨K0, cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R))))), .A⟩ = some ⟨cons false (cons false (cons true (K0))), rep (y + 2) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R)))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((y + 2) * 2) ⟨cons false (cons false (cons true (K0))), rep (y + 2) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R)))), .A⟩ = some ⟨rep (y + 2) [false, true] (cons false (cons false (cons true (K0)))), cons false (cons true (rep (z + 3) [true, false] (R))), .A⟩ :=
    cross_r trans c1 (y + 2) (cons false (cons false (cons true (K0)))) (cons false (cons true (rep (z + 3) [true, false] (R))))
  have h2 : steps 4 ⟨rep (y + 2) [false, true] (cons false (cons false (cons true (K0)))), cons false (cons true (rep (z + 3) [true, false] (R))), .A⟩ = some ⟨rep (y + 2) [false, true] (cons false (cons false (cons true (K0)))), cons true (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((y + 2) * 2) ⟨rep (y + 2) [false, true] (cons false (cons false (cons true (K0)))), cons true (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))), .E⟩ = some ⟨cons false (cons false (cons true (K0))), cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R)))))), .E⟩ :=
    cross_l trans c3 (y + 2) (cons false (cons false (cons true (K0)))) (cons false (cons false (cons false (rep (z + 2) [true, false] (R)))))
  have h4 : steps 3 ⟨cons false (cons false (cons true (K0))), cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R)))))), .E⟩ = some ⟨K0, cons true (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))))))), .F⟩ := rfl
  exact steps_congr trans (a := 3 + ((y + 2) * 2 + (4 + ((y + 2) * 2 + (3))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- One block of bounce_w01, move 3. -/
theorem bounce_w01_b3 (p q : Nat) (L R : Tape) :
    steps (2 * p + 2 * q + 14) ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), cons true (R), .F⟩ = some ⟨L, cons true (cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))))))), .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [false, true] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((q + 2) * 2) ⟨rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))), cons true (R), .F⟩ = some ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), cons true (rep (q + 2) [false, true] (R)), .F⟩ :=
    cross_l trans c0 (q + 2) (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L)))))))) (R)
  have h1 : steps 5 ⟨cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (L))))))), cons true (rep (q + 2) [false, true] (R)), .F⟩ = some ⟨rep (p + 1) [false, true] (cons false (cons false (cons true (L)))), cons true (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))), .E⟩ := rfl
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h2 : steps ((p + 1) * 2) ⟨rep (p + 1) [false, true] (cons false (cons false (cons true (L)))), cons true (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))), .E⟩ = some ⟨cons false (cons false (cons true (L))), cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R)))))))), .E⟩ :=
    cross_l trans c2 (p + 1) (cons false (cons false (cons true (L)))) (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R)))))))
  have h3 : steps 3 ⟨cons false (cons false (cons true (L))), cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R)))))))), .E⟩ = some ⟨L, cons true (cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (R))))))))))), .F⟩ := rfl
  exact steps_congr trans (a := (q + 2) * 2 + (5 + ((p + 1) * 2 + (3)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- bounce_w01, stretch 4. -/
theorem bounce_w01_s4 (x : Nat) (K1 : Tape) :
    steps (2 * x + 10) ⟨rep (x + 3) [false, true] (blank), cons true (K1), .F⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (K1)))), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [false, true] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((x + 3) * 2) ⟨rep (x + 3) [false, true] (blank), cons true (K1), .F⟩ = some ⟨blank, cons true (rep (x + 3) [false, true] (K1)), .F⟩ :=
    cross_l trans c0 (x + 3) (blank) (K1)
  have h1 : steps 4 ⟨blank, cons true (rep (x + 3) [false, true] (K1)), .F⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (K1)))), .A⟩ := rfl
  exact steps_congr trans (a := (x + 3) * 2 + (4)) (by omega) (steps_seq trans h0 (h1))

/-- A bounce against a wall in phase `0 1`: the wall becomes `0 0` one a further right, eating one a of the block after it. -/
theorem bounce_w01 (x y z : Nat) (ts : List (Nat × Nat)) (R : Tape) :
    ∃ n, steps n ⟨blank, rep (x + 3) [true, false] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R))))))), .A⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))))))))))), .A⟩ := by
  have h0 : ∃ n, steps n ⟨blank, rep (x + 3) [true, false] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R))))))), .A⟩ = some ⟨rep (x + 3) [false, true] (blank), sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R)))))), .A⟩ :=
    ⟨_, bounce_w01_s0 x (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R)))))))⟩
  have h1 : ∃ n, steps n ⟨rep (x + 3) [false, true] (blank), sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) ts (cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R)))))), .A⟩ = some ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R))))), .A⟩ :=
    seqR (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (rep (p + 3) [true, false] (cons false (rep (q + 3) [true, false] (X))))) (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) (fun Y => Y) .A (fun p L R => match p with | (p, q) => ⟨_, bounce_w01_b1 p q L R⟩) ts (rep (x + 3) [false, true] (blank)) (cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R))))))
  have h2 : ∃ n, steps n ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons false (rep (y + 3) [true, false] (cons false (cons true (rep (z + 3) [true, false] (R))))), .A⟩ = some ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons true (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))))))), .F⟩ :=
    ⟨_, bounce_w01_s2 y z (sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank))) R⟩
  have h3 : ∃ n, steps n ⟨sqr (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) ts (rep (x + 3) [false, true] (blank)), cons true (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))))))), .F⟩ = some ⟨rep (x + 3) [false, true] (blank), cons true (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R)))))))))), .F⟩ :=
    seqL' (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => rep (q + 2) [false, true] (cons false (cons false (cons true (rep (p + 2) [false, true] (cons false (cons false (cons true (X))))))))) (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) (fun Y => cons true (Y)) .F (fun p L R => match p with | (p, q) => ⟨_, bounce_w01_b3 p q L R⟩) ts (rep (x + 3) [false, true] (blank)) (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R)))))))))
  have h4 : ∃ n, steps n ⟨rep (x + 3) [false, true] (blank), cons true (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R)))))))))), .F⟩ = some ⟨cons false (blank), cons true (cons false (cons true (rep (x + 3) [false, true] (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))))))))))), .A⟩ :=
    ⟨_, bounce_w01_s4 x (sq (fun (p : Nat × Nat) (X : Tape) => match p with | (p, q) => cons false (cons false (cons true (rep (p + 1) [false, true] (cons false (cons false (cons true (cons false (cons true (rep (q + 2) [false, true] (X))))))))))) ts (cons false (cons false (cons true (rep (y + 2) [false, true] (cons false (cons false (cons false (rep (z + 2) [true, false] (R))))))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

