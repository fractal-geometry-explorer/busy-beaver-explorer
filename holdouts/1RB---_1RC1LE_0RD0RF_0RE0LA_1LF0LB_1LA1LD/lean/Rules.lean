  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .C⟩ = some ⟨app [] (app [true, true] L), R, .C⟩ := fun _ _ => rfl
  have h3 : steps ((j) * 4) ⟨cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank))))), rep (j) [false, true] (cons false (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))), .C⟩ = some ⟨rep (j) [true, true] (cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank)))))), cons false (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank)))))))), .C⟩ :=
    cross_r trans c3 (j) (cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank)))))) (cons false (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank)))))))))
  have h4 : steps 8 ⟨rep (j) [true, true] (cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank)))))), cons false (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank)))))))), .C⟩ = some ⟨cons true (cons true (rep (j) [true, true] (cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank)))))))), cons true (cons true (rep (k + 1) [true, false] (cons true (cons true (cons false (blank)))))), .E⟩ := rfl
