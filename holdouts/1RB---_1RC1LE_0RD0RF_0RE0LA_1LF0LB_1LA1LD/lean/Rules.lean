  have h0 : steps 3 ⟨rep (n) [true, true] (cons false (rep (4) [true] (blank))), cons true (blank), .C⟩ = some ⟨cons true (rep (n) [true, true] (cons false (rep (4) [true] (blank)))), cons true (blank), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (n) [true, true] (cons false (rep (4) [true] (blank)))), cons true (blank), .B⟩ = some ⟨rep (n) [true, true] (cons true (cons false (rep (4) [true] (blank)))), cons true (blank), .B⟩ := by
