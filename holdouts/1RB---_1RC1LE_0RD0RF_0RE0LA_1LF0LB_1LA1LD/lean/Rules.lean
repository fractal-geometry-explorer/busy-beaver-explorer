  have c11 : ∀ L R : Tape, steps 4 ⟨app [false] L, app [true, false] R, .E⟩ = some ⟨app [false] (app [false, true] L), R, .E⟩ := fun _ _ => rfl
  have h11 : steps ((n) * 4) ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))), rep (n) [true, false] (cons true (cons false (cons true (cons true (blank))))), .E⟩ = some ⟨cons false (rep (n) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))), cons true (cons false (cons true (cons true (blank)))), .E⟩ :=
    cross_r trans c11 (n) (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))) (cons true (cons false (cons true (cons true (blank)))))
  have h12 : steps 10 ⟨cons false (rep (n) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))), cons true (cons false (cons true (cons true (blank)))), .E⟩ = some ⟨cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))))), blank, .C⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((n) * 2 + (4 + (0 + ((n) * 4 + (10 + (0 + ((n) * 2 + (32 + (0 + ((n) * 4 + (10))))))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (h12)))))))))))))

