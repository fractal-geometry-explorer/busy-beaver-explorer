  have h2 : steps ((n) * 2) ⟨rep (n) [true, true] (cons true (cons true (cons false (rep (4) [true] (blank))))), cons true (cons true (blank)), .B⟩ = some ⟨cons true (cons true (cons false (rep (4) [true] (blank)))), cons true (rep (n) [false, true] (cons true (blank))), .B⟩ :=
    cross_l trans c2 (n) (cons true (cons true (cons false (rep (4) [true] (blank))))) (cons true (blank))
  have h3 : steps 6 ⟨cons true (cons true (cons false (rep (4) [true] (blank)))), cons true (rep (n) [false, true] (cons true (blank))), .B⟩ = some ⟨rep (1) [true] (blank), cons true (cons false (cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (cons true (blank))))))))), .A⟩ := rfl
  exact steps_congr trans (a := 5 + (0 + ((n) * 2 + (6)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- ... and halts there. -/
theorem halt0 (n : Nat) : step ⟨rep (1) [true] (blank), cons true (cons false (cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (cons true (blank))))))))), .A⟩ = none := rfl

/-- From (0, 2n+1) with the head on 1 the machine runs into its halting transition A1. -/
theorem toHalt1 (n : Nat) :
    steps (2 * n + 9) ⟨rep (n) [true, true] (cons true (cons false (rep (4) [true] (blank)))), cons true (blank), .C⟩ = some ⟨rep (1) [true] (blank), cons true (cons false (cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (blank)))))))), .A⟩ := by
  have h0 : steps 3 ⟨rep (n) [true, true] (cons true (cons false (rep (4) [true] (blank)))), cons true (blank), .C⟩ = some ⟨cons true (rep (n) [true, true] (cons true (cons false (rep (4) [true] (blank))))), cons true (blank), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (n) [true, true] (cons true (cons false (rep (4) [true] (blank))))), cons true (blank), .B⟩ = some ⟨rep (n) [true, true] (cons true (cons true (cons false (rep (4) [true] (blank))))), cons true (blank), .B⟩ := by
    simp only [steps_zero, show cons true (rep (n) [true, true] (cons true (cons false (rep (4) [true] (blank))))) = rep (n) [true, true] (cons true (cons true (cons false (rep (4) [true] (blank))))) from
      rep_rotate (n) [true] [true, true] [true, true] rfl (cons true (cons false (rep (4) [true] (blank))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 2) ⟨rep (n) [true, true] (cons true (cons true (cons false (rep (4) [true] (blank))))), cons true (blank), .B⟩ = some ⟨cons true (cons true (cons false (rep (4) [true] (blank)))), cons true (rep (n) [false, true] (blank)), .B⟩ :=
    cross_l trans c2 (n) (cons true (cons true (cons false (rep (4) [true] (blank))))) (blank)
  have h3 : steps 6 ⟨cons true (cons true (cons false (rep (4) [true] (blank)))), cons true (rep (n) [false, true] (blank)), .B⟩ = some ⟨rep (1) [true] (blank), cons true (cons false (cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (blank)))))))), .A⟩ := rfl
  exact steps_congr trans (a := 3 + (0 + ((n) * 2 + (6)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- ... and halts there. -/
theorem halt1 (n : Nat) : step ⟨rep (1) [true] (blank), cons true (cons false (cons true (cons true (cons true (cons false (cons true (rep (n) [false, true] (blank)))))))), .A⟩ = none := rfl

end H26350
