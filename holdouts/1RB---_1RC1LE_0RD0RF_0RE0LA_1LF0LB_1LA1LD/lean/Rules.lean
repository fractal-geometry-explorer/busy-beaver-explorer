      rep_rotate (n) [true] [true, true] [true, true] rfl (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank)))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 2) ⟨rep (n) [true, true] (cons true (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank)))))), cons true (blank), .B⟩ = some ⟨cons true (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank))))), cons true (rep (n) [false, true] (blank)), .B⟩ :=
    cross_l trans c2 (n) (cons true (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank)))))) (blank)
  have h3 : steps 56 ⟨cons true (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank))))), cons true (rep (n) [false, true] (blank)), .B⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), cons true (rep (n) [false, true] (blank)), .D⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), cons true (rep (n) [false, true] (blank)), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), rep (n) [true, false] (cons true (blank)), .D⟩ := by
    simp only [steps_zero, show cons true (rep (n) [false, true] (blank)) = rep (n) [true, false] (cons true (blank)) from
      rep_rotate (n) [true] [false, true] [true, false] rfl (blank)]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [false] L, app [true, false] R, .D⟩ = some ⟨app [false] (app [true, true] L), R, .D⟩ := fun _ _ => rfl
  have h5 : steps ((n) * 4) ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))), rep (n) [true, false] (cons true (blank)), .D⟩ = some ⟨cons false (rep (n) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))))))), cons true (blank), .D⟩ :=
    cross_r trans c5 (n) (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))) (cons true (blank))
  have h6 : steps 3 ⟨cons false (rep (n) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))))))), cons true (blank), .D⟩ = some ⟨cons true (cons true (rep (n) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))))), blank, .C⟩ := rfl
