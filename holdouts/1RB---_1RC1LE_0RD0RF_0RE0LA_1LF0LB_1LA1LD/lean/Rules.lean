  have h1 : steps 0 ⟨cons true (rep (n) [true, true] (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank)))))), cons true (blank), .B⟩ = some ⟨rep (n) [true, true] (cons true (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank)))))), cons true (blank), .B⟩ := by
