      rep_rotate (n) [true] [false, true] [true, false] rfl (blank)]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [false] L, app [true, false] R, .D⟩ = some ⟨app [false] (app [true, true] L), R, .D⟩ := fun _ _ => rfl
  have h5 : steps ((n) * 4) ⟨cons false (cons true (rep (4) [true] (blank))), rep (n) [true, false] (cons true (blank)), .D⟩ = some ⟨cons false (rep (n) [true, true] (cons true (rep (4) [true] (blank)))), cons true (blank), .D⟩ :=
    cross_r trans c5 (n) (cons true (rep (4) [true] (blank))) (cons true (blank))
  have h6 : steps 10 ⟨cons false (rep (n) [true, true] (cons true (rep (4) [true] (blank)))), cons true (blank), .D⟩ = some ⟨cons true (rep (n) [true, true] (cons true (rep (4) [true] (blank)))), cons true (cons false (cons true (cons true (blank)))), .B⟩ := rfl
  have h7 : steps 0 ⟨cons true (rep (n) [true, true] (cons true (rep (4) [true] (blank)))), cons true (cons false (cons true (cons true (blank)))), .B⟩ = some ⟨rep (n) [true, true] (cons true (cons true (rep (4) [true] (blank)))), cons true (cons false (cons true (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (n) [true, true] (cons true (rep (4) [true] (blank)))) = rep (n) [true, true] (cons true (cons true (rep (4) [true] (blank)))) from
      rep_rotate (n) [true] [true, true] [true, true] rfl (cons true (rep (4) [true] (blank)))]
  have c8 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, true] R), .B⟩ := fun _ _ => rfl
  have h8 : steps ((n) * 2) ⟨rep (n) [true, true] (cons true (cons true (rep (4) [true] (blank)))), cons true (cons false (cons true (cons true (blank)))), .B⟩ = some ⟨cons true (cons true (rep (4) [true] (blank))), cons true (rep (n) [false, true] (cons false (cons true (cons true (blank))))), .B⟩ :=
    cross_l trans c8 (n) (cons true (cons true (rep (4) [true] (blank)))) (cons false (cons true (cons true (blank))))
  have h9 : steps 32 ⟨cons true (cons true (rep (4) [true] (blank))), cons true (rep (n) [false, true] (cons false (cons true (cons true (blank))))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))), cons true (rep (n) [false, true] (cons false (cons true (cons true (blank))))), .E⟩ := rfl
  have h10 : steps 0 ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))), cons true (rep (n) [false, true] (cons false (cons true (cons true (blank))))), .E⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank)))))))))), rep (n) [true, false] (cons true (cons false (cons true (cons true (blank))))), .E⟩ := by
