    steps (6 * n + 62) ⟨rep (n) [true, true] (cons true (rep (1) [false, true] (cons false (rep (4) [true] (blank))))), cons true (blank), .C⟩ = some ⟨cons true (cons true (rep (n) [true, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons true (cons true (blank))))))))))))))), blank, .C⟩ := by
