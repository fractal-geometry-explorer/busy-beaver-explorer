    cross_l trans c0 (j) (rep (i + 1) [false, true] (cons false (rep (4) [true] (blank)))) (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))
  have h1 : steps 2 ⟨rep (i + 1) [false, true] (cons false (rep (4) [true] (blank))), cons true (rep (j) [true, false] (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))), .E⟩ = some ⟨cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank))))), cons false (rep (j) [true, false] (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))), .C⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank))))), cons false (rep (j) [true, false] (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))), .C⟩ = some ⟨cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank))))), rep (j) [false, true] (cons false (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (j) [true, false] (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))) = rep (j) [false, true] (cons false (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank))))))))) from
