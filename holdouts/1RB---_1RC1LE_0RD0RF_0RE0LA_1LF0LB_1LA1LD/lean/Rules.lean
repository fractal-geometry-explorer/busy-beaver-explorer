/-- Rule C, one cycle (s = 0): Q0(i+1, j, k+1) -> Q0(i, j+2, k). -/
theorem cyc_0 (i j k : Nat) :
    steps (6 * j + 10) ⟨rep (j) [true, true] (rep (i + 1) [false, true] (cons false (rep (4) [true] (blank)))), cons true (cons true (cons true (cons false (rep (k + 1) [true, false] (cons true (cons true (cons false (blank)))))))), .E⟩ = some ⟨cons true (cons true (rep (j) [true, true] (cons true (cons true (rep (i) [false, true] (cons false (rep (4) [true] (blank)))))))), cons true (cons true (rep (k + 1) [true, false] (cons true (cons true (cons false (blank)))))), .E⟩ := by
