      rep_rotate (n) [true] [true, true] [true, true] rfl (cons false (rep (4) [true] (blank)))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [false, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 2) ⟨rep (n) [true, true] (cons true (cons false (rep (4) [true] (blank)))), cons true (blank), .B⟩ = some ⟨cons true (cons false (rep (4) [true] (blank))), cons true (rep (n) [false, true] (blank)), .B⟩ :=
    cross_l trans c2 (n) (cons true (cons false (rep (4) [true] (blank)))) (blank)
  have h3 : steps 4 ⟨cons true (cons false (rep (4) [true] (blank))), cons true (rep (n) [false, true] (blank)), .B⟩ = some ⟨cons false (cons true (rep (4) [true] (blank))), cons true (rep (n) [false, true] (blank)), .D⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (rep (4) [true] (blank))), cons true (rep (n) [false, true] (blank)), .D⟩ = some ⟨cons false (cons true (rep (4) [true] (blank))), rep (n) [true, false] (cons true (blank)), .D⟩ := by
