/-!
# One bounce of the zone is one row of Pascal's triangle mod 2

The zone is a word of 4-cell letters `u = 1110` (the bit `true`) and `v = 1111` (`false`) at the left end of the tape,
after an optional prefix cell (`S` below is the tape left of the zone: blank, or one 1 then blank).  At a right turn
the head is in E, just right of the zone, on the first cell of a block `1 1 1` of the frozen tape.

`bounce`: whatever the word, one bounce (left sweep in C/D, the left end, right sweep in F) brings the head back to a
right turn with the zone `T w` and the frozen tape two cells shorter, where `T w` is the running XOR of the word
`w 1` read from the right.  So the zone is one row further down Pascal's triangle mod 2 (`tmap`, `bounce`).

Words are listed nearest the head first, i.e. right to left.
-/

namespace H75625W

open TM

/-- A 4-cell letter as it lies on the left tape, nearest cell first: `u = 1110` (true), `v = 1111` (false). -/
def lt : Bool → List Bool
  | true => [false, true, true, true]
  | false => [true, true, true, true]

/-- The zone on the left tape: the letters of `ws` (nearest first) in front of the tape `S`. -/
def zl : List Bool → Tape → Tape
  | [], s => s
  | a :: ws, s => app (lt a) (zl ws s)

/-- Running XOR from parity `q`, nearest letter first. -/
def sx : Bool → List Bool → List Bool
  | _, [] => []
  | q, a :: ws => bne q a :: sx (bne q a) ws

/-- The bounce map: append a `1` on the right (nearest) and take the running XOR from the right. -/
def tmap (ws : List Bool) : List Bool := true :: sx true ws

/-- The parity state of the left sweep: C is odd (`true`), D is even (`false`). -/
def pst : Bool → St
  | true => .C
  | false => .D

/-- What the left sweep leaves for parity `q`, left to right: `0101` (odd) or `1111` (even). -/
def ol : Bool → List Bool
  | true => [false, true, false, true]
  | false => [true, true, true, true]

/-- What the right sweep leaves for it, nearest first: `1011` read right to left, or `1111`. -/
def rl : Bool → List Bool
  | true => [true, true, false, true]
  | false => [true, true, true, true]

/-- The head on the first cell of the tape `X` to its left (the shape a left move produces). -/
def onL (X R : Tape) (q : St) : Config := ⟨tail X, cons (X 0) R, q⟩

theorem eta (X : Tape) : X = cons (X 0) (tail X) := by
  funext n; cases n <;> rfl

/-- One letter of the left sweep. -/
theorem sweep1 (a q : Bool) (Y R : Tape) :
    steps 4 (onL (app (lt a) Y) R (pst q)) = some (onL Y (app (ol (bne q a)) R) (pst (bne q a))) := by
  rw [eta Y]
  cases a <;> cases q <;> cases h : Y 0 <;> rfl

/-- The tape right of the head after the left sweep: the letters it left, last one nearest. -/
def sweepR : Bool → List Bool → Tape → Tape
  | _, [], R => R
  | q, a :: ws, R => sweepR (bne q a) ws (app (ol (bne q a)) R)

/-- The parity at the end of the left sweep. -/
def par : Bool → List Bool → Bool
  | q, [] => q
  | q, a :: ws => par (bne q a) ws

/-- The left sweep over the whole zone. -/
theorem sweep (ws : List Bool) (S : Tape) :
    ∀ (q : Bool) (R : Tape), steps (4 * ws.length) (onL (zl ws S) R (pst q)) = some (onL S (sweepR q ws R) (pst (par q ws))) := by
  induction ws with
  | nil => intro q R; rfl
  | cons a ws ih =>
    intro q R
    have h2 := ih (bne q a) (app (ol (bne q a)) R)
    have e : 4 * (a :: ws).length = 4 + 4 * ws.length := by simp [List.length]; omega
    rw [e]
    exact steps_seq trans (sweep1 a q (zl ws S) R) h2

/-- One letter of the right sweep: F crosses `0101` leaving `1011`, and `1111` leaving it. -/
theorem rsweep1 (c : Bool) (L R : Tape) :
    steps 4 ⟨L, app (ol c) R, .F⟩ = some ⟨app (rl c) L, R, .F⟩ := by
  cases c <;> rfl

/-- The tape left of the head after the right sweep. -/
def rsweepL : Bool → List Bool → Tape → Tape
  | _, [], L => L
  | q, a :: ws, L => app (rl (bne q a)) (rsweepL (bne q a) ws L)

/-- The right sweep over everything the left sweep left. -/
theorem rsweep (ws : List Bool) :
    ∀ (q : Bool) (L R : Tape), steps (4 * ws.length) ⟨L, sweepR q ws R, .F⟩ = some ⟨rsweepL q ws L, R, .F⟩ := by
  induction ws with
  | nil => intro q L R; rfl
  | cons a ws ih =>
    intro q L R
    have h1 := ih (bne q a) L (app (ol (bne q a)) R)
    have h2 := rsweep1 (bne q a) (rsweepL (bne q a) ws L) R
    have e : 4 * (a :: ws).length = 4 * ws.length + 4 := by simp [List.length]; omega
    rw [e]
    exact steps_seq trans h1 h2

/-- The tape left of the zone: blank, or a single 1 then blank. -/
def pre : Bool → Tape
  | false => blank
  | true => cons true blank

/-- The left end: in D the prefix stays, in C it toggles; either way F starts the right sweep after `1 1`. -/
def lsteps : Bool → Bool → Nat
  | false, true => 5
  | false, false => 3
  | true, true => 3
  | true, false => 5

theorem lend (p q : Bool) (R : Tape) :
    steps (lsteps p q) (onL (pre p) R (pst q)) = some ⟨app [true, true] (pre (bne p q)), R, .F⟩ := by
  cases p <;> cases q
  · -- p = '', D
    show steps 3 ⟨tail blank, cons (blank 0) R, .D⟩ = some ⟨cons true (cons true blank), R, .F⟩
    rw [tail_blank]; rfl
  · -- p = '', C : the prefix becomes one 1
    show steps 5 ⟨tail blank, cons (blank 0) R, .C⟩ = some ⟨cons true (cons true (cons true blank)), R, .F⟩
    rw [tail_blank]
    show steps 5 ⟨blank, cons false R, .C⟩ = some ⟨cons true (cons true (cons true blank)), R, .F⟩
    rfl
  · -- p = '1', D
    show steps 5 ⟨tail (cons true blank), cons true R, .D⟩ = some ⟨cons true (cons true (cons true blank)), R, .F⟩
    rw [tail_cons]; rfl
  · -- p = '1', C : the prefix goes
    show steps 3 ⟨tail (cons true blank), cons true R, .C⟩ = some ⟨cons true (cons true blank), R, .F⟩
    rw [tail_cons]; rfl

/-- The right sweep's output, regrouped into the letters of the new zone: `1011 1011 ... 11` is `11 1110 1110 ...`. -/
theorem regroup (ws : List Bool) :
    ∀ (q : Bool) (S : Tape), rsweepL q ws (app [true, true] S) = app [true, true] (zl (sx q ws) S) := by
  induction ws with
  | nil => intro q S; rfl
  | cons a ws ih =>
    intro q S
    show app (rl (bne q a)) (rsweepL (bne q a) ws (app [true, true] S)) =
      app [true, true] (app (lt (bne q a)) (zl (sx (bne q a) ws) S))
    rw [ih (bne q a) S]
    cases bne q a <;> rfl

/-- The zone's new prefix: in D it stays, in C it toggles. -/
def npre (p : Bool) (ws : List Bool) : Bool := bne p (par true ws)

/-- **One bounce.**  From a right turn with zone `ws` (prefix `p`) and frozen tape `1 1 1 R`, the machine comes back to
a right turn with zone `tmap ws`, prefix `npre p ws`, and frozen tape `1 R`. -/
theorem bounce (ws : List Bool) (p : Bool) (R : Tape) :
    steps (1 + 4 * ws.length + lsteps p (par true ws) + 4 * ws.length + 2)
      ⟨zl ws (pre p), cons true (cons true (cons true R)), .E⟩ =
      some ⟨zl (tmap ws) (pre (npre p ws)), cons true R, .E⟩ := by
  -- E on the frozen 1: write 0, step left into the zone in C (odd)
  have h0 : steps 1 ⟨zl ws (pre p), cons true (cons true (cons true R)), .E⟩ =
      some (onL (zl ws (pre p)) (cons false (cons true (cons true R))) (pst true)) := rfl
  have h1 := sweep ws (pre p) true (cons false (cons true (cons true R)))
  have h2 := lend p (par true ws) (sweepR true ws (cons false (cons true (cons true R))))
  have h3 := rsweep ws true (app [true, true] (pre (bne p (par true ws)))) (cons false (cons true (cons true R)))
  -- F> 0 1 1: F writes 1, A writes 0, E reads the 1: the new right turn
  have h4 : steps 2 ⟨rsweepL true ws (app [true, true] (pre (bne p (par true ws)))), cons false (cons true (cons true R)), .F⟩ =
      some ⟨cons false (cons true (rsweepL true ws (app [true, true] (pre (bne p (par true ws)))))), cons true R, .E⟩ := rfl
  have e : cons false (cons true (rsweepL true ws (app [true, true] (pre (bne p (par true ws)))))) =
      zl (tmap ws) (pre (npre p ws)) := by
    rw [regroup]; rfl
  rw [e] at h4
  exact steps_seq trans (steps_seq trans (steps_seq trans (steps_seq trans h0 h1) h2) h3) h4

/-! ## A frozen block of length `2k + 1`

At a right turn the frozen tape starts with a block of 1s under the head.  Each bounce takes two of its cells (`bounce`).
A block of length `2k + 1` therefore gives `k` bounces, `tmap` applied `k` times, and leaves a single 1 under the head.
If a 1 follows after one 0, the next bounce ends with F on `0 0 1` and the machine halts (`halts_of_odd`).  So away
from the right end of the tape, the machine halts as soon as it turns at a frozen block of odd length.
-/

/-- `tmap` applied `k` times. -/
def titer : Nat → List Bool → List Bool
  | 0, ws => ws
  | k + 1, ws => titer k (tmap ws)

/-- `k` bounces against a frozen block of `2k + 1` cells. -/
theorem bounces (k : Nat) : ∀ (ws : List Bool) (p : Bool) (R : Tape), ∃ n p',
    steps n ⟨zl ws (pre p), cons true (rep k [true, true] R), .E⟩ =
      some ⟨zl (titer k ws) (pre p'), cons true R, .E⟩ := by
  induction k with
  | zero => intro ws p R; exact ⟨0, p, rfl⟩
  | succ k ih =>
    intro ws p R
    obtain ⟨n, p', h⟩ := ih (tmap ws) (npre p ws) R
    refine ⟨_ + n, p', steps_seq trans (bounce ws p (rep k [true, true] R)) ?_⟩
    exact h

/-- After the left sweep, the left end and the right sweep, F reads `0 0 1`: one more step to the halt. -/
theorem halt_turn (ws : List Bool) (p : Bool) (R : Tape) :
    ∃ n c, steps n ⟨zl ws (pre p), cons true (cons false (cons true R)), .E⟩ = some c ∧ step c = none := by
  have h0 : steps 1 ⟨zl ws (pre p), cons true (cons false (cons true R)), .E⟩ =
      some (onL (zl ws (pre p)) (cons false (cons false (cons true R))) (pst true)) := rfl
  have h1 := sweep ws (pre p) true (cons false (cons false (cons true R)))
  have h2 := lend p (par true ws) (sweepR true ws (cons false (cons false (cons true R))))
  have h3 := rsweep ws true (app [true, true] (pre (bne p (par true ws)))) (cons false (cons false (cons true R)))
  have h4 : steps 2 ⟨rsweepL true ws (app [true, true] (pre (bne p (par true ws)))), cons false (cons false (cons true R)), .F⟩ =
      some ⟨cons true (cons true (rsweepL true ws (app [true, true] (pre (bne p (par true ws)))))), cons true R, .B⟩ := rfl
  exact ⟨_, _, steps_seq trans (steps_seq trans (steps_seq trans (steps_seq trans h0 h1) h2) h3) h4, rfl⟩

/-- **A right turn at a frozen block of odd length halts.**  Zone `ws` (any word, either prefix), frozen tape
`1^(2k+1) 0 1 ...`: the machine halts. -/
theorem halts_of_odd (k : Nat) (ws : List Bool) (p : Bool) (R : Tape) :
    Halts trans ⟨zl ws (pre p), cons true (rep k [true, true] (cons false (cons true R))), .E⟩ := by
  obtain ⟨n, p', h⟩ := bounces k ws p (cons false (cons true R))
  obtain ⟨m, c, hm, hc⟩ := halt_turn (titer k ws) p' R
  exact ⟨n + m, c, steps_seq trans h hm, hc⟩

end H75625W
