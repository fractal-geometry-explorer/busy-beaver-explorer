import Machine

/-! # The left-going pass and the block of `111110` words

Generated by `py/gen_rules.py` with `bbtools.symtm.prove`: every theorem is a run of the machine for all values of
the variables and every tape `L`, `R`, proved by `rfl` steps and the shift rules `cross_l`, `cross_r`.
Left tapes are written nearest the head first, so `(011111)^n` on the page is `rep n [true, true, true, true, true, false]` here. -/

namespace H117020

open TM

/-- The pass on the separator right of a block of length 1 that has `0 0` on its left: three steps later F reads 0, the halting transition. -/
theorem halt_pass (L R : Tape) :
    steps (3) ⟨cons true (cons false (cons false (L))), cons false (R), .E⟩ = some ⟨L, cons false (cons true (cons true (cons false (R)))), .F⟩ := by
  have h0 : steps 3 ⟨cons true (cons false (cons false (L))), cons false (R), .E⟩ = some ⟨L, cons false (cons true (cons true (cons false (R)))), .F⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)

/-- The pass over a block of length k+3: the block is cut into k+1 and 1 and the pass stands on the next separator. -/
theorem pass_split (k : Nat) (L R : Tape) :
    steps (k + 4) ⟨cons true (cons true (cons true (rep (k) [true] (cons false (L))))), cons false (R), .E⟩ = some ⟨L, cons false (cons true (rep (k) [true] (cons false (cons true (cons false (R)))))), .E⟩ := by
  have h0 : steps 3 ⟨cons true (cons true (cons true (rep (k) [true] (cons false (L))))), cons false (R), .E⟩ = some ⟨rep (k) [true] (cons false (L)), cons true (cons false (cons true (cons false (R)))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true] R), .E⟩ := fun _ _ => rfl
  have h1 : steps ((k) * 1) ⟨rep (k) [true] (cons false (L)), cons true (cons false (cons true (cons false (R)))), .E⟩ = some ⟨cons false (L), cons true (rep (k) [true] (cons false (cons true (cons false (R))))), .E⟩ :=
    cross_l trans c1 (k) (cons false (L)) (cons false (cons true (cons false (R))))
  have h2 : steps 1 ⟨cons false (L), cons true (rep (k) [true] (cons false (cons true (cons false (R))))), .E⟩ = some ⟨L, cons false (cons true (rep (k) [true] (cons false (cons true (cons false (R)))))), .E⟩ := rfl
  exact steps_congr trans (a := 3 + ((k) * 1 + (1))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A block of length 1 with a 1 two cells to its left stops the pass: the separator left of it is filled and F, on a 1, turns the head around. -/
theorem pass_stop (L R : Tape) :
    steps (3) ⟨cons true (cons false (cons true (L))), cons false (R), .E⟩ = some ⟨L, cons true (cons true (cons true (cons false (R)))), .F⟩ := by
  have h0 : steps 3 ⟨cons true (cons false (cons true (L))), cons false (R), .E⟩ = some ⟨L, cons true (cons true (cons true (cons false (R)))), .F⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)

/-- The pass across n words `111110`: each becomes `1110 10`, six steps a word, in the same state. -/
theorem cross_left (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨rep (n) [true, true, true, true, true, false] (L), cons false (R), .E⟩ = some ⟨L, cons false (rep (n) [true, true, true, false, true, false] (R)), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 6 ⟨app [true, true, true, true, true, false] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [true, true, true, false, true, false] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨rep (n) [true, true, true, true, true, false] (L), cons false (R), .E⟩ = some ⟨L, cons false (rep (n) [true, true, true, false, true, false] (R)), .E⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 6) (by omega) (h0)

/-- The sweep back: B turns the same cells, read one cell later, back into words `111110`, six steps a word. -/
theorem cross_right (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨L, rep (n) [true, true, false, true, false, true] (R), .B⟩ = some ⟨rep (n) [true, true, true, true, true, false] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 6 ⟨app [] L, app [true, true, false, true, false, true] R, .B⟩ = some ⟨app [] (app [true, true, true, true, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨L, rep (n) [true, true, false, true, false, true] (R), .B⟩ = some ⟨rep (n) [true, true, true, true, true, false] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 6) (by omega) (h0)

end H117020
