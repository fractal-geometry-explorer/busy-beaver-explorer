/-- sweep to the left over 1s: every other cell is erased -/
theorem l_sweep (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)


/-- sweep to the left: a single 0 is filled and the sweep goes on -/
theorem l_gap1 (L R : Tape) :
    steps (2) ⟨cons false (cons true (L)), cons true (R), .C⟩ = some ⟨L, cons true (cons true (cons true (R))), .C⟩ := by
  have h0 : steps 2 ⟨cons false (cons true (L)), cons true (R), .C⟩ = some ⟨L, cons true (cons true (cons true (R))), .C⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)


/-- sweep to the left: at a gap of two or more 0s (C on the leftmost 1 of a block) the head turns and a new pass to the right starts, two cells further left -/
theorem l_turn (L R : Tape) :
    steps (3) ⟨cons false (cons false (L)), cons true (R), .C⟩ = some ⟨cons true (L), cons true (cons true (R)), .D⟩ := by
  have h0 : steps 3 ⟨cons false (cons false (L)), cons true (R), .C⟩ = some ⟨cons true (L), cons true (cons true (R)), .D⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)


/-- sweep to the left through the wall the pass leaves -/
theorem wall_l (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨rep (n) [true, true, true, true, false, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [true, true, false, true, false, true] (R)), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 6 ⟨app [true, true, true, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true, false, true, false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨rep (n) [true, true, true, true, false, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [true, true, false, true, false, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 6) (by omega) (h0)


/-- sweep to the left: B on the leftmost 1 of a block with exactly four 0s to its left: the machine halts (the only way to the halting transition A1) -/
theorem halt4 (L R : Tape) :
    steps (7) ⟨cons false (cons false (cons false (cons false (cons true (L))))), cons true (R), .B⟩ = some ⟨L, cons true (cons false (cons true (cons true (cons true (cons true (R)))))), .A⟩ := by
  have h0 : steps 7 ⟨cons false (cons false (cons false (cons false (cons true (L))))), cons true (R), .B⟩ = some ⟨L, cons true (cons false (cons true (cons true (cons true (cons true (R)))))), .A⟩ := rfl
  exact steps_congr trans (a := 7) (by omega) (h0)


