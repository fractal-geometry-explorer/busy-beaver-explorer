  have c1 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .D⟩ = some ⟨app [] (app [true] L), R, .D⟩ := fun _ _ => rfl
  have h1 : steps ((a + 2) * 1) ⟨cons true (cons true (L)), rep (a + 2) [true] (cons false (cons true (cons true (cons false (R))))), .D⟩ = some ⟨rep (a + 2) [true] (cons true (cons true (L))), cons false (cons true (cons true (cons false (R)))), .D⟩ :=
