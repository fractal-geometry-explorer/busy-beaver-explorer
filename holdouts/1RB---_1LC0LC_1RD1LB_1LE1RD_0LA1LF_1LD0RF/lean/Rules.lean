    cross_r trans c1 (a + 3) (cons true (cons true (L))) (cons false (cons true (cons false (R))))
  have h2 : steps 13 ⟨rep (a + 3) [true] (cons true (cons true (L))), cons false (cons true (cons false (R))), .D⟩ = some ⟨rep (a) [true] (cons true (cons true (L))), cons true (cons true (cons true (cons true (cons true (cons true (R)))))), .C⟩ := rfl
