  have h0 : steps 1 ⟨cons true (L), cons true (rep (a + 2) [true] (cons false (rep (b + 5) [true] (cons false (R))))), .D⟩ = some ⟨cons true (cons true (L)), rep (a + 2) [true] (cons false (rep (b + 5) [true] (cons false (R)))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .D⟩ = some ⟨app [] (app [true] L), R, .D⟩ := fun _ _ => rfl
  have h1 : steps ((a + 2) * 1) ⟨cons true (cons true (L)), rep (a + 2) [true] (cons false (rep (b + 5) [true] (cons false (R)))), .D⟩ = some ⟨rep (a + 2) [true] (cons true (cons true (L))), cons false (rep (b + 5) [true] (cons false (R))), .D⟩ :=
    cross_r trans c1 (a + 2) (cons true (cons true (L))) (cons false (rep (b + 5) [true] (cons false (R))))
  have h2 : steps 5 ⟨rep (a + 2) [true] (cons true (cons true (L))), cons false (rep (b + 5) [true] (cons false (R))), .D⟩ = some ⟨cons false (cons false (cons false (rep (a) [true] (cons true (cons true (L)))))), rep (b + 5) [true] (cons false (R)), .F⟩ := rfl
  have c3 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .F⟩ = some ⟨app [] (app [false] L), R, .F⟩ := fun _ _ => rfl
  have h3 : steps ((b + 5) * 1) ⟨cons false (cons false (cons false (rep (a) [true] (cons true (cons true (L)))))), rep (b + 5) [true] (cons false (R)), .F⟩ = some ⟨rep (b + 5) [false] (cons false (cons false (cons false (rep (a) [true] (cons true (cons true (L))))))), cons false (R), .F⟩ :=
    cross_r trans c3 (b + 5) (cons false (cons false (cons false (rep (a) [true] (cons true (cons true (L))))))) (cons false (R))
  have h4 : steps 8 ⟨rep (b + 5) [false] (cons false (cons false (cons false (rep (a) [true] (cons true (cons true (L))))))), cons false (R), .F⟩ = some ⟨cons true (rep (b) [false] (cons false (cons false (cons false (rep (a) [true] (cons true (cons true (L)))))))), cons true (cons true (cons true (cons true (cons true (R))))), .D⟩ := rfl
  exact steps_congr trans (a := 1 + ((a + 2) * 1 + (5 + ((b + 5) * 1 + (8))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))


