theorem b_turn7 (L R : Tape) :
    steps (12) ⟨rep (7) [false] (L), cons true (R), .B⟩ = some ⟨cons true (L), cons true (cons true (cons true (cons true (cons true (cons true (cons true (R))))))), .D⟩ := by
