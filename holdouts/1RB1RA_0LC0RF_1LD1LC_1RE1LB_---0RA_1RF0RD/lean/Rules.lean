import Machine

/-! The head's trips over the run of ones at the right. Generated by `py/rules.py`. -/

namespace H81504

open TM

/-- From a visit, B at the right end above a run of 2n+2 ones, down to the 0 below the run in C. -/
theorem descend (n : Nat) (L : Tape) :
    steps (2 * n + 3) ⟨rep (n + 1) [true, true] (cons false (L)), blank, .B⟩ = some ⟨L, cons false (cons true (cons true (rep (n) [true, true] (cons false (blank))))), .C⟩ := by
  have hn : 1 + (0 + ((n) * 2 + (2))) = 2 * n + 3 := by omega
  have h0 : steps 1 ⟨rep (n + 1) [true, true] (cons false (L)), blank, .B⟩ = some ⟨cons true (rep (n) [true, true] (cons false (L))), cons true (cons false (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (n) [true, true] (cons false (L))), cons true (cons false (blank)), .C⟩ = some ⟨rep (n) [true, true] (cons true (cons false (L))), cons true (cons false (blank)), .C⟩ := by
    simp only [steps_zero, show cons true (rep (n) [true, true] (cons false (L))) = rep (n) [true, true] (cons true (cons false (L))) from
      rep_rotate (n) [true] [true, true] [true, true] rfl (cons false (L))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((n) * 2) ⟨rep (n) [true, true] (cons true (cons false (L))), cons true (cons false (blank)), .C⟩ = some ⟨cons true (cons false (L)), cons true (rep (n) [true, true] (cons false (blank))), .C⟩ :=
    cross_l trans c2 (n) (cons true (cons false (L))) (cons false (blank))
  have h3 : steps 2 ⟨cons true (cons false (L)), cons true (rep (n) [true, true] (cons false (blank))), .C⟩ = some ⟨L, cons false (cons true (cons true (rep (n) [true, true] (cons false (blank))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- The same for a run of 2n+1 ones. -/
theorem descend_odd (n : Nat) (L : Tape) :
    steps (2 * n + 2) ⟨cons true (rep (n) [true, true] (cons false (L))), blank, .B⟩ = some ⟨L, cons false (cons true (rep (n) [true, true] (cons false (blank)))), .C⟩ := by
  have hn : 1 + ((n) * 2 + (1)) = 2 * n + 2 := by omega
  have h0 : steps 1 ⟨cons true (rep (n) [true, true] (cons false (L))), blank, .B⟩ = some ⟨rep (n) [true, true] (cons false (L)), cons true (cons false (blank)), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((n) * 2) ⟨rep (n) [true, true] (cons false (L)), cons true (cons false (blank)), .C⟩ = some ⟨cons false (L), cons true (rep (n) [true, true] (cons false (blank))), .C⟩ :=
    cross_l trans c1 (n) (cons false (L)) (cons false (blank))
  have h2 : steps 1 ⟨cons false (L), cons true (rep (n) [true, true] (cons false (blank))), .C⟩ = some ⟨L, cons false (cons true (rep (n) [true, true] (cons false (blank)))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A at the foot of a run of 2n ones climbs it and adds a 1: the next visit. -/
theorem climb (n : Nat) (L : Tape) :
    steps (2 * n + 1) ⟨L, rep (n) [true, true] (blank), .A⟩ = some ⟨cons true (rep (n) [true, true] (L)), blank, .B⟩ := by
  have hn : (n) * 2 + (1) = 2 * n + 1 := by omega
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (blank), .A⟩ = some ⟨rep (n) [true, true] (L), blank, .A⟩ :=
    cross_r trans c0 (n) (L) (blank)
  have h1 : steps 1 ⟨rep (n) [true, true] (L), blank, .A⟩ = some ⟨cons true (rep (n) [true, true] (L)), blank, .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

/-- The same for a run of 2n+1 ones. -/
theorem climb_odd (n : Nat) (L : Tape) :
    steps (2 * n + 2) ⟨L, rep (n) [true, true] (cons true (blank)), .A⟩ = some ⟨cons true (cons true (rep (n) [true, true] (L))), blank, .B⟩ := by
  have hn : (n) * 2 + (2) = 2 * n + 2 := by omega
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (cons true (blank)), .A⟩ = some ⟨rep (n) [true, true] (L), cons true (blank), .A⟩ :=
    cross_r trans c0 (n) (L) (cons true (blank))
  have h1 : steps 2 ⟨rep (n) [true, true] (L), cons true (blank), .A⟩ = some ⟨cons true (cons true (rep (n) [true, true] (L))), blank, .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

