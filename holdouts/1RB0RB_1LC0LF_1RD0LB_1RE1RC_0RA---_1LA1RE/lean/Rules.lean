/-- one cycle: (11)^n0 -1, (01)^n1 +2, state B -/
theorem rule0 (n0 n1 : Nat) :
    steps (6 * n1 + 16) ⟨rep (n1 + 1) [true, false] (rep (n0 + 2) [true, true] (blank)), blank, .B⟩ = some ⟨cons true (cons false (cons true (rep (n1) [false, true] (cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank)))))))))), blank, .B⟩ := by
  have hn : 1 + (0 + ((n1) * 2 + (10 + (0 + ((n1) * 4 + (5)))))) = 6 * n1 + 16 := by omega
  have h0 : steps 1 ⟨rep (n1 + 1) [true, false] (rep (n0 + 2) [true, true] (blank)), blank, .B⟩ = some ⟨cons false (rep (n1) [true, false] (rep (n0 + 2) [true, true] (blank))), cons true (cons true (blank)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (rep (n1) [true, false] (rep (n0 + 2) [true, true] (blank))), cons true (cons true (blank)), .C⟩ = some ⟨rep (n1) [false, true] (cons false (rep (n0 + 2) [true, true] (blank))), cons true (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons false (rep (n1) [true, false] (rep (n0 + 2) [true, true] (blank))) = rep (n1) [false, true] (cons false (rep (n0 + 2) [true, true] (blank))) from
      rep_rotate (n1) [false] [true, false] [false, true] rfl (rep (n0 + 2) [true, true] (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((n1) * 2) ⟨rep (n1) [false, true] (cons false (rep (n0 + 2) [true, true] (blank))), cons true (cons true (blank)), .C⟩ = some ⟨cons false (rep (n0 + 2) [true, true] (blank)), cons true (rep (n1) [true, false] (cons true (blank))), .C⟩ :=
    cross_l trans c2 (n1) (cons false (rep (n0 + 2) [true, true] (blank))) (cons true (blank))
  have h3 : steps 10 ⟨cons false (rep (n0 + 2) [true, true] (blank)), cons true (rep (n1) [true, false] (cons true (blank))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank)))))), cons false (rep (n1) [true, false] (cons true (blank))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank)))))), cons false (rep (n1) [true, false] (cons true (blank))), .A⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank)))))), rep (n1) [false, true] (cons false (cons true (blank))), .A⟩ := by
    simp only [steps_zero, show cons false (rep (n1) [true, false] (cons true (blank))) = rep (n1) [false, true] (cons false (cons true (blank))) from
      rep_rotate (n1) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [false, true] L), R, .A⟩ := fun _ _ => rfl
  have h5 : steps ((n1) * 4) ⟨cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank)))))), rep (n1) [false, true] (cons false (cons true (blank))), .A⟩ = some ⟨rep (n1) [false, true] (cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank))))))), cons false (cons true (blank)), .A⟩ :=
    cross_r trans c5 (n1) (cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank))))))) (cons false (cons true (blank)))
  have h6 : steps 5 ⟨rep (n1) [false, true] (cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank))))))), cons false (cons true (blank)), .A⟩ = some ⟨cons true (cons false (cons true (rep (n1) [false, true] (cons false (cons true (cons false (cons true (cons true (rep (n0) [true, true] (blank)))))))))), blank, .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

