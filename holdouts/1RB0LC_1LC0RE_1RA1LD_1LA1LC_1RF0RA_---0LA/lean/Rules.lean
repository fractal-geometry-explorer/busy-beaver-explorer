import Machine

/-! # Shift rules of 1RB0LC_1LC0RE_1RA1LD_1LA1LC_1RF0RA_---0LA

Three crossings that the run uses: A turns `011` into `100` going right (`walk_A`); C, with a 1 ahead, moves left
through `01` blocks unchanged (`walk_C01`) and turns `110` into `011` (`walk_C110`).  The body of period-10 words
right of the zone: crossed out and back for every length (`body_right`, `body_left`), and a whole round trip from
the zone to the right end and back (`trip`), whose result next to the zone does not depend on the length.  The halting situations: only
F reading a 0 halts, and `E> 0 0`, `B> 1 0 0` and `A> 0 1 0 0` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H149962

open TM

/-- A turns each `011` into `100`, three steps a copy. -/
theorem walk_A (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨L, rep (n) [false, true, true] (R), .A⟩ = some ⟨rep (n) [false, false, true] (L), R, .A⟩ := by
  have hn : (n) * 3 = 3 * n := by omega
  have c0 : ∀ L R : Tape, steps 3 ⟨app [] L, app [false, true, true] R, .A⟩ = some ⟨app [] (app [false, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨L, rep (n) [false, true, true] (R), .A⟩ = some ⟨rep (n) [false, false, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- C, with a 1 ahead, crosses `01` blocks leftwards and leaves them as they were, four steps a copy. -/
theorem walk_C01 (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨rep (n) [true, false] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .C⟩ := by
  have hn : (n) * 4 = 4 * n := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, false] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨rep (n) [true, false] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- C, with a 1 ahead, turns each `110` into `011` going left, three steps a copy. -/
theorem walk_C110 (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [false, true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true, true] (R)), .C⟩ := by
  have hn : (n) * 3 = 3 * n := by omega
  have c0 : ∀ L R : Tape, steps 3 ⟨app [false, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [false, true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- The pass back through the body: D, with a 0 travelling along, turns each `0110110111` into `1011110101`, twelve steps a copy. -/
theorem body_left (n : Nat) (L R : Tape) :
    steps (12 * n) ⟨rep (n) [true, true, true, false, true, true, false, true, true, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [true, false, true, true, true, true, false, true, false, true] (R)), .D⟩ := by
  have hn : (n) * 12 = 12 * n := by omega
  have c0 : ∀ L R : Tape, steps 12 ⟨app [true, true, true, false, true, true, false, true, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, false, true, true, true, true, false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 12) ⟨rep (n) [true, true, true, false, true, true, false, true, true, false] (L), cons false (R), .D⟩ = some ⟨L, cons false (rep (n) [true, false, true, true, true, true, false, true, false, true] (R)), .D⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- The pass out through the body: E, with the word `010` travelling along, turns each `1011110101` into `1110110110`, 58 steps a copy. -/
theorem body_right (n : Nat) (L R : Tape) :
    steps (58 * n) ⟨cons false (cons true (cons false (L))), rep (n) [true, false, true, true, true, true, false, true, false, true] (R), .E⟩ = some ⟨cons false (cons true (cons false (rep (n) [false, true, true, false, true, true, false, true, true, true] (L)))), R, .E⟩ := by
  have hn : (n) * 58 = 58 * n := by omega
  have c0 : ∀ L R : Tape, steps 58 ⟨app [false, true, false] L, app [true, false, true, true, true, true, false, true, false, true] R, .E⟩ = some ⟨app [false, true, false] (app [false, true, true, false, true, true, false, true, true, true] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 58) ⟨cons false (cons true (cons false (L))), rep (n) [true, false, true, true, true, true, false, true, false, true] (R), .E⟩ = some ⟨cons false (cons true (cons false (rep (n) [false, true, true, false, true, true, false, true, true, true] (L)))), R, .E⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- One round trip from the zone through a body of n+1 words to the right end and back: one new cell, 70n+143 steps, and the head comes back to the zone in the same state with the same cells next to it whatever n is. -/
theorem trip (n : Nat) (L : Tape) :
    steps (70 * n + 143) ⟨cons false (cons true (cons false (L))), rep (n + 1) [true, false, true, true, true, true, false, true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank)))))))))), .E⟩ = some ⟨L, cons true (rep (n + 1) [true, false, true, true, false, true, true, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank)))))))))))))), .D⟩ := by
  have hn : (n + 1) * 58 + (20 + (20 + (20 + (13 + ((n + 1) * 12))))) = 70 * n + 143 := by omega
  have c0 : ∀ L R : Tape, steps 58 ⟨app [false, true, false] L, app [true, false, true, true, true, true, false, true, false, true] R, .E⟩ = some ⟨app [false, true, false] (app [false, true, true, false, true, true, false, true, true, true] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((n + 1) * 58) ⟨cons false (cons true (cons false (L))), rep (n + 1) [true, false, true, true, true, true, false, true, false, true] (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank)))))))))), .E⟩ = some ⟨cons false (cons true (cons false (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))), cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank))))))))), .E⟩ :=
    cross_r trans c0 (n + 1) (L) (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank))))))))))
  have h1 : steps 20 ⟨cons false (cons true (cons false (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))), cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank))))))))), .E⟩ = some ⟨cons true (cons false (cons false (cons true (cons false (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))))), cons true (cons false (cons true (cons true (cons true (cons true (cons true (blank))))))), .C⟩ := rfl
  have h2 : steps 20 ⟨cons true (cons false (cons false (cons true (cons false (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))))), cons true (cons false (cons true (cons true (cons true (cons true (cons true (blank))))))), .C⟩ = some ⟨cons true (cons false (cons false (cons true (cons true (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))))), cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), .D⟩ := rfl
  have h3 : steps 20 ⟨cons true (cons false (cons false (cons true (cons true (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))))), cons true (cons true (cons true (cons true (cons true (cons true (cons true (blank))))))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))))))))))), cons true (cons true (blank)), .C⟩ := rfl
  have h4 : steps 13 ⟨cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L)))))))))))), cons true (cons true (blank)), .C⟩ = some ⟨rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L), cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank))))))))))))), .D⟩ := rfl
  have c5 : ∀ L R : Tape, steps 12 ⟨app [false, true, true, false, true, true, false, true, true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true, true, false, true, true, true, true, false] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((n + 1) * 12) ⟨rep (n + 1) [false, true, true, false, true, true, false, true, true, true] (L), cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank))))))))))))), .D⟩ = some ⟨L, cons true (rep (n + 1) [true, false, true, true, false, true, true, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank)))))))))))))), .D⟩ :=
    cross_l trans c5 (n + 1) (L) (cons true (cons false (cons true (cons true (cons false (cons true (cons true (cons true (cons true (cons false (cons true (cons true (blank)))))))))))))
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- `E> 0 0` halts: E writes 1 and moves right onto the 0 in state F. -/
theorem halt_E (L R : Tape) : ∃ c, steps 1 ⟨L, cons false (cons false (R)), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `B> 1 0 0` halts after two steps. -/
theorem halt_B (L R : Tape) : ∃ c, steps 2 ⟨L, cons true (cons false (cons false (R))), .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `A> 0 1 0 0` halts after three steps. -/
theorem halt_A (L R : Tape) : ∃ c, steps 3 ⟨L, cons false (cons true (cons false (cons false (R)))), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H149962
