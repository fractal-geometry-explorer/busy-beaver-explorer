import Machine

/-! # Shift rules of 1RB0LC_1LC0RE_1RA1LD_1LA1LC_1RF0RA_---0LA

Three crossings that the run uses: A turns `011` into `100` going right (`walk_A`); C, with a 1 ahead, moves left
through `01` blocks unchanged (`walk_C01`) and turns `110` into `011` (`walk_C110`).  The halting situations: only
F reading a 0 halts, and `E> 0 0`, `B> 1 0 0` and `A> 0 1 0 0` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H149962

open TM

/-- A turns each `011` into `100`, three steps a copy. -/
theorem walk_A (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨L, rep (n) [false, true, true] (R), .A⟩ = some ⟨rep (n) [false, false, true] (L), R, .A⟩ := by
  have hn : (n) * 3 = 3 * n := by omega
  have c0 : ∀ L R : Tape, steps 3 ⟨app [] L, app [false, true, true] R, .A⟩ = some ⟨app [] (app [false, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨L, rep (n) [false, true, true] (R), .A⟩ = some ⟨rep (n) [false, false, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- C, with a 1 ahead, crosses `01` blocks leftwards and leaves them as they were, four steps a copy. -/
theorem walk_C01 (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨rep (n) [true, false] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .C⟩ := by
  have hn : (n) * 4 = 4 * n := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, false] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨rep (n) [true, false] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- C, with a 1 ahead, turns each `110` into `011` going left, three steps a copy. -/
theorem walk_C110 (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [false, true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true, true] (R)), .C⟩ := by
  have hn : (n) * 3 = 3 * n := by omega
  have c0 : ∀ L R : Tape, steps 3 ⟨app [false, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [false, true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `E> 0 0` halts: E writes 1 and moves right onto the 0 in state F. -/
theorem halt_E (L R : Tape) : ∃ c, steps 1 ⟨L, cons false (cons false (R)), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `B> 1 0 0` halts after two steps. -/
theorem halt_B (L R : Tape) : ∃ c, steps 2 ⟨L, cons true (cons false (cons false (R))), .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `A> 0 1 0 0` halts after three steps. -/
theorem halt_A (L R : Tape) : ∃ c, steps 3 ⟨L, cons false (cons true (cons false (cons false (R)))), .A⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H149962
