import Machine

/-! # Shift rules of 1RB0LE_1RC0RE_1RD0RA_1RE1LC_0LA0RF_1LE---

Two crossings of the bouncer: going left, E with a 0 ahead turns each `11` into `10` (`left_E`, four steps a pair);
going right, A turns each `0101` into `1110` (`right_A`, six steps a copy).  The halting situations: only F reading
a 1 halts, and `E> 1 1`, `B> 1 1 1`, `D> 0 1 1` and `1 F> 0` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H48565

open TM

/-- Going left, E (with a 0 ahead) turns each `11` into `10`, four steps a pair. -/
theorem left_E (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨rep (n) [true, true] (L), cons false (R), .E⟩ = some ⟨L, cons false (rep (n) [true, false] (R)), .E⟩ := by
  have hn : (n) * 4 = 4 * n := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [false] R, .E⟩ = some ⟨L, app [false] (app [true, false] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨rep (n) [true, true] (L), cons false (R), .E⟩ = some ⟨L, cons false (rep (n) [true, false] (R)), .E⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- Going right, A turns each `0101` into `1110`, six steps a copy. -/
theorem right_A (n : Nat) (L R : Tape) :
    steps (6 * n) ⟨L, rep (n) [false, true, false, true] (R), .A⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .A⟩ := by
  have hn : (n) * 6 = 6 * n := by omega
  have c0 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 6) ⟨L, rep (n) [false, true, false, true] (R), .A⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `E> 1 1` halts: E erases the 1 and moves right onto a 1 in state F. -/
theorem halt_E (L R : Tape) : ∃ c, steps 1 ⟨L, cons true (cons true (R)), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `1 F> 0` halts: F writes 1 and steps left onto a 1 in state E, and E erases it and steps back onto the new 1 in state F. -/
theorem halt_F (L R : Tape) : ∃ c, steps 2 ⟨cons true (L), cons false (R), .F⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `B> 1 1 1` halts after two steps. -/
theorem halt_B (L R : Tape) : ∃ c, steps 2 ⟨L, cons true (cons true (cons true (R))), .B⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `D> 0 1 1` halts after two steps. -/
theorem halt_D (L R : Tape) : ∃ c, steps 2 ⟨L, cons false (cons true (cons true (R))), .D⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H48565
