      rep_rotate (a) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h2 : steps ((a) * 4) ⟨blank, rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))), .A⟩ = some ⟨rep (a) [false, true, false, true] (blank), cons false (cons true (cons false (cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))))), .A⟩ :=
