  have h2 : steps ((a) * 4) ⟨rep (a) [true, false, true, false] (cons true (cons false (cons true (blank)))), cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))), .B⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (rep (a) [false, true, false, true] (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))), .B⟩ :=
