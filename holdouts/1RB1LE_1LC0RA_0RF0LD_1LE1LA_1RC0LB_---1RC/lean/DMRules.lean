/-- B, right counter used up first. -/
theorem bgtpre (b c k : Nat) :
    steps (12 * b + 16) ⟨cons false (cons false (cons true (rep (k) [false, true] (blank)))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))), .A⟩ = some ⟨cons true (rep (k) [false, true] (blank)), cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))))), .A⟩ := by
  have hn : 0 + (1 + (0 + ((b) * 4 + (0 + (7 + (0 + ((b) * 8 + (8)))))))) = 12 * b + 16 := by omega
  have h0 : steps 0 ⟨cons false (cons false (cons true (rep (k) [false, true] (blank)))), rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))), .A⟩ = some ⟨cons false (cons false (cons true (rep (k) [false, true] (blank)))), cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))), .A⟩ := by
    simp only [steps_zero, show rep (b) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))) = cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))) from
      (rep_rotate (b) [false, true, false, true] [false, true, false, true] [false, true, false, true] rfl (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))).symm]
  have h1 : steps 1 ⟨cons false (cons false (cons true (rep (k) [false, true] (blank)))), cons false (cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))), .A⟩ = some ⟨cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))), cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))))), .B⟩ = some ⟨cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (b) [false, true, false, true] (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))))) = rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))))) from
      rep_rotate (b) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((b) * 4) ⟨cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))), rep (b) [true, false, true, false] (cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank)))))))), .B⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank)))))), cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .B⟩ :=
    cross_r trans c3 (b) (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank)))))) (cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))
  have h4 : steps 0 ⟨rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank)))))), cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .B⟩ = some ⟨cons true (cons false (rep (b) [true, false, true, false] (cons false (cons true (rep (k) [false, true] (blank)))))), cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .B⟩ := by
    simp only [steps_zero, show rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank)))))) = cons true (cons false (rep (b) [true, false, true, false] (cons false (cons true (rep (k) [false, true] (blank)))))) from
      (rep_rotate (b) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons false (cons true (rep (k) [false, true] (blank))))).symm]
  have h5 : steps 7 ⟨cons true (cons false (rep (b) [true, false, true, false] (cons false (cons true (rep (k) [false, true] (blank)))))), cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .B⟩ = some ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (cons true (rep (k) [false, true] (blank))))))), cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank)))))), .A⟩ := rfl
  have h6 : steps 0 ⟨cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (cons true (rep (k) [false, true] (blank))))))), cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank)))))), .A⟩ = some ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))))), cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank)))))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (b) [true, false, true, false] (cons false (cons true (rep (k) [false, true] (blank))))))) = rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))))) from
      rep_rotate (b) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons false (cons true (rep (k) [false, true] (blank))))]
  have c7 : ∀ L R : Tape, steps 8 ⟨app [false, true, false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h7 : steps ((b) * 8) ⟨rep (b) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))))), cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank)))))), .A⟩ = some ⟨cons false (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank)))))), cons true (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .A⟩ :=
    cross_l trans c7 (b) (cons false (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank))))))) (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank))))))
  have h8 : steps 8 ⟨cons false (cons true (cons false (cons false (cons true (rep (k) [false, true] (blank)))))), cons true (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .A⟩ = some ⟨cons true (rep (k) [false, true] (blank)), cons false (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (blank))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- A `10` from the left becomes `0101` on the right. -/
theorem zloop (m : Nat) (L : Tape) :
    steps (8 * m + 12) ⟨cons true (cons false (cons true (L))), rep (m) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))), .A⟩ = some ⟨cons true (L), cons false (cons true (cons false (cons true (cons false (cons true (rep (m) [false, true, false, true] (cons false (cons true (blank))))))))), .A⟩ := by
  have hn : 0 + (1 + (0 + ((m) * 4 + (0 + (6 + (0 + ((m) * 4 + (5)))))))) = 8 * m + 12 := by omega
  have h0 : steps 0 ⟨cons true (cons false (cons true (L))), rep (m) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))), .A⟩ = some ⟨cons true (cons false (cons true (L))), cons false (cons true (cons false (cons true (rep (m) [false, true, false, true] (blank))))), .A⟩ := by
    simp only [steps_zero, show rep (m) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))) = cons false (cons true (cons false (cons true (rep (m) [false, true, false, true] (blank))))) from
      (rep_rotate (m) [false, true, false, true] [false, true, false, true] [false, true, false, true] rfl (blank)).symm]
  have h1 : steps 1 ⟨cons true (cons false (cons true (L))), cons false (cons true (cons false (cons true (rep (m) [false, true, false, true] (blank))))), .A⟩ = some ⟨cons true (cons true (cons false (cons true (L)))), cons true (cons false (cons true (rep (m) [false, true, false, true] (blank)))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (cons true (cons false (cons true (L)))), cons true (cons false (cons true (rep (m) [false, true, false, true] (blank)))), .B⟩ = some ⟨cons true (cons true (cons false (cons true (L)))), rep (m) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (m) [false, true, false, true] (blank)))) = rep (m) [true, false, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (m) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (blank)]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((m) * 4) ⟨cons true (cons true (cons false (cons true (L)))), rep (m) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ = some ⟨rep (m) [true, false, true, false] (cons true (cons true (cons false (cons true (L))))), cons true (cons false (cons true (blank))), .B⟩ :=
    cross_r trans c3 (m) (cons true (cons true (cons false (cons true (L))))) (cons true (cons false (cons true (blank))))
  have h4 : steps 0 ⟨rep (m) [true, false, true, false] (cons true (cons true (cons false (cons true (L))))), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (L))))), cons true (cons false (cons true (blank))), .B⟩ := by
    simp only [steps_zero, show rep (m) [true, false, true, false] (cons true (cons true (cons false (cons true (L))))) = cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (L))))) from
      (rep_rotate (m) [true] [false, true, false, true] [true, false, true, false] rfl (cons true (cons false (cons true (L))))).symm]
  have h5 : steps 6 ⟨cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (L))))), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons true (cons false (cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (L))))))), cons false (cons false (cons true (blank))), .D⟩ := rfl
  have h6 : steps 0 ⟨cons true (cons false (cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (L))))))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨rep (m) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (L))))))), cons false (cons false (cons true (blank))), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (m) [false, true, false, true] (cons true (cons false (cons true (L))))))) = rep (m) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (L))))))) from
      rep_rotate (m) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (cons false (cons true (L))))]
  have c7 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h7 : steps ((m) * 4) ⟨rep (m) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (L))))))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (L)))))), cons false (rep (m) [false, true, false, true] (cons false (cons true (blank)))), .D⟩ :=
    cross_l trans c7 (m) (cons true (cons false (cons true (cons true (cons false (cons true (L))))))) (cons false (cons true (blank)))
  have h8 : steps 5 ⟨cons true (cons false (cons true (cons true (cons false (cons true (L)))))), cons false (rep (m) [false, true, false, true] (cons false (cons true (blank)))), .D⟩ = some ⟨cons true (L), cons false (cons true (cons false (cons true (cons false (cons true (rep (m) [false, true, false, true] (cons false (cons true (blank))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- The last one. -/
theorem zfin (m : Nat) :
    steps (8 * m + 12) ⟨cons true (blank), rep (m) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (rep (m) [false, true, false, true] (cons false (cons true (blank))))))))), .A⟩ := by
