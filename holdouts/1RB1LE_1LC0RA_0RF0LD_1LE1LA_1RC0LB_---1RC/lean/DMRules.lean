  have h2 : steps 0 ⟨cons true (cons true (blank)), cons true (cons false (cons true (rep (m) [false, true, false, true] (blank)))), .B⟩ = some ⟨cons true (cons true (blank)), rep (m) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ := by
