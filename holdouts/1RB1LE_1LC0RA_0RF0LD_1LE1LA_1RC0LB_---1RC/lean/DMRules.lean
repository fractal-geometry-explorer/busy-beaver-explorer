  have h6 : steps 0 ⟨rep (a) [false, true, false, true] (cons false (cons true (cons false (blank)))), cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .F⟩ = some ⟨cons false (cons true (cons false (rep (a) [true, false, true, false] (blank)))), cons true (cons false (cons true (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))))), .F⟩ := by
