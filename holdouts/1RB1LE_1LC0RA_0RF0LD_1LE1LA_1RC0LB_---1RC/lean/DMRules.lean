  have c7 : ∀ L R : Tape, steps 8 ⟨app [true, false, true, false] L, app [false, true] R, .E⟩ = some ⟨L, app [false, true] (app [true, false, true, false] R), .E⟩ := fun _ _ => rfl
  have h7 : steps ((b) * 8) ⟨rep (b) [true, false, true, false] (cons true (cons false (cons true (blank)))), cons false (cons true (cons true (cons false (rep (c) [true, false, true, false] (blank))))), .E⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (cons true (rep (b) [true, false, true, false] (cons true (cons false (rep (c) [true, false, true, false] (blank)))))), .E⟩ :=
