  have h3 : steps ((m) * 4) ⟨cons true (cons true (blank)), rep (m) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ = some ⟨rep (m) [true, false, true, false] (cons true (cons true (blank))), cons true (cons false (cons true (blank))), .B⟩ :=
    cross_r trans c3 (m) (cons true (cons true (blank))) (cons true (cons false (cons true (blank))))
  have h4 : steps 0 ⟨rep (m) [true, false, true, false] (cons true (cons true (blank))), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons true (rep (m) [false, true, false, true] (cons true (blank))), cons true (cons false (cons true (blank))), .B⟩ := by
    simp only [steps_zero, show rep (m) [true, false, true, false] (cons true (cons true (blank))) = cons true (rep (m) [false, true, false, true] (cons true (blank))) from
      (rep_rotate (m) [true] [false, true, false, true] [true, false, true, false] rfl (cons true (blank))).symm]
  have h5 : steps 6 ⟨cons true (rep (m) [false, true, false, true] (cons true (blank))), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons true (cons false (cons true (rep (m) [false, true, false, true] (cons true (blank))))), cons false (cons false (cons true (blank))), .D⟩ := rfl
  have h6 : steps 0 ⟨cons true (cons false (cons true (rep (m) [false, true, false, true] (cons true (blank))))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨rep (m) [true, false, true, false] (cons true (cons false (cons true (cons true (blank))))), cons false (cons false (cons true (blank))), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (m) [false, true, false, true] (cons true (blank))))) = rep (m) [true, false, true, false] (cons true (cons false (cons true (cons true (blank))))) from
      rep_rotate (m) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons true (blank))]
  have c7 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h7 : steps ((m) * 4) ⟨rep (m) [true, false, true, false] (cons true (cons false (cons true (cons true (blank))))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨cons true (cons false (cons true (cons true (blank)))), cons false (rep (m) [false, true, false, true] (cons false (cons true (blank)))), .D⟩ :=
    cross_l trans c7 (m) (cons true (cons false (cons true (cons true (blank))))) (cons false (cons true (blank)))
  have h8 : steps 5 ⟨cons true (cons false (cons true (cons true (blank)))), cons false (rep (m) [false, true, false, true] (cons false (cons true (blank)))), .D⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (rep (m) [false, true, false, true] (cons false (cons true (blank))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- A(2, 2p + 2). -/
theorem e2a (p : Nat) :
    steps (8 * p + 23) ⟨blank, rep (p) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (blank)))))))))))), .C⟩ := by
  have hn : 0 + (1 + (0 + ((p) * 4 + (0 + (6 + (0 + ((p) * 4 + (16)))))))) = 8 * p + 23 := by omega
  have h0 : steps 0 ⟨blank, rep (p) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (blank))))), .A⟩ := by
    simp only [steps_zero, show rep (p) [false, true, false, true] (cons false (cons true (cons false (cons true (blank))))) = cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (blank))))) from
      (rep_rotate (p) [false, true, false, true] [false, true, false, true] [false, true, false, true] rfl (blank)).symm]
  have h1 : steps 1 ⟨blank, cons false (cons true (cons false (cons true (rep (p) [false, true, false, true] (blank))))), .A⟩ = some ⟨cons true (blank), cons true (cons false (cons true (rep (p) [false, true, false, true] (blank)))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (blank), cons true (cons false (cons true (rep (p) [false, true, false, true] (blank)))), .B⟩ = some ⟨cons true (blank), rep (p) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (p) [false, true, false, true] (blank)))) = rep (p) [true, false, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (p) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (blank)]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((p) * 4) ⟨cons true (blank), rep (p) [true, false, true, false] (cons true (cons false (cons true (blank)))), .B⟩ = some ⟨rep (p) [true, false, true, false] (cons true (blank)), cons true (cons false (cons true (blank))), .B⟩ :=
    cross_r trans c3 (p) (cons true (blank)) (cons true (cons false (cons true (blank))))
  have h4 : steps 0 ⟨rep (p) [true, false, true, false] (cons true (blank)), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons true (rep (p) [false, true, false, true] (blank)), cons true (cons false (cons true (blank))), .B⟩ := by
    simp only [steps_zero, show rep (p) [true, false, true, false] (cons true (blank)) = cons true (rep (p) [false, true, false, true] (blank)) from
      (rep_rotate (p) [true] [false, true, false, true] [true, false, true, false] rfl (blank)).symm]
  have h5 : steps 6 ⟨cons true (rep (p) [false, true, false, true] (blank)), cons true (cons false (cons true (blank))), .B⟩ = some ⟨cons true (cons false (cons true (rep (p) [false, true, false, true] (blank)))), cons false (cons false (cons true (blank))), .D⟩ := rfl
  have h6 : steps 0 ⟨cons true (cons false (cons true (rep (p) [false, true, false, true] (blank)))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨rep (p) [true, false, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (blank))), .D⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (p) [false, true, false, true] (blank)))) = rep (p) [true, false, true, false] (cons true (cons false (cons true (blank)))) from
      rep_rotate (p) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (blank)]
  have c7 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h7 : steps ((p) * 4) ⟨rep (p) [true, false, true, false] (cons true (cons false (cons true (blank)))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨cons true (cons false (cons true (blank))), cons false (rep (p) [false, true, false, true] (cons false (cons true (blank)))), .D⟩ :=
    cross_l trans c7 (p) (cons true (cons false (cons true (blank)))) (cons false (cons true (blank)))
  have h8 : steps 16 ⟨cons true (cons false (cons true (blank))), cons false (rep (p) [false, true, false, true] (cons false (cons true (blank)))), .D⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (rep (p) [false, true, false, true] (cons false (cons true (blank)))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

