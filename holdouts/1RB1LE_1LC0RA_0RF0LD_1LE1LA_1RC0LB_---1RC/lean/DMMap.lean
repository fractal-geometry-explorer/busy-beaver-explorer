import Blank
import DMRules
import TM.MapOrbit

/-!
# DeepMind's halts-iff map, proved here

`DM.State`, `DM.start`, `DM.next` are DeepMind's (google-deepmind/cryptids,
`BusyBeaver/BB6/M_1RB1LE_1LC0RA_0RF0LD_1LE1LA_1RC0LB_HHH1RC.lean`, commit 3647718), copied unchanged but for `ℕ`
written `Nat`.  Their file proves with Mathlib that the machine halts iff the orbit of `next` from `start` stops; here
the same statement is proved on this repository's machine semantics with core Lean only (`deepmind_halts_iff`), so
it no longer needs to be cited.

`A a b` is `0^∞ C> 0 (10)^a 110 (10)^b 0^∞` and `B a b c` is `0^∞ C> 0 (10)^a 110 (10)^b 110 (1010)^c 0^∞`.  Every
case of `next` starts with `min a b` rounds (`rounds`: each moves a `10` from both counters, two into the middle);
then the case runs to its next state through the rules of `DMRules.lean` (generated by `py/dmrules.py`), the B
cases with a second loop (`zloops`: each `10` left of the head becomes `0101` on the right).
-/

set_option autoImplicit false

namespace H113170

namespace DM

inductive State where
  /-- $A(a, b) := 0^\infty\,{<}\mathrm{C}\,(10)^a\,110\,(10)^b\,0^\infty$. -/
  | A (a b : Nat)
  /-- $B(a, b, c) := 0^\infty\,{<}\mathrm{C}\,(10)^a\,110\,(10)^b\,110\,(1010)^c\,0^\infty$. -/
  | B (a b c : Nat)

def start : State := .A 2 0

def next : State → Option State
  | .A a b =>
    if a < b then
      some (.A (2 * a + 2) (b - a - 1))
    else if a = b then
      none
    else if (a - b - 1) % 2 = 0 then
      some (.A (2 * ((a - b - 1) / 2) + 2) (2 * b + 2))
    else
      some (.B 2 (2 * ((a - b - 1) / 2) + 1) (b + 1))
  | .B a b c =>
    if a < b then
      some (.B (2 * a + 2) (b - a - 1) c)
    else if a = b then
      some (.A 2 (4 * a + 2 * c + 6))
    else
      some (.A 2 (2 * a + 2 * c + 2))

/-- `n` steps of `next` from `start`: DeepMind's `(Option.bind · next)^[n] (some start)` in `CollatzHalts`. -/
def orbit : Nat → Option State
  | 0 => some start
  | n + 1 => Option.bind (orbit n) next

end DM

open TM DM

/-- The configuration of a state. -/
def enc : State → Config
  | .A a b => ⟨blank, cons false (rep a [true, false] (cons true (cons true (cons false (rep b [true, false] blank))))), .C⟩
  | .B a b c => ⟨blank, cons false (rep a [true, false] (cons true (cons true (cons false (rep b [true, false]
      (cons true (cons true (cons false (rep c [true, false, true, false] blank))))))))), .C⟩

def Rel (s : State) (c : Config) : Prop := c = enc s

abbrev Plus := TM.Plus trans
abbrev Star := TM.Star trans

/-- `j` rounds. -/
theorem rounds (j : Nat) : ∀ (m k n : Nat) (T : Tape),
    Star ⟨cons true (rep (m + j) [false, true] blank), cons true (rep k [true, false, true, false] (cons false (rep (n + j) [true, false] T))), .C⟩
      ⟨cons true (rep m [false, true] blank), cons true (rep (k + j) [true, false, true, false] (cons false (rep n [true, false] T))), .C⟩ := by
  induction j with
  | zero => intro m k n T; exact Star.refl _
  | succ j ih =>
    intro m k n T
    have h₁ := round k (rep (m + j) [false, true] blank) (rep (n + j) [true, false] T)
    have h₂ := ih m (k + 1) n T
    rw [show k + 1 + j = k + (j + 1) by omega] at h₂
    refine (plus_of h₁ rfl ?_).star.trans h₂
    cfg_rfl

/-- `j` passes of `zloop`. -/
theorem zloops (j : Nat) : ∀ (m k : Nat),
    Star ⟨cons true (rep (m + j) [false, true] blank), rep k [false, true, false, true] (cons false (cons true (cons false (cons true blank)))), .A⟩
      ⟨cons true (rep m [false, true] blank), rep (k + j) [false, true, false, true] (cons false (cons true (cons false (cons true blank)))), .A⟩ := by
  induction j with
  | zero => intro m k; exact Star.refl _
  | succ j ih =>
    intro m k
    have h₁ := zloop k (rep (m + j) [false, true] blank)
    have h₂ := ih m (k + 1)
    rw [show k + 1 + j = k + (j + 1) by omega] at h₂
    refine (plus_of h₁ rfl ?_).star.trans h₂
    cfg_rfl

theorem tf_blank (s : Nat) : rep (s + 1) [true, false] blank = cons true (rep s [false, true] blank) := by
  rw [rep_succ_far, rep_rot]; simp only [app_cons, app_nil, cons_false_blank]

/-- The start of a pass and `j` rounds. -/
theorem pass (m j n : Nat) (T : Tape) :
    Plus ⟨blank, cons false (rep (m + j) [true, false] (cons true (cons true (cons false (rep (n + j) [true, false] T))))), .C⟩
      ⟨cons true (rep m [false, true] blank), cons true (rep j [true, false, true, false] (cons false (rep n [true, false] T))), .C⟩ := by
  rcases h : m + j with _ | s
  · obtain ⟨rfl, rfl⟩ : m = 0 ∧ j = 0 := by omega
    exact plus_of (entry0 (rep n [true, false] T)) rfl (by simp only [cons_false_blank, rep_zero])
  · have h₁ := entryS s (rep (n + j) [true, false] T)
    have h₂ := rounds j m 0 n T
    rw [Nat.zero_add] at h₂
    refine (plus_of h₁ rfl ?_).trans_star h₂
    simp only [h, rep_succ, app_cons, app_nil, rep_zero, rep_rot, cons_false_blank]

theorem rep_tf_odd (i : Nat) (X : Tape) :
    rep (2 * i + 1) [true, false] X = rep i [true, false, true, false] (cons true (cons false X)) := by
  rw [rep_add, rep_double]; rfl

theorem rep_tf_even (i : Nat) (X : Tape) : rep (2 * i) [true, false] X = rep i [true, false, true, false] X :=
  rep_double i [true, false] X

/-- A(a, a + d + 1) and B(a, a + d + 1, c): the left counter runs out first. -/
theorem step_lt (a d : Nat) (T : Tape) :
    Plus ⟨blank, cons false (rep a [true, false] (cons true (cons true (cons false (rep (a + d + 1) [true, false] T))))), .C⟩
      ⟨blank, cons false (rep (2 * a + 2) [true, false] (cons true (cons true (cons false (rep d [true, false] T))))), .C⟩ := by
  have h₁ := pass 0 a (d + 1) T
  rw [Nat.zero_add, show d + 1 + a = a + d + 1 by omega] at h₁
  refine h₁.trans (plus_of (exitlt a (rep d [true, false] T)) (by simp only [rep_zero]; rfl) ?_)
  rw [show 2 * a + 2 = 2 * (a + 1) by omega, rep_tf_even]
  cfg_rfl

/-- The right counter runs out first: after the pass, `gt1`. -/
theorem pass_gt (b k : Nat) (T : Tape) :
    Plus ⟨blank, cons false (rep (b + k + 1) [true, false] (cons true (cons true (cons false (rep b [true, false] T))))), .C⟩
      ⟨cons false (rep k [false, true] blank), cons false (cons true (cons false (cons true (rep b [false, true, false, true] T)))), .A⟩ := by
  have h₁ := pass (k + 1) b 0 T
  rw [Nat.zero_add, show k + 1 + b = b + k + 1 by omega] at h₁
  exact h₁.trans (plus_of (gt1 b k T) rfl rfl)

/-- A(b + 2i + 1, b) to A(2i + 2, 2b + 2). -/
theorem gtA_even (b i : Nat) : Plus (enc (.A (b + 2 * i + 1) b)) (enc (.A (2 * i + 2) (2 * b + 2))) := by
  have h₁ := pass_gt b (2 * i) blank
  rcases i with _ | i
  · refine h₁.trans ((plus_of (e1a0 b) (by simp only [Nat.mul_zero, rep_zero, cons_false_blank, rep_near4]) rfl).trans (plus_of (fin_odd b 0) (by cfg_rfl) ?_))
    simp only [enc, rep_tf_even, show 2 * b + 2 = 2 * (b + 1) by omega]
    cfg_rfl
  · have h₂ := e1as b (2 * i + 1)
    rw [rep_tf_odd] at h₂
    refine h₁.trans ((plus_of h₂ (by simp only [show 2 * (i + 1) = 2 * i + 1 + 1 by omega, rep_succ, app_cons, app_nil, rep_near4]) rfl).trans (plus_of (fin_odd b (i + 1)) (by cfg_rfl) ?_))
    simp only [enc, rep_tf_even, show 2 * b + 2 = 2 * (b + 1) by omega, show 2 * (i + 1) + 2 = 2 * (i + 2) by omega]
    cfg_rfl

/-- A(b + 2i + 2, b) to B(2, 2i + 1, b + 1). -/
theorem gtA_odd (b i : Nat) : Plus (enc (.A (b + 2 * i + 2) b)) (enc (.B 2 (2 * i + 1) (b + 1))) := by
  have h₁ := pass_gt b (2 * i + 1) blank
  rw [show b + (2 * i + 1) + 1 = b + 2 * i + 2 by omega] at h₁
  have h₂ := e1as b (2 * i)
  rw [rep_tf_even] at h₂
  refine h₁.trans ((plus_of h₂ (by simp only [rep_succ, app_cons, app_nil, rep_near4]) rfl).trans (plus_of (fin_even b i) (by cfg_rfl) ?_))
  simp only [enc, rep_tf_odd]
  cfg_rfl

theorem left_odd (a : Nat) :
    cons true (cons false (cons true (cons false (rep a [true, false, true, false] blank)))) =
      cons true (rep (2 * a + 1) [false, true] blank) := by
  rw [rep_add, rep_double]
  show _ = cons true (rep a [false, true, false, true] (cons false (cons true blank)))
  have h := rep_rotate a [false, true] [false, true, false, true] [false, true, false, true] rfl blank
  simp only [app_cons, app_nil] at h
  rw [rep_rot4 a false true false true blank, cons_false_blank, h]

/-- A(a, a) halts. -/
theorem eqA (a : Nat) : TM.Halts trans (enc (.A a a)) := by
  have h₁ := pass 0 a 0 blank
  simp only [Nat.zero_add] at h₁
  exact Halts.pre h₁.star (halts_at (haltA a) (by simp only [rep_zero]) rfl)

/-- B(a, a, c) to A(2, 4a + 2c + 6). -/
theorem eqB (a c : Nat) : Plus (enc (.B a a c)) (enc (.A 2 (4 * a + 2 * c + 6))) := by
  have h₁ := pass 0 a 0 (cons true (cons true (cons false (rep c [true, false, true, false] blank))))
  simp only [Nat.zero_add] at h₁
  have h₂ := zloops (2 * a + 1) 0 c
  simp only [Nat.zero_add] at h₂
  refine ((h₁.trans ((plus_of (beq1 a c) (by simp only [rep_zero]) rfl).trans (plus_of (beq2 a c) rfl ?_))).trans_star
    h₂).trans ((plus_of (zfin (c + (2 * a + 1))) (by simp only [rep_zero]) rfl).trans (plus_of (e2a (c + (2 * a + 1) + 1)) ?_ ?_))
  · rw [← left_odd]; cfg_rfl
  · cfg_rfl
  · simp only [enc, show 4 * a + 2 * c + 6 = 2 * (c + (2 * a + 1) + 1 + 1) by omega, rep_tf_even]
    cfg_rfl

/-- B(b + k + 1, b, c) to A(2, 2(b + k + 1) + 2c + 2). -/
theorem gtB (b k c : Nat) : Plus (enc (.B (b + k + 1) b c)) (enc (.A 2 (2 * (b + k + 1) + 2 * c + 2))) := by
  have h₁ := pass_gt b k (cons true (cons true (cons false (rep c [true, false, true, false] blank))))
  rcases k with _ | k
  · refine h₁.trans ((plus_of (bgtpre0 b c) (by simp only [rep_zero, cons_false_blank, rep_near4]) rfl).trans
      (plus_of (e2a (b + c + 1)) ?_ ?_))
    · cfg_rfl
    · simp only [enc, show 2 * (b + 0 + 1) + 2 * c + 2 = 2 * (b + c + 1 + 1) by omega, rep_tf_even]
      cfg_rfl
  · have h₂ := zloops k 0 (b + c + 1)
    simp only [Nat.zero_add] at h₂
    refine ((h₁.trans (plus_of (bgtpre b c k) (by simp only [rep_succ, app_cons, app_nil, rep_near4]) ?_)).trans_star
      h₂).trans ((plus_of (zfin (b + c + 1 + k)) (by simp only [rep_zero]) rfl).trans (plus_of (e2a (b + c + 1 + k + 1)) ?_ ?_))
    · cfg_rfl
    · cfg_rfl
    · simp only [enc, show 2 * (b + (k + 1) + 1) + 2 * c + 2 = 2 * (b + c + 1 + k + 1 + 1) by omega, rep_tf_even]
      cfg_rfl

/-- Every state lands where `next` says. -/
theorem step_rel : ∀ s c, Rel s c → TM.Lands trans Rel c (next s) := by
  intro s c h
  subst h
  cases s with
  | A a b =>
    simp only [next]
    split
    · obtain ⟨d, rfl⟩ : ∃ d, b = a + d + 1 := ⟨b - a - 1, by omega⟩
      refine ⟨_, ?_, rfl⟩
      rw [show a + d + 1 - a - 1 = d by omega]
      exact step_lt a d blank
    · split
      · subst b; exact eqA a
      · split
        · obtain ⟨i, rfl⟩ : ∃ i, a = b + 2 * i + 1 := ⟨(a - b - 1) / 2, by omega⟩
          refine ⟨_, ?_, rfl⟩
          rw [show (b + 2 * i + 1 - b - 1) / 2 = i by omega]
          exact gtA_even b i
        · obtain ⟨i, rfl⟩ : ∃ i, a = b + 2 * i + 2 := ⟨(a - b - 1) / 2, by omega⟩
          refine ⟨_, ?_, rfl⟩
          rw [show (b + 2 * i + 2 - b - 1) / 2 = i by omega]
          exact gtA_odd b i
  | B a b c =>
    simp only [next]
    split
    · obtain ⟨d, rfl⟩ : ∃ d, b = a + d + 1 := ⟨b - a - 1, by omega⟩
      refine ⟨_, ?_, rfl⟩
      rw [show a + d + 1 - a - 1 = d by omega]
      exact step_lt a d _
    · split
      · subst b; exact ⟨_, eqB a c, rfl⟩
      · obtain ⟨k, rfl⟩ : ∃ k, a = b + k + 1 := ⟨a - b - 1, by omega⟩
        exact ⟨_, gtB b k c, rfl⟩

/-- **DeepMind's halts-iff map, proved here.**  The machine halts from blank tape if and only if the orbit of
DeepMind's `next` from `start` stops. -/
theorem deepmind_halts_iff : HaltsFromBlank ↔ ∃ n, (DM.orbit n).isNone = true := by
  have h : HaltsFromBlank ↔ ∃ n, TM.orbit next start n = none :=
    halts_iff_orbit ⟨15, _, blank_A, by simp only [Rel, start, enc]; cfg_rfl⟩ step_rel
  have e : ∀ n, DM.orbit n = TM.orbit next start n := by
    intro n; induction n with
    | zero => rfl
    | succ n ih => simp only [DM.orbit, TM.orbit, ih]
  rw [h]
  constructor
  · rintro ⟨n, hn⟩; exact ⟨n, by rw [e, hn]; rfl⟩
  · rintro ⟨n, hn⟩; refine ⟨n, ?_⟩; rw [← e]; cases h' : DM.orbit n <;> simp_all

end H113170
