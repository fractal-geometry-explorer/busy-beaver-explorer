import Machine

/-! # The left-going pass

Generated by `py/gen_rules.py` with `bbtools.symtm.prove`: every theorem is a run of the machine for all values of
the variables and every tape `L`, `R`, proved by `rfl` steps and the shift rules `cross_l`, `cross_r`.
Left tapes are written nearest the head first, so `(10)^k` on the page is `rep k [false, true]` here. -/

namespace H157503

open TM

/-- E on a 1 with `0 0` to its left halts two steps later (F reads 0). -/
theorem halt_e (L R : Tape) :
    steps (2) ⟨cons false (cons false (L)), cons true (R), .E⟩ = some ⟨L, cons false (cons false (cons true (R))), .F⟩ := by
  have h0 : steps 2 ⟨cons false (cons false (L)), cons true (R), .E⟩ = some ⟨L, cons false (cons false (cons true (R))), .F⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- So does A on `1 0` with a 0 to its left (this pattern does not occur after the start). -/
theorem halt_a (L R : Tape) :
    steps (3) ⟨cons false (L), cons true (cons false (R)), .A⟩ = some ⟨L, cons false (cons false (cons true (R))), .F⟩ := by
  have h0 : steps 3 ⟨cons false (L), cons true (cons false (R)), .A⟩ = some ⟨L, cons false (cons false (cons true (R))), .F⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)

/-- The right sweep: A crosses `11` pairs, turning each into `01`. -/
theorem sweep_d (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, true] (R), .A⟩ = some ⟨rep (n) [true, false] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, false] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (R), .A⟩ = some ⟨rep (n) [true, false] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- ...and `01` pairs into `11`. -/
theorem sweep_b (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [false, true] (R), .A⟩ = some ⟨rep (n) [true, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [false, true] (R), .A⟩ = some ⟨rep (n) [true, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- The left pass over a block: C, B, C, D... walk left one cell per three steps; `0 1^(n+1)` with C on its right end becomes `0 0 1^n` with D on the first 0. -/
theorem c_run (n : Nat) (L R : Tape) :
    steps (3 * n + 1) ⟨rep (n) [true] (cons false (L)), cons true (R), .C⟩ = some ⟨L, cons false (cons false (rep (n) [true] (R))), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true] (cons false (L)), cons true (R), .C⟩ = some ⟨cons false (L), cons true (rep (n) [true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons false (L)) (R)
  have h1 : steps 1 ⟨cons false (L), cons true (rep (n) [true] (R)), .C⟩ = some ⟨L, cons false (cons false (rep (n) [true] (R))), .D⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (1)) (by omega) (steps_seq trans h0 (h1))

/-- A block of length k+2 >= 2 left of the pass is shifted one cell right and the pass goes on into the next separator. -/
theorem c_shift (k n : Nat) (L R : Tape) :
    steps (3 * k + 3 * n + 4) ⟨rep (n) [true] (cons false (cons true (cons true (rep (k) [true] (cons false (L)))))), cons true (R), .C⟩ = some ⟨L, cons false (cons false (rep (k) [true] (cons true (cons true (cons false (rep (n) [true] (R))))))), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true] (cons false (cons true (cons true (rep (k) [true] (cons false (L)))))), cons true (R), .C⟩ = some ⟨cons false (cons true (cons true (rep (k) [true] (cons false (L))))), cons true (rep (n) [true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons false (cons true (cons true (rep (k) [true] (cons false (L)))))) (R)
  have h1 : steps 3 ⟨cons false (cons true (cons true (rep (k) [true] (cons false (L))))), cons true (rep (n) [true] (R)), .C⟩ = some ⟨rep (k) [true] (cons false (L)), cons true (cons true (cons true (cons false (rep (n) [true] (R))))), .C⟩ := rfl
  have c2 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 3) ⟨rep (k) [true] (cons false (L)), cons true (cons true (cons true (cons false (rep (n) [true] (R))))), .C⟩ = some ⟨cons false (L), cons true (rep (k) [true] (cons true (cons true (cons false (rep (n) [true] (R)))))), .C⟩ :=
    cross_l trans c2 (k) (cons false (L)) (cons true (cons true (cons false (rep (n) [true] (R)))))
  have h3 : steps 1 ⟨cons false (L), cons true (rep (k) [true] (cons true (cons true (cons false (rep (n) [true] (R)))))), .C⟩ = some ⟨L, cons false (cons false (rep (k) [true] (cons true (cons true (cons false (rep (n) [true] (R))))))), .D⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (3 + ((k) * 3 + (1)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- A block of length 1 stops the pass: it grows to `1 1` and F turns the head around on the 1 left of it. -/
theorem c_stop (n : Nat) (L R : Tape) :
    steps (3 * n + 4) ⟨rep (n) [true] (cons false (cons true (cons false (cons true (L))))), cons true (R), .C⟩ = some ⟨L, cons true (cons false (cons true (cons true (cons false (rep (n) [true] (R)))))), .F⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true] (cons false (cons true (cons false (cons true (L))))), cons true (R), .C⟩ = some ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons false (cons true (cons false (cons true (L))))) (R)
  have h1 : steps 4 ⟨cons false (cons true (cons false (cons true (L)))), cons true (rep (n) [true] (R)), .C⟩ = some ⟨L, cons true (cons false (cons true (cons true (cons false (rep (n) [true] (R)))))), .F⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (4)) (by omega) (steps_seq trans h0 (h1))

/-- If that block of length 1 is the leftmost block of the tape, F reads 0: the machine halts. -/
theorem c_halt (n : Nat) (R : Tape) :
    steps (3 * n + 4) ⟨rep (n) [true] (cons false (cons true (blank))), cons true (R), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons false (rep (n) [true] (R)))))), .F⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true] (cons false (cons true (blank))), cons true (R), .C⟩ = some ⟨cons false (cons true (blank)), cons true (rep (n) [true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons false (cons true (blank))) (R)
  have h1 : steps 4 ⟨cons false (cons true (blank)), cons true (rep (n) [true] (R)), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons true (cons false (rep (n) [true] (R)))))), .F⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (4)) (by omega) (steps_seq trans h0 (h1))

/-- A pass that runs into the leftmost block (of any length n+1) turns right and the tape grows on the left. -/
theorem c_lead (n : Nat) (R : Tape) :
    steps (3 * n + 11) ⟨rep (n) [true] (blank), cons true (R), .C⟩ = some ⟨cons true (cons true (cons true (cons true (blank)))), rep (n) [true] (R), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true] (blank), cons true (R), .C⟩ = some ⟨blank, cons true (rep (n) [true] (R)), .C⟩ :=
    cross_l trans c0 (n) (blank) (R)
  have h1 : steps 11 ⟨blank, cons true (rep (n) [true] (R)), .C⟩ = some ⟨cons true (cons true (cons true (cons true (blank)))), rep (n) [true] (R), .A⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (11)) (by omega) (steps_seq trans h0 (h1))

end H157503
