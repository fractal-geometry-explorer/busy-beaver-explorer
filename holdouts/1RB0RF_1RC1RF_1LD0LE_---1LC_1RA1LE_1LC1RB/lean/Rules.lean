    steps (2 * j + 3) ⟨rep (a) [true] (blank), cons false (cons false (cons true (rep (j) [true, true] (blank)))), .E⟩ = some ⟨cons true (rep (j) [true, true] (cons true (cons true (rep (a) [true] (blank))))), blank, .F⟩ := by
  have hn : 2 + (0 + ((j) * 2 + (1))) = 2 * j + 3 := by omega
  have h0 : steps 2 ⟨rep (a) [true] (blank), cons false (cons false (cons true (rep (j) [true, true] (blank)))), .E⟩ = some ⟨cons true (cons true (rep (a) [true] (blank))), cons true (rep (j) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons true (rep (a) [true] (blank))), cons true (rep (j) [true, true] (blank)), .B⟩ = some ⟨cons true (cons true (rep (a) [true] (blank))), rep (j) [true, true] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (j) [true, true] (blank)) = rep (j) [true, true] (cons true (blank)) from
      rep_rotate (j) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((j) * 2) ⟨cons true (cons true (rep (a) [true] (blank))), rep (j) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (j) [true, true] (cons true (cons true (rep (a) [true] (blank)))), cons true (blank), .B⟩ :=
    cross_r trans c2 (j) (cons true (cons true (rep (a) [true] (blank)))) (cons true (blank))
  have h3 : steps 1 ⟨rep (j) [true, true] (cons true (cons true (rep (a) [true] (blank)))), cons true (blank), .B⟩ = some ⟨cons true (rep (j) [true, true] (cons true (cons true (rep (a) [true] (blank))))), blank, .F⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- Q(2k+3) -> X(0, 2k+2, 1). -/
theorem q_start_o (k : Nat) :
    steps (2 * k + 4) ⟨rep (k + 1) [true, true] (cons true (blank)), blank, .F⟩ = some ⟨blank, cons false (cons true (cons true (rep (k) [true, true] (cons false (cons true (blank)))))), .E⟩ := by
  have hn : 2 + ((k) * 2 + (2)) = 2 * k + 4 := by omega
  have h0 : steps 2 ⟨rep (k + 1) [true, true] (cons true (blank)), blank, .F⟩ = some ⟨rep (k) [true, true] (cons true (blank)), cons true (cons false (cons true (blank))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, true] R), .E⟩ := fun _ _ => rfl
  have h1 : steps ((k) * 2) ⟨rep (k) [true, true] (cons true (blank)), cons true (cons false (cons true (blank))), .E⟩ = some ⟨cons true (blank), cons true (rep (k) [true, true] (cons false (cons true (blank)))), .E⟩ :=
    cross_l trans c1 (k) (cons true (blank)) (cons false (cons true (blank)))
  have h2 : steps 2 ⟨cons true (blank), cons true (rep (k) [true, true] (cons false (cons true (blank)))), .E⟩ = some ⟨blank, cons false (cons true (cons true (rep (k) [true, true] (cons false (cons true (blank)))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- Q(2k+2) -> X(0, 2k+1, 1). -/
theorem q_start_e (k : Nat) :
    steps (2 * k + 3) ⟨rep (k + 1) [true, true] (blank), blank, .F⟩ = some ⟨blank, cons false (cons true (rep (k) [true, true] (cons false (cons true (blank))))), .E⟩ := by
  have hn : 2 + ((k) * 2 + (1)) = 2 * k + 3 := by omega
  have h0 : steps 2 ⟨rep (k + 1) [true, true] (blank), blank, .F⟩ = some ⟨rep (k) [true, true] (blank), cons true (cons false (cons true (blank))), .E⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, true] R), .E⟩ := fun _ _ => rfl
  have h1 : steps ((k) * 2) ⟨rep (k) [true, true] (blank), cons true (cons false (cons true (blank))), .E⟩ = some ⟨blank, cons true (rep (k) [true, true] (cons false (cons true (blank)))), .E⟩ :=
    cross_l trans c1 (k) (blank) (cons false (cons true (blank)))
  have h2 : steps 1 ⟨blank, cons true (rep (k) [true, true] (cons false (cons true (blank)))), .E⟩ = some ⟨blank, cons false (cons true (rep (k) [true, true] (cons false (cons true (blank))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

end H144815
