  have hn : 2 + ((j) * 7 + (10 + (0 + ((j) * 5 + (10))))) = 12 * j + 22 := by omega
  have h0 : steps 2 ⟨cons false (cons true (L)), cons false (cons false (rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))), .E⟩ = some ⟨cons true (cons false (cons false (cons true (L)))), rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons false (R))))))), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 7 ⟨app [] L, app [true, true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 7) ⟨cons true (cons false (cons false (cons true (L)))), rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons false (R))))))), .B⟩ = some ⟨rep (j) [true, false, true, false, true] (cons true (cons false (cons false (cons true (L))))), cons true (cons true (cons false (cons true (cons false (cons false (R)))))), .B⟩ :=
    cross_r trans c1 (j) (cons true (cons false (cons false (cons true (L))))) (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))
  have h2 : steps 10 ⟨rep (j) [true, false, true, false, true] (cons true (cons false (cons false (cons true (L))))), cons true (cons true (cons false (cons true (cons false (cons false (R)))))), .B⟩ = some ⟨cons false (cons true (rep (j) [true, false, true, false, true] (cons true (cons false (cons false (cons true (L))))))), cons true (cons true (cons false (cons true (R)))), .C⟩ := rfl
  have h3 : steps 0 ⟨cons false (cons true (rep (j) [true, false, true, false, true] (cons true (cons false (cons false (cons true (L))))))), cons true (cons true (cons false (cons true (R)))), .C⟩ = some ⟨rep (j) [false, true, true, false, true] (cons false (cons true (cons true (cons false (cons false (cons true (L))))))), cons true (cons true (cons false (cons true (R)))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (j) [true, false, true, false, true] (cons true (cons false (cons false (cons true (L))))))) = rep (j) [false, true, true, false, true] (cons false (cons true (cons true (cons false (cons false (cons true (L))))))) from
      rep_rotate (j) [false, true] [true, false, true, false, true] [false, true, true, false, true] rfl (cons true (cons false (cons false (cons true (L)))))]
  have c4 : ∀ L R : Tape, steps 5 ⟨app [false, true, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 5) ⟨rep (j) [false, true, true, false, true] (cons false (cons true (cons true (cons false (cons false (cons true (L))))))), cons true (cons true (cons false (cons true (R)))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons false (cons true (L)))))), cons true (rep (j) [true, false, false, true, false] (cons true (cons false (cons true (R))))), .C⟩ :=
    cross_l trans c4 (j) (cons false (cons true (cons true (cons false (cons false (cons true (L))))))) (cons true (cons false (cons true (R))))
  have h5 : steps 10 ⟨cons false (cons true (cons true (cons false (cons false (cons true (L)))))), cons true (rep (j) [true, false, false, true, false] (cons true (cons false (cons true (R))))), .C⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (rep (j) [true, false, false, true, false] (cons true (cons false (cons true (R))))))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

