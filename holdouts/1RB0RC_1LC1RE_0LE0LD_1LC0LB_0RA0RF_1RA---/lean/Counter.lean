import Machine

/-! Counter rules of 1RB0RC_1LC1RE_0LE0LD_1LC0LB_0RA0RF_1RA---: one hub event with the left counter borrowing through `k` digits, and with the right
counter carrying through `j` digits, for every `k`, `j` and every tape beyond the cells shown (`L`, `R`).
Found from 4000 sampled events by `py/rules.py` of this folder (`tools/py/bbtools/hubrules.py`) and proved by
`tools/py/bbtools/symtm.py` (single steps by `rfl`, the `k` or `j` copies by `TM.cross_l` / `TM.cross_r`). -/

namespace H4176

open TM

/-- The left counter borrows through `k` digits (its lowest digit was 0); the right counter changes only next to the hub. -/
theorem borrow (k : Nat) (L R : Tape) :
    steps (10 * k + 20) ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons false (R))), .E⟩ = some ⟨cons false (rep (k) [true, true, false, false] (cons true (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (cons true (R))), .E⟩ := by
  have hn : 3 + (0 + ((k) * 4 + (14 + (0 + ((k) * 6 + (3)))))) = 10 * k + 20 := by omega
  have h0 : steps 3 ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons false (R))), .E⟩ = some ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L)))))))), cons true (cons true (R)), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L)))))))), cons true (cons true (R)), .C⟩ = some ⟨rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (L)))))))), cons true (cons true (R)), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L)))))))) = rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (L)))))))) from
      rep_rotate (k) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (cons true (L)))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 4) ⟨rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (L)))))))), cons true (cons true (R)), .C⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (L))))))), cons true (rep (k) [true, false, true, false] (cons true (R))), .C⟩ :=
    cross_l trans c2 (k) (cons false (cons true (cons false (cons true (cons false (cons false (cons true (L)))))))) (cons true (R))
  have h3 : steps 14 ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (L))))))), cons true (rep (k) [true, false, true, false] (cons true (R))), .C⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (L))))), cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (R))))), .E⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons true (cons false (cons true (cons false (L))))), cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (R))))), .E⟩ = some ⟨cons true (cons true (cons false (cons true (cons false (L))))), rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (R))))), .E⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (k) [true, false, true, false] (cons true (R))))) = rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (R))))) from
      rep_rotate (k) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (R))]
  have c5 : ∀ L R : Tape, steps 6 ⟨app [] L, app [false, true, false, true] R, .E⟩ = some ⟨app [] (app [true, true, false, false] L), R, .E⟩ := fun _ _ => rfl
  have h5 : steps ((k) * 6) ⟨cons true (cons true (cons false (cons true (cons false (L))))), rep (k) [false, true, false, true] (cons false (cons true (cons false (cons true (R))))), .E⟩ = some ⟨rep (k) [true, true, false, false] (cons true (cons true (cons false (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (R)))), .E⟩ :=
    cross_r trans c5 (k) (cons true (cons true (cons false (cons true (cons false (L)))))) (cons false (cons true (cons false (cons true (R)))))
  have h6 : steps 3 ⟨rep (k) [true, true, false, false] (cons true (cons true (cons false (cons true (cons false (L)))))), cons false (cons true (cons false (cons true (R)))), .E⟩ = some ⟨cons false (rep (k) [true, true, false, false] (cons true (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (cons true (R))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- The right counter carries through `j` digits (the left counter's lowest digit was 1). -/
