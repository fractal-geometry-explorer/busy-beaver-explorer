    steps (22) ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))), .E⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))), .E⟩ := by
  have hn : 22 = 22 := by omega
  have h0 : steps 22 ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))), .E⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))), .E⟩ := rfl
  exact steps_congr trans hn (h0)

