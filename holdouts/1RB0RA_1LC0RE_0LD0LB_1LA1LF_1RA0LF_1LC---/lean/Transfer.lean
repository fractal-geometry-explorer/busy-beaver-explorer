/-! The shuttle of a transfer of 1RB0RA_1LC0RE_0LD0LB_1LA1LF_1RA0LF_1LC---, generated by `py/transfer.py`; do not edit by hand. -/

namespace H32883

open TM

/-- Going right, A crosses a saturated run `1 (0101)^(a+1)` and flips it. -/
theorem sh_right (a : Nat) (L R : Tape) :
    steps (4 * a + 5) ⟨L, cons true (rep (a + 1) [false, true, false, true] (R)), .A⟩ = some ⟨cons false (rep (a + 1) [true, false, true, false] (L)), R, .A⟩ := by
  have hn : 0 + ((a + 1) * 4 + (1)) = 4 * a + 5 := by omega
  have h0 : steps 0 ⟨L, cons true (rep (a + 1) [false, true, false, true] (R)), .A⟩ = some ⟨L, rep (a + 1) [true, false, true, false] (cons true (R)), .A⟩ := by
    simp only [steps_zero, show cons true (rep (a + 1) [false, true, false, true] (R)) = rep (a + 1) [true, false, true, false] (cons true (R)) from
      rep_rotate (a + 1) [true] [false, true, false, true] [true, false, true, false] rfl (R)]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .A⟩ = some ⟨app [] (app [true, false, true, false] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((a + 1) * 4) ⟨L, rep (a + 1) [true, false, true, false] (cons true (R)), .A⟩ = some ⟨rep (a + 1) [true, false, true, false] (L), cons true (R), .A⟩ :=
    cross_r trans c1 (a + 1) (L) (cons true (R))
  have h2 : steps 1 ⟨rep (a + 1) [true, false, true, false] (L), cons true (R), .A⟩ = some ⟨cons false (rep (a + 1) [true, false, true, false] (L)), R, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- The last run `1 (0101)^z` (z = 0 allowed) before blank tape: A flips it, adds two cells and turns; B is back at the run's first cell. -/
theorem sh_end (z : Nat) (L : Tape) :
    steps (8 * z + 4) ⟨L, cons true (rep (z) [false, true, false, true] (blank)), .A⟩ = some ⟨L, cons false (cons false (rep (z) [true, false, true, false] (cons true (blank)))), .B⟩ := by
  have hn : 0 + ((z) * 4 + (3 + (0 + ((z) * 4 + (1))))) = 8 * z + 4 := by omega
  have h0 : steps 0 ⟨L, cons true (rep (z) [false, true, false, true] (blank)), .A⟩ = some ⟨L, rep (z) [true, false, true, false] (cons true (blank)), .A⟩ := by
    simp only [steps_zero, show cons true (rep (z) [false, true, false, true] (blank)) = rep (z) [true, false, true, false] (cons true (blank)) from
      rep_rotate (z) [true] [false, true, false, true] [true, false, true, false] rfl (blank)]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .A⟩ = some ⟨app [] (app [true, false, true, false] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((z) * 4) ⟨L, rep (z) [true, false, true, false] (cons true (blank)), .A⟩ = some ⟨rep (z) [true, false, true, false] (L), cons true (blank), .A⟩ :=
    cross_r trans c1 (z) (L) (cons true (blank))
  have h2 : steps 3 ⟨rep (z) [true, false, true, false] (L), cons true (blank), .A⟩ = some ⟨cons false (rep (z) [true, false, true, false] (L)), cons true (cons true (blank)), .C⟩ := rfl
  have h3 : steps 0 ⟨cons false (rep (z) [true, false, true, false] (L)), cons true (cons true (blank)), .C⟩ = some ⟨rep (z) [false, true, false, true] (cons false (L)), cons true (cons true (blank)), .C⟩ := by
    simp only [steps_zero, show cons false (rep (z) [true, false, true, false] (L)) = rep (z) [false, true, false, true] (cons false (L)) from
      rep_rotate (z) [false] [true, false, true, false] [false, true, false, true] rfl (L)]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((z) * 4) ⟨rep (z) [false, true, false, true] (cons false (L)), cons true (cons true (blank)), .C⟩ = some ⟨cons false (L), cons true (rep (z) [true, false, true, false] (cons true (blank))), .C⟩ :=
    cross_l trans c4 (z) (cons false (L)) (cons true (blank))
  have h5 : steps 1 ⟨cons false (L), cons true (rep (z) [true, false, true, false] (cons true (blank))), .C⟩ = some ⟨L, cons false (cons false (rep (z) [true, false, true, false] (cons true (blank)))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))


/-- Going left over a flipped saturated run: the doubled cell at its right end moves two cells to the left. -/
theorem sh_left (a : Nat) (L R : Tape) :
    steps (4 * a + 5) ⟨rep (a + 1) [false, true, false, true] (cons false (L)), cons false (R), .B⟩ = some ⟨L, cons false (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))), .B⟩ := by
  have hn : 4 + ((a) * 4 + (1)) = 4 * a + 5 := by omega
  have h0 : steps 4 ⟨rep (a + 1) [false, true, false, true] (cons false (L)), cons false (R), .B⟩ = some ⟨rep (a) [false, true, false, true] (cons false (L)), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((a) * 4) ⟨rep (a) [false, true, false, true] (cons false (L)), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ = some ⟨cons false (L), cons true (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))), .C⟩ :=
    cross_l trans c1 (a) (cons false (L)) (cons true (cons true (cons false (cons true (R)))))
  have h2 : steps 1 ⟨cons false (L), cons true (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))), .C⟩ = some ⟨L, cons false (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- The turn at the left: two cells `1 0` of the run being moved are used up and A starts the next shuttle. -/
theorem sh_turn (L R : Tape) :
    steps (4) ⟨cons false (cons false (cons true (L))), cons false (R), .B⟩ = some ⟨cons false (L), cons true (cons false (cons true (R))), .A⟩ := by
  have hn : 4 = 4 := by omega
  have h0 : steps 4 ⟨cons false (cons false (cons true (L))), cons false (R), .B⟩ = some ⟨cons false (L), cons true (cons false (cons true (R))), .A⟩ := rfl
  exact steps_congr trans hn (h0)



/-! ## One shuttle and m shuttles, for every list of saturated runs

`runs as R` is the right stream `1 (0101)^(a1+1) 1 (0101)^(a2+1) ... R` (run lengths `4a+5`), `passed as L` the
left stream once A has crossed and flipped them. -/

def runs : List Nat → Tape → Tape
  | [], R => R
  | a :: as, R => cons true (rep (a + 1) [false, true, false, true] (runs as R))

def passed : List Nat → Tape → Tape
  | [], L => L
  | a :: as, L => passed as (cons false (rep (a + 1) [true, false, true, false] L))

/-- What the way back leaves to the right of the head (after its cell). -/
def back : List Nat → Tape → Tape
  | [], R => R
  | a :: as, R => cons false (rep a [true, false, true, false] (cons true (cons true (cons false (cons true
      (back as R))))))

def rcst : List Nat → Nat
  | [] => 0
  | a :: as => (4 * a + 5) + rcst as

theorem right_chain : ∀ (as : List Nat) (L R : Tape),
    steps (rcst as) ⟨L, runs as R, .A⟩ = some ⟨passed as L, R, .A⟩
  | [], L, R => rfl
  | a :: as, L, R => by
    have h1 := sh_right a L (runs as R)
    have h2 := right_chain as (cons false (rep (a + 1) [true, false, true, false] L)) R
    exact steps_seq trans h1 h2

theorem sh_left' (a : Nat) (L R : Tape) :
    steps (4 * a + 5) ⟨cons false (rep (a + 1) [true, false, true, false] L), cons false R, .B⟩ =
      some ⟨L, cons false (cons false (rep a [true, false, true, false] (cons true (cons true (cons false
        (cons true R)))))), .B⟩ := by
  have h : cons false (rep (a + 1) [true, false, true, false] L) = rep (a + 1) [false, true, false, true] (cons false L) :=
    rep_rotate (a + 1) [false] [true, false, true, false] [false, true, false, true] rfl L
  rw [h]
  exact sh_left a L R

theorem left_chain : ∀ (as : List Nat) (L R : Tape),
    steps (rcst as) ⟨passed as L, cons false R, .B⟩ = some ⟨L, cons false (back as R), .B⟩
  | [], L, R => rfl
  | a :: as, L, R => by
    have h1 := left_chain as (cons false (rep (a + 1) [true, false, true, false] L)) R
    have h2 := sh_left' a L (back as R)
    exact steps_congr trans (by simp only [rcst]; omega) (steps_seq trans h1 h2)

/-- Re-bracketing `0 1 0 (1010)^n 1 = (0101)^(n+1)`. -/
theorem rot (n : Nat) (s : Tape) :
    cons false (cons true (cons false (rep n [true, false, true, false] (cons true s)))) =
      rep (n + 1) [false, true, false, true] s := by
  have h := rep_rotate n [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true s)
  have h2 := rep_app_comm n [false, true, false, true] s
  rw [← h2]
  exact h

/-- After the way back and the turn the runs are as before, the last one four cells longer. -/
theorem back_runs : ∀ (as : List Nat) (z : Nat),
    cons true (cons false (cons true (back as (cons false (rep z [true, false, true, false] (cons true blank)))))) =
      runs as (cons true (rep (z + 1) [false, true, false, true] blank))
  | [], z => by
    show cons true (cons false (cons true (cons false (rep z [true, false, true, false] (cons true blank))))) =
      cons true (rep (z + 1) [false, true, false, true] blank)
    rw [rot]
  | a :: as, z => by
    show cons true (cons false (cons true (cons false (rep a [true, false, true, false] (cons true (cons true
      (cons false (cons true (back as (cons false (rep z [true, false, true, false] (cons true blank)))))))))))) =
      cons true (rep (a + 1) [false, true, false, true] (runs as (cons true (rep (z + 1) [false, true, false, true] blank))))
    rw [rot, back_runs as z]

/-- One shuttle over the saturated runs `as`: the left run loses `1 0`, the last run `1 (0101)^z` gains four
cells, nothing else changes.  `2 * rcst as + 8 * z + 8` steps. -/
theorem shuttle (as : List Nat) (z : Nat) (L : Tape) :
    steps (2 * rcst as + 8 * z + 8)
      ⟨cons false (cons false (cons true L)), runs as (cons true (rep z [false, true, false, true] blank)), .A⟩ =
      some ⟨cons false L, runs as (cons true (rep (z + 1) [false, true, false, true] blank)), .A⟩ := by
  have h1 := right_chain as (cons false (cons false (cons true L))) (cons true (rep z [false, true, false, true] blank))
  have h2 := sh_end z (passed as (cons false (cons false (cons true L))))
  have h3 := left_chain as (cons false (cons false (cons true L))) (cons false (rep z [true, false, true, false] (cons true blank)))
  have h4 := sh_turn L (back as (cons false (rep z [true, false, true, false] (cons true blank))))
  rw [back_runs as z] at h4
  exact steps_congr trans (by omega) (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 h4)))

def scst (as : List Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | m + 1, z => (2 * rcst as + 8 * z + 8) + scst as m (z + 1)

/-- m shuttles: `L (10)^m 0 A> 1 (0101)^(a1+1) ... 1 (0101)^z 0^inf` becomes
`L 0 A> 1 (0101)^(a1+1) ... 1 (0101)^(z+m) 0^inf`: 2m cells leave the left run, 4m arrive at the right end. -/
theorem shuttles (as : List Nat) : ∀ (m z : Nat) (L : Tape),
    steps (scst as m z)
      ⟨cons false (rep m [false, true] L), runs as (cons true (rep z [false, true, false, true] blank)), .A⟩ =
      some ⟨cons false L, runs as (cons true (rep (z + m) [false, true, false, true] blank)), .A⟩
  | 0, z, L => rfl
  | m + 1, z, L => by
    have h1 := shuttle as z (rep m [false, true] L)
    have h2 := shuttles as m (z + 1) L
    have e : z + 1 + m = z + (m + 1) := by omega
    rw [e] at h2
    exact steps_seq trans h1 h2

/-- The step count of m shuttles in closed form. -/
theorem scst_eq (as : List Nat) : ∀ (m z : Nat), scst as m z = m * (2 * rcst as + 8 * z + 8) + 4 * m * (m - 1)
  | 0, _ => by simp [scst]
  | m + 1, z => by
    rw [scst, scst_eq as m (z + 1)]
    cases m with
    | zero => simp
    | succ k =>
      simp only [Nat.add_sub_cancel]
      generalize rcst as = r
      have e1 : (k + 1) * (2 * r + 8 * (z + 1) + 8) = (k + 1) * (2 * r + 8 * z + 8) + 8 * (k + 1) := by
        rw [show 2 * r + 8 * (z + 1) + 8 = (2 * r + 8 * z + 8) + 8 by omega, Nat.mul_add, Nat.mul_comm (k + 1) 8]
      have e2 : (k + 1 + 1) * (2 * r + 8 * z + 8) = (k + 1) * (2 * r + 8 * z + 8) + (2 * r + 8 * z + 8) := by
        rw [Nat.add_mul, Nat.one_mul]
      have e3 : 4 * (k + 1) * k = 4 * (k * k) + 4 * k := by
        rw [Nat.mul_assoc, Nat.add_mul, Nat.one_mul, Nat.mul_add]
      have e4 : 4 * (k + 1 + 1) * (k + 1) = 4 * (k * k) + 12 * k + 8 := by
        rw [Nat.mul_assoc, show (k + 1 + 1) * (k + 1) = k * k + 3 * k + 2 by
          rw [Nat.add_mul, Nat.add_mul, Nat.mul_add, Nat.mul_add]; omega]
        omega
      rw [e1, e2, e3, e4]
      omega


/-! ## The events at a run boundary (for every surrounding tape) -/

/-- Run boundary, going right, 0 cells left over (the run counted from A on a 0 has length 0 mod 4): A takes the first cell of the next run (a 1) and goes on.  Every cell is flipped. -/
theorem loc_pass0 (n : Nat) (L R : Tape) :
    steps (4 * n + 1) ⟨L, rep (n) [false, true, false, true] (cons true (R)), .A⟩ = some ⟨cons false (rep (n) [false, true, false, true] (L)), R, .A⟩ := by
  have hn : (n) * 4 + (1) = 4 * n + 1 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨L, rep (n) [false, true, false, true] (cons true (R)), .A⟩ = some ⟨rep (n) [false, true, false, true] (L), cons true (R), .A⟩ :=
    cross_r trans c0 (n) (L) (cons true (R))
  have h1 : steps 1 ⟨rep (n) [false, true, false, true] (L), cons true (R), .A⟩ = some ⟨cons false (rep (n) [false, true, false, true] (L)), R, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- Run boundary, going right, length 3 mod 4: A is on the first cell of the next run (a 0) and goes on. -/
theorem loc_pass3 (n : Nat) (L R : Tape) :
    steps (4 * n + 3) ⟨L, rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ = some ⟨cons true (cons false (cons true (rep (n) [false, true, false, true] (L)))), cons false (R), .A⟩ := by
  have hn : (n) * 4 + (3) = 4 * n + 3 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨L, rep (n) [false, true, false, true] (cons false (cons true (cons false (cons false (R))))), .A⟩ = some ⟨rep (n) [false, true, false, true] (L), cons false (cons true (cons false (cons false (R)))), .A⟩ :=
    cross_r trans c0 (n) (L) (cons false (cons true (cons false (cons false (R)))))
  have h1 : steps 3 ⟨rep (n) [false, true, false, true] (L), cons false (cons true (cons false (cons false (R)))), .A⟩ = some ⟨cons true (cons false (cons true (rep (n) [false, true, false, true] (L)))), cons false (R), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- Run boundary, going right, length 1 mod 4: the head turns.  Back at the cell before the run (here a 0) the run is one cell longer and the next run has lost its first cell. -/
theorem loc_turn1 (n : Nat) (L R : Tape) :
    steps (8 * n + 11) ⟨cons false (L), rep (n + 1) [false, true, false, true] (cons false (cons false (R))), .A⟩ = some ⟨L, cons false (cons false (cons true (rep (n + 1) [false, true, false, true] (R)))), .B⟩ := by
  have hn : (n + 1) * 4 + (1 + (0 + ((n + 1) * 4 + (2)))) = 8 * n + 11 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n + 1) * 4) ⟨cons false (L), rep (n + 1) [false, true, false, true] (cons false (cons false (R))), .A⟩ = some ⟨rep (n + 1) [false, true, false, true] (cons false (L)), cons false (cons false (R)), .A⟩ :=
    cross_r trans c0 (n + 1) (cons false (L)) (cons false (cons false (R)))
  have h1 : steps 1 ⟨rep (n + 1) [false, true, false, true] (cons false (L)), cons false (cons false (R)), .A⟩ = some ⟨cons true (rep (n + 1) [false, true, false, true] (cons false (L))), cons false (R), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (rep (n + 1) [false, true, false, true] (cons false (L))), cons false (R), .B⟩ = some ⟨rep (n + 1) [true, false, true, false] (cons true (cons false (L))), cons false (R), .B⟩ := by
    simp only [steps_zero, show cons true (rep (n + 1) [false, true, false, true] (cons false (L))) = rep (n + 1) [true, false, true, false] (cons true (cons false (L))) from
      rep_rotate (n + 1) [true] [false, true, false, true] [true, false, true, false] rfl (cons false (L))]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .B⟩ := fun _ _ => rfl
  have h3 : steps ((n + 1) * 4) ⟨rep (n + 1) [true, false, true, false] (cons true (cons false (L))), cons false (R), .B⟩ = some ⟨cons true (cons false (L)), cons false (rep (n + 1) [false, true, false, true] (R)), .B⟩ :=
    cross_l trans c3 (n + 1) (cons true (cons false (L))) (R)
  have h4 : steps 2 ⟨cons true (cons false (L)), cons false (rep (n + 1) [false, true, false, true] (R)), .B⟩ = some ⟨L, cons false (cons false (cons true (rep (n + 1) [false, true, false, true] (R)))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))


/-- Run boundary, going right, length 2 mod 4: the head turns; the next run has lost its first cell. -/
theorem loc_turn2 (n : Nat) (L R : Tape) :
    steps (8 * n + 13) ⟨cons false (L), rep (n + 1) [false, true, false, true] (cons false (cons true (cons true (R)))), .A⟩ = some ⟨L, cons false (cons false (rep (n + 1) [true, false, true, false] (cons true (cons false (R))))), .B⟩ := by
  have hn : (n + 1) * 4 + (4 + ((n + 1) * 4 + (1))) = 8 * n + 13 := by omega
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n + 1) * 4) ⟨cons false (L), rep (n + 1) [false, true, false, true] (cons false (cons true (cons true (R)))), .A⟩ = some ⟨rep (n + 1) [false, true, false, true] (cons false (L)), cons false (cons true (cons true (R))), .A⟩ :=
    cross_r trans c0 (n + 1) (cons false (L)) (cons false (cons true (cons true (R))))
  have h1 : steps 4 ⟨rep (n + 1) [false, true, false, true] (cons false (L)), cons false (cons true (cons true (R))), .A⟩ = some ⟨rep (n + 1) [false, true, false, true] (cons false (L)), cons true (cons true (cons false (R))), .C⟩ := rfl
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((n + 1) * 4) ⟨rep (n + 1) [false, true, false, true] (cons false (L)), cons true (cons true (cons false (R))), .C⟩ = some ⟨cons false (L), cons true (rep (n + 1) [true, false, true, false] (cons true (cons false (R)))), .C⟩ :=
    cross_l trans c2 (n + 1) (cons false (L)) (cons true (cons false (R)))
  have h3 : steps 1 ⟨cons false (L), cons true (rep (n + 1) [true, false, true, false] (cons true (cons false (R)))), .C⟩ = some ⟨L, cons false (cons false (rep (n + 1) [true, false, true, false] (cons true (cons false (R))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))


/-- Going left onto a run that ends `0 1 0 1 0` before a `00`: the doubled cell moves two cells to the left. -/
theorem loc_cross (L R : Tape) :
    steps (5) ⟨cons false (cons true (cons false (cons true (cons false (L))))), cons false (R), .B⟩ = some ⟨L, cons false (cons false (cons true (cons true (cons false (cons true (R)))))), .B⟩ := by
  have hn : 5 = 5 := by omega
  have h0 : steps 5 ⟨cons false (cons true (cons false (cons true (cons false (L))))), cons false (R), .B⟩ = some ⟨L, cons false (cons false (cons true (cons true (cons false (cons true (R)))))), .B⟩ := rfl
  exact steps_congr trans hn (h0)


/-- Going left onto a run that ends in 1 before a `11`: the head turns right (a bounce); that run loses its last cell. -/
theorem loc_bounce (L R : Tape) :
    steps (4) ⟨cons true (L), cons true (cons true (R)), .C⟩ = some ⟨cons false (cons true (cons false (L))), R, .A⟩ := by
  have hn : 4 = 4 := by omega
  have h0 : steps 4 ⟨cons true (L), cons true (cons true (R)), .C⟩ = some ⟨cons false (cons true (cons false (L))), R, .A⟩ := rfl
  exact steps_congr trans hn (h0)


/-- Going left onto a run `1 0` of length 2 between a `11` and a `00`: three steps later F reads a 1. -/
theorem loc_halt (L R : Tape) :
    steps (3) ⟨cons false (cons true (cons true (L))), cons false (R), .B⟩ = some ⟨L, cons true (cons true (cons false (cons true (R)))), .F⟩ := by
  have hn : 3 = 3 := by omega
  have h0 : steps 3 ⟨cons false (cons true (cons true (L))), cons false (R), .B⟩ = some ⟨L, cons true (cons true (cons false (cons true (R)))), .F⟩ := rfl
  exact steps_congr trans hn (h0)



/-- ... and F on a 1 is the halting transition: the pattern of `loc_halt` halts after 4 steps. -/
theorem loc_halt_stops (L R : Tape) : step ⟨L, cons true R, .F⟩ = none := rfl


end H32883
