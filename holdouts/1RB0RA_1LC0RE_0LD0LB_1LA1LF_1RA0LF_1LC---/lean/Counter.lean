    cross_r trans c9 (d + 1) (cons false (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))))))))) (cons true (cons false (cons true (cons true (cons false (R))))))
  have h10 : steps 5 ⟨rep (d + 1) [true, false, true, false] (cons false (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))))))))), cons true (cons false (cons true (cons true (cons false (R))))), .A⟩ = some ⟨cons false (rep (d + 1) [true, false, true, false] (cons false (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))))))), cons true (cons true (cons false (cons false (R)))), .C⟩ := rfl
