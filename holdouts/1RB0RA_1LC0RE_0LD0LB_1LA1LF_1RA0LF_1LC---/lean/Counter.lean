  have h12 : steps ((d + 1) * 4) ⟨rep (d + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))))))), cons true (cons true (cons false (cons false (R)))), .C⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))))))))), cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R))))), .C⟩ :=
    cross_l trans c12 (d + 1) (cons false (cons false (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))))))) (cons true (cons false (cons false (R))))
  have h13 : steps 5 ⟨cons false (cons false (cons true (cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))))))))), cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R))))), .C⟩ = some ⟨rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))), cons true (cons true (cons true (cons false (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R)))))))))), .C⟩ := rfl
