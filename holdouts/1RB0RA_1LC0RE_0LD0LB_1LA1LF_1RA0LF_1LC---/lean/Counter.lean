  have h14 : steps ((c) * 4) ⟨rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))), cons true (cons true (cons true (cons false (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R)))))))))), .C⟩ = some ⟨cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))), cons true (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R))))))))))), .C⟩ :=
