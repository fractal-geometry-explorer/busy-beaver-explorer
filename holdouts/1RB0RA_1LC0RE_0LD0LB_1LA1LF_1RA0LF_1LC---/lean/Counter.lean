/-- Going home, B crosses a digit the carry went through. -/
theorem home (c e : Nat) (L R : Tape) :
    steps (4 * c + 4 * e + 14) ⟨cons false (cons true (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))), cons false (R), .B⟩ = some ⟨L, cons false (cons false (cons true (cons false (rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))))))))))))), .B⟩ := by
  have hn : 4 + (0 + ((c) * 4 + (7 + (0 + ((e) * 4 + (3)))))) = 4 * c + 4 * e + 14 := by omega
  have h0 : steps 4 ⟨cons false (cons true (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))), cons false (R), .B⟩ = some ⟨cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ = some ⟨rep (c) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))) = rep (c) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))) from
      rep_rotate (c) [false, true] [false, true, false, true] [false, true, false, true] rfl (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((c) * 4) ⟨rep (c) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ = some ⟨cons false (cons true (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))))), cons true (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))), .C⟩ :=
    cross_l trans c2 (c) (cons false (cons true (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L)))))))) (cons true (cons true (cons false (cons true (R)))))
  have h3 : steps 7 ⟨cons false (cons true (cons false (cons false (cons true (cons false (rep (e + 1) [true, false, true, false] (L))))))), cons true (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))), .C⟩ = some ⟨cons false (cons true (cons false (rep (e) [true, false, true, false] (L)))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))))))))), .C⟩ := rfl
  have h4 : steps 0 ⟨cons false (cons true (cons false (rep (e) [true, false, true, false] (L)))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))))))))), .C⟩ = some ⟨rep (e) [false, true, false, true] (cons false (cons true (cons false (L)))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))))))))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (e) [true, false, true, false] (L)))) = rep (e) [false, true, false, true] (cons false (cons true (cons false (L)))) from
      rep_rotate (e) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (L)]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h5 : steps ((e) * 4) ⟨rep (e) [false, true, false, true] (cons false (cons true (cons false (L)))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))))))))), .C⟩ = some ⟨cons false (cons true (cons false (L))), cons true (rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))))))))))), .C⟩ :=
    cross_l trans c5 (e) (cons false (cons true (cons false (L)))) (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))))))))))
  have h6 : steps 3 ⟨cons false (cons true (cons false (L))), cons true (rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))))))))))), .C⟩ = some ⟨L, cons false (cons false (cons true (cons false (rep (e) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (R))))))))))))))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


/-- Going home, B crosses digit 0 and the left end grows by four cells; A starts the next trip. -/
theorem home0 (a : Nat) (R : Tape) :
    steps (4 * a + 10) ⟨cons false (cons true (rep (a + 1) [false, true, false, true] (blank))), cons false (R), .B⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))))))))), .A⟩ := by
  have hn : 4 + (0 + ((a) * 4 + (6))) = 4 * a + 10 := by omega
  have h0 : steps 4 ⟨cons false (cons true (rep (a + 1) [false, true, false, true] (blank))), cons false (R), .B⟩ = some ⟨cons false (cons true (rep (a) [false, true, false, true] (blank))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (rep (a) [false, true, false, true] (blank))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ = some ⟨rep (a) [false, true, false, true] (cons false (cons true (blank))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (a) [false, true, false, true] (blank))) = rep (a) [false, true, false, true] (cons false (cons true (blank))) from
      rep_rotate (a) [false, true] [false, true, false, true] [false, true, false, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((a) * 4) ⟨rep (a) [false, true, false, true] (cons false (cons true (blank))), cons true (cons true (cons true (cons false (cons true (R))))), .C⟩ = some ⟨cons false (cons true (blank)), cons true (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))), .C⟩ :=
    cross_l trans c2 (a) (cons false (cons true (blank))) (cons true (cons true (cons false (cons true (R)))))
  have h3 : steps 6 ⟨cons false (cons true (blank)), cons true (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (R)))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))



/-! ## Chaining the pieces: one theorem per kind of trip, every carry depth

The left stream after the carry has passed digits `1..k` and the right stream of the digits still ahead, nearest
cell first as in `TM.Tape`.  `cin e L` is `L 1 (1010)^(e+1) 1` (the head has just arrived at a digit in B),
`kblk e c L` is `L (0101)^(e+1) 0 1 0 0 (1010)^(c+1) 1 0` (a digit the carry has passed), `dig2 c d R` is a digit at
2, `(0101)^(c+2) 0 (0101)^(d+1) 0 R`. -/

def cin (e : Nat) (L : Tape) : Tape := cons true (rep (e + 1) [false, true, false, true] (cons true L))

def kblk (e c : Nat) (L : Tape) : Tape :=
  cons false (cons true (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false
    (rep (e + 1) [true, false, true, false] L)))))))

def dig2 (c d : Nat) (R : Tape) : Tape :=
  rep (c + 2) [false, true, false, true] (cons false (rep (d + 1) [false, true, false, true] (cons false R)))

/-- The digits at 2 that a carry passes, nearest first, as `(c, d)` with `(x, y) = (4c+9, 4d+5)`. -/
def digs : List (Nat × Nat) → Tape → Tape
  | [], R => R
  | (c, d) :: ds, R => dig2 c d (digs ds R)

/-- The left stream once the carry has passed the digits `ds` (the first entered with `cin e`). -/
def cout : Nat → List (Nat × Nat) → Tape → Tape
  | _, [], L => L
  | e, (c, d) :: ds, L => cout d ds (kblk e c L)

def clast : Nat → List (Nat × Nat) → Nat
  | e, [] => e
  | _, (_, d) :: ds => clast d ds

def ccost : Nat → List (Nat × Nat) → Nat
  | _, [] => 0
  | e, (c, d) :: ds => (4 * c + 4 * d + 8 * e + 26) + ccost d ds

/-- The carry runs through every digit of `ds` (each at 2) and arrives at the digit after them. -/
theorem carry_chain : ∀ (ds : List (Nat × Nat)) (e : Nat) (L R : Tape),
    steps (ccost e ds) ⟨cin e L, digs ds R, .B⟩ = some ⟨cin (clast e ds) (cout e ds L), R, .B⟩
  | [], e, L, R => rfl
  | (c, d) :: ds, e, L, R => by
    have h1 := carry c d e L (digs ds R)
    have h2 := carry_chain ds d (kblk e c L) R
    exact steps_seq trans h1 h2

/-- What going home leaves behind each passed digit (the right stream after it). -/
def wout (e c : Nat) (R : Tape) : Tape :=
  cons false (cons true (cons false (rep e [true, false, true, false] (cons true (cons true (cons false (cons true
    (cons false (cons true (cons false (rep c [true, false, true, false] (cons true (cons true (cons false
    (cons true R)))))))))))))))

def rout : Nat → List (Nat × Nat) → Tape → Tape
  | _, [], R => R
  | e, (c, d) :: ds, R => wout e c (rout d ds R)

def rcost : Nat → List (Nat × Nat) → Nat
  | _, [] => 0
  | e, (c, d) :: ds => rcost d ds + (4 * c + 4 * e + 14)

/-- Going home over every digit the carry passed. -/
theorem home_chain : ∀ (ds : List (Nat × Nat)) (e : Nat) (L R : Tape),
    steps (rcost e ds) ⟨cout e ds L, cons false R, .B⟩ = some ⟨L, cons false (rout e ds R), .B⟩
  | [], e, L, R => rfl
  | (c, d) :: ds, e, L, R => by
    have h1 := home_chain ds d (kblk e c L) R
    have h2 := home c e L (rout d ds R)
    exact steps_seq trans h1 h2

/-- Digit 0 at 2 as the trip finds it: `(0101)^(a+1) 010 (0101)^(b+1) 0`, i.e. `(r0, r1) = (4a+7, 4b+5)`. -/
def d0two (a b : Nat) (R : Tape) : Tape :=
  rep (a + 1) [false, true, false, true] (cons false (cons true (cons false
    (rep (b + 1) [false, true, false, true] (cons false R)))))

/-- The left stream `0^inf (1010)^(a+1) 1 0` that digit 0 leaves while the carry is out. -/
def lhome (a : Nat) : Tape := cons false (cons true (rep (a + 1) [false, true, false, true] blank))


/-- A carry that stops at a digit at 1: digit 0 at 2, the digits `ds` at 2, then a digit `(x, y) = (4c+4, 4d+6)`. Every carry depth `ds.length + 1` at once. -/
theorem trip_stop1 (a b c d : Nat) (ds : List (Nat × Nat)) (R : Tape) :
    steps ((4 * a + 4 * b + 12) + ccost b ds + (8 * c + 12 * clast b ds + 26) + rcost b ds + (4 * a + 10)) ⟨blank, d0two a b (digs ds (rep (c + 1) [false, true, false, true] (rep (d + 1) [true, false, true, false] (cons true (cons false (R)))))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (rout b ds (cons false (cons true (cons false (rep (clast b ds) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (R))))))))))))))))))))))))))))))), .A⟩ := by
  have h1 := out0 a b (digs ds (rep (c + 1) [false, true, false, true] (rep (d + 1) [true, false, true, false] (cons true (cons false (R))))))
  have h2 := carry_chain ds b (lhome a) (rep (c + 1) [false, true, false, true] (rep (d + 1) [true, false, true, false] (cons true (cons false (R)))))
  have h3 := absorb1 c d (clast b ds) (cout b ds (lhome a)) R
  have h4 := home_chain ds b (lhome a) (cons false (cons true (cons false (rep (clast b ds) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (R)))))))))))))))))))
  have h5 := home0 a (rout b ds (cons false (cons true (cons false (rep (clast b ds) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (rep (d) [true, false, true, false] (cons true (cons false (R))))))))))))))))))))
  exact steps_congr trans (by omega) (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5))))

/-- A carry that stops at a digit at 0: digit 0 at 2, the digits `ds` at 2, then a digit `(x, y) = (4c+6, 4d+7)` and the next digit starting `1 0` (its first cell is taken).  Every carry depth at once. -/
theorem trip_stop0 (a b c d : Nat) (ds : List (Nat × Nat)) (R : Tape) :
    steps ((4 * a + 4 * b + 12) + ccost b ds + (8 * c + 8 * d + 12 * clast b ds + 44) + rcost b ds + (4 * a + 10)) ⟨blank, d0two a b (digs ds (rep (c + 1) [false, true, false, true] (cons false (cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R))))))))))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (a) [true, false, true, false] (cons true (cons true (cons false (cons true (rout b ds (cons false (cons true (cons false (rep (clast b ds) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R)))))))))))))))))))))))))))))))), .A⟩ := by
  have h1 := out0 a b (digs ds (rep (c + 1) [false, true, false, true] (cons false (cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R)))))))))))
  have h2 := carry_chain ds b (lhome a) (rep (c + 1) [false, true, false, true] (cons false (cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (R))))))))))
  have h3 := absorb0 c d (clast b ds) (cout b ds (lhome a)) R
  have h4 := home_chain ds b (lhome a) (cons false (cons true (cons false (rep (clast b ds) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R))))))))))))))))))))
  have h5 := home0 a (rout b ds (cons false (cons true (cons false (rep (clast b ds) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (c) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (R)))))))))))))))))))))
  exact steps_congr trans (by omega) (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 h5))))

