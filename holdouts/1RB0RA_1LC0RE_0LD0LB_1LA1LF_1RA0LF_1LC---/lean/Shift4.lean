  have h0 : steps ((a + 1) * 4) ⟨rep (a + 1) [true, false, true, false] (blank), cons false (R), .B⟩ = some ⟨blank, cons false (rep (a + 1) [false, true, false, true] (R)), .B⟩ :=
    cross_l trans c0 (a + 1) (blank) (R)
  have h1 : steps 4 ⟨blank, cons false (rep (a + 1) [false, true, false, true] (R)), .B⟩ = some ⟨cons true (blank), cons true (cons false (cons true (rep (a + 1) [false, true, false, true] (R)))), .B⟩ := rfl
  have h2 : steps 0 ⟨cons true (blank), cons true (cons false (cons true (rep (a + 1) [false, true, false, true] (R)))), .B⟩ = some ⟨cons true (blank), rep (a + 1) [true, false, true, false] (cons true (cons false (cons true (R)))), .B⟩ := by
