      rep_rotate (a + 1) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (R)]
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h3 : steps ((a + 1) * 4) ⟨cons true (blank), rep (a + 1) [true, false, true, false] (cons true (cons false (cons true (R)))), .B⟩ = some ⟨rep (a + 1) [true, false, true, false] (cons true (blank)), cons true (cons false (cons true (R))), .B⟩ :=
    cross_r trans c3 (a + 1) (cons true (blank)) (cons true (cons false (cons true (R))))
