/-- A steps onto the last cell of an alternating stretch, a 0, and comes back out in B after 1 steps, having looked at its last 1 cells only (any tape L further left). -/
theorem enter_A0 (L R : Tape) :
    steps (1) ⟨L, cons false (R), .A⟩ = some ⟨cons true (L), R, .B⟩ := by
  have hn : 1 = 1 := by omega
  have h0 : steps 1 ⟨L, cons false (R), .A⟩ = some ⟨cons true (L), R, .B⟩ := rfl
  exact steps_congr trans hn (h0)

