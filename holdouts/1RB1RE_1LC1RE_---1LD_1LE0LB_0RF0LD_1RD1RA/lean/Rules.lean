    cross_r trans c1 (r) (cons false (cons true (K0))) (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank))))))))))))
  have h2 : steps 10 ⟨rep (r) [false, true] (cons false (cons true (K0))), cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank))))))))))), .F⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (r) [false, true] (cons false (cons true (K0))))))))))), rep (q) [false, true] (cons false (cons true (blank))), .F⟩ := rfl
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h3 : steps ((q) * 4) ⟨cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (r) [false, true] (cons false (cons true (K0))))))))))), rep (q) [false, true] (cons false (cons true (blank))), .F⟩ = some ⟨rep (q) [false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (r) [false, true] (cons false (cons true (K0)))))))))))), cons false (cons true (blank)), .F⟩ :=
    cross_r trans c3 (q) (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (r) [false, true] (cons false (cons true (K0)))))))))))) (cons false (cons true (blank)))
  have h4 : steps 5 ⟨rep (q) [false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (r) [false, true] (cons false (cons true (K0)))))))))))), cons false (cons true (blank)), .F⟩ = some ⟨cons true (cons false (cons true (rep (q) [false, true] (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons true (rep (r) [false, true] (cons false (cons true (K0))))))))))))))), blank, .D⟩ := rfl
  exact steps_congr trans (a := 3 + ((r) * 4 + (10 + ((q) * 4 + (5))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The same with the separator 1011 before the last block (and at least one middle block a^(r+2) next to it). -/
theorem drainSD (m p q r : Nat) (ts : List (Nat)) (L : Tape) :
