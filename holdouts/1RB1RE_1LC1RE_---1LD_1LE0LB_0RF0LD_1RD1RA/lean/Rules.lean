  exact steps_congr trans (a := 2 + ((q) * 2 + (9 + ((q) * 4 + (5))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

