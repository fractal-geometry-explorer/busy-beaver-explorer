  have h1 : steps ((p) * 2) ⟨rep (p) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L))), cons false (cons true (cons true (cons false (cons false (K1))))), .D⟩ = some ⟨rep (m + 1) [true, true, true, false] (cons true (L)), cons false (rep (p) [false, true] (cons true (cons true (cons false (cons false (K1)))))), .D⟩ :=
    cross_l trans c1 (p) (rep (m + 1) [true, true, true, false] (cons true (L))) (cons true (cons true (cons false (cons false (K1)))))
  have h2 : steps 9 ⟨rep (m + 1) [true, true, true, false] (cons true (L)), cons false (rep (p) [false, true] (cons true (cons true (cons false (cons false (K1)))))), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L))))))), rep (p) [false, true] (cons true (cons true (cons false (cons false (K1))))), .F⟩ := rfl
  have c3 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
  have h3 : steps ((p) * 4) ⟨cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L))))))), rep (p) [false, true] (cons true (cons true (cons false (cons false (K1))))), .F⟩ = some ⟨rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))), cons true (cons true (cons false (cons false (K1)))), .F⟩ :=
    cross_r trans c3 (p) (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))) (cons true (cons true (cons false (cons false (K1)))))
  have h4 : steps 4 ⟨rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))), cons true (cons true (cons false (cons false (K1)))), .F⟩ = some ⟨cons true (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))), K1, .D⟩ := rfl
  exact steps_congr trans (a := 4 + ((p) * 2 + (9 + ((p) * 4 + (4))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

