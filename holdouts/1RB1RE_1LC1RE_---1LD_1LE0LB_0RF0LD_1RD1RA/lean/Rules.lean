  have h0 : steps 3 ⟨cons true (K0), cons true (rep (r) [false, true] (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank))))))))))))), .D⟩ = some ⟨cons false (cons true (K0)), rep (r) [false, true] (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank)))))))))))), .F⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true] R, .F⟩ = some ⟨app [] (app [false, true] L), R, .F⟩ := fun _ _ => rfl
