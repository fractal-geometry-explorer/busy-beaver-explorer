  exact steps_congr trans (a := 3 + ((q) * 4 + (5))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A drain trip over any list `ts` of middle blocks a^(x+2), each after the separator 1: the block next to the b's gains one a, the last block two, the middle ones stay. -/
theorem drainS (m p q : Nat) (ts : List (Nat)) (L : Tape) :
    ∃ n, steps n ⟨rep (q + 1) [true, false] (cons true (sq (fun (x : Nat) (X : Tape) => rep (x + 2) [true, false] (cons true (X))) ts (rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L)))))), blank, .D⟩ = some ⟨cons true (cons false (cons true (rep (q) [false, true] (cons false (cons true (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons true (rep (x) [false, true] (cons false (cons true (X))))))) ts (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))))))))), blank, .D⟩ := by
  have h0 : ∃ n, steps n ⟨rep (q + 1) [true, false] (cons true (sq (fun (x : Nat) (X : Tape) => rep (x + 2) [true, false] (cons true (X))) ts (rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L)))))), blank, .D⟩ = some ⟨sq (fun (x : Nat) (X : Tape) => rep (x + 2) [true, false] (cons true (X))) ts (rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L)))), cons true (cons true (rep (q) [false, true] (cons false (cons true (blank))))), .E⟩ :=
    ⟨_, drainS_s0 q (sq (fun (x : Nat) (X : Tape) => rep (x + 2) [true, false] (cons true (X))) ts (rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L)))))⟩
  have h1 : ∃ n, steps n ⟨sq (fun (x : Nat) (X : Tape) => rep (x + 2) [true, false] (cons true (X))) ts (rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L)))), cons true (cons true (rep (q) [false, true] (cons false (cons true (blank))))), .E⟩ = some ⟨rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L))), cons true (sqr (fun (x : Nat) (X : Tape) => cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (X))))))) ts (cons true (rep (q) [false, true] (cons false (cons true (blank)))))), .E⟩ :=
    seqL (fun (x : Nat) (X : Tape) => rep (x + 2) [true, false] (cons true (X))) (fun (x : Nat) (X : Tape) => cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (X))))))) (fun Y => cons true (Y)) .E (fun x L R => ⟨_, drainS_b1 x L R⟩) ts (rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L)))) (cons true (rep (q) [false, true] (cons false (cons true (blank)))))
  have h2 : ∃ n, steps n ⟨rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L))), cons true (sqr (fun (x : Nat) (X : Tape) => cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (X))))))) ts (cons true (rep (q) [false, true] (cons false (cons true (blank)))))), .E⟩ = some ⟨cons true (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))), sqr (fun (x : Nat) (X : Tape) => cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (X))))))) ts (cons true (rep (q) [false, true] (cons false (cons true (blank))))), .D⟩ :=
    ⟨_, drainS_s2 m p L (sqr (fun (x : Nat) (X : Tape) => cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (X))))))) ts (cons true (rep (q) [false, true] (cons false (cons true (blank))))))⟩
  have h3 : ∃ n, steps n ⟨cons true (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))), sqr (fun (x : Nat) (X : Tape) => cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (X))))))) ts (cons true (rep (q) [false, true] (cons false (cons true (blank))))), .D⟩ = some ⟨cons true (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons true (rep (x) [false, true] (cons false (cons true (X))))))) ts (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L))))))))))))), cons true (rep (q) [false, true] (cons false (cons true (blank)))), .D⟩ :=
    seqR' (fun (x : Nat) (X : Tape) => cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (X))))))) (fun (x : Nat) (X : Tape) => cons false (cons true (cons true (rep (x) [false, true] (cons false (cons true (X))))))) (fun Y => cons true (Y)) .D (fun x L R => ⟨_, drainS_b3 x L R⟩) ts (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))) (cons true (rep (q) [false, true] (cons false (cons true (blank)))))
  have h4 : ∃ n, steps n ⟨cons true (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons true (rep (x) [false, true] (cons false (cons true (X))))))) ts (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L))))))))))))), cons true (rep (q) [false, true] (cons false (cons true (blank)))), .D⟩ = some ⟨cons true (cons false (cons true (rep (q) [false, true] (cons false (cons true (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons true (rep (x) [false, true] (cons false (cons true (X))))))) ts (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))))))))), blank, .D⟩ :=
    ⟨_, drainS_s4 q (sq (fun (x : Nat) (X : Tape) => cons false (cons true (cons true (rep (x) [false, true] (cons false (cons true (X))))))) ts (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

/-- drainSD, stretch 0. -/
theorem drainSD_s0 (q r : Nat) (K0 : Tape) :
    steps (2 * q + 2 * r + 11) ⟨rep (q + 1) [true, false] (cons true (cons true (cons false (cons true (rep (r + 2) [true, false] (cons true (K0))))))), blank, .D⟩ = some ⟨K0, cons true (cons true (rep (r) [false, true] (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank)))))))))))))), .E⟩ := by
  have h0 : steps 2 ⟨rep (q + 1) [true, false] (cons true (cons true (cons false (cons true (rep (r + 2) [true, false] (cons true (K0))))))), blank, .D⟩ = some ⟨rep (q) [true, false] (cons true (cons true (cons false (cons true (rep (r + 2) [true, false] (cons true (K0))))))), cons false (cons false (cons true (blank))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((q) * 2) ⟨rep (q) [true, false] (cons true (cons true (cons false (cons true (rep (r + 2) [true, false] (cons true (K0))))))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨cons true (cons true (cons false (cons true (rep (r + 2) [true, false] (cons true (K0)))))), cons false (rep (q) [false, true] (cons false (cons true (blank)))), .D⟩ :=
    cross_l trans c1 (q) (cons true (cons true (cons false (cons true (rep (r + 2) [true, false] (cons true (K0))))))) (cons false (cons true (blank)))
  have h2 : steps 8 ⟨cons true (cons true (cons false (cons true (rep (r + 2) [true, false] (cons true (K0)))))), cons false (rep (q) [false, true] (cons false (cons true (blank)))), .D⟩ = some ⟨rep (r) [true, false] (cons true (K0)), cons false (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank)))))))))))), .D⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h3 : steps ((r) * 2) ⟨rep (r) [true, false] (cons true (K0)), cons false (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank)))))))))))), .D⟩ = some ⟨cons true (K0), cons false (rep (r) [false, true] (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank))))))))))))), .D⟩ :=
    cross_l trans c3 (r) (cons true (K0)) (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank))))))))))))
  have h4 : steps 1 ⟨cons true (K0), cons false (rep (r) [false, true] (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank))))))))))))), .D⟩ = some ⟨K0, cons true (cons true (rep (r) [false, true] (cons true (cons true (cons false (cons true (cons true (cons false (cons false (cons true (rep (q) [false, true] (cons false (cons true (blank)))))))))))))), .E⟩ := rfl
  exact steps_congr trans (a := 2 + ((q) * 2 + (8 + ((r) * 2 + (1))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- One block of drainSD, move 1. -/
theorem drainSD_b1 (x : Nat) (L R : Tape) :
    steps (2 * x + 5) ⟨rep (x + 2) [true, false] (cons true (L)), cons true (R), .E⟩ = some ⟨L, cons true (cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (R))))))), .E⟩ := by
  have h0 : steps 4 ⟨rep (x + 2) [true, false] (cons true (L)), cons true (R), .E⟩ = some ⟨rep (x) [true, false] (cons true (L)), cons false (cons true (cons true (cons false (cons false (R))))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((x) * 2) ⟨rep (x) [true, false] (cons true (L)), cons false (cons true (cons true (cons false (cons false (R))))), .D⟩ = some ⟨cons true (L), cons false (rep (x) [false, true] (cons true (cons true (cons false (cons false (R)))))), .D⟩ :=
    cross_l trans c1 (x) (cons true (L)) (cons true (cons true (cons false (cons false (R)))))
  have h2 : steps 1 ⟨cons true (L), cons false (rep (x) [false, true] (cons true (cons true (cons false (cons false (R)))))), .D⟩ = some ⟨L, cons true (cons true (rep (x) [false, true] (cons true (cons true (cons false (cons false (R))))))), .E⟩ := rfl
  exact steps_congr trans (a := 4 + ((x) * 2 + (1))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- drainSD, stretch 2. -/
theorem drainSD_s2 (m p : Nat) (L K1 : Tape) :
    steps (6 * p + 17) ⟨rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L))), cons true (K1), .E⟩ = some ⟨cons true (cons false (cons true (cons true (rep (p) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))))))), K1, .D⟩ := by
  have h0 : steps 4 ⟨rep (p + 2) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L))), cons true (K1), .E⟩ = some ⟨rep (p) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L))), cons false (cons true (cons true (cons false (cons false (K1))))), .D⟩ := rfl
