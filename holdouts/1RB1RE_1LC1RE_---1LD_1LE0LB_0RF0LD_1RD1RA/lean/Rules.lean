  have h1 : steps ((q) * 2) ⟨rep (q) [true, false] (rep (m + 1) [true, true, true, false] (cons true (L))), cons false (cons false (cons true (blank))), .D⟩ = some ⟨rep (m + 1) [true, true, true, false] (cons true (L)), cons false (rep (q) [false, true] (cons false (cons true (blank)))), .D⟩ :=
    cross_l trans c1 (q) (rep (m + 1) [true, true, true, false] (cons true (L))) (cons false (cons true (blank)))
  have h2 : steps 9 ⟨rep (m + 1) [true, true, true, false] (cons true (L)), cons false (rep (q) [false, true] (cons false (cons true (blank)))), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L))))))), rep (q) [false, true] (cons false (cons true (blank))), .F⟩ := rfl
