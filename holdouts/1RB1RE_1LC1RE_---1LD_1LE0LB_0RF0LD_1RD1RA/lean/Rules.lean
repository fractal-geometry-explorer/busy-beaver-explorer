  have h3 : steps ((q) * 4) ⟨cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L))))))), rep (q) [false, true] (cons false (cons true (blank))), .F⟩ = some ⟨rep (q) [false, true] (cons false (cons true (cons false (cons true (cons false (rep (m) [true, true, true, false] (cons true (L)))))))), cons false (cons true (blank)), .F⟩ :=
