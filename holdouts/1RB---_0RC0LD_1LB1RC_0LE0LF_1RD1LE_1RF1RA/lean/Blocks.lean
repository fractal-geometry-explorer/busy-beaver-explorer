import BPieces
import TM.ListFrame

/-!
# 1RB---_0RC0LD_1LB1RC_0LE0LF_1RD1LE_1RF1RA: the block map

The machine as a rewriting system on lists of blocks of 1s.  `blk [a, b, c, ...]` is the tape `1^a 0 1^b 0 1^c 0 ...`
(then blank), read away from the head; the empty list is blank tape, and a block may be empty.  A frame `Ph` is a
state and the block lists on both sides of the head:

* `E L R`: `blk L  E> 0  blk R`       * `C L R`: `blk L  C> 0  blk R`
* `B L R`: `blk L  B>  blk R`          * `F L R`: `blk L  F>  blk R`

`next` sends a frame to the next one the machine reaches (`next_sound`, every case one symbolic run of
`BPieces.lean`, for all block lists).  It is total except at three kinds of frames (`next_none_iff`, `Critical`):

* `C (2 :: L) (r + 1 :: R)`: `0 1 1 C> 0 1`,
* `B (1 :: L) (r + 3 :: R)`: `0 1 B> 1 1 1`,
* `F L (r + 2 :: R)`: `F> 1 1`,

and from each of those the machine halts (`none_halts`).  The run from blank tape reaches `B [1] []` after one step
(`init_start`).  So (`halts_iff`, `halts_iff_critical`) the machine halts from blank tape iff the orbit of `B [1] []`
under `next` reaches a critical frame; `frames_100000000` checks by `native_decide` that the first 100000000 frames are not
critical.  Generated by `py/blocks.py`; do not edit.
-/

namespace H15414

open TM

/-- Blocks of 1s, each followed by one 0, the first block next to the head; then blank tape. -/
def blk : List Nat → Tape
  | [] => blank
  | a :: R => rep a [true] (cons false (blk R))

/-- First block (an empty block if the list is empty: blank tape) and the rest. -/
def hd : List Nat → Nat
  | [] => 0
  | a :: _ => a

def tl : List Nat → List Nat
  | [] => []
  | _ :: R => R

theorem blk_ht : ∀ R : List Nat, blk R = rep (hd R) [true] (cons false (blk (tl R)))
  | [] => cons_false_blank.symm
  | _ :: _ => rfl

/-- A frame of the block map. -/
inductive Ph where
  | E (L R : List Nat)
  | C (L R : List Nat)
  | B (L R : List Nat)
  | F (L R : List Nat)
  deriving DecidableEq, Repr

def Ph.cfg : Ph → Config
  | .E L R => ⟨blk L, cons false (blk R), .E⟩
  | .C L R => ⟨blk L, cons false (blk R), .C⟩
  | .B L R => ⟨blk L, blk R, .B⟩
  | .F L R => ⟨blk L, blk R, .F⟩

/-- `1^i 0 L  E> 0  1^m 0 1^r 0 R`. -/
def nextE (i : Nat) (L : List Nat) : Nat → Nat → List Nat → Option Ph
  | 0, r, R => some (.E L ((i + 1) :: r :: R))
  | 1, r, R => some (.C (r :: (i + 2) :: L) R)
  | m + 2, r, R => some (.C (m :: (i + 2) :: L) (r :: R))

/-- `1^a 0 1^b 0 L  C> 0  1^r 0 R`. -/
def nextC (b : Nat) (L : List Nat) : Nat → Nat → List Nat → Option Ph
  | 0, r, R => some (.C ((r + 1) :: b :: L) R)
  | 1, r, R => some (.E L (b :: 0 :: (r + 1) :: R))
  | 2, 0, R => some (.B ((b + 5) :: L) R)
  | 2, _ + 1, _ => none
  | a + 3, r, R => some (.C ((r + 1) :: (a + 2) :: b :: L) R)

/-- `1^a 0 1^b 0 L  B>  1^r 0 1^s 0 R`. -/
def nextB (b : Nat) (L : List Nat) (s : Nat) (R : List Nat) : Nat → Nat → Option Ph
  | a, 0 => some (.C (s :: a :: b :: L) R)
  | 0, r + 1 => some (.E L (b :: 0 :: r :: s :: R))
  | 1, 1 => some (.F ((b + 4) :: L) (s :: R))
  | 1, 2 => some (.B ((b + 5) :: L) (s :: R))
  | 1, _ + 3 => none
  | a + 2, r + 1 => some (.C (r :: (a + 2) :: b :: L) (s :: R))

/-- `1^a 0 L  F>  1^r 0 R`. -/
def nextF (a : Nat) (L : List Nat) (R : List Nat) : Nat → Option Ph
  | 0 => some (.F ((a + 1) :: L) R)
  | 1 => some (.B ((a + 2) :: L) R)
  | _ + 2 => none

/-- The block map. -/
def next : Ph → Option Ph
  | .E L R => nextE (hd L) (tl L) (hd R) (hd (tl R)) (tl (tl R))
  | .C L R => nextC (hd (tl L)) (tl (tl L)) (hd L) (hd R) (tl R)
  | .B L R => nextB (hd (tl L)) (tl (tl L)) (hd (tl R)) (tl (tl R)) (hd L) (hd R)
  | .F L R => nextF (hd L) (tl L) (tl R) (hd R)

/-- The frames at which the machine is about to halt. -/
def Critical : Ph → Prop
  | .E _ _ => False
  | .C L R => hd L = 2 ∧ 1 ≤ hd R
  | .B L R => hd L = 1 ∧ 3 ≤ hd R
  | .F _ R => 2 ≤ hd R

def cE (i : Nat) (L : List Nat) (m r : Nat) (R : List Nat) : Config :=
  ⟨rep i [true] (cons false (blk L)), cons false (rep m [true] (cons false (rep r [true] (cons false (blk R))))), .E⟩

def cC (a b : Nat) (L : List Nat) (r : Nat) (R : List Nat) : Config :=
  ⟨rep a [true] (cons false (rep b [true] (cons false (blk L)))), cons false (rep r [true] (cons false (blk R))), .C⟩

def cB (a b : Nat) (L : List Nat) (r s : Nat) (R : List Nat) : Config :=
  ⟨rep a [true] (cons false (rep b [true] (cons false (blk L)))), rep r [true] (cons false (rep s [true] (cons false (blk R)))), .B⟩

def cF (a : Nat) (L : List Nat) (r : Nat) (R : List Nat) : Config :=
  ⟨rep a [true] (cons false (blk L)), rep r [true] (cons false (blk R)), .F⟩

theorem steps_eq_of {n : Nat} {c c' d d' : Config} (h : steps n c = some d) (hc : c = c') (hd : d = d') :
    steps n c' = some d' := by rw [← hc, ← hd]; exact h

theorem cfg_eq {l l' r r' : Tape} {q : St} (hl : l = l') (hr : r = r') :
    (⟨l, r, q⟩ : Config) = ⟨l', r', q⟩ := by rw [hl, hr]

/-- Two tapes made of cells, blocks and context tapes: write every cell as a run, merge runs of one symbol, then
match run by run, lengths by `omega`. -/
macro "blk_eq" : tactic =>
  `(tactic| focus
    try simp only [blk, rep_zero]
    try simp only [cons_rep1]
    try simp only [rep1_rep1]
    repeat' (first | rfl | apply rep_congr')
    all_goals omega)

macro "piece" t:term:max : tactic =>
  `(tactic| focus
    simp only [nextE, nextC, nextB, nextF, Option.some.injEq] at *
    subst_vars
    simp only [cE, cC, cB, cF, Ph.cfg]
    refine ⟨_, ?_, steps_eq_of ($t) (cfg_eq (by blk_eq) (by blk_eq)) (cfg_eq (by blk_eq) (by blk_eq))⟩
    omega)

macro "hpiece" t:term:max : tactic =>
  `(tactic| focus
    simp only [cE, cC, cB, cF]
    exact ⟨_, _, steps_eq_of ($t) (cfg_eq (by blk_eq) (by blk_eq)) rfl, rfl⟩)

theorem nextE_sound (i : Nat) (L : List Nat) : ∀ (m r : Nat) (R : List Nat) (p' : Ph), nextE i L m r R = some p' →
    ∃ n, 0 < n ∧ steps n (cE i L m r R) = some p'.cfg
  | 0, r, R, _, h => by piece (bp_E0 i (blk L) (rep r [true] (cons false (blk R))))
  | 1, r, R, _, h => by piece (bp_E1 i r (cons false (blk L)) (blk R))
  | m + 2, r, R, _, h => by piece (bp_E2 i m (cons false (blk L)) (rep r [true] (cons false (blk R))))

theorem nextC_sound (b : Nat) (L : List Nat) : ∀ (a r : Nat) (R : List Nat) (p' : Ph), nextC b L a r R = some p' →
    ∃ n, 0 < n ∧ steps n (cC a b L r R) = some p'.cfg
  | 0, r, R, _, h => by piece (bp_C0 r (rep b [true] (cons false (blk L))) (blk R))
  | 1, r, R, _, h => by
    cases b with
    | zero => piece (bp_C1a (blk L) (rep r [true] (cons false (blk R))))
    | succ b => piece (bp_C1b b (blk L) (rep r [true] (cons false (blk R))))
  | 2, 0, R, _, h => by piece (bp_C2 (rep b [true] (cons false (blk L))) (blk R))
  | 2, r + 1, R, _, h => by simp [nextC] at h
  | a + 3, r, R, _, h => by piece (bp_C3 a r (cons false (rep b [true] (cons false (blk L)))) (blk R))

theorem nextB_sound (b : Nat) (L : List Nat) (s : Nat) (R : List Nat) : ∀ (a r : Nat) (p' : Ph),
    nextB b L s R a r = some p' → ∃ n, 0 < n ∧ steps n (cB a b L r s R) = some p'.cfg
  | 0, 0, _, h => by piece (bp_B0 s (cons false (rep b [true] (cons false (blk L)))) (blk R))
  | 1, 0, _, h => by piece (bp_B0 s (cons true (cons false (rep b [true] (cons false (blk L))))) (blk R))
  | a + 2, 0, _, h => by piece (bp_B0 s (rep (a + 2) [true] (cons false (rep b [true] (cons false (blk L))))) (blk R))
  | 0, r + 1, _, h => by
    cases b with
    | zero => piece (bp_Ba0a (blk L) (rep r [true] (cons false (rep s [true] (cons false (blk R))))))
    | succ b => piece (bp_Ba0b b (blk L) (rep r [true] (cons false (rep s [true] (cons false (blk R))))))
  | 1, 1, _, h => by piece (bp_Ba1r1 (rep b [true] (cons false (blk L))) (rep s [true] (cons false (blk R))))
  | 1, 2, _, h => by piece (bp_Ba1r2 (rep b [true] (cons false (blk L))) (rep s [true] (cons false (blk R))))
  | 1, r + 3, _, h => by simp [nextB] at h
  | a + 2, r + 1, _, h => by
    piece (bp_Ba2 a r (cons false (rep b [true] (cons false (blk L)))) (rep s [true] (cons false (blk R))))

theorem nextF_sound (a : Nat) (L : List Nat) (R : List Nat) : ∀ (r : Nat) (p' : Ph), nextF a L R r = some p' →
    ∃ n, 0 < n ∧ steps n (cF a L r R) = some p'.cfg
  | 0, _, h => by piece (bp_F0 (rep a [true] (cons false (blk L))) (blk R))
  | 1, _, h => by piece (bp_F1 (rep a [true] (cons false (blk L))) (blk R))
  | r + 2, _, h => by simp [nextF] at h

theorem cfgE (L R : List Nat) : (Ph.E L R).cfg = cE (hd L) (tl L) (hd R) (hd (tl R)) (tl (tl R)) := by
  simp only [Ph.cfg, cE, ← blk_ht]

theorem cfgC (L R : List Nat) : (Ph.C L R).cfg = cC (hd L) (hd (tl L)) (tl (tl L)) (hd R) (tl R) := by
  simp only [Ph.cfg, cC, ← blk_ht]

theorem cfgB (L R : List Nat) :
    (Ph.B L R).cfg = cB (hd L) (hd (tl L)) (tl (tl L)) (hd R) (hd (tl R)) (tl (tl R)) := by
  simp only [Ph.cfg, cB, ← blk_ht]

theorem cfgF (L R : List Nat) : (Ph.F L R).cfg = cF (hd L) (tl L) (hd R) (tl R) := by
  simp only [Ph.cfg, cF, ← blk_ht]

/-- **Every value of the block map is a run of the machine**, for all block lists. -/
theorem next_sound : ∀ p p', next p = some p' → ∃ n, 0 < n ∧ steps n p.cfg = some p'.cfg
  | .E L R, p', h => by rw [cfgE]; exact nextE_sound _ _ _ _ _ p' h
  | .C L R, p', h => by rw [cfgC]; exact nextC_sound _ _ _ _ _ p' h
  | .B L R, p', h => by rw [cfgB]; exact nextB_sound _ _ _ _ _ _ p' h
  | .F L R, p', h => by rw [cfgF]; exact nextF_sound _ _ _ _ p' h

theorem nextC_halts (b : Nat) (L : List Nat) : ∀ (a r : Nat) (R : List Nat), nextC b L a r R = none →
    TM.Halts trans (cC a b L r R)
  | 0, r, R, h => by simp [nextC] at h
  | 1, r, R, h => by simp [nextC] at h
  | 2, 0, R, h => by simp [nextC] at h
  | 2, r + 1, R, _ => by hpiece (bp_Ch (rep b [true] (cons false (blk L))) (rep r [true] (cons false (blk R))))
  | a + 3, r, R, h => by simp [nextC] at h

theorem nextB_halts (b : Nat) (L : List Nat) (s : Nat) (R : List Nat) : ∀ (a r : Nat), nextB b L s R a r = none →
    TM.Halts trans (cB a b L r s R)
  | 0, 0, h => by simp [nextB] at h
  | 1, 0, h => by simp [nextB] at h
  | a + 2, 0, h => by simp [nextB] at h
  | 0, r + 1, h => by simp [nextB] at h
  | 1, 1, h => by simp [nextB] at h
  | 1, 2, h => by simp [nextB] at h
  | 1, r + 3, _ => by
    hpiece (bp_Bh (rep b [true] (cons false (blk L))) (rep r [true] (cons false (rep s [true] (cons false (blk R))))))
  | a + 2, r + 1, h => by simp [nextB] at h

theorem nextF_halts (a : Nat) (L : List Nat) (R : List Nat) : ∀ (r : Nat), nextF a L R r = none →
    TM.Halts trans (cF a L r R)
  | 0, h => by simp [nextF] at h
  | 1, h => by simp [nextF] at h
  | r + 2, _ => by hpiece (bp_Fh (rep a [true] (cons false (blk L))) (rep r [true] (cons false (blk R))))

/-- Where the block map is undefined, the machine halts. -/
theorem none_halts : ∀ p, next p = none → TM.Halts trans p.cfg
  | .E L R, h => by
    simp only [next] at h
    generalize hd R = m at h
    match m, h with
    | 0, h => simp [nextE] at h
    | 1, h => simp [nextE] at h
    | m + 2, h => simp [nextE] at h
  | .C L R, h => by rw [cfgC]; exact nextC_halts _ _ _ _ _ h
  | .B L R, h => by rw [cfgB]; exact nextB_halts _ _ _ _ _ _ h
  | .F L R, h => by rw [cfgF]; exact nextF_halts _ _ _ _ h

/-- The block map is undefined exactly at the critical frames. -/
theorem next_none_iff : ∀ p, next p = none ↔ Critical p
  | .E L R => by
    simp only [next, Critical]
    generalize hd R = m
    rcases m with _ | _ | m <;> simp [nextE]
  | .C L R => by
    simp only [next, Critical]
    generalize hd L = a; generalize hd R = r
    rcases a with _ | _ | _ | a <;> rcases r with _ | r <;> simp [nextC]
  | .B L R => by
    simp only [next, Critical]
    generalize hd L = a; generalize hd R = r
    rcases a with _ | _ | a <;> rcases r with _ | _ | _ | r <;> simp [nextB]
  | .F L R => by
    simp only [next, Critical]
    generalize hd R = r
    rcases r with _ | _ | r <;> simp [nextF]

/-- The first frame. -/
def start : Ph := .B [1] []

theorem init_start : steps 1 init = some start.cfg :=
  steps_eq_of bp_I rfl (cfg_eq (by simp only [blk, rep_succ, rep_zero, app_cons, app_nil, cons_false_blank]) rfl)

/-- **The machine halts from blank tape if and only if the block map, iterated from `B [1] []`, reaches a frame
where it is undefined.** -/
theorem halts_iff : HaltsFromBlank ↔ ∃ k p, iterF next k start = some p ∧ next p = none :=
  frames_halts_iff trans Ph.cfg next (fun _ => True) (fun p => next p = none)
    (fun p p' _ h => next_sound p p' h) (fun _ _ _ _ => trivial) (fun p _ h => none_halts p h) (fun _ _ h => h)
    init_start trivial

/-- **The machine halts from blank tape if and only if the block map reaches one of the three critical frames:**
C after a block of exactly two 1s with a 1 two cells ahead, B on a block of at least three 1s after a block of
exactly one, or F on a block of at least two 1s. -/
theorem halts_iff_critical : HaltsFromBlank ↔ ∃ k p, iterF next k start = some p ∧ Critical p := by
  rw [halts_iff]
  constructor
  · rintro ⟨k, p, h, hn⟩; exact ⟨k, p, h, (next_none_iff p).1 hn⟩
  · rintro ⟨k, p, h, hn⟩; exact ⟨k, p, h, (next_none_iff p).2 hn⟩

theorem frames_100000000 : ∀ j, j ≤ 100000000 → ∃ p, iterF next j start = some p :=
  checkF_sound next 100000000 start (by native_decide)

/-- No critical frame among the first 100000000 frames of the run from blank tape. -/
theorem no_halt_frames : ∀ j, j < 100000000 → ∀ p, iterF next j start = some p → ¬ Critical p := by
  intro j hj p hp hc
  obtain ⟨g, hg⟩ := frames_100000000 (j + 1) (by omega)
  rw [iterF_succ next j start p hp, (next_none_iff p).2 hc] at hg
  cases hg

end H15414
