  have h5 : steps ((k) * 3) ⟨cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (blank)))))))), rep (k) [false, true, true] (cons false (cons true (cons true (cons false (T))))), .A⟩ = some ⟨rep (k) [false, false, true] (cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (blank))))))))), cons false (cons true (cons true (cons false (T)))), .A⟩ :=
