/-! ## The layer law for each case of N (`layer_event` with the end of the event `ln_*`) -/

/-- The layer law when N's lowest digit 0 becomes 1. -/
theorem layer_event_n0t0 (L : Tape) {z : List Bool} {its : List Item} {l : Item} {r : List Bool × List Item × Item}
    (hz : z ≠ []) (h : evNext z its l = some r) :
    ∃ t, steps t ⟨cons false (cons false (cons true (L))), cons false (enc zd z (encT B its l)), .A⟩ =
      some ⟨cons false (cons true (cons true (L))), cons false (enc zd r.1 (encT B r.2.1 r.2.2)), .A⟩ :=
  layer_event hz h (fun T => ⟨_, ln_n0t0 L T⟩)

/-- The layer law when N ends in 02: becomes 10. -/
