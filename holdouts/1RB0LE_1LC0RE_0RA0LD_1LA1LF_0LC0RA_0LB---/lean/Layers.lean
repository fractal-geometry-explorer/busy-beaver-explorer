      some ⟨cons false (cons false (cons true (cons false (cons true (cons true (L)))))), cons false (enc zd r.1 (encT B r.2.1 r.2.2)), .A⟩ :=
  layer_event hz h (fun T => ⟨_, ln_n0t1 L T⟩)

