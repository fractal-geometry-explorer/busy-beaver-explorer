        exact ⟨_, _, _, zw_zr22 j e⟩
      · rcases (by omega : k = 2 * j + 3 ∨ k = 2 * j + 4) with h|h
        · subst h
          exact ⟨_, _, _, zw_zb22_3 j⟩
        · subst h
          exact ⟨_, _, _, zw_zb22_4 j⟩
    · obtain ⟨j, rfl⟩ : ∃ j, n = 24 * j + 47 := ⟨(n - 24) / 24, by omega⟩
      rcases (by omega : (k - 2 * j) % 8 = 0 ∨ (k - 2 * j) % 8 = 1 ∨ (k - 2 * j) % 8 = 2 ∨ (k - 2 * j) % 8 = 3 ∨ (k - 2 * j) % 8 = 4 ∨ (k - 2 * j) % 8 = 5 ∨ (k - 2 * j) % 8 = 6 ∨ (k - 2 * j) % 8 = 7) with h|h|h|h|h|h|h|h
      · by_cases hk : 2 * j + 8 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 8 := ⟨(k - 2 * j - 8) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_0 j e⟩
        · omega
      · by_cases hk : 2 * j + 9 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 9 := ⟨(k - 2 * j - 9) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_1 j e⟩
        · omega
      · by_cases hk : 2 * j + 10 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 10 := ⟨(k - 2 * j - 10) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_2 j e⟩
        · omega
      · by_cases hk : 2 * j + 11 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 11 := ⟨(k - 2 * j - 11) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_3 j e⟩
        · rcases (by omega : k = 2 * j + 3) with h
          · subst h
            exact ⟨_, _, _, zw_zb23_3 j⟩
      · by_cases hk : 2 * j + 4 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 4 := ⟨(k - 2 * j - 4) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_4 j e⟩
        · omega
      · by_cases hk : 2 * j + 5 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 5 := ⟨(k - 2 * j - 5) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_5 j e⟩
        · omega
      · by_cases hk : 2 * j + 6 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 6 := ⟨(k - 2 * j - 6) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_6 j e⟩
        · omega
      · by_cases hk : 2 * j + 7 ≤ k
        · obtain ⟨e, rfl⟩ : ∃ e, k = 8 * e + 2 * j + 7 := ⟨(k - 2 * j - 7) / 8, by omega⟩
          exact ⟨_, _, _, zw_zr23_7 j e⟩
        · omega

/-- The region in one statement: from `Ev n (.Z k)` with n < 12k + 12 (or k = 0) the machine either halts in this
pass, exactly when k is odd and n = 12k + 9, or reaches a next E-event. -/
theorem zregion (k n : Nat) (h : n < 12 * k + 12 ∨ k = 0) :
    (k % 2 = 1 ∧ n = 12 * k + 9 ∧ Halts trans (Ev n (.Z k))) ∨ ∃ n' T t, steps t (Ev n (.Z k)) = some (EvT n' T) := by
  by_cases hh : k % 2 = 1 ∧ n = 12 * k + 9
  · exact .inl ⟨hh.1, hh.2, zregion_halt k n hh.1 hh.2⟩
  · exact .inr (zregion_ev k n h hh)

/-- The start n = 2 of the region never halts: Z_k at n = 2 goes to Z_(k+1) at n = 2 in 102 steps (`zw_zs2`). -/
theorem zregion_two (k : Nat) : ¬ Halts trans (Ev 2 (.Z k)) := by
  have hs : ∀ k, steps 102 (Ev 2 (.Z k)) = some (Ev 2 (.Z (k + 1))) := fun k => zw_zs2 k
  have key : ∀ N k, ∀ M ≤ N, ∃ c, steps M (Ev 2 (.Z k)) = some c := by
    intro N
    induction N with
    | zero => intro k M hM; exact ⟨_, by rw [show M = 0 by omega]; rfl⟩
    | succ N ih =>
      intro k M hM
      by_cases h : M ≤ 102
      · have h2 := hs k
        rw [show 102 = M + (102 - M) by omega] at h2
        exact steps_le trans h2
      · obtain ⟨c, hc⟩ := ih (k + 1) (M - 102) (by omega)
        exact ⟨c, by rw [show M = 102 + (M - 102) by omega]; exact steps_seq trans (hs k) hc⟩
  exact not_halts_of_forall trans (fun M => key M k M (Nat.le_refl M))

