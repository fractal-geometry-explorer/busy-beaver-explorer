/-- The map for tail X: the next tail, n and the steps. -/
def nextX (t : Nat) : Nat → Tail × Nat × Nat
  | 0 => fsX0 t
  | 1 => fsX1 t
  | 2 => fsX2 t
  | 3 => fsX3 t
  | 4 => fsX4 t
  | 5 => fsX5 t
  | 6 => fsX6 t
  | 7 => fsX7 t
  | n + 8 =>
    match n % 8 with
    | 0 => fcX0 (n / 8) t
    | 1 => fcX1 (n / 8) t
    | 2 => fcX2 (n / 8) t
    | 3 => fcX3 (n / 8) t
    | 4 => fcX4 (n / 8) t
    | 5 => fcX5 (n / 8) t
    | 6 => fcX6 (n / 8) t
    | _ => fcX7 (n / 8) t

theorem nextX_sound (t n : Nat) :
    steps (nextX t n).2.2 (Ev n (.X t)) = some (Ev (nextX t n).2.1 (nextX t n).1) := by
  match n with
  | 0 => exact fsX0_sound t
  | 1 => exact fsX1_sound t
  | 2 => exact fsX2_sound t
  | 3 => exact fsX3_sound t
  | 4 => exact fsX4_sound t
  | 5 => exact fsX5_sound t
  | 6 => exact fsX6_sound t
  | 7 => exact fsX7_sound t
  | n + 8 =>
    obtain ⟨m, r, hr, rfl⟩ : ∃ m r, r < 8 ∧ n = 8 * m + r := ⟨n / 8, n % 8, Nat.mod_lt _ (by decide), by omega⟩
    rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · have e1 : (8 * m) / 8 = m := by omega
      have e2 : (8 * m) % 8 = 0 := by omega
      simp only [nextX, e1, e2]
      exact fcX0_sound m t
    · have e1 : (8 * m + 1) / 8 = m := by omega
      have e2 : (8 * m + 1) % 8 = 1 := by omega
      simp only [nextX, e1, e2]
      exact fcX1_sound m t
    · have e1 : (8 * m + 2) / 8 = m := by omega
      have e2 : (8 * m + 2) % 8 = 2 := by omega
