/-- The map for tail Y: the next tail, n and the steps. -/
def nextY (t : Nat) : Nat → Tail × Nat × Nat
  | 0 => fsY0 t
  | 1 => fsY1 t
  | 2 => fsY2 t
  | 3 => fsY3 t
  | 4 => fsY4 t
  | 5 => fsY5 t
  | 6 => fsY6 t
  | 7 => fsY7 t
  | n + 8 =>
    match n % 8 with
    | 0 => fcY0 (n / 8) t
    | 1 => fcY1 (n / 8) t
    | 2 => fcY2 (n / 8) t
    | 3 => fcY3 (n / 8) t
    | 4 => fcY4 (n / 8) t
    | 5 => fcY5 (n / 8) t
    | 6 => fcY6 (n / 8) t
    | _ => fcY7 (n / 8) t

theorem nextY_sound (t n : Nat) :
    steps (nextY t n).2.2 (Ev n (.Y t)) = some (Ev (nextY t n).2.1 (nextY t n).1) := by
  match n with
  | 0 => exact fsY0_sound t
  | 1 => exact fsY1_sound t
  | 2 => exact fsY2_sound t
  | 3 => exact fsY3_sound t
  | 4 => exact fsY4_sound t
  | 5 => exact fsY5_sound t
  | 6 => exact fsY6_sound t
  | 7 => exact fsY7_sound t
  | n + 8 =>
    obtain ⟨m, r, hr, rfl⟩ : ∃ m r, r < 8 ∧ n = 8 * m + r := ⟨n / 8, n % 8, Nat.mod_lt _ (by decide), by omega⟩
    rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · have e1 : (8 * m) / 8 = m := by omega
      have e2 : (8 * m) % 8 = 0 := by omega
      simp only [nextY, e1, e2]
      exact fcY0_sound m t
    · have e1 : (8 * m + 1) / 8 = m := by omega
      have e2 : (8 * m + 1) % 8 = 1 := by omega
      simp only [nextY, e1, e2]
      exact fcY1_sound m t
    · have e1 : (8 * m + 2) / 8 = m := by omega
      have e2 : (8 * m + 2) % 8 = 2 := by omega
      simp only [nextY, e1, e2]
      exact fcY2_sound m t
    · have e1 : (8 * m + 3) / 8 = m := by omega
      have e2 : (8 * m + 3) % 8 = 3 := by omega
      simp only [nextY, e1, e2]
      exact fcY3_sound m t
    · have e1 : (8 * m + 4) / 8 = m := by omega
      have e2 : (8 * m + 4) % 8 = 4 := by omega
      simp only [nextY, e1, e2]
      exact fcY4_sound m t
    · have e1 : (8 * m + 5) / 8 = m := by omega
      have e2 : (8 * m + 5) % 8 = 5 := by omega
      simp only [nextY, e1, e2]
      exact fcY5_sound m t
    · have e1 : (8 * m + 6) / 8 = m := by omega
      have e2 : (8 * m + 6) % 8 = 6 := by omega
      simp only [nextY, e1, e2]
      exact fcY6_sound m t
    · have e1 : (8 * m + 7) / 8 = m := by omega
      have e2 : (8 * m + 7) % 8 = 7 := by omega
      simp only [nextY, e1, e2]
      exact fcY7_sound m t

/-- The map for tail `1`. -/
def nextOne : Nat → Tail × Nat × Nat
  | 0 => (.one, 3, T_one_0 )
  | 1 => (.X (0), 2, T_one_1 )
  | n + 2 => if n % 2 = 0 then (.one, 3 * (n / 2) + 6, T_one_e (n / 2)) else (.X (0), 3 * (n / 2) + 5, T_one_o (n / 2))

theorem nextOne_sound (n : Nat) : steps (nextOne n).2.2 (Ev n .one) = some (Ev (nextOne n).2.1 (nextOne n).1) := by
  match n with
  | 0 => exact one_0
  | 1 => exact one_1
  | n + 2 =>
    obtain ⟨m, rfl | rfl⟩ : ∃ m, n = 2 * m ∨ n = 2 * m + 1 := ⟨n / 2, by omega⟩
    · have e : nextOne (2 * m + 2) = (.one, 3 * m + 6, T_one_e (m)) := by
        simp only [nextOne]
        rw [if_pos (by omega), show (2 * m) / 2 = m by omega]
      rw [e]
      exact one_e m
    · have e : nextOne (2 * m + 1 + 2) = (.X (0), 3 * m + 5, T_one_o (m)) := by
        simp only [nextOne]
        rw [if_neg (by omega), show (2 * m + 1) / 2 = m by omega]
      rw [e]
      exact one_o m

/-- The map for tail `Z t` (meant for `t ≥ 1` and `n ≥ 12 t + 12`, where `nextZ_sound` holds). -/
def nextZ (t n : Nat) : Tail × Nat × Nat :=
  if t % 2 = 1 then
    if n % 2 = 0 then (.one, 27 * (t / 2) + 3 * ((n - 24 * (t / 2) - 24) / 2) + 36, T_cZ10_24 (t / 2) ((n - 24 * (t / 2) - 24) / 2))
    else (.X (0), 27 * (t / 2) + 3 * ((n - 24 * (t / 2) - 25) / 2) + 35, T_cZ11_25 (t / 2) ((n - 24 * (t / 2) - 25) / 2))
  else
    if n % 2 = 0 then (.one, 27 * (t / 2 - 1) + 3 * ((n - 24 * (t / 2 - 1) - 36) / 2) + 48, T_cZ20_36 (t / 2 - 1) ((n - 24 * (t / 2 - 1) - 36) / 2))
    else (.X (0), 27 * (t / 2 - 1) + 3 * ((n - 24 * (t / 2 - 1) - 37) / 2) + 47, T_cZ21_37 (t / 2 - 1) ((n - 24 * (t / 2 - 1) - 37) / 2))

theorem nextZ_sound (t n : Nat) (h1 : 1 ≤ t) (h2 : 12 * t + 12 ≤ n) :
    steps (nextZ t n).2.2 (Ev n (.Z t)) = some (Ev (nextZ t n).2.1 (nextZ t n).1) := by
  obtain ⟨j, rfl | rfl⟩ : ∃ j, t = 2 * j + 1 ∨ t = 2 * j + 2 := ⟨(t - 1) / 2, by omega⟩
  · obtain ⟨z, rfl | rfl⟩ : ∃ z, n = 24 * j + 2 * z + 24 ∨ n = 24 * j + 2 * z + 25 :=
      ⟨(n - 24 * j - 24) / 2, by omega⟩
    · have e : nextZ (2 * j + 1) (24 * j + 2 * z + 24) = (.one, 27 * j + 3 * z + 36, T_cZ10_24 (j) (z)) := by
        simp only [nextZ]
        rw [if_pos (by omega), if_pos (by omega),
          show (2 * j + 1) / 2 = j by omega, show (24 * j + 2 * z + 24 - 24 * j - 24) / 2 = z by omega]
      rw [e]
      exact cZ10_24 j z
    · have e : nextZ (2 * j + 1) (24 * j + 2 * z + 25) = (.X (0), 27 * j + 3 * z + 35, T_cZ11_25 (j) (z)) := by
        simp only [nextZ]
        rw [if_pos (by omega), if_neg (by omega),
          show (2 * j + 1) / 2 = j by omega, show (24 * j + 2 * z + 25 - 24 * j - 25) / 2 = z by omega]
      rw [e]
      exact cZ11_25 j z
  · obtain ⟨z, rfl | rfl⟩ : ∃ z, n = 24 * j + 2 * z + 36 ∨ n = 24 * j + 2 * z + 37 :=
      ⟨(n - 24 * j - 36) / 2, by omega⟩
    · have e : nextZ (2 * j + 2) (24 * j + 2 * z + 36) = (.one, 27 * j + 3 * z + 48, T_cZ20_36 (j) (z)) := by
        simp only [nextZ]
        rw [if_neg (by omega), if_pos (by omega),
          show (2 * j + 2) / 2 - 1 = j by omega, show (24 * j + 2 * z + 36 - 24 * j - 36) / 2 = z by omega]
      rw [e]
      exact cZ20_36 j z
    · have e : nextZ (2 * j + 2) (24 * j + 2 * z + 37) = (.X (0), 27 * j + 3 * z + 47, T_cZ21_37 (j) (z)) := by
        simp only [nextZ]
        rw [if_neg (by omega), if_neg (by omega),
          show (2 * j + 2) / 2 - 1 = j by omega, show (24 * j + 2 * z + 37 - 24 * j - 37) / 2 = z by omega]
      rw [e]
      exact cZ21_37 j z

/-- The E-event map: the next tail, the next n and the number of steps; `none` for `Z k` with `k = 0` or
`n < 12k + 12`, the only E-events where the machine leaves the map (and where it can halt). -/
def next : Tail → Nat → Option (Tail × Nat × Nat)
  | .one, n => some (nextOne n)
  | .X t, n => some (nextX t n)
  | .Y t, n => some (nextY t n)
  | .Z t, n => if t = 0 ∨ n < 12 * t + 12 then none else some (nextZ t n)

/-- **The map is sound**: wherever `next` is defined, the machine goes from the E-event `Ev n T` to the one
`next` gives, in exactly the number of steps it gives. -/
theorem next_sound (T : Tail) (n : Nat) (T' : Tail) (n' s : Nat) (h : next T n = some (T', n', s)) :
    steps s (Ev n T) = some (Ev n' T') := by
  cases T with
  | one =>
    have hs := nextOne_sound n
    rw [show nextOne n = (T', n', s) from Option.some.inj h] at hs
    exact hs
  | X t =>
    have hs := nextX_sound t n
    rw [show nextX t n = (T', n', s) from Option.some.inj h] at hs
    exact hs
  | Y t =>
    have hs := nextY_sound t n
    rw [show nextY t n = (T', n', s) from Option.some.inj h] at hs
    exact hs
  | Z t =>
    simp only [next] at h
    by_cases hc : t = 0 ∨ n < 12 * t + 12
    · rw [if_pos hc] at h; cases h
    · rw [if_neg hc] at h
      have hs := nextZ_sound t n (by omega) (by omega)
      rw [show nextZ t n = (T', n', s) from Option.some.inj h] at hs
      exact hs

