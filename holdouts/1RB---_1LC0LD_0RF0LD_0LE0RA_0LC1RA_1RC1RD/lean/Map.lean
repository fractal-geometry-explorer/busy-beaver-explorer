theorem nextZ_pos (t n : Nat) (h1 : 1 ≤ t) (h2 : 12 * t + 12 ≤ n) :
    1 ≤ (nextZ t n).2.2 := by
  obtain ⟨j, rfl | rfl⟩ : ∃ j, t = 2 * j + 1 ∨ t = 2 * j + 2 := ⟨(t - 1) / 2, by omega⟩
  · obtain ⟨z, rfl | rfl⟩ : ∃ z, n = 24 * j + 2 * z + 24 ∨ n = 24 * j + 2 * z + 25 :=
      ⟨(n - 24 * j - 24) / 2, by omega⟩
    · have e : nextZ (2 * j + 1) (24 * j + 2 * z + 24) = (.one, 27 * j + 3 * z + 36, T_cZ10_24 (j) (z)) := by
        simp only [nextZ]
        rw [if_pos (by omega), if_pos (by omega),
          show (2 * j + 1) / 2 = j by omega, show (24 * j + 2 * z + 24 - 24 * j - 24) / 2 = z by omega]
      rw [e]
      exact T_cZ10_24_pos j z
    · have e : nextZ (2 * j + 1) (24 * j + 2 * z + 25) = (.X (0), 27 * j + 3 * z + 35, T_cZ11_25 (j) (z)) := by
        simp only [nextZ]
        rw [if_pos (by omega), if_neg (by omega),
          show (2 * j + 1) / 2 = j by omega, show (24 * j + 2 * z + 25 - 24 * j - 25) / 2 = z by omega]
      rw [e]
      exact T_cZ11_25_pos j z
  · obtain ⟨z, rfl | rfl⟩ : ∃ z, n = 24 * j + 2 * z + 36 ∨ n = 24 * j + 2 * z + 37 :=
      ⟨(n - 24 * j - 36) / 2, by omega⟩
    · have e : nextZ (2 * j + 2) (24 * j + 2 * z + 36) = (.one, 27 * j + 3 * z + 48, T_cZ20_36 (j) (z)) := by
        simp only [nextZ]
        rw [if_neg (by omega), if_pos (by omega),
          show (2 * j + 2) / 2 - 1 = j by omega, show (24 * j + 2 * z + 36 - 24 * j - 36) / 2 = z by omega]
      rw [e]
      exact T_cZ20_36_pos j z
    · have e : nextZ (2 * j + 2) (24 * j + 2 * z + 37) = (.X (0), 27 * j + 3 * z + 47, T_cZ21_37 (j) (z)) := by
        simp only [nextZ]
        rw [if_neg (by omega), if_neg (by omega),
          show (2 * j + 2) / 2 - 1 = j by omega, show (24 * j + 2 * z + 37 - 24 * j - 37) / 2 = z by omega]
      rw [e]
      exact T_cZ21_37_pos j z

/-- Every pass takes at least one step. -/
theorem next_pos (T : Tail) (n : Nat) (T' : Tail) (n' s : Nat) (h : next T n = some (T', n', s)) : 1 ≤ s := by
  cases T with
  | one =>
    have hs := nextOne_pos n
    rw [show nextOne n = (T', n', s) from Option.some.inj h] at hs
    exact hs
  | X t =>
    have hs := nextX_pos t n
    rw [show nextX t n = (T', n', s) from Option.some.inj h] at hs
    exact hs
  | Y t =>
    have hs := nextY_pos t n
    rw [show nextY t n = (T', n', s) from Option.some.inj h] at hs
    exact hs
  | Z t =>
    simp only [next] at h
    by_cases hc : t = 0 ∨ n < 12 * t + 12
    · rw [if_pos hc] at h; cases h
    · rw [if_neg hc] at h
      have hs := nextZ_pos t n (by omega) (by omega)
      rw [show nextZ t n = (T', n', s) from Option.some.inj h] at hs
      exact hs

