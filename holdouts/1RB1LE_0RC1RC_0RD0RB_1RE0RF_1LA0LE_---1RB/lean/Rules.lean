  have h4 : steps ((b + 1) * 2) ⟨cons false (cons true (cons false (cons false (cons true (cons true (rep (j + 1) [true, true] (cons false (L)))))))), rep (b + 1) [true, true] (cons true (cons true (blank))), .C⟩ = some ⟨rep (b + 1) [true, false] (cons false (cons true (cons false (cons false (cons true (cons true (rep (j + 1) [true, true] (cons false (L))))))))), cons true (cons true (blank)), .C⟩ :=
    cross_r trans c4 (b + 1) (cons false (cons true (cons false (cons false (cons true (cons true (rep (j + 1) [true, true] (cons false (L))))))))) (cons true (cons true (blank)))
  have h5 : steps 4 ⟨rep (b + 1) [true, false] (cons false (cons true (cons false (cons false (cons true (cons true (rep (j + 1) [true, true] (cons false (L))))))))), cons true (cons true (blank)), .C⟩ = some ⟨cons true (cons false (cons true (cons false (rep (b + 1) [true, false] (cons false (cons true (cons false (cons false (cons true (cons true (rep (j + 1) [true, true] (cons false (L))))))))))))), blank, .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The countdown at a = 0, third visit. -/
theorem exit3 (b j : Nat) (L : Tape) :
    steps (4 * b + 13) ⟨cons true (rep (b + 1) [false, true] (cons false (cons false (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))))), blank, .E⟩ = some ⟨cons true (cons false (cons true (cons false (rep (b + 1) [true, false] (cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))))))), blank, .E⟩ := by
  have hn : 1 + ((b + 1) * 2 + (4 + (0 + ((b + 1) * 2 + (4))))) = 4 * b + 13 := by omega
  have h0 : steps 1 ⟨cons true (rep (b + 1) [false, true] (cons false (cons false (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))))), blank, .E⟩ = some ⟨rep (b + 1) [false, true] (cons false (cons false (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))), cons true (cons true (blank)), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h1 : steps ((b + 1) * 2) ⟨rep (b + 1) [false, true] (cons false (cons false (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons false (cons false (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .A⟩ :=
    cross_l trans c1 (b + 1) (cons false (cons false (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))) (cons true (blank))
  have h2 : steps 4 ⟨cons false (cons false (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .A⟩ = some ⟨cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .C⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .C⟩ = some ⟨cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))), rep (b + 1) [true, true] (cons true (cons true (blank))), .C⟩ := by
    simp only [steps_zero, show cons true (rep (b + 1) [true, true] (cons true (blank))) = rep (b + 1) [true, true] (cons true (cons true (blank))) from
      rep_rotate (b + 1) [true] [true, true] [true, true] rfl (cons true (blank))]
  have c4 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .C⟩ = some ⟨app [] (app [true, false] L), R, .C⟩ := fun _ _ => rfl
  have h4 : steps ((b + 1) * 2) ⟨cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L))))))), rep (b + 1) [true, true] (cons true (cons true (blank))), .C⟩ = some ⟨rep (b + 1) [true, false] (cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))), cons true (cons true (blank)), .C⟩ :=
    cross_r trans c4 (b + 1) (cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))) (cons true (cons true (blank)))
  have h5 : steps 4 ⟨rep (b + 1) [true, false] (cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))), cons true (cons true (blank)), .C⟩ = some ⟨cons true (cons false (cons true (cons false (rep (b + 1) [true, false] (cons true (cons true (cons true (cons false (cons false (rep (j + 1) [true, true] (cons false (L)))))))))))), blank, .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The erase sweep: from the visit `0 0 1^(2j+4) 0 0 1 1 (10)^(b+1) 1 E>` the head goes left, turns the (10) run into 1s and the 1s into 0s, and stands in A left of the gap. -/
theorem erase (b j : Nat) (L : Tape) :
    steps (2 * b + 2 * j + 21) ⟨cons true (rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 2) [true, true] (cons false (cons false (L))))))))), blank, .E⟩ = some ⟨L, cons false (cons true (cons false (rep (j + 2) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))))), .A⟩ := by
  have hn : 1 + ((b + 1) * 2 + (12 + ((j + 2) * 2 + (2)))) = 2 * b + 2 * j + 21 := by omega
  have h0 : steps 1 ⟨cons true (rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 2) [true, true] (cons false (cons false (L))))))))), blank, .E⟩ = some ⟨rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 2) [true, true] (cons false (cons false (L)))))))), cons true (cons true (blank)), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h1 : steps ((b + 1) * 2) ⟨rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 2) [true, true] (cons false (cons false (L)))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons true (cons false (cons false (rep (j + 2) [true, true] (cons false (cons false (L))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .A⟩ :=
    cross_l trans c1 (b + 1) (cons true (cons true (cons false (cons false (rep (j + 2) [true, true] (cons false (cons false (L)))))))) (cons true (blank))
  have h2 : steps 12 ⟨cons true (cons true (cons false (cons false (rep (j + 2) [true, true] (cons false (cons false (L))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .A⟩ = some ⟨rep (j + 2) [true, true] (cons false (cons false (L))), cons true (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank))))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, false] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((j + 2) * 2) ⟨rep (j + 2) [true, true] (cons false (cons false (L))), cons true (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank))))))), .E⟩ = some ⟨cons false (cons false (L)), cons true (rep (j + 2) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))), .E⟩ :=
    cross_l trans c3 (j + 2) (cons false (cons false (L))) (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))
  have h4 : steps 2 ⟨cons false (cons false (L)), cons true (rep (j + 2) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))), .E⟩ = some ⟨L, cons false (cons true (cons false (rep (j + 2) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- The same with a countdown one level up to the left: its (10) run loses two copies, its run of 1s gains two 1s, and the head enters the gap of 0s in D. -/
theorem outer_step (b c j : Nat) (L : Tape) :
    steps (2 * b + 2 * j + 26) ⟨cons true (rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))))))))), blank, .E⟩ = some ⟨cons false (cons true (cons true (cons true (rep (c + 1) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))))), rep (j + 3) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank))))))), .D⟩ := by
  have hn : 1 + ((b + 1) * 2 + (12 + ((j + 3) * 2 + (5)))) = 2 * b + 2 * j + 26 := by omega
  have h0 : steps 1 ⟨cons true (rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))))))))), blank, .E⟩ = some ⟨rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L)))))))))))))), cons true (cons true (blank)), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h1 : steps ((b + 1) * 2) ⟨rep (b + 1) [false, true] (cons true (cons true (cons false (cons false (rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L)))))))))))))), cons true (cons true (blank)), .A⟩ = some ⟨cons true (cons true (cons false (cons false (rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .A⟩ :=
    cross_l trans c1 (b + 1) (cons true (cons true (cons false (cons false (rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L)))))))))))))) (cons true (blank))
  have h2 : steps 12 ⟨cons true (cons true (cons false (cons false (rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))))))), cons true (rep (b + 1) [true, true] (cons true (blank))), .A⟩ = some ⟨rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))), cons true (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank))))))), .E⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, false] R), .E⟩ := fun _ _ => rfl
  have h3 : steps ((j + 3) * 2) ⟨rep (j + 3) [true, true] (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))), cons true (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank))))))), .E⟩ = some ⟨cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L)))))))), cons true (rep (j + 3) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))), .E⟩ :=
    cross_l trans c3 (j + 3) (cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))) (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))
  have h4 : steps 5 ⟨cons false (rep (c + 2) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L)))))))), cons true (rep (j + 3) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank)))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons true (rep (c + 1) [false, true] (cons true (cons false (cons false (cons true (cons true (cons false (L))))))))))), rep (j + 3) [false, false] (cons true (cons true (cons false (cons false (rep (b + 1) [true, true] (cons true (blank))))))), .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

end H2090
