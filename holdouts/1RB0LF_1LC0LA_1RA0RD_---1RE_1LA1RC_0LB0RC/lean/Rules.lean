import Machine

/-! # Shift rules of 1RB0LF_1LC0LA_1RA0RD_---1RE_1LA1RC_0LB0RC

The two sweeps of the bouncer: going right, B (with a 1 behind it) turns each `010101` into `011001`
(`sweep_right`, 14 steps a copy); going left, C (with `110` ahead) turns each `011001` back into `010101`
(`sweep_left`, 22 steps a copy).  The halting situations: only D reading a 0 halts, and `C> 1 0`, `E> 1 1 0`,
`F> 1 1 0` and `D> 1 1 1 0` lead there.

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H36670

open TM

/-- The rightward sweep: B, with a 1 behind it, turns each `010101` into `011001`, 14 steps a copy. -/
theorem sweep_right (n : Nat) (L R : Tape) :
    steps (14 * n) ⟨cons true (L), rep (n) [false, true, false, true, false, true] (R), .B⟩ = some ⟨cons true (rep (n) [true, false, false, true, true, false] (L)), R, .B⟩ := by
  have hn : (n) * 14 = 14 * n := by omega
  have c0 : ∀ L R : Tape, steps 14 ⟨app [true] L, app [false, true, false, true, false, true] R, .B⟩ = some ⟨app [true] (app [true, false, false, true, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 14) ⟨cons true (L), rep (n) [false, true, false, true, false, true] (R), .B⟩ = some ⟨cons true (rep (n) [true, false, false, true, true, false] (L)), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- The leftward sweep: C, with `110` ahead of it, turns each `011001` back into `010101`, 22 steps a copy. -/
theorem sweep_left (n : Nat) (L R : Tape) :
    steps (22 * n) ⟨rep (n) [true, false, false, true, true, false] (L), cons true (cons true (cons false (R))), .C⟩ = some ⟨L, cons true (cons true (cons false (rep (n) [false, true, false, true, false, true] (R)))), .C⟩ := by
  have hn : (n) * 22 = 22 * n := by omega
  have c0 : ∀ L R : Tape, steps 22 ⟨app [true, false, false, true, true, false] L, app [true, true, false] R, .C⟩ = some ⟨L, app [true, true, false] (app [false, true, false, true, false, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 22) ⟨rep (n) [true, false, false, true, true, false] (L), cons true (cons true (cons false (R))), .C⟩ = some ⟨L, cons true (cons true (cons false (rep (n) [false, true, false, true, false, true] (R)))), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans hn (h0)

/-- `C> 1 0` halts: C erases the 1 and moves right onto the 0 in state D. -/
theorem halt_C (L R : Tape) : ∃ c, steps 1 ⟨L, cons true (cons false (R)), .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `E> 1 1 0` halts: E moves right in state C and the previous case applies. -/
theorem halt_E (L R : Tape) : ∃ c, steps 2 ⟨L, cons true (cons true (cons false (R))), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `F> 1 1 0` halts: F erases the 1, moves right in state C, and C> 1 0 follows. -/
theorem halt_F (L R : Tape) : ∃ c, steps 2 ⟨L, cons true (cons true (cons false (R))), .F⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

/-- `D> 1 1 1 0` halts after three steps. -/
theorem halt_D (L R : Tape) : ∃ c, steps 3 ⟨L, cons true (cons true (cons true (cons false (R)))), .D⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H36670
