import Seq

/-! Long sweeps over lists of blocks (generated by py/gen_sweep.py with bbtools.seqtm). -/

namespace H129771

open TM

/-- carry_even, stretch 0. -/
theorem carry_even_s0 (a : Nat) (K1 : Tape) :
    steps (8 * a + 39) ⟨blank, cons false (rep (a + 2) [true, false, true, false] (cons true (cons true (cons false (cons true (K1)))))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))))), K1, .A⟩ := by
  have h0 : steps 3 ⟨blank, cons false (rep (a + 2) [true, false, true, false] (cons true (cons true (cons false (cons true (K1)))))), .B⟩ = some ⟨cons true (cons false (blank)), rep (a + 2) [true, false, true, false] (cons true (cons true (cons false (cons true (K1))))), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 8 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((a + 2) * 8) ⟨cons true (cons false (blank)), rep (a + 2) [true, false, true, false] (cons true (cons true (cons false (cons true (K1))))), .B⟩ = some ⟨rep (a + 2) [true, false, false, true] (cons true (cons false (blank))), cons true (cons true (cons false (cons true (K1)))), .B⟩ :=
    cross_r trans c1 (a + 2) (cons true (cons false (blank))) (cons true (cons true (cons false (cons true (K1)))))
  have h2 : steps 20 ⟨rep (a + 2) [true, false, false, true] (cons true (cons false (blank))), cons true (cons true (cons false (cons true (K1)))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))))), K1, .A⟩ := rfl
  exact steps_congr trans (a := 3 + ((a + 2) * 8 + (20))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- One block of carry_even, move 1. -/
theorem carry_even_b1 (t : Nat) (L R : Tape) :
    steps (8 * t + 37) ⟨cons false (cons false (L)), rep (t + 4) [true, false, true, false] (cons true (R)), .A⟩ = some ⟨cons false (cons false (cons true (rep (t + 4) [true, false, false, true] (L)))), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 8 ⟨app [false, false] L, app [true, false, true, false] R, .A⟩ = some ⟨app [false, false] (app [true, false, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((t + 4) * 8) ⟨cons false (cons false (L)), rep (t + 4) [true, false, true, false] (cons true (R)), .A⟩ = some ⟨cons false (cons false (rep (t + 4) [true, false, false, true] (L))), cons true (R), .A⟩ :=
    cross_r trans c0 (t + 4) (L) (cons true (R))
  have h1 : steps 5 ⟨cons false (cons false (rep (t + 4) [true, false, false, true] (L))), cons true (R), .A⟩ = some ⟨cons false (cons false (cons true (rep (t + 4) [true, false, false, true] (L)))), R, .A⟩ := rfl
  exact steps_congr trans (a := (t + 4) * 8 + (5)) (by omega) (steps_seq trans h0 (h1))

/-- carry_even, stretch 2. -/
theorem carry_even_s2 (b : Nat) (K0 R : Tape) :
    steps (12 * b + 58) ⟨cons false (cons false (K0)), cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R)))), .A⟩ = some ⟨K0, cons true (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R)))))))))), .C⟩ := by
  have h0 : steps 6 ⟨cons false (cons false (K0)), cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R)))), .A⟩ = some ⟨cons true (cons false (cons false (cons true (K0)))), rep (b + 4) [true, false, true, false] (cons false (R)), .B⟩ := rfl
  have c1 : ∀ L R : Tape, steps 8 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((b + 4) * 8) ⟨cons true (cons false (cons false (cons true (K0)))), rep (b + 4) [true, false, true, false] (cons false (R)), .B⟩ = some ⟨rep (b + 4) [true, false, false, true] (cons true (cons false (cons false (cons true (K0))))), cons false (R), .B⟩ :=
    cross_r trans c1 (b + 4) (cons true (cons false (cons false (cons true (K0))))) (cons false (R))
  have h2 : steps 4 ⟨rep (b + 4) [true, false, false, true] (cons true (cons false (cons false (cons true (K0))))), cons false (R), .B⟩ = some ⟨rep (b + 3) [true, false, false, true] (cons true (cons false (cons false (cons true (K0))))), cons true (cons false (cons true (cons true (cons false (R))))), .C⟩ := rfl
  have c3 : ∀ L R : Tape, steps 4 ⟨app [true, false, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, false, true] R), .C⟩ := fun _ _ => rfl
  have h3 : steps ((b + 3) * 4) ⟨rep (b + 3) [true, false, false, true] (cons true (cons false (cons false (cons true (K0))))), cons true (cons false (cons true (cons true (cons false (R))))), .C⟩ = some ⟨cons true (cons false (cons false (cons true (K0)))), cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R)))))), .C⟩ :=
    cross_l trans c3 (b + 3) (cons true (cons false (cons false (cons true (K0))))) (cons false (cons true (cons true (cons false (R)))))
  have h4 : steps 4 ⟨cons true (cons false (cons false (cons true (K0)))), cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R)))))), .C⟩ = some ⟨K0, cons true (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R)))))))))), .C⟩ := rfl
  exact steps_congr trans (a := 6 + ((b + 4) * 8 + (4 + ((b + 3) * 4 + (4))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- One block of carry_even, move 3. -/
theorem carry_even_b3 (t : Nat) (L R : Tape) :
    steps (4 * t + 17) ⟨cons true (rep (t + 4) [true, false, false, true] (L)), cons true (R), .C⟩ = some ⟨L, cons true (rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (R))))))), .C⟩ := by
  have h0 : steps 5 ⟨cons true (rep (t + 4) [true, false, false, true] (L)), cons true (R), .C⟩ = some ⟨rep (t + 3) [true, false, false, true] (L), cons true (cons false (cons true (cons false (cons false (cons true (R)))))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true, false, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, false, true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((t + 3) * 4) ⟨rep (t + 3) [true, false, false, true] (L), cons true (cons false (cons true (cons false (cons false (cons true (R)))))), .C⟩ = some ⟨L, cons true (rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (R))))))), .C⟩ :=
    cross_l trans c1 (t + 3) (L) (cons false (cons true (cons false (cons false (cons true (R))))))
  exact steps_congr trans (a := 5 + ((t + 3) * 4)) (by omega) (steps_seq trans h0 (h1))

/-- carry_even, stretch 4. -/
theorem carry_even_s4 (a : Nat) (K1 : Tape) :
    steps (4 * a + 13) ⟨cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))), cons true (K1), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (K1))))))))))))))), .B⟩ := by
  have h0 : steps 10 ⟨cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))), cons true (K1), .C⟩ = some ⟨rep (a) [true, false, false, true] (cons true (cons false (blank))), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (K1))))))))))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true, false, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, false, true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((a) * 4) ⟨rep (a) [true, false, false, true] (cons true (cons false (blank))), cons true (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (K1))))))))))), .C⟩ = some ⟨cons true (cons false (blank)), cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (K1)))))))))))), .C⟩ :=
    cross_l trans c1 (a) (cons true (cons false (blank))) (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (K1)))))))))))
  have h2 : steps 3 ⟨cons true (cons false (blank)), cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (K1)))))))))))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (K1))))))))))))))), .B⟩ := rfl
  exact steps_congr trans (a := 10 + ((a) * 4 + (3))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- A long sweep: the counter carries through any list of even 1-digit blocks (10)^(2t+8) 1 and stops at an odd 0-digit block (10)^(2b+9) 0. -/
theorem carry_even (a b : Nat) (ts : List (Nat)) (R : Tape) :
    ∃ n, steps n ⟨blank, cons false (rep (a + 2) [true, false, true, false] (cons true (cons true (cons false (cons true (sq (fun (t : Nat) (X : Tape) => rep (t + 4) [true, false, true, false] (cons true (X))) ts (cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R))))))))))), .B⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (sq (fun (t : Nat) (X : Tape) => rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (X))))))) ts (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R))))))))))))))))))))))))), .B⟩ := by
  have h0 : ∃ n, steps n ⟨blank, cons false (rep (a + 2) [true, false, true, false] (cons true (cons true (cons false (cons true (sq (fun (t : Nat) (X : Tape) => rep (t + 4) [true, false, true, false] (cons true (X))) ts (cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R))))))))))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))))), sq (fun (t : Nat) (X : Tape) => rep (t + 4) [true, false, true, false] (cons true (X))) ts (cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R))))), .A⟩ :=
    ⟨_, carry_even_s0 a (sq (fun (t : Nat) (X : Tape) => rep (t + 4) [true, false, true, false] (cons true (X))) ts (cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R))))))⟩
  have h1 : ∃ n, steps n ⟨cons false (cons false (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))))), sq (fun (t : Nat) (X : Tape) => rep (t + 4) [true, false, true, false] (cons true (X))) ts (cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R))))), .A⟩ = some ⟨cons false (cons false (sqr (fun (t : Nat) (X : Tape) => cons true (rep (t + 4) [true, false, false, true] (X))) ts (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank)))))))))))), cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R)))), .A⟩ :=
    seqR (fun (t : Nat) (X : Tape) => rep (t + 4) [true, false, true, false] (cons true (X))) (fun (t : Nat) (X : Tape) => cons true (rep (t + 4) [true, false, false, true] (X))) (fun Y => cons false (cons false (Y))) .A (fun t L R => ⟨_, carry_even_b1 t L R⟩) ts (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank)))))))))) (cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R)))))
  have h2 : ∃ n, steps n ⟨cons false (cons false (sqr (fun (t : Nat) (X : Tape) => cons true (rep (t + 4) [true, false, false, true] (X))) ts (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank)))))))))))), cons true (cons false (rep (b + 4) [true, false, true, false] (cons false (R)))), .A⟩ = some ⟨sqr (fun (t : Nat) (X : Tape) => cons true (rep (t + 4) [true, false, false, true] (X))) ts (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank)))))))))), cons true (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R)))))))))), .C⟩ :=
    ⟨_, carry_even_s2 b (sqr (fun (t : Nat) (X : Tape) => cons true (rep (t + 4) [true, false, false, true] (X))) ts (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))))) R⟩
  have h3 : ∃ n, steps n ⟨sqr (fun (t : Nat) (X : Tape) => cons true (rep (t + 4) [true, false, false, true] (X))) ts (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank)))))))))), cons true (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R)))))))))), .C⟩ = some ⟨cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))), cons true (sq (fun (t : Nat) (X : Tape) => rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (X))))))) ts (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R))))))))))), .C⟩ :=
    seqL' (fun (t : Nat) (X : Tape) => cons true (rep (t + 4) [true, false, false, true] (X))) (fun (t : Nat) (X : Tape) => rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (X))))))) (fun Y => cons true (Y)) .C (fun t L R => ⟨_, carry_even_b3 t L R⟩) ts (cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank)))))))))) (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R))))))))))
  have h4 : ∃ n, steps n ⟨cons true (cons false (cons false (cons true (cons true (cons true (rep (a + 1) [true, false, false, true] (cons true (cons false (blank))))))))), cons true (sq (fun (t : Nat) (X : Tape) => rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (X))))))) ts (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R))))))))))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (sq (fun (t : Nat) (X : Tape) => rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (X))))))) ts (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R))))))))))))))))))))))))), .B⟩ :=
    ⟨_, carry_even_s4 a (sq (fun (t : Nat) (X : Tape) => rep (t + 3) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (X))))))) ts (cons false (cons true (cons false (cons true (rep (b + 3) [false, true, false, true] (cons false (cons true (cons true (cons false (R)))))))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

end H129771
