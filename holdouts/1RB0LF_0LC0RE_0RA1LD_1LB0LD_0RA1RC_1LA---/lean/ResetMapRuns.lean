open TM

/-- `cross_r` with nothing between the head and the crossed block.  Stating that case through `app [] L` makes
the kernel unfold the repeat count (x + 18 levels of `rep` and `steps`) when it compares with `L`; going through
this lemma, proved once for every count, avoids that. -/
theorem cross_r0 {s : Nat} {q : St} {w v : List Bool}
    (h : ∀ L R : Tape, steps s ⟨L, app w R, q⟩ = some ⟨app v L, R, q⟩) (k : Nat) :
    ∀ L R : Tape, steps (k * s) ⟨L, rep k w R, q⟩ = some ⟨rep k v L, R, q⟩ := by
  have := cross_r (u := []) (δ := trans) (fun L R => by simpa only [app_nil] using h L R) k
  intro L R; simpa only [app_nil] using this L R

theorem re_s0 (x : Nat) (T : Tape) :
    steps (8 * x + 146) ⟨cons true (blank), cons true (cons false (rep (x + 18) [true, false, true, false] (T))), .B⟩ = some ⟨cons false (cons false (rep (x + 18) [true, false, false, true] (cons true (blank)))), T, .A⟩ := by
  have hn : 0 + ((x + 18) * 8 + (2)) = 8 * x + 146 := by omega
  have h0 : steps 0 ⟨cons true (blank), cons true (cons false (rep (x + 18) [true, false, true, false] (T))), .B⟩ = some ⟨cons true (blank), rep (x + 18) [true, false, true, false] (cons true (cons false (T))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (x + 18) [true, false, true, false] (T))) = rep (x + 18) [true, false, true, false] (cons true (cons false (T))) from
      rep_rotate (x + 18) [true, false] [true, false, true, false] [true, false, true, false] rfl (T)]
  have c1 : ∀ L R : Tape, steps 8 ⟨L, app [true, false, true, false] R, .B⟩ = some ⟨app [true, false, false, true] L, R, .B⟩ := fun _ _ => rfl
  have h1 : steps ((x + 18) * 8) ⟨cons true (blank), rep (x + 18) [true, false, true, false] (cons true (cons false (T))), .B⟩ = some ⟨rep (x + 18) [true, false, false, true] (cons true (blank)), cons true (cons false (T)), .B⟩ :=
    cross_r0 c1 (x + 18) (cons true (blank)) (cons true (cons false (T)))
  have h2 : steps 2 ⟨rep (x + 18) [true, false, false, true] (cons true (blank)), cons true (cons false (T)), .B⟩ = some ⟨cons false (cons false (rep (x + 18) [true, false, false, true] (cons true (blank)))), T, .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))

