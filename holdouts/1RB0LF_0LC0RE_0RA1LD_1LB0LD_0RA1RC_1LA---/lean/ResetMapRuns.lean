      rep_rotate (x + 17) [true] [true, false, false, true] [true, true, false, false] rfl (cons true (blank))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true, true, false, false] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [true, false, true, false] R), .B⟩ := fun _ _ => rfl
  have h1 : steps ((x + 17) * 4) ⟨rep (x + 17) [true, true, false, false] (cons true (cons true (blank))), cons false (cons true (cons false (cons false (cons true (T1))))), .B⟩ = some ⟨cons true (cons true (blank)), cons false (rep (x + 17) [true, false, true, false] (cons true (cons false (cons false (cons true (T1)))))), .B⟩ :=
    cross_l trans c1 (x + 17) (cons true (cons true (blank))) (cons true (cons false (cons false (cons true (T1)))))
  have h2 : steps 8 ⟨cons true (cons true (blank)), cons false (rep (x + 17) [true, false, true, false] (cons true (cons false (cons false (cons true (T1)))))), .B⟩ = some ⟨cons false (cons true (cons false (blank))), cons false (cons true (cons false (rep (x + 17) [true, false, true, false] (cons true (cons false (cons false (cons true (T1)))))))), .E⟩ := rfl
