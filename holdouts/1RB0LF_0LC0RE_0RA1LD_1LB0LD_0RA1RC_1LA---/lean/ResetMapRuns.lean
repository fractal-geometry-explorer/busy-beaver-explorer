  have h0 : steps 0 ⟨cons true (rep (x + 17) [true, false, false, true] (cons true (blank))), cons false (cons true (cons false (cons false (cons true (T1))))), .B⟩ = some ⟨rep (x + 17) [true, true, false, false] (cons true (cons true (blank))), cons false (cons true (cons false (cons false (cons true (T1))))), .B⟩ := by
