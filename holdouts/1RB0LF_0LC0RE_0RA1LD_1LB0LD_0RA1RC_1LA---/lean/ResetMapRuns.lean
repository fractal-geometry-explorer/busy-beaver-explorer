    simp only [steps_zero, show cons false (cons true (cons false (rep (x + 17) [true, false, true, false] (cons true (cons false (cons false (cons true (T1)))))))) = rep (x + 17) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (T1)))))))) from
      rep_rotate (x + 17) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons false (cons false (cons true (T1)))))]
  have c4 : ∀ L R : Tape, steps 8 ⟨app [false] L, app [false, true, false, true] R, .E⟩ = some ⟨app [false] (app [true, false, false, true] L), R, .E⟩ := fun _ _ => rfl
  have h4 : steps ((x + 17) * 8) ⟨cons false (cons true (cons false (blank))), rep (x + 17) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (T1)))))))), .E⟩ = some ⟨cons false (rep (x + 17) [true, false, false, true] (cons true (cons false (blank)))), cons false (cons true (cons false (cons true (cons false (cons false (cons true (T1))))))), .E⟩ :=
    cross_r trans c4 (x + 17) (cons true (cons false (blank))) (cons false (cons true (cons false (cons true (cons false (cons false (cons true (T1))))))))
  have h5 : steps 11 ⟨cons false (rep (x + 17) [true, false, false, true] (cons true (cons false (blank)))), cons false (cons true (cons false (cons true (cons false (cons false (cons true (T1))))))), .E⟩ = some ⟨cons false (cons true (cons false (cons false (cons true (cons false (cons false (cons true (rep (x + 17) [true, false, false, true] (cons true (cons false (blank))))))))))), T1, .E⟩ := rfl
