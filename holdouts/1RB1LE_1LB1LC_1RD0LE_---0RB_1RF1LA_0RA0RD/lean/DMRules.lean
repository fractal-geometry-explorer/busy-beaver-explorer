/-- F(d, 4, b, c) to F(d + 1, 0, b + 3, c). -/
theorem f_k2z (b c d : Nat) :
    steps (13) ⟨cons true (rep (d) [true] (blank)), cons true (cons true (cons true (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .F⟩ = some ⟨cons true (cons true (rep (d) [true] (blank))), cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank))))))), .F⟩ := by
  have hn : 13 = 13 := by omega
  have h0 : steps 13 ⟨cons true (rep (d) [true] (blank)), cons true (cons true (cons true (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .F⟩ = some ⟨cons true (cons true (rep (d) [true] (blank))), cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank))))))), .F⟩ := rfl
  exact steps_congr trans hn (h0)

/-- F(d, 2k + 6, b, c) to F(d + 1, 2k + 2, b + 3, c). -/
theorem f_k2 (b c d k : Nat) :
    steps (8 * k + 21) ⟨cons true (rep (d) [true] (blank)), cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [true, true] (cons false (rep (b) [true] (cons false (rep (c) [true] (blank))))))))))), .F⟩ = some ⟨cons true (cons true (rep (d) [true] (blank))), cons true (cons true (rep (k) [true, true] (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))))), .F⟩ := by
  have hn : 11 + (0 + ((k) * 6 + (1 + (0 + (6 + (0 + (0 + ((k) * 2 + (3))))))))) = 8 * k + 21 := by omega
  have h0 : steps 11 ⟨cons true (rep (d) [true] (blank)), cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [true, true] (cons false (rep (b) [true] (cons false (rep (c) [true] (blank))))))))))), .F⟩ = some ⟨cons false (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))), cons true (rep (k) [true, true] (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))), cons true (rep (k) [true, true] (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .B⟩ = some ⟨cons false (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))), rep (k) [true, true] (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (k) [true, true] (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))) = rep (k) [true, true] (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))) from
      rep_rotate (k) [true] [true, true] [true, true] rfl (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))]
  have c2 : ∀ L R : Tape, steps 6 ⟨app [false] L, app [true, true] R, .B⟩ = some ⟨app [false] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 6) ⟨cons false (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))), rep (k) [true, true] (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .B⟩ = some ⟨cons false (rep (k) [true, true] (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank)))))))), cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank))))), .B⟩ :=
    cross_r trans c2 (k) (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))) (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank))))))
  have h3 : steps 1 ⟨cons false (rep (k) [true, true] (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank)))))))), cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank))))), .B⟩ = some ⟨rep (k) [true, true] (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))), cons false (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .C⟩ := rfl
  have h4 : steps 0 ⟨rep (k) [true, true] (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))), cons false (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .C⟩ = some ⟨cons true (cons true (rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))))), cons false (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .C⟩ := by
    simp only [steps_zero, show rep (k) [true, true] (cons true (cons true (cons true (cons false (cons true (rep (d) [true] (blank))))))) = cons true (cons true (rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))))) from
      (rep_rotate (k) [true, true] [true, true] [true, true] rfl (cons true (cons false (cons true (rep (d) [true] (blank)))))).symm]
  have h5 : steps 6 ⟨cons true (cons true (rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))))), cons false (cons true (cons false (rep (b) [true] (cons false (rep (c) [true] (blank)))))), .C⟩ = some ⟨rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))), cons true (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .E⟩ := rfl
  have h6 : steps 0 ⟨rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))), cons true (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .E⟩ = some ⟨cons true (rep (k) [true, true] (cons false (cons true (rep (d) [true] (blank))))), cons true (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .E⟩ := by
    simp only [steps_zero, show rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))) = cons true (rep (k) [true, true] (cons false (cons true (rep (d) [true] (blank))))) from
      (rep_rotate (k) [true] [true, true] [true, true] rfl (cons false (cons true (rep (d) [true] (blank))))).symm]
  have h7 : steps 0 ⟨cons true (rep (k) [true, true] (cons false (cons true (rep (d) [true] (blank))))), cons true (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .E⟩ = some ⟨rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))), cons true (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (k) [true, true] (cons false (cons true (rep (d) [true] (blank))))) = rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))) from
      rep_rotate (k) [true] [true, true] [true, true] rfl (cons false (cons true (rep (d) [true] (blank))))]
  have c8 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [true, true] R), .E⟩ := fun _ _ => rfl
  have h8 : steps ((k) * 2) ⟨rep (k) [true, true] (cons true (cons false (cons true (rep (d) [true] (blank))))), cons true (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))), .E⟩ = some ⟨cons true (cons false (cons true (rep (d) [true] (blank)))), cons true (rep (k) [true, true] (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank))))))))), .E⟩ :=
    cross_l trans c8 (k) (cons true (cons false (cons true (rep (d) [true] (blank))))) (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank))))))))
  have h9 : steps 3 ⟨cons true (cons false (cons true (rep (d) [true] (blank)))), cons true (rep (k) [true, true] (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank))))))))), .E⟩ = some ⟨cons true (cons true (rep (d) [true] (blank))), cons true (cons true (rep (k) [true, true] (cons false (cons true (cons true (cons true (rep (b) [true] (cons false (rep (c) [true] (blank)))))))))), .F⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (h9))))))))))

end H25239
