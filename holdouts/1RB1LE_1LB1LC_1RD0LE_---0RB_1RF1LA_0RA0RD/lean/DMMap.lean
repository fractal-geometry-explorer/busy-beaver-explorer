import Blank
import DMRules
import TM.MapOrbit

/-!
# DeepMind's halts-iff map, proved here

`DM.State`, `DM.start`, `DM.next` and the dispatch functions `enterF_*` are DeepMind's (google-deepmind/cryptids,
`BusyBeaver/BB6/M_1RB1LE_1LB1LC_1RD0LE_HHH0RB_1RF1LA_0RA0RD.lean`, commit 3647718), copied unchanged but for `ℕ`
written `Nat`.  Their file proves with Mathlib that the machine halts iff the orbit of `next` from `start` stops; here
the same statement is proved on this repository's machine semantics with core Lean only (`deepmind_halts_iff`), so
it no longer needs to be cited.

`E q a b c` is `0^∞ E> 0 0^q 1^a 0 1^b 0 1^c 0^∞` and `F_even d k b c` is `0^∞ 1^(d+1) F> 1^(2k) 0 1^b 0 1^c 0^∞`.
Every case of `next` (and of the dispatch functions), split by the parities that decide the next state, is one rule
of `DMRules.lean`, generated by `py/dmrules.py`.
-/

set_option autoImplicit false

namespace H25239

namespace DM

inductive State where
  /-- Canonical hub configuration
  $E(q, a, b, c) := 0^\infty\,\mathrm{E}{>}\,0\,0^q\,1^a\,0\,1^b\,0\,1^c\,0^\infty$
  with $q \in \{0, 1\}$. -/
  | E (q : Bool) (a b c : Nat)
  /-- Even-block right-sweep configuration
  $F(d, 2k, b, c) := 0^\infty\,1^{d+1}\,\mathrm{F}{>}\,1^{2k}\,0\,1^b\,0\,1^c\,0^\infty$. -/
  | F_even (d k b c : Nat)

def start : State := .E true 3 0 0

def mkE (m b c : Nat) : State :=
  .E (decide (m % 2 = 1)) m b c

def enterF_d0 (a b c : Nat) : Option State :=
  if a % 2 = 0 then
    some (.F_even 0 (a / 2) b c)
  else if a = 1 then
    none
  else if a = 3 then
    some (mkE (b + 2) (c + 3) 0)
  else
    none

def enterF_d1 (a b c : Nat) : Option State :=
  if a % 2 = 0 then
    some (.F_even 1 (a / 2) b c)
  else if a = 1 then
    none
  else if a = 3 then
    some (mkE (b + 3) (c + 3) 0)
  else
    some (.E true (a - 2) (b + 6) c)

def enterF_c0 (d a b : Nat) : Option State :=
  if a % 2 = 0 then
    some (.F_even d (a / 2) b 0)
  else if a = 1 then
    none
  else if a = 3 then
    some (mkE (d + b + 2) 3 0)
  else
    some (mkE (d + 1) (a - 4) (b + 3))

def next : State → Option State
  | .E false a b c => enterF_d0 a b c
  | .E true 0 0 0 => none
  | .E true 0 0 (c + 1) => some (mkE (c + 2) 3 0)
  | .E true 0 (b + 1) c => enterF_c0 2 (b + 1) c
  | .E true (a + 1) b c => enterF_d1 (a + 1) b c
  | .F_even d 0 0 0 => some (mkE (d + 1) 3 0)
  | .F_even d 0 0 (c + 1) => some (.F_even (d + 1) 0 (c + 1) 0)
  | .F_even d 0 (b + 1) c => enterF_c0 (d + 1) (b + 1) c
  | .F_even 0 1 b c => some (mkE (b + 2) (c + 3) 0)
  | .F_even 1 1 b c => some (.E true (b + 4) c 0)
  | .F_even (d + 2) 1 b c => some (mkE (d + 1) (b + 4) c)
  | .F_even d (k + 2) b c => some (.F_even (d + 1) k (b + 3) c)

/-- `n` steps of `next` from `start`: DeepMind's `(Option.bind · next)^[n] (some start)` in `CollatzHalts`. -/
def orbit : Nat → Option State
  | 0 => some start
  | n + 1 => Option.bind (orbit n) next

end DM

open TM DM

/-- The configuration of a state. -/
def enc : State → Config
  | .E false a b c => ⟨blank, cons false (rep a [true] (cons false (rep b [true] (cons false (rep c [true] blank))))), .E⟩
  | .E true a b c =>
      ⟨blank, cons false (cons false (rep a [true] (cons false (rep b [true] (cons false (rep c [true] blank)))))), .E⟩
  | .F_even d k b c =>
      ⟨rep (d + 1) [true] blank, rep (2 * k) [true] (cons false (rep b [true] (cons false (rep c [true] blank)))), .F⟩

def Rel (s : State) (c : Config) : Prop := c = enc s

theorem mkE_even (j b c : Nat) : mkE (2 * j) b c = .E false (2 * j) b c := by
  simp only [mkE]; congr; simp only [decide_eq_false_iff_not]; omega

theorem mkE_odd (j b c : Nat) : mkE (2 * j + 1) b c = .E true (2 * j + 1) b c := by
  simp only [mkE]; congr; simp only [decide_eq_true_eq]; omega

/-- Both sides with every count split into its variable part and literal cells. -/
macro "enc_norm" : tactic =>
  `(tactic| ((simp only [enc, Nat.mul_add, Nat.mul_one, Nat.mul_zero, rep_add, rep_succ, rep_zero, app_cons, app_nil]) <;> cfg_rfl))

/-- Lands in `s'` through one rule. -/
macro "land" r:term : tactic => `(tactic| exact ⟨_, plus_of $r (by enc_norm) (by enc_norm), rfl⟩)
/-- Halts through one rule. -/
macro "halt" r:term : tactic => `(tactic| exact halts_at $r (by enc_norm) rfl)

theorem parity (n : Nat) : ∃ j, n = 2 * j ∨ n = 2 * j + 1 := ⟨n / 2, by omega⟩

set_option maxHeartbeats 4000000 in
/-- Every state lands where `next` says. -/
theorem step_enc : ∀ s, TM.Lands trans Rel (enc s) (next s)
  | .E false a b c => by
    simp only [next, enterF_d0]
    obtain ⟨k, rfl | rfl⟩ := parity a
    · rw [if_pos (by omega), show 2 * k / 2 = k by omega]; land (e0_even b c k)
    · rw [if_neg (by omega)]
      rcases k with _ | _ | k
      · rw [if_pos rfl]; halt (e0_1 b c)
      · rw [if_neg (by omega), if_pos rfl]
        obtain ⟨j, rfl | rfl⟩ := parity b
        · rw [show 2 * j + 2 = 2 * (j + 1) by omega, mkE_even]; land (e0_3e c j)
        · rw [show 2 * j + 1 + 2 = 2 * (j + 1) + 1 by omega, mkE_odd]; land (e0_3o c j)
      · rw [if_neg (by omega), if_neg (by omega)]
        halt (e0_5 b c k)
  | .E true 0 0 0 => by simp only [next]; halt e1_000
  | .E true 0 0 (c + 1) => by
    simp only [next]
    obtain ⟨j, rfl | rfl⟩ := parity c
    · rw [show 2 * j + 1 + 1 = 2 * (j + 1) by omega, mkE_even]; land (e1_00ce j)
    · rw [show 2 * j + 1 + 1 + 1 = 2 * (j + 1) + 1 by omega, mkE_odd]; land (e1_00co j)
  | .E true 0 (b + 1) c => by
    simp only [next, enterF_c0]
    obtain ⟨k, rfl | rfl⟩ := parity b
    · rcases k with _ | k
      · rw [if_neg (by omega), if_pos rfl]; halt (e1_0b_1 c)
      · rcases k with _ | k
        · rw [if_neg (by omega), if_neg (by omega), if_pos rfl]
          obtain ⟨j, rfl | rfl⟩ := parity c
          · rw [show 2 + 2 * j + 2 = 2 * (j + 2) by omega, mkE_even]; land (e1_0b_3e j)
          · rw [show 2 + (2 * j + 1) + 2 = 2 * (j + 2) + 1 by omega, mkE_odd]; land (e1_0b_3o j)
        · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), show 2 + 1 = 2 * 1 + 1 from rfl, mkE_odd,
            show 2 * (k + 1 + 1) + 1 - 4 = 2 * k + 1 by omega]
          land (e1_0b_5 c k)
    · rw [if_pos (by omega), show (2 * k + 1 + 1) / 2 = k + 1 by omega]; land (e1_0b_even c k)
  | .E true (a + 1) b c => by
    simp only [next, enterF_d1]
    obtain ⟨k, rfl | rfl⟩ := parity a
    · rcases k with _ | k
      · rw [if_neg (by omega), if_pos rfl]; halt (e1_a_1 b c)
      · rcases k with _ | k
        · rw [if_neg (by omega), if_neg (by omega), if_pos rfl]
          obtain ⟨j, rfl | rfl⟩ := parity b
          · rw [show 2 * j + 3 = 2 * (j + 1) + 1 by omega, mkE_odd]; land (e1_a_3e c j)
          · rw [show 2 * j + 1 + 3 = 2 * (j + 2) by omega, mkE_even]; land (e1_a_3o c j)
        · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), show 2 * (k + 1 + 1) + 1 - 2 = 2 * k + 3 by omega]
          land (e1_a_5 b c k)
    · rw [if_pos (by omega), show (2 * k + 1 + 1) / 2 = k + 1 by omega]; land (e1_a_even b c k)
  | .F_even d 0 0 0 => by
    simp only [next]
    obtain ⟨j, rfl | rfl⟩ := parity d
    · rw [mkE_odd]; land (f_000e j)
    · rw [show 2 * j + 1 + 1 = 2 * (j + 1) by omega, mkE_even]; land (f_000o j)
  | .F_even d 0 0 (c + 1) => by simp only [next]; land (f_00c c d)
  | .F_even d 0 (b + 1) c => by
    simp only [next, enterF_c0]
    obtain ⟨k, rfl | rfl⟩ := parity b
    · rcases k with _ | k
      · rw [if_neg (by omega), if_pos rfl]; halt (f_0b_1 c d)
      · rcases k with _ | k
        · rw [if_neg (by omega), if_neg (by omega), if_pos rfl]
          obtain ⟨i, rfl | rfl⟩ := parity d <;> obtain ⟨j, rfl | rfl⟩ := parity c
          · rw [show 2 * i + 1 + 2 * j + 2 = 2 * (i + j + 1) + 1 by omega, mkE_odd]; land (f_0b_3_00 i j)
          · rw [show 2 * i + 1 + (2 * j + 1) + 2 = 2 * (i + j + 2) by omega, mkE_even]; land (f_0b_3_01 i j)
          · rw [show 2 * i + 1 + 1 + 2 * j + 2 = 2 * (i + j + 2) by omega, mkE_even]; land (f_0b_3_10 i j)
          · rw [show 2 * i + 1 + 1 + (2 * j + 1) + 2 = 2 * (i + j + 2) + 1 by omega, mkE_odd]; land (f_0b_3_11 i j)
        · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), show 2 * (k + 1 + 1) + 1 - 4 = 2 * k + 1 by omega]
          obtain ⟨i, rfl | rfl⟩ := parity d
          · rw [show 2 * i + 1 + 1 = 2 * (i + 1) by omega, mkE_even]; land (f_0b_5e c i k)
          · rw [show 2 * i + 1 + 1 + 1 = 2 * (i + 1) + 1 by omega, mkE_odd]; land (f_0b_5o c i k)
    · rw [if_pos (by omega), show (2 * k + 1 + 1) / 2 = k + 1 by omega]; land (f_0b_even c d k)
  | .F_even 0 1 b c => by
    simp only [next]
    obtain ⟨j, rfl | rfl⟩ := parity b
    · rw [show 2 * j + 2 = 2 * (j + 1) by omega, mkE_even]; land (f0_2e c j)
    · rw [show 2 * j + 1 + 2 = 2 * (j + 1) + 1 by omega, mkE_odd]; land (f0_2o c j)
  | .F_even 1 1 b c => by simp only [next]; land (f1_2 b c)
  | .F_even (d + 2) 1 b c => by
    simp only [next]
    obtain ⟨i, rfl | rfl⟩ := parity d
    · rw [mkE_odd]; land (fd_2e b c i)
    · rw [show 2 * i + 1 + 1 = 2 * (i + 1) by omega, mkE_even]; land (fd_2o b c i)
  | .F_even d (k + 2) b c => by
    simp only [next]
    rcases k with _ | k
    · land (f_k2z b c d)
    · land (f_k2 b c d k)

/-- **DeepMind's halts-iff map, proved here.**  The machine halts from blank tape if and only if the orbit of
DeepMind's `next` from `start` stops. -/
theorem deepmind_halts_iff : HaltsFromBlank ↔ ∃ n, (DM.orbit n).isNone = true := by
  have h : HaltsFromBlank ↔ ∃ n, TM.orbit next start n = none :=
    halts_iff_orbit ⟨12, _, blank_E, by simp only [start]; enc_norm⟩ (fun s c (h : c = enc s) => by subst h; exact step_enc s)
  have e : ∀ n, DM.orbit n = TM.orbit next start n := by
    intro n; induction n with
    | zero => rfl
    | succ n ih => simp only [DM.orbit, TM.orbit, ih]
  rw [h]
  constructor
  · rintro ⟨n, hn⟩; exact ⟨n, by rw [e, hn]; rfl⟩
  · rintro ⟨n, hn⟩; refine ⟨n, ?_⟩; rw [← e]; cases h' : DM.orbit n <;> simp_all

end H25239
