import Machine

/-! Counter rules of 1RB0RD_1LC1RE_1LD0LC_0LE0LC_0RA0RF_1RA---: one hub event with the left counter borrowing through `k` digits, and with the right
counter carrying through `j` digits, for every `k`, `j` and every tape beyond the cells shown (`L`, `R`).
Found from 4000 sampled events by `py/rules.py` of this folder (`tools/py/bbtools/hubrules.py`) and proved by
`tools/py/bbtools/symtm.py` (single steps by `rfl`, the `k` or `j` copies by `TM.cross_l` / `TM.cross_r`). -/

namespace H124880

open TM

/-- The left counter borrows through `k` digits (its lowest digit was 0); the right counter changes only next to the hub. -/
theorem borrow (k : Nat) (L R : Tape) :
    steps (10 * k + 20) ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons false (R))), .E⟩ = some ⟨cons false (cons true (rep (k) [true, false, false, true] (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (cons true (R))), .E⟩ := by
  have hn : 4 + (0 + ((k) * 4 + (12 + (0 + ((k) * 6 + (4)))))) = 10 * k + 20 := by omega
  have h0 : steps 4 ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons false (R))), .E⟩ = some ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons true (R))), .C⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons true (R))), .C⟩ = some ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons true (R))), .C⟩ := by
    simp only [steps_zero, show cons true (cons false (rep (k) [true, false, true, false] (cons true (cons false (cons false (cons true (L))))))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons true (L))))))) from
      rep_rotate (k) [true, false] [true, false, true, false] [true, false, true, false] rfl (cons true (cons false (cons false (cons true (L)))))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 4) ⟨rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons false (cons true (L))))))), cons false (cons false (cons true (R))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (L)))))), cons false (rep (k) [false, true, false, true] (cons false (cons true (R)))), .C⟩ :=
    cross_l trans c2 (k) (cons true (cons false (cons true (cons false (cons false (cons true (L))))))) (cons false (cons true (R)))
  have h3 : steps 12 ⟨cons true (cons false (cons true (cons false (cons false (cons true (L)))))), cons false (rep (k) [false, true, false, true] (cons false (cons true (R)))), .C⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (R)))))), .B⟩ := rfl
  have h4 : steps 0 ⟨cons true (cons false (cons true (cons false (L)))), cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (R)))))), .B⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (R)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (k) [false, true, false, true] (cons false (cons true (R)))))) = rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (R)))))) from
      rep_rotate (k) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (cons true (R)))]
  have c5 : ∀ L R : Tape, steps 6 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h5 : steps ((k) * 6) ⟨cons true (cons false (cons true (cons false (L)))), rep (k) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (R)))))), .B⟩ = some ⟨rep (k) [true, false, false, true] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (cons true (cons false (cons true (R))))), .B⟩ :=
    cross_r trans c5 (k) (cons true (cons false (cons true (cons false (L))))) (cons true (cons false (cons true (cons false (cons true (R))))))
  have h6 : steps 4 ⟨rep (k) [true, false, false, true] (cons true (cons false (cons true (cons false (L))))), cons true (cons false (cons true (cons false (cons true (R))))), .B⟩ = some ⟨cons false (cons true (rep (k) [true, false, false, true] (cons true (cons false (cons true (cons false (L))))))), cons false (cons false (cons true (R))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- The right counter carries through `j` digits (the left counter's lowest digit was 1). -/
theorem carry0 (j : Nat) (L R : Tape) :
    steps (12 * j + 54) ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))))))))))))), .E⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons true (R)))))))))))))))))), .E⟩ := by
  have hn : 11 + ((j) * 7 + (15 + (0 + ((j) * 5 + (28))))) = 12 * j + 54 := by omega
  have h0 : steps 11 ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))))))))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))), rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 7 ⟨app [] L, app [true, false, true, true, false] R, .A⟩ = some ⟨app [] (app [true, false, true, true, false] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 7) ⟨cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))), rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))), .A⟩ = some ⟨rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))), cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))), .A⟩ :=
    cross_r trans c1 (j) (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))) (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))))
  have h2 : steps 15 ⟨rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))), cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))), .A⟩ = some ⟨cons true (cons true (cons false (rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons true (R))))), .C⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons true (cons false (rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons true (R))))), .C⟩ = some ⟨rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons true (R))))), .C⟩ := by
    simp only [steps_zero, show cons true (cons true (cons false (rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))) = rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))) from
      rep_rotate (j) [true, true, false] [true, false, true, true, false] [true, true, false, true, false] rfl (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))]
  have c4 : ∀ L R : Tape, steps 5 ⟨app [true, true, false, true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [false, true, false, false, true] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 5) ⟨rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons true (R))))), .C⟩ = some ⟨cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))))), cons false (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons true (R)))))), .C⟩ :=
    cross_l trans c4 (j) (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))) (cons false (cons true (cons false (cons true (R)))))
  have h5 : steps 28 ⟨cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))))), cons false (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons true (R)))))), .C⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons true (R)))))))))))))))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The right counter carries through `j` digits beyond a stretch of literal cells (the left counter's lowest digit was 1). -/
theorem carry1 (j : Nat) (L R : Tape) :
    steps (12 * j + 66) ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))))))))))))))))), .E⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))))))))))))))), .E⟩ := by
  have hn : 11 + ((j) * 7 + (27 + (0 + ((j) * 5 + (28))))) = 12 * j + 66 := by omega
  have h0 : steps 11 ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))))))))))))))))), .E⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))), rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))))))))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 7 ⟨app [] L, app [true, false, true, true, false] R, .A⟩ = some ⟨app [] (app [true, false, true, true, false] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 7) ⟨cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))), rep (j) [true, false, true, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R)))))))))))))), .A⟩ = some ⟨rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))), cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))))))), .A⟩ :=
    cross_r trans c1 (j) (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))) (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))))))))
  have h2 : steps 27 ⟨rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))), cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))))))), .A⟩ = some ⟨cons true (cons true (cons false (rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .C⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons true (cons false (rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .C⟩ = some ⟨rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .C⟩ := by
    simp only [steps_zero, show cons true (cons true (cons false (rep (j) [true, false, true, true, false] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))) = rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))) from
      rep_rotate (j) [true, true, false] [true, false, true, true, false] [true, true, false, true, false] rfl (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))]
  have c4 : ∀ L R : Tape, steps 5 ⟨app [true, true, false, true, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [false, true, false, false, true] R), .C⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 5) ⟨rep (j) [true, true, false, true, false] (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))), cons false (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .C⟩ = some ⟨cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))))), cons false (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))), .C⟩ :=
    cross_l trans c4 (j) (cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L))))))))))))))) (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))
  have h5 : steps 28 ⟨cons true (cons true (cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))))))), cons false (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))), .C⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (rep (j) [false, true, false, false, true] (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))))))))))))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- The most frequent sampled event without a long borrow, all cells literal. -/
theorem plain (L R : Tape) :
    steps (54) ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))))))))))), .E⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (R))))))))))))))))), .E⟩ := by
  have hn : 40 + (14) = 54 := by omega
  have h0 : steps 40 ⟨cons false (cons true (L)), cons false (cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))))))))))))), .E⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))), cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ := rfl
  have h1 : steps 14 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons false (cons true (L)))))))))), cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ = some ⟨cons true (cons false (L)), cons false (cons false (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (R))))))))))))))))), .E⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))

end H124880
