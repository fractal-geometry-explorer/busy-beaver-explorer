/-- F on a blank pair (both cells 0): the pair becomes 11 and B leaves it to the right. -/
theorem reflect (L R : Tape) :
    steps (3) ⟨cons false (L), cons false (R), .F⟩ = some ⟨cons true (cons true (L)), R, .B⟩ := by
  have hn : 3 = 3 := by omega
  have h0 : steps 3 ⟨cons false (L), cons false (R), .F⟩ = some ⟨cons true (cons true (L)), R, .B⟩ := rfl
  exact steps_congr trans hn (h0)

