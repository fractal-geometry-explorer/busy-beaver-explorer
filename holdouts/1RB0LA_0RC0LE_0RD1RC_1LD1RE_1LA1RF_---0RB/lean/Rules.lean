import Machine

/-! # Shift rules of 1RB0LA_0RC0LE_0RD1RC_1LD1RE_1LA1RF_---0RB

The two passes over the bulk of the tape, which is made of the words 110 (seen at the right end) or 010 (seen at
the left end): moving right C turns each `010` into `101`, seven steps a word, so that `1 (010)^n` becomes
`(110)^n 1` (`pass_right`); moving left A turns each `011` back into `010` in fifteen steps (`pass_left`).  The only
halt is F reading a 0, reached from `E> 1 0` (`halt_E`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H35717

open TM

/-- C crosses `010` rightwards in seven steps and leaves `101`. -/
theorem pass_right (n : Nat) (L R : Tape) :
    steps (7 * n) ⟨cons true (L), rep (n) [false, true, false] (R), .C⟩ = some ⟨rep (n) [true, false, true] (cons true (L)), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 7 ⟨app [] L, app [false, true, false] R, .C⟩ = some ⟨app [] (app [true, false, true] L), R, .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 7) ⟨cons true (L), rep (n) [false, true, false] (R), .C⟩ = some ⟨rep (n) [true, false, true] (cons true (L)), R, .C⟩ :=
    cross_r trans c0 (n) (cons true (L)) (R)
  exact steps_congr trans (a := (n) * 7) (by omega) (h0)

/-- A crosses `011` leftwards in fifteen steps and leaves `010`. -/
theorem pass_left (n : Nat) (L R : Tape) :
    steps (15 * n) ⟨rep (n) [true, true, false] (L), cons true (cons false (R)), .A⟩ = some ⟨L, cons true (rep (n) [false, true, false] (cons false (R))), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 15 ⟨app [true, true, false] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [false, true, false] R), .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 15) ⟨rep (n) [true, true, false] (L), cons true (cons false (R)), .A⟩ = some ⟨L, cons true (rep (n) [false, true, false] (cons false (R))), .A⟩ :=
    cross_l trans c0 (n) (L) (cons false (R))
  exact steps_congr trans (a := (n) * 15) (by omega) (h0)

/-- `E> 1 0` halts: E keeps the 1 and moves right in state F, which reads a 0. -/
theorem halt_E (L R : Tape) : ∃ c, steps 1 ⟨L, cons true (cons false R), .E⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H35717
