  have c3 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [true, true] R), .B⟩ := fun _ _ => rfl
  have h3 : steps ((k + 1) * 2) ⟨rep (k + 1) [false, true] (cons false (blank)), cons true (cons true (blank)), .B⟩ = some ⟨cons false (blank), cons true (rep (k + 1) [true, true] (cons true (blank))), .B⟩ :=
    cross_l trans c3 (k + 1) (cons false (blank)) (cons true (blank))
  have h4 : steps 6 ⟨cons false (blank), cons true (rep (k + 1) [true, true] (cons true (blank))), .B⟩ = some ⟨cons true (cons false (cons false (blank))), cons true (rep (k + 1) [true, true] (cons true (blank))), .A⟩ := rfl
  have h5 : steps 0 ⟨cons true (cons false (cons false (blank))), cons true (rep (k + 1) [true, true] (cons true (blank))), .A⟩ = some ⟨cons true (cons false (cons false (blank))), rep (k + 1) [true, true] (cons true (cons true (blank))), .A⟩ := by
    simp only [steps_zero, show cons true (rep (k + 1) [true, true] (cons true (blank))) = rep (k + 1) [true, true] (cons true (cons true (blank))) from
      rep_rotate (k + 1) [true] [true, true] [true, true] rfl (cons true (blank))]
  have c6 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, false] L), R, .A⟩ := fun _ _ => rfl
  have h6 : steps ((k + 1) * 2) ⟨cons true (cons false (cons false (blank))), rep (k + 1) [true, true] (cons true (cons true (blank))), .A⟩ = some ⟨rep (k + 1) [true, false] (cons true (cons false (cons false (blank)))), cons true (cons true (blank)), .A⟩ :=
    cross_r trans c6 (k + 1) (cons true (cons false (cons false (blank)))) (cons true (cons true (blank)))
  have h7 : steps 5 ⟨rep (k + 1) [true, false] (cons true (cons false (cons false (blank)))), cons true (cons true (blank)), .A⟩ = some ⟨cons false (rep (k + 1) [true, false] (cons true (cons false (cons false (blank))))), cons true (cons false (cons true (blank))), .D⟩ := rfl
  have h8 : steps 0 ⟨cons false (rep (k + 1) [true, false] (cons true (cons false (cons false (blank))))), cons true (cons false (cons true (blank))), .D⟩ = some ⟨rep (k + 1) [false, true] (cons false (cons true (cons false (cons false (blank))))), cons true (cons false (cons true (blank))), .D⟩ := by
    simp only [steps_zero, show cons false (rep (k + 1) [true, false] (cons true (cons false (cons false (blank))))) = rep (k + 1) [false, true] (cons false (cons true (cons false (cons false (blank))))) from
      rep_rotate (k + 1) [false] [true, false] [false, true] rfl (cons true (cons false (cons false (blank))))]
  have c9 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h9 : steps ((k + 1) * 4) ⟨rep (k + 1) [false, true] (cons false (cons true (cons false (cons false (blank))))), cons true (cons false (cons true (blank))), .D⟩ = some ⟨cons false (cons true (cons false (cons false (blank)))), cons true (rep (k + 1) [false, true] (cons false (cons true (blank)))), .D⟩ :=
    cross_l trans c9 (k + 1) (cons false (cons true (cons false (cons false (blank))))) (cons false (cons true (blank)))
  have h10 : steps 15 ⟨cons false (cons true (cons false (cons false (blank)))), cons true (rep (k + 1) [false, true] (cons false (cons true (blank)))), .D⟩ = some ⟨cons true (cons false (cons false (blank))), cons true (cons true (cons false (cons true (rep (k + 1) [false, true] (cons false (cons true (blank))))))), .D⟩ := rfl
  exact steps_congr trans (a := (k + 1) * 2 + (3 + (0 + ((k + 1) * 2 + (6 + (0 + ((k + 1) * 2 + (5 + (0 + ((k + 1) * 4 + (15))))))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (h10)))))))))))

/-- A(2k+2, 0) reaches F on a 0, the halting transition: out of fuel with an even block, the machine halts. -/
theorem halt_even (k : Nat) :
    steps (2 * k + 4) ⟨blank, rep (k + 1) [true, true] (cons true (blank)), .A⟩ = some ⟨cons true (cons false (rep (k + 1) [true, false] (blank))), blank, .F⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, false] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((k + 1) * 2) ⟨blank, rep (k + 1) [true, true] (cons true (blank)), .A⟩ = some ⟨rep (k + 1) [true, false] (blank), cons true (blank), .A⟩ :=
    cross_r trans c0 (k + 1) (blank) (cons true (blank))
  have h1 : steps 2 ⟨rep (k + 1) [true, false] (blank), cons true (blank), .A⟩ = some ⟨cons true (cons false (rep (k + 1) [true, false] (blank))), blank, .F⟩ := rfl
  exact steps_congr trans (a := (k + 1) * 2 + (2)) (by omega) (steps_seq trans h0 (h1))

