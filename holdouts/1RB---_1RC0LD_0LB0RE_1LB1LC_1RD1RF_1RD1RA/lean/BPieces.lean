  have h0 : steps 2 ⟨rep (a) [true] (cons false (L)), cons true (cons false (R)), .F⟩ = some ⟨cons true (cons true (rep (a) [true] (cons false (L)))), R, .B⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- L 0 (1)^a F> (1)^b+2 0 R  ->  L 0 (1)^a 1 A> (1)^b+1 0 R  (halts) -/
theorem bp38 (a b : Nat) (L R : Tape) :
    steps (1) ⟨rep (a) [true] (cons false (L)), rep (b + 2) [true] (cons false (R)), .F⟩ = some ⟨cons true (rep (a) [true] (cons false (L))), rep (b + 1) [true] (cons false (R)), .A⟩ := by
  have h0 : steps 1 ⟨rep (a) [true] (cons false (L)), rep (b + 2) [true] (cons false (R)), .F⟩ = some ⟨cons true (rep (a) [true] (cons false (L))), rep (b + 1) [true] (cons false (R)), .A⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

end H68492
