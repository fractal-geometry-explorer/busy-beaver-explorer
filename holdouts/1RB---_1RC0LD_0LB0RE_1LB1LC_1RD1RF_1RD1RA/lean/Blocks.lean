import BPieces
import TM.ListFrame

/-!
# 1RB---_1RC0LD_0LB0RE_1LB1LC_1RD1RF_1RD1RA: the block map

The machine as a rewriting system on lists of blocks of 1s.  `blk [a, b, c, ...]` is the tape `1^a 0 1^b 0 1^c 0 ...`
(then blank), read away from the head; a block may be empty, and the empty list is blank tape.  A frame `BF` is a
state `q` and two block lists: the tape left of the head is `blk l`, the tape from the head cell rightwards `blk r`.
Every configuration with finitely many 1s is a frame.

`next` runs the machine from a frame until the head first needs a cell beyond the first block of each side.  It is
a finite table on (state, first left block l0, first right block r0), 39 cases; each case is one symbolic run of
`BPieces.lean`, valid for all block lengths in its range and all tapes around, and `next_sound` says every value of
`next` is a run of at least one step of the machine.  `next` is undefined exactly at the *critical* frames
(`next_none_iff`, `crit`), where the machine halts before the head leaves the window (`none_halts`):

* `A` with l0 ≥ 0, r0 ≥ 1  (`L 0 (1)^a A> (1)^b+1 0 R`)
* `B` with l0 ≥ 2, r0 ≥ 4  (`L 0 (1)^a+2 B> (1)^b+4 0 R`)
* `C` with l0 ≥ 0, r0 ≥ 4  (`L 0 (1)^a C> (1)^b+4 0 R`)
* `D` with l0 ≥ 1, r0 ≥ 3  (`L 0 (1)^a+1 D> (1)^b+3 0 R`)
* `E` with l0 ≥ 0, r0 ≥ 3  (`L 0 (1)^a E> (1)^b+3 0 R`)
* `F` with l0 ≥ 0, r0 ≥ 2  (`L 0 (1)^a F> (1)^b+2 0 R`)

The run from blank tape is the frame `start = ⟨A, [], []⟩` (`init_start`).  `halts_iff_critical`: the machine halts
from blank tape iff the orbit of `start` under `next` reaches a critical frame.  `frames_100000000` checks by
`native_decide` that `next` is defined on the first 100000000 frames, so none of them is critical (`no_halt_frames`).
Generated by `py/blockmap.py`; do not edit.
-/

set_option maxRecDepth 20000

namespace H68492

open TM

/-- Blocks of 1s, each followed by one 0, the first block next to the head; then blank tape. -/
def blk : List Nat → Tape
  | [] => blank
  | a :: R => rep a [true] (cons false (blk R))

/-- First block (an empty block if the list is empty, which is blank tape) and the rest. -/
def hd : List Nat → Nat
  | [] => 0
  | a :: _ => a

def tl : List Nat → List Nat
  | [] => []
  | _ :: R => R

theorem blk_ht : ∀ R : List Nat, blk R = rep (hd R) [true] (cons false (blk (tl R)))
  | [] => cons_false_blank.symm
  | _ :: _ => rfl

/-- A frame: state, blocks left of the head (nearest first), blocks from the head cell rightwards. -/
structure BF where
  q : St
  l : List Nat
  r : List Nat
  deriving DecidableEq, Repr

def BF.cfg (f : BF) : Config := ⟨blk f.l, blk f.r, f.q⟩

/-- `1^l1 0 1^l0  q>  1^r0 0 1^r1 0`, between `blk L` and `blk R`. -/
def c2 (q : St) (l0 l1 : Nat) (L : List Nat) (r0 r1 : Nat) (R : List Nat) : Config :=
  ⟨rep l0 [true] (cons false (rep l1 [true] (cons false (blk L)))),
   rep r0 [true] (cons false (rep r1 [true] (cons false (blk R)))), q⟩

theorem cfg2 (f : BF) :
    f.cfg = c2 f.q (hd f.l) (hd (tl f.l)) (tl (tl f.l)) (hd f.r) (hd (tl f.r)) (tl (tl f.r)) := by
  simp only [BF.cfg, c2, ← blk_ht]

theorem steps_eq_of {n : Nat} {c c' d d' : Config} (h : steps n c = some d) (hc : c = c') (hd : d = d') :
    steps n c' = some d' := by rw [← hc, ← hd]; exact h

theorem cfg_eq {l l' r r' : Tape} {q : St} (hl : l = l') (hr : r = r') :
    (⟨l, r, q⟩ : Config) = ⟨l', r', q⟩ := by rw [hl, hr]

/-- Two tapes made of cells, blocks and context tapes: write every cell as a run, merge runs of one symbol, then
match run by run, lengths by `omega`. -/
macro "blk_eq" : tactic =>
  `(tactic| focus
    try simp only [blk, rep_zero]
    try simp only [cons_rep1]
    try simp only [rep1_rep1]
    repeat' (first | rfl | apply rep_congr')
    all_goals omega)

/-- State A: the table on (l0, r0); `l1 :: L`, `r1 :: R` are the blocks behind the window. -/
def nextA (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : Nat → Nat → Option BF
  | a, 0 => some ⟨.B, (a + 1) :: l1 :: L, r1 :: R⟩
  | a, b + 1 => none

def critA : Nat → Nat → Bool
  | _, 0 => false
  | _, _ + 1 => true

/-- State B: the table on (l0, r0); `l1 :: L`, `r1 :: R` are the blocks behind the window. -/
def nextB (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : Nat → Nat → Option BF
  | a, 0 => some ⟨.C, (a + 1) :: l1 :: L, r1 :: R⟩
  | 0, b + 1 => some ⟨.D, l1 :: L, 0 :: 0 :: b :: r1 :: R⟩
  | 1, b + 1 => some ⟨.C, l1 :: L, 0 :: 1 :: b :: r1 :: R⟩
  | 2, 1 => some ⟨.B, l1 :: L, 1 :: 1 :: (1 + r1) :: R⟩
  | 3, 1 => some ⟨.D, l1 :: L, 0 :: 0 :: 0 :: 1 :: (1 + r1) :: R⟩
  | 4, 1 => some ⟨.C, l1 :: L, 0 :: 1 :: 0 :: 1 :: (1 + r1) :: R⟩
  | 5, 1 => some ⟨.B, l1 :: L, 1 :: 1 :: 2 :: (1 + r1) :: R⟩
  | a + 6, 1 => some ⟨.B, a :: l1 :: L, 1 :: 1 :: 2 :: (1 + r1) :: R⟩
  | a + 2, 2 => some ⟨.D, 2 :: 1 :: a :: l1 :: L, r1 :: R⟩
  | a + 2, 3 => some ⟨.B, 3 :: 1 :: a :: l1 :: L, r1 :: R⟩
  | a + 2, b + 4 => none

def critB : Nat → Nat → Bool
  | _, 0 => false
  | 0, _ + 1 => false
  | 1, _ + 1 => false
  | 2, 1 => false
  | 3, 1 => false
  | 4, 1 => false
  | 5, 1 => false
  | _ + 6, 1 => false
  | _ + 2, 2 => false
  | _ + 2, 3 => false
  | _ + 2, _ + 4 => true

/-- State C: the table on (l0, r0); `l1 :: L`, `r1 :: R` are the blocks behind the window. -/
def nextC (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : Nat → Nat → Option BF
  | 0, 0 => some ⟨.B, l1 :: L, 1 :: r1 :: R⟩
  | 1, 0 => some ⟨.D, l1 :: L, 0 :: 0 :: 0 :: r1 :: R⟩
  | 2, 0 => some ⟨.C, l1 :: L, 0 :: 1 :: 0 :: r1 :: R⟩
  | 3, 0 => some ⟨.B, l1 :: L, 1 :: 1 :: (1 + r1) :: R⟩
  | 4, 0 => some ⟨.D, l1 :: L, 0 :: 0 :: 0 :: 1 :: (1 + r1) :: R⟩
  | 5, 0 => some ⟨.C, l1 :: L, 0 :: 1 :: 0 :: 1 :: (1 + r1) :: R⟩
  | a + 6, 0 => some ⟨.C, a :: l1 :: L, 0 :: 1 :: 2 :: (1 + r1) :: R⟩
  | a, 1 => some ⟨.D, 1 :: a :: l1 :: L, r1 :: R⟩
  | a, 2 => some ⟨.D, 2 :: a :: l1 :: L, r1 :: R⟩
  | a, 3 => some ⟨.B, 3 :: a :: l1 :: L, r1 :: R⟩
  | a, b + 4 => none

def critC : Nat → Nat → Bool
  | 0, 0 => false
  | 1, 0 => false
  | 2, 0 => false
  | 3, 0 => false
  | 4, 0 => false
  | 5, 0 => false
  | _ + 6, 0 => false
  | _, 1 => false
  | _, 2 => false
  | _, 3 => false
  | _, _ + 4 => true

/-- State D: the table on (l0, r0); `l1 :: L`, `r1 :: R` are the blocks behind the window. -/
def nextD (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : Nat → Nat → Option BF
  | 0, 0 => some ⟨.E, 0 :: (1 + l1) :: L, r1 :: R⟩
  | 1, 0 => some ⟨.D, l1 :: L, 0 :: 0 :: (1 + r1) :: R⟩
  | 2, 0 => some ⟨.C, l1 :: L, 0 :: 1 :: (1 + r1) :: R⟩
  | a + 3, 0 => some ⟨.F, 1 :: 1 :: a :: l1 :: L, r1 :: R⟩
  | 0, b + 1 => some ⟨.C, l1 :: L, 0 :: (b + 1) :: r1 :: R⟩
  | a + 1, 1 => some ⟨.D, 2 :: a :: l1 :: L, r1 :: R⟩
  | a + 1, 2 => some ⟨.B, 3 :: a :: l1 :: L, r1 :: R⟩
  | a + 1, b + 3 => none

def critD : Nat → Nat → Bool
  | 0, 0 => false
  | 1, 0 => false
  | 2, 0 => false
  | _ + 3, 0 => false
  | 0, _ + 1 => false
  | _ + 1, 1 => false
  | _ + 1, 2 => false
  | _ + 1, _ + 3 => true

/-- State E: the table on (l0, r0); `l1 :: L`, `r1 :: R` are the blocks behind the window. -/
def nextE (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : Nat → Nat → Option BF
  | a, 0 => some ⟨.D, (a + 1) :: l1 :: L, r1 :: R⟩
  | a, 1 => some ⟨.D, (a + 2) :: l1 :: L, r1 :: R⟩
  | a, 2 => some ⟨.B, (a + 3) :: l1 :: L, r1 :: R⟩
  | a, b + 3 => none

def critE : Nat → Nat → Bool
  | _, 0 => false
  | _, 1 => false
  | _, 2 => false
  | _, _ + 3 => true

/-- State F: the table on (l0, r0); `l1 :: L`, `r1 :: R` are the blocks behind the window. -/
def nextF (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : Nat → Nat → Option BF
  | a, 0 => some ⟨.D, (a + 1) :: l1 :: L, r1 :: R⟩
  | a, 1 => some ⟨.B, (a + 2) :: l1 :: L, r1 :: R⟩
  | a, b + 2 => none

def critF : Nat → Nat → Bool
  | _, 0 => false
  | _, 1 => false
  | _, _ + 2 => true

/-- The block map. -/
def next (f : BF) : Option BF :=
  match f.q with
  | .A => nextA (hd (tl f.l)) (tl (tl f.l)) (hd (tl f.r)) (tl (tl f.r)) (hd f.l) (hd f.r)
  | .B => nextB (hd (tl f.l)) (tl (tl f.l)) (hd (tl f.r)) (tl (tl f.r)) (hd f.l) (hd f.r)
  | .C => nextC (hd (tl f.l)) (tl (tl f.l)) (hd (tl f.r)) (tl (tl f.r)) (hd f.l) (hd f.r)
  | .D => nextD (hd (tl f.l)) (tl (tl f.l)) (hd (tl f.r)) (tl (tl f.r)) (hd f.l) (hd f.r)
  | .E => nextE (hd (tl f.l)) (tl (tl f.l)) (hd (tl f.r)) (tl (tl f.r)) (hd f.l) (hd f.r)
  | .F => nextF (hd (tl f.l)) (tl (tl f.l)) (hd (tl f.r)) (tl (tl f.r)) (hd f.l) (hd f.r)

/-- The critical frames: the machine halts before the head leaves the window. -/
def crit (f : BF) : Bool :=
  match f.q with
  | .A => critA (hd f.l) (hd f.r)
  | .B => critB (hd f.l) (hd f.r)
  | .C => critC (hd f.l) (hd f.r)
  | .D => critD (hd f.l) (hd f.r)
  | .E => critE (hd f.l) (hd f.r)
  | .F => critF (hd f.l) (hd f.r)

macro "piece" t:term:max : tactic =>
  `(tactic| focus
    simp only [nextA, nextB, nextC, nextD, nextE, nextF, Option.some.injEq] at *
    subst_vars
    simp only [c2, BF.cfg]
    refine ⟨_, ?_, steps_eq_of ($t) (cfg_eq (by blk_eq) (by blk_eq)) (cfg_eq (by blk_eq) (by blk_eq))⟩
    omega)

macro "hpiece" t:term:max : tactic =>
  `(tactic| focus
    simp only [c2]
    exact ⟨_, _, steps_eq_of ($t) (cfg_eq (by blk_eq) (by blk_eq)) rfl, rfl⟩)

theorem nextA_sound (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat) (p' : BF),
    nextA l1 L r1 R l0 r0 = some p' → ∃ n, 0 < n ∧ steps n (c2 .A l0 l1 L r0 r1 R) = some p'.cfg
  | a, 0, _, h => by piece (bp0 a (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))
  | a, b + 1, _, h => by simp [nextA] at h

theorem nextA_halts (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat),
    nextA l1 L r1 R l0 r0 = none → TM.Halts trans (c2 .A l0 l1 L r0 r1 R)
  | a, 0, h => by simp [nextA] at h
  | a, b + 1, h => by exact ⟨0, _, rfl, rfl⟩

theorem nextA_none (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat),
    nextA l1 L r1 R l0 r0 = none ↔ critA l0 r0 = true
  | a, 0 => by simp [nextA, critA]
  | a, b + 1 => by simp [nextA, critA]

