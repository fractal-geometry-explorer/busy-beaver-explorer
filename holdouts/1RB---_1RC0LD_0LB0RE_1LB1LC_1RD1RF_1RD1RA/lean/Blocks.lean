theorem nextE_sound (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat) (p' : BF),
    nextE l1 L r1 R l0 r0 = some p' → ∃ n, 0 < n ∧ steps n (c2 .E l0 l1 L r0 r1 R) = some p'.cfg
  | a, 0, _, h => by piece (bp32 a (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))
  | a, 1, _, h => by piece (bp33 a (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))
  | a, 2, _, h => by piece (bp34 a (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))
  | a, b + 3, _, h => by simp [nextE] at h

theorem nextE_halts (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat),
    nextE l1 L r1 R l0 r0 = none → TM.Halts trans (c2 .E l0 l1 L r0 r1 R)
  | a, 0, h => by simp [nextE] at h
  | a, 1, h => by simp [nextE] at h
  | a, 2, h => by simp [nextE] at h
  | a, b + 3, h => by hpiece (bp35 a b (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))

theorem nextE_none (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat),
    nextE l1 L r1 R l0 r0 = none ↔ critE l0 r0 = true
  | a, 0 => by simp [nextE, critE]
  | a, 1 => by simp [nextE, critE]
  | a, 2 => by simp [nextE, critE]
  | a, b + 3 => by simp [nextE, critE]

theorem nextF_sound (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat) (p' : BF),
    nextF l1 L r1 R l0 r0 = some p' → ∃ n, 0 < n ∧ steps n (c2 .F l0 l1 L r0 r1 R) = some p'.cfg
  | a, 0, _, h => by piece (bp36 a (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))
  | a, 1, _, h => by piece (bp37 a (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))
  | a, b + 2, _, h => by simp [nextF] at h

theorem nextF_halts (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat),
    nextF l1 L r1 R l0 r0 = none → TM.Halts trans (c2 .F l0 l1 L r0 r1 R)
  | a, 0, h => by simp [nextF] at h
  | a, 1, h => by simp [nextF] at h
  | a, b + 2, h => by hpiece (bp38 a b (rep l1 [true] (cons false (blk L))) (rep r1 [true] (cons false (blk R))))

theorem nextF_none (l1 : Nat) (L : List Nat) (r1 : Nat) (R : List Nat) : ∀ (l0 r0 : Nat),
    nextF l1 L r1 R l0 r0 = none ↔ critF l0 r0 = true
  | a, 0 => by simp [nextF, critF]
  | a, 1 => by simp [nextF, critF]
  | a, b + 2 => by simp [nextF, critF]

/-- **Every value of the block map is a run of the machine**, for all block lists. -/
theorem next_sound (p p' : BF) (h : next p = some p') : ∃ n, 0 < n ∧ steps n p.cfg = some p'.cfg := by
  obtain ⟨q, l, r⟩ := p
  rw [cfg2]
  cases q <;> simp only [next] at h
  · exact nextA_sound _ _ _ _ _ _ p' h
  · exact nextB_sound _ _ _ _ _ _ p' h
  · exact nextC_sound _ _ _ _ _ _ p' h
  · exact nextD_sound _ _ _ _ _ _ p' h
  · exact nextE_sound _ _ _ _ _ _ p' h
  · exact nextF_sound _ _ _ _ _ _ p' h

/-- Where the block map is undefined, the machine halts. -/
theorem none_halts (p : BF) (h : next p = none) : TM.Halts trans p.cfg := by
  obtain ⟨q, l, r⟩ := p
  rw [cfg2]
  cases q <;> simp only [next] at h
  · exact nextA_halts _ _ _ _ _ _ h
  · exact nextB_halts _ _ _ _ _ _ h
  · exact nextC_halts _ _ _ _ _ _ h
  · exact nextD_halts _ _ _ _ _ _ h
  · exact nextE_halts _ _ _ _ _ _ h
  · exact nextF_halts _ _ _ _ _ _ h

/-- The block map is undefined exactly at the critical frames. -/
theorem next_none_iff (p : BF) : next p = none ↔ crit p = true := by
  obtain ⟨q, l, r⟩ := p
  cases q <;> simp only [next, crit]
  · exact nextA_none _ _ _ _ _ _
  · exact nextB_none _ _ _ _ _ _
  · exact nextC_none _ _ _ _ _ _
  · exact nextD_none _ _ _ _ _ _
  · exact nextE_none _ _ _ _ _ _
  · exact nextF_none _ _ _ _ _ _

/-- Blank tape, state A. -/
def start : BF := ⟨.A, [], []⟩

theorem init_start : steps 0 init = some start.cfg := rfl

/-- **The machine halts from blank tape if and only if the block map, iterated from the blank frame, reaches a
frame where it is undefined.** -/
theorem halts_iff : HaltsFromBlank ↔ ∃ k p, iterF next k start = some p ∧ next p = none :=
  frames_halts_iff trans BF.cfg next (fun _ => True) (fun p => next p = none)
    (fun p p' _ h => next_sound p p' h) (fun _ _ _ _ => trivial) (fun p _ h => none_halts p h) (fun _ _ h => h)
    init_start trivial

/-- **The machine halts from blank tape if and only if the block map reaches a critical frame.** -/
theorem halts_iff_critical : HaltsFromBlank ↔ ∃ k p, iterF next k start = some p ∧ crit p = true := by
  rw [halts_iff]
  constructor
  · rintro ⟨k, p, h, hn⟩; exact ⟨k, p, h, (next_none_iff p).1 hn⟩
  · rintro ⟨k, p, h, hn⟩; exact ⟨k, p, h, (next_none_iff p).2 hn⟩

theorem frames_100000000 : ∀ j, j ≤ 100000000 → ∃ p, iterF next j start = some p :=
  checkF_sound next 100000000 start (by native_decide)

/-- No critical frame among the first 100000000 frames of the run from blank tape. -/
theorem no_halt_frames : ∀ j, j < 100000000 → ∀ p, iterF next j start = some p → crit p = false := by
  intro j hj p hp
  obtain ⟨g, hg⟩ := frames_100000000 (j + 1) (by omega)
  rw [iterF_succ next j start p hp] at hg
  cases hc : crit p with
  | false => rfl
  | true => rw [(next_none_iff p).2 hc] at hg; cases hg

end H68492
