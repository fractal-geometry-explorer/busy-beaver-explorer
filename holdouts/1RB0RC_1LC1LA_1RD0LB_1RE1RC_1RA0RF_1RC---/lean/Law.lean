import Machine

/-!
# The block-level law of 1RB0RC_1LC1LA_1RD0LB_1RE1RC_1RA0RF_1RC---

Generated by `py/law_rules.py`; do not edit by hand.

Between two turns of the head the tape has two parts.  Behind the head (where it came from on its way out) the tape
is *blocks*: runs of 1s separated by single 0s; a block `1^b 0` is written as the number `b`.  Ahead of it the tape
is *gaps*: runs of 0s separated by single 1s; a gap `0^g 1` is written as the number `g`.  Here the blocks are on the left of the head, the gaps on the right.  A
configuration is a list `L` of closed blocks (nearest the head first), the length `o` of the open block next to the
head, the gap under the head, and the list `G` of the gaps after it; `X` and `Y` are the tape beyond the two lists
(any tape, or blank tape at the ends).

* `rc q L o g G X Y`: the head moves away from the blocks in state `q`, on the first cell of the gap `g`.
* `bc L o z G X Y`: the head moves back in state `B`, on the last cell of the open block (on the separator
  of the block `L.head` when `o = 0`); `z` zeros lie between it and the next 1.
* `rce`, `bce`: the same at the end of the tape, with only blank tape ahead (the gap is infinite).

Each theorem below is one rule of the law, with its exact number of machine steps.  Together they cover every
configuration of these four shapes; the only one without a successor is `halt`: state `F` on a gap of
length 0, that is, on two adjacent 1s.
-/

namespace H156554

open TM

/-- `n` ones in front of a stream. -/
def ones (n : Nat) (T : Tape) : Tape := rep n [true] T

/-- `n` zeros in front of a stream. -/
def zeros (n : Nat) (T : Tape) : Tape := rep n [false] T

/-- Closed blocks, nearest the head first: the separator 0, then `b` ones. -/
def blocks : List Nat → Tape → Tape
  | [], T => T
  | b :: bs, T => cons false (ones b (blocks bs T))

/-- Gaps, nearest the head first: `g` zeros, then a 1. -/
def gaps : List Nat → Tape → Tape
  | [], T => T
  | g :: gs, T => zeros g (cons true (gaps gs T))

/-- Outward phase: state `q` on the first cell of the gap `g`; open block `o`, closed blocks `L`, further gaps `G`. -/
def rc (q : St) (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) : Config :=
  ⟨ones o (blocks L X), zeros g (cons true (gaps G Y)), q⟩

/-- Outward phase at the end of the tape: only blank tape ahead. -/
def rce (q : St) (L : List Nat) (o : Nat) (X : Tape) : Config :=
  ⟨ones o (blocks L X), blank, q⟩

/-- Return phase: state `B` on the last cell of the open block `o` (on the separator of `L.head` if `o = 0`),
`z` zeros between the head and the next 1, then the gaps `G`. -/
def bc (L : List Nat) (o z : Nat) (G : List Nat) (X Y : Tape) : Config :=
  ⟨tail (ones o (blocks L X)), cons ((ones o (blocks L X)) 0) (zeros z (cons true (gaps G Y))), .B⟩

/-- Return phase with only blank tape on the gap side. -/
def bce (L : List Nat) (o : Nat) (X : Tape) : Config :=
  ⟨tail (ones o (blocks L X)), cons ((ones o (blocks L X)) 0) blank, .B⟩

/-- Return, open block of 3 or more: three of its cells `1 1 1` become `0 1 0`, a gap `z + 1` is closed. -/
theorem b_triple (L : List Nat) (o z : Nat) (G : List Nat) (X Y : Tape) :
    steps 5 (bc L (o + 3) z G X Y) = some (bc L o 1 ((z + 1) :: G) X Y) := rfl

/-- Return, open block of 2: the head turns; the open block joins the block behind it. -/
theorem b_turn2 (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 7 (bc (b :: L) 2 z G X Y) = some (rc .D L (b + 3) z G X Y) := rfl

/-- The same at the end of the blocks (blank tape behind). -/
theorem b_turn2_end (z : Nat) (G : List Nat) (Y : Tape) :
    steps 7 (bc [] 2 z G blank Y) = some (rc .D [] 3 z G blank Y) := rfl

/-- Return, open block of 1 and a nonempty block behind: `1 0 1` becomes `0 1 0`, the head enters that block. -/
theorem b_one (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 7 (bc ((b + 1) :: L) 1 z G X Y) = some (bc L b 1 ((z + 1) :: G) X Y) := rfl

/-- Return, open block of 1 and an empty block behind: the head turns. -/
theorem b_turn1 (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 9 (bc (0 :: b :: L) 1 z G X Y) = some (rc .D L (b + 3) z G X Y) := rfl

/-- The same with blank tape behind the empty block. -/
theorem b_turn1_end (z : Nat) (G : List Nat) (Y : Tape) :
    steps 9 (bc [0] 1 z G blank Y) = some (rc .D [] 3 z G blank Y) := rfl

/-- The same with blank tape behind the open block. -/
theorem b_turn1_end' (z : Nat) (G : List Nat) (Y : Tape) :
    steps 9 (bc [] 1 z G blank Y) = some (rc .D [] 3 z G blank Y) := rfl

/-- Return, head on the separator of a nonempty block: `1 0` becomes `0 1`, a gap `z` is closed. -/
theorem b_zero (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 2 (bc ((b + 1) :: L) 0 z G X Y) = some (bc L b 1 (z :: G) X Y) := rfl

/-- Return, head on the separator of an empty block: the head turns. -/
theorem b_turn0 (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 3 (bc (0 :: b :: L) 0 z G X Y) = some (rc .C L (b + 2) z G X Y) := rfl

/-- The same with blank tape behind the empty block. -/
theorem b_turn0_end (z : Nat) (G : List Nat) (Y : Tape) :
    steps 3 (bc [0] 0 z G blank Y) = some (rc .C [] 2 z G blank Y) := rfl

/-- The same on blank tape. -/
theorem b_turn0_end' (z : Nat) (G : List Nat) (Y : Tape) :
    steps 3 (bc [] 0 z G blank Y) = some (rc .C [] 2 z G blank Y) := rfl

/-- `b_triple` with only blank tape on the gap side: no gap is closed. -/
theorem b_triple_inf (L : List Nat) (o : Nat) (X : Tape) :
    steps 5 (bce L (o + 3) X) = some (bc L o 1 [] X blank) := by
  have h : steps 5 (bce L (o + 3) X) = some (⟨tail (ones o (blocks L X)), cons ((ones o (blocks L X)) 0) (cons false (cons true (cons false blank))), .B⟩ : Config) := rfl
  rw [cons_false_blank] at h
  exact h

/-- `b_turn2` with only blank tape on the gap side. -/
theorem b_turn2_inf (L : List Nat) (b : Nat) (X : Tape) :
    steps 7 (bce (b :: L) 2 X) = some (rce .D L (b + 3) X) := rfl

/-- `b_turn2_end` with only blank tape on the gap side. -/
theorem b_turn2_end_inf :
    steps 7 (bce [] 2 blank) = some (rce .D [] 3 blank) := rfl

/-- `b_one` with only blank tape on the gap side. -/
theorem b_one_inf (L : List Nat) (b : Nat) (X : Tape) :
    steps 7 (bce ((b + 1) :: L) 1 X) = some (bc L b 1 [] X blank) := by
  have h : steps 7 (bce ((b + 1) :: L) 1 X) = some (⟨tail (ones b (blocks L X)), cons ((ones b (blocks L X)) 0) (cons false (cons true (cons false blank))), .B⟩ : Config) := rfl
  rw [cons_false_blank] at h
  exact h

/-- `b_turn1` with only blank tape on the gap side. -/
theorem b_turn1_inf (L : List Nat) (b : Nat) (X : Tape) :
    steps 9 (bce (0 :: b :: L) 1 X) = some (rce .D L (b + 3) X) := rfl

/-- `b_turn1_end` with only blank tape on the gap side. -/
theorem b_turn1_end_inf :
    steps 9 (bce [0] 1 blank) = some (rce .D [] 3 blank) := rfl

/-- `b_turn1_end'` with only blank tape on the gap side. -/
theorem b_turn1_end_inf' :
    steps 9 (bce [] 1 blank) = some (rce .D [] 3 blank) := rfl

/-- `b_zero` with only blank tape on the gap side. -/
theorem b_zero_inf (L : List Nat) (b : Nat) (X : Tape) :
    steps 2 (bce ((b + 1) :: L) 0 X) = some (bc L b 1 [] X blank) := rfl

/-- `b_turn0` with only blank tape on the gap side. -/
theorem b_turn0_inf (L : List Nat) (b : Nat) (X : Tape) :
    steps 3 (bce (0 :: b :: L) 0 X) = some (rce .C L (b + 2) X) := rfl

/-- `b_turn0_end` with only blank tape on the gap side. -/
theorem b_turn0_end_inf :
    steps 3 (bce [0] 0 blank) = some (rce .C [] 2 blank) := rfl

/-- The start of the mirror twin: the head on blank tape. -/
theorem b_turn0_end_inf' :
    steps 3 (bce [] 0 blank) = some (rce .C [] 2 blank) := rfl

/-- Outward in C, gap 0 (a 1 under the head): the head turns, the 1 is erased and joins the next gap. -/
theorem c_turn0 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 1 (rc .C L o 0 (g :: G) X Y) = some (bc L o (g + 1) G X Y) := rfl

/-- `c_turn0` on the last gap. -/
theorem c_turn0_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 1 (rc .C L o 0 [] X blank) = some (bce L o X) := by
  have h : steps 1 (rc .C L o 0 [] X blank) = some (⟨tail (ones o (blocks L X)), cons ((ones o (blocks L X)) 0) (cons false blank), .B⟩ : Config) := rfl
  rw [cons_false_blank] at h
  exact h

/-- Outward in C, gap 1: `0 1` becomes `1 1`, the open block grows by 2. -/
theorem c_gap1 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 2 (rc .C L o 1 (g :: G) X Y) = some (rc .C L (o + 2) g G X Y) := rfl

/-- `c_gap1` on the last gap: blank tape follows. -/
theorem c_gap1_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 2 (rc .C L o 1 [] X blank) = some (rce .C L (o + 2) X) := rfl

/-- Outward in C, gap 2: `0 0 1` becomes `1 1 0`, the block `o + 2` is closed, state F. -/
theorem c_gap2 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 3 (rc .C L o 2 (g :: G) X Y) = some (rc .F ((o + 2) :: L) 0 g G X Y) := rfl

/-- `c_gap2` on the last gap: blank tape follows. -/
theorem c_gap2_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 3 (rc .C L o 2 [] X blank) = some (rce .F ((o + 2) :: L) 0 X) := rfl

/-- Outward in C, gap 3: `0 0 0 1` becomes `1 1 1 0`, the block `o + 3` is closed. -/
theorem c_gap3 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 4 (rc .C L o 3 (g :: G) X Y) = some (rc .C ((o + 3) :: L) 0 g G X Y) := rfl

/-- `c_gap3` on the last gap: blank tape follows. -/
theorem c_gap3_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 4 (rc .C L o 3 [] X blank) = some (rce .C ((o + 3) :: L) 0 X) := rfl

/-- Outward in C, gap 4: four 1s are written and the head turns on the 1 that ends the gap. -/
theorem c_turn4 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 4 (rc .C L o 4 (g :: G) X Y) = some (bc L (o + 5) g G X Y) := rfl

/-- `c_turn4` on the last gap. -/
theorem c_turn4_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 4 (rc .C L o 4 [] X blank) = some (bce L (o + 5) X) := rfl

/-- Outward in C, gap of 5 or more: four 1s are written and the head turns on the fifth 0. -/
theorem c_turn5 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 4 (rc .C L o (g + 5) G X Y) = some (bc ((o + 4) :: L) 0 g G X Y) := rfl

/-- Outward in C at the end of the tape: four new 1s, then the head turns. -/
theorem c_end (L : List Nat) (o : Nat) (X : Tape) :
    steps 4 (rce .C L o X) = some (bce ((o + 4) :: L) 0 X) := by
  have h : steps 4 (rce .C L o X) = some (⟨ones (o + 4) (blocks L X), blank, .B⟩ : Config) := rfl
  have e : (⟨ones (o + 4) (blocks L X), blank, .B⟩ : Config) = bce ((o + 4) :: L) 0 X := by
    show (⟨ones (o + 4) (blocks L X), blank, .B⟩ : Config) = (⟨ones (o + 4) (blocks L X), cons false blank, .B⟩ : Config)
    rw [cons_false_blank]
  rw [e] at h
  exact h

/-- Outward in F, gap of 1 or more: its first 0 becomes a 1 that opens a new block, state C. -/
theorem f_step (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 1 (rc .F L o (g + 1) G X Y) = some (rc .C L (o + 1) g G X Y) := rfl

/-- Outward in F at the end of the tape. -/
theorem f_end (L : List Nat) (o : Nat) (X : Tape) :
    steps 1 (rce .F L o X) = some (rce .C L (o + 1) X) := rfl

/-- Outward in D, gap 0: the 1 joins the open block. -/
theorem d_gap0 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 1 (rc .D L o 0 (g :: G) X Y) = some (rc .C L (o + 1) g G X Y) := rfl

/-- `d_gap0` on the last gap: blank tape follows. -/
theorem d_gap0_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 1 (rc .D L o 0 [] X blank) = some (rce .C L (o + 1) X) := rfl

/-- Outward in D, gap 1: `0 1` becomes `1 0`, the block `o + 1` is closed, state F. -/
theorem d_gap1 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 2 (rc .D L o 1 (g :: G) X Y) = some (rc .F ((o + 1) :: L) 0 g G X Y) := rfl

/-- `d_gap1` on the last gap: blank tape follows. -/
theorem d_gap1_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 2 (rc .D L o 1 [] X blank) = some (rce .F ((o + 1) :: L) 0 X) := rfl

/-- Outward in D, gap 2: `0 0 1` becomes `1 1 0`, the block `o + 2` is closed. -/
theorem d_gap2 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 3 (rc .D L o 2 (g :: G) X Y) = some (rc .C ((o + 2) :: L) 0 g G X Y) := rfl

/-- `d_gap2` on the last gap: blank tape follows. -/
theorem d_gap2_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 3 (rc .D L o 2 [] X blank) = some (rce .C ((o + 2) :: L) 0 X) := rfl

/-- Outward in D, gap 3: three 1s are written and the head turns on the 1 that ends the gap. -/
theorem d_turn3 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 3 (rc .D L o 3 (g :: G) X Y) = some (bc L (o + 4) g G X Y) := rfl

/-- `d_turn3` on the last gap. -/
theorem d_turn3_last (L : List Nat) (o : Nat) (X : Tape) :
    steps 3 (rc .D L o 3 [] X blank) = some (bce L (o + 4) X) := rfl

/-- Outward in D, gap of 4 or more: three 1s are written and the head turns on the fourth 0. -/
theorem d_turn4 (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 3 (rc .D L o (g + 4) G X Y) = some (bc ((o + 3) :: L) 0 g G X Y) := rfl

/-- Outward in D at the end of the tape: three new 1s, then the head turns. -/
theorem d_end (L : List Nat) (o : Nat) (X : Tape) :
    steps 3 (rce .D L o X) = some (bce ((o + 3) :: L) 0 X) := by
  have h : steps 3 (rce .D L o X) = some (⟨ones (o + 3) (blocks L X), blank, .B⟩ : Config) := rfl
  have e : (⟨ones (o + 3) (blocks L X), blank, .B⟩ : Config) = bce ((o + 3) :: L) 0 X := by
    show (⟨ones (o + 3) (blocks L X), blank, .B⟩ : Config) = (⟨ones (o + 3) (blocks L X), cons false blank, .B⟩ : Config)
    rw [cons_false_blank]
  rw [e] at h
  exact h

/-! ## Composite rules

The rules above, chained over the patterns that fill the tape in the run from blank tape: the words
S (gap 1), P (gaps 2 2) and Q (gaps 4 2) on the gap side, and the blocks they turn into.  Proved by evaluation like the others. -/

set_option maxRecDepth 100000 in
/-- Outward in C over the word P (gaps 2 2): the open block is closed with 2 more cells and a new one of 3 is opened; with `o = 3` the block is a 5 (`c_gap2`, `f_step`, `c_gap1`). -/
theorem pair_c (L : List Nat) (o g : Nat) (G : List Nat) (X Y : Tape) :
    steps 6 (rc .C L o 2 (2 :: g :: G) X Y) = some (rc .C ((o + 2) :: L) 3 g G X Y) := rfl

set_option maxRecDepth 100000 in
/-- Outward in F over the word P: a block 5 (`f_step`, `c_gap1`, `c_gap2`). -/
theorem pair_f (L : List Nat) (g : Nat) (G : List Nat) (X Y : Tape) :
    steps 6 (rc .F L 0 2 (2 :: g :: G) X Y) = some (rc .F (5 :: L) 0 g G X Y) := rfl

set_option maxRecDepth 100000 in
/-- Outward in F over the word Q (gaps 4 2): the blocks 4 and 2 (`f_step`, `c_gap3`, `c_gap2`). -/
theorem long_f (L : List Nat) (g : Nat) (G : List Nat) (X Y : Tape) :
    steps 8 (rc .F L 0 4 (2 :: g :: G) X Y) = some (rc .F (2 :: 4 :: L) 0 g G X Y) := rfl

set_option maxRecDepth 100000 in
/-- Outward in F on the word S (gap 1) followed by a gap 2: the head turns, and the two gaps and the 1 between them become one gap 4, so S P becomes Q (`f_step`, `c_turn0`, `b_one`). -/
theorem short_f (L : List Nat) (b : Nat) (G : List Nat) (X Y : Tape) :
    steps 9 (rc .F ((b + 1) :: L) 0 1 (2 :: G) X Y) = some (bc L b 1 (4 :: G) X Y) := rfl

set_option maxRecDepth 100000 in
/-- Outward in C (open block 3) on the word Q: the head turns on it, comes back three cells into the block `b` behind, turns again and goes on outward, leaving the blocks `b + 4` and 6 where `b`, the open 3 and Q were (`c_turn4`, `b_triple` twice, `b_turn2`, `d_gap1`, `f_step`, `c_gap1`, `c_gap3`). -/
theorem long_c (L : List Nat) (b g : Nat) (G : List Nat) (X Y : Tape) :
    steps 30 (rc .C (b :: L) 3 4 (2 :: g :: G) X Y) = some (rc .C (6 :: (b + 4) :: L) 0 g G X Y) := rfl

set_option maxRecDepth 100000 in
/-- Return onto a block 6 (the mark left by `long_c`): the head turns inside it, the 6 joins the block behind, and the head goes out again in F (`b_one`, `b_triple`, `b_turn2`, `d_gap1`). -/
theorem wall (L : List Nat) (b : Nat) (G : List Nat) (X Y : Tape) :
    steps 21 (bc (6 :: b :: L) 1 1 G X Y) = some (rc .F ((b + 4) :: L) 0 2 (2 :: G) X Y) := rfl

set_option maxRecDepth 100000 in
/-- Return over a block 5: two gaps (`b_one`, `b_triple`); with `z = 1` they are the word P. -/
theorem back_5 (L : List Nat) (z : Nat) (G : List Nat) (X Y : Tape) :
    steps 12 (bc (5 :: L) 1 z G X Y) = some (bc L 1 1 (2 :: (z + 1) :: G) X Y) := rfl

set_option maxRecDepth 100000 in
/-- Return over a block 7: gaps 1 2 2, the words S P (`b_one`, `b_triple` twice, `b_zero`). -/
theorem back_7 (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 19 (bc (7 :: (b + 1) :: L) 1 z G X Y) = some (bc L b 1 (1 :: 2 :: 2 :: (z + 1) :: G) X Y) := rfl

set_option maxRecDepth 100000 in
/-- Return over a block 13 (a 9 and a 6 joined by `wall`): gaps 1 2 2 2 2 2 (`b_one`, `b_triple` four times, `b_zero`). -/
theorem back_13 (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 29 (bc (13 :: (b + 1) :: L) 1 z G X Y) = some (bc L b 1 (1 :: 2 :: 2 :: 2 :: 2 :: (z + 1) :: G) X Y) := rfl

set_option maxRecDepth 100000 in
/-- Return over the blocks 4 and 2 (the image of Q under `long_f`): gaps 1 2 2 (`b_one` twice, `b_triple`, `b_zero`). -/
theorem back_4_2 (L : List Nat) (b z : Nat) (G : List Nat) (X Y : Tape) :
    steps 21 (bc (2 :: 4 :: (b + 1) :: L) 1 z G X Y) = some (bc L b 1 (1 :: 2 :: 2 :: (z + 1) :: G) X Y) := rfl

/-- The only configuration with no successor: state `F` on a gap of length 0 (two adjacent 1s). -/
theorem halt (L : List Nat) (o : Nat) (G : List Nat) (X Y : Tape) :
    step (rc .F L o 0 G X Y) = none := rfl

/-- After 1 step from blank tape the machine is in the return phase with a block of 1 behind the head and blank tape ahead. -/
theorem start : steps 1 init = some (bce [1] 0 blank) := by
  have h : steps 1 init = some (⟨ones 1 blank, blank, .B⟩ : Config) := rfl
  have e : (⟨ones 1 blank, blank, .B⟩ : Config) = bce [1] 0 blank := by
    show (⟨ones 1 blank, blank, .B⟩ : Config) = (⟨ones 1 blank, cons false blank, .B⟩ : Config)
    rw [cons_false_blank]
  rw [e] at h
  exact h

end H156554
