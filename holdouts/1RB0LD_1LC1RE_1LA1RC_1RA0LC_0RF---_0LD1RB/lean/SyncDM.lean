  [.right [.left [.right [.sync 1 3, .sync 1 3]], .left [.right [.sync 1 3, .sync 1 3, .sync 1 3]]], .right [.left [.right [.sync 1 3, .sync 1 3]], .left [.right [.sync 1 3, .sync 1 3, .sync 1 3]], .left [.right [.sync 1 3]]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1, .sync 1 1], .right [.sync 1 1], .right [.left [.right [.sync 1 3, .sync 1 3]], .left [.right [.sync 1 3, .sync 1 3]]], .right [.left [.right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3]], .left [.right [.sync 1 3, .sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3, .sync 1 3]]], .right [.left [.right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3]], .left [.right [.sync 1 3, .sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3, .sync 1 3]], .left [.right [.sync 1 3], .right [.sync 1 3], .right [.sync 1 3]]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1, .sync 1 1], .right [.sync 1 1], .right [.left [.right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3]], .left [.right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3], .right [.sync 1 3, .sync 1 3]]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1, .sync 1 1], .right [.sync 1 1], .right [.left [.right [.sync 1 3, .sync 1 3]], .left [.right [.sync 1 3, .sync 1 3]]]],
  [.right [.sync 1 1, .sync 1 1], .right [.left [.sync 1 1], .left [.sync 1 1]], .right [.left [.sync 1 1], .left [.sync 1 1], .left [.sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]], .right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1, .sync 1 1], .right [.sync 1 1], .right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]], .right [.left [.sync 1 1], .left [.sync 1 1]], .right [.left [.sync 1 1], .left [.sync 1 1], .left [.sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.left [.sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1]], .right [.sync 1 1, .sync 1 1]],
  [.right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.left [.sync 1 1], .left [.sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1], .right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1], .right [.left [.sync 1 1], .left [.sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1], .right [.left [.sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1]]],
  [.right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1, .sync 1 1], .right [.halt 1 1, .halt 1 1], .right [.halt 1 1, .halt 1 1, .halt 1 1], .right [.halt 1 1], .right [.sync 1 1, .sync 1 1]],
  [.right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]], .right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]], .right [.sync 1 1, .sync 1 1], .right [.sync 1 1, .sync 1 1, .sync 1 1], .right [.sync 1 1], .right [.left [.sync 1 1, .sync 1 1, .sync 1 1], .left [.sync 1 1, .sync 1 1, .sync 1 1]]]]

theorem closed : TM.CTL.closed transX autL autR absS = true := by decide
theorem starts : TM.CTL.starts autL autR absS .A = true := by decide
theorem checked : TM.Sync.checkAll transX transY autL autR pairs absS certs 5 = true := by decide

/-- 1RB0LD_1RC1RE_1LA1RC_1RA0LC_0RF---_0LD1RB halts from blank tape if and only if 1RB0LD_1LC1RE_1LA1RC_1RA0LC_0RF---_0LD1RB does. -/
theorem halts_iff : TM.Halts transX (TM.blankCfg .A) ↔ TM.Halts transY (TM.blankCfg .A) :=
  TM.Sync.halts_iff closed starts checked (by decide)

end H168919.SyncDM
