import TM.Sync
import Machine

/-!
# This holdout halts if and only if DeepMind's table, started in state C, halts

`transX` is 1RB0LD_1RC1RE_1LA1RC_1RA0LC_0RF---_0LD1RB.  It is the table
1RB1RE_1LC1RB_1RA0LD_1RC0LB_0RF---_0LD1RA, which google-deepmind/cryptids proves never halts from blank tape in state
A (`BusyBeaver/BB6/NonHalt/M_1RB1RE_1LC1RB_1RA0LD_1RC0LB_0RFHHH_0LD1RA.lean`, commit 3647718), with its states
renamed (A→B, B→C, C→A, D, E, F unchanged) so that it starts in its state C instead.
The holdout `transY` (`H168919.trans`) differs from `transX` in one transition, B0: `1LC` instead of `1RC`.  Every
time the first machine is in B, the cell to its left holds 1 (B is entered only by `1RB`), so where the first
machine does B0 in one step the holdout does `1LC` then C1 = `1RC` and is back in step after two.  The certificate
below checks this over a closed tape language (9 + 12 automaton edges, 67 abstract configurations); `TM.Sync.halts_iff`
then gives: one machine halts from blank tape if and only if the other does.

This does not decide the holdout: DeepMind's proof is for the other start state.  Their macro rules are facts about
the table and hold for both starts; what would be needed is a new run certificate (their `chunk_*` list ending in a
`glider` configuration) from state C.

Generated by `python3 tools/py/syncpair.py find 1RB0LD_1RC1RE_1LA1RC_1RA0LC_0RF---_0LD1RB
1RB0LD_1LC1RE_1LA1RC_1RA0LC_0RF---_0LD1RB cert.json --window 2` and `syncpair.py lean cert.json ...`, then edited to
use the holdout's own `St` and `trans` from `Machine.lean`.
-/

namespace H168919.SyncDM

open TM
open H168919 (St)

/-- The table of 1RB0LD_1RC1RE_1LA1RC_1RA0LC_0RF---_0LD1RB. -/
def transX : St → Bool → Option (Bool × Dir × St)
  | .A, false => some (true, .R, .B)
  | .A, true => some (false, .L, .D)
  | .B, false => some (true, .R, .C)
  | .B, true => some (true, .R, .E)
  | .C, false => some (true, .L, .A)
  | .C, true => some (true, .R, .C)
  | .D, false => some (true, .R, .A)
  | .D, true => some (false, .L, .C)
  | .E, false => some (false, .R, .F)
  | .E, true => none
  | .F, false => some (false, .L, .D)
  | .F, true => some (true, .R, .B)

/-- The holdout's own table (`H168919.trans`, `Machine.lean`). -/
abbrev transY : St → Bool → Option (Bool × Dir × St) := H168919.trans

/-- The left automaton (nearest cell first). -/
def autL : TM.CTL.Auto := ⟨[
    (0, false, 1), (0, false, 2), (0, false, 3), (1, true, 0), (2, true, 1), (2, true, 2), (2, true, 3),
    (3, true, 4), (4, false, 4)],
  [4]⟩

/-- The right automaton (head cell first). -/
def autR : TM.CTL.Auto := ⟨[
    (0, false, 0), (0, false, 1), (1, false, 2), (1, false, 3), (1, false, 4), (2, true, 0), (2, true, 1),
    (3, true, 2), (3, true, 3), (3, true, 4), (4, true, 5), (5, false, 5)],
  [5]⟩

