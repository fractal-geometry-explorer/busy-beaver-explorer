  (.A, 4, 1), (.A, 4, 3), (.A, 4, 5), (.B, 1, 0), (.B, 1, 1), (.B, 1, 2), (.B, 1, 3), (.B, 1, 4), (.B, 1, 5),
  (.B, 2, 0), (.B, 2, 1), (.B, 2, 2), (.B, 2, 3), (.B, 2, 4), (.B, 2, 5), (.B, 3, 2), (.B, 3, 3), (.B, 3, 4),
  (.B, 3, 5), (.C, 0, 2), (.C, 1, 0), (.C, 1, 1), (.C, 1, 2), (.C, 2, 0), (.C, 2, 1), (.C, 2, 2), (.C, 2, 3),
  (.C, 2, 4), (.C, 2, 5), (.C, 3, 0), (.C, 3, 1), (.C, 3, 2), (.C, 4, 0), (.C, 4, 2), (.D, 0, 2), (.D, 1, 0),
  (.D, 1, 2), (.D, 1, 5), (.D, 2, 0), (.D, 2, 2), (.D, 2, 5), (.D, 3, 0), (.D, 3, 2), (.D, 3, 5), (.D, 4, 0),
  (.D, 4, 2), (.E, 2, 0), (.E, 2, 1), (.E, 2, 2), (.E, 2, 3), (.E, 2, 4), (.E, 2, 5), (.F, 0, 0), (.F, 0, 1),
  (.F, 0, 2), (.F, 0, 3), (.F, 0, 4), (.F, 0, 5)]

/-- The pairs of states (first machine, second machine) at which the runs are together. -/
def pairs : List (St × St) := [(.A, .A), (.B, .B), (.C, .C), (.D, .D), (.E, .E), (.F, .F)]

