open TM

/-- Leftward pass over an even block: `1^(2k+2)` becomes the segment `(1 0)^k 1 0 0`, and C moves on to the 0 in front of it with the three 0s it carries. -/
theorem left_even (k : Nat) (L R : Tape) :
    steps (4 * k + 3) ⟨cons true (cons true (rep (k) [true, true] (cons false (L)))), cons false (cons false (cons false (R))), .C⟩ = some ⟨L, cons false (cons false (cons false (rep (k) [true, false] (cons true (cons false (cons false (R))))))), .C⟩ := by
  have h0 : steps 1 ⟨cons true (cons true (rep (k) [true, true] (cons false (L)))), cons false (cons false (cons false (R))), .C⟩ = some ⟨cons true (rep (k) [true, true] (cons false (L))), cons true (cons true (cons false (cons false (R)))), .A⟩ := rfl
  have h1 : steps 0 ⟨cons true (rep (k) [true, true] (cons false (L))), cons true (cons true (cons false (cons false (R)))), .A⟩ = some ⟨rep (k) [true, true] (cons true (cons false (L))), cons true (cons true (cons false (cons false (R)))), .A⟩ := by
    simp only [steps_zero, show cons true (rep (k) [true, true] (cons false (L))) = rep (k) [true, true] (cons true (cons false (L))) from
      rep_rotate (k) [true] [true, true] [true, true] rfl (cons false (L))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false] R), .A⟩ := fun _ _ => rfl
  have h2 : steps ((k) * 4) ⟨rep (k) [true, true] (cons true (cons false (L))), cons true (cons true (cons false (cons false (R)))), .A⟩ = some ⟨cons true (cons false (L)), cons true (rep (k) [true, false] (cons true (cons false (cons false (R))))), .A⟩ :=
    cross_l trans c2 (k) (cons true (cons false (L))) (cons true (cons false (cons false (R))))
  have h3 : steps 2 ⟨cons true (cons false (L)), cons true (rep (k) [true, false] (cons true (cons false (cons false (R))))), .A⟩ = some ⟨L, cons false (cons false (cons false (rep (k) [true, false] (cons true (cons false (cons false (R))))))), .C⟩ := rfl
  exact steps_congr trans (a := 1 + (0 + ((k) * 4 + (2)))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- Leftward pass reaching an odd block `1^(2k+1)`: it too becomes `(1 0)^k 1 0 0`, the 0 in front of it and its first cell become 1 1 (glued to the block on the left) and the head turns right in state B. -/
theorem left_odd (k : Nat) (L R : Tape) :
    steps (4 * k + 4) ⟨cons true (rep (k) [true, true] (cons false (L))), cons false (cons false (cons false (R))), .C⟩ = some ⟨cons true (cons true (L)), rep (k) [true, false] (cons true (cons false (cons false (R)))), .B⟩ := by
  have h0 : steps 1 ⟨cons true (rep (k) [true, true] (cons false (L))), cons false (cons false (cons false (R))), .C⟩ = some ⟨rep (k) [true, true] (cons false (L)), cons true (cons true (cons false (cons false (R)))), .A⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false] R), .A⟩ := fun _ _ => rfl
  have h1 : steps ((k) * 4) ⟨rep (k) [true, true] (cons false (L)), cons true (cons true (cons false (cons false (R)))), .A⟩ = some ⟨cons false (L), cons true (rep (k) [true, false] (cons true (cons false (cons false (R))))), .A⟩ :=
    cross_l trans c1 (k) (cons false (L)) (cons true (cons false (cons false (R))))
  have h2 : steps 3 ⟨cons false (L), cons true (rep (k) [true, false] (cons true (cons false (cons false (R))))), .A⟩ = some ⟨cons true (cons true (L)), rep (k) [true, false] (cons true (cons false (cons false (R)))), .B⟩ := rfl
  exact steps_congr trans (a := 1 + ((k) * 4 + (3))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

/-- Rightward pass: every three pairs `1 0 1 0 1 0` become a block `1^5` and a 0 (written here as left words). -/
theorem right_group (k : Nat) (L R : Tape) :
    steps (18 * k) ⟨cons true (L), rep (k) [true, false, true, false, true, false] (R), .B⟩ = some ⟨rep (k) [true, false, true, true, true, true] (cons true (L)), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 18 ⟨app [] L, app [true, false, true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, false, true, true, true, true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((k) * 18) ⟨cons true (L), rep (k) [true, false, true, false, true, false] (R), .B⟩ = some ⟨rep (k) [true, false, true, true, true, true] (cons true (L)), R, .B⟩ :=
    cross_r trans c0 (k) (cons true (L)) (R)
  exact steps_congr trans (a := (k) * 18) (by omega) (h0)

/-- Rightward pass at a segment end in phase 0: `1 0 0` becomes `1 1 1`. -/
theorem right_seg0 (L R : Tape) :
    steps (5) ⟨cons true (L), cons true (cons false (cons false (R))), .B⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), R, .B⟩ := by
  have h0 : steps 5 ⟨cons true (L), cons true (cons false (cons false (R))), .B⟩ = some ⟨cons true (cons true (cons true (cons true (L)))), R, .B⟩ := rfl
  exact steps_congr trans (a := 5) (by omega) (h0)

