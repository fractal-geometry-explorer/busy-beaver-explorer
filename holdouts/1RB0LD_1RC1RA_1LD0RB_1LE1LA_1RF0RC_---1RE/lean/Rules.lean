    steps (8 * j + 13) ⟨cons true (rep (j) [true, true] (cons false (cons false (blank)))), blank, .C⟩ = some ⟨rep (j) [true, true] (cons true (cons true (cons true (cons true (cons true (blank)))))), blank, .F⟩ := by
  have h0 : steps 1 ⟨cons true (rep (j) [true, true] (cons false (cons false (blank)))), blank, .C⟩ = some ⟨rep (j) [true, true] (cons false (cons false (blank))), cons true (cons true (blank)), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 2) ⟨rep (j) [true, true] (cons false (cons false (blank))), cons true (cons true (blank)), .D⟩ = some ⟨cons false (cons false (blank)), cons true (rep (j) [false, true] (cons true (blank))), .D⟩ :=
    cross_l trans c1 (j) (cons false (cons false (blank))) (cons true (blank))
  have h2 : steps 3 ⟨cons false (cons false (blank)), cons true (rep (j) [false, true] (cons true (blank))), .D⟩ = some ⟨cons true (cons true (cons false (blank))), rep (j) [false, true] (cons true (blank)), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((j) * 2) ⟨cons true (cons true (cons false (blank))), rep (j) [false, true] (cons true (blank)), .A⟩ = some ⟨rep (j) [true, true] (cons true (cons true (cons false (blank)))), cons true (blank), .A⟩ :=
    cross_r trans c3 (j) (cons true (cons true (cons false (blank)))) (cons true (blank))
  have c4 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 2) ⟨rep (j) [true, true] (cons true (cons true (cons false (blank)))), cons true (blank), .A⟩ = some ⟨cons true (cons true (cons false (blank))), cons true (rep (j) [true, false] (blank)), .A⟩ :=
    cross_l trans c4 (j) (cons true (cons true (cons false (blank)))) (blank)
  have h5 : steps 9 ⟨cons true (cons true (cons false (blank))), cons true (rep (j) [true, false] (blank)), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (blank))))), rep (j) [true, false] (blank), .F⟩ := rfl
  have c6 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .F⟩ = some ⟨app [] (app [true, true] L), R, .F⟩ := fun _ _ => rfl
  have h6 : steps ((j) * 2) ⟨cons true (cons true (cons true (cons true (cons true (blank))))), rep (j) [true, false] (blank), .F⟩ = some ⟨rep (j) [true, true] (cons true (cons true (cons true (cons true (cons true (blank)))))), blank, .F⟩ :=
    cross_r trans c6 (j) (cons true (cons true (cons true (cons true (cons true (blank)))))) (blank)
  exact steps_congr trans (a := 1 + ((j) * 2 + (3 + ((j) * 2 + ((j) * 2 + (9 + ((j) * 2))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

