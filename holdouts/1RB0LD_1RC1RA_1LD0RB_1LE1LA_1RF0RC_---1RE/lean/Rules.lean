open TM

/-- From blank tape to `1^3 0 0 1^3 C>` in 18 steps. -/
theorem start :
    steps (18) ⟨blank, blank, .A⟩ = some ⟨cons true (cons true (cons true (cons false (cons false (cons true (cons true (cons true (blank)))))))), blank, .C⟩ := by
  have h0 : steps 18 ⟨blank, blank, .A⟩ = some ⟨cons true (cons true (cons true (cons false (cons false (cons true (cons true (cons true (blank)))))))), blank, .C⟩ := rfl
  exact steps_congr trans (a := 18) (by omega) (h0)

/-- One sweep: `(10)^(k+2) 1^(2j+1) C>` becomes `(10)^k 1^(2j+7) C>`. -/
