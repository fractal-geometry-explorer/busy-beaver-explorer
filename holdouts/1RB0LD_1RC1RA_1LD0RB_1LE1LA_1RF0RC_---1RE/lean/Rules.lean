  have h3 : steps ((j) * 2) ⟨cons true (cons true (cons true (rep (k + 1) [false, true] (L)))), rep (j) [false, true] (cons true (blank)), .A⟩ = some ⟨rep (j) [true, true] (cons true (cons true (cons true (rep (k + 1) [false, true] (L))))), cons true (blank), .A⟩ :=
