  have h1 : steps ((j) * 2) ⟨rep (j) [true, true] (rep (k + 2) [false, true] (L)), cons true (cons true (blank)), .D⟩ = some ⟨rep (k + 2) [false, true] (L), cons true (rep (j) [false, true] (cons true (blank))), .D⟩ :=
    cross_l trans c1 (j) (rep (k + 2) [false, true] (L)) (cons true (blank))
  have h2 : steps 3 ⟨rep (k + 2) [false, true] (L), cons true (rep (j) [false, true] (cons true (blank))), .D⟩ = some ⟨cons true (cons true (cons true (rep (k + 1) [false, true] (L)))), rep (j) [false, true] (cons true (blank)), .A⟩ := rfl
