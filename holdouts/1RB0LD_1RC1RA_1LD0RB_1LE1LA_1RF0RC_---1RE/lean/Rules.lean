  have c4 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 2) ⟨rep (j) [true, true] (cons true (cons true (cons true (rep (k + 1) [false, true] (L))))), cons true (blank), .A⟩ = some ⟨cons true (cons true (cons true (rep (k + 1) [false, true] (L)))), cons true (rep (j) [true, false] (blank)), .A⟩ :=
    cross_l trans c4 (j) (cons true (cons true (cons true (rep (k + 1) [false, true] (L))))) (blank)
  have h5 : steps 9 ⟨cons true (cons true (cons true (rep (k + 1) [false, true] (L)))), cons true (rep (j) [true, false] (blank)), .A⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [false, true] (L))))))), rep (j) [true, false] (blank), .B⟩ := rfl
  have c6 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, true] L), R, .B⟩ := fun _ _ => rfl
  have h6 : steps ((j) * 2) ⟨cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [false, true] (L))))))), rep (j) [true, false] (blank), .B⟩ = some ⟨rep (j) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [false, true] (L)))))))), blank, .B⟩ :=
    cross_r trans c6 (j) (cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [false, true] (L)))))))) (blank)
  have h7 : steps 1 ⟨rep (j) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [false, true] (L)))))))), blank, .B⟩ = some ⟨cons true (rep (j) [true, true] (cons true (cons true (cons true (cons true (cons true (cons true (rep (k) [false, true] (L))))))))), blank, .C⟩ := rfl
