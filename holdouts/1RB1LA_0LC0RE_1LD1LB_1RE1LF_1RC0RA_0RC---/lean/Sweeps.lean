  have h0 : ∃ n, steps n ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))))))))), blank, .C⟩ = some ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ :=
    ⟨_, sweep_s1_s0 z (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))))⟩
  have h1 : ∃ n, steps n ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ = some ⟨cons false (cons true (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ :=
    seqL (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) (fun Y => cons true (Y)) .D (fun c L R => ⟨_, sweep_s1_b1 c L R⟩) ts (cons false (cons true (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))) (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))
  have h2 : ∃ n, steps n ⟨cons false (cons true (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ = some ⟨cons false (cons true (cons false (cons false (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ :=
    ⟨_, sweep_s1_s2 a L (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))))⟩
  have h3 : ∃ n, steps n ⟨cons false (cons true (cons false (cons false (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ = some ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .E⟩ :=
    seqR' (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) (fun Y => Y) .E (fun c L R => ⟨_, sweep_s1_b3 c L R⟩) ts (cons false (cons true (cons false (cons false (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))) (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))
  have h4 : ∃ n, steps n ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (rep (z) [false, true, false] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))))))))))), blank, .C⟩ :=
    ⟨_, sweep_s1_s4 z (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

/-- sweep_s2, stretch 0. -/
theorem sweep_s2_s0 (z : Nat) (K0 : Tape) :
    steps (5 * z + 8) ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (K0))))))), blank, .C⟩ = some ⟨K0, cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ := by
  have h0 : steps 8 ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (K0))))))), blank, .C⟩ = some ⟨rep (z) [false, false, true] (K0), cons true (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 5 ⟨app [false, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((z) * 5) ⟨rep (z) [false, false, true] (K0), cons true (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .D⟩ = some ⟨K0, cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ :=
    cross_l trans c1 (z) (K0) (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))
  exact steps_congr trans (a := 8 + ((z) * 5)) (by omega) (steps_seq trans h0 (h1))

/-- One block of sweep_s2, move 1. -/
theorem sweep_s2_b1 (c : Nat) (L R : Tape) :
    steps (5 * c + 9) ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (L)))))))), cons true (R), .D⟩ = some ⟨L, cons true (rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ := by
