  have h1 : ∃ n, steps n ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (blank)))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ = some ⟨cons false (cons true (cons true (blank))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ :=
