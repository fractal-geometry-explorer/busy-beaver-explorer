  have h2 : ∃ n, steps n ⟨cons false (cons false (cons false (cons true (blank)))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (blank))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ :=
    ⟨_, left_s0_s2 (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))))⟩
  have h3 : ∃ n, steps n ⟨cons false (cons true (cons false (cons true (cons true (blank))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ = some ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons true (cons true (blank)))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .E⟩ :=
