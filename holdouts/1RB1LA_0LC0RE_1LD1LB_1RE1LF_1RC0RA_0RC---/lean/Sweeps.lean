  have h0 : steps 8 ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (K0))))))), blank, .C⟩ = some ⟨rep (z) [false, false, true] (K0), cons true (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 5 ⟨app [false, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((z) * 5) ⟨rep (z) [false, false, true] (K0), cons true (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .D⟩ = some ⟨K0, cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ :=
    cross_l trans c1 (z) (K0) (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))
  exact steps_congr trans (a := 8 + ((z) * 5)) (by omega) (steps_seq trans h0 (h1))

/-- One block of left_s3_s, move 1. -/
theorem left_s3_s_b1 (c : Nat) (L R : Tape) :
    steps (5 * c + 9) ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (L)))))))), cons true (R), .D⟩ = some ⟨L, cons true (rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ := by
  have h0 : steps 9 ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (L)))))))), cons true (R), .D⟩ = some ⟨rep (c) [false, false, true] (L), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 5 ⟨app [false, false, true] L, app [true] R, .D⟩ = some ⟨L, app [true] (app [true, false, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((c) * 5) ⟨rep (c) [false, false, true] (L), cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))), .D⟩ = some ⟨L, cons true (rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ :=
    cross_l trans c1 (c) (L) (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))
  exact steps_congr trans (a := 9 + ((c) * 5)) (by omega) (steps_seq trans h0 (h1))

/-- left_s3_s, stretch 2. -/
theorem left_s3_s_s2 (K1 : Tape) :
    steps (25) ⟨cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), cons true (K1), .D⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))), K1, .A⟩ := by
  have h0 : steps 25 ⟨cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), cons true (K1), .D⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))), K1, .A⟩ := rfl
  exact steps_congr trans (a := 25) (by omega) (h0)

/-- One block of left_s3_s, move 3. -/
theorem left_s3_s_b3 (c : Nat) (L R : Tape) :
    steps (7 * c + 13) ⟨cons false (L), rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (L))))))))), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 7 ⟨app [false] L, app [true, false, true] R, .A⟩ = some ⟨app [false] (app [false, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((c) * 7) ⟨cons false (L), rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))), .A⟩ = some ⟨cons false (rep (c) [false, false, true] (L)), cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))), .A⟩ :=
    cross_r trans c0 (c) (L) (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))
  have h1 : steps 13 ⟨cons false (rep (c) [false, false, true] (L)), cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))), .A⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (L))))))))), R, .A⟩ := rfl
  exact steps_congr trans (a := (c) * 7 + (13)) (by omega) (steps_seq trans h0 (h1))

/-- left_s3_s, stretch 4. -/
theorem left_s3_s_s4 (z : Nat) (K0 : Tape) :
    steps (7 * z + 28) ⟨cons false (K0), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons true (rep (z) [false, false, true] (K0)))))))))), blank, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 7 ⟨app [false] L, app [true, false, true] R, .A⟩ = some ⟨app [false] (app [false, false, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((z) * 7) ⟨cons false (K0), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .A⟩ = some ⟨cons false (rep (z) [false, false, true] (K0)), cons true (cons false (cons true (cons false (cons true (cons true (blank)))))), .A⟩ :=
    cross_r trans c0 (z) (K0) (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))
  have h1 : steps 28 ⟨cons false (rep (z) [false, false, true] (K0)), cons true (cons false (cons true (cons false (cons true (cons true (blank)))))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons true (rep (z) [false, false, true] (K0)))))))))), blank, .C⟩ := rfl
  exact steps_congr trans (a := (z) * 7 + (28)) (by omega) (steps_seq trans h0 (h1))

/-- Left end [0]S3 [0]S (= [0]S [0]S3) followed only by S3 digits: an overflow; the left end becomes [0]S [0]S0, every S3 becomes S0 and a new S1 is born at the right end. -/
theorem left_s3_s (z : Nat) (ts : List (Nat)) :
    ∃ n, steps n ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))), blank, .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons true (rep (z) [false, false, true] (sq (fun (c : Nat) (X : Tape) => cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))))))))))))), blank, .C⟩ := by
  have h0 : ∃ n, steps n ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (cons false (cons true (blank)))))))))))))), blank, .C⟩ = some ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ :=
    ⟨_, left_s3_s_s0 z (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))⟩
  have h1 : ∃ n, steps n ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ :=
    seqL (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) (fun Y => cons true (Y)) .D (fun c L R => ⟨_, left_s3_s_b1 c L R⟩) ts (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))) (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))
  have h2 : ∃ n, steps n ⟨cons false (cons true (cons false (cons true (cons false (cons true (blank)))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ = some ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .A⟩ :=
    ⟨_, left_s3_s_s2 (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))))⟩
  have h3 : ∃ n, steps n ⟨cons false (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .A⟩ = some ⟨cons false (sq (fun (c : Nat) (X : Tape) => cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank))))))))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .A⟩ :=
    seqR' (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) (fun (c : Nat) (X : Tape) => cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) (fun Y => cons false (Y)) .A (fun c L R => ⟨_, left_s3_s_b3 c L R⟩) ts (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))) (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))
  have h4 : ∃ n, steps n ⟨cons false (sq (fun (c : Nat) (X : Tape) => cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank))))))))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .A⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons true (rep (z) [false, false, true] (sq (fun (c : Nat) (X : Tape) => cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))))))))))))), blank, .C⟩ :=
    ⟨_, left_s3_s_s4 z (sq (fun (c : Nat) (X : Tape) => cons false (cons false (cons true (cons false (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons false (cons true (cons false (cons false (cons false (cons true (cons false (cons true (blank)))))))))))⟩
  obtain ⟨n0, h0⟩ := h0; obtain ⟨n1, h1⟩ := h1; obtain ⟨n2, h2⟩ := h2; obtain ⟨n3, h3⟩ := h3; obtain ⟨n4, h4⟩ := h4
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4))))⟩

