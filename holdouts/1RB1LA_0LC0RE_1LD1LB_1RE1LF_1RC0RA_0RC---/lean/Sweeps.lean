    ⟨_, sweep_s2_s0 z (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))))))⟩
  have h1 : ∃ n, steps n ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ = some ⟨cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ :=
    seqL (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) (fun Y => cons true (Y)) .D (fun c L R => ⟨_, sweep_s2_b1 c L R⟩) ts (cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))))) (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))
  have h2 : ∃ n, steps n ⟨cons false (cons false (cons false (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ :=
    ⟨_, sweep_s2_s2 a L (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))))⟩
  have h3 : ∃ n, steps n ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L)))))))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ = some ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (a) [false, false, true] (L))))))))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .E⟩ :=
