/-- The first block used up: 0^inf 10 110 (S, then S1 with left run 0) becomes 0^inf 1000: the leading 10 and the S1 merge into an S0 at the left end. -/
theorem left_s_s1 (z : Nat) (ts : List (Nat)) :
    ∃ n, steps n ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons true (blank))))))))))))), blank, .C⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (rep (z) [false, true, false] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons true (blank))))))))))))))), blank, .C⟩ := by
  have h0 : ∃ n, steps n ⟨cons true (cons false (cons true (cons false (cons false (cons true (rep (z) [false, false, true] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons true (blank))))))))))))), blank, .C⟩ = some ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons true (blank)))))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ :=
    ⟨_, left_s_s1_s0 z (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons true (blank)))))))⟩
  have h1 : ∃ n, steps n ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) ts (cons false (cons true (cons true (cons false (cons true (blank)))))), cons true (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .D⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (blank))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ :=
    seqL (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (c) [false, false, true] (X))))))))) (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) (fun Y => cons true (Y)) .D (fun c L R => ⟨_, left_s_s1_b1 c L R⟩) ts (cons false (cons true (cons true (cons false (cons true (blank)))))) (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))
  have h2 : ∃ n, steps n ⟨cons false (cons true (cons true (cons false (cons true (blank))))), cons true (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))), .D⟩ = some ⟨cons false (cons true (cons false (cons false (cons false (cons true (blank)))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ :=
    ⟨_, left_s_s1_s2 (sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))))⟩
  have h3 : ∃ n, steps n ⟨cons false (cons true (cons false (cons false (cons false (cons true (blank)))))), sqr (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) ts (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank)))))))), .E⟩ = some ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons true (blank))))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .E⟩ :=
    seqR' (fun (c : Nat) (X : Tape) => rep (c) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (X))))))))) (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) (fun Y => Y) .E (fun c L R => ⟨_, left_s_s1_b3 c L R⟩) ts (cons false (cons true (cons false (cons false (cons false (cons true (blank))))))) (rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))
  have h4 : ∃ n, steps n ⟨sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons true (blank))))))), rep (z) [true, false, true] (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))), .E⟩ = some ⟨cons true (cons false (cons true (cons false (cons false (cons true (cons false (rep (z) [false, true, false] (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons true (blank))))))))))))))), blank, .C⟩ :=
    ⟨_, left_s_s1_s4 z (sq (fun (c : Nat) (X : Tape) => cons false (cons true (cons false (cons false (cons false (cons true (cons false (rep (c) [false, true, false] (X))))))))) ts (cons false (cons true (cons false (cons false (cons false (cons true (blank))))))))⟩
