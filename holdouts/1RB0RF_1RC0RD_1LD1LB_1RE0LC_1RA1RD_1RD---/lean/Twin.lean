  | .A, true => some (false, .R, .C)
  | .B, false => some (true, .L, .C)
  | .B, true => some (true, .L, .A)
  | .C, false => some (true, .R, .D)
  | .C, true => some (false, .L, .B)
  | .D, false => some (true, .R, .E)
  | .D, true => some (true, .R, .C)
  | .E, false => some (true, .R, .A)
