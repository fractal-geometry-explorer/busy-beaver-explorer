    cross_r trans c11 (k + 2) (cons true (cons false (cons true (cons false (cons true (cons false (blank))))))) (cons false (cons true (blank)))
  have h12 : steps 5 ⟨rep (k + 2) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (blank))))))), cons false (cons true (blank)), .C⟩ = some ⟨cons false (rep (k + 2) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))), cons true (cons true (cons true (blank))), .C⟩ := rfl
  have h13 : steps 0 ⟨cons false (rep (k + 2) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))), cons true (cons true (cons true (blank))), .C⟩ = some ⟨rep (k + 2) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))), cons true (cons true (cons true (blank))), .C⟩ := by
    simp only [steps_zero, show cons false (rep (k + 2) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))) = rep (k + 2) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))) from
      rep_rotate (k + 2) [false] [true, false] [false, true] rfl (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))]
  have c14 : ∀ L R : Tape, steps 4 ⟨app [false, true] L, app [true, true] R, .C⟩ = some ⟨L, app [true, true] (app [true, true] R), .C⟩ := fun _ _ => rfl
  have h14 : steps ((k + 2) * 4) ⟨rep (k + 2) [false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))), cons true (cons true (cons true (blank))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (blank))))))), cons true (cons true (rep (k + 2) [true, true] (cons true (blank)))), .C⟩ :=
    cross_l trans c14 (k + 2) (cons false (cons true (cons false (cons true (cons false (cons true (cons false (blank)))))))) (cons true (blank))
  have h15 : steps 16 ⟨cons false (cons true (cons false (cons true (cons false (cons true (cons false (blank))))))), cons true (cons true (rep (k + 2) [true, true] (cons true (blank)))), .C⟩ = some ⟨blank, cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (k + 2) [true, true] (cons true (blank)))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (steps_seq trans h11 (steps_seq trans h12 (steps_seq trans h13 (steps_seq trans h14 (h15))))))))))))))))

/-- Round 0: `C> 0 1 1^(c+2)` becomes `C> 0 1 (01)^2 1^c`. -/
theorem l_r0 (c : Nat) :
    steps (12) ⟨blank, cons false (cons true (rep (c + 2) [true] (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (rep (c) [true] (blank))))))), .C⟩ := by
  have hn : 12 = 12 := by omega
  have h0 : steps 12 ⟨blank, cons false (cons true (rep (c + 2) [true] (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (rep (c) [true] (blank))))))), .C⟩ := rfl
  exact steps_congr trans hn (h0)

/-- Start of a round: `C> 0 1 (01)^(a+1) 1^(c+2)` becomes `1 (01)^a A> 0 1 1^(c+2)`. -/
theorem l_rint (a c : Nat) :
    steps (2 * a + 8) ⟨blank, cons false (cons true (rep (a + 1) [false, true] (rep (c + 2) [true] (blank)))), .C⟩ = some ⟨cons true (rep (a) [false, true] (cons false (blank))), cons false (cons true (cons true (cons true (rep (c) [true] (blank))))), .A⟩ := by
  have hn : 1 + (0 + ((a + 1) * 2 + (5))) = 2 * a + 8 := by omega
  have h0 : steps 1 ⟨blank, cons false (cons true (rep (a + 1) [false, true] (rep (c + 2) [true] (blank)))), .C⟩ = some ⟨cons false (blank), cons true (rep (a + 1) [false, true] (rep (c + 2) [true] (blank))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons false (blank), cons true (rep (a + 1) [false, true] (rep (c + 2) [true] (blank))), .E⟩ = some ⟨cons false (blank), rep (a + 1) [true, false] (cons true (rep (c + 2) [true] (blank))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (a + 1) [false, true] (rep (c + 2) [true] (blank))) = rep (a + 1) [true, false] (cons true (rep (c + 2) [true] (blank))) from
      rep_rotate (a + 1) [true] [false, true] [true, false] rfl (rep (c + 2) [true] (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .E⟩ = some ⟨app [] (app [false, true] L), R, .E⟩ := fun _ _ => rfl
  have h2 : steps ((a + 1) * 2) ⟨cons false (blank), rep (a + 1) [true, false] (cons true (rep (c + 2) [true] (blank))), .E⟩ = some ⟨rep (a + 1) [false, true] (cons false (blank)), cons true (rep (c + 2) [true] (blank)), .E⟩ :=
    cross_r trans c2 (a + 1) (cons false (blank)) (cons true (rep (c + 2) [true] (blank)))
  have h3 : steps 5 ⟨rep (a + 1) [false, true] (cons false (blank)), cons true (rep (c + 2) [true] (blank)), .E⟩ = some ⟨cons true (rep (a) [false, true] (cons false (blank))), cons false (cons true (cons true (cons true (rep (c) [true] (blank))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- One step of a round: a pair 01 moves from the left block to the right block, and two 1s are spent. -/
theorem l_it (c i m : Nat) :
    steps (8 * i + 6) ⟨rep (m + 1) [true, false] (cons true (blank)), cons false (cons true (rep (i) [false, true, false, true] (rep (c + 2) [true] (blank)))), .A⟩ = some ⟨rep (m) [true, false] (cons true (blank)), cons false (cons true (cons false (cons true (rep (i) [false, true, false, true] (cons false (rep (c + 1) [true] (blank))))))), .A⟩ := by
  have hn : 0 + ((i) * 4 + (3 + (0 + ((i) * 4 + (3))))) = 8 * i + 6 := by omega
  have h0 : steps 0 ⟨rep (m + 1) [true, false] (cons true (blank)), cons false (cons true (rep (i) [false, true, false, true] (rep (c + 2) [true] (blank)))), .A⟩ = some ⟨rep (m + 1) [true, false] (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (rep (c + 2) [true] (blank)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (i) [false, true, false, true] (rep (c + 2) [true] (blank)))) = rep (i) [false, true, false, true] (cons false (cons true (rep (c + 2) [true] (blank)))) from
      rep_rotate (i) [false, true] [false, true, false, true] [false, true, false, true] rfl (rep (c + 2) [true] (blank))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((i) * 4) ⟨rep (m + 1) [true, false] (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (rep (c + 2) [true] (blank)))), .A⟩ = some ⟨rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank))), cons false (cons true (rep (c + 2) [true] (blank))), .A⟩ :=
    cross_r trans c1 (i) (rep (m + 1) [true, false] (cons true (blank))) (cons false (cons true (rep (c + 2) [true] (blank))))
  have h2 : steps 3 ⟨rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank))), cons false (cons true (rep (c + 2) [true] (blank))), .A⟩ = some ⟨cons true (rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank)))), cons true (cons false (rep (c + 1) [true] (blank))), .F⟩ := rfl
  have h3 : steps 0 ⟨cons true (rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank)))), cons true (cons false (rep (c + 1) [true] (blank))), .F⟩ = some ⟨rep (i) [true, true, true, true] (cons true (rep (m + 1) [true, false] (cons true (blank)))), cons true (cons false (rep (c + 1) [true] (blank))), .F⟩ := by
    simp only [steps_zero, show cons true (rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank)))) = rep (i) [true, true, true, true] (cons true (rep (m + 1) [true, false] (cons true (blank)))) from
      rep_rotate (i) [true] [true, true, true, true] [true, true, true, true] rfl (rep (m + 1) [true, false] (cons true (blank)))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [false, true, false, true] R), .F⟩ := fun _ _ => rfl
  have h4 : steps ((i) * 4) ⟨rep (i) [true, true, true, true] (cons true (rep (m + 1) [true, false] (cons true (blank)))), cons true (cons false (rep (c + 1) [true] (blank))), .F⟩ = some ⟨cons true (rep (m + 1) [true, false] (cons true (blank))), cons true (rep (i) [false, true, false, true] (cons false (rep (c + 1) [true] (blank)))), .F⟩ :=
    cross_l trans c4 (i) (cons true (rep (m + 1) [true, false] (cons true (blank)))) (cons false (rep (c + 1) [true] (blank)))
  have h5 : steps 3 ⟨cons true (rep (m + 1) [true, false] (cons true (blank))), cons true (rep (i) [false, true, false, true] (cons false (rep (c + 1) [true] (blank)))), .F⟩ = some ⟨rep (m) [true, false] (cons true (blank)), cons false (cons true (cons false (cons true (rep (i) [false, true, false, true] (cons false (rep (c + 1) [true] (blank))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (h5))))))

/-- A round runs out of 1s: `1 (01)^(m+1) A> 0 1 (01)^(2i) 1` becomes `(10)^m 1^(4i+5) A>`. -/
theorem l_iend1 (i m : Nat) :
    steps (12 * i + 10) ⟨rep (m + 1) [true, false] (cons true (blank)), cons false (cons true (rep (i) [false, true, false, true] (cons true (blank)))), .A⟩ = some ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (cons true (rep (m) [true, false] (cons true (blank))))))), cons false (blank), .A⟩ := by
  have hn : 0 + ((i) * 4 + (2 + (0 + ((i) * 4 + (6 + (0 + ((i) * 4 + (2)))))))) = 12 * i + 10 := by omega
  have h0 : steps 0 ⟨rep (m + 1) [true, false] (cons true (blank)), cons false (cons true (rep (i) [false, true, false, true] (cons true (blank)))), .A⟩ = some ⟨rep (m + 1) [true, false] (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (cons true (blank)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (i) [false, true, false, true] (cons true (blank)))) = rep (i) [false, true, false, true] (cons false (cons true (cons true (blank)))) from
      rep_rotate (i) [false, true] [false, true, false, true] [false, true, false, true] rfl (cons true (blank))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((i) * 4) ⟨rep (m + 1) [true, false] (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (cons true (blank)))), .A⟩ = some ⟨rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank))), cons false (cons true (cons true (blank))), .A⟩ :=
    cross_r trans c1 (i) (rep (m + 1) [true, false] (cons true (blank))) (cons false (cons true (cons true (blank))))
  have h2 : steps 2 ⟨rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank))), cons false (cons true (cons true (blank))), .A⟩ = some ⟨cons true (cons true (rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank))))), cons true (blank), .A⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons true (rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank))))), cons true (blank), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (rep (m + 1) [true, false] (cons true (blank))))), cons true (blank), .A⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (i) [true, true, true, true] (rep (m + 1) [true, false] (cons true (blank))))) = rep (i) [true, true, true, true] (cons true (cons true (rep (m + 1) [true, false] (cons true (blank))))) from
      rep_rotate (i) [true, true] [true, true, true, true] [true, true, true, true] rfl (rep (m + 1) [true, false] (cons true (blank)))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((i) * 4) ⟨rep (i) [true, true, true, true] (cons true (cons true (rep (m + 1) [true, false] (cons true (blank))))), cons true (blank), .A⟩ = some ⟨cons true (cons true (rep (m + 1) [true, false] (cons true (blank)))), cons true (rep (i) [true, false, true, false] (blank)), .A⟩ :=
    cross_l trans c4 (i) (cons true (cons true (rep (m + 1) [true, false] (cons true (blank))))) (blank)
  have h5 : steps 6 ⟨cons true (cons true (rep (m + 1) [true, false] (cons true (blank)))), cons true (rep (i) [true, false, true, false] (blank)), .A⟩ = some ⟨cons true (cons true (rep (m) [true, false] (cons true (blank)))), cons false (cons true (cons false (rep (i) [true, false, true, false] (blank)))), .A⟩ := rfl
  have h6 : steps 0 ⟨cons true (cons true (rep (m) [true, false] (cons true (blank)))), cons false (cons true (cons false (rep (i) [true, false, true, false] (blank)))), .A⟩ = some ⟨cons true (cons true (rep (m) [true, false] (cons true (blank)))), rep (i) [false, true, false, true] (cons false (cons true (cons false (blank)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (i) [true, false, true, false] (blank)))) = rep (i) [false, true, false, true] (cons false (cons true (cons false (blank)))) from
      rep_rotate (i) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (blank)]
  have c7 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h7 : steps ((i) * 4) ⟨cons true (cons true (rep (m) [true, false] (cons true (blank)))), rep (i) [false, true, false, true] (cons false (cons true (cons false (blank)))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (rep (m) [true, false] (cons true (blank))))), cons false (cons true (cons false (blank))), .A⟩ :=
    cross_r trans c7 (i) (cons true (cons true (rep (m) [true, false] (cons true (blank))))) (cons false (cons true (cons false (blank))))
  have h8 : steps 2 ⟨rep (i) [true, true, true, true] (cons true (cons true (rep (m) [true, false] (cons true (blank))))), cons false (cons true (cons false (blank))), .A⟩ = some ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (cons true (rep (m) [true, false] (cons true (blank))))))), cons false (blank), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- A full round ends: `1 A> 0 1 (01)^(2i) 1^(c+4)` becomes `C> 0 1 (01)^(2i+4) 1^c`. -/
theorem l_i0a (c i : Nat) :
    steps (16 * i + 20) ⟨cons true (blank), cons false (cons true (rep (i) [false, true, false, true] (rep (c + 4) [true] (blank)))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (i) [true, false, true, false] (cons true (cons false (rep (c + 1) [true] (blank))))))))))), .C⟩ := by
  have hn : 0 + ((i) * 4 + (3 + (0 + ((i) * 4 + (4 + (0 + ((i) * 4 + (7 + (0 + ((i) * 4 + (6))))))))))) = 16 * i + 20 := by omega
  have h0 : steps 0 ⟨cons true (blank), cons false (cons true (rep (i) [false, true, false, true] (rep (c + 4) [true] (blank)))), .A⟩ = some ⟨cons true (blank), rep (i) [false, true, false, true] (cons false (cons true (rep (c + 4) [true] (blank)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (i) [false, true, false, true] (rep (c + 4) [true] (blank)))) = rep (i) [false, true, false, true] (cons false (cons true (rep (c + 4) [true] (blank)))) from
      rep_rotate (i) [false, true] [false, true, false, true] [false, true, false, true] rfl (rep (c + 4) [true] (blank))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((i) * 4) ⟨cons true (blank), rep (i) [false, true, false, true] (cons false (cons true (rep (c + 4) [true] (blank)))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (blank)), cons false (cons true (rep (c + 4) [true] (blank))), .A⟩ :=
    cross_r trans c1 (i) (cons true (blank)) (cons false (cons true (rep (c + 4) [true] (blank))))
  have h2 : steps 3 ⟨rep (i) [true, true, true, true] (cons true (blank)), cons false (cons true (rep (c + 4) [true] (blank))), .A⟩ = some ⟨cons true (rep (i) [true, true, true, true] (cons true (blank))), cons true (cons false (rep (c + 3) [true] (blank))), .F⟩ := rfl
  have h3 : steps 0 ⟨cons true (rep (i) [true, true, true, true] (cons true (blank))), cons true (cons false (rep (c + 3) [true] (blank))), .F⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (blank))), cons true (cons false (rep (c + 3) [true] (blank))), .F⟩ := by
    simp only [steps_zero, show cons true (rep (i) [true, true, true, true] (cons true (blank))) = rep (i) [true, true, true, true] (cons true (cons true (blank))) from
      rep_rotate (i) [true] [true, true, true, true] [true, true, true, true] rfl (cons true (blank))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [false, true, false, true] R), .F⟩ := fun _ _ => rfl
  have h4 : steps ((i) * 4) ⟨rep (i) [true, true, true, true] (cons true (cons true (blank))), cons true (cons false (rep (c + 3) [true] (blank))), .F⟩ = some ⟨cons true (cons true (blank)), cons true (rep (i) [false, true, false, true] (cons false (rep (c + 3) [true] (blank)))), .F⟩ :=
    cross_l trans c4 (i) (cons true (cons true (blank))) (cons false (rep (c + 3) [true] (blank)))
  have h5 : steps 4 ⟨cons true (cons true (blank)), cons true (rep (i) [false, true, false, true] (cons false (rep (c + 3) [true] (blank)))), .F⟩ = some ⟨cons true (blank), cons true (cons false (cons true (rep (i) [false, true, false, true] (cons false (rep (c + 3) [true] (blank)))))), .B⟩ := rfl
  have h6 : steps 0 ⟨cons true (blank), cons true (cons false (cons true (rep (i) [false, true, false, true] (cons false (rep (c + 3) [true] (blank)))))), .B⟩ = some ⟨cons true (blank), rep (i) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c + 3) [true] (blank)))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (i) [false, true, false, true] (cons false (rep (c + 3) [true] (blank)))))) = rep (i) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c + 3) [true] (blank)))))) from
      rep_rotate (i) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (rep (c + 3) [true] (blank)))]
  have c7 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .B⟩ = some ⟨app [] (app [true, true, true, true] L), R, .B⟩ := fun _ _ => rfl
  have h7 : steps ((i) * 4) ⟨cons true (blank), rep (i) [true, false, true, false] (cons true (cons false (cons true (cons false (rep (c + 3) [true] (blank)))))), .B⟩ = some ⟨rep (i) [true, true, true, true] (cons true (blank)), cons true (cons false (cons true (cons false (rep (c + 3) [true] (blank))))), .B⟩ :=
    cross_r trans c7 (i) (cons true (blank)) (cons true (cons false (cons true (cons false (rep (c + 3) [true] (blank))))))
  have h8 : steps 7 ⟨rep (i) [true, true, true, true] (cons true (blank)), cons true (cons false (cons true (cons false (rep (c + 3) [true] (blank))))), .B⟩ = some ⟨cons true (cons true (cons true (rep (i) [true, true, true, true] (cons true (blank))))), cons true (cons true (cons false (rep (c + 1) [true] (blank)))), .A⟩ := rfl
  have h9 : steps 0 ⟨cons true (cons true (cons true (rep (i) [true, true, true, true] (cons true (blank))))), cons true (cons true (cons false (rep (c + 1) [true] (blank)))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (cons true (blank))))), cons true (cons true (cons false (rep (c + 1) [true] (blank)))), .A⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (i) [true, true, true, true] (cons true (blank))))) = rep (i) [true, true, true, true] (cons true (cons true (cons true (cons true (blank))))) from
      rep_rotate (i) [true, true, true] [true, true, true, true] [true, true, true, true] rfl (cons true (blank))]
  have c10 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h10 : steps ((i) * 4) ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (cons true (blank))))), cons true (cons true (cons false (rep (c + 1) [true] (blank)))), .A⟩ = some ⟨cons true (cons true (cons true (cons true (blank)))), cons true (rep (i) [true, false, true, false] (cons true (cons false (rep (c + 1) [true] (blank))))), .A⟩ :=
    cross_l trans c10 (i) (cons true (cons true (cons true (cons true (blank))))) (cons true (cons false (rep (c + 1) [true] (blank))))
  have h11 : steps 6 ⟨cons true (cons true (cons true (cons true (blank)))), cons true (rep (i) [true, false, true, false] (cons true (cons false (rep (c + 1) [true] (blank))))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (i) [true, false, true, false] (cons true (cons false (rep (c + 1) [true] (blank))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (h11))))))))))))

/-- A round ends with three 1s: `C> 0 1 (01)^(2i+3)` follows. -/
theorem l_i0b (i : Nat) :
    steps (16 * i + 20) ⟨cons true (blank), cons false (cons true (rep (i) [false, true, false, true] (cons true (cons true (cons true (blank)))))), .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (i) [false, true, false, true] (cons false (blank)))))))))), .C⟩ := by
  have hn : 0 + ((i) * 4 + (2 + (0 + ((i) * 4 + (6 + (0 + ((i) * 4 + (5 + (0 + ((i) * 4 + (7))))))))))) = 16 * i + 20 := by omega
  have h0 : steps 0 ⟨cons true (blank), cons false (cons true (rep (i) [false, true, false, true] (cons true (cons true (cons true (blank)))))), .A⟩ = some ⟨cons true (blank), rep (i) [false, true, false, true] (cons false (cons true (cons true (cons true (cons true (blank)))))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (i) [false, true, false, true] (cons true (cons true (cons true (blank)))))) = rep (i) [false, true, false, true] (cons false (cons true (cons true (cons true (cons true (blank)))))) from
      rep_rotate (i) [false, true] [false, true, false, true] [false, true, false, true] rfl (cons true (cons true (cons true (blank))))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((i) * 4) ⟨cons true (blank), rep (i) [false, true, false, true] (cons false (cons true (cons true (cons true (cons true (blank)))))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (blank)), cons false (cons true (cons true (cons true (cons true (blank))))), .A⟩ :=
    cross_r trans c1 (i) (cons true (blank)) (cons false (cons true (cons true (cons true (cons true (blank))))))
  have h2 : steps 2 ⟨rep (i) [true, true, true, true] (cons true (blank)), cons false (cons true (cons true (cons true (cons true (blank))))), .A⟩ = some ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (blank)))), cons true (cons true (cons true (blank))), .A⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (blank)))), cons true (cons true (cons true (blank))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (blank)))), cons true (cons true (cons true (blank))), .A⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (i) [true, true, true, true] (cons true (blank)))) = rep (i) [true, true, true, true] (cons true (cons true (cons true (blank)))) from
      rep_rotate (i) [true, true] [true, true, true, true] [true, true, true, true] rfl (cons true (blank))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((i) * 4) ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (blank)))), cons true (cons true (cons true (blank))), .A⟩ = some ⟨cons true (cons true (cons true (blank))), cons true (rep (i) [true, false, true, false] (cons true (cons true (blank)))), .A⟩ :=
    cross_l trans c4 (i) (cons true (cons true (cons true (blank)))) (cons true (cons true (blank)))
  have h5 : steps 6 ⟨cons true (cons true (cons true (blank))), cons true (rep (i) [true, false, true, false] (cons true (cons true (blank)))), .A⟩ = some ⟨cons true (cons true (blank)), cons false (cons true (cons false (rep (i) [true, false, true, false] (cons true (cons true (blank)))))), .A⟩ := rfl
  have h6 : steps 0 ⟨cons true (cons true (blank)), cons false (cons true (cons false (rep (i) [true, false, true, false] (cons true (cons true (blank)))))), .A⟩ = some ⟨cons true (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (i) [true, false, true, false] (cons true (cons true (blank)))))) = rep (i) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))) from
      rep_rotate (i) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (cons true (cons true (blank)))]
  have c7 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h7 : steps ((i) * 4) ⟨cons true (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (blank)))))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (blank))), cons false (cons true (cons false (cons true (cons true (blank))))), .A⟩ :=
    cross_r trans c7 (i) (cons true (cons true (blank))) (cons false (cons true (cons false (cons true (cons true (blank))))))
  have h8 : steps 5 ⟨rep (i) [true, true, true, true] (cons true (cons true (blank))), cons false (cons true (cons false (cons true (cons true (blank))))), .A⟩ = some ⟨cons true (cons true (cons true (rep (i) [true, true, true, true] (cons true (cons true (blank)))))), cons true (cons false (blank)), .F⟩ := rfl
  have h9 : steps 0 ⟨cons true (cons true (cons true (rep (i) [true, true, true, true] (cons true (cons true (blank)))))), cons true (cons false (blank)), .F⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (blank)))))), cons true (cons false (blank)), .F⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (i) [true, true, true, true] (cons true (cons true (blank)))))) = rep (i) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (blank)))))) from
      rep_rotate (i) [true, true, true] [true, true, true, true] [true, true, true, true] rfl (cons true (cons true (blank)))]
  have c10 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [false, true, false, true] R), .F⟩ := fun _ _ => rfl
  have h10 : steps ((i) * 4) ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (cons true (cons true (blank)))))), cons true (cons false (blank)), .F⟩ = some ⟨cons true (cons true (cons true (cons true (cons true (blank))))), cons true (rep (i) [false, true, false, true] (cons false (blank))), .F⟩ :=
    cross_l trans c10 (i) (cons true (cons true (cons true (cons true (cons true (blank)))))) (cons false (blank))
  have h11 : steps 7 ⟨cons true (cons true (cons true (cons true (cons true (blank))))), cons true (rep (i) [false, true, false, true] (cons false (blank))), .F⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (rep (i) [false, true, false, true] (cons false (blank)))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (steps_seq trans h8 (steps_seq trans h9 (steps_seq trans h10 (h11))))))))))))

/-- A round ends with one 1: the tape becomes `1^(4i+4) A>`. -/
theorem l_i0c (i : Nat) :
    steps (12 * i + 10) ⟨cons true (blank), cons false (cons true (rep (i) [false, true, false, true] (cons true (blank)))), .A⟩ = some ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (cons true (blank))))), cons false (blank), .A⟩ := by
  have hn : 0 + ((i) * 4 + (2 + (0 + ((i) * 4 + (6 + (0 + ((i) * 4 + (2)))))))) = 12 * i + 10 := by omega
  have h0 : steps 0 ⟨cons true (blank), cons false (cons true (rep (i) [false, true, false, true] (cons true (blank)))), .A⟩ = some ⟨cons true (blank), rep (i) [false, true, false, true] (cons false (cons true (cons true (blank)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (rep (i) [false, true, false, true] (cons true (blank)))) = rep (i) [false, true, false, true] (cons false (cons true (cons true (blank)))) from
      rep_rotate (i) [false, true] [false, true, false, true] [false, true, false, true] rfl (cons true (blank))]
  have c1 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h1 : steps ((i) * 4) ⟨cons true (blank), rep (i) [false, true, false, true] (cons false (cons true (cons true (blank)))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (blank)), cons false (cons true (cons true (blank))), .A⟩ :=
    cross_r trans c1 (i) (cons true (blank)) (cons false (cons true (cons true (blank))))
  have h2 : steps 2 ⟨rep (i) [true, true, true, true] (cons true (blank)), cons false (cons true (cons true (blank))), .A⟩ = some ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (blank)))), cons true (blank), .A⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (blank)))), cons true (blank), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (blank)))), cons true (blank), .A⟩ := by
    simp only [steps_zero, show cons true (cons true (rep (i) [true, true, true, true] (cons true (blank)))) = rep (i) [true, true, true, true] (cons true (cons true (cons true (blank)))) from
      rep_rotate (i) [true, true] [true, true, true, true] [true, true, true, true] rfl (cons true (blank))]
  have c4 : ∀ L R : Tape, steps 4 ⟨app [true, true, true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .A⟩ := fun _ _ => rfl
  have h4 : steps ((i) * 4) ⟨rep (i) [true, true, true, true] (cons true (cons true (cons true (blank)))), cons true (blank), .A⟩ = some ⟨cons true (cons true (cons true (blank))), cons true (rep (i) [true, false, true, false] (blank)), .A⟩ :=
    cross_l trans c4 (i) (cons true (cons true (cons true (blank)))) (blank)
  have h5 : steps 6 ⟨cons true (cons true (cons true (blank))), cons true (rep (i) [true, false, true, false] (blank)), .A⟩ = some ⟨cons true (cons true (blank)), cons false (cons true (cons false (rep (i) [true, false, true, false] (blank)))), .A⟩ := rfl
  have h6 : steps 0 ⟨cons true (cons true (blank)), cons false (cons true (cons false (rep (i) [true, false, true, false] (blank)))), .A⟩ = some ⟨cons true (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (cons false (blank)))), .A⟩ := by
    simp only [steps_zero, show cons false (cons true (cons false (rep (i) [true, false, true, false] (blank)))) = rep (i) [false, true, false, true] (cons false (cons true (cons false (blank)))) from
      rep_rotate (i) [false, true, false] [true, false, true, false] [false, true, false, true] rfl (blank)]
  have c7 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [true, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h7 : steps ((i) * 4) ⟨cons true (cons true (blank)), rep (i) [false, true, false, true] (cons false (cons true (cons false (blank)))), .A⟩ = some ⟨rep (i) [true, true, true, true] (cons true (cons true (blank))), cons false (cons true (cons false (blank))), .A⟩ :=
    cross_r trans c7 (i) (cons true (cons true (blank))) (cons false (cons true (cons false (blank))))
  have h8 : steps 2 ⟨rep (i) [true, true, true, true] (cons true (cons true (blank))), cons false (cons true (cons false (blank))), .A⟩ = some ⟨cons true (cons true (rep (i) [true, true, true, true] (cons true (cons true (blank))))), cons false (blank), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (steps_seq trans h6 (steps_seq trans h7 (h8)))))))))

/-- No 1s left at the start of a round: `C> 0 1 (01)^(a+1)` becomes `C> 0 1^(2a+6)` (the rounds restart). -/
theorem l_rrs (a : Nat) :
    steps (6 * a + 15) ⟨blank, cons false (cons true (rep (a + 1) [false, true] (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons true (cons true (rep (a + 1) [true, true] (cons true (blank)))))), .C⟩ := by
  have hn : 1 + (0 + ((a + 1) * 2 + (3 + (0 + ((a + 1) * 4 + (5)))))) = 6 * a + 15 := by omega
  have h0 : steps 1 ⟨blank, cons false (cons true (rep (a + 1) [false, true] (blank))), .C⟩ = some ⟨cons false (blank), cons true (rep (a + 1) [false, true] (blank)), .E⟩ := rfl
  have h1 : steps 0 ⟨cons false (blank), cons true (rep (a + 1) [false, true] (blank)), .E⟩ = some ⟨cons false (blank), rep (a + 1) [true, false] (cons true (blank)), .E⟩ := by
    simp only [steps_zero, show cons true (rep (a + 1) [false, true] (blank)) = rep (a + 1) [true, false] (cons true (blank)) from
      rep_rotate (a + 1) [true] [false, true] [true, false] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .E⟩ = some ⟨app [] (app [false, true] L), R, .E⟩ := fun _ _ => rfl
  have h2 : steps ((a + 1) * 2) ⟨cons false (blank), rep (a + 1) [true, false] (cons true (blank)), .E⟩ = some ⟨rep (a + 1) [false, true] (cons false (blank)), cons true (blank), .E⟩ :=
    cross_r trans c2 (a + 1) (cons false (blank)) (cons true (blank))
  have h3 : steps 3 ⟨rep (a + 1) [false, true] (cons false (blank)), cons true (blank), .E⟩ = some ⟨cons true (rep (a + 1) [false, true] (cons false (blank))), cons false (cons true (blank)), .F⟩ := rfl
  have h4 : steps 0 ⟨cons true (rep (a + 1) [false, true] (cons false (blank))), cons false (cons true (blank)), .F⟩ = some ⟨rep (a + 1) [true, false] (cons true (cons false (blank))), cons false (cons true (blank)), .F⟩ := by
    simp only [steps_zero, show cons true (rep (a + 1) [false, true] (cons false (blank))) = rep (a + 1) [true, false] (cons true (cons false (blank))) from
      rep_rotate (a + 1) [true] [false, true] [true, false] rfl (cons false (blank))]
  have c5 : ∀ L R : Tape, steps 4 ⟨app [true, false] L, app [false] R, .F⟩ = some ⟨L, app [false] (app [true, true] R), .F⟩ := fun _ _ => rfl
  have h5 : steps ((a + 1) * 4) ⟨rep (a + 1) [true, false] (cons true (cons false (blank))), cons false (cons true (blank)), .F⟩ = some ⟨cons true (cons false (blank)), cons false (rep (a + 1) [true, true] (cons true (blank))), .F⟩ :=
    cross_l trans c5 (a + 1) (cons true (cons false (blank))) (cons true (blank))
  have h6 : steps 5 ⟨cons true (cons false (blank)), cons false (rep (a + 1) [true, true] (cons true (blank))), .F⟩ = some ⟨blank, cons false (cons true (cons true (cons true (rep (a + 1) [true, true] (cons true (blank)))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- One 1 left at the start of a round: the run reaches D on blank tape, which halts. -/
theorem l_rh (a : Nat) :
    steps (2 * a + 5) ⟨blank, cons false (cons true (rep (a + 1) [false, true] (cons true (blank)))), .C⟩ = some ⟨cons false (cons true (rep (a + 1) [false, true] (cons false (blank)))), blank, .D⟩ := by
  have hn : 1 + (0 + ((a + 1) * 2 + (2))) = 2 * a + 5 := by omega
  have h0 : steps 1 ⟨blank, cons false (cons true (rep (a + 1) [false, true] (cons true (blank)))), .C⟩ = some ⟨cons false (blank), cons true (rep (a + 1) [false, true] (cons true (blank))), .E⟩ := rfl
  have h1 : steps 0 ⟨cons false (blank), cons true (rep (a + 1) [false, true] (cons true (blank))), .E⟩ = some ⟨cons false (blank), rep (a + 1) [true, false] (cons true (cons true (blank))), .E⟩ := by
    simp only [steps_zero, show cons true (rep (a + 1) [false, true] (cons true (blank))) = rep (a + 1) [true, false] (cons true (cons true (blank))) from
      rep_rotate (a + 1) [true] [false, true] [true, false] rfl (cons true (blank))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .E⟩ = some ⟨app [] (app [false, true] L), R, .E⟩ := fun _ _ => rfl
  have h2 : steps ((a + 1) * 2) ⟨cons false (blank), rep (a + 1) [true, false] (cons true (cons true (blank))), .E⟩ = some ⟨rep (a + 1) [false, true] (cons false (blank)), cons true (cons true (blank)), .E⟩ :=
    cross_r trans c2 (a + 1) (cons false (blank)) (cons true (cons true (blank)))
  have h3 : steps 2 ⟨rep (a + 1) [false, true] (cons false (blank)), cons true (cons true (blank)), .E⟩ = some ⟨cons false (cons true (rep (a + 1) [false, true] (cons false (blank)))), blank, .D⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

