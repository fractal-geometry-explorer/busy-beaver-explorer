/-- A(x+1, 0) reaches A(x+1, 2). -/
theorem pc_a0 (x : Nat) :
    steps (6) ⟨rep (x + 1) [false, true] (blank), blank, .A⟩ = some ⟨cons true (cons true (cons false (cons true (rep (x) [false, true] (blank))))), blank, .A⟩ := by
  have h0 : steps 6 ⟨rep (x + 1) [false, true] (blank), blank, .A⟩ = some ⟨cons true (cons true (cons false (cons true (rep (x) [false, true] (blank))))), blank, .A⟩ := rfl
  exact steps_congr trans (a := 6) (by omega) (h0)

/-- A(0, 0), the blank tape, reaches A(0, 2). -/
theorem pc_a00 :
    steps (6) ⟨blank, blank, .A⟩ = some ⟨cons true (cons true (cons false (blank))), blank, .A⟩ := by
  have h0 : steps 6 ⟨blank, blank, .A⟩ = some ⟨cons true (cons true (cons false (blank))), blank, .A⟩ := rfl
  exact steps_congr trans (a := 6) (by omega) (h0)

/-- A(0, n+5) reaches E(2, n+3). -/
theorem pc_ones (n : Nat) :
    steps (n + 21) ⟨rep (n + 5) [true] (blank), blank, .A⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (rep (n + 2) [true] (cons false (blank)))))))), .E⟩ := by
  have h0 : steps 2 ⟨rep (n + 5) [true] (blank), blank, .A⟩ = some ⟨rep (n + 5) [true] (blank), cons true (cons false (blank)), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((n + 5) * 1) ⟨rep (n + 5) [true] (blank), cons true (cons false (blank)), .C⟩ = some ⟨blank, cons true (rep (n + 5) [true] (cons false (blank))), .C⟩ :=
    cross_l trans c1 (n + 5) (blank) (cons false (blank))
  have h2 : steps 14 ⟨blank, cons true (rep (n + 5) [true] (cons false (blank))), .C⟩ = some ⟨blank, cons false (cons true (cons false (cons true (cons false (cons true (rep (n + 2) [true] (cons false (blank)))))))), .E⟩ := rfl
  exact steps_congr trans (a := 2 + ((n + 5) * 1 + (14))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (h2)))

