import Pieces
import Norm

/-!
# 1RB0RC_1LC1RE_1RA1LD_0LC0LA_1RF1RD_---0RD: the frame map

Configurations (blank tape around, `S>` the head in state S on the next cell):
* `z`: `1^L 10^j C 1^R`
* `y`: `1^L A 10 10^j 1^R`
* `w`: `1^L C 00 10^j 1^R`
* `u`: `1^L 10^j 1 A 00 1^R`
* `Z`: `1110 1^L 10^j C 1^R`
* `Y`: `1110 1^L A 10 10^j 1^R`
* `W`: `1110 1^L C 00 10^j 1^R`
* `U`: `1110 1^L 10^j 1 A 00 1^R`

`next` sends each one to the next frame the machine reaches; `next_sound` proves every case for all parameters
(one symbolic run of `Pieces.lean` each, generated by `py/pieces.py`, glued by `tape_eq`).  Where `next` is `none`
the machine halts (`none_halts`).  The run from blank tape reaches `Ph.z 0 0 2` after 2 steps (`init_start`).
So the machine halts from blank tape iff the orbit of `Ph.z 0 0 2` under `next` reaches a phase where `next` is
`none` (`halts_iff`); `no_halt_phases` checks the first 100000000 phases by `native_decide`.
-/

namespace H97525

open TM

/-- `1^L 10^j C 1^R`. -/
def Frz (l j r : Nat) : Config := ⟨rep j [false, true] (rep l [true] (blank)), rep r [true] (blank), .C⟩

/-- `1^L A 10 10^j 1^R`. -/
def Fry (l j r : Nat) : Config := ⟨rep l [true] (blank), cons true (cons false (rep j [true, false] (rep r [true] (blank)))), .A⟩

/-- `1^L C 00 10^j 1^R`. -/
def Frw (l j r : Nat) : Config := ⟨rep l [true] (blank), cons false (cons false (rep j [true, false] (rep r [true] (blank)))), .C⟩

/-- `1^L 10^j 1 A 00 1^R`. -/
def Fru (l j r : Nat) : Config := ⟨cons true (rep j [false, true] (rep l [true] (blank))), cons false (cons false (rep r [true] (blank))), .A⟩

/-- `1110 1^L 10^j C 1^R`. -/
def FrZ (l j r : Nat) : Config := ⟨rep j [false, true] (rep l [true] (cons false (cons true (cons true (cons true (blank)))))), rep r [true] (blank), .C⟩

/-- `1110 1^L A 10 10^j 1^R`. -/
def FrY (l j r : Nat) : Config := ⟨rep l [true] (cons false (cons true (cons true (cons true (blank))))), cons true (cons false (rep j [true, false] (rep r [true] (blank)))), .A⟩

/-- `1110 1^L C 00 10^j 1^R`. -/
def FrW (l j r : Nat) : Config := ⟨rep l [true] (cons false (cons true (cons true (cons true (blank))))), cons false (cons false (rep j [true, false] (rep r [true] (blank)))), .C⟩

/-- `1110 1^L 10^j 1 A 00 1^R`. -/
def FrU (l j r : Nat) : Config := ⟨cons true (rep j [false, true] (rep l [true] (cons false (cons true (cons true (cons true (blank))))))), cons false (cons false (rep r [true] (blank))), .A⟩

/-- A frame. -/
inductive Ph where
  | z (l j r : Nat)
  | y (l j r : Nat)
  | w (l j r : Nat)
  | u (l j r : Nat)
  | Z (l j r : Nat)
  | Y (l j r : Nat)
  | W (l j r : Nat)
  | U (l j r : Nat)
  deriving DecidableEq, Repr

def Ph.cfg : Ph → Config
  | .z l j r => Frz l j r
  | .y l j r => Fry l j r
  | .w l j r => Frw l j r
  | .u l j r => Fru l j r
  | .Z l j r => FrZ l j r
  | .Y l j r => FrY l j r
  | .W l j r => FrW l j r
  | .U l j r => FrU l j r

/-- The frame map. -/
def next : Ph → Option Ph
  | .z 0 0 0 => some (.w (0) (0) (4))
  | .z (l + 1) 0 0 => some (.y (l) (0) (2))
  | .z l (j + 1) 0 => some (.u (l) (j) (2))
  | .z 0 0 (r + 1) => some (.w (0) (0) (r + 1))
  | .z 0 (j + 1) (r + 1) => some (.w (0) (j + 1) (r + 1))
  | .z 1 0 (r + 1) => some (.w (0) (0) (r + 3))
  | .z 1 1 1 => none
  | .z 1 1 2 => some (.Y (1) (0) (1))
  | .z 1 1 3 => some (.U (2) (0) (2))
  | .z 1 1 (r + 4) => some (.Y (3) (0) (r + 1))
  | .z 1 2 1 => some (.Z (4) (0) (0))
  | .z 1 2 2 => some (.Y (2) (0) (2))
  | .z 1 2 (r + 3) => some (.U (3) (0) (r + 1))
  | .z 1 (j + 3) (r + 1) => some (.W (4) (j) (r + 1))
  | .z (l + 2) 0 (r + 1) => some (.y (l) (0) (r + 1))
  | .z (l + 2) (j + 1) (r + 1) => some (.y (l) (j + 1) (r + 1))
  | .y 0 0 0 => some (.w (0) (0) (4))
  | .y 0 (j + 1) 0 => some (.u (0) (j) (2))
  | .y 0 j 1 => some (.u (0) (j) (2))
  | .y 0 j (r + 2) => some (.z (0) (j + 1) (r + 1))
  | .y (l + 1) 0 0 => some (.u (l) (0) (2))
  | .y (l + 1) (j + 1) 0 => some (.u (l) (j + 1) (2))
  | .y (l + 1) j 1 => some (.u (l) (j + 1) (2))
  | .y (l + 1) j (r + 2) => some (.z (l) (j + 2) (r + 1))
  | .w 0 0 0 => some (.w (0) (0) (4))
  | .w (l + 1) 0 0 => some (.y (l) (0) (2))
  | .w l 0 1 => none
  | .w l 0 2 => some (.y (l + 1) (0) (1))
  | .w l 0 3 => some (.u (l + 2) (0) (2))
  | .w l 0 (r + 4) => some (.y (l + 3) (0) (r + 1))
  | .w l 1 0 => none
  | .w l 1 1 => some (.z (l + 4) (0) (0))
  | .w l 1 2 => some (.y (l + 2) (0) (2))
  | .w l 1 (r + 3) => some (.u (l + 3) (0) (r + 1))
  | .w l 2 0 => some (.z (l + 4) (0) (0))
  | .w l (j + 3) 0 => some (.w (l + 4) (j) (1))
  | .w l (j + 2) (r + 1) => some (.w (l + 4) (j) (r + 1))
  | .u 0 0 r => some (.w (0) (0) (r + 4))
  | .u (l + 1) 0 r => some (.y (l) (0) (r + 2))
  | .u l (j + 1) r => some (.u (l) (j) (r + 2))
  | .Z 0 0 0 => some (.u (2) (0) (2))
  | .Z 0 (j + 1) 0 => some (.u (2) (j + 1) (2))
  | .Z 0 0 (r + 1) => some (.y (0) (1) (r + 1))
  | .Z 0 (j + 1) (r + 1) => some (.y (0) (j + 2) (r + 1))
  | .Z (l + 1) 0 0 => some (.Y (l) (0) (2))
  | .Z (l + 1) (j + 1) 0 => some (.U (l + 1) (j) (2))
  | .Z 1 0 (r + 1) => some (.u (2) (0) (r + 1))
  | .Z 1 (j + 1) (r + 1) => some (.y (5) (j + 1) (r + 1))
  | .Z (l + 2) 0 (r + 1) => some (.Y (l) (0) (r + 1))
  | .Z (l + 2) (j + 1) (r + 1) => some (.Y (l) (j + 1) (r + 1))
  | .Y 0 j 0 => some (.y (0) (1) (2 * j + 4))
  | .Y 0 j 1 => some (.y (0) (1) (2 * j + 6))
  | .Y 0 j (r + 2) => some (.w (3) (j + 1) (r + 1))
  | .Y 1 0 0 => some (.u (2) (1) (2))
  | .Y 1 (j + 1) 0 => some (.u (2) (j + 2) (2))
  | .Y 1 j 1 => some (.u (2) (j + 2) (2))
  | .Y 1 j (r + 2) => some (.z (2) (j + 3) (r + 1))
  | .Y (l + 2) 0 0 => some (.U (l + 1) (0) (2))
  | .Y (l + 2) (j + 1) 0 => some (.U (l + 1) (j + 1) (2))
  | .Y (l + 2) j 1 => some (.U (l + 1) (j + 1) (2))
  | .Y (l + 2) j (r + 2) => some (.Z (l + 1) (j + 2) (r + 1))
  | .W 0 0 0 => some (.u (2) (0) (2))
  | .W (l + 1) 0 0 => some (.Y (l) (0) (2))
  | .W l 0 1 => none
  | .W l 0 2 => some (.Y (l + 1) (0) (1))
  | .W l 0 3 => some (.U (l + 2) (0) (2))
  | .W l 0 (r + 4) => some (.Y (l + 3) (0) (r + 1))
  | .W l 1 0 => none
  | .W l 1 1 => some (.Z (l + 4) (0) (0))
  | .W l 1 2 => some (.Y (l + 2) (0) (2))
  | .W l 1 (r + 3) => some (.U (l + 3) (0) (r + 1))
  | .W l 2 0 => some (.Z (l + 4) (0) (0))
  | .W l (j + 3) 0 => some (.W (l + 4) (j) (1))
  | .W l (j + 2) (r + 1) => some (.W (l + 4) (j) (r + 1))
  | .U 0 0 r => some (.u (2) (0) (r + 2))
  | .U 0 (j + 1) r => some (.u (2) (j + 1) (r + 2))
  | .U (l + 1) 0 r => some (.Y (l) (0) (r + 2))
  | .U (l + 1) (j + 1) r => some (.U (l + 1) (j) (r + 2))

macro "piece" t:term:max : tactic =>
  `(tactic| focus
    simp only [next, Option.some.injEq] at *
    subst_vars
    simp only [Ph.cfg, Frz, Fry, Frw, Fru, FrZ, FrY, FrW, FrU]
    refine ⟨_, ?_, steps_eq_of ($t) (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))⟩
    omega)

macro "piece2" t:term:max u:term:max : tactic =>
  `(tactic| focus
    simp only [next, Option.some.injEq] at *
    subst_vars
    simp only [Ph.cfg, Frz, Fry, Frw, Fru, FrZ, FrY, FrW, FrU]
    refine ⟨_, ?_, steps_eq_of (steps_seq trans ($t) (steps_eq_of ($u) (cfg_eq (by tape_eq) (by tape_eq)) rfl))
      (cfg_eq (by tape_eq) (by tape_eq)) (cfg_eq (by tape_eq) (by tape_eq))⟩
    omega)

macro "hpiece" t:term:max : tactic =>
  `(tactic| focus
    simp only [Ph.cfg, Frz, Fry, Frw, Fru, FrZ, FrY, FrW, FrU]
    exact ⟨_, _, steps_eq_of ($t) (cfg_eq (by tape_eq) (by tape_eq)) rfl, rfl⟩)

theorem next_sound : ∀ p p', next p = some p' → ∃ n, 0 < n ∧ steps n p.cfg = some p'.cfg
  | .z 0 0 0, _, h => by piece pc_z0
  | .z (l + 1) 0 0, _, h => by piece (pc_z1 l)
  | .z l (j + 1) 0, _, h => by piece (pc_z2 j l)
  | .z 0 0 (r + 1), _, h => by piece (pc_z3a r)
  | .z 0 (j + 1) (r + 1), _, h => by piece (pc_z3b j r)
  | .z 1 0 (r + 1), _, h => by piece (pc_z4 r)
  | .z 1 1 1, _, h => by simp [next] at h
  | .z 1 1 2, _, h => by piece pc_z6
  | .z 1 1 3, _, h => by piece pc_z7
  | .z 1 1 (r + 4), _, h => by piece (pc_z8 r)
  | .z 1 2 1, _, h => by piece pc_z9
  | .z 1 2 2, _, h => by piece pc_z10
  | .z 1 2 (r + 3), _, h => by piece (pc_z11 r)
  | .z 1 (j + 3) (r + 1), _, h => by piece (pc_z12 j r)
  | .z (l + 2) 0 (r + 1), _, h => by piece (pc_z13a l r)
  | .z (l + 2) (j + 1) (r + 1), _, h => by piece (pc_z13b j l r)
  | .y 0 0 0, _, h => by piece pc_y0
  | .y 0 (j + 1) 0, _, h => by piece2 (pc_y1 j) (pc_y1z j)
  | .y 0 j 1, _, h => by piece (pc_y2 j)
  | .y 0 j (r + 2), _, h => by piece (pc_y3 j r)
  | .y (l + 1) 0 0, _, h => by piece (pc_y4a l)
  | .y (l + 1) (j + 1) 0, _, h => by piece2 (pc_y4b j l) (pc_y4bz j l)
  | .y (l + 1) j 1, _, h => by piece (pc_y5 j l)
  | .y (l + 1) j (r + 2), _, h => by piece (pc_y6 j l r)
  | .w 0 0 0, _, h => by piece pc_w0
  | .w (l + 1) 0 0, _, h => by piece (pc_w1 l)
  | .w l 0 1, _, h => by simp [next] at h
  | .w l 0 2, _, h => by piece (pc_w3 l)
