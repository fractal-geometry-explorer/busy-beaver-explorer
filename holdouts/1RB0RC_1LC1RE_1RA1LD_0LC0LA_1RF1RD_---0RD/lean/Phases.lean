  | .w l 1 0, _, h => by simp [next] at h
  | .w l 1 1, _, h => by piece (pc_w7 l)
  | .w l 1 2, _, h => by piece (pc_w8 l)
  | .w l 1 (r + 3), _, h => by piece (pc_w9 l r)
  | .w l 2 0, _, h => by piece (pc_w10 l)
  | .w l (j + 3) 0, _, h => by piece (pc_w11 j l)
  | .w l (j + 2) (r + 1), _, h => by piece (pc_w12 j l r)
  | .u 0 0 r, _, h => by piece (pc_u0 r)
  | .u (l + 1) 0 r, _, h => by piece (pc_u1 l r)
  | .u l (j + 1) r, _, h => by piece (pc_u2 j l r)
  | .Z 0 0 0, _, h => by piece pc_Z0a
  | .Z 0 (j + 1) 0, _, h => by piece (pc_Z0b j)
  | .Z 0 0 (r + 1), _, h => by piece (pc_Z1a r)
  | .Z 0 (j + 1) (r + 1), _, h => by piece (pc_Z1b j r)
  | .Z (l + 1) 0 0, _, h => by piece (pc_Z2 l)
  | .Z (l + 1) (j + 1) 0, _, h => by piece (pc_Z3 j l)
  | .Z 1 0 (r + 1), _, h => by piece (pc_Z4 r)
  | .Z 1 (j + 1) (r + 1), _, h => by piece (pc_Z5 j r)
  | .Z (l + 2) 0 (r + 1), _, h => by piece (pc_Z6a l r)
  | .Z (l + 2) (j + 1) (r + 1), _, h => by piece (pc_Z6b j l r)
  | .Y 0 j 0, _, h => by piece (pc_Y0 j)
  | .Y 0 j 1, _, h => by piece (pc_Y1 j)
  | .Y 0 j (r + 2), _, h => by piece (pc_Y2 j r)
  | .Y 1 0 0, _, h => by piece pc_Y3a
  | .Y 1 (j + 1) 0, _, h => by piece2 (pc_Y3b j) (pc_Y3bz j)
  | .Y 1 j 1, _, h => by piece (pc_Y4 j)
  | .Y 1 j (r + 2), _, h => by piece (pc_Y5 j r)
