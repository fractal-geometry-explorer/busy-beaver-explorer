    iter_cast (y_zigzag (0) (s + 6) (p + 1) (2 * m)) (by omega) (by congr 1 <;> omega) (by congr 1 <;> omega)
  have h1 : iter 1 (.y (0) (2 * p + 2 * m + 2) (s + 7)) = some (.z (0) (2 * p + 2 * m + 3) (s + 6)) := iter_one (by simp [next])
  have h2 : iter 1 (.z (0) (2 * p + 2 * m + 3) (s + 6)) = some (.w (0) (2 * p + 2 * m + 3) (s + 6)) := iter_one (by simp [next])
  have h3 : iter (p + m + 1) (.w (0) (2 * p + 2 * m + 3) (s + 6)) = some (.w (4 * p + 4 * m + 4) (1) (s + 6)) :=
    iter_cast (w_sweep (0) (1) (s + 5) (p + m + 1)) (by omega) (by congr 1 <;> omega) (by congr 1 <;> omega)
  have h4 : iter 1 (.w (4 * p + 4 * m + 4) (1) (s + 6)) = some (.u (4 * p + 4 * m + 7) (0) (s + 4)) := iter_one (by simp [next])
  have h5 : iter 1 (.u (4 * p + 4 * m + 7) (0) (s + 4)) = some (.y (4 * p + 4 * m + 6) (0) (s + 6)) := iter_one (by simp [next])
  exact iter_cast (iter_trans (iter_trans (iter_trans (iter_trans (iter_trans (h0) h1) h2) h3) h4) h5) (by omega) rfl rfl

