def near : Ph → Res
  | .y a j r => nearY a j r
  | .Y a j r => nearYY a j r
  | _ => .off

/-- The closed pass map. -/
def cpass (p : Ph) : Res :=
  match fast p with
  | some (q, n) => .go q n
  | none => near p

