        rw [hf] at h; simp only [near] at h; unfold nearY at h
        by_cases hc : 3 ≤ a ∧ 2 ≤ r
        · rw [ite_eq_left_of_eq_true _ _ (eq_true hc)] at h
          by_cases hc : a % 3 = 0
