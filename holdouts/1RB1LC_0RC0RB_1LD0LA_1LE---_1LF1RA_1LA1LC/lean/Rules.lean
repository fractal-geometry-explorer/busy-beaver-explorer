import Machine

/-! The tick rules of the two counters (generated by the family's py/gen_rules.py).

Left of the head: the counter U, digits `00000` (0) and `00001` (1), least significant next to the gap; right of the header: the counter V, pairs `11` (0) and `01` (1), least significant first. Every tick adds 1 to U and takes 1 from V, for every number of carries j and borrows i + 1, and every tape L, R beyond them. -/

namespace H15053

open TM

/-- Tick (gap `00`, header `0110101`), V odd: U = x0 1^j becomes x1 0^j (j carries), V loses its lowest 1. -/
theorem tick0_odd (j : Nat) (L R : Tape) :
    steps (10 * j + 38) ⟨cons false (cons false (rep (j) [true, false, false, false, false] (cons false (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ = some ⟨cons false (cons false (rep (j) [false, false, false, false, false] (cons true (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons true (R))))))))), .D⟩ := by
  have h0 : steps 0 ⟨cons false (cons false (rep (j) [true, false, false, false, false] (cons false (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ = some ⟨rep (j) [false, false, true, false, false] (cons false (cons false (cons false (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ := by
    simp only [steps_zero, show cons false (cons false (rep (j) [true, false, false, false, false] (cons false (cons false (cons false (cons false (cons false (L)))))))) = rep (j) [false, false, true, false, false] (cons false (cons false (cons false (cons false (cons false (cons false (cons false (L)))))))) from
      rep_rotate (j) [false, false] [true, false, false, false, false] [false, false, true, false, false] rfl (cons false (cons false (cons false (cons false (cons false (L))))))]
  have c1 : ∀ L R : Tape, steps 5 ⟨app [false, false, true, false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, true, true, true, true] R), .D⟩ := fun _ _ => rfl
  have h1 : steps ((j) * 5) ⟨rep (j) [false, false, true, false, false] (cons false (cons false (cons false (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))), .D⟩ = some ⟨cons false (cons false (cons false (cons false (cons false (cons false (cons false (L))))))), cons false (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .D⟩ :=
    cross_l trans c1 (j) (cons false (cons false (cons false (cons false (cons false (cons false (cons false (L)))))))) (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))
  have h2 : steps 4 ⟨cons false (cons false (cons false (cons false (cons false (cons false (cons false (L))))))), cons false (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))), .D⟩ = some ⟨cons true (cons false (cons false (cons false (cons false (L))))), cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ := rfl
  have h3 : steps 0 ⟨cons true (cons false (cons false (cons false (cons false (L))))), cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ = some ⟨cons true (cons false (cons false (cons false (cons false (L))))), rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))) = rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))) from
      rep_rotate (j) [true, true, true] [true, true, true, true, true] [true, true, true, true, true] rfl (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))]
  have c4 : ∀ L R : Tape, steps 5 ⟨app [] L, app [true, true, true, true, true] R, .B⟩ = some ⟨app [] (app [false, false, false, false, false] L), R, .B⟩ := fun _ _ => rfl
  have h4 : steps ((j) * 5) ⟨cons true (cons false (cons false (cons false (cons false (L))))), rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ = some ⟨rep (j) [false, false, false, false, false] (cons true (cons false (cons false (cons false (cons false (L)))))), cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))), .B⟩ :=
    cross_r trans c4 (j) (cons true (cons false (cons false (cons false (cons false (L)))))) (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))))
  have h5 : steps 30 ⟨rep (j) [false, false, false, false, false] (cons true (cons false (cons false (cons false (cons false (L)))))), cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (R))))))))))), .B⟩ = some ⟨cons true (cons true (cons false (cons false (cons false (cons false (rep (j) [false, false, false, false, false] (cons true (cons false (cons false (cons false (cons false (L)))))))))))), cons true (cons false (cons true (cons true (cons true (R))))), .A⟩ := rfl
  have h6 : steps 4 ⟨cons true (cons true (cons false (cons false (cons false (cons false (rep (j) [false, false, false, false, false] (cons true (cons false (cons false (cons false (cons false (L)))))))))))), cons true (cons false (cons true (cons true (cons true (R))))), .A⟩ = some ⟨cons false (cons false (rep (j) [false, false, false, false, false] (cons true (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons true (cons true (R))))))))), .D⟩ := rfl
  exact steps_congr trans (a := 0 + ((j) * 5 + (4 + (0 + ((j) * 5 + (30 + (4))))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

