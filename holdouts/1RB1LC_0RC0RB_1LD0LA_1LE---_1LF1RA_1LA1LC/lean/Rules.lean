  have h3 : steps 0 ⟨cons true (cons false (cons false (cons false (cons false (L))))), cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (rep (i + 1) [true, true] (cons false (cons true (R))))))))))))), .B⟩ = some ⟨cons true (cons false (cons false (cons false (cons false (L))))), rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (rep (i + 1) [true, true] (cons false (cons true (R))))))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (cons true (cons true (rep (j) [true, true, true, true, true] (cons true (cons true (cons false (cons true (cons true (cons true (rep (i + 1) [true, true] (cons false (cons true (R))))))))))))) = rep (j) [true, true, true, true, true] (cons true (cons true (cons true (cons true (cons true (cons false (cons true (cons true (cons true (rep (i + 1) [true, true] (cons false (cons true (R))))))))))))) from
