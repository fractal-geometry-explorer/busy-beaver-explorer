/-- Tick (gap `00`, header `0110111`), V with i+1 trailing zeros: U + 1 with j carries, V - 1 with i+1 borrows. -/
theorem tick1_even (i j : Nat) (L R : Tape) :
    steps (8 * i + 10 * j + 46) ⟨cons false (cons false (rep (j) [true, false, false, false, false] (cons false (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons true (cons true (rep (i + 1) [true, true] (cons false (cons true (R)))))))))), .D⟩ = some ⟨cons false (cons false (rep (j) [false, false, false, false, false] (cons true (cons false (cons false (cons false (cons false (L)))))))), cons false (cons true (cons true (cons false (cons true (cons true (cons true (rep (i + 1) [false, true] (cons true (cons true (R)))))))))), .D⟩ := by
