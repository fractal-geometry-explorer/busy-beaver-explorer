import Machine

/-! # Shift rules of 1RB0LC_1LC0RB_0LE0LD_1LC---_0RA1LF_1LA1LF

The four passes of the machine over the two regular parts of its tape: B moving right over the six-cell word
`011101` (`pass_right_b`) and over `1001` (`pass_right_a`), C moving left over `000101` (`pass_left_b`) and E moving
left over `1010` (`pass_left_a`).  The only halt is D reading a 1; D is entered only from C reading a 1, so `1 C> 1`
halts after two steps (`halt_C`).

Generated by `py/rules.py` from symbolic runs (`tools/py/bbtools/symtm.py`); every proof is `rfl` steps, the
crossing lemmas `TM.cross_r`/`TM.cross_l` and `omega`, checked by Lean's kernel. -/

namespace H25358

open TM

/-- Moving right over the periodic right part, 14 steps a word: `011101` becomes `010001`. -/
theorem pass_right_b (n : Nat) (L R : Tape) :
    steps (14 * n) ⟨cons false (cons false (L)), rep (n) [false, true, true, true, false, true] (R), .B⟩ = some ⟨cons false (cons false (rep (n) [true, false, false, false, true, false] (L))), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 14 ⟨app [false, false] L, app [false, true, true, true, false, true] R, .B⟩ = some ⟨app [false, false] (app [true, false, false, false, true, false] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 14) ⟨cons false (cons false (L)), rep (n) [false, true, true, true, false, true] (R), .B⟩ = some ⟨cons false (cons false (rep (n) [true, false, false, false, true, false] (L))), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 14) (by omega) (h0)

/-- Moving left over the right part, 10 steps a word: `000101` becomes `101110`. -/
theorem pass_left_b (n : Nat) (L R : Tape) :
    steps (10 * n) ⟨rep (n) [true, false, true, false, false, false] (L), cons false (R), .C⟩ = some ⟨L, cons false (rep (n) [true, false, true, true, true, false] (R)), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 10 ⟨app [true, false, true, false, false, false] L, app [false] R, .C⟩ = some ⟨L, app [false] (app [true, false, true, true, true, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 10) ⟨rep (n) [true, false, true, false, false, false] (L), cons false (R), .C⟩ = some ⟨L, cons false (rep (n) [true, false, true, true, true, false] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 10) (by omega) (h0)

/-- Moving right over the `0011` blocks of the left part, 20 steps a word. -/
theorem pass_right_a (n : Nat) (L R : Tape) :
    steps (20 * n) ⟨cons false (cons false (L)), rep (n) [true, false, false, true] (R), .B⟩ = some ⟨cons false (cons false (rep (n) [false, true, false, true] (L))), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 20 ⟨app [false, false] L, app [true, false, false, true] R, .B⟩ = some ⟨app [false, false] (app [false, true, false, true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 20) ⟨cons false (cons false (L)), rep (n) [true, false, false, true] (R), .B⟩ = some ⟨cons false (cons false (rep (n) [false, true, false, true] (L))), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 20) (by omega) (h0)

/-- Moving left over the left part, E turns each `1010` back into `0011`. -/
theorem pass_left_a (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨rep (n) [false, true, false, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [false, false, true, true] (R)), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, false, true, true] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨rep (n) [false, true, false, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [false, false, true, true] (R)), .E⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 4) (by omega) (h0)

/-- `1 C> 1` halts: C writes a 0 and steps left in state D onto a 1, which has no transition. -/
theorem halt_C (L R : Tape) :
    ∃ c, steps 1 ⟨cons true L, cons true R, .C⟩ = some c ∧ step c = none :=
  ⟨_, rfl, rfl⟩

end H25358
