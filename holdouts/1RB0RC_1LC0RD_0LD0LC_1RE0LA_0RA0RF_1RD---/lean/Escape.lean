/-! Halting corollaries for 1RB0RC_1LC0RD_0LD0LC_1RE0LA_0RA0RF_1RD---, generated by `rules.py escape`; do not edit by hand.

`trap_halts`: from the head in D on `b^(k+1) 1 0 1 1`, whatever follows, the machine halts (rule `trap` of
`Rules.lean`): the transient gadget `10` meeting a gadget across an empty block is fatal.  `witness_halts`: from the
head in D on `b^6 g4 b^5 g4 b^2 g0 b^2 g0` (b = 1000; a tape of the regular gadgets only, every block of length >= 2) the machine
halts after 3,268 steps.  So the tape language "regular gadgets with arbitrary block lengths" contains halting
configurations, and no invariant on gadget shapes alone can prove that the machine does not halt. -/

namespace H172498

open TM

/-- From the head in D on `b^(k+1) 1 0 1 1`, whatever follows, the machine halts. -/
theorem trap_halts (k : Nat) (R : Tape) :
    TM.Halts trans (⟨blank, rep (k + 1) [true, false, false, false] (cons true (cons false (cons true (cons true (R))))), .D⟩ : Config) :=
  ⟨_, _, trap k R, (step_none_iff _).2 ⟨rfl, rfl⟩⟩

/-- `n` list steps end in a configuration that halts. -/
def haltsAt (n : Nat) (c : FCfg St) : Bool :=
  match TM.fsteps trans n c with
  | some c' => (TM.fstep trans c').isNone
  | none => false

theorem halts_of_haltsAt {n : Nat} {c : FCfg St} (h : haltsAt n c = true) : TM.Halts trans c.toCfg := by
  unfold haltsAt at h
  split at h
  next c' e =>
    refine ⟨n, c'.toCfg, by rw [FCfg.steps_eq trans, e]; rfl, ?_⟩
    rw [FCfg.step_eq trans]
    cases e' : TM.fstep trans c' with
    | none => rfl
    | some _ => rw [e'] at h; cases h
  next => cases h

/-- The witness tape `b^6 g4 b^5 g4 b^2 g0 b^2 g0`, as a list of cells. -/
def witnessTape : List Bool := [true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, true, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, true, false, true, false, false, false, true, false, false, false, true, false, false, true, true, false, false, false, true, false, false, false, true, false, false, true]

/-- From the head in D on `b^6 g4 b^5 g4 b^2 g0 b^2 g0` (a tape of regular gadgets, every block of length >= 2) the machine halts,
after 3,268 steps; checked by Lean's kernel. -/
theorem witness_halts : TM.Halts trans (⟨blank, app witnessTape blank, .D⟩ : Config) :=
  halts_of_haltsAt (n := 3268) (c := ⟨[], witnessTape, .D⟩) (by decide +kernel)

