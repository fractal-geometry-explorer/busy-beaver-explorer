import Full

/-!
# The complete macro map of 1RB1RF_1LC1RE_0LD0LC_1RD0RB_1RA0RB_1RA---

Generated by `py/gen_sim.py` in the folder of 1RB0RF_1LC1RE_0LD0LC_1RD0RB_1RA0RB_0LC---; do not edit by hand.

`Full.lean` has a *partial* macro map `astep`: the regular Q-steps in closed form (the word goes to `phi (phi W)`,
the counter adds one), the anomalies with a wide counter, and the collisions in the rows of `coll`.  It returns
`none` on the other irregular steps, which for this machine have too many cases for a finite table.

Here the gap is closed by a step that every machine can take: `tstep` writes the Q configuration as a finite
list tape (`fenc`), runs the machine on it cell by cell until the next Q configuration (`simQ`, at most `fuel`
steps), reads that configuration back (`decode`, unverified) and checks that its tape is the tape the machine
reached (`trim`, equal up to blank cells).  Only the check is trusted, so `tstep_sound` holds for any `decode`.

`mstep` is `astep` where `astep` applies and `tstep` elsewhere.  It is defined on every Q configuration the run
meets as long as each irregular stretch ends at a Q configuration within `fuel` steps (in the simulated run it
takes at most a few times 10^4 steps).  So:

* `mstep_sound`: each step of `mstep` is at least one step of the machine;
* `not_halts_of_mrun`: if the iterated `mstep` never fails from the configuration at step 27, the machine never
  halts from blank tape.

The six machines of the family share the regular part of the map; they differ in which irregular steps are
closed forms and in what the simulated stretches do.
-/

namespace H65140

open TM

/-! ## The tape of a Q configuration as finite lists -/

/-- The cells of `wl W` (last block first, nearest cell first), up to blank tape. -/
def wcells : List Nat → List Bool
  | [] => []
  | b :: W => List.replicate b true ++ false :: wcells W

/-- The cells of `gl G`, up to blank tape. -/
def gcells : List Nat → List Bool
  | [] => []
  | g :: G => List.replicate g false ++ true :: gcells G

theorem app_replicate (n : Nat) (b : Bool) (X : List Bool) (s : Tape) :
    app (List.replicate n b ++ X) s = rep n [b] (app X s) := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [List.replicate_succ, List.cons_append, app, ih, rep_succ]

theorem app_replicate3 (a : Nat) (X : List Bool) (s : Tape) :
    app (List.replicate (3 * a) true ++ X) s = rep a [true, true, true] (app X s) := by
  rw [app_replicate, rep_mul3]; rfl

theorem app_wcells : ∀ W : List Nat, app (wcells W) blank = wl W
  | [] => rfl
  | b :: W => by simp only [wcells, app_replicate, app, app_wcells W, wl]

theorem app_gcells : ∀ G : List Nat, app (gcells G) blank = gl G
  | [] => rfl
  | g :: G => by simp only [gcells, app_replicate, app, app_gcells G, gl]

/-- The finite form of `qr W a G`. -/
def fenc (c : AC) : FCfg St :=
  ⟨List.replicate (3 * c.a) true ++ false :: wcells c.W, false :: gcells c.G, .B⟩

theorem fenc_toCfg (c : AC) : (fenc c).toCfg = c.enc := by
  simp only [fenc, FCfg.toCfg, AC.enc, qr, app_replicate3, app, app_wcells, app_gcells]

/-! ## Equal up to blank cells -/

/-- Drop the trailing `false`s. -/
def trim : List Bool → List Bool
  | [] => []
  | b :: l =>
    match b, trim l with
    | false, [] => []
    | b, t => b :: t

theorem app_trim : ∀ l : List Bool, app (trim l) blank = app l blank
  | [] => rfl
  | b :: l => by
    have ih := app_trim l
    cases b with
    | false =>
      cases h : trim l with
      | nil => simp only [trim, h, app]; rw [← ih, h]; exact cons_false_blank.symm
      | cons x t => simp only [trim, h, app]; rw [← ih, h]; rfl
    | true => simp only [trim, app]; rw [← ih]

/-! ## Reading a Q configuration back (unverified) -/

/-- Leading `true`s: their number and the rest. -/
def ones1 : List Bool → Nat × List Bool
  | true :: l => match ones1 l with
    | (n, r) => (n + 1, r)
  | l => (0, l)

/-- Parse a word: blocks separated by single `false`s, then only `false`s.  Last block (nearest) first. -/
def pword (fuel : Nat) (l : List Bool) : Option (List Nat) :=
  match fuel with
  | 0 => none
  | f + 1 =>
    let (b, r) := ones1 l
    if b = 0 then none else
    match r with
    | [] => some [b]
    | [false] => some [b]
    | false :: false :: r' => if r'.all (· = false) then some [b] else none
    | false :: r' =>
      match pword f r' with
      | some W => some (b :: W)
      | none => none
    | _ => none

/-- Parse gaps: `0^g 1` repeated, then only `false`s. -/
def pgaps (fuel : Nat) (r : List Bool) : Option (List Nat) :=
  match fuel with
  | 0 => none
  | f + 1 =>
    let g := (r.takeWhile (· = false)).length
    match r.drop g with
    | [] => some []
    | true :: r' => (pgaps f r').map (g :: ·)
    | _ => none

/-- All blocks but the first of the word (the last of the list) odd. -/
def oddButFirst : List Nat → Bool
  | [] => true
  | [_] => true
  | b :: W => b % 2 == 1 && oddButFirst W

/-- A Q configuration as `c/trans.c` finds them: state B on a 0, `1^(3a) 0` to its left with `a ≥ 1`, then a word
of at least two blocks, all but the first odd. -/
def decode (d : FCfg St) : Option AC :=
  if d.st = .B ∧ d.r.headD false = false ∧ d.l.headD false = true then
    let (m, l1) := ones1 d.l
    if m % 3 = 0 then
      match l1 with
      | false :: l2 =>
        match pword (l2.length + 1) l2 with
        | some W =>
          if 2 ≤ W.length ∧ oddButFirst W then
            (pgaps (d.r.length + 1) d.r.tail).map fun G => ⟨W, m / 3, G⟩
          else none
        | none => none
      | _ => none
    else none
  else none

/-! ## Running to the next Q configuration -/

/-- Step until `decode` succeeds, at most `fuel` steps; the number of steps and the configuration. -/
def simQ : Nat → Nat → FCfg St → Option (Nat × FCfg St)
  | 0, _, _ => none
  | f + 1, k, c =>
    match fstep c with
    | none => none
    | some d => if (decode d).isSome then some (k + 1, d) else simQ f (k + 1) d

theorem simQ_spec : ∀ (f k : Nat) (c : FCfg St) (n : Nat) (d : FCfg St), simQ f k c = some (n, d) →
    k + 1 ≤ n ∧ fsteps (n - k) c = some d
  | 0, _, _, _, _, h => by simp [simQ] at h
  | f + 1, k, c, n, d, h => by
    simp only [simQ] at h
    cases e : fstep c with
    | none => rw [e] at h; cases h
    | some d1 =>
      rw [e] at h
      simp only at h
      by_cases hd : (decode d1).isSome
      · simp only [hd, ite_true, Option.some.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        refine ⟨Nat.le_refl _, ?_⟩
        rw [show k + 1 - k = 0 + 1 by omega]
        simp only [fsteps, TM.fsteps, e]
      · simp only [hd, ite_false, Bool.false_eq_true] at h
        obtain ⟨h1, h2⟩ := simQ_spec f (k + 1) d1 n d h
        refine ⟨by omega, ?_⟩
        rw [show n - k = (n - (k + 1)) + 1 by omega]
        simp only [fsteps, TM.fsteps] at h2 ⊢
        simp only [fstep] at e
        rw [e]; exact h2

/-- The step limit of one simulated stretch. -/
def fuel : Nat := 100000000

/-- The next Q configuration by direct simulation, checked. -/
def tstep (c : AC) : Option AC :=
  match simQ fuel 0 (fenc c) with
  | some (_, d) =>
    match decode d with
    | some c' =>
      if trim (fenc c').l = trim d.l ∧ trim (fenc c').r = trim d.r ∧ (fenc c').st = d.st then some c' else none
    | none => none
  | none => none

theorem tstep_sound (c c' : AC) (h : tstep c = some c') : ∃ n, 1 ≤ n ∧ steps n c.enc = some c'.enc := by
  unfold tstep at h
  split at h
  · rename_i n d e
    obtain ⟨h1, h2⟩ := simQ_spec _ _ _ _ _ e
    split at h
    · rename_i c2 _
      by_cases hc : trim (fenc c2).l = trim d.l ∧ trim (fenc c2).r = trim d.r ∧ (fenc c2).st = d.st
      · simp only [hc, and_self, ite_true, Option.some.injEq] at h; subst h
        refine ⟨n - 0, by omega, ?_⟩
        have h2' : TM.fsteps trans (n - 0) (fenc c) = some d := h2
        rw [← fenc_toCfg, ← fenc_toCfg, steps, TM.FCfg.steps_eq trans, h2']
        have el : app d.l blank = app (fenc c2).l blank := by rw [← app_trim, ← hc.1, app_trim]
        have er : app d.r blank = app (fenc c2).r blank := by rw [← app_trim, ← hc.2.1, app_trim]
        simp only [Option.map_some, FCfg.toCfg, el, er, hc.2.2]
      · simp only [hc, ite_false] at h; cases h
    · cases h
  · cases h

/-! ## The complete map -/

/-- The macro map: a proved closed form where one applies, direct simulation elsewhere. -/
def mstep (c : AC) : Option AC :=
  match astep c with
  | some c' => some c'
  | none => tstep c

theorem mstep_sound (c c' : AC) (h : mstep c = some c') : ∃ n, 1 ≤ n ∧ steps n c.enc = some c'.enc := by
  unfold mstep at h
  cases e : astep c with
  | some c1 =>
    rw [e] at h; simp only [Option.some.injEq] at h; subst h
    obtain ⟨n, hn, hs⟩ := astep_sound c c1 e
    exact ⟨n, by omega, hs⟩
  | none => rw [e] at h; exact tstep_sound c c' h

/-- `k` steps of `mstep`. -/
def mrun : Nat → AC → Option AC
  | 0, c => some c
  | k + 1, c => (mstep c).bind (mrun k)

theorem mrun_adv : ∀ (k : Nat) (c c' : AC), mrun k c = some c' → ∃ n, k ≤ n ∧ steps n c.enc = some c'.enc
  | 0, c, c', h => by cases h; exact ⟨0, Nat.le_refl _, rfl⟩
  | k + 1, c, c', h => by
    simp only [mrun] at h
    cases h1 : mstep c with
    | none => rw [h1] at h; cases h
    | some c1 =>
      rw [h1] at h
      obtain ⟨n, hn, hs⟩ := mstep_sound c c1 h1
      obtain ⟨m, hm, hs'⟩ := mrun_adv k c1 c' h
      exact ⟨n + m, by omega, steps_seq trans hs hs'⟩

/-- **Non-halting reduced to the complete macro map**: if the iterated `mstep` never fails from the first Q
configuration of the run (step 27), the machine never halts from blank tape. -/
theorem not_halts_of_mrun (h : ∀ k, (mrun k start).isSome) : ¬ HaltsFromBlank := by
  apply not_halts_of_forall
  intro n
  have hk := h n
  cases e : mrun n start with
  | none => rw [e] at hk; cases hk
  | some c =>
    obtain ⟨m, hm, hs⟩ := mrun_adv n start c e
    have h3 := steps_seq trans start_reached hs
    have e2 : 27 + m = n + (27 + m - n) := by omega
    rw [e2] at h3
    exact steps_le trans h3

/-- A bounded version: if `k` steps of `mstep` succeed, the machine does not halt in its first `27 + k` steps. -/
theorem runs_of_mrun (k : Nat) (h : (mrun k start).isSome) : ∃ c, steps (27 + k) init = some c := by
  cases e : mrun k start with
  | none => rw [e] at h; cases h
  | some c =>
    obtain ⟨m, hm, hs⟩ := mrun_adv k start c e
    have h3 := steps_seq trans start_reached hs
    have e2 : 27 + m = (27 + k) + (m - k) := by omega
    rw [e2] at h3
    exact steps_le trans h3

/-- The run as a loop for compiled evaluation: `k` steps of `mstep`, the number of steps taken. -/
def mrunN : Nat → Nat → AC → Nat
  | 0, i, _ => i
  | k + 1, i, c => match mstep c with
    | some c' => mrunN k (i + 1) c'
    | none => i

theorem mrunN_sound : ∀ (k i : Nat) (c : AC), mrunN k i c = i + k → (mrun k c).isSome
  | 0, _, _, _ => rfl
  | k + 1, i, c, h => by
    simp only [mrunN] at h
    simp only [mrun]
    cases e : mstep c with
    | none => rw [e] at h; simp only at h; omega
    | some c' =>
      rw [e] at h; simp only at h
      exact mrunN_sound k (i + 1) c' (by omega)

end H65140
