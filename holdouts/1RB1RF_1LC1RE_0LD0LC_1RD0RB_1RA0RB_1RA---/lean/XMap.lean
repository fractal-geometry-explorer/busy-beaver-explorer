/-- The anomaly with a one-unit counter: word `[1, 2c+2]`, counter low part 1, gaps `flat S`. -/
def xanu : Nat → List Sg → Option AC
  | 0, .two (m0 + 1) :: .five (k1 + 1) :: S => some ⟨[6], 1, (3 * m0 + 4) :: 2 :: List.replicate (k1) 5 ++ flat S⟩
  | (c + 1), .two (m0 + 1) :: .five (k1 + 1) :: S => some ⟨5 :: (List.replicate (c) 1 ++ ([]) ++ [2]), 1, (3 * m0 + 4) :: 2 :: List.replicate (k1) 5 ++ flat S⟩
  | 0, .two (m0 + 1) :: .big q1 :: S => some ⟨[6], 1, (3 * m0 + 4) :: (3 * q1 + 5) :: flat S⟩
  | (c + 1), .two (m0 + 1) :: .big q1 :: S => some ⟨5 :: (List.replicate (c) 1 ++ ([]) ++ [2]), 1, (3 * m0 + 4) :: (3 * q1 + 5) :: flat S⟩
  | 0, .two (m0 + 1) :: [] => some ⟨[6], 1, (3 * m0 + 4) :: []⟩
  | (c + 1), .two (m0 + 1) :: [] => some ⟨5 :: (List.replicate (c) 1 ++ ([]) ++ [2]), 1, (3 * m0 + 4) :: []⟩
  | 0, .five (k0 + 1) :: S => some ⟨[6], 1, 1 :: 2 :: List.replicate (k0) 5 ++ flat S⟩
  | (c + 1), .five (k0 + 1) :: S => some ⟨5 :: (List.replicate (c) 1 ++ ([]) ++ [2]), 1, 1 :: 2 :: List.replicate (k0) 5 ++ flat S⟩
  | 0, .big q0 :: S => some ⟨[6], 1, 1 :: (3 * q0 + 5) :: flat S⟩
  | (c + 1), .big q0 :: S => some ⟨5 :: (List.replicate (c) 1 ++ ([]) ++ [2]), 1, 1 :: (3 * q0 + 5) :: flat S⟩
  | 0, [] => some ⟨[6], 1, 1 :: []⟩
  | (c + 1), [] => some ⟨5 :: (List.replicate (c) 1 ++ ([]) ++ [2]), 1, 1 :: []⟩
  | _, _ => none

theorem xg00_sound (s : Nat) (S : List Sg) {C : List Nat} {a' : Nat} {G' : List Nat} {j : Nat}
    (h : xg00 s S = some (C, a', G', j)) (L : Tape) :
    ∃ k, 1 ≤ k ∧ steps k (zc L (List.replicate (2 * s + 0) 2 ++ 0 :: flat S)) = some (qx a' C (rep j [true] L) G') := by
  unfold xg00 at h
