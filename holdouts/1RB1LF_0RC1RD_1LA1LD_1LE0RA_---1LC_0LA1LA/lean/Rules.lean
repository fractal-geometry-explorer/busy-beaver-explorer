/-- The same with an odd last block. -/
theorem end2_o (y z : Nat) :
    steps (12 * y + 44) ⟨blank, cons false (cons true (cons true (cons false (cons true (rep (y + 2) [true, true] (cons false (cons true (rep (z) [true, true] (blank))))))))), .A⟩ = some ⟨blank, cons false (cons true (cons true (cons true (cons true (cons true (cons true (rep (y) [true, true] (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (z) [true, true] (blank))))))))))))))))), .A⟩ := by
  have hn : 5 + ((y + 2) * 10 + (9 + ((y) * 2 + (10)))) = 12 * y + 44 := by omega
  have h0 : steps 5 ⟨blank, cons false (cons true (cons true (cons false (cons true (rep (y + 2) [true, true] (cons false (cons true (rep (z) [true, true] (blank))))))))), .A⟩ = some ⟨cons true (cons true (cons false (cons true (cons true (blank))))), rep (y + 2) [true, true] (cons false (cons true (rep (z) [true, true] (blank)))), .D⟩ := rfl
  have c1 : ∀ L R : Tape, steps 10 ⟨app [true, true, false] L, app [true, true] R, .D⟩ = some ⟨app [true, true, false] (app [true, true] L), R, .D⟩ := fun _ _ => rfl
  have h1 : steps ((y + 2) * 10) ⟨cons true (cons true (cons false (cons true (cons true (blank))))), rep (y + 2) [true, true] (cons false (cons true (rep (z) [true, true] (blank)))), .D⟩ = some ⟨cons true (cons true (cons false (rep (y + 2) [true, true] (cons true (cons true (blank)))))), cons false (cons true (rep (z) [true, true] (blank))), .D⟩ :=
    cross_r trans c1 (y + 2) (cons true (cons true (blank))) (cons false (cons true (rep (z) [true, true] (blank))))
  have h2 : steps 9 ⟨cons true (cons true (cons false (rep (y + 2) [true, true] (cons true (cons true (blank)))))), cons false (cons true (rep (z) [true, true] (blank))), .D⟩ = some ⟨rep (y) [true, true] (cons true (cons true (blank))), cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (z) [true, true] (blank)))))))))), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, true] R), .A⟩ := fun _ _ => rfl
  have h3 : steps ((y) * 2) ⟨rep (y) [true, true] (cons true (cons true (blank))), cons true (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (z) [true, true] (blank)))))))))), .A⟩ = some ⟨cons true (cons true (blank)), cons true (rep (y) [true, true] (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (z) [true, true] (blank))))))))))), .A⟩ :=
    cross_l trans c3 (y) (cons true (cons true (blank))) (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (z) [true, true] (blank))))))))))
  have h4 : steps 10 ⟨cons true (cons true (blank)), cons true (rep (y) [true, true] (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (z) [true, true] (blank))))))))))), .A⟩ = some ⟨blank, cons false (cons true (cons true (cons true (cons true (cons true (cons true (rep (y) [true, true] (cons false (cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (z) [true, true] (blank))))))))))))))))), .A⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

