import Machine

/-! # 1RB0LE_1RC1RB_1RD0RA_0RE---_1LF1LA_1LA1LF: shift rules of the sweeps and the shape of a halt

Generated by `py/rules.py` with `tools/py/bbtools/symtm.py`; every rule holds for all `n` and all tapes `L`, `R`. -/

namespace H58953

open TM

/-- Rightward, B runs over 1s. -/
theorem b_run (n : Nat) (L R : Tape) :
    steps (n) ⟨L, rep (n) [true] (R), .B⟩ = some ⟨rep (n) [true] (L), R, .B⟩ := by
  have c0 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .B⟩ = some ⟨app [] (app [true] L), R, .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 1) ⟨L, rep (n) [true] (R), .B⟩ = some ⟨rep (n) [true] (L), R, .B⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 1) (by omega) (h0)

/-- Leftward, F runs over 1s. -/
theorem f_run (n : Nat) (L R : Tape) :
    steps (n) ⟨rep (n) [true] (L), cons true (R), .F⟩ = some ⟨L, cons true (rep (n) [true] (R)), .F⟩ := by
  have c0 : ∀ L R : Tape, steps 1 ⟨app [true] L, app [true] R, .F⟩ = some ⟨L, app [true] (app [true] R), .F⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 1) ⟨rep (n) [true] (L), cons true (R), .F⟩ = some ⟨L, cons true (rep (n) [true] (R)), .F⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 1) (by omega) (h0)

/-- Leftward, E (with A between) turns each pair 11 into 01, 2 steps a pair. -/
theorem e_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨rep (n) [true, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [true, true] L, app [true] R, .E⟩ = some ⟨L, app [true] (app [false, true] R), .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨rep (n) [true, true] (L), cons true (R), .E⟩ = some ⟨L, cons true (rep (n) [false, true] (R)), .E⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- Rightward, A (with B, C) turns each 0101 into 1110, 4 steps a copy. -/
theorem a_run (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨L, rep (n) [false, true, false, true] (R), .A⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .A⟩ = some ⟨app [] (app [false, true, true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨L, rep (n) [false, true, false, true] (R), .A⟩ = some ⟨rep (n) [false, true, true, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 4) (by omega) (h0)

/-- The only way to a halt: B on a double 0 followed by a 1 reaches D on a 1 (which halts) in 2 steps. -/
theorem halt_shape (L R : Tape) :
    steps (2) ⟨L, cons false (cons false (cons true (R))), .B⟩ = some ⟨cons true (cons true (L)), cons true (R), .D⟩ := by
  have h0 : steps 2 ⟨L, cons false (cons false (cons true (R))), .B⟩ = some ⟨cons true (cons true (L)), cons true (R), .D⟩ := rfl
  exact steps_congr trans (a := 2) (by omega) (h0)

/-- D reading a 1 halts (the end of `halt_shape`). -/
theorem halt_after_shape (L R : Tape) : step ⟨L, cons true R, .D⟩ = none := rfl

end H58953

