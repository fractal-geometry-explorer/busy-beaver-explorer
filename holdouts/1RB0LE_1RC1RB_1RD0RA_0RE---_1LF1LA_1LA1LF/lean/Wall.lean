/-!
# Two-cell letters: walls are ordinary letters

Cut the tape into 2-cell letters.  Left of the head at a right turn the zone uses two letters, `a = 11` and the wall
letter `b = 10` (left to right); right of the head the frozen tape uses `a = 11` and `c = 01`.  Read nearest the head
first, `b` on the left and `c` on the right are the same two cells `0 1`, so one encoding `lt2` serves both sides
(`false` is `a`, `true` is `b` or `c`).

The 4-cell letters of `Pascal.lean` are pairs: `u = 1110` is `a b` and `v = 1111` is `a a` (`zl_two`), and the wall
`1 0` of `Absorb.lean` is one `b`.  So a walled zone, or a zone with walls anywhere inside it, is just a word in
`a` and `b`, and one theorem (`bounce2`) gives the next right turn for every such zone and every frozen word in
`a` and `c`:

* **left sweep** (`sweep2`): C (odd) and D (even) take the running XOR of the zone from the right, `b` counting 1, and
  leave `a` (even) or `c` (odd).  It never turns early: every left sweep over a word in `a` and `b` reaches the left end.
* **left end** (`lend`, from `Pascal.lean`): one `a` is added and the prefix toggles in C.
* **right sweep** (`rsw2`, `rsweep2`): F (`e = false`) and E (`e = true`) take the running XOR again, now from the left,
  `c` counting 1, and write `b` where it is odd, `a` where it is even.  It stops, at a new right turn, at the first
  place where the running XOR is odd twice in a row (E reading `a`).

The case left open in `Absorb.lean`, an even head block meeting a walled zone, is the instance `wall_even`: frozen
tape `1 1 0 ...` with the wall `1 0` next to the head.  Words are listed nearest the head first.
-/

namespace H58953

open TM

/-- A 2-cell letter, nearest cell first: `false` is `a = 11`; `true` is `b = 10` left of the head, `c = 01` right of it. -/
def lt2 : Bool → List Bool
  | false => [true, true]
  | true => [false, true]

/-- A word of 2-cell letters (nearest first) in front of the tape `S`; the same function serves both sides. -/
def zl2 : List Bool → Tape → Tape
  | [], s => s
  | x :: xs, s => app (lt2 x) (zl2 xs s)

theorem zl2_append (xs ys : List Bool) (S : Tape) : zl2 (xs ++ ys) S = zl2 xs (zl2 ys S) := by
  induction xs with
  | nil => rfl
  | cons a xs ih => simp only [List.cons_append, zl2, ih]

/-- A 4-cell letter is two 2-cell letters: `u = a b` is `[b, a]` nearest first, `v = a a`. -/
def two : Bool → List Bool
  | true => [true, false]
  | false => [false, false]

/-- A 4-cell zone (`Pascal.lean`) as a 2-cell word. -/
def dbl : List Bool → List Bool
  | [] => []
  | x :: xs => two x ++ dbl xs

theorem zl_two (ws : List Bool) (S : Tape) : zl ws S = zl2 (dbl ws) S := by
  induction ws with
  | nil => rfl
  | cons x ws ih =>
    rw [dbl, zl2_append, ← ih]
    cases x <;> rfl

/-- One letter of the left sweep: parity `q` (C odd, D even) meets `x` (`b` counts 1) and leaves `a` or `c`. -/
theorem sweep2_1 (x q : Bool) (Y R : Tape) :
    steps 2 (onL (app (lt2 x) Y) R (pst q)) = some (onL Y (app (lt2 (bne q x)) R) (pst (bne q x))) := by
  rw [eta Y]
  cases x <;> cases q <;> cases h : Y 0 <;> rfl

/-- **The left sweep** over a word in `a` and `b`: the running XOR from the right, never an early turn. -/
theorem sweep2 (ws : List Bool) (S : Tape) :
    ∀ (q : Bool) (R : Tape), steps (2 * ws.length) (onL (zl2 ws S) R (pst q)) =
      some (onL S (zl2 (sx q ws).reverse R) (pst (par q ws))) := by
  induction ws with
  | nil => intro q R; rfl
  | cons a ws ih =>
    intro q R
    have h2 := ih (bne q a) (app (lt2 (bne q a)) R)
    have e : 2 * (a :: ws).length = 2 + 2 * ws.length := by simp [List.length]; omega
    rw [e]
    have e2 : zl2 (sx (bne q a) ws).reverse (app (lt2 (bne q a)) R) = zl2 (sx q (a :: ws)).reverse R := by
      simp only [sx, List.reverse_cons, zl2_append]; rfl
    rw [e2] at h2
    exact steps_seq trans (sweep2_1 a q (zl2 ws S) R) h2

/-- The state of the right sweep: F (`false`) or E (`true`), the running XOR of the `c`s so far. -/
def fst : Bool → St
  | false => .B
  | true => .A

/-- One letter of the right sweep, unless it is E meeting `a` (a right turn): writes `b` if the new XOR is odd. -/
theorem rsweep2_1 (e x : Bool) (h : (e && !x) = false) (L R : Tape) :
    steps 2 ⟨L, app (lt2 x) R, fst e⟩ = some ⟨app (lt2 (bne e x)) L, R, fst (bne e x)⟩ := by
  cases e <;> cases x <;> first | rfl | exact absurd h (by decide)

/-- Where the right sweep from state `e`, with `L` behind it, ends over the word `xs` and then the tape `R`: at the first
E reading `a` (a right turn, as a configuration), or in `fst e'` on `R` if there is none. -/
def rsw2 (e : Bool) (L : Tape) : List Bool → Tape → Config
  | [], R => ⟨L, R, fst e⟩
  | x :: xs, R => if (e && !x) = true then ⟨L, app (lt2 x) (zl2 xs R), .A⟩
    else rsw2 (bne e x) (app (lt2 (bne e x)) L) xs R

/-- **The right sweep.** -/
theorem rsweep2 (xs : List Bool) : ∀ (e : Bool) (L R : Tape), ∃ n,
    steps n ⟨L, zl2 xs R, fst e⟩ = some (rsw2 e L xs R) := by
  induction xs with
  | nil => intro e L R; exact ⟨0, rfl⟩
  | cons x xs ih =>
    intro e L R
    by_cases h : (e && !x) = true
    · refine ⟨0, ?_⟩
      cases e
      · simp at h
      · cases x
        · rfl
        · simp at h
    · have h' : (e && !x) = false := by cases hh : (e && !x) <;> simp_all
      obtain ⟨n, hn⟩ := ih (bne e x) (app (lt2 (bne e x)) L) R
      refine ⟨2 + n, ?_⟩
      have : rsw2 e L (x :: xs) R = rsw2 (bne e x) (app (lt2 (bne e x)) L) xs R := by
        show (if (e && !x) = true then _ else _) = _
        simp only [h']; rfl
      rw [this]
      exact steps_seq trans (rsweep2_1 e x h' L (zl2 xs R)) hn

/-- **One bounce, any zone in `a` and `b`.**  From a right turn (E on `a`) with zone `ws` (prefix `p`) and frozen word
`s` in `a` and `c` after the `a` under the head, the machine runs to `rsw2`: the right sweep from F, with the new `a`
and toggled prefix behind it, over the left sweep's output `(sx true ws).reverse`, then `c` (the head's `a`, which E
broke), then `s`, then `R`. -/
theorem bounce2 (ws : List Bool) (p : Bool) (s : List Bool) (R : Tape) : ∃ n,
    steps n ⟨zl2 ws (pre p), app (lt2 false) (zl2 s R), .A⟩ =
      some (rsw2 false (app [true, true] (pre (bne p (par true ws)))) ((sx true ws).reverse ++ true :: s) R) := by
  have h0 : steps 1 ⟨zl2 ws (pre p), app (lt2 false) (zl2 s R), .A⟩ =
      some (onL (zl2 ws (pre p)) (app (lt2 true) (zl2 s R)) (pst true)) := rfl
  have h1 := sweep2 ws (pre p) true (app (lt2 true) (zl2 s R))
  have h2 := lend p (par true ws) (zl2 (sx true ws).reverse (app (lt2 true) (zl2 s R)))
  obtain ⟨n, h3⟩ := rsweep2 ((sx true ws).reverse ++ true :: s) false
    (app [true, true] (pre (bne p (par true ws)))) R
  have e : zl2 ((sx true ws).reverse ++ true :: s) R = zl2 (sx true ws).reverse (app (lt2 true) (zl2 s R)) := by
    rw [zl2_append]; rfl
  rw [e] at h3
  exact ⟨_, steps_seq trans (steps_seq trans (steps_seq trans h0 h1) h2) h3⟩

/-! ## The case left open: an even head block against a walled zone

A walled zone is `true :: dbl ws` (the wall `b` nearest the head).  An even head block of `2m` cells is `m` letters `a`,
and `wbounces` takes it down two cells a bounce; what is left is `1 1 0 ...`: one `a` under the head, then `c`.  Then
`bounce2` applies as for any zone.  `wall_even` states it for the walled zone of `Absorb.lean` in its own terms.
-/

/-- The walled zone of `Absorb.lean` is the 2-cell word `b` followed by the zone. -/
theorem walled (ws : List Bool) (p : Bool) :
    app [false, true] (zl ws (pre p)) = zl2 (true :: dbl ws) (pre p) := by
  rw [zl_two]; rfl

/-- **Even head block, walled zone.**  Zone `ws` with the wall `1 0` next to the head, frozen tape `1 1` then the word `s`
in `a = 11` and `c = 01` (for instance `0 1^(2j+1) 0 1^(2l+1) ...`): the next right turn, or the right sweep's arrival
on `R`, is `rsw2` of the zone's 2-cell word `true :: dbl ws`, as for every zone. -/
theorem wall_even (ws : List Bool) (p : Bool) (s : List Bool) (R : Tape) : ∃ n,
    steps n ⟨app [false, true] (zl ws (pre p)), cons true (cons true (zl2 s R)), .A⟩ =
      some (rsw2 false (app [true, true] (pre (bne p (par true (true :: dbl ws)))))
        ((sx true (true :: dbl ws)).reverse ++ true :: s) R) := by
  rw [walled]
  exact bounce2 (true :: dbl ws) p s R

/-! ## The shape is kept until the right sweep reaches the end of the frozen word

`bounce2` turns a right turn of the shape `Turn w p s R` (zone `w` in `a`, `b` out to the prefix, E on `a`, frozen word `s`
in `a`, `c`, then the tape `R`) into another one of the same shape, with the same `R`, unless the right sweep runs off
the end of `s` into `R`.  `nxt` computes the new `w`, `p`, `s` on lists alone (`turn_next`), so whether the machine can
halt before the head gets to `R` is a question about words, not tapes: `not_halts_of_closed` says the machine never
halts if a set of shapes is closed under `nxt`.  Inside the shape the tape has no `0 0` and every frozen block after
the head block is odd; the halting patterns of `Blocks.lean` and `Route.lean` (F on `0 0 1`) can only come from `R`.
-/

/-- A right turn: zone `w` (2-cell letters `a`, `b`, nearest first) out to the prefix `p`, E on an `a`, then the frozen
word `s` (letters `a`, `c`), then `R`. -/
def Turn (w : List Bool) (p : Bool) (s : List Bool) (R : Tape) : Config :=
  ⟨zl2 w (pre p), app (lt2 false) (zl2 s R), .A⟩

/-- The right sweep on lists: from state `e` with the word `W` behind it (nearest first) over `xs`, the word behind it
at the end, the state, and what is left after the `a` it turned on (`none` if it ran off the end of `xs`). -/
def rswL : Bool → List Bool → List Bool → List Bool × Bool × Option (List Bool)
  | e, W, [] => (W, e, none)
  | e, W, x :: xs => if (e && !x) = true then (W, e, some xs) else rswL (bne e x) (bne e x :: W) xs

/-- The configuration `rsw2` reaches, read off `rswL`. -/
def rswC (S R : Tape) : List Bool × Bool × Option (List Bool) → Config
  | (W, _, some r) => ⟨zl2 W S, app (lt2 false) (zl2 r R), .A⟩
  | (W, e, none) => ⟨zl2 W S, R, fst e⟩

theorem rsw2_eq (xs : List Bool) : ∀ (e : Bool) (W : List Bool) (S R : Tape),
    rsw2 e (zl2 W S) xs R = rswC S R (rswL e W xs) := by
  induction xs with
  | nil => intro e W S R; rfl
  | cons x xs ih =>
    intro e W S R
    by_cases h : (e && !x) = true
    · have hx : x = false := by cases e <;> cases x <;> simp_all
      subst hx
      show (if (e && !false) = true then _ else _) = rswC S R (if (e && !false) = true then _ else _)
      simp only [h, ↓reduceIte]; rfl
    · show (if (e && !x) = true then _ else _) = rswC S R (if (e && !x) = true then _ else _)
      simp only [h, ↓reduceIte, Bool.false_eq_true]
      exact ih (bne e x) (bne e x :: W) S R

/-- The next right turn, on lists: `none` if the right sweep runs into `R`. -/
def nxt (w : List Bool) (p : Bool) (s : List Bool) : Option (List Bool × Bool × List Bool) :=
  match rswL false [false] ((sx true w).reverse ++ true :: s) with
  | (W, _, some r) => some (W, bne p (par true w), r)
  | (_, _, none) => none

/-- **The next right turn** has the same shape, for every zone in `a`, `b` (walls anywhere) and frozen word. -/
theorem turn_next (w : List Bool) (p : Bool) (s : List Bool) (R : Tape) (w' : List Bool) (p' : Bool) (s' : List Bool)
    (h : nxt w p s = some (w', p', s')) : ∃ n, steps (n + 1) (Turn w p s R) = some (Turn w' p' s' R) := by
  have h0 : steps 1 (Turn w p s R) = some (onL (zl2 w (pre p)) (app (lt2 true) (zl2 s R)) (pst true)) := rfl
  have h1 := sweep2 w (pre p) true (app (lt2 true) (zl2 s R))
  have h2 := lend p (par true w) (zl2 (sx true w).reverse (app (lt2 true) (zl2 s R)))
  obtain ⟨n, h3⟩ := rsweep2 ((sx true w).reverse ++ true :: s) false (zl2 [false] (pre (bne p (par true w)))) R
  have e : zl2 ((sx true w).reverse ++ true :: s) R = zl2 (sx true w).reverse (app (lt2 true) (zl2 s R)) := by
    rw [zl2_append]; rfl
  rw [e, rsw2_eq] at h3
  have e2 : rswC (pre (bne p (par true w))) R (rswL false [false] ((sx true w).reverse ++ true :: s)) =
      Turn w' p' s' R := by
    unfold nxt at h
    revert h
    cases rswL false [false] ((sx true w).reverse ++ true :: s) with
    | mk W rest =>
      cases rest with
      | mk e' r =>
        cases r with
        | none => intro h; cases h
        | some r => intro h; cases h; rfl
  rw [e2] at h3
  have h4 := steps_seq trans (steps_seq trans (steps_seq trans h0 h1) h2) h3
  exact ⟨2 * w.length + lsteps p (par true w) + n, steps_congr trans (by omega) h4⟩

/-- **No halt while the shape is kept.**  If a set of shapes contains `(w, p, s)` and `nxt` maps each of its members to
another member (never `none`), then the machine never halts from `Turn w p s R`, whatever `R` is. -/
theorem not_halts_of_closed (P : List Bool → Bool → List Bool → Prop)
    (hP : ∀ w p s, P w p s → ∃ w' p' s', nxt w p s = some (w', p', s') ∧ P w' p' s')
    (w : List Bool) (p : Bool) (s : List Bool) (R : Tape) (h : P w p s) : ¬ Halts trans (Turn w p s R) := by
  have key : ∀ N, ∃ w' p' s' m, P w' p' s' ∧ N ≤ m ∧ steps m (Turn w p s R) = some (Turn w' p' s' R) := by
    intro N
    induction N with
    | zero => exact ⟨w, p, s, 0, h, Nat.le_refl 0, rfl⟩
    | succ N ih =>
      obtain ⟨w1, p1, s1, m, h1, hm, hs⟩ := ih
      obtain ⟨w2, p2, s2, hn, h2⟩ := hP w1 p1 s1 h1
      obtain ⟨k, hk⟩ := turn_next w1 p1 s1 R w2 p2 s2 hn
      exact ⟨w2, p2, s2, m + (k + 1), h2, by omega, steps_seq trans hs hk⟩
  apply not_halts_of_forall
  apply forall_of_unbounded trans (fun m => ∃ c', steps m (Turn w p s R) = some c')
  · intro n
    obtain ⟨w', p', s', m, _, hm, hs⟩ := key n
    exact ⟨m, hm, _, hs⟩
  · intro m hm; exact hm

