  have h0 : steps 2 ⟨blank, cons false (rep (x + 2) [false, true] (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .C⟩ = some ⟨cons true (blank), cons true (rep (x + 2) [false, true] (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons true (rep (x + 2) [false, true] (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ = some ⟨cons true (blank), rep (x + 2) [true, false] (cons true (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (x + 2) [false, true] (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))) = rep (x + 2) [true, false] (cons true (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))) from
      rep_rotate (x + 2) [true] [false, true] [true, false] rfl (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((x + 2) * 2) ⟨cons true (blank), rep (x + 2) [true, false] (cons true (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ = some ⟨rep (x + 2) [true, false] (cons true (blank)), cons true (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))), .B⟩ :=
    cross_r trans c2 (x + 2) (cons true (blank)) (cons true (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))))
  have h3 : steps 9 ⟨rep (x + 2) [true, false] (cons true (blank)), cons true (cons false (rep (y + 3) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))), .B⟩ = some ⟨cons false (rep (x + 2) [true, false] (cons true (blank))), cons true (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (rep (x + 2) [true, false] (cons true (blank))), cons true (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))))), .A⟩ = some ⟨rep (x + 2) [false, true] (cons false (cons true (blank))), cons true (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))))), .A⟩ := by
    simp only [steps_zero, show cons false (rep (x + 2) [true, false] (cons true (blank))) = rep (x + 2) [false, true] (cons false (cons true (blank))) from
      rep_rotate (x + 2) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false] R), .A⟩ := fun _ _ => rfl
  have h5 : steps ((x + 2) * 2) ⟨rep (x + 2) [false, true] (cons false (cons true (blank))), cons true (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))))), .A⟩ = some ⟨cons false (cons true (blank)), cons true (rep (x + 2) [true, false] (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))))))), .A⟩ :=
    cross_l trans c5 (x + 2) (cons false (cons true (blank))) (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))))))
  have h6 : steps 3 ⟨cons false (cons true (blank)), cons true (rep (x + 2) [true, false] (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (rep (x + 2) [true, false] (cons true (cons false (cons true (cons true (rep (y + 1) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

/-- Left phase, marker `1`: the first block gains one 01 and the marker turns back into `0`. (4*x+26 steps) -/
theorem left_b (x y : Nat) (R : Tape) :
    steps (4 * x + 26) ⟨blank, cons false (rep (x + 5) [false, true] (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .C⟩ = some ⟨blank, cons false (cons false (cons true (cons false (rep (x + 5) [true, false] (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))))), .C⟩ := by
  have hn : 2 + (0 + ((x + 5) * 2 + (1 + (0 + ((x + 5) * 2 + (3)))))) = 4 * x + 26 := by omega
  have h0 : steps 2 ⟨blank, cons false (rep (x + 5) [false, true] (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .C⟩ = some ⟨cons true (blank), cons true (rep (x + 5) [false, true] (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (blank), cons true (rep (x + 5) [false, true] (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ = some ⟨cons true (blank), rep (x + 5) [true, false] (cons true (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ := by
    simp only [steps_zero, show cons true (rep (x + 5) [false, true] (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))) = rep (x + 5) [true, false] (cons true (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))) from
      rep_rotate (x + 5) [true] [false, true] [true, false] rfl (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .B⟩ = some ⟨app [] (app [true, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((x + 5) * 2) ⟨cons true (blank), rep (x + 5) [true, false] (cons true (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))), .B⟩ = some ⟨rep (x + 5) [true, false] (cons true (blank)), cons true (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))), .B⟩ :=
    cross_r trans c2 (x + 5) (cons true (blank)) (cons true (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))))
  have h3 : steps 1 ⟨rep (x + 5) [true, false] (cons true (blank)), cons true (cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))), .B⟩ = some ⟨cons false (rep (x + 5) [true, false] (cons true (blank))), cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))), .A⟩ := rfl
  have h4 : steps 0 ⟨cons false (rep (x + 5) [true, false] (cons true (blank))), cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))), .A⟩ = some ⟨rep (x + 5) [false, true] (cons false (cons true (blank))), cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))), .A⟩ := by
    simp only [steps_zero, show cons false (rep (x + 5) [true, false] (cons true (blank))) = rep (x + 5) [false, true] (cons false (cons true (blank))) from
      rep_rotate (x + 5) [false] [true, false] [false, true] rfl (cons true (blank))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [false, true] L, app [true] R, .A⟩ = some ⟨L, app [true] (app [true, false] R), .A⟩ := fun _ _ => rfl
  have h5 : steps ((x + 5) * 2) ⟨rep (x + 5) [false, true] (cons false (cons true (blank))), cons true (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))), .A⟩ = some ⟨cons false (cons true (blank)), cons true (rep (x + 5) [true, false] (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))), .A⟩ :=
    cross_l trans c5 (x + 5) (cons false (cons true (blank))) (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))
  have h6 : steps 3 ⟨cons false (cons true (blank)), cons true (rep (x + 5) [true, false] (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R)))))))), .A⟩ = some ⟨blank, cons false (cons false (cons true (cons false (rep (x + 5) [true, false] (rep (y + 2) [false, true] (cons false (cons false (cons true (cons true (cons false (R))))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))

