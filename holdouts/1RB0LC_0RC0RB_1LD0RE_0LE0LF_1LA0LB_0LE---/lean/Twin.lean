/-! ## The machine is its frame-A conjugate seen through `img` (frame A itself (`img` only renames nothing)) -/

/-- Frame-A state to this machine's state. -/
def sigma : St → St
  | .A => .A
  | .B => .B
  | .C => .C
  | .D => .D
  | .E => .E
  | .F => .F

/-- A frame-A configuration as a configuration of this machine. -/
def img (c : Cfg St) : Cfg St := ⟨c.l, c.r, sigma c.st⟩

theorem hsig (q : St) (b : Bool) :
    trans (sigma q) b = (FA.trans q b).map (fun x => (x.1, (fun d => d) x.2.1, sigma x.2.2)) := by
  cases q <;> cases b <;> rfl

theorem cons_head_tail (s : Tape) : cons (s 0) (tail s) = s := by
  funext n; cases n <;> rfl

/-- One step of the machine is one step of its frame-A conjugate. -/
theorem step_img (c : Cfg St) : TM.step trans (img c) = (TM.step FA.trans c).map img := by
  obtain ⟨l, r, q⟩ := c
  cases q <;> cases h : r 0 <;> simp [TM.step, img, trans, FA.trans, sigma, h]

/-- Every run of the machine is a run of its frame-A conjugate. -/
theorem steps_img (n : Nat) (c : Cfg St) : TM.steps trans n (img c) = (TM.steps FA.trans n c).map img := by
  induction n generalizing c with
  | zero => rfl
  | succ n ih =>
    unfold TM.steps
    rw [step_img]
    cases TM.step FA.trans c with
    | none => rfl
    | some c' => exact ih c'

/-- The run from blank tape is the image of the frame-A run from blank tape in state A. -/
theorem init_img : img ⟨blank, blank, .A⟩ = init := by
  rfl

/-- The machine halts from blank tape if and only if its frame-A conjugate halts from blank tape in state A. -/
theorem halts_iff : HaltsFromBlank ↔ TM.Halts FA.trans ⟨blank, blank, .A⟩ := by
  unfold HaltsFromBlank
  rw [← init_img]
  constructor
  · rintro ⟨n, d, h1, h2⟩
    rw [steps_img] at h1
    cases e : TM.steps FA.trans n ⟨blank, blank, .A⟩ with
    | none => rw [e] at h1; cases h1
    | some c' =>
      rw [e] at h1
      cases h1
      refine ⟨n, c', e, ?_⟩
      have := step_img c'
      rw [h2] at this
      cases e2 : TM.step FA.trans c' with
      | none => rfl
      | some _ => rw [e2] at this; cases this
  · rintro ⟨n, c', h1, h2⟩
    refine ⟨n, img c', ?_, ?_⟩
    · rw [steps_img, h1]; rfl
    · rw [step_img, h2]; rfl

end MX

