/-! ## The two frame-A tables have one question -/

abbrev FX := MX.FA.trans
abbrev FY := MY.FA.trans

/-- Not in F: the two runs are synchronised there. -/
def Syn (c : Cfg St) : Prop := c.st ≠ .F
/-- D reads 1: the two machines take different paths from here. -/
def Seg (c : Cfg St) : Prop := c.st = .D ∧ c.r 0 = true
/-- D reads 1 and the cell left of it is 0, but the window is not `1 0 0 0 D>1 1`. -/
def Bad (c : Cfg St) : Prop := c.st = .D ∧ c.r 0 = true ∧ c.l 0 = false ∧
    ¬ (c.l 1 = false ∧ c.l 2 = false ∧ c.l 3 = true ∧ c.r 1 = true)

/-- `false` exactly at the starts of segments. -/
def notSeg (c : Cfg St) : Bool := match c.st, c.r 0 with
  | .D, true => false
  | _, _ => true

theorem notSeg_ok (e : Cfg St) (h : notSeg e = true) : ¬ Bad e := by
  obtain ⟨l, r, q⟩ := e
  rintro ⟨h1, h2, -⟩
  simp only at h1 h2; subst h1
  simp [notSeg, h2] at h

/-- The two tables agree off the segments, never halt there, and every good segment closes. -/
theorem resync : Resync FX FY Syn Seg Bad where
  agree c hs hg := by
    obtain ⟨l, r, q⟩ := c
    obtain ⟨b, R, rfl⟩ := tape_cell r
    simp only [Syn, Seg] at hs hg
    cases q <;> cases b
    all_goals first | rfl | (exact absurd rfl hs) | (exact absurd ⟨rfl, rfl⟩ hg)
  live c hs hg := by
    obtain ⟨l, r, q⟩ := c
    obtain ⟨b, R, rfl⟩ := tape_cell r
    simp only [Syn, Seg] at hs hg
    cases q <;> cases b
    all_goals first | (exact absurd rfl hs) | (exact absurd ⟨rfl, rfl⟩ hg) | exact ⟨_, rfl, nofun⟩
  seg c hs hg hb := by
    obtain ⟨l, r, q⟩ := c
    obtain ⟨b0, R, rfl⟩ := tape_cell r
    obtain ⟨l0, L, rfl⟩ := tape_cell l
    obtain ⟨h1, h2⟩ := hg
    simp only at h1 h2; subst h1; subst h2
    cases l0
    · obtain ⟨l1, L, rfl⟩ := tape_cell L
      obtain ⟨l2, L, rfl⟩ := tape_cell L
      obtain ⟨l3, L, rfl⟩ := tape_cell L
      obtain ⟨r1, R, rfl⟩ := tape_cell R
      by_cases hw : (l1 = false ∧ l2 = false ∧ l3 = true ∧ r1 = true)
      · obtain ⟨rfl, rfl, rfl, rfl⟩ := hw
        refine ⟨21, 1, clean_of_chk FX notSeg notSeg_ok _ _ rfl, clean_of_chk FY notSeg notSeg_ok _ _ rfl,
          Or.inl ⟨_, ?_, rfl, rfl⟩⟩
        nofun
      · exact absurd ⟨rfl, rfl, rfl, hw⟩ hb
    · exact ⟨1, 1, clean_of_chk FX notSeg notSeg_ok _ _ rfl, clean_of_chk FY notSeg notSeg_ok _ _ rfl,
        Or.inr ⟨⟨_, rfl, rfl⟩, ⟨_, rfl, rfl⟩⟩⟩

/-- **One question.**  The frame-A runs from blank tape (in state A) meet a bad configuration together, and if they
never do, 1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_0LE--- and 1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_1LA--- halt together. -/
theorem halt_together :
    (NoBad FX Bad ⟨blank, blank, .A⟩ ↔ NoBad FY Bad ⟨blank, blank, .A⟩) ∧
    (NoBad FX Bad ⟨blank, blank, .A⟩ → (MX.HaltsFromBlank ↔ MY.HaltsFromBlank)) := by
  rw [MX.halts_iff, MY.halts_iff]
  exact TM.halt_together resync (c0 := ⟨blank, blank, .A⟩) nofun

end Twin
