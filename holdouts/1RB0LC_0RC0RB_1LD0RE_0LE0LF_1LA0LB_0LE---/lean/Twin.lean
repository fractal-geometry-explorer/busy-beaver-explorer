  | .F, false => some (false, .L, .E)
  | .F, true => none

/-- The configuration of its run from blank tape. -/
abbrev init : Cfg St := TM.blankCfg .A
/-- 1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_0LE--- halts from blank tape. -/
abbrev HaltsFromBlank : Prop := TM.Halts trans init

namespace FA

/-- The frame-A conjugate of 1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_0LE---: 1RB0LC_0RC0RB_1LD0RE_0LE0LF_1LA0LB_0LE---. -/
def trans : St → Bool → Option (Bool × Dir × St)
  | .A, false => some (true, .R, .B)
  | .A, true => some (false, .L, .C)
  | .B, false => some (false, .R, .C)
  | .B, true => some (false, .R, .B)
  | .C, false => some (true, .L, .D)
  | .C, true => some (false, .R, .E)
