import Machine

/-! # The left-going pass

Generated by `py/gen_rules.py` with `bbtools.symtm.prove`: every theorem is a run of the machine for all values of
the variables and every tape `L`, `R`, proved by `rfl` steps and the shift rules `cross_l`, `cross_r`.
Left tapes are written nearest the head first, so `(10)^k` on the page is `rep k [false, true]` here. -/

namespace H157319

open TM

/-- C on a 0 with a 0 to its left: E reads 0, the halting transition. -/
theorem halt_c (L R : Tape) :
    steps (1) ⟨cons false (L), cons false (R), .C⟩ = some ⟨L, cons false (cons false (R)), .E⟩ := by
  have h0 : steps 1 ⟨cons false (L), cons false (R), .C⟩ = some ⟨L, cons false (cons false (R)), .E⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

/-- D on `0 0`: E reads 0. -/
theorem halt_d (L R : Tape) :
    steps (1) ⟨L, cons false (cons false (R)), .D⟩ = some ⟨cons false (L), cons false (R), .E⟩ := by
  have h0 : steps 1 ⟨L, cons false (cons false (R)), .D⟩ = some ⟨cons false (L), cons false (R), .E⟩ := rfl
  exact steps_congr trans (a := 1) (by omega) (h0)

/-- The right sweep: A crosses `11` pairs, turning each into `01`. -/
theorem sweep_d (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, true] (R), .A⟩ = some ⟨rep (n) [true, false] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .A⟩ = some ⟨app [] (app [true, false] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, true] (R), .A⟩ = some ⟨rep (n) [true, false] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- ...and `01` pairs into `11`. -/
theorem sweep_b (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [false, true] (R), .A⟩ = some ⟨rep (n) [true, true] (L), R, .A⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [false, true] R, .A⟩ = some ⟨app [] (app [true, true] L), R, .A⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [false, true] (R), .A⟩ = some ⟨rep (n) [true, true] (L), R, .A⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- The left pass: C, D, F walk left through 1s, writing a 0 every third cell. -/
theorem pass (n : Nat) (L R : Tape) :
    steps (3 * n) ⟨rep (n) [true, true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true, true] (R)), .C⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true, true, true] (L), cons true (R), .C⟩ = some ⟨L, cons true (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 3) (by omega) (h0)

/-- A block of length 3n+1 stops the pass: the head turns right (and the separator left of the block becomes 1). -/
theorem stop_1 (n : Nat) (L R : Tape) :
    steps (3 * n + 5) ⟨rep (n) [true, true, true] (cons false (L)), cons true (R), .C⟩ = some ⟨cons true (cons true (L)), rep (n) [false, true, true] (R), .A⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true, true, true] (cons false (L)), cons true (R), .C⟩ = some ⟨cons false (L), cons true (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons false (L)) (R)
  have h1 : steps 5 ⟨cons false (L), cons true (rep (n) [false, true, true] (R)), .C⟩ = some ⟨cons true (cons true (L)), rep (n) [false, true, true] (R), .A⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (5)) (by omega) (steps_seq trans h0 (h1))

/-- A block of length 3n+2 does not stop it: the pass goes on into the block to the left, in state D. -/
theorem cont_2 (n : Nat) (L R : Tape) :
    steps (3 * n + 3) ⟨rep (n) [true, true, true] (cons true (cons false (cons true (L)))), cons true (R), .C⟩ = some ⟨L, cons true (cons true (cons true (cons true (rep (n) [false, true, true] (R))))), .D⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true, true, true] (cons true (cons false (cons true (L)))), cons true (R), .C⟩ = some ⟨cons true (cons false (cons true (L))), cons true (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons true (cons false (cons true (L)))) (R)
  have h1 : steps 3 ⟨cons true (cons false (cons true (L))), cons true (rep (n) [false, true, true] (R)), .C⟩ = some ⟨L, cons true (cons true (cons true (cons true (rep (n) [false, true, true] (R))))), .D⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (3)) (by omega) (steps_seq trans h0 (h1))

/-- A block of length 3n+3 with a 1 left of its separator: C reads the separator, E the 1, and the pass ends (A next). -/
theorem stop_3 (n : Nat) (L R : Tape) :
    steps (3 * n + 4) ⟨rep (n) [true, true, true] (cons true (cons true (cons false (cons true (L))))), cons true (R), .C⟩ = some ⟨L, cons true (cons false (cons false (cons true (cons true (rep (n) [false, true, true] (R)))))), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true, true, true] (cons true (cons true (cons false (cons true (L))))), cons true (R), .C⟩ = some ⟨cons true (cons true (cons false (cons true (L)))), cons true (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons true (cons true (cons false (cons true (L))))) (R)
  have h1 : steps 4 ⟨cons true (cons true (cons false (cons true (L)))), cons true (rep (n) [false, true, true] (R)), .C⟩ = some ⟨L, cons true (cons false (cons false (cons true (cons true (rep (n) [false, true, true] (R)))))), .E⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (4)) (by omega) (steps_seq trans h0 (h1))

/-- ...but with `0 0` left of it (the leftmost block of the tape) E reads 0: the machine halts. -/
theorem halt_3 (n : Nat) (L R : Tape) :
    steps (3 * n + 4) ⟨rep (n) [true, true, true] (cons true (cons true (cons false (cons false (L))))), cons true (R), .C⟩ = some ⟨L, cons false (cons false (cons false (cons true (cons true (rep (n) [false, true, true] (R)))))), .E⟩ := by
  have c0 : ∀ L R : Tape, steps 3 ⟨app [true, true, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [false, true, true] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 3) ⟨rep (n) [true, true, true] (cons true (cons true (cons false (cons false (L))))), cons true (R), .C⟩ = some ⟨cons true (cons true (cons false (cons false (L)))), cons true (rep (n) [false, true, true] (R)), .C⟩ :=
    cross_l trans c0 (n) (cons true (cons true (cons false (cons false (L))))) (R)
  have h1 : steps 4 ⟨cons true (cons true (cons false (cons false (L)))), cons true (rep (n) [false, true, true] (R)), .C⟩ = some ⟨L, cons false (cons false (cons false (cons true (cons true (rep (n) [false, true, true] (R)))))), .E⟩ := rfl
  exact steps_congr trans (a := (n) * 3 + (4)) (by omega) (steps_seq trans h0 (h1))

end H157319
