    steps (4 * j + 13) ⟨cons true (cons false (P)), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨cons true (P), cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .C⟩ := by
