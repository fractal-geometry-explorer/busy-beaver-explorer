/-- The E-pass over an even block: `P E> 1^(2k)` to `P (01)^k C> 1 1`. -/
theorem epass_even (k : Nat) (P : Tape) :
    steps (2 * k + 2) ⟨P, rep (k) [true, true] (blank), .E⟩ = some ⟨rep (k) [true, false] (P), cons true (cons true (blank)), .C⟩ := by
  have hn : (k) * 2 + (2) = 2 * k + 2 := by omega
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((k) * 2) ⟨P, rep (k) [true, true] (blank), .E⟩ = some ⟨rep (k) [true, false] (P), blank, .E⟩ :=
    cross_r trans c0 (k) (P) (blank)
  have h1 : steps 2 ⟨rep (k) [true, false] (P), blank, .E⟩ = some ⟨rep (k) [true, false] (P), cons true (cons true (blank)), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- The E-pass over an odd block: `P E> 1^(2k+3)` to `P (01)^(k+1) 1 0 C> 1 1`. -/
theorem epass_odd (k : Nat) (P : Tape) :
    steps (2 * k + 14) ⟨P, cons true (rep (k + 1) [true, true] (blank)), .E⟩ = some ⟨cons false (cons true (cons true (cons false (rep (k) [true, false] (P))))), cons true (cons true (blank)), .C⟩ := by
  have hn : 0 + ((k + 1) * 2 + (12)) = 2 * k + 14 := by omega
  have h0 : steps 0 ⟨P, cons true (rep (k + 1) [true, true] (blank)), .E⟩ = some ⟨P, rep (k + 1) [true, true] (cons true (blank)), .E⟩ := by
    simp only [steps_zero, show cons true (rep (k + 1) [true, true] (blank)) = rep (k + 1) [true, true] (cons true (blank)) from
      rep_rotate (k + 1) [true] [true, true] [true, true] rfl (blank)]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((k + 1) * 2) ⟨P, rep (k + 1) [true, true] (cons true (blank)), .E⟩ = some ⟨rep (k + 1) [true, false] (P), cons true (blank), .E⟩ :=
    cross_r trans c1 (k + 1) (P) (cons true (blank))
  have h2 : steps 12 ⟨rep (k + 1) [true, false] (P), cons true (blank), .E⟩ = some ⟨cons false (cons true (cons true (cons false (rep (k) [true, false] (P))))), cons true (cons true (blank)), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


/-- Two `01` of the halved block become six more 1s: `P 0 1 0 1 C> 1^(2j+2)` to `P C> 1^(2j+8)`. -/
theorem pairs (j : Nat) (P : Tape) :
    steps (4 * j + 20) ⟨cons true (cons false (cons true (cons false (P)))), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨P, cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank))))))))), .C⟩ := by
  have hn : 7 + (0 + ((j) * 2 + (3 + (0 + ((j) * 2 + (10)))))) = 4 * j + 20 := by omega
  have h0 : steps 7 ⟨cons true (cons false (cons true (cons false (P)))), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨cons false (cons true (cons true (cons true (cons false (P))))), cons true (rep (j) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (cons true (cons true (cons false (P))))), cons true (rep (j) [true, true] (blank)), .B⟩ = some ⟨cons false (cons true (cons true (cons true (cons false (P))))), rep (j) [true, true] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (j) [true, true] (blank)) = rep (j) [true, true] (cons true (blank)) from
      rep_rotate (j) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [false, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((j) * 2) ⟨cons false (cons true (cons true (cons true (cons false (P))))), rep (j) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P)))))), cons true (blank), .B⟩ :=
    cross_r trans c2 (j) (cons false (cons true (cons true (cons true (cons false (P)))))) (cons true (blank))
  have h3 : steps 3 ⟨rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P)))))), cons true (blank), .B⟩ = some ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ := rfl
  have h4 : steps 0 ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ = some ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ := by
    simp only [steps_zero, show cons false (rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P))))))) = rep (j) [false, false] (cons false (cons false (cons true (cons true (cons true (cons false (P))))))) from
      rep_rotate (j) [false] [false, false] [false, false] rfl (cons false (cons true (cons true (cons true (cons false (P))))))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((j) * 2) ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ = some ⟨cons false (cons false (cons true (cons true (cons true (cons false (P)))))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ :=
    cross_l trans c5 (j) (cons false (cons false (cons true (cons true (cons true (cons false (P))))))) (cons true (blank))
  have h6 : steps 10 ⟨cons false (cons false (cons true (cons true (cons true (cons false (P)))))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ = some ⟨P, cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank))))))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


/-- One `01` left: `P 0 1 C> 1^(2j+2)` to `P 1 C> 1^(2j+5)`. -/
