/-- A 0 at the end of the left word with an even block: `P 0 C> 1^(2j+2)` to `P C> 1^(2j+5)`. -/
theorem r_zero (j : Nat) (P : Tape) :
    steps (4 * j + 9) ⟨cons false (P), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨P, cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .C⟩ := by
  have hn : 3 + (0 + ((j) * 2 + (3 + (0 + ((j) * 2 + (3)))))) = 4 * j + 9 := by omega
  have h0 : steps 3 ⟨cons false (P), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨cons false (cons true (P)), cons true (rep (j) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (P)), cons true (rep (j) [true, true] (blank)), .B⟩ = some ⟨cons false (cons true (P)), rep (j) [true, true] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (j) [true, true] (blank)) = rep (j) [true, true] (cons true (blank)) from
      rep_rotate (j) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [false, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((j) * 2) ⟨cons false (cons true (P)), rep (j) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (j) [false, false] (cons false (cons true (P))), cons true (blank), .B⟩ :=
    cross_r trans c2 (j) (cons false (cons true (P))) (cons true (blank))
  have h3 : steps 3 ⟨rep (j) [false, false] (cons false (cons true (P))), cons true (blank), .B⟩ = some ⟨cons false (rep (j) [false, false] (cons false (cons true (P)))), cons false (cons true (blank)), .D⟩ := rfl
  have h4 : steps 0 ⟨cons false (rep (j) [false, false] (cons false (cons true (P)))), cons false (cons true (blank)), .D⟩ = some ⟨rep (j) [false, false] (cons false (cons false (cons true (P)))), cons false (cons true (blank)), .D⟩ := by
    simp only [steps_zero, show cons false (rep (j) [false, false] (cons false (cons true (P)))) = rep (j) [false, false] (cons false (cons false (cons true (P)))) from
      rep_rotate (j) [false] [false, false] [false, false] rfl (cons false (cons true (P)))]
  have c5 : ∀ L R : Tape, steps 2 ⟨app [false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps ((j) * 2) ⟨rep (j) [false, false] (cons false (cons false (cons true (P)))), cons false (cons true (blank)), .D⟩ = some ⟨cons false (cons false (cons true (P))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ :=
    cross_l trans c5 (j) (cons false (cons false (cons true (P)))) (cons true (blank))
  have h6 : steps 3 ⟨cons false (cons false (cons true (P))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ = some ⟨P, cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (steps_seq trans h4 (steps_seq trans h5 (h6)))))))


