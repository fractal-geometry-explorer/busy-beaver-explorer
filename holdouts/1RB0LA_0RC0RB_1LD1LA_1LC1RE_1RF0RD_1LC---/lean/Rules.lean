  have h0 : steps 7 ⟨cons true (cons false (P)), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨cons false (cons true (cons true (P))), cons true (rep (j) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps 0 ⟨cons false (cons true (cons true (P))), cons true (rep (j) [true, true] (blank)), .B⟩ = some ⟨cons false (cons true (cons true (P))), rep (j) [true, true] (cons true (blank)), .B⟩ := by
