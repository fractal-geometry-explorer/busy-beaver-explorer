  have c2 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [false, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps ((j) * 2) ⟨cons false (cons true (cons true (P))), rep (j) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (j) [false, false] (cons false (cons true (cons true (P)))), cons true (blank), .B⟩ :=
    cross_r trans c2 (j) (cons false (cons true (cons true (P)))) (cons true (blank))
  have h3 : steps 3 ⟨rep (j) [false, false] (cons false (cons true (cons true (P)))), cons true (blank), .B⟩ = some ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ := rfl
  have h4 : steps 0 ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ = some ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ := by
    simp only [steps_zero, show cons false (rep (j) [false, false] (cons false (cons true (cons true (P))))) = rep (j) [false, false] (cons false (cons false (cons true (cons true (P))))) from
