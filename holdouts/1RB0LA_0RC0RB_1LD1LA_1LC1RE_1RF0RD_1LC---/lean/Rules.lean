  have h5 : steps ((j) * 2) ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ = some ⟨cons false (cons false (cons true (cons true (P)))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ :=
    cross_l trans c5 (j) (cons false (cons false (cons true (cons true (P))))) (cons true (blank))
  have h6 : steps 3 ⟨cons false (cons false (cons true (cons true (P)))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ = some ⟨cons true (P), cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .C⟩ := rfl
