/-! # Wall trips of any list of blocks

Generated by `rework_gen.py` from `rework_cases.txt` (`py/rework.py`); do not edit by hand.

The cases of the rounds of a wall trip (`py/rework.py`): left modes `LM`, right modes `RM`, pieces of tape `GF`, and
what each mode does at a block or a piece (`leftP`, `lastP`, `rxC`), each proved by its symbolic run (`rw_L*`,
`rw_R*`; `rw_ok`).  With `Sys.go_ok` of ReworkCore.lean that gives a round of the copy loop and the work before it
for any list of blocks (`round_ok`), all rounds (`iter_ok`), and with the start (`rw_T*`) and the end, the whole
trip: `wall_turn` (a trip after the counter's walk, through `counter_borrow_ex`) and `wall_last`. -/

namespace BB6e
open TM

namespace RW

inductive LM where
  | l0 | l1 | l2 | l3 | l4 | l5 | l6 | l7
  deriving DecidableEq

def LM.q : LM → St
  | .l0 => .B
  | .l1 => .B
  | .l2 => .B
  | .l3 => .D
  | .l4 => .B
  | .l5 => .D
  | .l6 => .C
  | .l7 => .C
def LM.lc : LM → List Bool
  | .l0 => []
  | .l1 => []
  | .l2 => [true]
  | .l3 => [true]
  | .l4 => [true]
  | .l5 => []
  | .l6 => []
  | .l7 => [true]
def LM.u : LM → Bool
  | .l0 => true
  | .l1 => false
  | .l2 => false
  | .l3 => false
  | .l4 => true
  | .l5 => false
  | .l6 => true
  | .l7 => true

inductive RM where
  | r0 | r1 | r2 | r3
  deriving DecidableEq

def RM.q : RM → St
  | .r0 => .B
  | .r1 => .C
  | .r2 => .E
  | .r3 => .A
def RM.c : RM → List Bool
  | .r0 => [true]
  | .r1 => []
  | .r2 => [true]
  | .r3 => []

inductive GF where
  | g0 | g1 | g2 | g3 | g4 | g5 | g6 | g7 | g8 | g9 | g10 | g11 | g12 | g13 | g14 | g15 | g16 | g17 | g18 | g19 | g20 | g21 | g22 | g23 | g24 | g25 | g26 | g27 | g28 | g29 | g30 | g31

/-- The pieces of tape right of the head, with their parameter, in front of `Y`. -/
def GF.T : GF → Nat → Tape → Tape
  | .g0, _, Y => cons false (cons false (cons true (cons false (Y))))
  | .g1, t, Y => cons false (cons false (cons false (rep (t) [true, false] (cons false (cons true (cons false (cons true (Y))))))))
  | .g2, t, Y => cons false (cons false (cons false (rep (t) [true, false] (cons true (cons false (cons true (cons false (cons false (cons false (cons false (Y)))))))))))
  | .g3, t, Y => cons false (cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (Y))))))
  | .g4, t, Y => rep (t) [true, false] (cons false (cons true (cons false (cons true (Y)))))
  | .g5, t, Y => cons false (cons false (rep (t) [true, false] (cons false (cons true (cons false (cons true (Y)))))))
  | .g6, t, Y => cons false (cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (cons true (Y)))))))
