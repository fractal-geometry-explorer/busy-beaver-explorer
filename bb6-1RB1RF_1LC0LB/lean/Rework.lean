theorem rotT (n : Nat) (s : Tape) : rep n Q' (cons true s) = cons true (rep n Q s) := (mvQ0 n s).symm
theorem rotP (n : Nat) (s : Tape) : rep n P' (cons true s) = cons true (rep n P s) := (mv01 n s).symm
theorem pp (n : Nat) (s : Tape) : cons false (cons true (rep n P s)) = rep n P (cons false (cons true s)) :=
  rep_rotate n P P P rfl s

def leftC (m : LM) (s : Bool) (b : Nat) : LRes LM RM GF := leftP m s (b % 2) (b / 2)
def lastC (m : LM) (b : Nat) : LRes LM RM GF := lastP m (b % 2) (b / 2)

/-- The cases as a `Sys`. -/
def sys : Sys where
  LM := LM
  RM := RM
  GF := GF
  lq := LM.q
  llc := LM.lc
  lu := LM.u
  rq := RM.q
  rc := RM.c
  gT := GF.T
  gF := GF.F
  leftC := leftC
  lastC := lastC
  rxC := rxC

theorem rw_raw_L1 (L R : Tape) :
    steps (1) ⟨cons false (L), cons true (R), .B⟩ = some ⟨L, cons false (cons false (R)), .B⟩ := by
  have hn : 1 = 1 := by omega
  have h0 : steps 1 ⟨cons false (L), cons true (R), .B⟩ = some ⟨L, cons false (cons false (R)), .B⟩ := rfl
  exact steps_congr trans hn (h0)

theorem rw_L2 (X Y : Tape) :
    ∃ k, steps k ⟨app [] (rep (2 * (0)) P (cons false X)), cons true Y, .B⟩ = some ⟨app [] X, cons false (GF.T .g9 0 Y), .B⟩ := by
  have h := rw_raw_L1 X Y
  have e0 : app [] (rep (2 * (0)) P (cons false X)) = cons false (X) := by first | (simp only [itp, rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, rotT, mv10, rotP, pp, cons_false_blank, Nat.mul_add, Nat.add_assoc]; done) | (simp only [itp, rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, rotT, mv10, rotP, pp, cons_false_blank, Nat.mul_add, Nat.add_assoc, rep_swap]; done)
  rw [e0]
  exact ⟨_, h⟩

theorem rw_raw_L3 (t : Nat) (L R : Tape) :
    steps (4 * t + 5) ⟨cons false (cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (L)))))), cons true (R), .B⟩ = some ⟨L, cons false (cons false (cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (R))))))), .B⟩ := by
  have hn : 1 + (0 + ((t) * 4 + (4))) = 4 * t + 5 := by omega
  have h0 : steps 1 ⟨cons false (cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (L)))))), cons true (R), .B⟩ = some ⟨cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (L))))), cons false (cons false (R)), .B⟩ := rfl
  have h1 : steps 0 ⟨cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (L))))), cons false (cons false (R)), .B⟩ = some ⟨rep (t) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))), cons false (cons false (R)), .B⟩ := by
    simp only [steps_zero, show cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (L))))) = rep (t) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))) from
      rep_rotate (t) [true, false, true] [false, true, false, true] [true, false, true, false] rfl (cons false (L))]
  have c2 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .B⟩ := fun _ _ => rfl
  have h2 : steps ((t) * 4) ⟨rep (t) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))), cons false (cons false (R)), .B⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), cons false (rep (t) [false, true, false, true] (cons false (R))), .B⟩ :=
    cross_l trans c2 (t) (cons true (cons false (cons true (cons false (L))))) (cons false (R))
  have h3 : steps 4 ⟨cons true (cons false (cons true (cons false (L)))), cons false (rep (t) [false, true, false, true] (cons false (R))), .B⟩ = some ⟨L, cons false (cons false (cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (R))))))), .B⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

theorem rw_L4 (t : Nat) (X Y : Tape) :
    ∃ k, steps k ⟨app [] (rep (2 * (t + 1)) P (cons false X)), cons true Y, .B⟩ = some ⟨app [] X, cons false (GF.T .g3 t Y), .B⟩ := by
  have h := rw_raw_L3 t X Y
  have e0 : app [] (rep (2 * (t + 1)) P (cons false X)) = cons false (cons true (cons false (cons true (rep (t) [false, true, false, true] (cons false (X)))))) := by first | (simp only [itp, rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, rotT, mv10, rotP, pp, cons_false_blank, Nat.mul_add, Nat.add_assoc]; done) | (simp only [itp, rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, rotT, mv10, rotP, pp, cons_false_blank, Nat.mul_add, Nat.add_assoc, rep_swap]; done)
  rw [e0]
