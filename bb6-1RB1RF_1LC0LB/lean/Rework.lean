  | .g8, t, Y => cons false (cons false (rep (t) [true, false] (cons true (cons false (cons true (cons false (cons false (cons false (cons false (Y))))))))))
  | .g9, _, Y => cons false (Y)
  | .g10, t, Y => cons false (cons true (rep (t) [false, true, false, true] (cons false (Y))))
