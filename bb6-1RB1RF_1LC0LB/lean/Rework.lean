/-- A block `(s, 2u + par)` with more blocks to its left, in a left mode. -/
def leftP : LM → Bool → Nat → Nat → LRes LM RM GF
  | .l0, false, 0, 0 => .cont .l1 .g9 0
  | .l0, false, 0, t + 1 => .cont .l1 .g3 t
  | .l0, false, 1, t => .cont .l5 .g14 t
  | .l0, true, 0, 0 => .cont .l0 .g9 0
  | .l0, true, 0, t + 1 => .cont .l0 .g3 t
  | .l0, true, 1, t => .refl .r2 [(false, 2 * t + 1)]
  | .l1, false, 0, t + 1 => .refl .r1 [(true, 1), (false, 2 * t + 1)]
  | .l1, false, 1, t => .refl .r1 [(true, 1), (false, 2 * t)]
  | .l1, true, 0, 0 => .cont .l6 .g27 0
  | .l1, true, 0, t + 1 => .refl .r1 [(true, 1), (true, 2 * t + 1)]
  | .l1, true, 1, t => .refl .r1 [(true, 1), (true, 2 * t)]
  | .l2, true, 0, 0 => .refl .r1 [(false, 1)]
  | .l2, true, 0, t + 1 => .refl .r1 [(false, 2 * t + 3)]
  | .l2, true, 1, t => .cont .l0 .g23 t
  | .l3, false, 0, 0 => .cont .l1 .g26 0
  | .l3, false, 0, t + 1 => .cont .l1 .g6 t
  | .l3, true, 0, 0 => .cont .l0 .g26 0
  | .l3, true, 0, t + 1 => .cont .l0 .g6 t
  | .l4, false, 0, 0 => .cont .l1 .g28 0
  | .l4, false, 0, t + 1 => .cont .l1 .g12 t
  | .l4, true, 0, 0 => .cont .l0 .g28 0
  | .l4, true, 0, t + 1 => .cont .l0 .g12 t
  | .l4, true, 1, t => .refl .r3 [(false, 2 * t + 2)]
  | .l5, false, 0, 0 => .cont .l1 .g27 0
  | .l5, false, 0, t + 1 => .cont .l1 .g15 t
  | .l5, false, 1, t => .cont .l5 .g21 t
  | .l5, true, 0, 0 => .cont .l0 .g27 0
  | .l5, true, 0, t + 1 => .cont .l0 .g15 t
  | .l5, true, 1, t => .cont .l1 .g14 t
  | .l6, false, 1, t => .cont .l1 .g14 t
