  | .g25, t, Y => rep (t) [false, true, false, true] (cons false (cons false (Y)))
  | .g26, _, Y => cons false (cons true (Y))
  | .g27, _, Y => cons true (Y)
  | .g28, _, Y => cons false (cons false (Y))
  | .g29, _, Y => cons false (cons true (Y))
  | .g30, _, Y => cons false (cons false (cons true (cons false (cons false (cons false (cons false (Y)))))))
  | .g31, _, Y => cons true (cons false (cons true (cons false (cons true (Y)))))
