          show (trigP_last true false ((2 * u + 1) % 2) ((2 * u + 1) / 2)).map (· ++ x' :: L) = _
          rw [show (2 * u + 1) % 2 = 1 by omega, show (2 * u + 1) / 2 = u by omega]] at h
        match u, h with
