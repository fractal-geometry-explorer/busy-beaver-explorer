  | .l6, true, 0, t + 1 => .refl .r2 [(false, 2 * t + 2)]
  | .l6, true, 1, t => .cont .l0 .g14 t
  | .l7, false, 1, t => .refl .r2 [(false, 0), (false, 2 * t + 1)]
  | .l7, true, 1, t => .refl .r2 [(false, 0), (true, 2 * t + 1)]
  | _, _, _, _ => .stuck

/-- The last block `(false, 2u + par)`, on blank tape. -/
def lastP : LM → Nat → Nat → LRes LM RM GF
  | .l0, 0, 0 => .refl .r2 [(false, 1)]
  | .l0, 0, t + 1 => .refl .r2 [(false, 2 * t + 3)]
  | .l0, 1, t => .refl .r2 [(true, 2 * t), (false, 3)]
  | .l1, 0, t + 1 => .refl .r1 [(true, 1), (false, 2 * t + 1)]
  | .l1, 1, t => .refl .r1 [(true, 1), (false, 2 * t)]
  | .l2, 0, t + 1 => .refl .r1 [(true, 2 * t + 2), (false, 3)]
  | .l4, 0, t + 1 => .refl .r3 [(false, 2 * t + 4)]
  | .l5, 0, t + 1 => .refl .r2 [(false, 2 * t + 4)]
  | .l5, 1, t + 1 => .refl .r2 [(false, 2 * t + 2), (false, 3)]
  | .l7, 1, t => .refl .r2 [(false, 0), (false, 2 * t + 1)]
  | _, _, _ => .stuck

