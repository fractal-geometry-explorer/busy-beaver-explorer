  have h : ∀ R : Tape, ∃ m, steps m ⟨rep (x4) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (x3) [false, true, false, true] (cons false (cons true (cons false (rep (1) [false, true] (cons true (rep (x2) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank))))))))))))))))))))))))))))))))), W5 (cons false (cons true R)), .C⟩ = some ⟨F3 (rep (2 * x4 + 2) P (cons true (rep (2 * x2 + 7) P (cons true (rep (2 * x1 + 1) P (cons true (rep (2 * (x0 + 2 * x3) + 10) P (blank)))))))), R, .C⟩ := by
