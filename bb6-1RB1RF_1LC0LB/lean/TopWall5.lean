theorem top_piece_41 (x0 x1 x2 x3 x4 : Nat) (R : Tape) :
    ∃ n, steps n ⟨rep (x4) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (x3) [false, true, false, true] (cons false (cons true (cons false (rep (1) [false, true] (cons true (rep (x2) [false, true, false, true] (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank))))))))))))))))))))))))))))))))), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (x4) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2 + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (rep (x1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep ((x0 + 2 * x3 + 4)) [true, false, true, false] (cons true (blank)))))))))))))))))))))))))))))), R, .C⟩ := by
  have h0 := top_piece_41_0 x0 x1 x2 x3 x4 R
  rw [show cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (x0) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (cons false (rep (x1) [true, false, true, false] (cons false (cons true (cons false (cons true (cons false (cons true (rep (x2) [false, true, false, true] (cons false (cons true (cons false (cons false (rep (x3) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (cons false (cons true (cons false (rep (x4) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))))))))))))))))))))))))))))))))))) = Rd (x0 + 2) [x1, x2 + 1] (2 * x3 + 2) (cons false (cons true (cons false (cons true (cons false (rep (x4) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))) by
