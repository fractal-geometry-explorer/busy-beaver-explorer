    cross_l trans c0 (d + 1) (cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))))) (cons true (cons false (cons false (cons true (R)))))
  have h1 : steps 5 ⟨cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L))))))), cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (cons true (R)))))), .C⟩ = some ⟨rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))), cons true (cons true (cons false (cons true (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (cons true (R))))))))))), .B⟩ := rfl
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .B⟩ := fun _ _ => rfl
