    cross_l trans c2 (a) (cons false (cons true (cons true (L)))) (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))
  have h3 : steps 7 ⟨cons false (cons true (cons true (L))), cons true (rep (a) [true, false, true, false] (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons false (L)))), rep (a) [true, false, true, false] (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))), .E⟩ := rfl
  have c4 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, false, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h4 : steps ((a) * 4) ⟨cons true (cons false (cons true (cons false (L)))), rep (a) [true, false, true, false] (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))), .E⟩ = some ⟨rep (a) [true, false, true, false] (cons true (cons false (cons true (cons false (L))))), cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))), .E⟩ :=
