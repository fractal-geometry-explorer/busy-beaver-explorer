import Machine

/-! # Sweep rules

Generated by `rules.py` (tools/py/bbtools/symtm.py); do not edit by hand.  The tape is made of pairs `10`; a sweep to
the right in E and a sweep to the left in B and D each shift the pairs they cross by one cell, and E marks each block
boundary it crosses, turning `0 10` into `0 11`.  An E that reaches `0 11` instead halts two steps later
(`Blank.lean`, `halt_shape`), so a mark left in E's way is the only way the machine can stop. -/

namespace BB6e

open TM

/-- E runs right over pairs `10`, shifting each one cell to the right (`E1 → 0RC`, `C0 → 1RE`), 2 steps a pair. -/
theorem e_run (n : Nat) (L R : Tape) :
    steps (2 * n) ⟨L, rep (n) [true, false] (R), .E⟩ = some ⟨rep (n) [true, false] (L), R, .E⟩ := by
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, false] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 2) ⟨L, rep (n) [true, false] (R), .E⟩ = some ⟨rep (n) [true, false] (L), R, .E⟩ :=
    cross_r trans c0 (n) (L) (R)
  exact steps_congr trans (a := (n) * 2) (by omega) (h0)

/-- E at a block boundary `0 10` marks it: the pair after the 0 becomes `11`, and E goes on (`E0`, `A1`, `F0`). -/
theorem e_mark (L R : Tape) :
    steps (3) ⟨L, cons false (cons true (cons false (R))), .E⟩ = some ⟨cons true (cons true (cons false (L))), R, .E⟩ := by
  have h0 : steps 3 ⟨L, cons false (cons true (cons false (R))), .E⟩ = some ⟨cons true (cons true (cons false (L))), R, .E⟩ := rfl
  exact steps_congr trans (a := 3) (by omega) (h0)

/-- B runs left over pairs, two at a time, shifting each one cell to the right (`B0 → 1LC`, `C1 → 0LD`, `D0 → 1LB`, `B1 → 0LB`), 4 steps per two pairs; in between, the head is in D. -/
theorem b_run (n : Nat) (L R : Tape) :
    steps (4 * n) ⟨rep (n) [true, false, true, false] (cons true (L)), cons false (R), .B⟩ = some ⟨cons true (L), cons false (rep (n) [false, true, false, true] (R)), .B⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .B⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .B⟩ := fun _ _ => rfl
  have h0 : steps ((n) * 4) ⟨rep (n) [true, false, true, false] (cons true (L)), cons false (R), .B⟩ = some ⟨cons true (L), cons false (rep (n) [false, true, false, true] (R)), .B⟩ :=
    cross_l trans c0 (n) (cons true (L)) (R)
  exact steps_congr trans (a := (n) * 4) (by omega) (h0)

end BB6e
