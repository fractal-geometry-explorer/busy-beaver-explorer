  have h0 : steps 10 ⟨rep (d + 1) [false, true, false, true] (cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))))), cons false (cons true (blank)), .C⟩ = some ⟨rep (d + 1) [false, true, false, true] (cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))))), cons true (cons true (cons false (cons true (cons false (cons true (blank)))))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((d + 1) * 4) ⟨rep (d + 1) [false, true, false, true] (cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))))), cons true (cons true (cons false (cons true (cons false (cons true (blank)))))), .C⟩ = some ⟨cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L))))))), cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank))))))), .C⟩ :=
    cross_l trans c1 (d + 1) (cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))))) (cons true (cons false (cons true (cons false (cons true (blank))))))
  have h2 : steps 5 ⟨cons false (rep (c + 1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L))))))), cons true (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank))))))), .C⟩ = some ⟨rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))), cons true (cons true (cons false (cons true (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), .B⟩ := rfl
  have c3 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .B⟩ := fun _ _ => rfl
  have h3 : steps ((c) * 4) ⟨rep (c) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (L)))))), cons true (cons true (cons false (cons true (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank)))))))))))), .B⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (L))))), cons true (rep (c) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (blank))))))))))))), .B⟩ :=
