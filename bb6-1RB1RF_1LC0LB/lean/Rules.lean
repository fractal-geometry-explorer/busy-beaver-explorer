  have h1 : steps 3 ⟨cons true (rep (a + 1) [false, true, false, true] (cons false (L))), cons true (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ = some ⟨cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (L)))), rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .E⟩ := rfl
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, false, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h2 : steps ((b) * 4) ⟨cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (L)))), rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .E⟩ = some ⟨rep (b) [true, false, true, false] (cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (L))))), cons true (cons false (cons false (cons true (cons false (cons true (R)))))), .E⟩ :=
