    cross_l trans c2 (c) (cons false (cons false (cons true (cons false (cons true (L)))))) (cons true (cons false (cons true (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (cons true (R)))))))))))
  have h3 : steps 5 ⟨cons false (cons false (cons true (cons false (cons true (L))))), cons true (rep (c) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (cons true (R)))))))))))), .B⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (L)))))), rep (c) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (rep (d + 1) [true, false, true, false] (cons true (cons false (cons false (cons true (R))))))))))), .E⟩ := rfl
  have c4 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, false, true, false] L), R, .E⟩ := fun _ _ => rfl
