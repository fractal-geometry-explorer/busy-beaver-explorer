  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((b) * 4) ⟨rep (b) [false, true, false, true] (cons false (cons true (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))))))), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))), cons true (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ :=
    cross_l trans c0 (b) (cons false (cons true (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))))))) (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))
  have h1 : steps 3 ⟨cons false (cons true (cons true (rep (a) [false, true, false, true] (cons false (cons true (cons true (L))))))), cons true (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ = some ⟨rep (a) [false, true, false, true] (cons false (cons true (cons true (L)))), cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))), .B⟩ := rfl
