    steps (8 * b + 9) ⟨rep (b) [false, true, false, true] (cons true (rep (a + 1) [false, true, false, true] (cons false (L)))), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (b) [true, false, true, false] (cons true (cons false (rep (a + 1) [false, true, false, true] (cons false (L))))))))))), R, .C⟩ := by
