import Counter

/-! # The top of the counter

Generated by `top_gen.py` from the shapes in `top_shapes.txt` (found by `py/top.py shapes`); do not edit by hand.

The trips from the right end that `Counter.lean` does not cover end at the left end of the tape or at a level of
the wrong parity.  Each such trip is the counter's walk over standard digit-0 levels, then a *top piece*, then the
counter's sweep back; or, when the last level is not standard, a piece that is the whole trip.  For every piece
seen in the run to 10^11 steps there is a theorem here: `top_piece_i`, the run itself, and `top_i`, the whole trip
with the tape written as blocks of pairs (`rep n P`) and seps.  Lengths are variables wherever the run does not
depend on them.  Kernel only. -/

set_option linter.unusedSimpArgs false
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

namespace BB6e

open TM


/-- The run of top piece 0 (turn: L 1 2*x0  ->  L 0 2*x0+2). -/
theorem top_piece_0 (x0 : Nat) (L R : Tape) :
    steps ((x0) * 4 + (3 + ((x0) * 4 + (6)))) ⟨rep (x0) [false, true, false, true] (cons true (L)), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (x0) [true, false, true, false] (cons true (cons false (L))))))))), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((x0) * 4) ⟨rep (x0) [false, true, false, true] (cons true (L)), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons true (L), cons true (rep (x0) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ :=
    cross_l trans c0 (x0) (cons true (L)) (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))
  have h1 : steps 3 ⟨cons true (L), cons true (rep (x0) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ = some ⟨cons true (cons false (L)), rep (x0) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .E⟩ := rfl
  have c2 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, false, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h2 : steps ((x0) * 4) ⟨cons true (cons false (L)), rep (x0) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .E⟩ = some ⟨rep (x0) [true, false, true, false] (cons true (cons false (L))), cons true (cons false (cons false (cons true (cons false (cons true (R)))))), .E⟩ :=
    cross_r trans c2 (x0) (cons true (cons false (L))) (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))
  have h3 : steps 6 ⟨rep (x0) [true, false, true, false] (cons true (cons false (L))), cons true (cons false (cons false (cons true (cons false (cons true (R)))))), .E⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (x0) [true, false, true, false] (cons true (cons false (L))))))))), R, .C⟩ := rfl
  exact (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (h3))))

/-- Top piece 0 after a borrow: turn: L 1 2*x0  ->  L 0 2*x0+2. -/
theorem top_0 (x0 : Nat) (c d : Nat) (zs : List (Nat × Nat)) (L : Tape) :
    ∃ n, steps n ⟨lv false false (2 * c + 2) (2 * d + 2) (Zs zs (rep (2 * x0 + 2) P (cons true (L)))), R0, .C⟩
      = some ⟨lv true true (2 * c + 3) (2 * d + 3) (Rs zs (rep (2 * x0 + 2) P (cons false (L)))), R0, .C⟩ := by
  have e1 : rep (2 * x0 + 2) P (cons true (L)) = app Q (rep (x0) [false, true, false, true] (cons true (L))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
  have h : ∀ R : Tape, steps ((x0) * 4 + (3 + ((x0) * 4 + (6)))) ⟨rep (x0) [false, true, false, true] (cons true (L)), W5 (cons false (cons true R)), .C⟩ = some ⟨F3 (rep (2 * x0 + 2) P (cons false (L))), R, .C⟩ := by
    intro R
    have h := top_piece_0 x0 L R
    have e2 : cons false (cons true (cons true (cons false (cons true (cons false (rep (x0) [true, false, true, false] (cons true (cons false (L))))))))) = F3 (rep (2 * x0 + 2) P (cons false (L))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
    rw [e2] at h; exact h
  rw [e1]; exact counter_borrow_any c d zs h ⟨_, rfl⟩

/-- The run of top piece 1 (turn: 0^inf 2*x0+1 1 2*x1+1 0 2*x2+2  ->  0^inf 2*x0 1 2*x1+3 1 2*x2+3). -/
theorem top_piece_1 (x0 x1 x2 : Nat) (R : Tape) :
    steps ((x2) * 4 + (7 + ((x1) * 4 + (3 + ((x1) * 4 + (2 + ((x1) * 4 + (7 + ((x1) * 4 + (6 + ((x2) * 4 + (6)))))))))))) ⟨rep (x2) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank))))))))))))), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank)))))))))))))))))))), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((x2) * 4) ⟨rep (x2) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank))))))))))))), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))))))))), cons true (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ :=
    cross_l trans c0 (x2) (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank))))))))))))) (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))
  have h1 : steps 7 ⟨cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))))))))), cons true (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ = some ⟨rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank))))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))), .C⟩ := rfl
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h2 : steps ((x1) * 4) ⟨rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank))))), cons true (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))), .C⟩ = some ⟨cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank)))), cons true (rep (x1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))))), .C⟩ :=
    cross_l trans c2 (x1) (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank))))) (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))))
  have h3 : steps 3 ⟨cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank)))), cons true (rep (x1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))))), .C⟩ = some ⟨cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank))))), rep (x1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))), .E⟩ := rfl
  have c4 : ∀ L R : Tape, steps 4 ⟨app [] L, app [true, false, true, false] R, .E⟩ = some ⟨app [] (app [true, false, true, false] L), R, .E⟩ := fun _ _ => rfl
  have h4 : steps ((x1) * 4) ⟨cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank))))), rep (x1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))), .E⟩ = some ⟨rep (x1) [true, false, true, false] (cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))), cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))), .E⟩ :=
    cross_r trans c4 (x1) (cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))) (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))))
  have h5 : steps 2 ⟨rep (x1) [true, false, true, false] (cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))), cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))), .E⟩ = some ⟨rep (x1) [true, false, true, false] (cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))), cons false (cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))), .D⟩ := rfl
  have c6 : ∀ L R : Tape, steps 4 ⟨app [true, false, true, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [false, true, false, true] R), .D⟩ := fun _ _ => rfl
  have h6 : steps ((x1) * 4) ⟨rep (x1) [true, false, true, false] (cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))), cons false (cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))), .D⟩ = some ⟨cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank))))), cons false (rep (x1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))), .D⟩ :=
    cross_l trans c6 (x1) (cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))) (cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))
  have h7 : steps 7 ⟨cons true (cons false (cons false (cons true (rep (x0) [false, true, false, true] (blank))))), cons false (rep (x1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))))), .D⟩ = some ⟨cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank)))))), rep (x1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))), .C⟩ := rfl
  have c8 : ∀ L R : Tape, steps 4 ⟨app [] L, app [false, true, false, true] R, .C⟩ = some ⟨app [] (app [false, true, false, true] L), R, .C⟩ := fun _ _ => rfl
  have h8 : steps ((x1) * 4) ⟨cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank)))))), rep (x1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))), .C⟩ = some ⟨rep (x1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank))))))), cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))), .C⟩ :=
