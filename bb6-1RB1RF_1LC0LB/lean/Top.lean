  have h9 : steps 6 ⟨rep (x1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank))))))), cons false (cons false (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))), .C⟩ = some ⟨cons true (cons false (cons true (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank))))))))))))), rep (x2) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .E⟩ := rfl
