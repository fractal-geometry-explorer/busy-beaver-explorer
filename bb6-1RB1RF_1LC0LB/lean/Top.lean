    have e2 : cons false (cons true (cons true (cons false (cons true (cons false (rep (x1) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (x0) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (cons true (L)))))))))))))))))))) = F3 (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 3) P (cons true (cons true (L)))))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
