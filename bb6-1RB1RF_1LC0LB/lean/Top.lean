/-- Top piece 1 after a borrow: turn: 0^inf 2*x0+1 1 2*x1+1 0 2*x2+2  ->  0^inf 2*x0 1 2*x1+3 1 2*x2+3. -/
theorem top_1 (x0 x1 x2 : Nat) (c d : Nat) (zs : List (Nat × Nat)) :
    ∃ n, steps n ⟨lv false false (2 * c + 2) (2 * d + 2) (Zs zs (rep (2 * x2 + 4) P (cons false (rep (2 * x1 + 1) P (cons true (rep (2 * x0 + 1) P (blank))))))), R0, .C⟩
      = some ⟨lv true true (2 * c + 3) (2 * d + 3) (Rs zs (rep (2 * x2 + 3) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0) P (blank))))))), R0, .C⟩ := by
  have e1 : rep (2 * x2 + 4) P (cons false (rep (2 * x1 + 1) P (cons true (rep (2 * x0 + 1) P (blank))))) = app Q (rep (x2) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank)))))))))))))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
  have h : ∀ R : Tape, steps ((x2) * 4 + (7 + ((x1) * 4 + (3 + ((x1) * 4 + (2 + ((x1) * 4 + (7 + ((x1) * 4 + (6 + ((x2) * 4 + (6)))))))))))) ⟨rep (x2) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (blank))))))))))))), W5 (cons false (cons true R)), .C⟩ = some ⟨F3 (rep (2 * x2 + 3) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0) P (blank)))))), R, .C⟩ := by
    intro R
    have h := top_piece_1 x0 x1 x2 R
    have e2 : cons false (cons true (cons true (cons false (cons true (cons false (rep (x2) [true, false, true, false] (cons true (cons false (cons true (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons true (cons false (cons true (cons true (rep (x0) [false, true, false, true] (blank)))))))))))))))))))) = F3 (rep (2 * x2 + 3) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0) P (blank)))))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
    rw [e2] at h; exact h
  rw [e1]; exact counter_borrow_any c d zs h ⟨_, rfl⟩

/-- The run of top piece 2 (turn: 0^inf 2*x0+1 1 2*x1+1  ->  0^inf 3 1 2*x0+1 1 2*x1+2). -/
theorem top_piece_2 (x0 x1 : Nat) (R : Tape) :
    steps ((x1) * 4 + (3 + ((x0) * 4 + (19 + ((x0) * 4 + (3 + ((x1) * 4 + (6)))))))) ⟨rep (x1) [false, true, false, true] (cons false (cons true (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank))))))), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (cons false (cons true (cons false (rep (x1) [true, false, true, false] (cons true (cons true (cons false (rep (x0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))))))))), R, .C⟩ := by
  have c0 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .C⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .C⟩ := fun _ _ => rfl
  have h0 : steps ((x1) * 4) ⟨rep (x1) [false, true, false, true] (cons false (cons true (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank))))))), cons true (cons true (cons false (cons false (cons true (cons false (cons true (R))))))), .C⟩ = some ⟨cons false (cons true (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank)))))), cons true (rep (x1) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ :=
    cross_l trans c0 (x1) (cons false (cons true (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank))))))) (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))
  have h1 : steps 3 ⟨cons false (cons true (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank)))))), cons true (rep (x1) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))), .C⟩ = some ⟨rep (x0) [false, true, false, true] (cons false (cons true (blank))), cons true (cons false (cons true (cons false (rep (x1) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))), .B⟩ := rfl
  have c2 : ∀ L R : Tape, steps 4 ⟨app [false, true, false, true] L, app [true] R, .B⟩ = some ⟨L, app [true] (app [true, false, true, false] R), .B⟩ := fun _ _ => rfl
