    ∃ n, steps n ⟨lv false false (2 * c + 2) (2 * d + 2) (Zs zs (rep (2) P (cons true (L)))), R0, .C⟩
      = some ⟨lv true true (2 * c + 3) (2 * d + 3) (Rs zs (rep (2) P (cons false (L)))), R0, .C⟩ := by
  have e1 : rep (2) P (cons true (L)) = app Q (cons true (L)) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
  have h : ∀ R : Tape, steps (9) ⟨cons true (L), W5 (cons false (cons true R)), .C⟩ = some ⟨F3 (rep (2) P (cons false (L))), R, .C⟩ := by
    intro R
    have h := top_piece_7  L R
    have e2 : cons false (cons true (cons true (cons false (cons true (cons false (cons true (cons false (L)))))))) = F3 (rep (2) P (cons false (L))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
    rw [e2] at h; exact h
  rw [e1]; exact counter_borrow_any c d zs h ⟨_, rfl⟩

