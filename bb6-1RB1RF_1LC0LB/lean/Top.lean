/-- Top piece 12 after a borrow: turn: L 1 2*x0+2 0 2*x1+2 0  ->  L 0 2*x0+2 1 2*x1+3 1 1. -/
theorem top_12 (x0 x1 : Nat) (c d : Nat) (zs : List (Nat × Nat)) (L : Tape) :
    ∃ n, steps n ⟨lv false false (2 * c + 2) (2 * d + 2) (Zs zs (rep (2) P (cons false (rep (2 * x1 + 2) P (cons false (rep (2 * x0 + 2) P (cons true (L)))))))), R0, .C⟩
      = some ⟨lv true true (2 * c + 3) (2 * d + 3) (Rs zs (rep (1) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 2) P (cons false (L)))))))), R0, .C⟩ := by
  have e1 : rep (2) P (cons false (rep (2 * x1 + 2) P (cons false (rep (2 * x0 + 2) P (cons true (L)))))) = app Q (cons false (cons false (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (rep (x0) [false, true, false, true] (cons true (L)))))))))))))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
  have h : ∀ R : Tape, steps (5 + ((x1) * 4 + (5 + ((x1) * 4 + (6 + ((x1) * 4 + (6 + ((x0) * 4 + (3 + ((x0) * 4 + (6 + ((x1) * 4 + (10))))))))))))) ⟨cons false (cons false (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons false (cons true (cons false (cons true (rep (x0) [false, true, false, true] (cons true (L))))))))))))), W5 (cons false (cons true R)), .C⟩ = some ⟨F3 (rep (1) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 2) P (cons false (L))))))), R, .C⟩ := by
    intro R
    have h := top_piece_12 x0 x1 L R
    have e2 : cons false (cons true (cons true (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (rep (x0) [true, false, true, false] (cons true (cons false (L)))))))))))))))))))) = F3 (rep (1) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 2) P (cons false (L))))))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
    rw [e2] at h; exact h
  rw [e1]; exact counter_borrow_any c d zs h ⟨_, rfl⟩

