/-- Top piece 2 after a borrow: turn: 0^inf 2*x0+1 1 2*x1+1  ->  0^inf 3 1 2*x0+1 1 2*x1+2. -/
theorem top_2 (x0 x1 : Nat) (c d : Nat) (zs : List (Nat × Nat)) :
    ∃ n, steps n ⟨lv false false (2 * c + 2) (2 * d + 2) (Zs zs (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 1) P (blank))))), R0, .C⟩
      = some ⟨lv true true (2 * c + 3) (2 * d + 3) (Rs zs (rep (2 * x1 + 2) P (cons true (rep (2 * x0 + 1) P (cons true (rep (3) P (blank))))))), R0, .C⟩ := by
  have e1 : rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 1) P (blank))) = app Q (rep (x1) [false, true, false, true] (cons false (cons true (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank)))))))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
  have h : ∀ R : Tape, steps ((x1) * 4 + (3 + ((x0) * 4 + (19 + ((x0) * 4 + (3 + ((x1) * 4 + (6)))))))) ⟨rep (x1) [false, true, false, true] (cons false (cons true (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank))))))), W5 (cons false (cons true R)), .C⟩ = some ⟨F3 (rep (2 * x1 + 2) P (cons true (rep (2 * x0 + 1) P (cons true (rep (3) P (blank)))))), R, .C⟩ := by
    intro R
    have h := top_piece_2 x0 x1 R
    have e2 : cons false (cons true (cons true (cons false (cons true (cons false (rep (x1) [true, false, true, false] (cons true (cons true (cons false (rep (x0) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (cons true (blank))))))))))))))))))) = F3 (rep (2 * x1 + 2) P (cons true (rep (2 * x0 + 1) P (cons true (rep (3) P (blank)))))) := by simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]
    rw [e2] at h; exact h
  rw [e1]; exact counter_borrow_any c d zs h ⟨_, rfl⟩

