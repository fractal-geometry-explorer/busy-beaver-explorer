    ∃ n, steps n ⟨lv false false (2 * c + 2) (2 * d + 2) (Zs zs (rep (2 * x2 + 4) P (cons false (rep (2 * x1 + 1) P (cons true (rep (2 * x0 + 2) P (cons true (L)))))))), R0, .C⟩
