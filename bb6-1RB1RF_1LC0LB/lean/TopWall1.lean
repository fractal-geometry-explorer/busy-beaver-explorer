  rw [show Rd (2 * x3 + 3) [x0 + 1, x1 + 1, x2 + 1] 0 (cons false (cons true (cons false (cons true (cons false (rep (x4) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R))))))))))))) = cons false (rep ((2 * x3 + 3)) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (rep (x0 + 1) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (rep (x1 + 1) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (rep (x2 + 1) [true, false, true, false] (cons true (cons false (cons false (cons false (cons false (cons true (cons false (cons true (cons false (rep (x4) [true, false, true, false] (cons true (cons false (cons false (cons true (cons false (cons true (R)))))))))))))))))))))))))))))))))))) by
    simp only [Rd, WBs, WB, WX, rep_add, rep_succ, rep_zero, app_cons, app_nil, rpq, rpq0, mv10, mv01, mvQ, mvQ0]] at h1
  have h2 := top_piece_29_1 x0 x1 x2 x4 (2 * x3 + 3) R
  exact ⟨_, steps_seq trans h0 (steps_seq trans h1 (h2))⟩

/-- Top piece 29 after a borrow, building a wall: turn: 0^inf 2*x0+2 1 2*x1+2 1 2*x2+1 1 1 0 2*x3+8 0 2*x4+2  ->  0^inf 4*x3+8 1 2*x0+4 1 2*x1+3 1 2*x2+7 1 2*x4+2. -/
theorem top_29 (x0 x1 x2 x3 x4 : Nat) (c d : Nat) (zs : List (Nat × Nat)) :
    ∃ n, steps n ⟨lv false false (2 * c + 2) (2 * d + 2) (Zs zs (rep (2 * x4 + 4) P (cons false (rep (2 * x3 + 8) P (cons false (rep (1) P (cons true (rep (2 * x2 + 1) P (cons true (rep (2 * x1 + 2) P (cons true (rep (2 * x0 + 2) P (blank))))))))))))), R0, .C⟩
      = some ⟨lv true true (2 * c + 3) (2 * d + 3) (Rs zs (rep (2 * x4 + 2) P (cons true (rep (2 * x2 + 7) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 4) P (cons true (rep (2 * (2 * x3) + 8) P (blank))))))))))), R0, .C⟩ := by
  have e1 : rep (2 * x4 + 4) P (cons false (rep (2 * x3 + 8) P (cons false (rep (1) P (cons true (rep (2 * x2 + 1) P (cons true (rep (2 * x1 + 2) P (cons true (rep (2 * x0 + 2) P (blank))))))))))) = app Q (rep (x4) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x3) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (1) [false, true] (cons true (rep (x2) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank)))))))))))))))))))))))))))))))))))))))))) := by first | (simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]; done) | simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3, rep_swap]
  have h : ∀ R : Tape, ∃ m, steps m ⟨rep (x4) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons false (cons true (rep (x3) [false, true, false, true] (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons false (rep (1) [false, true] (cons true (rep (x2) [false, true, false, true] (cons false (cons true (cons true (cons false (cons true (cons false (cons true (rep (x1) [false, true, false, true] (cons true (cons false (cons true (rep (x0) [false, true, false, true] (cons false (cons true (blank))))))))))))))))))))))))))))))))))))))))), W5 (cons false (cons true R)), .C⟩ = some ⟨F3 (rep (2 * x4 + 2) P (cons true (rep (2 * x2 + 7) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 4) P (cons true (rep (2 * (2 * x3) + 8) P (blank)))))))))), R, .C⟩ := by
    intro R
    obtain ⟨m, h⟩ := top_piece_29 x0 x1 x2 x3 x4 R
    have e2 : cons false (cons true (cons true (cons false (cons true (cons false (rep (x4) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (cons true (cons false (rep (x2 + 1) [true, false, true, false] (cons true (cons false (cons true (cons false (cons true (cons true (cons false (rep (x1 + 1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep (x0 + 1) [true, false, true, false] (cons true (cons true (cons false (cons true (cons false (rep ((2 * x3 + 3)) [true, false, true, false] (cons true (blank)))))))))))))))))))))))))))))))))))) = F3 (rep (2 * x4 + 2) P (cons true (rep (2 * x2 + 7) P (cons true (rep (2 * x1 + 3) P (cons true (rep (2 * x0 + 4) P (cons true (rep (2 * (2 * x3) + 8) P (blank)))))))))) := by first | (simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3]; done) | simp only [rep_add, rq, rep_succ, rep_zero, app_cons, app_nil, pq, rotf, F3, rep_swap]
    rw [e2] at h; exact ⟨m, h⟩
  rw [e1]; exact counter_borrow_ex c d zs h ⟨_, rfl⟩

