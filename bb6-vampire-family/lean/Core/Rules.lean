import Core.Machine

/-! Rules of the core that hold for every left tape `P` and every F0 (they never read F0), generated by `py/gen.py` with `bbtools.symtm`; do not edit by hand. -/

namespace Core

open TM

section
variable (f0 : Bool × Dir × St)

/-- Two `01` of the halved block become six more 1s: `P 0 1 0 1 C> 1^(2j+2)` to `P C> 1^(2j+8)`. -/
theorem pairs (j : Nat) (P : Tape) :
    steps f0 (4 * j + 20) ⟨cons true (cons false (cons true (cons false (P)))), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨P, cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank))))))))), .C⟩ := by
  have hn : 7 + (0 + ((j) * 2 + (3 + (0 + ((j) * 2 + (10)))))) = 4 * j + 20 := by omega
  have h0 : steps f0 7 ⟨cons true (cons false (cons true (cons false (P)))), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨cons false (cons true (cons true (cons true (cons false (P))))), cons true (rep (j) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps f0 0 ⟨cons false (cons true (cons true (cons true (cons false (P))))), cons true (rep (j) [true, true] (blank)), .B⟩ = some ⟨cons false (cons true (cons true (cons true (cons false (P))))), rep (j) [true, true] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (j) [true, true] (blank)) = rep (j) [true, true] (cons true (blank)) from
      rep_rotate (j) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps f0 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [false, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps f0 ((j) * 2) ⟨cons false (cons true (cons true (cons true (cons false (P))))), rep (j) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P)))))), cons true (blank), .B⟩ :=
    cross_r (trans f0) c2 (j) (cons false (cons true (cons true (cons true (cons false (P)))))) (cons true (blank))
  have h3 : steps f0 3 ⟨rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P)))))), cons true (blank), .B⟩ = some ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ := rfl
  have h4 : steps f0 0 ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ = some ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ := by
    simp only [steps_zero, show cons false (rep (j) [false, false] (cons false (cons true (cons true (cons true (cons false (P))))))) = rep (j) [false, false] (cons false (cons false (cons true (cons true (cons true (cons false (P))))))) from
      rep_rotate (j) [false] [false, false] [false, false] rfl (cons false (cons true (cons true (cons true (cons false (P))))))]
  have c5 : ∀ L R : Tape, steps f0 2 ⟨app [false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps f0 ((j) * 2) ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (cons true (cons false (P))))))), cons false (cons true (blank)), .D⟩ = some ⟨cons false (cons false (cons true (cons true (cons true (cons false (P)))))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ :=
    cross_l (trans f0) c5 (j) (cons false (cons false (cons true (cons true (cons true (cons false (P))))))) (cons true (blank))
  have h6 : steps f0 10 ⟨cons false (cons false (cons true (cons true (cons true (cons false (P)))))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ = some ⟨P, cons true (cons true (cons true (cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank))))))))), .C⟩ := rfl
  exact steps_congr (trans f0) hn (steps_seq (trans f0) h0 (steps_seq (trans f0) h1 (steps_seq (trans f0) h2 (steps_seq (trans f0) h3 (steps_seq (trans f0) h4 (steps_seq (trans f0) h5 (h6)))))))


/-- One `01` left: `P 0 1 C> 1^(2j+2)` to `P 1 C> 1^(2j+5)`. -/
theorem one_pair (j : Nat) (P : Tape) :
    steps f0 (4 * j + 13) ⟨cons true (cons false (P)), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨cons true (P), cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .C⟩ := by
  have hn : 7 + (0 + ((j) * 2 + (3 + (0 + ((j) * 2 + (3)))))) = 4 * j + 13 := by omega
  have h0 : steps f0 7 ⟨cons true (cons false (P)), rep (j + 1) [true, true] (blank), .C⟩ = some ⟨cons false (cons true (cons true (P))), cons true (rep (j) [true, true] (blank)), .B⟩ := rfl
  have h1 : steps f0 0 ⟨cons false (cons true (cons true (P))), cons true (rep (j) [true, true] (blank)), .B⟩ = some ⟨cons false (cons true (cons true (P))), rep (j) [true, true] (cons true (blank)), .B⟩ := by
    simp only [steps_zero, show cons true (rep (j) [true, true] (blank)) = rep (j) [true, true] (cons true (blank)) from
      rep_rotate (j) [true] [true, true] [true, true] rfl (blank)]
  have c2 : ∀ L R : Tape, steps f0 2 ⟨app [] L, app [true, true] R, .B⟩ = some ⟨app [] (app [false, false] L), R, .B⟩ := fun _ _ => rfl
  have h2 : steps f0 ((j) * 2) ⟨cons false (cons true (cons true (P))), rep (j) [true, true] (cons true (blank)), .B⟩ = some ⟨rep (j) [false, false] (cons false (cons true (cons true (P)))), cons true (blank), .B⟩ :=
    cross_r (trans f0) c2 (j) (cons false (cons true (cons true (P)))) (cons true (blank))
  have h3 : steps f0 3 ⟨rep (j) [false, false] (cons false (cons true (cons true (P)))), cons true (blank), .B⟩ = some ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ := rfl
  have h4 : steps f0 0 ⟨cons false (rep (j) [false, false] (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ = some ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ := by
    simp only [steps_zero, show cons false (rep (j) [false, false] (cons false (cons true (cons true (P))))) = rep (j) [false, false] (cons false (cons false (cons true (cons true (P))))) from
      rep_rotate (j) [false] [false, false] [false, false] rfl (cons false (cons true (cons true (P))))]
  have c5 : ∀ L R : Tape, steps f0 2 ⟨app [false, false] L, app [false] R, .D⟩ = some ⟨L, app [false] (app [true, true] R), .D⟩ := fun _ _ => rfl
  have h5 : steps f0 ((j) * 2) ⟨rep (j) [false, false] (cons false (cons false (cons true (cons true (P))))), cons false (cons true (blank)), .D⟩ = some ⟨cons false (cons false (cons true (cons true (P)))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ :=
    cross_l (trans f0) c5 (j) (cons false (cons false (cons true (cons true (P))))) (cons true (blank))
  have h6 : steps f0 3 ⟨cons false (cons false (cons true (cons true (P)))), cons false (rep (j) [true, true] (cons true (blank))), .D⟩ = some ⟨cons true (P), cons true (cons true (cons true (cons true (rep (j) [true, true] (cons true (blank)))))), .C⟩ := rfl
  exact steps_congr (trans f0) hn (steps_seq (trans f0) h0 (steps_seq (trans f0) h1 (steps_seq (trans f0) h2 (steps_seq (trans f0) h3 (steps_seq (trans f0) h4 (steps_seq (trans f0) h5 (h6)))))))


end

end Core
