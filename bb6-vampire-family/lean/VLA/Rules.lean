import VLA.Machine

/-! The E-pass of the core with F0 = 1LA, for every left tape `P`; this is where F0 is read. generated by `py/gen.py` with `bbtools.symtm`; do not edit by hand. -/

namespace VLA

open TM

/-- The E-pass over an even block: `P E> 1^(2k+2)` to `P (01)^(k) C> 1^4`. -/
theorem ev (k : Nat) (P : Tape) :
    steps (2 * k + 10) ⟨P, rep (k + 1) [true, true] (blank), .E⟩ = some ⟨rep (k) [true, false] (P), cons true (cons true (cons true (cons true (blank)))), .C⟩ := by
  have hn : (k + 1) * 2 + (8) = 2 * k + 10 := by omega
  have c0 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h0 : steps ((k + 1) * 2) ⟨P, rep (k + 1) [true, true] (blank), .E⟩ = some ⟨rep (k + 1) [true, false] (P), blank, .E⟩ :=
    cross_r trans c0 (k + 1) (P) (blank)
  have h1 : steps 8 ⟨rep (k + 1) [true, false] (P), blank, .E⟩ = some ⟨rep (k) [true, false] (P), cons true (cons true (cons true (cons true (blank)))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (h1))


/-- The E-pass over an odd block: `P E> 1^(2k+3)` to `P (01)^(k+1) C> 1^4`. -/
theorem od (k : Nat) (P : Tape) :
    steps (2 * k + 16) ⟨P, cons true (rep (k + 1) [true, true] (blank)), .E⟩ = some ⟨cons true (cons false (rep (k) [true, false] (P))), cons true (cons true (cons true (cons true (blank)))), .C⟩ := by
  have hn : 0 + ((k + 1) * 2 + (14)) = 2 * k + 16 := by omega
  have h0 : steps 0 ⟨P, cons true (rep (k + 1) [true, true] (blank)), .E⟩ = some ⟨P, rep (k + 1) [true, true] (cons true (blank)), .E⟩ := by
    simp only [steps_zero, show cons true (rep (k + 1) [true, true] (blank)) = rep (k + 1) [true, true] (cons true (blank)) from
      rep_rotate (k + 1) [true] [true, true] [true, true] rfl (blank)]
  have c1 : ∀ L R : Tape, steps 2 ⟨app [] L, app [true, true] R, .E⟩ = some ⟨app [] (app [true, false] L), R, .E⟩ := fun _ _ => rfl
  have h1 : steps ((k + 1) * 2) ⟨P, rep (k + 1) [true, true] (cons true (blank)), .E⟩ = some ⟨rep (k + 1) [true, false] (P), cons true (blank), .E⟩ :=
    cross_r trans c1 (k + 1) (P) (cons true (blank))
  have h2 : steps 14 ⟨rep (k + 1) [true, false] (P), cons true (blank), .E⟩ = some ⟨cons true (cons false (rep (k) [true, false] (P))), cons true (cons true (cons true (cons true (blank)))), .C⟩ := rfl
  exact steps_congr trans hn (steps_seq trans h0 (steps_seq trans h1 (h2)))


end VLA
