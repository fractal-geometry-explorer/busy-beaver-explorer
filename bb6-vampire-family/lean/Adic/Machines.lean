theorem x0_ctx : _root_.Adic.ctx 0 = x0.1 := by decide

/-- **1RB---_1LC0RB_0LD0LC_1RE1RB_1RD1LF_1LA0LE halts** if the checker finds a halt on its orbit (`VLA`, from (context 0, 15)). -/
theorem halts_of_seg (L Lf f s : Nat) (hL : 1 ≤ L)
    (h : _root_.Adic.seg VLA.Adic.tab L Lf f (3 ^ L) s 0 [15] = true) : HaltsFromBlank := by
  have r := x0_reaches
  have hv : _root_.Adic.val L [15] = 15 := by simp [_root_.Adic.val]
  rw [← x0_ctx, show x0.2.1 = 15 from rfl, ← hv] at r
  exact halts_iff.2 (_root_.Adic.halts_of_seg VLA.Adic.nextOK VLA.Adic.haltOK L Lf f s hL r (by rw [hv]; decide) h)

end H21328

