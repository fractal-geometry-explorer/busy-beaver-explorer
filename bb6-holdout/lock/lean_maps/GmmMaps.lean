/-- **The return G MM → G MMM → G WMM → G MM, for the machine.**  Every two-marker round start G 1, M m, M E − 2 on the piece's
class with both gaps at least 32 runs, without halting, to the two-marker round start G 1, M m', M E' − 2 with
8 * m' = m + 6 * E + 18 and E' = E + 12; this is also the 3-round result of the proved zipper model `roundsZ`. -/
theorem gmm_MMM_WMM_return (s t : Int) (m E : Nat) (hm : (m : Int) = 16 * s + 8 * t + 12) (hE : (E : Int) = 4 * t + 3)
    (g1 : 32 ≤ m) (g2 : m + 32 ≤ E) :
    ∃ kk m' E', steps kk (roundStart [⟨.M, m⟩, ⟨.M, E - 2⟩] E) = some (roundStart [⟨.M, m'⟩, ⟨.M, E' - 2⟩] E') ∧
      roundsZ 1000 3 [⟨.M, m⟩, ⟨.M, E - 2⟩] E = .newRound [⟨.M, m'⟩, ⟨.M, E' - 2⟩] E' ∧
      8 * m' = m + 6 * E + 18 ∧ E' = E + 12 := by
  let y : List Int := [s, t]
  have hy : inCone gmm_MMM_WMM_ts 32 y := by
    intro f hf
    simp only [gmm_MMM_WMM_ts, List.mem_cons, List.mem_nil_iff, or_false] at hf
    rcases hf with rfl | rfl <;>
      simp only [y, gmm_MMM_WMM_m, gmm_MMM_WMM_E, YForm.eval, YForm.sub, YForm.add, YForm.neg, addL, smulL, List.map, dot] <;> omega
  have hs : agL y gmm_MMM_WMM_ss [⟨.M, m⟩, ⟨.M, E - 2⟩] := by
    refine ⟨⟨rfl, ?_⟩, ⟨rfl, ?_⟩, trivial⟩ <;>
      simp only [agN, y, gmm_MMM_WMM_m, gmm_MMM_WMM_E, YForm.eval, YForm.addc, dot] <;> omega
  have hW : agN y gmm_MMM_WMM_E E := by simp only [agN, y, gmm_MMM_WMM_E, YForm.eval, dot]; omega
  obtain ⟨kk, ms', Wn', hk, hr, ht, htW⟩ := pass_sound _ _ _ _ _ _ _ _ gmm_MMM_WMM_check y hy _ _ hs hW
  obtain ⟨v1, v2, rfl, e1, e2⟩ := agL_two ht
  simp only [agN, y, gmm_MMM_WMM_tW, YForm.eval, dot] at e1 e2 htW
  have hv2 : v2 = Wn' - 2 := by omega
  subst hv2
  exact ⟨kk, v1, Wn', hk, hr, by omega, by omega⟩

/-- The countdown of G MM → G MMM → G WMM → G MM: the scaled distance to its fixed line m = 6/7·E + -450/49. -/
theorem gmm_MMM_WMM_countdown (m E m' E' : Int) (h1 : 8 * m' = m + 6 * E + 18) (h2 : E' = E + 12) :
    8 * (49 * m' - 42 * E' + 450) = 49 * m - 42 * E + 450 := by omega

theorem gmm_MMM_WMM_ne_zero (m E : Int) : 49 * m - 42 * E + 450 ≠ 0 := by omega

