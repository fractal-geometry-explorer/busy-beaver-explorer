import BB6.SymSplit
open BB6 BB6.Sym

/-! # The pass maps P and Q of the one-extra-wall loop, as theorems

Generated by `gen_passmaps.py` from `../cosets.json` and `../passmaps.py`.  For each map, the start state on its coset
is built with positions as forms in the coset coordinates; the proved symbolic model `symRoundsZ` is run for 8
rounds; `passCheck` (evaluated by `native_decide`, which trusts Lean's compiler as well as its kernel) confirms that
the start is well formed on the cone, every round is decided, and the final positions equal the affine image as
forms.  `pass_sound` (proved, from `symRoundsZ_sound`, `symRightOK_sound` and `rounds_run`) turns this into a
statement about the machine, and `P_pass` / `Q_pass` state it in plain terms.  No split was needed: both cosets are
decided as they are. -/

namespace BB6.Sym

/-- Coefficientwise equality of forms. -/
def formEqB (f g : YForm) : Bool := f.k == g.k && coeffEq f.c g.c

theorem eval_formEqB {f g : YForm} (h : formEqB f g = true) (y : List Int) : f.eval y = g.eval y := by
  simp only [formEqB, Bool.and_eq_true, beq_iff_eq] at h
  simp only [YForm.eval, h.1, dot_coeffEq _ _ y h.2]

def marksEqB : List SMark → List SMark → Bool
  | [], [] => true
  | s :: ss, t :: tt => decide (s.t = t.t) && formEqB s.p t.p && marksEqB ss tt
  | _, _ => false

theorem agL_marksEqB {y : List Int} : ∀ {ss tt : List SMark} {ms : List Mark}, marksEqB ss tt = true → agL y ss ms →
    agL y tt ms
  | [], [], [], _, _ => trivial
  | s :: ss, t :: tt, m :: ms, h, hs => by
    simp only [marksEqB, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    obtain ⟨⟨ht, hp⟩, hr⟩ := hs
    refine ⟨⟨h1 ▸ ht, ?_⟩, agL_marksEqB h3 hr⟩
    unfold agN at hp ⊢; rw [hp, eval_formEqB h2]
  | [], _ :: _, _, h, _ => by simp [marksEqB] at h
  | _ :: _, [], _, h, _ => by simp [marksEqB] at h
  | [], [], _ :: _, _, hs => absurd hs id
  | _ :: _, _ :: _, [], _, hs => absurd hs id

section
variable (ts : List YForm) (Γ : Int)

/-- The pass check: well-formed start, `n` decided rounds ending at a round start whose marks and width are, as forms,
`tt` and `tW`. -/
def passCheck (fuel n : Nat) (ss : List SMark) (sW : YForm) (tt : List SMark) (tW : YForm) : Bool :=
  symRightOK ts Γ (YForm.const 4) false sW ss &&
  (match symRoundsZ ts Γ fuel n ss sW with
   | some (.newRound ss' sW') => marksEqB ss' tt && formEqB sW' tW
   | _ => false)

def shapeOf (ss : List SMark) : String := "G" ++ String.join (ss.map (fun m => match m.t with
  | .G => "G" | .M => "M" | .W => "W" | .B => "B"))

/-- The shapes of the round starts of `n` symbolic rounds (`none` unless every round is decided and ends at a round
start). -/
def symShapes (fuel : Nat) : Nat → List SMark → YForm → Option (List String)
  | 0, _, _ => some []
  | n + 1, ss, sW =>
    match symRoundZ ts Γ fuel [] (YForm.const 1) ss sW with
    | some (.newRound ss' sW') => (symShapes fuel n ss' sW').map (shapeOf ss' :: ·)
    | _ => none

theorem pass_sound (fuel n : Nat) (ss : List SMark) (sW : YForm) (tt : List SMark) (tW : YForm)
    (hc : passCheck ts Γ fuel n ss sW tt tW = true)
    (y : List Int) (hy : inCone ts Γ y) (ms : List Mark) (Wn : Nat) (hs : agL y ss ms) (hW : agN y sW Wn) :
    ∃ k ms' Wn', steps k (roundStart ms Wn) = some (roundStart ms' Wn') ∧ roundsZ fuel n ms Wn = .newRound ms' Wn' ∧
      agL y tt ms' ∧ agN y tW Wn' := by
  simp only [passCheck, Bool.and_eq_true] at hc
  obtain ⟨hwf, hrun⟩ := hc
  cases hr : symRoundsZ ts Γ fuel n ss sW with
  | none => rw [hr] at hrun; cases hrun
  | some r =>
    rw [hr] at hrun
    cases r with
    | newRound ss' sW' =>
      simp only [Bool.and_eq_true] at hrun
      have hag := symRoundsZ_sound ts Γ hy fuel n ss ms sW Wn _ hs hW hr
      have hrwf : roundWF ms Wn := symRightOK_sound ts Γ hy ss _ 4 false sW Wn ms (agN_const y 4) hW hs hwf
      generalize hcr : roundsZ fuel n ms Wn = cr at hag
      cases cr with
      | newRound ms' Wn' =>
        obtain ⟨k, hk, -⟩ := rounds_run fuel n ms Wn hrwf (by rw [hcr]; intro h; cases h)
        rw [hcr] at hk
        refine ⟨k, ms', Wn', hk, rfl, agL_marksEqB hrun.1 hag.1, ?_⟩
        have := hag.2; unfold agN at this ⊢; rw [this, eval_formEqB hrun.2]
      | _ => exact absurd hag id
    | _ => simp at hrun

end

theorem agL_four {y : List Int} {f1 f2 f3 f4 : YForm} {ms : List Mark}
    (h : agL y [⟨.W, f1⟩, ⟨.W, f2⟩, ⟨.W, f3⟩, ⟨.W, f4⟩] ms) :
    ∃ v1 v2 v3 v4, ms = [⟨.W, v1⟩, ⟨.W, v2⟩, ⟨.W, v3⟩, ⟨.W, v4⟩] ∧ agN y f1 v1 ∧ agN y f2 v2 ∧ agN y f3 v3 ∧
      agN y f4 v4 := by
  match ms, h with
  | [⟨t1, p1⟩, ⟨t2, p2⟩, ⟨t3, p3⟩, ⟨t4, p4⟩], ⟨⟨e1, a1⟩, ⟨e2, a2⟩, ⟨e3, a3⟩, ⟨e4, a4⟩, _⟩ =>
    simp only at e1 e2 e3 e4
    subst e1 e2 e3 e4
    exact ⟨p1, p2, p3, p4, rfl, a1, a2, a3, a4⟩

end BB6.Sym

open BB6.Sym

/-! ## The pass map P

Coset of starts (coordinates k0 … k4; positions x = x0 + Σ kᵢ·basisᵢ from `cosets.json`).  Shapes of the 8 rounds:
GBWW GWWWW GBWW GMBW GMWWW GMBW GMWWW GWWWW. -/

def Pw1 : YForm := ⟨1, [-2, 0, 0, 0, 0]⟩
def Pw2 : YForm := ⟨-296, [0, 4, -8, 8, -64]⟩
def Pw3 : YForm := ⟨-167, [0, -4, 8, -8, -64]⟩
def Pw4 : YForm := ⟨-38, [0, -4, -24, -8, 0]⟩
def PE : YForm := ⟨27, [0, -4, 8, 24, 0]⟩
def Pss : List SMark := [⟨.W, Pw1⟩, ⟨.W, Pw2⟩, ⟨.W, Pw3⟩, ⟨.W, Pw4⟩]
def Pts : List YForm := [Pw1, Pw2.sub Pw1, Pw3.sub Pw2, Pw4.sub Pw3, PE.sub Pw4]
/-- The affine image of the start, as forms in the same coordinates. -/
def Ptt : List SMark := [⟨.W, ⟨-3, [0, 0, 0, 0, -2]⟩⟩, ⟨.W, ⟨-4, [0, -2, -2, 4, -6]⟩⟩, ⟨.W, ⟨21, [0, -4, 0, 14, -4]⟩⟩, ⟨.W, ⟨46, [0, -4, 6, 22, 0]⟩⟩]
def PtW : YForm := ⟨51, [0, -4, 8, 24, 0]⟩

/-- Evaluated: the start is well formed on the cone (gaps ≥ 36), every one of the 8 rounds is decided and ends at a
round start, and the positions after round 8 are the affine image. -/
theorem P_check : passCheck Pts 36 1000 8 Pss PE Ptt PtW = true := by native_decide

/-- Evaluated: the shapes of the 8 rounds. -/
theorem P_shapes : symShapes Pts 36 1000 8 Pss PE =
    some ["GBWW", "GWWWW", "GBWW", "GMBW", "GMWWW", "GMBW", "GMWWW", "GWWWW"] := by native_decide

/-- **The pass map P, for the machine.**  Every round start `G 1, W w1, W w2, W w3, W w4`, width `E`, on the
coset of P with all cone gaps at least 36 runs in some number `kk` of machine steps, without halting, to the round
start `G 1, W v1, W v2, W v3, W v4`, width `E'`, where (v1, v2, v3, v4, E') is the affine image P(w1, …, E); this
is also the 8-round result of the proved zipper model `roundsZ`. -/
theorem P_pass (k0 k1 k2 k3 k4 : Int) (w1 w2 w3 w4 E : Nat)
    (hw1 : (w1 : Int) = 1 + (-2) * k0) (hw2 : (w2 : Int) = -296 + (4) * k1 + (-8) * k2 + (8) * k3 + (-64) * k4) (hw3 : (w3 : Int) = -167 + (-4) * k1 + (8) * k2 + (-8) * k3 + (-64) * k4)
    (hw4 : (w4 : Int) = -38 + (-4) * k1 + (-24) * k2 + (-8) * k3) (hE : (E : Int) = 27 + (-4) * k1 + (8) * k2 + (24) * k3)
    (g1 : 36 ≤ w1) (g2 : w1 + 36 ≤ w2) (g3 : w2 + 36 ≤ w3) (g4 : w3 + 36 ≤ w4) (g5 : w4 + 36 ≤ E) :
    ∃ kk v1 v2 v3 v4 E', steps kk (roundStart [⟨.W, w1⟩, ⟨.W, w2⟩, ⟨.W, w3⟩, ⟨.W, w4⟩] E) =
        some (roundStart [⟨.W, v1⟩, ⟨.W, v2⟩, ⟨.W, v3⟩, ⟨.W, v4⟩] E') ∧
      roundsZ 1000 8 [⟨.W, w1⟩, ⟨.W, w2⟩, ⟨.W, w3⟩, ⟨.W, w4⟩] E =
        .newRound [⟨.W, v1⟩, ⟨.W, v2⟩, ⟨.W, v3⟩, ⟨.W, v4⟩] E' ∧
      64 * v1 = w2 + w3 + 271 ∧
      64 * v2 = w2 + 5 * w3 + 12 * w4 + 16 * E + 899 ∧
      16 * v3 = w3 + 4 * w4 + 11 * E + 358 ∧
      16 * v4 = w4 + 15 * E + 369 ∧
      E' = E + 24 := by
  let y : List Int := [k0, k1, k2, k3, k4]
  have hy : inCone Pts 36 y := by
    intro t ht
    simp only [Pts, List.mem_cons, List.mem_nil_iff, or_false] at ht
    rcases ht with rfl | rfl | rfl | rfl | rfl <;>
      simp only [y, Pw1, Pw2, Pw3, Pw4, PE, YForm.eval, YForm.sub, YForm.add, YForm.neg, addL, smulL,
        List.map, dot] <;> omega
  have hs : agL y Pss [⟨.W, w1⟩, ⟨.W, w2⟩, ⟨.W, w3⟩, ⟨.W, w4⟩] := by
    refine ⟨⟨rfl, ?_⟩, ⟨rfl, ?_⟩, ⟨rfl, ?_⟩, ⟨rfl, ?_⟩, trivial⟩ <;>
      simp only [agN, y, Pw1, Pw2, Pw3, Pw4, YForm.eval, dot] <;> omega
  have hW : agN y PE E := by simp only [agN, y, PE, YForm.eval, dot]; omega
  obtain ⟨kk, ms', Wn', hk, hr, ht, htW⟩ := pass_sound _ _ _ _ _ _ _ _ P_check y hy _ _ hs hW
  obtain ⟨v1, v2, v3, v4, rfl, e1, e2, e3, e4⟩ := agL_four ht
  refine ⟨kk, v1, v2, v3, v4, Wn', hk, hr, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [agN, y, PtW, YForm.eval, dot] at e1 e2 e3 e4 htW <;> omega

/-! ## The pass map Q

Coset of starts (coordinates k0 … k4; positions x = x0 + Σ kᵢ·basisᵢ from `cosets.json`).  Shapes of the 8 rounds:
GBWW GMMWW GMWWW GMBW GMWWW GMBW GMWWW GWWWW. -/

def Qw1 : YForm := ⟨-1, [2, 0, 0, 0, 0]⟩
def Qw2 : YForm := ⟨4222, [0, 0, 0, 0, -256]⟩
def Qw3 : YForm := ⟨-6679, [0, -16, 0, 0, 0]⟩
def Qw4 : YForm := ⟨-90, [0, -4, 16, -16, 0]⟩
def QE : YForm := ⟨-57, [0, -4, 16, 16, 0]⟩
def Qss : List SMark := [⟨.W, Qw1⟩, ⟨.W, Qw2⟩, ⟨.W, Qw3⟩, ⟨.W, Qw4⟩]
def Qts : List YForm := [Qw1, Qw2.sub Qw1, Qw3.sub Qw2, Qw4.sub Qw3, QE.sub Qw4]
/-- The affine image of the start, as forms in the same coordinates. -/
def Qtt : List SMark := [⟨.W, ⟨37, [0, 0, 0, 0, -2]⟩⟩, ⟨.W, ⟨76, [0, -2, 6, 2, -18]⟩⟩, ⟨.W, ⟨21, [0, -4, 14, 8, -16]⟩⟩, ⟨.W, ⟨-36, [0, -4, 16, 14, 0]⟩⟩]
def QtW : YForm := ⟨-33, [0, -4, 16, 16, 0]⟩

/-- Evaluated: the start is well formed on the cone (gaps ≥ 192), every one of the 8 rounds is decided and ends at a
round start, and the positions after round 8 are the affine image. -/
theorem Q_check : passCheck Qts 192 1000 8 Qss QE Qtt QtW = true := by native_decide

/-- Evaluated: the shapes of the 8 rounds. -/
theorem Q_shapes : symShapes Qts 192 1000 8 Qss QE =
    some ["GBWW", "GMMWW", "GMWWW", "GMBW", "GMWWW", "GMBW", "GMWWW", "GWWWW"] := by native_decide

/-- **The pass map Q, for the machine.**  Every round start `G 1, W w1, W w2, W w3, W w4`, width `E`, on the
coset of Q with all cone gaps at least 192 runs in some number `kk` of machine steps, without halting, to the round
start `G 1, W v1, W v2, W v3, W v4`, width `E'`, where (v1, v2, v3, v4, E') is the affine image Q(w1, …, E); this
is also the 8-round result of the proved zipper model `roundsZ`. -/
theorem Q_pass (k0 k1 k2 k3 k4 : Int) (w1 w2 w3 w4 E : Nat)
    (hw1 : (w1 : Int) = -1 + (2) * k0) (hw2 : (w2 : Int) = 4222 + (-256) * k4) (hw3 : (w3 : Int) = -6679 + (-16) * k1)
    (hw4 : (w4 : Int) = -90 + (-4) * k1 + (16) * k2 + (-16) * k3) (hE : (E : Int) = -57 + (-4) * k1 + (16) * k2 + (16) * k3)
    (g1 : 192 ≤ w1) (g2 : w1 + 192 ≤ w2) (g3 : w2 + 192 ≤ w3) (g4 : w3 + 192 ≤ w4) (g5 : w4 + 192 ≤ E) :
    ∃ kk v1 v2 v3 v4 E', steps kk (roundStart [⟨.W, w1⟩, ⟨.W, w2⟩, ⟨.W, w3⟩, ⟨.W, w4⟩] E) =
        some (roundStart [⟨.W, v1⟩, ⟨.W, v2⟩, ⟨.W, v3⟩, ⟨.W, v4⟩] E') ∧
      roundsZ 1000 8 [⟨.W, w1⟩, ⟨.W, w2⟩, ⟨.W, w3⟩, ⟨.W, w4⟩] E =
        .newRound [⟨.W, v1⟩, ⟨.W, v2⟩, ⟨.W, v3⟩, ⟨.W, v4⟩] E' ∧
      128 * v1 = w2 + 514 ∧
      128 * v2 = 9 * w2 + 4 * w3 + 16 * w4 + 32 * E + 1710 ∧
      32 * v3 = 2 * w2 + w3 + 6 * w4 + 22 * E + 701 ∧
      16 * v4 = w4 + 15 * E + 369 ∧
      E' = E + 24 := by
  let y : List Int := [k0, k1, k2, k3, k4]
  have hy : inCone Qts 192 y := by
    intro t ht
    simp only [Qts, List.mem_cons, List.mem_nil_iff, or_false] at ht
    rcases ht with rfl | rfl | rfl | rfl | rfl <;>
      simp only [y, Qw1, Qw2, Qw3, Qw4, QE, YForm.eval, YForm.sub, YForm.add, YForm.neg, addL, smulL,
        List.map, dot] <;> omega
  have hs : agL y Qss [⟨.W, w1⟩, ⟨.W, w2⟩, ⟨.W, w3⟩, ⟨.W, w4⟩] := by
    refine ⟨⟨rfl, ?_⟩, ⟨rfl, ?_⟩, ⟨rfl, ?_⟩, ⟨rfl, ?_⟩, trivial⟩ <;>
      simp only [agN, y, Qw1, Qw2, Qw3, Qw4, YForm.eval, dot] <;> omega
  have hW : agN y QE E := by simp only [agN, y, QE, YForm.eval, dot]; omega
  obtain ⟨kk, ms', Wn', hk, hr, ht, htW⟩ := pass_sound _ _ _ _ _ _ _ _ Q_check y hy _ _ hs hW
  obtain ⟨v1, v2, v3, v4, rfl, e1, e2, e3, e4⟩ := agL_four ht
  refine ⟨kk, v1, v2, v3, v4, Wn', hk, hr, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [agN, y, QtW, YForm.eval, dot] at e1 e2 e3 e4 htW <;> omega

