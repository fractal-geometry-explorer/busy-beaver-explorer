import BB6.Cycles

/-! # The mark rules, each proved from the transition table along the Python prover's trace (generated by gen_rules.py). -/

namespace BB6

/-- BOUNCE: One bounce off a marker: the gap moves 2 right, the marker 2 left. -/
theorem bounce (m : Nat) (L : Tape) (R : Tape) :
    steps (6 * m + 30) ⟨cons false (cons false (L)), cons false (rep (m + 2) [true, false] (cons true (cons true (cons false (R))))), .E⟩ = some ⟨cons false (cons false (cons true (cons false (L)))), cons false (rep (m) [true, false] (cons true (cons true (cons false (cons true (cons false (R))))))), .E⟩ := by
  conv => lhs; rw [rep_shift' false true (m + 2) (cons true (cons true (cons false (R)))), rep_cons2 (m + 2) false true (cons true (cons false (R)))]
  have h0 := pass (m + 3) (cons false (cons false (L))) (cons true (cons false (R)))
  have h1 : steps 6 ⟨rep (m + 3) [true, false] (cons false (cons false (L))), cons true (cons false (R)), .E⟩ = some ⟨rep (m + 2) [true, false] (cons false (cons false (L))), cons false (cons true (cons true (cons true (R)))), .A⟩ := rfl
  have h2 := shift (1) (rep (m + 2) [true, false] (cons false (cons false (L)))) (cons true (cons true (R)))
  have h3 := carry (1) (rep (m + 2) [true, false] (cons false (cons false (L)))) (R)
  have h4 : steps 5 ⟨rep (m + 2) [true, false] (cons false (cons false (L))), cons true (cons true (cons true (cons false (R)))), .A⟩ = some ⟨cons false (rep (m) [true, false] (cons false (cons false (L)))), cons true (cons true (cons true (cons true (cons false (cons true (cons false (R))))))), .A⟩ := rfl
  conv at h4 => rhs; rw [rep_shift' false true (m) (cons false (cons false (L)))]
  have h5 := carry (m) (cons false (cons false (cons false (L)))) (cons true (cons true (cons false (rep (1) [true, false] (R)))))
  have h6 : steps 4 ⟨cons false (cons false (cons false (L))), cons true (cons true (rep (m) [true, false] (cons true (cons true (cons false (cons true (cons false (R)))))))), .A⟩ = some ⟨cons false (L), cons false (cons true (cons true (cons false (rep (m) [true, false] (cons true (cons true (cons false (cons true (cons false (R)))))))))), .A⟩ := rfl
  have h7 := shift (1) (cons false (L)) (cons true (cons false (rep (m) [true, false] (cons true (cons true (cons false (rep (1) [true, false] (R))))))))
  have h8 : steps 1 ⟨cons false (cons true (cons false (L))), cons true (cons false (rep (m) [true, false] (cons true (cons true (cons false (cons true (cons false (R)))))))), .A⟩ = some ⟨cons false (cons false (cons true (cons false (L)))), cons false (rep (m) [true, false] (cons true (cons true (cons false (cons true (cons false (R))))))), .E⟩ := rfl
  have e : 6 * m + 30 = 2 * (m + 3) + (6 + (2 * (1) + (4 * (1) + (5 + (4 * (m) + (4 + (2 * (1) + (1)))))))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (steps_seq h5 (steps_seq h6 (steps_seq h7 (h8))))))))

/-- SWAP: No stripes left between gap and marker: the marker ends up just left of the gap, which moves 1 right. -/
theorem swap (L : Tape) (R : Tape) :
    steps (21) ⟨cons false (cons false (cons true (L))), cons false (cons true (cons true (cons false (R)))), .E⟩ = some ⟨cons false (cons false (cons true (cons true (L)))), cons false (cons true (cons false (R))), .E⟩ := by
  have h0 := pass (1) (cons false (cons false (cons true (L)))) (cons true (cons false (R)))
  have h1 : steps 6 ⟨cons true (cons false (cons false (cons false (cons true (L))))), cons true (cons false (R)), .E⟩ = some ⟨cons false (cons false (cons true (L))), cons false (cons true (cons true (cons true (R)))), .A⟩ := rfl
  have h2 := shift (1) (cons false (cons false (cons true (L)))) (cons true (cons true (R)))
  have h3 := carry (1) (cons false (cons false (cons true (L)))) (R)
  have h4 : steps 4 ⟨cons false (cons false (cons true (L))), cons true (cons true (cons true (cons false (R)))), .A⟩ = some ⟨cons true (L), cons false (cons true (cons true (cons false (cons true (cons false (R)))))), .A⟩ := rfl
  have h5 := shift (1) (cons true (L)) (cons true (cons false (rep (1) [true, false] (R))))
  have h6 : steps 1 ⟨cons false (cons true (cons true (L))), cons true (cons false (cons true (cons false (R)))), .A⟩ = some ⟨cons false (cons false (cons true (cons true (L)))), cons false (cons true (cons false (R))), .E⟩ := rfl
  have e : 21 = 2 * (1) + (6 + (2 * (1) + (4 * (1) + (4 + (2 * (1) + (1)))))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (steps_seq h5 (h6))))))

/-- MERGE: Two stripe cells between: gap and marker become a wall 00, and a packet 111 heads left. -/
theorem merge (L : Tape) (R : Tape) :
    steps (31) ⟨cons false (cons false (cons true (L))), cons false (cons true (cons false (cons true (cons true (cons false (R)))))), .E⟩ = some ⟨L, cons true (cons true (cons true (cons false (cons true (cons false (cons false (cons true (cons false (R))))))))), .A⟩ := by
  have h0 := pass (2) (cons false (cons false (cons true (L)))) (cons true (cons false (R)))
  have h1 : steps 6 ⟨cons true (cons false (cons true (cons false (cons false (cons false (cons true (L))))))), cons true (cons false (R)), .E⟩ = some ⟨cons true (cons false (cons false (cons false (cons true (L))))), cons false (cons true (cons true (cons true (R)))), .A⟩ := rfl
  have h2 := shift (1) (rep (1) [true, false] (cons false (cons false (cons true (L))))) (cons true (cons true (R)))
  have h3 := carry (1) (rep (1) [true, false] (cons false (cons false (cons true (L))))) (R)
  have h4 : steps 5 ⟨cons true (cons false (cons false (cons false (cons true (L))))), cons true (cons true (cons true (cons false (R)))), .A⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons true (cons true (cons false (cons true (cons false (R))))))), .A⟩ := rfl
  have h5 := shift (1) (cons false (cons true (L))) (cons true (cons true (cons false (rep (1) [true, false] (R)))))
  conv at h5 => rhs; rw [rep_cons2 (1) false true (L)]
  have h6 := carry (2) (L) (cons false (rep (1) [true, false] (R)))
  have e : 31 = 2 * (2) + (6 + (2 * (1) + (4 * (1) + (5 + (2 * (1) + (4 * (2))))))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (steps_seq h5 (h6))))))

/-- WALLBOUNCE: One bounce off a wall (or the blank end): the gap moves 2 right, the wall stays. -/
theorem wallbounce (m : Nat) (L : Tape) (R : Tape) :
    steps (6 * m + 12) ⟨cons false (cons false (L)), cons false (rep (m + 1) [true, false] (cons false (R))), .E⟩ = some ⟨cons false (cons false (cons true (cons false (L)))), cons false (rep (m) [true, false] (cons false (R))), .E⟩ := by
  conv => lhs; rw [rep_shift' false true (m + 1) (cons false (R))]
  have h0 := pass (m + 1) (cons false (cons false (L))) (cons false (cons false (R)))
  have h1 : steps 3 ⟨rep (m + 1) [true, false] (cons false (cons false (L))), cons false (cons false (R)), .E⟩ = some ⟨cons false (rep (m) [true, false] (cons false (cons false (L)))), cons true (cons true (cons false (R))), .A⟩ := rfl
  conv at h1 => rhs; rw [rep_shift' false true (m) (cons false (cons false (L)))]
  have h2 := carry (m) (cons false (cons false (cons false (L)))) (cons false (R))
  have h3 : steps 4 ⟨cons false (cons false (cons false (L))), cons true (cons true (rep (m) [true, false] (cons false (R)))), .A⟩ = some ⟨cons false (L), cons false (cons true (cons true (cons false (rep (m) [true, false] (cons false (R)))))), .A⟩ := rfl
  have h4 := shift (1) (cons false (L)) (cons true (cons false (rep (m) [true, false] (cons false (R)))))
  have h5 : steps 1 ⟨cons false (cons true (cons false (L))), cons true (cons false (rep (m) [true, false] (cons false (R)))), .A⟩ = some ⟨cons false (cons false (cons true (cons false (L)))), cons false (rep (m) [true, false] (cons false (R))), .E⟩ := rfl
  have e : 6 * m + 12 = 2 * (m + 1) + (3 + (4 * (m) + (4 + (2 * (1) + (1))))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (h5)))))

/-- MEET->marker: Gap and wall vanish; the shift uses up the marker and a gap opens where the marker was. -/
theorem meet_to_marker (j : Nat) (L : Tape) (R : Tape) :
    steps (2 * j + 8) ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons true (cons true (cons false (R)))))), .E⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons false (cons true (rep (j) [false, true] (L)))))))), cons false (R), .E⟩ := by
  -- the run ends in the form ⟨cons false (rep (j + 2) [false, true] (cons false (cons true (L)))), cons false (R), .E⟩; the stated form is the same tape re-bracketed
  have h0 : steps 3 ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons true (cons true (cons false (R)))))), .E⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))), .A⟩ := rfl
  conv at h0 => rhs; rw [rep_shift' false true (j) (cons true (cons true (cons false (R)))), rep_cons2 (j) false true (cons true (cons false (R)))]
  have h1 := shift (j + 2) (cons false (cons true (L))) (cons true (cons false (R)))
  have h2 : steps 1 ⟨rep (j + 2) [false, true] (cons false (cons true (L))), cons true (cons false (R)), .A⟩ = some ⟨cons false (rep (j + 2) [false, true] (cons false (cons true (L)))), cons false (R), .E⟩ := rfl
  have e : 2 * j + 8 = 3 + (2 * (j + 2) + (1)) := by omega
  rw [e]
  have hc := steps_seq h0 (steps_seq h1 (h2))
  simpa only [rep_cons2, rep_shift'] using hc

/-- MEET->wall: Gap and wall vanish; the next wall becomes a block 111, and a packet heads left. -/
theorem meet_to_wall (j : Nat) (L : Tape) (R : Tape) :
    steps (6 * j + 13) ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons false (cons true (R))))), .E⟩ = some ⟨L, cons true (cons true (rep (j) [true, false] (cons true (cons false (cons true (cons true (cons true (R)))))))), .A⟩ := by
  -- the run ends in the form ⟨L, cons true (cons true (rep (j + 1) [true, false] (cons true (cons true (cons true (R)))))), .A⟩; the stated form is the same tape re-bracketed
  have h0 : steps 3 ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons false (cons true (R))))), .E⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons false (rep (j) [true, false] (cons false (cons true (R)))))), .A⟩ := rfl
  conv at h0 => rhs; rw [rep_shift' false true (j) (cons false (cons true (R)))]
  have h1 := shift (j + 1) (cons false (cons true (L))) (cons false (cons false (cons true (R))))
  have h2 : steps 4 ⟨rep (j + 1) [false, true] (cons false (cons true (L))), cons false (cons false (cons true (R))), .A⟩ = some ⟨rep (j) [false, true] (cons false (cons true (L))), cons true (cons true (cons true (cons true (cons true (R))))), .A⟩ := rfl
  conv at h2 => rhs; rw [rep_cons2 (j) false true (L)]
  have h3 := carry (j + 1) (L) (cons true (cons true (cons true (R))))
  have e : 6 * j + 13 = 3 + (2 * (j + 1) + (4 + (4 * (j + 1)))) := by omega
  rw [e]
  have hc := steps_seq h0 (steps_seq h1 (steps_seq h2 (h3)))
  simpa only [rep_cons2, rep_shift'] using hc

/-- MEET->block: Gap and wall vanish; the block becomes a wall two cells further right, and a packet heads left. -/
theorem meet_to_block (j : Nat) (L : Tape) (R : Tape) :
    steps (6 * j + 19) ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R))))))), .E⟩ = some ⟨L, cons true (cons true (rep (j) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons false (R)))))))))), .A⟩ := by
  -- the run ends in the form ⟨L, cons true (cons true (rep (j + 3) [true, false] (cons false (R)))), .A⟩; the stated form is the same tape re-bracketed
  have h0 : steps 3 ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R))))))), .E⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R)))))))), .A⟩ := rfl
  conv at h0 => rhs; rw [rep_shift' false true (j) (cons true (cons true (cons true (cons false (R))))), rep_cons2 (j) false true (cons true (cons true (cons false (R))))]
  have h1 := shift (j + 2) (cons false (cons true (L))) (cons true (cons true (cons false (R))))
  conv at h1 => rhs; rw [rep_cons2 (j + 2) false true (L)]
  have h2 := carry (j + 3) (L) (cons false (R))
  have e : 6 * j + 19 = 3 + (2 * (j + 2) + (4 * (j + 3))) := by omega
  rw [e]
  have hc := steps_seq h0 (steps_seq h1 (h2))
  simpa only [rep_cons2, rep_shift'] using hc

/-- MEET->blank: Gap and wall vanish; the shift reaches blank tape, which gains an end marker 11; a packet heads left. -/
theorem meet_to_blank (j : Nat) (L : Tape) :
    steps (6 * j + 13) ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (blank))), .E⟩ = some ⟨L, cons true (cons true (rep (j) [true, false] (cons true (cons false (cons true (cons true (blank))))))), .A⟩ := by
  -- the run ends in the form ⟨L, cons true (cons true (rep (j + 1) [true, false] (cons true (cons true (blank))))), .A⟩; the stated form is the same tape re-bracketed
  have h0 : steps 3 ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (blank))), .E⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons false (rep (j) [true, false] (blank)))), .A⟩ := rfl
  conv at h0 => rhs; rw [rep_shift' false true (j) (blank)]
  have h1 := shift (j + 1) (cons false (cons true (L))) (cons false (blank))
  have h2 : steps 4 ⟨rep (j + 1) [false, true] (cons false (cons true (L))), cons false (blank), .A⟩ = some ⟨rep (j) [false, true] (cons false (cons true (L))), cons true (cons true (cons true (cons true (blank)))), .A⟩ := rfl
  conv at h2 => rhs; rw [rep_cons2 (j) false true (L)]
  have h3 := carry (j + 1) (L) (cons true (cons true (blank)))
  have e : 6 * j + 13 = 3 + (2 * (j + 1) + (4 + (4 * (j + 1)))) := by omega
  rw [e]
  have hc := steps_seq h0 (steps_seq h1 (steps_seq h2 (h3)))
  simpa only [rep_cons2, rep_shift'] using hc

/-- GAP->blankend: A gap with nothing to its right: the end gains a marker 3 cells further right, and a packet heads left. -/
theorem gap_to_blankend (L : Tape) :
    steps (13) ⟨cons false (cons false (cons true (L))), cons false (blank), .E⟩ = some ⟨L, cons true (cons true (cons true (cons false (cons true (cons true (blank)))))), .A⟩ := by
  have h0 : steps 3 ⟨cons false (cons false (cons true (L))), cons false (blank), .E⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons false (blank))), .A⟩ := rfl
  have h1 := shift (1) (cons false (cons true (L))) (cons false (blank))
  have h2 : steps 4 ⟨cons false (cons true (cons false (cons true (L)))), cons false (blank), .A⟩ = some ⟨cons false (cons true (L)), cons true (cons true (cons true (cons true (blank)))), .A⟩ := rfl
  have h3 := carry (1) (L) (cons true (cons true (blank)))
  have e : 13 = 3 + (2 * (1) + (4 + (4 * (1)))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (h3)))

/-- MEET->endmarker: Gap and wall vanish; the shift uses up the end marker, the new gap meets the blank end, a new end marker forms 3 cells further right, and a packet heads left. -/
theorem meet_to_endmarker (j : Nat) (L : Tape) :
    steps (6 * j + 29) ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons true (cons true (blank))))), .E⟩ = some ⟨L, cons true (cons true (rep (j) [true, false] (cons true (cons false (cons true (cons false (cons true (cons false (cons true (cons true (blank))))))))))), .A⟩ := by
  -- the run ends in the form ⟨L, cons true (cons true (rep (j + 3) [true, false] (cons true (cons true (blank))))), .A⟩; the stated form is the same tape re-bracketed
  have h0 : steps 3 ⟨cons false (cons false (cons true (L))), cons false (cons false (rep (j) [true, false] (cons true (cons true (blank))))), .E⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons false (rep (j) [true, false] (cons true (cons true (blank)))))), .A⟩ := rfl
  conv at h0 => rhs; rw [rep_shift' false true (j) (cons true (cons true (blank))), rep_cons2 (j) false true (cons true (blank))]
  have h1 := shift (j + 2) (cons false (cons true (L))) (cons true (blank))
  have h2 : steps 4 ⟨rep (j + 2) [false, true] (cons false (cons true (L))), cons true (blank), .A⟩ = some ⟨rep (j + 2) [false, true] (cons false (cons true (L))), cons false (cons true (cons false (blank))), .A⟩ := rfl
  have h3 := shift (1) (rep (j + 2) [false, true] (cons false (cons true (L)))) (cons false (blank))
  have h4 : steps 4 ⟨cons false (cons true (rep (j + 2) [false, true] (cons false (cons true (L))))), cons false (blank), .A⟩ = some ⟨rep (j + 2) [false, true] (cons false (cons true (L))), cons true (cons true (cons true (cons true (blank)))), .A⟩ := rfl
  conv at h4 => rhs; rw [rep_cons2 (j + 2) false true (L)]
  have h5 := carry (j + 3) (L) (cons true (cons true (blank)))
  have e : 6 * j + 29 = 3 + (2 * (j + 2) + (4 + (2 * (1) + (4 + (4 * (j + 3)))))) := by omega
  rw [e]
  have hc := steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (h5)))))
  simpa only [rep_cons2, rep_shift'] using hc

/-- BLOCK->marker: The block becomes a wall, the old gap stays (asleep), and a gap opens where the marker was. -/
theorem block_to_marker (j : Nat) (m : Nat) (L : Tape) (R : Tape) :
    steps (2 * j + 2 * m + 9) ⟨cons false (cons false (cons true (L))), cons false (rep (m) [true, false] (cons true (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R)))))))))), .E⟩ = some ⟨cons false (cons false (cons true (cons false (cons true (cons false (rep (j) [true, false] (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))))))))), cons false (R), .E⟩ := by
  -- the run ends in the form ⟨cons false (rep (j + 2) [false, true] (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))))), cons false (R), .E⟩; the stated form is the same tape re-bracketed
  conv => lhs; rw [rep_shift' false true (m) (cons true (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))))), rep_cons2 (m) false true (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))))]
  have h0 := pass (m + 1) (cons false (cons false (cons true (L)))) (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))))
  have h1 : steps 2 ⟨rep (m + 1) [true, false] (cons false (cons false (cons true (L)))), cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))), .E⟩ = some ⟨cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons false (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons false (R))))))), .A⟩ := rfl
  conv at h1 => rhs; rw [rep_shift' false true (j) (cons true (cons true (cons false (R)))), rep_cons2 (j) false true (cons true (cons false (R)))]
  have h2 := shift (j + 2) (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))) (cons true (cons false (R)))
  have h3 : steps 1 ⟨rep (j + 2) [false, true] (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons true (cons false (R)), .A⟩ = some ⟨cons false (rep (j + 2) [false, true] (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))))), cons false (R), .E⟩ := rfl
  have e : 2 * j + 2 * m + 9 = 2 * (m + 1) + (2 + (2 * (j + 2) + (1))) := by omega
  rw [e]
  have hc := steps_seq h0 (steps_seq h1 (steps_seq h2 (h3)))
  simpa only [rep_cons2, rep_shift'] using hc

/-- BLOCK->wall: The block becomes a wall; the next wall becomes a block; the packet comes back and the first wall turns into a marker and a gap. -/
theorem block_to_wall (j : Nat) (m : Nat) (L : Tape) (R : Tape) :
    steps (6 * j + 2 * m + 17) ⟨cons false (cons false (cons true (L))), cons false (rep (m) [true, false] (cons true (cons true (cons true (cons false (rep (j) [true, false] (cons false (cons true (R))))))))), .E⟩ = some ⟨cons false (cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (rep (j) [true, false] (cons true (cons true (cons true (R))))), .E⟩ := by
  conv => lhs; rw [rep_shift' false true (m) (cons true (cons true (cons true (cons false (rep (j) [true, false] (cons false (cons true (R)))))))), rep_cons2 (m) false true (cons true (cons true (cons false (rep (j) [true, false] (cons false (cons true (R)))))))]
  have h0 := pass (m + 1) (cons false (cons false (cons true (L)))) (cons true (cons true (cons false (rep (j) [true, false] (cons false (cons true (R)))))))
  have h1 : steps 2 ⟨rep (m + 1) [true, false] (cons false (cons false (cons true (L)))), cons true (cons true (cons false (rep (j) [true, false] (cons false (cons true (R)))))), .E⟩ = some ⟨cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons false (cons true (cons false (rep (j) [true, false] (cons false (cons true (R)))))), .A⟩ := rfl
  conv at h1 => rhs; rw [rep_shift' false true (j) (cons false (cons true (R)))]
  have h2 := shift (j + 1) (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))) (cons false (cons false (cons true (R))))
  have h3 : steps 4 ⟨rep (j + 1) [false, true] (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (cons false (cons true (R))), .A⟩ = some ⟨rep (j) [false, true] (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons true (cons true (cons true (cons true (cons true (R))))), .A⟩ := rfl
  have h4 := carry (j) (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))) (cons true (cons true (cons true (R))))
  have h5 : steps 4 ⟨cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons true (cons true (rep (j) [true, false] (cons true (cons true (cons true (R)))))), .A⟩ = some ⟨rep (m) [true, false] (cons false (cons false (cons true (L)))), cons false (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (R)))))))), .A⟩ := rfl
  have h6 := shift (1) (rep (m) [true, false] (cons false (cons false (cons true (L))))) (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (R)))))))
  have h7 : steps 1 ⟨cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (R)))))), .A⟩ = some ⟨cons false (cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (rep (j) [true, false] (cons true (cons true (cons true (R))))), .E⟩ := rfl
  have e : 6 * j + 2 * m + 17 = 2 * (m + 1) + (2 + (2 * (j + 1) + (4 + (4 * (j) + (4 + (2 * (1) + (1))))))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (steps_seq h5 (steps_seq h6 (h7)))))))

/-- BLOCK->block: The block becomes a wall; the next block becomes a wall 2 cells right; the first wall turns into a marker and a gap. -/
theorem block_to_block (j : Nat) (m : Nat) (L : Tape) (R : Tape) :
    steps (6 * j + 2 * m + 23) ⟨cons false (cons false (cons true (L))), cons false (rep (m) [true, false] (cons true (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R))))))))))), .E⟩ = some ⟨cons false (cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (rep (j) [true, false] (cons true (cons false (cons true (cons false (cons false (R))))))), .E⟩ := by
  -- the run ends in the form ⟨cons false (cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (rep (j + 2) [true, false] (cons false (R))), .E⟩; the stated form is the same tape re-bracketed
  conv => lhs; rw [rep_shift' false true (m) (cons true (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R)))))))))), rep_cons2 (m) false true (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R)))))))))]
  have h0 := pass (m + 1) (cons false (cons false (cons true (L)))) (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R)))))))))
  have h1 : steps 2 ⟨rep (m + 1) [true, false] (cons false (cons false (cons true (L)))), cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R)))))))), .E⟩ = some ⟨cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons false (cons true (cons false (rep (j) [true, false] (cons true (cons true (cons true (cons false (R)))))))), .A⟩ := rfl
  conv at h1 => rhs; rw [rep_shift' false true (j) (cons true (cons true (cons true (cons false (R))))), rep_cons2 (j) false true (cons true (cons true (cons false (R))))]
  have h2 := shift (j + 2) (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))) (cons true (cons true (cons false (R))))
  have h3 := carry (j + 2) (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))) (cons false (R))
  have h4 : steps 4 ⟨cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons true (cons true (rep (j + 2) [true, false] (cons false (R)))), .A⟩ = some ⟨rep (m) [true, false] (cons false (cons false (cons true (L)))), cons false (cons true (cons true (cons false (rep (j + 2) [true, false] (cons false (R)))))), .A⟩ := rfl
  have h5 := shift (1) (rep (m) [true, false] (cons false (cons false (cons true (L))))) (cons true (cons false (rep (j + 2) [true, false] (cons false (R)))))
  have h6 : steps 1 ⟨cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons true (cons false (rep (j + 2) [true, false] (cons false (R)))), .A⟩ = some ⟨cons false (cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (rep (j + 2) [true, false] (cons false (R))), .E⟩ := rfl
  have e : 6 * j + 2 * m + 23 = 2 * (m + 1) + (2 + (2 * (j + 2) + (4 * (j + 2) + (4 + (2 * (1) + (1)))))) := by omega
  rw [e]
  have hc := steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (steps_seq h5 (h6))))))
  simpa only [rep_cons2, rep_shift'] using hc

/-- BLOCK->blank: The block becomes a wall; the blank end gains a marker; the wall turns into a marker and a gap. -/
theorem block_to_blank (j : Nat) (m : Nat) (L : Tape) :
    steps (6 * j + 2 * m + 17) ⟨cons false (cons false (cons true (L))), cons false (rep (m) [true, false] (cons true (cons true (cons true (cons false (rep (j) [true, false] (blank))))))), .E⟩ = some ⟨cons false (cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (rep (j) [true, false] (cons true (cons true (blank)))), .E⟩ := by
  conv => lhs; rw [rep_shift' false true (m) (cons true (cons true (cons true (cons false (rep (j) [true, false] (blank)))))), rep_cons2 (m) false true (cons true (cons true (cons false (rep (j) [true, false] (blank)))))]
  have h0 := pass (m + 1) (cons false (cons false (cons true (L)))) (cons true (cons true (cons false (rep (j) [true, false] (blank)))))
  have h1 : steps 2 ⟨rep (m + 1) [true, false] (cons false (cons false (cons true (L)))), cons true (cons true (cons false (rep (j) [true, false] (blank)))), .E⟩ = some ⟨cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons false (cons true (cons false (rep (j) [true, false] (blank)))), .A⟩ := rfl
  conv at h1 => rhs; rw [rep_shift' false true (j) (blank)]
  have h2 := shift (j + 1) (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))) (cons false (blank))
  have h3 : steps 4 ⟨rep (j + 1) [false, true] (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (blank), .A⟩ = some ⟨rep (j) [false, true] (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons true (cons true (cons true (cons true (blank)))), .A⟩ := rfl
  have h4 := carry (j) (cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L))))))) (cons true (cons true (blank)))
  have h5 : steps 4 ⟨cons false (cons false (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons true (cons true (rep (j) [true, false] (cons true (cons true (blank))))), .A⟩ = some ⟨rep (m) [true, false] (cons false (cons false (cons true (L)))), cons false (cons true (cons true (cons false (rep (j) [true, false] (cons true (cons true (blank))))))), .A⟩ := rfl
  have h6 := shift (1) (rep (m) [true, false] (cons false (cons false (cons true (L))))) (cons true (cons false (rep (j) [true, false] (cons true (cons true (blank))))))
  have h7 : steps 1 ⟨cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L)))))), cons true (cons false (rep (j) [true, false] (cons true (cons true (blank))))), .A⟩ = some ⟨cons false (cons false (cons true (rep (m) [true, false] (cons false (cons false (cons true (L))))))), cons false (rep (j) [true, false] (cons true (cons true (blank)))), .E⟩ := rfl
  have e : 6 * j + 2 * m + 17 = 2 * (m + 1) + (2 + (2 * (j + 1) + (4 + (4 * (j) + (4 + (2 * (1) + (1))))))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (steps_seq h5 (steps_seq h6 (h7)))))))

/-- PACKET->gap: Gap step: the gap moves 2 right. -/
theorem packet_to_gap (L : Tape) (R : Tape) :
    steps (7) ⟨cons false (cons false (cons false (L))), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons false (cons true (cons false (L)))), cons false (R), .E⟩ := by
  have h0 : steps 4 ⟨cons false (cons false (cons false (L))), cons true (cons true (R)), .A⟩ = some ⟨cons false (L), cons false (cons true (cons true (cons false (R)))), .A⟩ := rfl
  have h1 := shift (1) (cons false (L)) (cons true (cons false (R)))
  have h2 : steps 1 ⟨cons false (cons true (cons false (L))), cons true (cons false (R)), .A⟩ = some ⟨cons false (cons false (cons true (cons false (L)))), cons false (R), .E⟩ := rfl
  have e : 7 = 4 + (2 * (1) + (1)) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (h2))

/-- PACKET->wall: The wall becomes a marker with a gap just right of it. -/
theorem packet_to_wall (L : Tape) (R : Tape) :
    steps (7) ⟨cons false (cons false (cons true (L))), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons false (cons true (cons true (L)))), cons false (R), .E⟩ := by
  have h0 : steps 4 ⟨cons false (cons false (cons true (L))), cons true (cons true (R)), .A⟩ = some ⟨cons true (L), cons false (cons true (cons true (cons false (R)))), .A⟩ := rfl
  have h1 := shift (1) (cons true (L)) (cons true (cons false (R)))
  have h2 : steps 1 ⟨cons false (cons true (cons true (L))), cons true (cons false (R)), .A⟩ = some ⟨cons false (cons false (cons true (cons true (L)))), cons false (R), .E⟩ := rfl
  have e : 7 = 4 + (2 * (1) + (1)) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (h2))

/-- PACKET->marker: Marker pass: the packet crosses the marker, which stays where it is. -/
theorem packet_to_marker (L : Tape) (R : Tape) :
    steps (5) ⟨cons true (cons false (cons true (L))), cons true (cons true (R)), .A⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons false (R))))), .A⟩ := by
  have h0 : steps 5 ⟨cons true (cons false (cons true (L))), cons true (cons true (R)), .A⟩ = some ⟨L, cons true (cons true (cons true (cons true (cons false (R))))), .A⟩ := rfl
  have e : 5 = 5 := by omega
  rw [e]
  exact h0

/-- PACKET->leftend: A new gap starts at the left end; the tape grows 2 cells to the left. -/
theorem packet_to_leftend (R : Tape) :
    steps (7) ⟨blank, cons true (cons true (R)), .A⟩ = some ⟨cons false (cons false (cons true (blank))), cons false (R), .E⟩ := by
  have h0 : steps 4 ⟨blank, cons true (cons true (R)), .A⟩ = some ⟨blank, cons false (cons true (cons true (cons false (R)))), .A⟩ := rfl
  have h1 := shift (1) (blank) (cons true (cons false (R)))
  have h2 : steps 1 ⟨cons false (cons true (blank)), cons true (cons false (R)), .A⟩ = some ⟨cons false (cons false (cons true (blank))), cons false (R), .E⟩ := rfl
  have e : 7 = 4 + (2 * (1) + (1)) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (h2))

/-- PACKET->leftend-marker: A marker on the first cell turns into a wall, a new gap starts at the left end; the tape grows 4 cells. -/
theorem packet_to_leftend_marker (R : Tape) :
    steps (18) ⟨cons true (blank), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons false (cons true (blank))), cons false (cons true (cons false (cons false (R)))), .E⟩ := by
  have h0 : steps 5 ⟨cons true (blank), cons true (cons true (R)), .A⟩ = some ⟨blank, cons false (cons true (cons true (cons true (cons false (R))))), .A⟩ := rfl
  have h1 := shift (1) (blank) (cons true (cons true (cons false (R))))
  have h2 := carry (1) (blank) (cons false (R))
  have h3 : steps 4 ⟨blank, cons true (cons true (cons true (cons false (cons false (R))))), .A⟩ = some ⟨blank, cons false (cons true (cons true (cons false (cons true (cons false (cons false (R))))))), .A⟩ := rfl
  have h4 := shift (1) (blank) (cons true (cons false (rep (1) [true, false] (cons false (R)))))
  have h5 : steps 1 ⟨cons false (cons true (blank)), cons true (cons false (cons true (cons false (cons false (R))))), .A⟩ = some ⟨cons false (cons false (cons true (blank))), cons false (cons true (cons false (cons false (R)))), .E⟩ := rfl
  have e : 18 = 5 + (2 * (1) + (4 * (1) + (4 + (2 * (1) + (1))))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (steps_seq h2 (steps_seq h3 (steps_seq h4 (h5)))))

/-- PACKET->marker-after-gap: A packet reaching a marker directly preceded by a gap: gap and marker become a wall and the packet goes on left. -/
theorem packet_to_marker_after_gap (L : Tape) (R : Tape) :
    steps (15) ⟨cons true (cons false (cons false (cons false (cons true (L))))), cons true (cons true (R)), .A⟩ = some ⟨L, cons true (cons true (cons true (cons false (cons true (cons false (cons false (R))))))), .A⟩ := by
  have h0 : steps 5 ⟨cons true (cons false (cons false (cons false (cons true (L))))), cons true (cons true (R)), .A⟩ = some ⟨cons false (cons true (L)), cons false (cons true (cons true (cons true (cons false (R))))), .A⟩ := rfl
  have h1 := shift (1) (cons false (cons true (L))) (cons true (cons true (cons false (R))))
  conv at h1 => rhs; rw [rep_cons2 (1) false true (L)]
  have h2 := carry (2) (L) (cons false (R))
  have e : 15 = 5 + (2 * (1) + (4 * (2))) := by omega
  rw [e]
  exact steps_seq h0 (steps_seq h1 (h2))

/-- PACKET->block: The machine halts (D reads 1). -/
theorem packet_to_block (L : Tape) (R : Tape) :
    steps 4 ⟨cons true (cons true (cons false (L))), cons true (cons true (R)), .A⟩ = some ⟨cons false (L), cons true (cons true (cons true (cons false (R)))), .D⟩ ∧ step ⟨cons false (L), cons true (cons true (cons true (cons false (R)))), .D⟩ = none :=
  ⟨rfl, rfl⟩

end BB6
