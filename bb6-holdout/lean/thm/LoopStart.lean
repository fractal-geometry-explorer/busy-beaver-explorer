import BB6.Loop
open BB6 BB6.Sym

/-! # The loop stretch's start class (generated by `thm/gen_loop.py`; see `LoopPass.lean`)

The phase-0 pass starts with R ≥ 4097: a = 1 + 2 y₀, b = 2 y₁, E = 2 y₂, R = 2 y₃, c = E − R − 1, with cone gaps
a, b − a, c − b and R − 3649 (all ≥ 448); the right end R and the left countdown L₁ are carried along. -/

def loopStart : SState :=
  let a : YForm := ⟨1, [2, 0, 0, 0]⟩
  let b : YForm := ⟨0, [0, 2, 0, 0]⟩
  let E : YForm := ⟨0, [0, 0, 2, 0]⟩
  let R : YForm := ⟨0, [0, 0, 0, 2]⟩
  let c := (E.sub R).addc (-1)
  ([⟨.W, a⟩, ⟨.W, b⟩, ⟨.W, c⟩], E, [a, b.sub a, c.sub b, R.addc (448 - 4097)])

def loopR : YForm := ⟨0, [0, 0, 0, 2]⟩
def loopL : YForm := L1Form ⟨0, [0, 2, 0, 0]⟩ ((YForm.sub ⟨0, [0, 0, 2, 0]⟩ ⟨0, [0, 0, 0, 2]⟩).addc (-1)) ⟨0, [0, 0, 2, 0]⟩

def loopLS : LState := (loopStart, loopR, loopL)
