import BB6.Ends
open BB6 BB6.Sym

/-! # The exit tree's start class (generated by `thm/gen_exit.py`; see `ExitTheorem.lean`)

The loop states a = 1 + 2 y₀, b = 2 y₁, c = 1 + 2 y₂, E = 2 y₃ (a odd, b even, c odd, E even) with the marks W a,
W b, W c and width E; the cone gaps are a, b − a, c − b and E − c.  `exitStartE` adds the start's width, right end
and left countdown that `Tree.okEnd` carries along (unused by the exit's end events: all 0). -/

def exitStart : SState :=
  let a : YForm := ⟨1, [2, 0, 0, 0]⟩
  let b : YForm := ⟨0, [0, 2, 0, 0]⟩
  let c : YForm := ⟨1, [0, 0, 2, 0]⟩
  let E : YForm := ⟨0, [0, 0, 0, 2]⟩
  ([⟨.W, a⟩, ⟨.W, b⟩, ⟨.W, c⟩], E, [a, b.sub a, c.sub b, E.sub c])

def exitStartE : EState := (exitStart, ⟨YForm.const 0, YForm.const 0, YForm.const 0⟩)
