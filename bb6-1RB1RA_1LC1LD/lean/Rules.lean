    steps (10 * y + 11) ⟨cons true (cons false (cons false (rep (y) [true] (cons false (rep (x) [true] (cons false (L))))))), cons false (cons true (cons true (R))), .B⟩ = some ⟨cons true (cons true (cons true (rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L)))))))))), R, .A⟩ := by
  have h0 : steps 3 ⟨cons true (cons false (cons false (rep (y) [true] (cons false (rep (x) [true] (cons false (L))))))), cons false (cons true (cons true (R))), .B⟩ = some ⟨rep (y) [true] (cons false (rep (x) [true] (cons false (L)))), cons false (cons true (cons false (cons true (cons true (cons true (R)))))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 9 ⟨app [true] L, app [false, true, false] R, .C⟩ = some ⟨L, app [false, true, false] (app [true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((y) * 9) ⟨rep (y) [true] (cons false (rep (x) [true] (cons false (L)))), cons false (cons true (cons false (cons true (cons true (cons true (R)))))), .C⟩ = some ⟨cons false (rep (x) [true] (cons false (L))), cons false (cons true (cons false (rep (y) [true] (cons true (cons true (cons true (R))))))), .C⟩ :=
    cross_l trans c1 (y) (cons false (rep (x) [true] (cons false (L)))) (cons true (cons true (cons true (R))))
  have h2 : steps 5 ⟨cons false (rep (x) [true] (cons false (L))), cons false (cons true (cons false (rep (y) [true] (cons true (cons true (cons true (R))))))), .C⟩ = some ⟨cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L)))))), rep (y) [true] (cons true (cons true (cons true (R)))), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((y) * 1) ⟨cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L)))))), rep (y) [true] (cons true (cons true (cons true (R)))), .A⟩ = some ⟨rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (cons true (cons true (R))), .A⟩ :=
    cross_r trans c3 (y) (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))) (cons true (cons true (cons true (R))))
  have h4 : steps 3 ⟨rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (cons true (cons true (R))), .A⟩ = some ⟨cons true (cons true (cons true (rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L)))))))))), R, .A⟩ := rfl
  exact steps_congr trans (a := 3 + ((y) * 9 + (5 + ((y) * 1 + (3))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

/-- Phase Y at the blank end of the tape: the pass configuration again. -/
theorem y_end (x y : Nat) (L : Tape) :
    steps (10 * y + 12) ⟨cons true (cons false (cons false (rep (y) [true] (cons false (rep (x) [true] (cons false (L))))))), blank, .B⟩ = some ⟨rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (cons false (cons true (blank))), .B⟩ := by
  have h0 : steps 3 ⟨cons true (cons false (cons false (rep (y) [true] (cons false (rep (x) [true] (cons false (L))))))), blank, .B⟩ = some ⟨rep (y) [true] (cons false (rep (x) [true] (cons false (L)))), cons false (cons true (cons false (cons true (blank)))), .C⟩ := rfl
  have c1 : ∀ L R : Tape, steps 9 ⟨app [true] L, app [false, true, false] R, .C⟩ = some ⟨L, app [false, true, false] (app [true] R), .C⟩ := fun _ _ => rfl
  have h1 : steps ((y) * 9) ⟨rep (y) [true] (cons false (rep (x) [true] (cons false (L)))), cons false (cons true (cons false (cons true (blank)))), .C⟩ = some ⟨cons false (rep (x) [true] (cons false (L))), cons false (cons true (cons false (rep (y) [true] (cons true (blank))))), .C⟩ :=
    cross_l trans c1 (y) (cons false (rep (x) [true] (cons false (L)))) (cons true (blank))
  have h2 : steps 5 ⟨cons false (rep (x) [true] (cons false (L))), cons false (cons true (cons false (rep (y) [true] (cons true (blank))))), .C⟩ = some ⟨cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L)))))), rep (y) [true] (cons true (blank)), .A⟩ := rfl
  have c3 : ∀ L R : Tape, steps 1 ⟨app [] L, app [true] R, .A⟩ = some ⟨app [] (app [true] L), R, .A⟩ := fun _ _ => rfl
  have h3 : steps ((y) * 1) ⟨cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L)))))), rep (y) [true] (cons true (blank)), .A⟩ = some ⟨rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (blank), .A⟩ :=
    cross_r trans c3 (y) (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))) (cons true (blank))
  have h4 : steps 4 ⟨rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (blank), .A⟩ = some ⟨rep (y) [true] (cons true (cons false (cons true (cons true (rep (x) [true] (cons false (L))))))), cons true (cons false (cons true (blank))), .B⟩ := rfl
  exact steps_congr trans (a := 3 + ((y) * 9 + (5 + ((y) * 1 + (4))))) (by omega) (steps_seq trans h0 (steps_seq trans h1 (steps_seq trans h2 (steps_seq trans h3 (h4)))))

end BB6c
