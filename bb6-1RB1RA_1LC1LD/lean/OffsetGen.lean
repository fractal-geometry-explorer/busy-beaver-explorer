import Offset

/-!
Writes `OffsetData.lean`: the descriptions in `reach`, sorted by key, as a balanced search tree split into named
subtrees, with one kernel check per subtree.  Run from this directory with the Lean path set as in `check.sh`:
`lean --run OffsetGen.lean > OffsetData.lean`.
-/

open BB6c

deriving instance Inhabited for St
deriving instance Inhabited for AC

def showQ : St → String
  | .A => "St.A" | .B => "St.B" | .C => "St.C" | .D => "St.D" | .E => "St.E" | .F => "St.F"

def showAC (a : AC) : String :=
  let wr := match a.wr with | none => "none" | some (e, s) => s!"(some ({e}, {s}))"
  s!"(AC.mk {a.two} {a.u} {showQ a.q} {a.h} {a.lx} {a.lr} {a.wx} {wr})"

partial def lit (xs : Array AC) (lo hi : Nat) : String :=
  if lo ≥ hi then ".leaf"
  else
    let m := (lo + hi) / 2
    s!"(.node {lit xs lo m}\n  {showAC xs[m]!} {lit xs (m + 1) hi})"

/-- Named subtrees down to depth `d`; returns the expression for the range and appends definitions and checks. -/
partial def named (xs : Array AC) (lo hi d : Nat) (nm : String) (out thms : IO.Ref (Array String)) : IO String := do
  if lo ≥ hi then return ".leaf"
  if d = 0 then
    out.modify (·.push s!"def {nm} : TS := {lit xs lo hi}\n")
    thms.modify (·.push s!"theorem ok_{nm} : okT reachT {nm} = true := by decide +kernel\n")
    return nm
  let m := (lo + hi) / 2
  let l ← named xs lo m (d - 1) (nm ++ "0") out thms
  let r ← named xs (m + 1) hi (d - 1) (nm ++ "1") out thms
  let body := s!".node {l} {showAC xs[m]!} {r}"
  let okl := if l = ".leaf" then "" else s!", ok_{l}"
  let okr := if r = ".leaf" then "" else s!", ok_{r}"
  out.modify (·.push s!"def {nm} : TS := {body}\n")
  thms.modify (·.push s!"theorem ok_{nm} : okT reachT {nm} = true := by\n  have h : okT reachT ({body}) = true := by\n    rw [okT_node{okl}{okr}]\n    decide +kernel\n  exact h\n")
  return nm

def main : IO Unit := do
  let xs := (reach.toList.toArray.qsort (fun a b => keyC a < keyC b))
  -- the keys must be distinct for the tree to be a search tree
  for i in [1:xs.size] do
    if keyC xs[i-1]! = keyC xs[i]! then throw (IO.userError "duplicate key")
  let out ← IO.mkRef (#[] : Array String)
  let thms ← IO.mkRef (#[] : Array String)
  -- the root is `reachT` itself; its subtrees are named `reachT0`, `reachT1`, ...
  let root ← named xs 0 xs.size 6 "reachT" out thms
  IO.println "import Offset

/-!
# The reachable descriptions, checked by the kernel

Generated by `OffsetGen.lean` (do not edit): the descriptions reachable from the starts, as a search tree, and one
kernel check (`decide +kernel`) per subtree that every description in it is fine (`okA`).  `check_ok` puts them
together; `offset_bound` and `recur_next` are the results of `Offset.lean` for this tree.
-/

namespace BB6c

open TM

set_option maxRecDepth 10000
"
  for s in (← out.get) do IO.println s
  for s in (← thms.get) do IO.println s
  let foot := "theorem starts_ok : starts.all (fun a => ROOT.mem a) = true := by decide +kernel

/-- **The kernel checks the reachable descriptions** (COUNT of them): the starts are among them, none is lost,
`two` is kept, and every one at which `pre` may stop has the bound. -/
theorem check_ok : checkT ROOT = true := by
  unfold checkT
  rw [starts_ok, ok_ROOT]
  rfl

/-- **Where `pre` stops, `c ≥ -1`, and `c ≥ 0` unless the block left of the last is 2** (kernel only).  For every list
`ls` of blocks of at least 2 (any number of them, nearest first), if `pre` stops then it returns two explicit blocks
`a, b` and `p`, `u` with `2u ≤ a + 2p + 1`, and `2u ≤ a + 2p` unless `ls` starts with 2; `u ≤ 2`; `b ≥ 2`, and the
blocks after `b` are at least 2, then 0s. -/
theorem offset_bound {ls : List Nat} (hg : ∀ b ∈ ls, 2 ≤ b) {f : Nat} {L : List Nat} {p u : Nat}
    (e : pre f ⟨.B, 0, pad 1 ls, [0, 1]⟩ 0 = some (L, p, u)) :
    ∃ a b M, L = a :: b :: M ∧ 2 * u ≤ a + 2 * p + (if ls.headD 0 = 2 then 1 else 0) ∧ 2 ≤ b ∧ GZ M ∧ u ≤ 2 :=
  offset_bound_of check_ok hg e

/-- **The next pass start** (kernel only).  For every list `ls` of blocks of at least 2, if `pre` stops, then for every
`j ≥ 2` the pass from a last block `3j` reaches a pass start with all blocks at least 2 and last block `2j + c`,
`c ≥ -1`, and `c ≥ 0` unless `ls` starts with 2. -/
theorem recur_next {ls : List Nat} (hg : ∀ b ∈ ls, 2 ≤ b) {f : Nat} {L : List Nat} {p u : Nat}
    (e : pre f ⟨.B, 0, pad 1 ls, [0, 1]⟩ 0 = some (L, p, u)) (j : Nat) (hj : 2 ≤ j) :
    ∃ ls' n, (∀ b ∈ ls', 2 ≤ b) ∧ Reaches (K ls (3 * j - 1)) (K ls' n) ∧
      2 * j ≤ n + 1 + (if ls.headD 0 = 2 then 1 else 0) :=
  recur_next_of check_ok hg e j hj

end BB6c"
  IO.println ((foot.replace "ROOT" root).replace "COUNT" (toString xs.size))
